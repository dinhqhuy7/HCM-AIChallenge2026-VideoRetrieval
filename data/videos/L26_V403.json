olden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · Thc hi · Ht nêm Aji-ngon Heo · Phi hp thc hin · Láé tuoi: 250g · Ót him xanh, đò: 30g · Gà tre: 1 con · Sà cáy dáp dáp: 8 cày · Bt Canh ca công ty AJINOMOTO · Hành tim bàm, tòi bàm, dàu đièu · Công ty C · Thc hin chương trình · chuơng trình thuc · DÀI TRUYÊN HìNH TP. HCM"}],"speech":[{"time":13.3,"text":"Chào Thông Phương, mộng mỹ gì vậy?"},{"time":17.0,"text":"Em đang mơ sao mà mình nhắm mắt rồi mình mở mắt ra là mình tới Phú Yên hả cô?"},{"time":21.4,"text":"Tới Phú Yên thì thích gì nhất ở đó?"},{"time":23.2,"text":"Em thích mắt cá ngựa đại dương nè, rồi cơm gà Phú Yên nè, rồi lẩu gà lá é nè"},{"time":29.6,"text":"Rồi, như vậy là nhớ Phú Yên là chính, nhưng mà nhớ món ăn Phú Yên là mười lận"},{"time":34.7,"text":"Đúng rồi"},{"time":35.6,"text":"Bây giờ mình nấu món gì? Mình nấu món gà đi cô"},{"time":38.4,"text":"Được rồi, sẵn sàng thôi, nhưng mà bây giờ có ai phụ cô làm bếp không?"},{"time":41.6,"text":"Em sẵn sàng"},{"time":42.4,"text":"Rồi, vậy mình đi bếp liền nha"},{"time":45.9,"text":"Gà hấp lá é, bắt mắt, ngọt thịt, thơm lưng"},{"time":65.5,"text":"Chào mừng các bạn đang đến với chương trình Món ngon mọi"},{"time":68.2,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":72.4,"text":"Với món ăn này thì các bạn lưu ý là chúng ta sẽ chọn 1 con gà tre hoặc là con gà ta dưới 1,2kg"},{"time":78.3,"text":"Thì món ăn sẽ chín đều và ngon hơn ha"},{"time":80.4,"text":"Và để cho gia vị thấm đều vào thịt gà thì chúng ta nên giả tất cả các gia vị cùng với nhau"},{"time":85.9,"text":"50g lá é hay là ở quê mình còn gọi là lá é trắng"},{"time":90.3,"text":"Nhìn thì hình hức giống như lá húng quế ở mình"},{"time":92.9,"text":"Nhưng mà có điều là nó xanh mướt luôn"},{"time":94.8,"text":"Từ cái lá cho tới cái cọng"},{"time":96.7,"text":"Và cái mùi thơm rất là đặc trưng"},{"time":98.2,"text":"Nó hơi giống giống như là cái mùi xả vậy đó"},{"time":100.1,"text":"Hành tím băm và tỏi băm"},{"time":101.7,"text":"Mỗi thứ mình cho khoảng chừng 1 muỗng canh vô đây"},{"time":103.6,"text":"Tiếp theo thì chúng ta sẽ cho vào đây 1 muỗng canh"},{"time":107.4,"text":"Bột canh của công ty Ajinomoto"},{"time":109.5,"text":"1 muỗng cà phê hạt nêm Ajinon gà"},{"time":112.5,"text":"Và cuối cùng thì mình sẽ cho vào đây là ớt hiểm"},{"time":115.6,"text":"2 trái màu đỏ đi"},{"time":117.1,"text":"6 trái ớt hiểm màu xanh"},{"time":119.3,"text":"Và nếu như mà mình sợ là cái ớt hiểm nó có cay quá"},{"time":122.4,"text":"Thì mình sẽ chọn những cái trái ớt hiểm mà nó non thôi"},{"time":124.8,"text":"Thì cái vị cay nó sẽ ít hơn"},{"time":126.6,"text":"Cô nhờ Thanh Phương giả nhuyễn cái hỗn hợp này giúp cô nha"},{"time":129.5,"text":"Dạ, thơm quá"},{"time":130.8,"text":"Chúng ta sẽ giả gia vị rồi sau đó mới ướp để giúp thịt gà thấm đều gia vị ha"},{"time":137.5,"text":"Và trong lúc mà chờ Thanh Phương giả cái gia vị ra"},{"time":140.6,"text":"Thì chúng ta sẽ sơ chế"},{"time":142.1,"text":"Đây là tắc, để chút mình sẽ làm cái phần nước chấm"},{"time":145.3,"text":"Bây giờ mình sẽ chỉ cắt làm đôi thôi"},{"time":146.8,"text":"Còn phần xả thì chúng ta sẽ đập dập và mình cắt làm đôi"},{"time":150.1,"text":"Và bây giờ thì chúng ta sẽ ướp gà"},{"time":152.1,"text":"Mình sẽ cho con gà vào trong một cái tô"},{"time":155.0,"text":"Sẽ múc cái phần gia vị này ra"},{"time":157.0,"text":"Mình sẽ chà lên cái phần da gà như thế này"},{"time":159.8,"text":"Khi mà mình ướp như thế này"},{"time":161.3,"text":"Thì một chút nữa cái món hấp của mình nó vừa ngọt"},{"time":164.3,"text":"Rồi đậm đà và nó thơm nữa"},{"time":166.4,"text":"Cái phần mà sát gia vị dư này nè"},{"time":168.6,"text":"Cho vào trong bụng gà luôn"},{"time":170.4,"text":"Sau khi mà chúng ta đã ướp phần gia vị vào trong thịt gà rồi"},{"time":174.4,"text":"Thì mình sẽ để cho thịt gà thấm khoảng chừng 30 phút"},{"time":177.6,"text":"Mình sẽ lót xả ở bên dưới này"},{"time":179.4,"text":"Xong rồi mình đặt vào đây một ít lá é để cho nó thơm"},{"time":182.7,"text":"Bây giờ thời gian đủ rồi"},{"time":183.9,"text":"Mình sẽ phớt cái màu dầu điều lên da gà như thế này"},{"time":186.6,"text":"Các bạn lưu ý là chúng ta sẽ quét thêm một lớp dầu điều lên da gà"},{"time":190.5,"text":"Để cho món ăn có màu sắc hấp dẫn ha"},{"time":192.6,"text":"Đối với lại cái nồi sứ này là sứ dưỡng xinh"},{"time":195.4,"text":"Thì mình chỉ cho một ít nước thôi"},{"time":197.0,"text":"Cho con gà vào trong đây"},{"time":199.5,"text":"Sẽ đẩy cái nắp nồi này lại"},{"time":201.0,"text":"Cô sẽ bắt lên bếp cho em mở lửa giúp cô ha"},{"time":204.0,"text":"Trong nắp nồi nó đã có hơi khó bốc lên rồi"},{"time":206.2,"text":"Bây giờ em giảm lửa nhỏ nhất giúp cô đi"},{"time":208.9,"text":"Chúng ta sẽ hấp trong khoảng thời gian từ 30 tới 35 phút"},{"time":213.0,"text":"Mình sẽ chuẩn bị cái phần muối để chấm"},{"time":215.6,"text":"Mình sẽ cho vô khoảng chừng 1 nấm lá é"},{"time":218.8,"text":"Cho vào đây 1 muỗng canh, bột canh của công ty Ajinomoto"},{"time":222.1,"text":"1 muỗng canh đường"},{"time":223.6,"text":"Và khoảng chừng 4 trái ớt"},{"time":225.3,"text":"Mình sẽ sử dụng ớt xanh và 1 trái ớt hiểm để cho nó có cái màu đỏ đẹp"},{"time":229.5,"text":"Rồi hứa với cô là sẽ phụ cô"},{"time":231.2,"text":"Vậy giờ dạ tiếp phần muối chấm nha"},{"time":233.0,"text":"Dạ"},{"time":236.0,"text":"Dạ xong cô ơi"},{"time":237.2,"text":"Rồi cô cảm ơn Phương"},{"time":238.3,"text":"Rất là thơm luôn á"},{"time":239.8,"text":"Cho vào đây thêm chừng 2 muỗng canh nước cốt tắc"},{"time":243.1,"text":"Để nó có cái mùi thơm đặc trưng của tắc nữa"},{"time":245.8,"text":"Rồi vậy là mình đã xong cái phần muối chấm"},{"time":250.4,"text":"Rồi cô sẽ mở nắp ra"},{"time":254.2,"text":"Hấp dẫn quá luôn cô"},{"time":255.5,"text":"Cho thêm 1 ít lá é còn tươi vô"},{"time":258.5,"text":"Nó vừa thơm đúng không?"},{"time":260.3,"text":"Vừa đẹp"},{"time":261.1,"text":"Thì khi ăn chúng ta sẽ xé gà ra"},{"time":263.7,"text":"Và chấm với lại muối ớt"},{"time":265.9,"text":"Cà chín thơm lừng mùi lá é, sả, thịt săn ngọt tự nhiên, hoa quyện với nước chấm chua cay nhẹ"},{"time":273.0,"text":"Món hấp giữ vị lưu hương cho bữa ngon của bạn"},{"time":276.3,"text":"Với tuyệt chiêu hấp ngày hôm nay, Thanh Phương tin chắc rằng món gà hấp lá é sẽ là một món ăn yêu thích và cho tất cả mọi người"},{"time":282.5,"text":"Và nếu các bạn muốn tìm hiểu kỹ về công thức món ăn, quý vị vui lòng truy cập vào kênh youtube, website và fanpage với địa chỉ đang hiển thị trên màn hình"},{"time":291.8,"text":"Còn bây giờ, xin chào tạm biệt và hẹn gặp lại"}]}