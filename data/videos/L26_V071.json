},{"time":266.8,"until":269.4,"text":"Eat Well,Live Woll · INOMOTO · Singay · MON · móingay · Well,LivWell · minus-FERO COOUNG"},{"time":269.8,"until":282.0,"text":"Onli · mingày · BA ROI · BÍT TÉT · AJINOMOTO. · Eat Well, Live Well. · CANH RAU CÙ · XÔNG KHÓI · DÀY DÙ DINH DUÖNG · VOI · BÜA ÄN · liRAON"},{"time":294.4,"until":299.9,"text":"MOTO · ming · AJINOM · AJINOMOTO · Eat Well, L · ngày · mingày · Eat We · main · AJING · IOTO · AgaMay"},{"time":300.5,"until":309.8,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · AJINOMOTO · mingày · Eat Well, Live We"},{"time":313.0,"until":322.8,"text":"200g · 150g · Công ty Ajinomoto Vit Nam · 1trái · Tham gia thc hin · Công ty Hakuhodo · Công ty Golden Scale · Công ty HKFilm · ·CHANH · NGUYÊN LIÊU · ·TÁO VÀNG · ·TÁO XANH · Phi hp thc hin · DAI TRUYEN HINH · Bán quyn kch bán và cău trúc · ·NHO NÂU · ·HAT ÓC CHÓ · Ban quyen kich ban va cau truc · ·CÂN TÂY · · XÖT MAYONNAISE VI NGUYËN BÀN · ·TÁO DÒ · 1 bę · Thc hin chương trình · Thc hin chươ · Onlir · ·CAN TÁY · THÀNH PHÓ HO CHÍMINH · chương trình thuc"}],"speech":[{"time":12.0,"text":"Salad táo và hạt ốc chó"},{"time":13.6,"text":"Hành mát ngọt lành"},{"time":14.9,"text":"Mùi thơm béo béo"},{"time":41.2,"text":"Rất vui khi được gặp lại quý vị khán giả đang xem chương trình"},{"time":43.9,"text":"Món ngon mỗi ngày"},{"time":44.9,"text":"Nấu chuẩn ăn lành"},{"time":47.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":51.7,"text":"Anh Vũ nè"},{"time":52.5,"text":"Em thấy hôm nay mình có rất nhiều loại trái cây nha"},{"time":55.4,"text":"Đúng rồi"},{"time":56.0,"text":"Và đặc biệt là có hạt ốc chó nè"},{"time":57.6,"text":"Có cần tây nữa"},{"time":58.7,"text":"Món gì mà sao em ráng không ra Vũ ơi"},{"time":60.8,"text":"Thưa các bạn món ăn của chúng ta ngày hôm nay"},{"time":62.9,"text":"Đó là một món salad"},{"time":64.7,"text":"Nhìn xong là thấy rất là tươi mát rồi đúng không nào?"},{"time":67.4,"text":"Thưa các bạn, ngày hôm nay chúng ta thực hiện đó là món xà lách táo và hạt ốc chó"},{"time":71.8,"text":"Bây giờ anh sẽ chuẩn bị một cái tô và vắt vô đó một xíu nước cốt chanh"},{"time":75.5,"text":"Chúng ta nên ngâm táo vô trong nước lạnh pha nước cốt chanh"},{"time":78.6,"text":"Để táo không bị thâm và có mùi thơm từ nước cốt chanh"},{"time":82.1,"text":"Đó, chúng ta cắt đầu đuôi"},{"time":84.9,"text":"Chúng ta cắt dọc như vầy"},{"time":93.4,"text":"Trong táo có rất là nhiều những giá trị dinh dưỡng"},{"time":95.9,"text":"Và khi thưởng thức táo thì chúng ta nhớ là ăn luôn cả phần vỏ nha"},{"time":98.9,"text":"Rất là tốt cho sức khỏe"},{"time":100.4,"text":"Ở đây Thanh Phương thấy là anh Vũ có chọn táo đỏ, táo xanh và cả táo vàng"},{"time":104.5,"text":"Và khi rau, củ, quả, trái cây mà có nhiều màu sắc khác nhau"},{"time":107.8,"text":"Sẽ cung cấp nhiều vitamin và khoáng chất hơn cho cơ thể đấy ạ"},{"time":110.5,"text":"Bây giờ nhờ em cắt dùm anh quả táo màu đỏ"},{"time":116.5,"text":"Rồi"},{"time":118.5,"text":"Bây giờ anh sẽ xử lý cái trái táo màu vàng"},{"time":123.0,"text":"Cần tay thì chúng ta cũng cắt cỡ khoảng 2cm như vầy"},{"time":126.8,"text":"Nhỏ nhỏ như vầy nha"},{"time":128.6,"text":"Thưa các bạn, đối với cần tây thì chúng ta nên bào bỏ vỏ và cắt nhỏ hơn các nguyên liệu khác"},{"time":133.2,"text":"Để cần tây không bị dai và thấm gia vị hơn nha các bạn"},{"time":136.4,"text":"Một miếng liệu nữa là nho"},{"time":138.0,"text":"Bây giờ ở đây thì anh sẽ dùng nho màu nâu và nho không hạt"},{"time":142.5,"text":"Thì nho này thì chúng ta chỉ cần cắt làm đôi thôi"},{"time":148.5,"text":"Các loại trái cây chúng ta phải xong"},{"time":150.5,"text":"Rồi một miếng liệu nữa không thể thiếu đó là các hạt ốc chó"},{"time":154.5,"text":"Và hạt ốc chó này là tôi cũng đã bể thành những miếng có cạnh cỏ 2cm như vầy"},{"time":159.3,"text":"Và đã rang thơm"},{"time":160.6,"text":"Trong hạt ốc chó thì có chứa vitamin E"},{"time":163.2,"text":"Rất là tốt cho làn da của chúng ta"},{"time":164.9,"text":"Giúp cho da sáng mịn màng hơn"},{"time":167.3,"text":"Ngoài ra còn có chứa omega 3 và DHA"},{"time":169.9,"text":"Tốt cho đảo bộ nữa đấy ạ"},{"time":171.2,"text":"Để cho cái món salad này chúng ta được thấm vị bên trong"},{"time":174.8,"text":"Chúng ta cho đây khoảng chừng 1 phần 3 muỗng cà phê muối thôi các bạn nha"},{"time":179.3,"text":"Cho vào đây một tí xíu tiêu"},{"time":180.6,"text":"Nhưng mà nhớ tiêu trắng xay nha"},{"time":182.1,"text":"Chúng ta nên ướp một tí xíu muối tiêu vào trong táo trước"},{"time":185.8,"text":"Sau đó chúng ta nhớ trút bỏ nước"},{"time":187.7,"text":"Rồi chúng ta mới cho sốt Mayonaise Aji Mayo vào"},{"time":190.3,"text":"Như vậy thì món salad chúng ta không bị chảy nước"},{"time":193.4,"text":"Và nước sốt sẽ bám vào trong táo nhiều hơn"},{"time":196.0,"text":"Cho hạt ngọt chó vào"},{"time":197.3,"text":"Nho vào luôn"},{"time":199.2,"text":"Chúng ta cho ở đây khoảng 1 chén sốt Mayonaise Aji Mayo vị nguyên bản vào"},{"time":204.5,"text":"Sốt Mayonaise Aji Mayo vị nguyên bản có vị chua chua, ngọt ngọt"},{"time":208.7,"text":"Rất là phù hợp với những món salad trái cây như thế này"},{"time":211.4,"text":"Đúng rồi, trộn nhẹ tay đều"},{"time":213.5,"text":"Chúng ta không trộn tới trộn lui nhiều quá"},{"time":215.5,"text":"Thì marjoram nó cũng sẽ bị chảy nước luôn"},{"time":218.1,"text":"Đó"},{"time":219.3,"text":"Vừa áo vừa bám vừa đẹp các bạn"},{"time":221.5,"text":"Và thưa các bạn thấy là chúng ta đã hoàn thành"},{"time":223.5,"text":"Xong một món salad táo với lại hạt ốc chó"},{"time":225.7,"text":"Rất là đơn giản đúng không nào"},{"time":226.9,"text":"Bây giờ thì chúng ta còn giai đoạn cuối cùng"},{"time":228.8,"text":"Đó là chúng ta ra dĩa trên bài và thưởng thức thôi"},{"time":231.8,"text":"Với món salad cực kỳ hấp dẫn ngày hôm nay"},{"time":234.2,"text":"Nếu như các bạn muốn xem lại công thức"},{"time":235.8,"text":"Hãy quét mã QR trang hiển thị trên bàn hình"},{"time":240.0,"text":"Bây giờ thì anh sẽ ra món"},{"time":242.4,"text":"Với một món salad rất là thanh mát"},{"time":245.8,"text":"Thơm ngon"},{"time":246.5,"text":"Và cái mùi của champagne đó là mình rất là kích thích khẩu vị luôn anh Vũ ơi"},{"time":250.6,"text":"Vừa giảm cân vừa thanh lọc cơ thể"},{"time":252.3,"text":"Các bạn nhớ thực hiện món này nha"},{"time":254.8,"text":"Và thưa các bạn"},{"time":255.8,"text":"Món này là món xà lách tươi mát"},{"time":257.7,"text":"Cho nên chúng ta cũng cần trang trí một ít hoa lá"},{"time":261.1,"text":"Nhìn cho nó xinh tươi, nó phấn khởi ha"},{"time":263.1,"text":"Rồi đây là hoa phân xê"},{"time":264.7,"text":"Chúng ta để tự nhiên ha"},{"time":266.4,"text":"Món xà lách này thì mình sẽ ăn kèm với những món gì vậy anh Vũ?"},{"time":269.6,"text":"Thưa các bạn, món xà lách là một món ăn đầu bữa"},{"time":271.8,"text":"Thì chúng ta có thể kết hợp cùng với món canh rau củ, ba rọi sông khói"},{"time":275.6,"text":"Và món bò bếp Tết là chúng ta có ngay một bữa ăn hoàn chỉnh, một bữa ăn đầy đủ dinh dưỡng và rất là hấp dẫn"},{"time":282.6,"text":"Salad có nhiều màu sắc tươi tắn, áo ngục lớp sốt mayonnaise bóng bẫy, vị chua ngọt mọng nước"},{"time":287.9,"text":"Cùng với chút béo béo hậu vị, thơm mùi hạt ốc chó rang, quyện hòa khéo vị"},{"time":294.1,"text":"Đối vị với món salad táo và hạt ốc chó, thơm ngon và giàu giá trị dinh dưỡng, các bạn hãy thử ngay nhé"},{"time":299.9,"text":"Ngoài ra để xem lại công thức của món ngon ngày hôm nay"},{"time":302.3,"text":"Vui lòng truy cập vào kênh youtube, website và fanpage của Món Ngon Mỗi Ngày"},{"time":306.1,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại quý vị"}]}