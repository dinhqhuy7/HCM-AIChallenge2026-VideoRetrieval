.3,"text":"tuoitre · Coftuoitrev · Cofft"},{"time":70.6,"until":75.0,"text":"tusitrerv"},{"time":75.2,"until":79.0,"text":"100 · HSD/EXP: · Sta · Southern · goiSao · SUA TUO · Vinami · imamilk · 1,24 · VRUAMILK · Agöi Sao"},{"time":79.2,"until":84.3,"text":"Mama · Etuoitre · Lychee · Mamo · LY EtuoitreTV · CHENET"},{"time":87.9,"until":88.8,"text":"doney · TOSHIS · DÁU · DAU · TRON"},{"time":89.0,"until":90.7,"text":"tuoitreV"},{"time":93.5,"until":96.2,"text":"TEYUH> · Mono · Ngôi Sao · TEYUH · Mona · COFFEE · Mano · Mana"},{"time":96.4,"until":99.2,"text":"tuoitre"},{"time":102.3,"until":104.8,"text":"COFFEE · tubitre · AMB"},{"time":105.1,"until":109.8,"text":"COF · PA ĂNSÁNG"},{"time":110.0,"until":115.8,"text":"tuoitre · KHUYET · coff · Coffer · SuoltreTV"},{"time":116.0,"until":118.3,"text":"tuoitrerv"},{"time":118.5,"until":120.6,"text":"tuoitrerv · tucitrery"},{"time":122.4,"until":123.6,"text":"tusitrerv"},{"time":123.8,"until":126.0,"text":"Tác gi: Tho Ngân · thuang hibu · tusitrery"},{"time":126.4,"until":132.6,"text":"Tác gi: Tho Ngân · tuoitre · Coffee <LYT · gia chón trn gian · Fim gi.... · Binh an duri · Da thua .... tim chút · thutng hitu · tuitréV · Fimgi"}],"speech":[{"time":14.8,"text":"Điều đặn mỗi ngày vào lúc 5h30 sáng, người dân quanh xã Hồ Nai Hai, huyện Tràng Bông, tỉnh Đồng Nai"},{"time":21.1,"text":"lại thấy thấp thoáng bóng dáng của một nhóm người ngồi trên xe ba bánh, mở cửa quán cà phê để chuẩn bị cho một ngày mới mưu sinh."},{"time":29.1,"text":"Nơi họ đang làm việc có tên là Khuyết, với hầu hết các lao động tại quán đều là người khuyết tật."},{"time":35.0,"text":"Đó là câu chuyện của anh Đinh Văn Tâm và những người cộng sự của mình."},{"time":39.0,"text":"Anh Tâm bị tai nạn lao động, chấn thương cuộc sống, di chuyển đều phụ thuộc vào chiếc xe điện."},{"time":44.1,"text":"Anh Tâm giữ vai trò là quản lý, quán xuyến các công việc tại quán cà phê khuyết."},{"time":48.6,"text":"Ngoài ra trên chiếc xe của mình, anh còn kiêm luôn các công việc khác như sắp xếp lau dọn và bưng nước cho khách."},{"time":56.8,"text":"Những khách hàng đến với cà phê khuyết không chỉ vì không gian quán thơ mộng, xinh đẹp và mát mẻ,"},{"time":61.7,"text":"mà điều đặc biệt còn chính là ở sự niềm nở của những con người nơi đây."},{"time":66.2,"text":"Quán cà phê khuyết hiện tại có 12 thành viên chia nhau theo ca để làm việc trong ngày."},{"time":70.5,"text":"Trong nhóm có một pha chế, còn lại làm giữ xe, bưng bê, tính tiền"},{"time":75.4,"text":"Và hầu hết mọi người đều đi lại khó khăn"},{"time":78.5,"text":"Ngoài ra, tất cả đều không có kinh nghiệm trong việc kinh doanh pha chế"},{"time":81.8,"text":"Đều phối mô hình quán cà phê, nên mọi thứ đối với anh chị đều rất mới mẻ"},{"time":86.0,"text":"Các anh chị phải tự học hỏi, trau dồi và tước lĩ kinh nghiệm qua từng ngày hoạt động của quán"},{"time":91.6,"text":"Trong quá trình làm việc, do hầu hết mọi người đều là người khuyết tật"},{"time":94.9,"text":"Nên mọi việc vận hành khá chậm, xong"},{"time":97.3,"text":"Không vì vậy mà khách hàng cảm thấy khó chịu"},{"time":99.6,"text":"Ngược lại họ luôn dành sự thông cảm dành cho những người làm việc tại đây"},{"time":103.0,"text":"Cũng nhờ vậy mà mỗi người khuyết tật dần bớt đi sự ngại ngùng"},{"time":106.5,"text":"Hay lo sợ không làm hài lòng khách hàng"},{"time":112.8,"text":"Nếu một ngày bạn cảm thấy cuộc sống thật buồn chán"},{"time":115.2,"text":"Hãy thử đến với Cà Phê Khuyết"},{"time":116.9,"text":"Cùng thưởng thức một ly cà phê và ngắm nhìn những khung cảnh nơi đây"},{"time":120.2,"text":"Để thấy rằng bản thân mình còn may mắn hơn rất nhiều người"},{"time":126.7,"text":"Tìm gì ở trốn trận gian"},{"time":128.4,"text":"Dạng thưa tìm chút, bình an đủ rồi"}]}