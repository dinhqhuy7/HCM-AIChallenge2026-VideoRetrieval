4,"until":182.8,"text":"mingày · Eat Well, Live Well. · MEO · AJINOMOTO. · ÁP CHÃO THIT BÒ CHÍN VÙA · ĐÊ THIT BÒ MÊM VÀ NGOT THIT"},{"time":183.0,"until":185.0,"text":"AWIBRAND"},{"time":194.6,"until":194.6,"text":"AJINOMOTO · mđingày"},{"time":197.0,"until":200.0,"text":"AJINOMOTO · mingày · AjiMay"},{"time":214.1,"until":215.0,"text":"mdingày · AJINOMOTO."},{"time":217.9,"until":219.8,"text":"AJINOMOTO. · mdingày"},{"time":223.3,"until":240.2,"text":"NGO · Blendy · #NauChuanAnLành · móingay · AINOMOTO · moing · móin · Singay"},{"time":240.6,"until":250.5,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC · AJINOMOTO · mingày"},{"time":250.7,"until":252.5,"text":"mingày · MON"},{"time":259.2,"until":261.3,"text":"mingày · AJINOMOTO · Eat Well, Live Well. · Onl"},{"time":270.0,"until":272.7,"text":"mingày · Onl · AJINOMOTO. · Eat Well, Live Well."},{"time":272.9,"until":280.4,"text":"MEO · GIÚP TÄNG VI BÉO CHO MÓN SALAD · DÙNG XÖT MAYONNAISE"},{"time":280.8,"until":283.5,"text":"AJINOMOTO · Eat Well, Live Well. · Onl · moingày"},{"time":295.0,"until":302.9,"text":"AJINOMOTO · mingày · Eat Well, Live Well. · iline · moingay · ngay · Eat Well, Live · Eat Welt, U · móing · máin · gày · máir · Aji-May"},{"time":303.3,"until":312.0,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · AJINOMOTO · moingay"},{"time":313.0,"until":324.8,"text":"150g · 20g · 30g · Tham gia · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Golden Scale · Công ty Hakuhodo Vit Nam · NGUYÊN LIÊU · Công ty HKFilm · Bn quyn kch bn và cu trúc · ·RAU MÁ NON · 1 trái · Phi hp thc hin · ·CÀ RÓT · ·HÀNH TÍM · ·TÒI BÁC · · HAT NÊM HEO · ·TÒI PHI · · THIT BÒ THÄN NGOI · ·XÖT MAYONNAISE VI NGUYÊN BAN · Thc hin chương trình · · LÁ HÚNG LÙI · chuơng trình thuc · ·DÁU TÒI · Công ty A · ·BÔT NGOT · · NUÓC CÓT CHANH · · THOM CHÍN CÁT SI · Thc hié · THÀNH PHÓ HO CHÍMINH · Cóng ty H · DÀI TRUYÊN HìNH · ·ÖT SÜNG"}],"speech":[{"time":12.4,"text":"Đẹp da thanh nhiệt với salad bò rau má"},{"time":37.9,"text":"Chương trình được tài trợ bởi công ty Agenoto Việt Nam"},{"time":42.3,"text":"Minh Phương nè"},{"time":43.0,"text":"Dạ"},{"time":43.8,"text":"Hôm nay mình sẽ giới thiệu cho Minh Phương một cái món ăn cực kỳ là hấp dẫn"},{"time":48.2,"text":"Salad đúng mình, em thấy là nguyên liệu chính ngày hôm nay là rau má"},{"time":51.3,"text":"Đối với những ai mà có thể ăn được cái vị đắng đắng, nhẫn nhẫn, rất là đặc trưng của rau má"},{"time":56.5,"text":"Thì chắc chắn sẽ rất thích cho mà xem"},{"time":58.2,"text":"Bây giờ bắt tay làm liền anh Minh ha"},{"time":59.9,"text":"Rồi, thì cà rốt đầu tiên thì nhờ Minh Phương sẽ cắt chỉ ra"},{"time":68.5,"text":"Ớt sừng thì mình sẽ bỏ hột"},{"time":71.3,"text":"Và em còn được biết đó chính là ở trong ớt sừng còn có vitamin C"},{"time":77.6,"text":"Rất là tốt cho da nè, cũng như là tăng sức đề kháng cho cơ thể"},{"time":84.0,"text":"Và hành tím thì mình sẽ cắt khoanh"},{"time":87.0,"text":"Mình sẽ lấy giúp Minh Phương một cái tô nước đá nè"},{"time":90.7,"text":"Mình sẽ cho cái hành tím này vào đây luôn"},{"time":93.6,"text":"Mình sẽ đi ướp cái phần bò này nha"},{"time":95.7,"text":"Cho vào trong đây 1 muỗng cà phê hạt niêm Ajinomoto"},{"time":99.3,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":102.1,"text":"1 phần 4 muỗng cà phê tiêu"},{"time":104.9,"text":"1 muỗng canh dầu ăn"},{"time":107.4,"text":"Chúng ta sẽ trộn đều"},{"time":108.8,"text":"Nên lựa chọn các phần thịt bò mà thăng ngoại"},{"time":111.5,"text":"Thì nó sẽ mềm hơn"},{"time":113.1,"text":"Và chúng ta sẽ ướp trong khoảng thời gian khoảng 10-15 phút"},{"time":116.5,"text":"Để cho thịt bò nó thấm"},{"time":118.2,"text":"Chúng ta sẽ đi pha sốt"},{"time":119.4,"text":"Chúng ta sẽ cần 2 muỗng canh nước chanh"},{"time":123.3,"text":"2 muỗng canh đường vào trong đây"},{"time":126.1,"text":"1 muỗng cà phê tiêu, 1 ít muối, 2 muỗng canh dầu tỏi vào trong đây luôn"},{"time":134.1,"text":"Chúng ta sẽ bắt đầu đánh tan đều phần nước sốt này lên cho nó tan hết đường ra"},{"time":138.5,"text":"Và bước tiếp theo chúng ta sẽ áp chảo phần bò cho vào trong đây 1 ít dầu ăn"},{"time":143.5,"text":"Chúng ta sẽ cho bò vào trong đây luôn"},{"time":147.2,"text":"Bây giờ nó được rồi đó Minh Phương"},{"time":148.7,"text":"Chúng ta sẽ chở qua 1 mặt"},{"time":150.2,"text":"Thấy 1 màu quang rất là đẹp, hấp dẫn không?"},{"time":152.6,"text":"Mình sẽ áp chảo phần thịt bò này với lửa vừa thôi ha"},{"time":156.8,"text":"Thì mình sẽ cho thêm cái phần tỏi cũ này vào"},{"time":159.3,"text":"Chúng ta nên áp chảo tỏi cùng với thịt bò"},{"time":161.8,"text":"Giúp tăng thêm mùi thơm của thịt bò nha"},{"time":163.8,"text":"Cái phần tỏi thì nó vàng đều ở ngoài"},{"time":166.2,"text":"Mình sẽ bớt ra đúng không?"},{"time":167.0,"text":"Đúng rồi, mình sẽ bớt ra nơi đây"},{"time":169.0,"text":"Nó hơi xém cạnh thì nó càng thơm"},{"time":171.4,"text":"Dạ, giờ mình sẽ áp chảo những cái mặt còn lại của miếng thịt bò"},{"time":175.0,"text":"Mình sẽ áp chảo những cái mặt còn lại"},{"time":177.1,"text":"Các bạn khán giả lưu ý là thịt bò chúng ta nên áp chảo cho thịt bò chín vừa"},{"time":180.8,"text":"Để thịt bò mềm và ngọt thịt"},{"time":182.5,"text":"Chúng ta sẽ cắt lát thịt bò này ra"},{"time":184.8,"text":"Bên ngoài thì xém cạnh"},{"time":186.6,"text":"Bên trong thì vẫn còn giữ được độ mọng nước"},{"time":190.4,"text":"Cũng như là một cái màu hồng"},{"time":191.6,"text":"Hồng nhẹ rất là đẹp"},{"time":193.0,"text":"Mình sẽ bỏ ra đây"},{"time":196.4,"text":"Chúng ta sẽ trộn phần salad này lên hết"},{"time":198.8,"text":"Chùng với nhau"},{"time":199.8,"text":"Húng lũi này nè"},{"time":201.5,"text":"Nó cũng rất là thơm"},{"time":202.9,"text":"Và mình sẽ cho phần cà rốt mà Minh Phương cắt lúc nãy"},{"time":206.3,"text":"Dưới là ớt"},{"time":207.5,"text":"Và phần hành tím lúc nãy mình đã ngâm đá và để ráo rồi"},{"time":210.6,"text":"Phần thơm này là phần đổi vị"},{"time":212.6,"text":"Cái vị giác của mình, phần thịt bò thì mình nên xếp lên trên"},{"time":215.9,"text":"Thơm nó có phần enzyme nó làm thịt bò của chúng ta rất là nhanh mềm"},{"time":220.0,"text":"Cho hết phần nước sốt vào"},{"time":221.5,"text":"Rau má được xem là một loại thuốc quý"},{"time":224.1,"text":"Không những là tốt cho hệ tiêu hóa mà còn thanh lọc, thanh nhiệt"},{"time":229.3,"text":"Giúp làm đẹp da và giảm thâm"},{"time":232.2,"text":"Cho nên là chị em phụ nữ dạo gần đây cũng có những loại mỹ phẩm"},{"time":235.4,"text":"Có tinh chất rau má ở trong đó giúp cho căng bóng và giảm những vết thâm ở trên da nữa"},{"time":239.8,"text":"Đúng rồi"},{"time":240.2,"text":"Các bạn khán giả ơi, đừng quên lưu lại công thức của món ăn ngày hôm nay bằng cách rất là đơn giản"},{"time":244.8,"text":"Mã QR đang hiện trên màn hình, hãy dùng điện thoại di động để quét mã này"},{"time":248.5,"text":"Lưu lại công thức ngay các bạn nha"},{"time":252.4,"text":"Tới công đoạn chúng ta sẽ ra món thôi"},{"time":255.3,"text":"Rất là hấp dẫn, về màu sắc thì không thể nào chê được"},{"time":258.5,"text":"Từng lát thịt bò chúng ta sẽ xếp đều trên bề mặt của dĩa salad đúng không ạ?"},{"time":262.5,"text":"Đúng rồi, phần tỏi phi để tăng thêm mùi thơm"},{"time":265.8,"text":"Cái phần tỏi mình áp chảo lúc nãy nè"},{"time":267.5,"text":"À"},{"time":267.9,"text":"Cho lên luôn"},{"time":269.3,"text":"Chúng ta sẽ cho thêm cái phần sốt mayonnaise ajimayo vị miên bản lên trên nữa"},{"time":274.1,"text":"Với món ăn này chúng ta sẽ sử dụng sốt mayonnaise ajimayo vị miên bản"},{"time":278.2,"text":"Giúp tăng thêm vị béo cho món ăn nha"},{"time":279.9,"text":"Và ở đây mình cũng chúc quý vị khán giả thực hiện thành công cái món này nha"},{"time":283.5,"text":"Vì rau má nhẫn nhẫn, có chút béo béo của mayonnaise"},{"time":286.8,"text":"Thịt bò mềm ngọt cùng với nước sốt thơm thơm"},{"time":290.1,"text":"Vừa lạ miệng vừa thanh nhiệt cơ thể"},{"time":292.3,"text":"Nếu như các bạn đang tìm một món ăn vừa ngon vừa tốt cho sức khỏe"},{"time":298.6,"text":"Mà lại đẹp da thì không thể bỏ qua món salad bò rau má"},{"time":302.9,"text":"Và các bạn có thể xem thêm nhiều công thức của những món ăn ngon"},{"time":305.9,"text":"Bằng cách truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":310.5,"text":"Xin chào và hẹn gặp lại"}]}