time":42.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":45.3,"text":"Anh Long nè, hôm nay mình sẽ làm món gì mà Thân Phương thấy hấp dẫn quá"},{"time":49.5,"text":"Có thịt cua nè"},{"time":50.4,"text":"Rồi, em hỏi nha"},{"time":51.6,"text":"Em thích ăn cua không?"},{"time":52.8,"text":"Em thích"},{"time":53.3,"text":"Em thích ăn súp không?"},{"time":54.8,"text":"Cũng thích luôn"},{"time":55.5,"text":"Em thích ăn lẩu thái không?"},{"time":56.9,"text":"Trời ơi, món này là hết sảy luôn"},{"time":58.1,"text":"Hôm nay em sẽ nấu em 3 món trong 1"},{"time":61.1,"text":"Hôm nay chúng ta thực hiện món súp cua vị thái."},{"time":65.0,"text":"Bây giờ mình chuẩn bị khâu chế biến nha."},{"time":66.9,"text":"Phần mà dễ nhất là cắt thái về chế biến là Thanh Phương làm nha."},{"time":70.5,"text":"Nấm thì mình xé nhỏ ra xong mình cắt làm đôi."},{"time":73.0,"text":"Trong nấm kim châm này thì có chứa vitamin B và có chất để kiểm soát cholesterol rất là tốt."},{"time":79.4,"text":"Chính vì vậy thì sẽ giúp cho cơ thể của chúng ta khỏe mạnh hơn và đặc biệt là phát triển trí não nữa."},{"time":85.5,"text":"Với những cái mấu súp mà có phần nấm nó ăn nó vừa ngọt nước mà nó vừa có cảm giác là nó sừng sực rất là ngon"},{"time":91.8,"text":"Nấm lông cô thì mình cắt lát"},{"time":98.6,"text":"Cà rốt lông sẽ cắt thành những sợi nhỏ"},{"time":104.8,"text":"Cái đến mình sẽ chuẩn bị cái phần sơ chế cua"},{"time":107.8,"text":"Cho đây một xíu gừng cắt lát"},{"time":111.3,"text":"Một muỗng canh rượu trắng"},{"time":113.3,"text":"Nước sôi rồi mình sẽ chuẩn bị một cái rây để mình cho cua vào"},{"time":117.7,"text":"Mình trần qua đây"},{"time":119.4,"text":"Để cho cái phần của mình nó ngon hơn nữa và nó tốt hơn mình sẽ ép cái phần nước ra"},{"time":123.7,"text":"Cho nó ráo nước đi. Mình cho vào đây một xíu tiêu."},{"time":128.2,"text":"Mùi thơm của gừng, của rượu hòa cùng với lại tiêu."},{"time":131.9,"text":"Làm chạy ra có mùi thịt cua rất thơm."},{"time":134.0,"text":"Như vậy là vừa xong công đoạn sơ chế."},{"time":135.6,"text":"Chúng ta có một cái nồi nước dùng gà mà Long đã chuẩn bị từ trước."},{"time":138.5,"text":"Rồi anh cho cà phốt vô nha Thanh Phương."},{"time":139.9,"text":"Dạ."},{"time":141.8,"text":"Đây là nấm nha."},{"time":144.4,"text":"Tiếp đến là nấm kim châm."},{"time":148.8,"text":"Rồi bây giờ bà sẽ cho phần cua vào."},{"time":150.6,"text":"Với một lít nước dùng thì Long sẽ nêm vào đây một muỗng canh rưỡi gia vị nêm sẵn Aisequid Lẩu Thái."},{"time":156.4,"text":"Đối với bữa ăn này chúng ta sử dụng lại gia vị nêm sẵn"},{"time":158.5,"text":"Ajiquit lẩu thái để cho món ăn có hương vị mới lạ và thơm ngon hơn"},{"time":161.9,"text":"2 muỗng cà phê đường"},{"time":165.8,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":169.0,"text":"Thường để có vị thái đó anh Long"},{"time":170.6,"text":"Thành phương thấy là phải có thêm đá trúc nè"},{"time":172.5,"text":"Rồi chanh nè, rồi xá, rồi ớt"},{"time":174.8,"text":"Riền nè"},{"time":175.2,"text":"Riền v.v"},{"time":176.2,"text":"Rất là lĩnh kĩnh nhiều loại gia vị"},{"time":177.8,"text":"Nhưng chỉ cần 1 muỗng rưỡi cho vào trong phần sếp này thôi"},{"time":181.4,"text":"Với lại 1 đít nước dùng"},{"time":182.5,"text":"Đã có được vị thái đúng chuẩn rồi"},{"time":184.8,"text":"Món súp này cũng rất là dinh dữ luôn các bạn ạ"},{"time":187.2,"text":"Có nhiều nấm nè, có chứa protein và đặc biệt là trong thịt cua nha"},{"time":190.3,"text":"Thịt cua có chứa canxi và folate"},{"time":192.6,"text":"Sẽ giúp cho cơ thể của chúng ta chống mệt mỏi, xuyên nhược cơ thể và chống chứa máu nữa"},{"time":197.3,"text":"Pha 3 muỗng canh bột năng với lại 1 phần 3 chén nước vào"},{"time":200.3,"text":"Từ từ trong nồi súp của mình"},{"time":203.0,"text":"Bây giờ chúng ta sẽ đánh trứng"},{"time":207.5,"text":"Sau khi đánh trứng thì mình sẽ dùng rây cho trứng vào nồi để tạo vân mây"},{"time":214.8,"text":"Bây giờ là nồi súp đã trông rất là hấp dẫn và có màu sắc của con bắt mắt luôn"},{"time":218.8,"text":"Các bạn lưu ý là với món súp thì chúng ta hãy cho bột năng vào trước"},{"time":222.8,"text":"Sau đó chúng ta hãy cho trứng vào để tạo vân mây được đẹp hơn"},{"time":225.8,"text":"Rồi như vậy là mình đã hoàn thành xong món súp cua vị thái của ngày hôm nay"},{"time":230.3,"text":"Các bạn có thể xem lại công thức của món ăn ngày hôm nay bằng cách quét mã QR đang hiển thiện trên bàn hình"},{"time":237.0,"text":"Và Long sẽ dọn ra và mời mọi người cùng thưởng thức"},{"time":239.3,"text":"Nấm và rau củ quả vừa chín tới nên vẫn còn chữ được độ giòn và vị ngọt tự nhiên"},{"time":245.0,"text":"Còn thịt cua thì thơm lừng và từng thớ thịt cua trông rất là hấp dẫn luôn"},{"time":263.5,"text":"Như vậy là chúng ta đã có được một món súp cua vị thái"},{"time":268.1,"text":"Rất là thơm ngon, hấp dẫn cho buổi sáng rồi"},{"time":270.6,"text":"Món này thì sẽ ăn kèm với những món nào khác ạ?"},{"time":273.0,"text":"Bữa bữa ăn này thì chúng ta sẽ ăn kèm với món là ba rội, sả ớt, tẩm bột chiên giòn"},{"time":277.8,"text":"Súp cua sánh thơm, vân trứng vang đều hấp dẫn"},{"time":281.0,"text":"Thịt cua ngọt, rau củ giòn, chua cay hài hòa"},{"time":284.6,"text":"Nông thơm vị thái, ấm bụng ngay từ muỗng đầu tiên"},{"time":291.7,"text":"Làm ấm cơ thể với món súp cua vị Thái ngon nhất ngay thôi các bạn ơi"},{"time":296.1,"text":"Ngoài ra các bạn có thể truy cập vào kênh youtube, website và fanpage của Món Ngon Mỗi Ngày"},{"time":300.6,"text":"Để tìm hiểu về công thức nấu các món ăn ngon"},{"time":303.1,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại"}]}