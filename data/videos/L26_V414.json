 · Bn quyn kch bn và cu trúc · Công ty HKFilm · Ht nêm Aji-ngon Heo · Lòng tráng trúng gà: 1 qu · Tóm sú: 200g · Giò sóng: 50g · Hành tím: 3 cù · Phi hp thc hin · Rau càn nuóc: 1bó · Mānuóc: 2M · Hành lá: 1it · Thc hin chương trình · Công ty C · chuơng trình thuc · ĐÀI TRUYÊN HìNH TP. HCM · Cóng ty A · Thc hié"}],"speech":[{"time":12.6,"text":"Hôm nay mình nấu món gì cô?"},{"time":14.2,"text":"Trời, rau cần"},{"time":17.1,"text":"Cô biết em không ăn được cần"},{"time":18.5,"text":"Mà hôm nay cô nấu món có cần"},{"time":20.5,"text":"Không ai thương mình"},{"time":22.1,"text":"Tuấn à, đừng nói là vậy nè"},{"time":24.0,"text":"Cô không biết là hôm nay em làm MC"},{"time":27.3,"text":"Nhưng mà cô sẽ"},{"time":28.3,"text":"Hương yêu Tuấn theo cách của cô"},{"time":29.9,"text":"Rau cần này có công dụng rất là tốt"},{"time":31.9,"text":"Ngoài cái việc giàu vitamin C, vitamin A"},{"time":34.8,"text":"Thì trong rau cần này có chứa nhiều chất sơ"},{"time":37.2,"text":"Ăn thì cũng giòn giòn nữa"},{"time":38.7,"text":"Cô sẽ nấu món này thật ngon"},{"time":40.5,"text":"Để cho Tuấn thưởng thức món rau cần một cách rất là thú vị"},{"time":43.2,"text":"Vô"},{"time":46.0,"text":"Canh tôm rau cần nước"},{"time":47.4,"text":"Giòn ngon, ngọt mát, ăn là mê ly"},{"time":66.5,"text":"Chào mừng các bạn đang đến với chương trình món ngon mỗi ngày"},{"time":69.2,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":73.3,"text":"Đầu tiên là tôm xú"},{"time":74.7,"text":"Sẻ lột, sạch hết vỏ"},{"time":76.2,"text":"Rồi mình bỏ cái chỉ lưng"},{"time":78.3,"text":"Và cô Hà trừ lại 3 cái con này nè"},{"time":80.7,"text":"Mình trừ cái đuôi lại cho đẹp"},{"time":81.7,"text":"Trang trí"},{"time":82.2,"text":"Đúng rồi"},{"time":83.0,"text":"Tuấn giúp cho cô Hà một cái cối"},{"time":85.8,"text":"Mình sẽ đập dập sơ ha"},{"time":87.2,"text":"Rồi cô cho vô đây"},{"time":89.1,"text":"Rồi Tuấn sẽ giả giúp cô"},{"time":93.4,"text":"Cô sẽ cho thêm cái phần mà đầu hành lá"},{"time":96.0,"text":"Rồi mình sẽ cho đầu hành vô"},{"time":97.7,"text":"Cho nửa muỗng cà phê tiêu"},{"time":99.0,"text":"Và nửa muỗng cà phê hạt nêm Ajinon heo"},{"time":101.5,"text":"Tuấn sẽ giả giùm cô"},{"time":106.4,"text":"Hơi nhuyễn nhuyễn xong rồi là em sẽ đổ"},{"time":108.4,"text":"Rồi mình sẽ cho từ từ lòng trắng trứng gà vô"},{"time":110.1,"text":"Dạ rồi"},{"time":110.6,"text":"Các bạn lưu ý là chúng ta sẽ thêm lòng trắng trứng gà vào khi quết tôm"},{"time":115.0,"text":"Để cho chả tôm có độ kết dính và viên tôm không bị khô ha"},{"time":118.6,"text":"Cho thêm giò sống vào mình, quết chung một lúc nữa là được"},{"time":122.1,"text":"Hành tím rất là đơn giản, chúng ta sẽ cắt lá"},{"time":126.7,"text":"Rồi mình sẽ cắt đôi cà chua bi"},{"time":131.4,"text":"Rồi tiếp theo cần nước"},{"time":132.8,"text":"Chúng ta sẽ chọn cần nước mà có cái phần cộng màu trắng dài"},{"time":136.1,"text":"Và ít lá thì sẽ là cần nước no và ngon"},{"time":139.1,"text":"Và mình sẽ ngâm nó vào trong nước vo gạo"},{"time":141.7,"text":"Rồi sau đó mình rửa lại như vậy thì nó sẽ rất là ngon"},{"time":144.3,"text":"Rồi bây giờ thì mình sẽ cắt khúc nó khoảng chừng 4 phần"},{"time":147.7,"text":"Cần nước xong rồi"},{"time":148.9,"text":"Thì cuối cùng cắt hành lá còn lại làm rau nêm"},{"time":152.6,"text":"Mình cắt khoảng chừng 2 phân là được"},{"time":155.3,"text":"Cô đã chuẩn bị xong thì mình đây em cũng đã quất xong rồi"},{"time":157.5,"text":"Do riêng giùm cô đi"},{"time":158.5,"text":"Đầu tiên mình sẽ tha 1 miếng nước lên không cô"},{"time":160.2,"text":"Bây giờ thì chúng ta sẽ bắt 1 cái nồi lên trên bếp"},{"time":166.4,"text":"Để mà mình nấu canh"},{"time":167.3,"text":"Cho vào đây khoảng chừng 2 muỗng canh mỡ nước"},{"time":169.7,"text":"Cho hành tím vào mình phi cho thơm"},{"time":174.5,"text":"Rồi bây giờ mình sẽ cho cà chua bi vào đây"},{"time":177.5,"text":"Tướng có ngửi thấy là cái ngùi hành phi rất là thơm"},{"time":180.6,"text":"Dạ"},{"time":181.5,"text":"Mình sẽ nêm vào đây nửa muỗng cà phê muối"},{"time":183.7,"text":"1 muỗng cà phê đường"},{"time":185.1,"text":"Cho cô vào đây khoảng chừng 1 lít 2 nước"},{"time":187.2,"text":"Các bạn lưu ý là chúng ta sẽ xào cà chua với chất béo để giúp hòa tan tiền vitamin A có trong cà chua"},{"time":193.6,"text":"Thì cơ thể sẽ dễ hấp thụ thơm và món ăn cũng sẽ có màu đẹp hơn ha"},{"time":197.6,"text":"Bây giờ mình sẽ cho 3 con tôm vô"},{"time":200.0,"text":"Cho lần lượt các viên tôm này vô trong đây luôn, mình nấu lên"},{"time":203.2,"text":"Tiếp theo thì chúng ta sẽ nêm gia vị vào đây"},{"time":205.5,"text":"Nửa muỗng canh hạt nêm Azi con heo"},{"time":209.0,"text":"Nửa muỗng cà phê muối"},{"time":210.4,"text":"Rồi mình đợi cho nước nó sôi lại khoảng chừng 3 phút để cho phần tôm và các viên tôm nó ra nước ngọt ha"},{"time":216.6,"text":"Rồi bây giờ mình xuống cùng mình sẽ cho cái phần cần vô"},{"time":220.4,"text":"Rau cần này thì mình sẽ không nấu lâu quá"},{"time":222.5,"text":"Nấu vừa chín tới thôi để cho nó còn cái độ giòn"},{"time":225.4,"text":"Và trong nước canh của mình nó có vị chua nhẹ của cà chua"},{"time":228.4,"text":"Cho nên mình nấu nhanh thì rau nó sẽ không bị chuyển màu"},{"time":231.4,"text":"Rồi mình đợi cho nước sôi lại ha"},{"time":233.4,"text":"Khi nước vừa sôi trở lại thì bây giờ em tắt bếp với cô đi Tú"},{"time":237.0,"text":"Cảm ơn em"},{"time":237.7,"text":"Mình sẽ cho nửa muỗng canh nước mắm"},{"time":239.6,"text":"Rồi cô cho luôn phần hành lá vô"},{"time":241.6,"text":"Bây giờ giòn ra và mời mọi người thưởng thức"},{"time":246.5,"text":"Mình sẽ múc canh ra tô"},{"time":249.8,"text":"Những cái viên tôm rất là hấp dẫn"},{"time":252.6,"text":"Xen lẫn với loại màu của cà chua nè"},{"time":255.5,"text":"Hương vị của rau cần nè"},{"time":257.1,"text":"Sau đó thì mình sẽ gắp từng cái con tôm mà mình chừa lại mình để lên nha"},{"time":261.3,"text":"Cho thêm một ít tiêu"},{"time":264.2,"text":"Rất là thơm luôn"},{"time":265.4,"text":"Và để tạo thành một bữa ăn hoàn chỉnh"},{"time":267.5,"text":"Thì món ăn này chúng ta có thể kết hợp với món sườn kho đậu hủ non"},{"time":270.5,"text":"Và rau củ xào hỷ lạc các bạn nha"},{"time":272.8,"text":"Nghe có vẻ ngon nữa cô"},{"time":274.2,"text":"Và đặc biệt là cả hai món này"},{"time":276.5,"text":"Thì công thức cũng có sẵn trên website mongomongi.com nha"},{"time":280.0,"text":"Món ăn với phần nước canh trong, ngọt lư vị tôm, thơm lưng mùi rau cần chín giòn"},{"time":286.2,"text":"Đúng là một món ăn thanh mát cho sức khỏe của bạn"},{"time":288.9,"text":"Một món ăn rất đơn giản, dễ làm nhưng lại thanh mát và bổ dưỡng nữa"},{"time":293.2,"text":"Các bạn hãy thực hiện ngay tại nhà của mình nha"}]}