e":88.1,"text":"Mẹ dìu mình ra nhà tắm"},{"time":93.6,"text":"Thì nó bắt đầu nổi nhiều hơn"},{"time":95.9,"text":"Và nó kết thành mãn"},{"time":97.4,"text":"Toàn thân luôn, tay, chân"},{"time":99.5,"text":"Nói chung là chân full hết luôn"},{"time":101.7,"text":"Hình như hầu như là gần 80% cơ thể"},{"time":104.3,"text":"Mà căn bệnh này nói rằng là đừng có stress"},{"time":106.8,"text":"Trét là sẽ nặng hơn nữa"},{"time":110.1,"text":"Nhưng mà thật ra là không thể không trét được"},{"time":114.0,"text":"Bởi vì mình từng là một cô gái rất là năng động"},{"time":116.8,"text":"Rất là nhiều năng lượng và tự tin vào bản thân của mình"},{"time":119.5,"text":"Tự nhiên mắc một căn bệnh mà nặng cũng thẩm mỹ nhiều"},{"time":122.7,"text":"Nên như thế mình cần trét hơn chứ không thể nào không trét được"},{"time":133.7,"text":"Gia đình họ hàng ai chỉ cách nào thì mình làm theo cách đó"},{"time":138.5,"text":"Từ đông y, tây y, thuốc đam đầy đủ hết"},{"time":142.0,"text":"Cái gì mình cũng làm"},{"time":143.2,"text":"Nhưng mà càng làm lại càng nặng"},{"time":145.4,"text":"Và nặng nhất là toàn thân luôn"},{"time":148.4,"text":"Mình không ngủ được"},{"time":149.6,"text":"Thì mẹ cũng thức"},{"time":150.9,"text":"Mẹ phải lấy quạt tay cho mình"},{"time":154.3,"text":"Trên những cái lưng nè"},{"time":156.3,"text":"Đằng sau lưng, bụng"},{"time":157.8,"text":"Để cho nó dịu bớt đi"},{"time":160.9,"text":"Mà trong khi đó là sáng mẹ phải"},{"time":163.0,"text":"Buôn bán dậy sớm"},{"time":164.9,"text":"4h sáng mới dậy rồi"},{"time":167.5,"text":"Mình chỉ còn trở mình một chút xíu thôi"},{"time":170.3,"text":"Mẹ lại là giật mình"},{"time":171.7,"text":"Mẹ hỏi đau được hả con"},{"time":174.7,"text":"Nên lúc đó thì thực sự là rất là thương mẹ"},{"time":179.0,"text":"Và mình bắt đầu mình quay lại Sài Gòn làm việc"},{"time":181.8,"text":"Mình cũng chỉ ở các mình thôi"},{"time":183.5,"text":"Ý là mình cũng tách gia đình ra để cho mẹ rất là bớt lo"},{"time":186.4,"text":"Và mình cũng giấu mẹ"},{"time":188.8,"text":"Quay lại Sài Gòn thì một tháng thôi"},{"time":190.6,"text":"Cái này bùng nặng như thế như vậy nữa"},{"time":193.1,"text":"Vô cùng đau đớn"},{"time":194.2,"text":"Nhưng mà lại giấu mẹ"},{"time":196.2,"text":"Nói con không sao cả"},{"time":197.2,"text":"Mỗi lần mẹ hỏi xong là nói con không sao"},{"time":206.3,"text":"Vì như là đêm nào cũng"},{"time":208.1,"text":"Đêm nào cũng là"},{"time":209.9,"text":"Giá như là sau đêm nay mình đừng có thức dậy nữa"},{"time":214.4,"text":"Mình nói mong sống như kiểu như vậy"},{"time":217.5,"text":"Bởi vì nếu có cơ thể này mình không làm được gì hết"},{"time":220.4,"text":"Mình sẽ sống như một người ông không có giá trị"},{"time":223.0,"text":"Thì sống như làm gì"},{"time":224.6,"text":"Làm đớn gì nữa, ảnh hưởng người thân gì nữa"},{"time":226.5,"text":"Mình không muốn"},{"time":227.8,"text":"Cứ lúc nào của mình cũng nói là"},{"time":229.3,"text":"Tối nào mình cũng cần nguyện là"},{"time":231.8,"text":"Cho tôi sống như vậy nữa"},{"time":235.5,"text":"Nhiều lần là mình đã quyết định mua thuốc ngủ về rồi đó"},{"time":238.6,"text":"Mình vương gia đình"},{"time":239.7,"text":"Mình sợ gỡ lại buồn"},{"time":242.9,"text":"Và sốc"},{"time":244.8,"text":"Vì bà rất là khổ"},{"time":249.9,"text":"Mình thấy cái hành trình bà sống không chồng"},{"time":253.9,"text":"Và một mình nuôi hai đứa con"},{"time":255.7,"text":"Nó đau khổ lắm"},{"time":259.6,"text":"Mẹ nhiều khi lại còn nói"},{"time":261.5,"text":"Trời tao già rồi"},{"time":262.9,"text":"Sao mày không để con bệnh này cho tao đi"},{"time":267.9,"text":"Mẹ khùng quá"},{"time":268.8,"text":"Con không chịu đau được mà"},{"time":272.9,"text":"Thật ra bệnh đến là không ai có muốn cả"},{"time":277.1,"text":"Không ai được chọn lựa là"},{"time":278.8,"text":"Tôi thấy mất bệnh gì, bệnh gì khi đến với cuộc đời này"},{"time":295.3,"text":"Mình làm xét nghiệm máu tất cả các kiểu"},{"time":297.2,"text":"Là được cơ thể mình đáp ứng được thứ sinh học"},{"time":300.5,"text":"Và bác sĩ trao tim"},{"time":302.0,"text":"Là mình đã rất là vui mừng tại bệnh viện rồi"},{"time":305.9,"text":"Cứ chạy tung tăng ra chỗ tiệc photo"},{"time":308.9,"text":"Rất là vui, rất là háo thức"},{"time":310.4,"text":"Bởi vì đó là mình sống rồi"},{"time":311.9,"text":"Mình được sống rồi"},{"time":317.3,"text":"Mũi đầu tiên là nó sẽ ngưng thành hình bẫy"},{"time":320.5,"text":"Là cảm thấy người nó sẽ bớt căng cứng"},{"time":323.7,"text":"Sau khi tìm hết liệu trình"},{"time":325.8,"text":"Thấy cơ thể mình phản ứng vào tích cực"},{"time":328.3,"text":"Rất là hạnh phúc"},{"time":329.1,"text":"Rất là biết ơn cuộc sống này"},{"time":330.6,"text":"Biết ơn là còn cách để chữa"},{"time":332.7,"text":"Biết ơn còn phương pháp này"},{"time":335.3,"text":"Để mà lấy lại cuộc đời cho mình"},{"time":344.2,"text":"Phong biệt mình vẫn đang tốt hơn"},{"time":345.7,"text":"Mình sống lạc quan, vui vẻ hơn"},{"time":347.4,"text":"Và năng lượng hơn"},{"time":348.8,"text":"Mình có thể là mang năng lượng đó"},{"time":351.6,"text":"Vui vẻ, đáp đại cho mẹ"},{"time":353.7,"text":"Rồi yêu thương mẹ nhiều hơn, chăm sóc mẹ"},{"time":355.7,"text":"Tạm ngay"}]}