.2,null],["L30_V076",323,12.9,2],["L30_V091",4937,197.4,45],["L22_V031",7390,295.6,76],["L30_V023",3586,143.4,37],["L30_V068",6105,244.2,37],["L30_V064",5181,207.2,59],["L22_V007",9119,364.7,106]]]],"onScreen":[{"time":0.1,"until":2.9,"text":"tv.tuoitre.vn"},{"time":4.7,"until":7.1,"text":"Herbalife · Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.7,"until":14.1,"text":"Herbalife · Cuc thi Lan ta năng lung tích cc 2024: · CAM · Tm lòng ca mt v lương y · XABIP · NHOPE"},{"time":14.5,"until":17.6,"text":"Herbalife · Cuc thi Lan ta năng lung tích cc 2024: · Tm lòng ca mt v lương y"},{"time":19.8,"until":19.8,"text":"Cuc thi Lan ta năng lung tích cc 2024: · Herbalife · Tm lòng ca mt v lương y"},{"time":20.4,"until":24.3,"text":"Herbalife · tuoitre · Cuc thi Lan ta năng lung tích cc 2024: · CÂY THUC QUANH TA · Tm lòng ca mt v lương y · THIÈN NHIÈN BAN TANG · YST-LUONG Y GIUSE NGUVN VAN LONG · fubitreTV · Tám long cua moi v luong y"},{"time":26.6,"until":26.8,"text":"tuöitrerv"},{"time":27.8,"until":33.2,"text":"tuoitre"},{"time":47.2,"until":47.8,"text":"tuoitrerv"},{"time":48.3,"until":50.6,"text":"CAN · HANG DE VO · DAI H · tuöitreV · MHAUR · DAI"},{"time":51.2,"until":51.2,"text":"CAM · UONG · IGATR · WG CUT"},{"time":52.6,"until":57.5,"text":"tuoitre"},{"time":57.9,"until":61.5,"text":"tuoitre"},{"time":62.1,"until":65.4,"text":"tuoitre"},{"time":69.5,"until":72.2,"text":"Auoitre · MubitreTy"},{"time":72.6,"until":77.9,"text":"tuoitre · AuoitreTV · tubitrev"},{"time":78.2,"until":81.1,"text":"tuoitre · THIÈN NHIÈN BAN TANG · TubitreTV · YST-LUONG Y GIUSE NGUVENVANLONG · CÃY THUÖC QUANH TA"},{"time":82.4,"until":84.2,"text":"tubitrery · tusitlery"},{"time":84.5,"until":85.9,"text":"tuoitrery"},{"time":86.1,"until":128.0,"text":"tuoitre · 50 NAM HANH NGHE THUOC DONG · THU MOI TIEC · DiChing · Lugng · Enong · Di Ching · Chst · Lityng · Del Efing · Liugng"},{"time":128.3,"until":133.2,"text":"CÂY THUÕC QUANH TA · Y Sǐ - LUONG Y GIUSE NGUYĚN VÁN LONG · TIÈN NHIÈ · GA-YANG · TMIÊN NHIE"},{"time":134.0,"until":140.4,"text":"tuoitrety · DAI HO · TUB · Eachchi · Enukch · NGOMBI · hank · REba"},{"time":140.6,"until":143.3,"text":"CAM · CAN · XA BIP · Chum3 · NTh"},{"time":150.2,"until":150.7,"text":"tuöitrerv"},{"time":151.4,"until":157.2,"text":"tuoitre"},{"time":158.8,"until":162.0,"text":"Herbalife · Tác già: Minh Chin"},{"time":162.3,"until":165.5,"text":"Tác gi: Minh Chin · Herbalife"},{"time":165.8,"until":168.4,"text":"Tác gi: Minh Chin · Herbalife"}],"speech":[{"time":13.4,"text":"Nguồn dược liệu để ông cứu chữa người bệnh là mảnh vườn diện tích khoảng 1.000m2 nằm ngay sau nhà."},{"time":19.7,"text":"Tại đây ông đã trồng nhiều loại cây thuốc nam quý hiến đang được phát triển rất tốt như bồ công anh, kim ngân, xuyên tâm liên, đinh lăng, sáo tam phân, mật gấu, mật nhân, rễ quạt."},{"time":31.3,"text":"Ông đã theo nghề bốc thuốc chữa bệnh từ năm 1972 đến đây."},{"time":35.6,"text":"Với ông, nghề này niềm vui lớn nhất là được chữa trị thành công cho các bệnh nhân."},{"time":40.7,"text":"Những bệnh nhân nào không chữa trị được, ông rất đau đáu và trăng trở."},{"time":44.7,"text":"Theo người dân địa phương, Lương Y Long có nhiều bài thuốc gia truyện rất hay, rất dễ sử dụng,"},{"time":50.3,"text":"nên thường tới đây để lấy thuốc chữa bệnh cho gia đình mỗi khi bị cảm, trái gió trở trời."},{"time":55.4,"text":"Đặc biệt, thầy Long có bài thuốc chuyên dụng cho sản phụ và trẻ sơ sinh,"},{"time":59.4,"text":"giúp sản phụ mau hồi phục sức khỏe, trẻ sơ sinh không bị mẩn ngứa, quấy khóc."},{"time":64.7,"text":"Đến thời điểm này, ông vẫn không nhớ hết đã khám chữa bệnh cho bao nhiêu người có hoàn cảnh khó khăn,"},{"time":70.2,"text":"Chỉ tính riêng 3 năm trở lại đây, ông đã khám chữa bệnh cho khoảng 300 người dân có hoàn cảnh khó khăn."},{"time":76.4,"text":"Trong thời gian tới, Lương Y Lông tiếp tục làm công tác từ thiện,"},{"time":80.2,"text":"chữa trị cho các hộ dân trên địa bàn huyện Cam Lâm và thành phố Cam Ranh."},{"time":85.6,"text":"Y tế quy định ở tiến xã người thầy thuốc điều trị bệnh trứng song thường ở tiến xã và hội y tế đã quy định."},{"time":98.7,"text":"Ngoài ra, mỗi một tuyến xã, các thầy thuốc phải trồng vườn cây thuốc nam mẫu để hướng dẫn cho đồng bào, gồm các bệnh, cảm, ho, bị răng thấp, điều kinh, thuốc bổ trông, bảy bệnh thông thường ở tuyến xã mà vội theo quy định."},{"time":128.9,"text":"Lương y Nguyễn Văn Long cũng được Ban chấp hành Trung ương Hội đồng y Việt Nam tặng bằng khen"},{"time":133.5,"text":"vì đã có thành tích trong công tác thử kế, bảo tồn muôn thuốc, bài thuốc và phương pháp chữa bệnh của đồng y"},{"time":139.8,"text":"Ngoài ra các cấp chính quyền đã tặng nhiều bằng khen, giấy khen"},{"time":143.4,"text":"Không những giỏi trong khám chữa bệnh cho người nghèo"},{"time":146.4,"text":"mà lương y Nguyễn Văn Long còn là một võ sư thứ thiệt"},{"time":149.9,"text":"Đây là võ sư cổ truyền Việt Nam đẳng cấp thứ 18"},{"time":153.5,"text":"Ông Long còn là hướng dẫn viên môn dưỡng sinh và thái cực trường sinh"},{"time":157.2,"text":"Chủ nhiệm Công lạc Bộ Dưỡng sinh của xã trực tiếp đào tạo, huấn luyện về dưỡng sinh cho người cao tuổi tại khu vực Cam Lâm, Cam Rành"}]}