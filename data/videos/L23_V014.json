{"time":89.0,"text":"Và lúc này các tay đua đã bắt đầu quẹo phải qua công viên thiếu nhi Quy Nhơn"},{"time":99.7,"text":"Vẫn là những chiếc máy kéo mạnh mẽ với tốc độ cao của 620 Châu Thới Vĩnh Long"},{"time":104.4,"text":"Họ đã vào đến đường Xuân Diệu rồi"},{"time":106.2,"text":"Và bây giờ sẽ là giờ phút mà chúng ta chờ đợi những cuộc cạnh tranh cực kỳ mãn nhãn"},{"time":110.6,"text":"Đến đến trong trận đua ngày hôm nay"},{"time":114.1,"text":"Vẫn còn 4 chiếc máy kéo ở phía trước Mạc Tinh Lát"},{"time":116.5,"text":"Ngay sau Mạc Tinh Lát là Lê Nguyệt Minh và Trần Tuấn Kiệt"},{"time":120.6,"text":"Thêm 1 máy kéo nữa của Vĩnh Long đã tách ra"},{"time":124.4,"text":"Vĩnh Long còn 3 chiếc máy kéo ở phía trên"},{"time":126.2,"text":"Ngay trước Martin Las"},{"time":127.6,"text":"Martin Las đang cố gắng tràn lên phía trước Peter Rikunov"},{"time":132.7,"text":"Để có một vị trí thuận lợi hơn"},{"time":135.7,"text":"Liệu Peter Rikunov sẽ chọn đeo bám Martin Las"},{"time":138.0,"text":"Hay là sẽ làm một mũi riêng với người động đội Roman Maikin của mình"},{"time":143.0,"text":"Lê Nguyệt Minh cũng đang bám rất sát với Martin Las"},{"time":146.0,"text":"Và đi song song cùng với Peter Rikunov"},{"time":151.4,"text":"Sau lưng Lê Nguyệt Minh vẫn là Trần Tuấn Kiệt và Lê Văn Bình"},{"time":154.4,"text":"Nguyễn Văn Bình"},{"time":156.9,"text":"Một kinh hoạt cuối cùng"},{"time":158.0,"text":"Chắc chắn là Trần Tuấn Kiệt sẽ ngương theo tay đua Đồng Tháp ở phía trên mình để tách ra là một tông ri nữa"},{"time":163.6,"text":"Mặt Tinh Lát chỉ còn hai đầu máy kéo thôi"},{"time":169.4,"text":"Có vẻ như là Roman Maikin vừa chen vào ở phía sau Mikael Ram"},{"time":172.8,"text":"Và không để cho Mặt Tinh Lát có được một máy kéo thuận lợi"},{"time":177.5,"text":"Và đây sẽ là 500m cuối cùng"},{"time":179.3,"text":"Và nơi mà chúng ta sẽ chứng kiến các tay đua làm nước lớn để tốc độ lên cao nhất có thể"},{"time":186.5,"text":"Mikael Ram và Roman Maikin 500m cuối cùng"},{"time":189.2,"text":"Mikael Ram và Roman Maikin đang làm tốc độ rất cao"},{"time":192.0,"text":"Martin Lach vẫn đang có vị trí thuận lợi hơn Peter Rikunov"},{"time":196.3,"text":"Có vẻ như Martin Lach gặp sự cố kỹ thuật rồi"},{"time":201.1,"text":"Và bây giờ là Trần Tuấn Kiệt và Peter Rikunov"},{"time":203.9,"text":"Trần Tuấn Kiệt và Peter Rikunov"},{"time":205.4,"text":"Trần Tuấn Kiệt"},{"time":207.1,"text":"Chúng ta chờ đợi góc quay này để xác định xem tay đua nào là người về nhất"},{"time":210.9,"text":"Dường như là Trần Tuấn Kiệt"},{"time":213.6,"text":"Ở đây chúng ta có thể nhìn thấy bánh xe của Trần Tuấn Kiệt áp sát gần và đích hơn"},{"time":220.7,"text":"Và đó là chiến thắng chặn cho Trần Tuấn Kiệt"},{"time":223.2,"text":"Chứng thắng chặn thứ 2 ở cuộc đua năm nay cho tay đùa của Đô Ba Găng Đồng Tháp"},{"time":234.8,"text":"Trần Tuấn Kiệt, đó chính xác là Trần Tuấn Kiệt"},{"time":237.5,"text":"Bánh xe của Trần Tuấn Kiệt đã chạm vạch đích trước so với Peter Rikunov"},{"time":241.8,"text":"Khoảng cách chỉ tính có lẽ chỉ khoảng 2cm thôi"},{"time":246.4,"text":"Cú đẩy xe tuyệt vời của Trần Tuấn Kiệt"},{"time":253.5,"text":"Nếu quan sát kỹ những lá cờ ở hai bên bảng chữ A"},{"time":258.7,"text":"Và nếu có mặt tại hiện trường đích đến thì chúng ta đều có thể cảm nhận được gió tạc ngang rất mạnh"},{"time":284.5,"text":"Trần Tuấn Kiệt. Ở đây chúng ta"},{"time":287.1,"text":"có thể nhìn thấy bánh xe của Trần Tuấn Kiệt"},{"time":288.7,"text":"áp sát gần và đích hơn."},{"time":293.4,"text":"Và đó là chiến thắng chặn cho Trần Tuấn Kiệt."},{"time":296.1,"text":"Chiến thắng chặn thứ 2 ở cuộc đua"},{"time":297.6,"text":"năm nay cho tay đùa của"},{"time":308.6,"text":"đó chính xác là Trần Tuấn Kiệt."},{"time":310.5,"text":"Bánh xe của Trần Tuấn Kiệt đã"},{"time":312.0,"text":"chạm và đích trước so với Peter Rikunov."},{"time":315.0,"text":"Khoảng cách chỉ tính..."}]}