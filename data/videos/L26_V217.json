xt":"Rồi, cho một vài lát gừng vào"},{"time":45.9,"text":"Khoảng một muỗng canh đủ tránh"},{"time":47.8,"text":"Ở đây mình có thể chọn thịt cua hoặc là thịt càng cúm đều được nha"},{"time":51.9,"text":"Thịt càng cúm thì nó có nhiều thịt và miếng thịt nó dẹp nó sẽ đẹp mắt hơn"},{"time":55.6,"text":"Mình sẽ nên tách cái phần xương cua ở bên trong"},{"time":58.2,"text":"Thì cái lúc mà mình trộn salad thì nó sẽ ăn hấp dẫn hơn nha"},{"time":61.8,"text":"Nước cũng đã sôi rồi, Minh Phương sẽ cho phần thịt cua vào"},{"time":65.0,"text":"Chúng ta nên trộn thịt cua qua gừng với rượu để giảm mùi tăng của thịt cua nha"},{"time":69.3,"text":"Nó chỉ cần sôi lại là được"},{"time":71.7,"text":"Phần nước đã sôi trở lại rồi, Minh Phương sẽ vớt nhanh tay cái phần thịt cua này"},{"time":75.9,"text":"Nhưng mà phải nhớ là nhẹ tay nha các bạn"},{"time":79.1,"text":"Minh Phương sẽ cho thêm một ít tiêu vào trong để cho nó tăng cái mùi thơm của cái phần thịt cua"},{"time":83.4,"text":"Và bây giờ chúng ta bắt đầu công đoạn cắt cái phần rau củ này nha"},{"time":86.9,"text":"Với cái phần dưa leo, bỏ cái phần hạt đi"},{"time":90.6,"text":"Và chúng ta sẽ thái sợi hết"},{"time":94.9,"text":"Cần tây thì các bạn nên tước vỏ sẵn đi"},{"time":97.0,"text":"Xong đó mình sẽ chia làm 3 khúc"},{"time":100.4,"text":"Cắt sợi cho nó đều nhau luôn"},{"time":102.0,"text":"Nên lựa chọn cái phần cần tây non một tí xíu"},{"time":104.3,"text":"Nó sẽ giảm được cái mùi hăng của cần"},{"time":106.8,"text":"Tiếp theo là hành tây"},{"time":108.1,"text":"Hành tây chúng ta sẽ cắt khoang luôn"},{"time":111.9,"text":"Củ thị là này chúng ta sẽ cắt hồng đôi"},{"time":116.8,"text":"Và các bạn biết không"},{"time":117.7,"text":"Trong củ thị là thì có rất là nhiều chất estrogen"},{"time":120.7,"text":"Tốt cho nữ giới"},{"time":122.0,"text":"Cho nên đối với các bạn nữ"},{"time":123.4,"text":"Chúng ta nên chăm ăn các loại củ thì là nhiều chút xíu"},{"time":127.2,"text":"Thì sẽ tốt cho sức khỏe của mình"},{"time":128.5,"text":"Với món này chúng ta nên kết hợp với củ thì là"},{"time":131.0,"text":"Để tạo thêm vị mới lạ cho món ăn nữa nha"},{"time":133.2,"text":"Nguyên liệu chính cho món ăn ngày hôm nay"},{"time":135.3,"text":"Đó là táo xanh"},{"time":136.6,"text":"Mình sẽ không có bào vỏ"},{"time":138.2,"text":"Vì vỏ táo xanh có chứa rất nhiều vitamin"},{"time":140.7,"text":"Và để tăng độ giòn cho món ăn nữa"},{"time":143.2,"text":"Táo xanh có rất là nhiều vitamin"},{"time":145.2,"text":"Đếm sơ sơ trên đầu ngón tay thôi nha"},{"time":147.4,"text":"Mình là em đã thấy có vitamin A"},{"time":148.9,"text":"A, B, C, E"},{"time":151.7,"text":"Một điều thú vị nữa đối với táo xanh khác với táo đỏ"},{"time":154.6,"text":"Đó là trong táo xanh có rất là nhiều chất sắc, cali cũng như là protein"},{"time":158.8,"text":"Mình sẽ thái sợi to hơn một tí xíu nha"},{"time":160.8,"text":"Để giữ được cái độ giòn cho cái phần táo của mình"},{"time":163.8,"text":"Cho vào bên đây"},{"time":168.8,"text":"Rau mùi để tạo thêm cái mùi thơm"},{"time":170.8,"text":"Thì mình sẽ có ngò và lá húng lũi"},{"time":173.8,"text":"Mình sẽ cắt rối"},{"time":176.5,"text":"Mình sẽ cho hết vào trong cái phần nước tô này"},{"time":178.4,"text":"Tiếp theo là cái phần ô liu"},{"time":180.2,"text":"Ô liu thì các bạn cũng có thể sử dụng những loại ô liu nào mà mình thích hoặc là dễ dàng tìm mua"},{"time":186.3,"text":"Ở đây thì đầu bếp Ngọc Minh sử dụng ô liu đen và đã bỏ hộp rồi"},{"time":190.1,"text":"Đúng rồi"},{"time":190.8,"text":"Rồi Minh Phương sẽ cho hỗn hợp các loại rau củ quả vào ngăn mát của tủ lạnh"},{"time":195.5,"text":"Với món ăn salad ngày hôm nay thì không thể thiếu đó là phần nước sốt"},{"time":199.6,"text":"Mình sẽ cho vào đây 3 muỗng canh sốt mayonnaise ayamayo vị ngọt dịu"},{"time":203.5,"text":"2 muỗng canh nước cốt tắc"},{"time":205.3,"text":"Chúng ta sử dụng phần nước cốt tắc cho phần nước sốt giúp tạo mùi thơm đặc trưng cho món ăn nha"},{"time":209.9,"text":"2 muỗng canh mật ong nha"},{"time":211.4,"text":"Để tạo độ ngọt"},{"time":213.2,"text":"Cho món sốt"},{"time":214.6,"text":"Và để tăng thêm cái mùi thơm đặc trưng"},{"time":217.2,"text":"Cho cái phần mùi tạc hạt này"},{"time":219.1,"text":"Khoảng 1 muỗng canh"},{"time":220.1,"text":"Thêm 1 ít muối nữa để cân bằng cái vị"},{"time":222.6,"text":"Của cái món salad này"},{"time":224.8,"text":"Và bây giờ phần sốt chúng ta đã xong"},{"time":226.9,"text":"Bắt đầu chúng ta sẽ trộn salad thôi"},{"time":229.1,"text":"Đây mình vừa vừa lấy trong tủ lạnh ra"},{"time":231.0,"text":"Rất là lạnh luôn"},{"time":232.0,"text":"Sẽ cho hết cái phần nước sốt đã pha này vào trong cái tô salad"},{"time":235.4,"text":"Như vậy là món salad ngày hôm nay đã xong rồi"},{"time":237.8,"text":"Đó nó chỉ đơn giản vậy thôi"},{"time":239.4,"text":"Mình Phương rất là thích màu sắc của món salad ngày hôm nay"},{"time":243.0,"text":"Rất là nhẹ nhàng và thanh mát"},{"time":244.6,"text":"Chính vì thế mà các bạn khán giả xem chương trình có thể sử dụng điện thoại di động"},{"time":247.7,"text":"Quét mạng QR đang hiển thị trên màn hình"},{"time":249.8,"text":"Để lưu ngay công thức của món salad ngày hôm nay nha"},{"time":254.1,"text":"Rồi chúng ta sẽ cho cái phần salad ra đây"},{"time":260.3,"text":"Tiếp theo là chúng ta sẽ cho cái phần thịt cua này lên trên mặt nha"},{"time":264.0,"text":"Để tăng tính hấp dẫn cho món ăn ngày hôm nay"},{"time":265.9,"text":"Chúng ta nên cho lên trên một ít sốt mayonnaise ajimayo vị ngọt dịu lên trên nha"},{"time":271.8,"text":"Quả thật một món ăn đúng với tiêu chí của chúng ta đó là nấu chuẩn, ăn làm"},{"time":276.5,"text":"Với món salad này thì chúng ta nên kết hợp với món bánh gà chiên sốt mè nha"},{"time":280.8,"text":"Salad tươi mát, lạ miệng với thịt cua ngọt, thêm độ giòn của táo, chua thanh từ nước tắc, độc đáo hương thơm từ củ thị là"},{"time":289.0,"text":"Tổng hòa tạo nên món salad cua táo xanh thật bắt vị, đổi món cuối tuần"},{"time":295.1,"text":"Để bổ sung chất sơ và thật nhiều rau xanh cho cả nhà"},{"time":298.4,"text":"Thì chân chơi gì nữa, thực hiện ngay món salad cua táo xanh các bạn nhé"},{"time":302.1,"text":"Và các bạn cũng có thể truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":306.1,"text":"Để xem thêm nhiều công thức của các món ăn ngon trong chương trình Món ngon mỗi ngày"},{"time":309.5,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}