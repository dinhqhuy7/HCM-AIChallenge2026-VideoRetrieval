:12.5,"text":"Gà chiên nước mắm nè, gà bơ tỏi nè, hay là gà mật ong, hay là gà muối tươi chanh không ta?"},{"time":20.5,"text":"Làm cái gì mà lãm nhãm lãm nhãm mấy con gà hoài vậy?"},{"time":22.8,"text":"Có một cuộc đại chiến gà đó anh Long"},{"time":24.8,"text":"Anh không biết em sao chứ nãy giờ mấy con gà chắc đằng kia nó đang á xì lắm rồi đó"},{"time":28.6,"text":"Chứ không phải là anh Long nghe rồi thèm hả?"},{"time":31.8,"text":"Em đang nghĩ coi làm món gà nào mà nó vừa ngon vừa hấp dẫn đây nè"},{"time":35.5,"text":"Bây giờ là anh sẽ làm cho em một món ăn từ gà khá đặc biệt mà vị cũng đặc biệt luôn"},{"time":40.3,"text":"Thơm và béo"},{"time":41.6,"text":"Nghe là thấp lồi đó"},{"time":45.5,"text":"Giòn ngon thơm béo"},{"time":46.8,"text":"Với gà chiên bè sốt chanh muối mayo"},{"time":65.2,"text":"Mến chờ quý khán giả đã quay trở lại"},{"time":66.7,"text":"Với chương trình món ngon mỗi ngày"},{"time":67.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":72.8,"text":"Nguyên liệu của chúng ta cũng đã sẵn sàng rồi"},{"time":75.1,"text":"Gà của Phương đây"},{"time":77.2,"text":"Phương ơi lấy dành chảo dầu nha"},{"time":80.5,"text":"Trong khi đó thì anh sẽ chuẩn bị"},{"time":81.9,"text":"Cái phần gà này"},{"time":83.3,"text":"Mình sẽ chọn cái phần má đùi phải không anh Long"},{"time":85.6,"text":"Đúng rồi phần má đùi"},{"time":86.9,"text":"Mình chọn theo mình cắt, để lát mình chiên cho nó cung lại đẹp đẹp"},{"time":90.3,"text":"Cái phần gà mình đã xong"},{"time":95.6,"text":"Gà thì mình có dùng bột khô, bây giờ mình không tẩm ướp đâu"},{"time":98.4,"text":"Mình chỉ cần cho ra một nửa muỗng cà phê tiêu"},{"time":100.5,"text":"Long sẽ đánh một cái quả trứng lên"},{"time":102.4,"text":"Để tạo sự kích dính và cái phần gà khi chiên lên nó sẽ sốt hơn"},{"time":105.7,"text":"Đúng rồi, với lại màu và gà dưới nó đẹp lên"},{"time":107.5,"text":"Đây, rồi trộn gà lên"},{"time":112.5,"text":"Cho vào phần gà này một muỗng cà phê chanh muối bông"},{"time":115.3,"text":"Các bạn lưu ý là đối với món ăn này chúng ta nên sử dụng má đùi"},{"time":118.6,"text":"Khi mà chiên lên thì thịt sẽ rất là giòn nhưng mà bên trong lại không bị khô"},{"time":121.9,"text":"Bây giờ Long sẽ pha phần bột để chiên"},{"time":124.4,"text":"Bột ở đây Long sử dụng là gia vị nêm sẵn Isoquit bột chiên giòn"},{"time":128.3,"text":"Long sử dụng 1 phần 2 gói"},{"time":129.9,"text":"Và Long sẽ sử dụng thêm 5 muỗng canh bột chiên xù"},{"time":133.6,"text":"Một cái hỗn hợp bột khô để mình chiên"},{"time":135.5,"text":"Và kế đến Long sẽ cho vào đây là 1 muỗng canh mè trắng"},{"time":139.5,"text":"Mình cho vào 1 muỗng canh mè đen"},{"time":141.1,"text":"Cả mè trắng với mè đen chắc là có lý do gì đặc biệt đúng không bà?"},{"time":145.6,"text":"Đúng rồi Thanh Phương ơi"},{"time":146.6,"text":"Có nghĩa là khi mà mình cho mè trắng và cả mè đen thì món ăn chúng ta sẽ đẹp mắt hơn và thơm ngon hơn"},{"time":152.1,"text":"Rồi, bây giờ chúng ta chuẩn bị chiên"},{"time":153.7,"text":"Mình đã chiên từng miếng một"},{"time":155.9,"text":"Mình nhúng qua cái hông hộp bột nè"},{"time":158.9,"text":"Thủ kính luôn"},{"time":161.7,"text":"Thanh Phương giúp Long là mình sẽ đảo cái phần gà nha Thanh Phương"},{"time":164.4,"text":"Khi mình nhúng qua cái phần bột chiên giòn như thế này á"},{"time":168.2,"text":"Mình thấy là mình chiên nó không có bị văng dầu ha"},{"time":171.3,"text":"Tại vì bột nó áo nó hút cái phần nước bên trong gà đó"},{"time":173.8,"text":"À, dạ"},{"time":174.8,"text":"Cái mùi chanh muối rất thơm"},{"time":177.2,"text":"Wow"},{"time":178.5,"text":"Hấp dẫn không Thanh Phương"},{"time":179.5,"text":"Trời ơi nóng giòn trông hấp dẫn cực kì luôn đấy ạ"},{"time":182.2,"text":"Đúng rồi"},{"time":182.4,"text":"Rất là thơm và gà trông giòn rồi điểm xuyến là những cái hạt mè đen hấp dẫn quá"},{"time":190.5,"text":"Thanh Phương ơi cái phần gà mình đã xong rồi bây giờ mình phải làm cái sốt chấm"},{"time":193.7,"text":"Cho vào đây là 2 muỗng canh mayonnaise"},{"time":196.8,"text":"Với những cái món mà chiên giòn thì sốt mayonnaise cực kỳ hấp dẫn luôn"},{"time":200.6,"text":"Anh phải cho vào đây là nửa muỗng cà phê chanh muối"},{"time":203.6,"text":"Một muỗng cà phê ngò tây"},{"time":205.1,"text":"Sau đó mình khuấy đều lên"},{"time":206.6,"text":"Nhà Thanh Phương là có một cái hũ chanh muối mình ngâm cũng lâu lâu rồi đó"},{"time":210.7,"text":"Chắc là phải lấy Lan làm món này mới được"},{"time":212.2,"text":"Thôi khoan từ từ nha"},{"time":212.8,"text":"Các bạn lưu ý là ở nhà mình nên chọn những quả chanh muối sáng màu và nước trong"},{"time":217.6,"text":"Vì đây là chanh muối mới sẽ rất là thơm ngon"},{"time":219.8,"text":"Chứ nếu mà để lâu quá thì nó sẽ không ngon đâu"},{"time":221.8,"text":"À vậy đó"},{"time":222.7,"text":"Đúng rồi"},{"time":223.2,"text":"Rồi Thanh Phương phải nhớ kỹ điều này mới được"},{"time":225.2,"text":"Nó rất là thơm lắm"},{"time":227.0,"text":"Ăn biết không"},{"time":227.6,"text":"Bây giờ tất cả các công đoàn đã xong rồi"},{"time":229.7,"text":"Mình sẽ dọn ra và mời tất cả quý vị cùng thưởng thức"},{"time":232.3,"text":"Dạ"},{"time":236.1,"text":"Ôi nhìn thế này đảm bảo là các bé rất là thích mê luôn á"},{"time":238.8,"text":"Đúng rồi"},{"time":239.8,"text":"Đúng là món tủ của các bé luôn á"},{"time":241.3,"text":"Cuối cùng là mình sẽ đặt một cái cọng ngò lên"},{"time":244.1,"text":"Để tạo màu sắc"},{"time":245.7,"text":"Bây giờ mình sẽ chấm kèm với cái sốt bằng nãy mình pha"},{"time":248.7,"text":"Rất là ngon"},{"time":249.5,"text":"Món này vừa nhanh vừa dễ thực hiện nữa"},{"time":251.6,"text":"Vì vậy những cái chuyến đi cắm trại"},{"time":253.5,"text":"Hoặc là đi du lịch với gia đình"},{"time":254.8,"text":"Chúng ta hãy nhớ thực hiện món này nha"},{"time":256.5,"text":"Hoặc là những cái bữa tiệc"},{"time":257.9,"text":"Cái món ăn này mình có thể ăn kèm với lại một loại salad"},{"time":260.7,"text":"Mà từ dầu dấm thì cũng rất là hợp, rất là thú vị"},{"time":262.7,"text":"Gà chín vàng ươm, vị mè hấp dẫn"},{"time":265.3,"text":"Cắn vào miếng gà tròn rụm"},{"time":267.2,"text":"Thơm mùi chanh muối"},{"time":268.5,"text":"Chấm chút sốt béo ngậy"},{"time":270.1,"text":"Thật quá xá đả"},{"time":271.5,"text":"Món ăn ngày hôm nay chắc hẳn là thực đơn yêu thích"},{"time":274.0,"text":"Của các thành viên ở trong gia đình"},{"time":275.4,"text":"Vừa ngon lại dễ thực hiện"},{"time":277.0,"text":"Ngại gì không thử"}]}