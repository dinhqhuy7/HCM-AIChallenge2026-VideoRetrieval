,8],["L30_V018",451,18.0,3],["L30_V018",7059,282.3,30],["L30_V018",4260,170.4,20],["L30_V018",2234,89.3,13],["L30_V018",3314,132.5,18]]]],"onScreen":[{"time":0.1,"until":2.5,"text":"tv.tuoitre.vn"},{"time":5.1,"until":6.3,"text":"Herbalife · trên th gii · thương hiu · cân năng · & súc khóe · quán ly"},{"time":7.1,"until":7.1,"text":"Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":12.3,"until":21.2,"text":"Trái tim ngưi thy thuc · Cuc thi Lan ta năng lung tích cc 2024: · 1900 · thutng hitu · cán ná"},{"time":25.2,"until":27.6,"text":"QUANG HÙNG"},{"time":29.6,"until":31.4,"text":"BÀNG KHEN · BAN CHAP HÀNH TRUNG UONG · NHÓM TÁC GIÀ PGS.TS.BS DÓ QUANG HÙNG VÀ THS.BS LÉ HOÀNG VÍNH · Tang · BĚNH VIÈN CHO RÁY, THÁNH PHÓ HÓ CHÍ MINH · VAO SÓ KHEN THUÓNG · Hà Ni, ngáy 18 tháng 12 năm 2023 · \"Tgo hinh thâm my müi bâng sun sròn tr thân hoàn toàn\" · CHU TICH · CONG HOA XÀ HÓI CHU NGHIA VIÈT NAM · HOI KHUYEN HOC VIÈT NAM · (sóng müi dugc tão hinh bng sun surn dp mèm cát min) · GS. TS Nguyen Thi Doan · 00-KHVN 56: 117 · D dt Gi Nhi Gii thrng Nhān tài dàt Vit\" linh vc Y. Duge năm 2023 vói Cóng trinh · Die lip - Ty do Hankt phuc"},{"time":54.8,"until":58.4,"text":"tuöitrev"},{"time":63.3,"until":83.5,"text":"1900 · 1000 · 9900"},{"time":94.0,"until":101.0,"text":"mum · tuóitre"},{"time":101.6,"until":104.7,"text":"900 · tuoitre"},{"time":110.8,"until":122.3,"text":"1900 · 1000 · A000"},{"time":150.6,"until":191.3,"text":"1900 · D QUANG HÙNG · 1000 · eas. · DÓ QUA · NO KEAM"},{"time":191.7,"until":195.5,"text":"Thu Ha · BS.ThuH · BS.TruHa · ChuHa · BS.ThMa"},{"time":208.6,"until":212.3,"text":"1900"},{"time":212.7,"until":216.6,"text":"BS.ChuHa · GRuHa"},{"time":217.0,"until":221.2,"text":"1000 · 1900"},{"time":221.8,"until":258.4,"text":"Tru"},{"time":258.8,"until":270.8,"text":"1900 · 1000"},{"time":279.9,"until":288.4,"text":"1900 · 1000"},{"time":318.0,"until":338.3,"text":"1900 · 1000 · 9900"},{"time":338.5,"until":340.3,"text":"35.0"},{"time":340.5,"until":346.6,"text":"35.0 · tuóitréV"},{"time":346.8,"until":358.1,"text":"1900 · 9900 · 190.0"},{"time":358.5,"until":362.6,"text":"tuoitrerv"},{"time":362.8,"until":376.8,"text":"Tác gi: Thành Quang · thung hitu · 1900 · PDS.S.S"}],"speech":[{"time":11.7,"text":"Tôi là thầy thuốc ưu tú, phó giáo sư, tiến sĩ, bác sĩ cao cấp Đỗ Quang Hùng,"},{"time":18.9,"text":"nguyên là trưởng khoa Tàu 5 Mỹ, Bệnh viện Trà Lẫy nhiều năm liền."},{"time":32.1,"text":"Thật ra thì có một tham gia một chiến trường,"},{"time":34.8,"text":"thì lúc đó thì tôi bất lực với một người bạn đồng đội chết trên bàn tay của tôi"},{"time":44.2,"text":"và lúc đó thu hút tôi theo nghề y ở trong một chiến trường Campuchia."},{"time":48.1,"text":"tôi học đọc y khoa Sài Gòn năm 1982 đến năm 1988 và sau tốt nghiệp xong thì tôi được về bệnh viện"},{"time":58.8,"text":"trà rẫy để làm công tác chuyên môn cho đến ngày hôm nay mặc dù tuổi hưu rồi tôi vẫn đăng ký trong"},{"time":65.1,"text":"bệnh viện trà rẫy tôi vẫn làm và bệnh viện trà rẫy vẫn kéo dài tuổi hưu của tôi cho đến giờ ngay"},{"time":69.4,"text":"này 64 tuổi rồi vậy để mà làm sao mình trả ơn được cho những người bệnh nhân đã từng trải qua mình đã"},{"time":76.4,"text":"đã từng ở trong bệnh viện trà rẫy, đó là những bài học rất lớn mà cuộc đời bác sĩ cần phải lưu tâm,"},{"time":81.8,"text":"bằng phải tạnh tâm với họ, và chính vì vậy mà tôi vẫn cố tâm làm cho đến khi ra bệnh viện trà rẫy không còn chấp nhận tôi nữa,"},{"time":89.7,"text":"thì tôi sẽ từ chối và tôi sẽ ra đi để làm việc khác."},{"time":102.7,"text":"Trên nền tảng của làm chuyên ngành bóng tạo hình thì rất thuận lợi cho việc phó tùy thẩm mỹ,"},{"time":109.8,"text":"kỹ tất nhiên rằng hãy tùy theo cái khía cạnh con mắt của người đó nữa khi cạnh bàn tay của họ nữa"},{"time":115.6,"text":"nhưng mà đa số là khéo tay đa số là là được luyện kỹ về kỹ năng nhưng mà tất nhiên còn tâm nhìn nữa"},{"time":122.5,"text":"cho về tôi được dạy dạy thương nhân tài đặc biệt giải cao nhất của tư lĩnh vực y dưỡng trong năm"},{"time":128.2,"text":"nay đó thì là cái giải quyết biến tiếng giải quyết gì thật bấm sinh giải quyết cái chuyện mà chấn"},{"time":135.5,"text":"bị ẩn thương tai nạn cho lao động tai nạn giao thông tai nạn giao thông tai nạo động gãy xương"},{"time":140.5,"text":"tính mũi rồi nói nhiễm trùng với nhiễm trùng giải quyết một cách gì trước đây vẫn để cho"},{"time":146.3,"text":"nhân tàn phế gần như cả tâm trời mặt thì biến dạng mũi thì gãy đi cong hoạch đi một bên và"},{"time":154.9,"text":"thậm chí cong tới 45 độ 60 độ quay lại các mũi còn quay lại khi mà tôi dặn dàng những bệnh nhân"},{"time":163.6,"text":"Nên như vậy, về chính phương pháp tôi sẽ nghĩ phải bây giờ làm cách nào để đưa họ sớm offline tới lại trường sống bình thường."},{"time":172.1,"text":"Và chính vì vậy thì tôi đi học ở Hàn Quốc, học ở Sinh, học ở các nước."},{"time":177.3,"text":"Vậy thì thấy ra là họ hướng tới một chuyện là họ đi dùng các liệu tự thân để mà tạo ra những sản phẩm của họ, tạo ra cái hình hài về thẩm mỹ của họ thì rất an toàn như vậy đó."},{"time":191.5,"text":"Tôi có 3 người con, vợ tôi là bác sĩ Trung Hoa Sản, cũng một đồng nhành ở TP.HCM, tiến sĩ Lê Thị Thu Hà, trước đây là trưởng phòng sản của Bệnh viện Từ Vũ."},{"time":208.1,"text":"Bây giờ thì tuổi hu thì tuổi hu lúc 55 tuổi, nhưng mà hiện tại thì cô vẫn làm việc, mặc dù cô ấy năm nay là chuẩn bị bước sang tuổi 60, nhưng mà năm nay, gần năm nay là cô vẫn làm việc ở Từ Vũ, giống như là bác sĩ bình thường."},{"time":221.0,"text":"trường con tôi có 3 người con đặc thù là hai vợ chồng tôi lại ba người con một là cô gái lớn thì"},{"time":228.7,"text":"hai người con lớn học bác sĩ hết cô gái lớn học xong bác sĩ tốt như bác sĩ ở Đại học y pha phòng"},{"time":234.8,"text":"của Thành rồi cũng học về chương trình tàu năm Mỹ học vô hồ tàu năm Mỹ rồi vậy ra sau đó thì"},{"time":241.1,"text":"cổ ước mơ của cổ là muốn tung bay thì có lại lập nghiệp đi thử thời gian ở bên Mỹ và thêm thời gian"},{"time":248.3,"text":"một thời gian một tình trạng định thì cậu trở thành một bác sĩ xuất sắc bên Mỹ. Hiện tại"},{"time":253.0,"text":"cậu là bác sĩ nội trú của Mỹ. Tất nhiên là học xong thì cô ấy cũng hứa sẽ về Việt Nam."},{"time":258.5,"text":"Rồi con trai tôi thì kế tiếp là con trai tôi cũng là bác sĩ đó. Học ở trường tốt nghiệp truyền độ"},{"time":263.8,"text":"y khoa phòng học tập và hiện tại cũng học trên đền tàu ở Mỹ. Hiện tại là trưởng đơn vị tàu"},{"time":269.8,"text":"bệnh viện của người một cô gái Úc thì nhỏ hơn cách anh nó mười mười hai tuổi tất cả giá đó"},{"time":277.2,"text":"vậy là cô Úc thì sinh năm hai đứa bốn cô gái Úc của tôi thì lại thích đi IT công nghệ phần mềm"},{"time":285.4,"text":"vậy ra thì cậu đang học và chuẩn bị đi học bên Úc mình không ép đâu học xong có thể là chuyển"},{"time":291.9,"text":"qua băng bằng hai chuyển qua một ngành nghề nào đó nhưng mà ra không có chống nào bỏ ngành nghề"},{"time":297.0,"text":"người ta chọn cả. Tôi nghĩ rằng trong khu trường cũng vậy. Nếu học nghệ y, dù sao tôi với vợ tôi"},{"time":307.3,"text":"vẫn là nghệ y. Cho nên sẵn sàng trước mắt là thầy của nó, thầy của hai con. Thầy và mẹ trở thành"},{"time":314.9,"text":"cha mẹ là người thầy của hai con. Cuộc đời tôi bây giờ đến giờ phút này gần như là dành cho nghệ"},{"time":321.5,"text":"từng ngày y rất là nhiều thậm chí là liên quân của từng ngày y tôi không có thật ra thì chắc lại cũng"},{"time":328.9,"text":"quen rồi cũng không không thích đi chơi hai vợ chồng cũng có thể trong nhà thôi đi chơi những"},{"time":348.7,"text":"rồi nhưng mà đến giờ này càng tuổi hưu càng tuổi về lớn tuổi thì tôi lại rất nhiều việc hơn là"},{"time":357.6,"text":"tuổi trước đây. Hôm nay mình nghĩ"},{"time":359.9,"text":"không đi làm"},{"time":361.2,"text":"thì có nghĩ rằng là một bệnh nhân"},{"time":363.2,"text":"một khách hàng, một bệnh nhân nào đó"},{"time":364.9,"text":"đang cần mình, họ đến địa điểm"},{"time":367.2,"text":"mình khám và không có mình thì không"},{"time":370.1,"text":"mình phải đặt trường hợp như vậy"},{"time":371.7,"text":"và chính như vậy mà tự nhiên là tôi"},{"time":373.8,"text":"có đam mê trong công việc"}]}