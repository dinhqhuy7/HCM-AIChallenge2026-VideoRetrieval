98.8,"until":102.3,"text":"RODE"},{"time":102.5,"until":114.0,"text":"RODE"},{"time":124.0,"until":127.9,"text":"PODE · RODE"},{"time":128.1,"until":131.2,"text":"Sport · Vit Phuong · tuoitre"},{"time":134.2,"until":137.1,"text":"BUA"},{"time":137.5,"until":139.8,"text":"tuoitreTy · MAMCHAY"},{"time":140.0,"until":143.2,"text":"tuoitre"},{"time":143.4,"until":146.2,"text":"tuoitrev · tuoitrerv"},{"time":146.7,"until":149.7,"text":"HONDA · TUÄN KIN"},{"time":153.1,"until":156.0,"text":"tuoitre · VENTUS"},{"time":196.7,"until":199.5,"text":"Herbalife · Tác gi: Hồng Vĩnh"},{"time":199.7,"until":202.8,"text":"Herbalife · Tác gi: Hồng Vĩnh"},{"time":203.0,"until":206.4,"text":"Chúc Quý khách dùng ngon ming! · Anh Chi Em chung tay dóng góp, · Herbalife · Tác gi: Hồng Vĩnh · in! · on! · Bépăn không nhn hin kim. · Bép Com Nghia Tinh* · Camon! · tubitrerv · chúng tôichinhn · thc pham và nhu yeu pham."}],"speech":[{"time":23.4,"text":"Mọi người đến đây đều được đội ngũ bếp cơm Nghĩa Tình chào đón niềm nở với phương châm trao yêu thương nhận lại nụ cười."},{"time":52.6,"text":"Hôm nay, bếp phục vụ bánh canh để đổi món cho bà con ăn ngon miệng hơn."},{"time":56.9,"text":"Ở khu vực bếp, sau khi hoàn thành các khâu chế biến,"},{"time":60.1,"text":"Mỗi người tự nhận một việc để kịp giờ mở cửa phục vụ bà con."},{"time":63.7,"text":"Các cán bộ, hội viên, hội chữ thập đỏ, phường lái thiêu cũng chung sức với bếp."},{"time":68.2,"text":"Mỗi người phụ một tay để mỗi bữa cơm thêm ấm áp."},{"time":73.3,"text":"Khi mà cái chương trình này phát động thì ai cũng đều rất vui hết trơn."},{"time":77.0,"text":"Nhất là những người dân nghèo khó khăn có được những bữa cơm trưa vậy nè."},{"time":84.0,"text":"Mà ở đây thì con nấu rất là ngon."},{"time":86.0,"text":"Thành ra cái sức ăn của người dân cứ mỗi ngày mỗi tăng lên vậy đó"},{"time":93.0,"text":"Tại vì cô tham gia theo ở đây thì cô nắm rõ cái trường hợp đó"},{"time":101.9,"text":"Vô cho ăn miễn phí giúp đỡ những người nghèo khốn khổ đó"},{"time":107.3,"text":"Tôi hài lòng, đẹp ý"},{"time":110.6,"text":"Bàn ghế sạch sẽ, ly tét chén mới tinh"},{"time":113.9,"text":"Thức ăn thì canh, món rượu xào, gà kho, thịt kho"},{"time":118.4,"text":"Ăn xong có chuối tráng biển, có dưa hấu, có chôm chôm nữa"},{"time":123.9,"text":"Coi như là đãi ăn được no, tiếp đãi nồng hậu, chú đáo"},{"time":128.4,"text":"Thực đơn của bếp cũng sẽ được thay đổi mỗi ngày"},{"time":131.0,"text":"Tuy không đồng, nhưng mỗi khay rất chất lượng với các món mặn luôn phiên từng ngày"},{"time":136.1,"text":"Hôm thì cơm, hôm lại nấu bánh canh, hủ tiếu"},{"time":139.2,"text":"Để có được bếp cơm nghĩa tình, ông Tuấn đầu tư khoảng 1 tỷ đồng để sửa chữa xây mới mặt bằng."},{"time":145.5,"text":"Mỗi tháng trả 10 triệu tiền thuê mặt bằng bên cạnh, mỗi ngày chi gần 10 triệu mua đồ nấu ăn phục vụ bà con."},{"time":152.4,"text":"Dù kinh phí để duy trì bếp không hề nhỏ, nhưng gia đình không ngận tiền ủng hộ từ cộng đồng."},{"time":157.9,"text":"Mình mong muốn phát triển thêm để cho cái duy trì này nó dài cho ổn, xong rồi mình muốn nấu thêm những sức cho những bệnh nhân nằm trong bệnh viện,"},{"time":170.9,"text":"cho nó đem tới những cái niềm một món ăn hay là một cái niềm vui là hỗ trợ cho nhau."},{"time":179.0,"text":"Trong khi ta nằm bệnh mà có người xem xẻ những món ăn như vậy thì giống như cái động lực của người ta nó hỏi mái hơn, suy nghĩ nó bóng ra hơn."},{"time":191.0,"text":"Với tâm niệm cho đi là còn mãi, mỗi thành viên trong gia đình của ông Tuấn luôn cố gắng làm tốt nhất công việc của mình mỗi ngày, để những phần cơm đưa đến đây bà con luôn được chất lượng nhất."}]}