g ty Golden Scale · Bn quyn kch bn và cu trúc · Ht nêm Aji-ngon Heo · Thit xay: 200g · Nám rom: 100g · Hành lá: 3 nhánh · Phi hp thc hin · Cà tím: 1quà · Gng bǎm: 1m · Thc hin chương trình · Tói bám: 1M · Ót sng: 1 quà · chuơng trình thuc · Công ty C · Nuc tuong “Phú Si” · DAI TRUYÊN HINH TP. HCM · Thc hié"}],"speech":[{"time":40.5,"text":"Ngoài ra thì ba cái nguyên liệu này các bạn đều tốt cho tim mạch các bạn ha"},{"time":43.3,"text":"Trời ơi anh gài bẫy em"},{"time":45.0,"text":"Đó là câu trả lời đúng nhất"},{"time":47.6,"text":"Nhưng mà em chưa ăn nên chưa biết nó tốt sao"},{"time":50.5,"text":"Đúng rồi như vậy thì em hãy cùng về bếp phụ với anh một tay nha"},{"time":53.8,"text":"Ok"},{"time":56.2,"text":"Ca tím kho nấm thịt băm đậm đa đứa cơm"},{"time":75.5,"text":"Mình chào các bạn đang xem chương trình món ngon mỗi ngày"},{"time":77.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":81.9,"text":"Đầu tiên chúng ta sẽ hành lá ha khoảng chừng 3 cái đồng hành"},{"time":86.5,"text":"Sao em thấy người ta hay dùng đậu hành để cho vào trong thịt heo anh ha?"},{"time":89.7,"text":"Cái mùi thơm của đậu hành nó vừa phải thôi"},{"time":94.0,"text":"Mình cho vô thịt heo thì nó cũng vừa thơm"},{"time":97.0,"text":"Tiếp tục chúng ta chỉ cần nêm ở đây 1 muỗng cà phê hạt nêm Aji ngon heo"},{"time":100.7,"text":"Tứng giúp anh trộn đều ha"},{"time":102.5,"text":"Cái khối này để em"},{"time":104.0,"text":"Phần lá chúng ta cắt để chút xíu chúng ta cho vào trong cái món kho"},{"time":106.8,"text":"Chúng ta cắt ra làm tư ha, làm tư giống kho để cho thấm vô như vầy nha"},{"time":111.5,"text":"Rồi cây tím thì chúng ta cắt khúc nha các bạn nha"},{"time":114.3,"text":"Khoảng chừng 5cm như vầy"},{"time":116.8,"text":"Đó, chúng ta cắt ra hình dưỡng thanh"},{"time":120.9,"text":"Cho ra dĩa"},{"time":121.8,"text":"Bây giờ chúng ta sẽ bắt nồi đất đi"},{"time":124.4,"text":"Rồi, bắt lên đây"},{"time":125.2,"text":"Cho vào đây một ít dầu cho dì vô làm"},{"time":127.4,"text":"Em nghĩ là mình sẽ phi hành, phi đồ trước"},{"time":129.6,"text":"Thường thường là như vậy đó, nhưng hôm nay bất thường"},{"time":132.1,"text":"Đó"},{"time":132.7,"text":"Thưa các bạn, chúng ta nên xào cà tím trước để món kho chúng ta được thơm nha các bạn"},{"time":137.2,"text":"Chúng ta giống như xào ấp chảo nhanh nhanh đó"},{"time":139.2,"text":"Dì nấm luôn"},{"time":140.5,"text":"Đó, nấm dậy mùi thơm"},{"time":141.9,"text":"Đó, xào nhanh qua"},{"time":143.0,"text":"Vừa dậy mùi thơm như vậy là được"},{"time":144.9,"text":"Cho vỏ cà tím vừa ứng màu sáng lên như vậy là được nha các bạn"},{"time":148.2,"text":"Chúng ta trút ra để riêng"},{"time":150.1,"text":"Đó, dậy cái mùi thơm mùi áp chảo liền ha"},{"time":152.4,"text":"Thơm luôn đó"},{"time":152.8,"text":"Rồi, chúng ta cho tiếp dầu điều vào khoảng 2 muỗng canh nha các bạn"},{"time":156.4,"text":"Cho gần khi nãy chúng ta băm khoảng 1 muỗng canh"},{"time":159.9,"text":"Tỏi băm"},{"time":161.2,"text":"Xào thơm luôn"},{"time":162.8,"text":"Thơm quá"},{"time":164.0,"text":"Ơt băm"},{"time":164.9,"text":"Xào thơm"},{"time":165.9,"text":"Rồi, cho thịt vô đúng không?"},{"time":167.7,"text":"Đúng vậy"},{"time":169.3,"text":"Các bạn lưu ý nha"},{"time":170.5,"text":"Chúng ta xào thơm không để xào vàng nha các bạn"},{"time":172.9,"text":"Kế tiếp chúng ta cho khoảng 200 gram thịt heo xay vào"},{"time":176.3,"text":"Rồi chúng ta xào cho thịt băm tơi và săn như vầy"},{"time":181.6,"text":"Chúng ta sẽ cho tiếp nấm và cà tím"},{"time":185.9,"text":"Phần chúng ta nêm"},{"time":187.2,"text":"Đầu tiên chúng ta cho vào đây nửa muỗng canh đường"},{"time":190.6,"text":"Chúng ta xào đường cho nó tan ra trước"},{"time":193.4,"text":"Chúng ta cho vào đây khoảng 2 muỗng canh nước tương phú sỉ"},{"time":196.5,"text":"Đó 1 muỗng nè"},{"time":198.1,"text":"2 muỗng canh nước tương phú sỉ"},{"time":199.9,"text":"Thơm quá anh ơi"},{"time":201.4,"text":"Em thấy cho nước tương vô một cái nó dậy cái mùi thơm"},{"time":203.7,"text":"Nó dậy cái mùi và nó kết hợp với tất cả những nguyên liệu khác"},{"time":206.0,"text":"Nó bốc cái mùi lên rất thơm"},{"time":207.4,"text":"Cho vào đây nước"},{"time":208.7,"text":"À chúng ta có nước dừa thì cho vào nước dừa nha"},{"time":211.2,"text":"Dừa sắm sắp thôi các bạn"},{"time":212.4,"text":"Chúng ta kho liu liu liu liu"},{"time":214.6,"text":"Khoảng cỡ chừng 10 phút là cái nước kho nó sẽ rút lại"},{"time":218.0,"text":"Chúng ta cho khoảng 1 muỗng canh tương ớt vào"},{"time":219.9,"text":"Tạo độ cay nhẹ nhẹ"},{"time":221.5,"text":"Bắt vị màu cũng sẽ đẹp nữa"},{"time":223.3,"text":"Chính xác"},{"time":224.2,"text":"Khi chúng ta kho chúng ta cho vào đây 1 muỗng canh tương ớt"},{"time":226.9,"text":"Để tạo độ sánh sệt tự nhiên cho nước kho"},{"time":229.1,"text":"Rồi, bây giờ chúng ta kho liu liu liu liu thôi"},{"time":231.6,"text":"Thưa các bạn, đối với món này"},{"time":232.9,"text":"Chúng ta nên kho bằng nồi đất"},{"time":234.3,"text":"Thì món ăn sẽ ngon hơn và giữ nhiệt được lâu hơn nha các bạn"},{"time":239.6,"text":"Nồi khó đã cạn"},{"time":240.7,"text":"Đúng rồi, nước kho vừa sánh sệt như vầy là được nè các bạn"},{"time":243.8,"text":"Đối với món này thì nó có cái tâm màu tối"},{"time":246.2,"text":"Và gan màu lẹn nóng"},{"time":247.4,"text":"Cho nên chúng ta phải chọn một cái dụng cụ"},{"time":249.8,"text":"Có cái tâm màu sáng, cái màu vàng vàng kem kem này nè"},{"time":252.6,"text":"Mới nổi bật được cái tà tím, cái thịt"},{"time":255.4,"text":"Thưa các bạn, chúng ta có món kho rồi"},{"time":257.0,"text":"Chúng ta còn thêm món canh chúng ta có thể ăn cùng với lại canh cải xoăn"},{"time":260.3,"text":"Và thêm một món rau sọt thập cẩm gì nữa"},{"time":262.9,"text":"Thì chúng ta có ngay một bữa ăn hoàn chỉnh"},{"time":265.4,"text":"Phần cà tím mềm, tan ra trong miệng"},{"time":267.7,"text":"Kèm một chút nấm sực sực, ngọt thanh"},{"time":270.5,"text":"Quyện cùng với lại phần thịt heo băm thấm vị đậm đà"},{"time":273.9,"text":"Một món ăn có thể làm siêu lòng bất kỳ ai"},{"time":277.3,"text":"Cà tím, kho nấm, thịt băm"},{"time":279.3,"text":"Món ăn ngày hôm nay phải nói là quá động lòng người đúng không các bạn"},{"time":282.5,"text":"Nên là các bạn hãy thực hiện ngay món ăn của mình"},{"time":285.8,"text":"Ngay tại nhà nha"},{"time":286.8,"text":"Và công thức thì luôn luôn có trên những kênh của Món Ngọc Món Ngày"},{"time":289.6,"text":"Ví dụ như là Youtube, website và cả fanpage của chương trình"},{"time":293.3,"text":"Nhớ truy cập vào và thực hiện nha"}]}