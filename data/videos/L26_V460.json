"time":32.8,"text":"Cô đảm bảo là món ăn này các bạn nhỏ sẽ rất thích đó"},{"time":35.2,"text":"Và em cũng đảm bảo là tất cả quý vị khán giả đang nóng lòng theo dõi xem món ăn này như thế nào"},{"time":41.9,"text":"Pancake 2 màu chuối sô-cô-la, cực phẩm cho cả nhà"},{"time":64.2,"text":"Được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":67.7,"text":"Rồi đầu tiên là mình sẽ chuẩn bị phần kem"},{"time":70.8,"text":"Whipping thì chúng ta sẽ giữ lạnh"},{"time":72.3,"text":"Sau đó mình cho vào đây khoảng chừng 100ml whipping"},{"time":75.0,"text":"Khi đánh whipping này là chỉ vừa nổi thôi"},{"time":77.7,"text":"Không có đánh quá kỹ"},{"time":78.9,"text":"Nếu đánh quá kỹ thì nó sẽ tách nước"},{"time":80.3,"text":"Em thấy phần kem mình đánh này thấy không"},{"time":83.0,"text":"Nó đã đứng được như thế này rồi"},{"time":84.8,"text":"Thì bây giờ chúng ta sẽ cho nó vào trong một túi bắt kem"},{"time":87.8,"text":"Và mình sẽ giữ lạnh"},{"time":88.7,"text":"Chuối thì chúng ta sẽ lột vỏ và mình cắt lát như thế này"},{"time":91.5,"text":"Để cho chuối sau khi mình cắt lát không bị đen á"},{"time":93.8,"text":"Chúng ta có thể là dùng cọ"},{"time":95.2,"text":"Phớt một ít cái nước cốt chanh lên đây"},{"time":97.3,"text":"Và đồng thời nước cốt chanh"},{"time":99.4,"text":"Cũng làm cho cái chuối mình có vị chua chua"},{"time":101.7,"text":"Chút nữa mình ăn với lại bánh bánh khác"},{"time":103.8,"text":"Sẽ rất là ngon"},{"time":104.5,"text":"Em muốn pha bột gì? Bột truyền thống hay là bột sô-cô-la?"},{"time":108.7,"text":"Em thích sô-cô-la"},{"time":109.9,"text":"Rồi cô sẽ pha bột truyền thống"},{"time":111.7,"text":"Chúng ta sẽ cho bột bánh rán"},{"time":113.8,"text":"Pha sẵn vị truyền thống ra tô"},{"time":115.8,"text":"Cho nước vào đây"},{"time":117.3,"text":"Theo cái công thức đã hướng dẫn trên bao bì"},{"time":119.6,"text":"Cô đã xong cái phần bột vị truyền thống của cô rồi"},{"time":124.7,"text":"Và tiếp theo thì Hà sẽ pha cái phần bột vị sô-cô-la"},{"time":130.4,"text":"Cho khoảng chừng nửa lượng nước vô trước"},{"time":132.8,"text":"Chúng ta chỉ cần khuấy bình thường thôi là bột đã rất mịn rồi"},{"time":136.2,"text":"Rồi bây giờ chúng ta đã có 2 phần bột"},{"time":138.5,"text":"Đầu tiên thì chúng ta sẽ làm nóng chảo"},{"time":140.6,"text":"Trong cái thời gian khoảng chừng 2 phút"},{"time":142.6,"text":"Thì bây giờ chúng ta sẽ hạ nhiệt bằng cách là đặt lên một cái khăn ẩm"},{"time":146.9,"text":"Trong lúc đó thì mình sẽ chuẩn bị cái phần bột để mình đổ lên được hai màu nè"},{"time":150.8,"text":"Đó là mình sẽ cho vào một cái vá đổ lên này"},{"time":155.4,"text":"Một phần bột màu trắng"},{"time":156.9,"text":"Rồi và một phần bột màu vị sô-cô-la"},{"time":160.4,"text":"Rồi bây giờ mình sẽ đặt cái chảo lên"},{"time":162.5,"text":"Và mình sẽ đổ bột lên giống như bình thường"},{"time":165.9,"text":"Lát nữa khi bánh chín phần bột sô-cô-la sẽ dành cho Hakuta"},{"time":169.5,"text":"Còn phần bột vị truyền thống sẽ dành cho Hà"},{"time":171.9,"text":"Các bạn lưu ý là chúng ta sẽ pha hai loại bột với nhau"},{"time":174.8,"text":"Để một cái bánh mà chúng ta có thể có nhiều hương vị và màu sắc"},{"time":178.3,"text":"Rồi bây giờ cô sẽ lật"},{"time":179.7,"text":"Wow, hai màu sắc bột hòa quyện lại với nhau"},{"time":183.1,"text":"Công nhận đẹp thiệt luôn á cô"},{"time":184.5,"text":"Hà Cô Ta biết không"},{"time":185.6,"text":"Khi đổ bánh thì chúng ta cũng có thể tạo ra nhiều vân khác nhau"},{"time":189.1,"text":"Tùy vào cách đổ và sự khéo tay của mỗi người đó"},{"time":191.8,"text":"Rồi bây giờ cô dớt ra nha"},{"time":193.4,"text":"Rồi cứ như vậy thì chúng ta sẽ đổ tiếp cái bánh khác"},{"time":196.4,"text":"Rồi"},{"time":197.0,"text":"Và khi mà mình múc bột"},{"time":198.6,"text":"Thì mình cũng lưu ý là mình đừng có làm hai cái màu này nó tan vào nhau"},{"time":203.7,"text":"Thì khi mình đổ bánh cái vân nó sẽ không có được đẹp"},{"time":211.9,"text":"Xong một cái nữa rồi"},{"time":213.2,"text":"Giờ cô lấy ra"},{"time":214.1,"text":"Cứ như vậy thì chúng ta sẽ đổ cho đến khi hết bột"},{"time":219.0,"text":"Phớt một ít sốt"},{"time":220.7,"text":"Sô-cô-la ra"},{"time":223.5,"text":"Mình sẽ đặt một cái bánh lên"},{"time":224.9,"text":"Cô sẽ xếp lên đây một ít chuối"},{"time":227.1,"text":"Cho lên đây một lớp"},{"time":229.0,"text":"Kem whipping mà mình đã đánh"},{"time":230.9,"text":"Kế đến lại là một lớp bánh"},{"time":232.7,"text":"Một lớp chuối nữa"},{"time":234.4,"text":"Một lớp kem"},{"time":235.9,"text":"Rắc lên đây một ít cốp"},{"time":237.4,"text":"Một cái bánh nữa"},{"time":238.9,"text":"Và cuối cùng ở trên thì mình sẽ chạy những cái đường sô-cô-la dứt dắt"},{"time":243.6,"text":"Một cái đọt không lũi ở đây"},{"time":245.5,"text":"Chúng ta đã hoàn thành món ăn rồi đó"},{"time":247.2,"text":"Có sắc màu"},{"time":248.4,"text":"Cộng thêm nữa là có chuối và kem tươi nữa"},{"time":250.5,"text":"Đảm bảo là các bạn nhỏ nhà mình sẽ rất là thích luôn"},{"time":253.4,"text":"Mặt bánh có từng vân màu nâu vàng đan sen cực bắt mắt"},{"time":257.2,"text":"Miếng bánh mềm xốp, ngọt dịu vị sô-cô-la và chuối"},{"time":260.8,"text":"Kết hợp chút béo béo của kem tươi"},{"time":262.7,"text":"Khiến chúng ta cảm thấy vô cùng hài lòng và lưu luyến"},{"time":266.1,"text":"Thêm một công thức cho những tín đồ mê pancake"},{"time":268.3,"text":"Vừa đẹp mắt, vừa lạ miệng"},{"time":270.2,"text":"Hãy cập nhật những công thức mới lạ"},{"time":272.2,"text":"Trên trang của Món Ngon Mỗi Ngày"},{"time":273.7,"text":"Còn ngay bây giờ thì Hakuta và cô Thu Hà"},{"time":275.9,"text":"Xin chào và hẹn gặp lại trong chương trình kỳ sau"}]}