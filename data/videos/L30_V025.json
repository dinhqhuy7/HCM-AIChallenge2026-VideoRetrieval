"time":122.6,"until":132.6,"text":"GIA · 111 · KHONG · tuoitle · iNH · vers · d.o · intuortreTV · suoitreTiv"},{"time":133.7,"until":138.2,"text":"GIA · tubitreTV · AKHONG"},{"time":139.4,"until":142.3,"text":"GIA · KHO"},{"time":143.5,"until":152.9,"text":"Bà NGUYEN THU THÃO (69 tuői)"},{"time":153.3,"until":170.4,"text":"tuoitreV · Bà TRÃN THU THÙY (58 tui)"},{"time":172.9,"until":176.1,"text":"Bé BÙI QUANG BÁCH (8 tui) · CONG DÓNG · Xu Doong · CÓNG DONG · 0869.33.39.39 · Hat ing, Ukulale"},{"time":176.3,"until":179.8,"text":"ANDREW · Aubitrev"},{"time":180.4,"until":186.9,"text":"ANDREW · Ch! LÊ TH! LAN ANH (48 tui) · tuolthe"},{"time":190.2,"until":191.6,"text":"tuoitrej · coChek"},{"time":192.4,"until":200.4,"text":"Bà NGUYËN KIM THANH (66 tui) · 0000"},{"time":204.4,"until":214.6,"text":"tucitreTv"},{"time":215.0,"until":219.2,"text":"Lear"},{"time":219.6,"until":226.0,"text":"May · Hanh · vui · phúc · mán · phive · tucitreTy · Hgn · phic · tuoitlerv"},{"time":226.4,"until":229.0,"text":"Lear"},{"time":239.4,"until":241.8,"text":"Tác gi: Đình Khoa · Tác già: Đinh"},{"time":242.0,"until":243.2,"text":"Tác gi: Đình Khoa · thung hatu"},{"time":243.7,"until":247.4,"text":"Tác gi: Đình Khoa · tubitrely · Ptuoiti"}],"speech":[{"time":12.6,"text":"Một không gian biểu diễn ấm cúng trong đêm nhạc ra mắt cộng đồng hát cùng ukulele vừa diễn ra tại Hà Nội"},{"time":19.6,"text":"với sự tham gia của những thành viên đến từ nhiều tỉnh thành khác nhau như Hà Nội, Bắc Giang, Huy Nhơn, TP.HCM"},{"time":28.1,"text":"Họ gồm nhiều lứa tuổi, ngành nghề khác nhau như bác sĩ, dược sĩ, kỹ sư, nhân viên văn phòng, nhà báo, bán hàng tạp hóa, sinh viên, học sinh"},{"time":38.8,"text":"Trong đó tập trung nhiều nhất là những người già, người khuyết tật"},{"time":44.1,"text":"Họ là thành viên của một dàn hợp xướng mang tên đa dạng"},{"time":48.0,"text":"Cái tên đúng như tính chất, đa ngành nghề, lứa tuổi, giới tính của cả nhóm"},{"time":52.6,"text":"Tôn vinh sự đa dạng, tôn trọng sự khác biệt, sự bình đẳng xã hội"},{"time":57.9,"text":"Nhất là với những người khuyết tật, người yếu thế trong xã hội"},{"time":63.3,"text":"Bà Hoàng Thị Thu Hường, người sáng lập hợp xướng đa dạng cho biết"},{"time":67.5,"text":"Giàn hợp sướng được thành lập vào năm 2018"},{"time":71.6,"text":"Khởi nguồn từ chân trở của bà"},{"time":73.5,"text":"Đã làm sao xây dựng được một dự án cộng đồng"},{"time":76.3,"text":"Có thể thu hút nhiều thành phần tham gia"},{"time":78.5,"text":"Cùng chia sẻ một mối quan tâm chung"},{"time":80.9,"text":"Một niềm hứng khởi"},{"time":82.4,"text":"Một hoạt động ý nghĩa"},{"time":84.0,"text":"Tạo sự gắn kết"},{"time":85.1,"text":"Âm nhạc chính là hình thức được lựa chọn"},{"time":88.0,"text":"Để hiện thực hóa mong muốn nhân văn ấy"},{"time":91.9,"text":"Tháng 11 năm 2023"},{"time":94.2,"text":"Hợp sướng đa dạng"},{"time":95.4,"text":"Vượt qua 112 đoàn"},{"time":97.1,"text":"hoàn toàn đến từ các quốc gia trong cuộc thi hợp sướng quốc tế interculture tổ chức tại Hải Nam"},{"time":102.5,"text":"Trung Quốc và đạt huy chương đồng ngoài ra nhóm thường xuyên biểu diễn trong các chương trình"},{"time":108.5,"text":"hoạt động vì cộng đồng khác như hòa nhạc vì một Hà Nội đáng sống biểu diễn tại trụ sở Liên Hợp Quốc"},{"time":115.1,"text":"tại Việt Nam nhân nghề môi trường thế giới dự án kết hợp với sinh viên các trường đại học để lan"},{"time":120.8,"text":"lan tỏa năng lượng tích cực."},{"time":123.1,"text":"Hợp sướng đa dạng hiện do ca sĩ Hà Ni phụ trách chỉ huy"},{"time":126.7,"text":"và đang triển khai dự án xây dựng cộng đồng hát cùng ukulele,"},{"time":131.4,"text":"đưa âm nhạc nuôi dưỡng, âm nhạc ngũ cung vào đời sống."},{"time":135.3,"text":"Nhiều thành viên dù tuổi cao, dù có những khiếm khuyết về tay hoặc chân,"},{"time":139.8,"text":"nhưng vẫn kiên trì tập luyện để tự tin biểu diễn."},{"time":143.4,"text":"Từ khi biết được cây đàn này thì tôi cảm thấy rất là hạnh phúc và rất là vui vẻ."},{"time":147.9,"text":"Là một món ăn tinh thần đối với tôi"},{"time":150.1,"text":"Là một món liều thúc bổ đối với sức khỏe tuổi già"},{"time":152.6,"text":"Và khi mà chơi cùng với cả các anh chị khác trong giảm sướng"},{"time":158.7,"text":"Thì tôi cảm giác như là mình khỏe hơn rất là nhiều"},{"time":162.0,"text":"Và mình yêu đời hơn rất là nhiều"},{"time":163.8,"text":"Bởi vì nó giống như là cộng đường của những năng lượng tích cực"},{"time":166.9,"text":"Mang lại cho mình những niềm vui"},{"time":169.0,"text":"Con nào cũng như con Lali từ hồi lúc con 4 tuổi"},{"time":171.6,"text":"Con rất thấy hạnh phúc và con thấy nó rất là điệu đàng và nhẹ nhàng"},{"time":175.9,"text":"Bản thân mình là một người khuyết tật, cái tay của mình nó không bình thường"},{"time":179.9,"text":"Khi mà chơi cái đàn này và hát những cái bài thiền ca đấy"},{"time":183.2,"text":"Thì mình cảm thấy là cái tâm hồn mình nó nhẹ nhàng hơn"},{"time":187.0,"text":"Thì cảm thấy bình an"},{"time":188.1,"text":"Cái đàn này thì giúp mình quên đi cái mệt mỏi"},{"time":191.7,"text":"Tôi muốn là cái âm nhạc hôm nay nó sẽ lan tỏa đến mọi người"},{"time":196.7,"text":"Để cho mọi người sống vui hơn, tốt hơn và khỏe hơn"}]}