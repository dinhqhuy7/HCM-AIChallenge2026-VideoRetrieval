ngày hôm nay đây"},{"time":54.4,"text":"Minh Tuấn biết không, trong thời điểm giao mùa năm mới như thế này"},{"time":58.3,"text":"Thì cô nghĩ là một món ăn phải có nhiều màu sắc rực rỡ"},{"time":62.4,"text":"Và phải đảm bảo về dinh dưỡng nữa"},{"time":64.3,"text":"Cho nên là hôm nay cô sẽ làm món súp gất nấm mỡ"},{"time":67.2,"text":"Và đặc biệt nha, trong gất có nhiều vitamin A nữa"},{"time":69.6,"text":"Và nó sẽ giúp cho chúng ta sáng mắt, bổ sung dinh dưỡng"},{"time":72.6,"text":"Và đặc biệt là giảm đi lượng cholesterol"},{"time":74.6,"text":"Với một quả gất như thế này thì chúng ta sẽ thêm vào"},{"time":78.0,"text":"Một muỗng canh rượu trắng và một muỗng canh dầu ăn"},{"time":80.7,"text":"Chúng ta sẽ bóp nó để cho nó tan ra"},{"time":83.1,"text":"Thì chúng ta sẽ được cái phần gất như thế này"},{"time":86.5,"text":"Dạ rồi"},{"time":88.0,"text":"Nấm mỡ, thì ở đây cô sử dụng nấm mỡ 2 màu"},{"time":90.7,"text":"Mình sẽ cắt lát"},{"time":92.3,"text":"Cái nấm mỡ này của mình là có chứa rất là nhiều vitamin D"},{"time":95.5,"text":"Mình ăn nấm mỡ nha mọi người"},{"time":96.8,"text":"Sẽ giúp mình hấp thụ canxi tốt hơn"},{"time":98.3,"text":"Bây giờ thì em sẽ xác lát mỏng cô ha"},{"time":101.2,"text":"Đúng rồi"},{"time":104.9,"text":"Rồi nấm nâu mình cũng tương tự ha"},{"time":106.5,"text":"Mình làm như vậy luôn"},{"time":111.1,"text":"Cảm ơn Tướng"},{"time":112.0,"text":"Rồi tiếp theo thì mình có thêm phần củ năng"},{"time":115.3,"text":"Mình cũng cắt sợi giống như là cà rốt đúng không nha"},{"time":117.7,"text":"Chúng ta sẽ chọn củ năng tươi mới"},{"time":119.9,"text":"Đó là những củ năng có vỏ bóng"},{"time":121.9,"text":"To, chắc tay và giòn"},{"time":123.9,"text":"là củ năng ngon"},{"time":131.3,"text":"ngò rí thì mình sẽ cắt nhỏ"},{"time":132.9,"text":"tiếp theo chúng ta sẽ cắt vuông"},{"time":138.4,"text":"miếng đậu hủ khoảng chừng 1cm"},{"time":150.7,"text":"một cái chảo, mình sẽ mở lửa"},{"time":153.0,"text":"cho vào đây khoảng chừng 3 muỗng canh dầu ăn"},{"time":156.4,"text":"đối với phi bò rô"},{"time":157.6,"text":"thì mình không cần dầu thật nóng đâu nha"},{"time":159.3,"text":"bởi vì bò rô thì nó mỏng, nó rất là mau"},{"time":161.7,"text":"chín, rất là dễ để bị điên"},{"time":163.4,"text":"chúng ta sẽ tắt riêng"},{"time":165.3,"text":"cái phần sát bò rô ra, còn cái phần dầu"},{"time":167.6,"text":"thì bây giờ chúng ta sẽ cho lại"},{"time":169.5,"text":"vào trong chảo"},{"time":170.3,"text":"Bởi vì trong đây có tính dầu bô rô rồi"},{"time":173.1,"text":"Rồi cô sẽ cho nấm vô đây"},{"time":174.5,"text":"Mình xào cho cái nấm này nó thơm lên"},{"time":176.5,"text":"Các bạn lưu ý là chúng ta sẽ xào nấm với dầu bô rô phi"},{"time":179.8,"text":"Để cho nấm thơm ngon hơn nha"},{"time":181.8,"text":"Cho vào trong phần nấm này nửa muỗng cà phê hạt nêm Azi ngon nấm"},{"time":185.5,"text":"Và một ít tiêu"},{"time":187.1,"text":"Chúng ta chỉ cần đảo đều lên"},{"time":189.8,"text":"Tắt lửa"},{"time":191.2,"text":"Tiếp theo thì chúng ta sẽ nấu súp"},{"time":193.3,"text":"Chúng ta sẽ chuẩn bị là một nít hai nước dùng chay"},{"time":196.5,"text":"Các bạn ha"},{"time":197.1,"text":"Cô sẽ múc một giá nước dùng này"},{"time":199.3,"text":"này cho vào trong cái phần gất mà chúng ta đã sơ chế rồi đó. Chúng ta sẽ rây cái phần gất qua cái"},{"time":205.2,"text":"rây này. Chúng ta sẽ rây nước gất qua để cho nước gất không bị lợn cợn thì súp sẽ mịn hơn. Bây giờ"},{"time":211.8,"text":"thì chúng ta sẽ nêm gia vị vào trong nước dùng nha các bạn. Đầu tiên 1 muỗng rưỡi cà phê muối,"},{"time":217.9,"text":"nửa muỗng canh đường. Chúng ta sẽ cho thêm 1 muỗng canh rưỡi hạt nêm Azi ngon nắm. Cho vào"},{"time":226.5,"text":"Vào đây là cà rốt và củ năng đã cắt sợi."},{"time":229.8,"text":"Cho phần nấm vào."},{"time":233.9,"text":"Cuối cùng chúng ta sẽ cho bột năng pha nước vô."},{"time":236.5,"text":"Với lại cái lượng súp này thì chúng ta cho khoảng chừng 3 muỗng canh mình pha với lại nước vô."},{"time":242.3,"text":"Cho súp tạo độ sánh là được ha."},{"time":244.7,"text":"Em tắt bếp dùm cô đi Tướng."},{"time":246.4,"text":"Chúng ta sẽ cho vào đây 1 muỗng cà phê dầu mè cho thơm."},{"time":251.1,"text":"Với lại 1 ít ngò rí."},{"time":252.8,"text":"Chúng ta đang có 1 nồi súp rất là hấp dẫn luôn."},{"time":255.2,"text":"Và bên cạnh đó thì cũng có một mã Twitter"},{"time":257.3,"text":"Để tất cả các bạn có thể quét mã này và thực hiện món ăn tại nhà"},{"time":263.3,"text":"Ngày đầu năm mới mà ăn một cái chén súp mà đỏ rực"},{"time":266.0,"text":"Mà bên trong đầy đủ nguyên liệu mà tốt cho sức khỏe thế này đi"},{"time":269.8,"text":"Còn gì mà hạnh phúc"},{"time":270.8,"text":"Cả năm may mắn ha"},{"time":271.9,"text":"Dạ"},{"time":272.6,"text":"Tàu hủ chi mà mình chiên giòn, mình bóp nhỏ"},{"time":275.1,"text":"Rồi cô sẽ rắc tiêu lên đây"},{"time":277.1,"text":"Và với món ăn ngày hôm nay là một món chay"},{"time":279.5,"text":"Chúng ta nên kết hợp với xào lăn chay thảo mộc"},{"time":282.4,"text":"Thì sẽ có được một bữa ăn hoàn chỉnh"},{"time":284.6,"text":"Súp có màu cam đỏ đẹp mắt, sánh vừa"},{"time":287.2,"text":"Với vị ngọt thơm của nấm và nước dùng"},{"time":289.9,"text":"Củ năng và rau củ thì giòn giòn"},{"time":292.4,"text":"Hòa quyện chung với mùi thơm của hành bò rô"},{"time":295.1,"text":"Thật sản khoái"},{"time":297.6,"text":"Nếu các bạn đang lăng tăng"},{"time":299.0,"text":"Chuẩn bị một món ăn để cầu cho nhiều sự may mắn"},{"time":301.9,"text":"Và rực rỡ trong năm mới"},{"time":303.5,"text":"Thì hãy chọn món ăn của ngày hôm nay"},{"time":305.1,"text":"Công thức luôn có trên Youtube, Website và Fanpage"},{"time":308.2,"text":"Của chương trình Món Ngon Mỗi Ngày"},{"time":309.5,"text":"Các bạn truy cập vào đây"},{"time":310.6,"text":"Lấy công thức và thách đại cả gia đình của mình"},{"time":312.7,"text":"Chúc các bạn thành công nha"}]}