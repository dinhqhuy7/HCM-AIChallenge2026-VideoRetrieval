2.8,"text":"Nấu chuẩn"},{"time":43.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":48.7,"text":"Xin nè"},{"time":49.2,"text":"Sao tự nhiên bây giờ Thanh Phương thèm một cái món"},{"time":51.1,"text":"Món mà chua chua cay cay mà lạ miệng một chút á Xin"},{"time":54.1,"text":"Đúng ý Xin luôn á"},{"time":55.2,"text":"Wow"},{"time":55.6,"text":"Y chang như cái nguyên liệu mà Xin chuẩn bị ngày hôm nay luôn"},{"time":58.2,"text":"Đối với món này thì đầu tiên là mình phải chuẩn bị bạch tuột nè"},{"time":61.4,"text":"Bây giờ chắc là Xin sẽ cần"},{"time":63.3,"text":"Một cái nồi trước ha"},{"time":64.2,"text":"Chắc là sẽ nhờ Phương đập dập cái phần gừng"},{"time":67.3,"text":"Với lại xả này, xả mình cắt khúc ra đi"},{"time":68.9,"text":"Cái gừng thì mình cũng cắt lát dày, mình đập dập bỏ vô đây"},{"time":71.3,"text":"Để mình luộc cái phần bạch tuột cho nó thơm"},{"time":74.6,"text":"Bây giờ Phương đập dập nha"},{"time":75.9,"text":"Cho cái phần gừng đã đập dập vào trước nha"},{"time":78.5,"text":"Rồi, cái phần xả mình cũng cắt khúc, mình đập dập mình bỏ vô luôn"},{"time":81.5,"text":"Đối với phần nước này thì xin sẽ cho thêm 2 muỗng canh giấm gạo lên men Ajinomoto"},{"time":85.5,"text":"Các bạn nên nhớ là chúng ta luộc bạch tuột với giấm"},{"time":87.8,"text":"Ngâm đá trước khi cắt để bạch tuột được giòn và ngọt hơn nha"},{"time":91.0,"text":"Thân Hương được biết là ăn bạch tuột rất là tốt cho sức khỏe"},{"time":93.5,"text":"Bởi vì trong bạch tuột có chứa chất selenium"},{"time":96.2,"text":"Sẽ giúp chuyển hóa protein"},{"time":97.7,"text":"Rất là tốt cho hệ tiêu hóa"},{"time":99.9,"text":"Bên cạnh đó lại ít calor, ít chất béo"},{"time":102.7,"text":"Nên phù hợp cho những ai muốn giảm cân"},{"time":104.5,"text":"Cái phần nước vừa sôi thì chúng ta cho bạch tuột vào luôn"},{"time":109.7,"text":"Trời ơi, xin mua bạch tuột tươi quá"},{"time":111.7,"text":"Có bí quyết gì không xin?"},{"time":112.9,"text":"Thì bạch tuột đầu tiên là mua bạch tuột phải trắng"},{"time":115.3,"text":"Có độ ràng hồi, rồi da liền với nhau"},{"time":118.2,"text":"Không bị bị rách lựa những con bạch tuột không có những cái đớm màu xanh"},{"time":120.8,"text":"Hay những cái đớm có màu sắc khác"},{"time":122.2,"text":"Bởi những con bạch tuột đó rất là dễ làm chúng ta bị ngộ độc"},{"time":125.0,"text":"Đối với phần cốc non nhỏ như là Phương sau khi mà bào vỏ nè"},{"time":127.8,"text":"Cửa sạch để ráo chắc là xin sẽ cắt đôi thôi"},{"time":131.3,"text":"Cắt đôi như vậy là vừa ăn ha"},{"time":132.8,"text":"Và trong cốc non thì cũng có nhiều chất sơ lắm quý vị ạ"},{"time":136.0,"text":"Bên cạnh đó còn ít calor, ít chất béo nè"},{"time":138.8,"text":"Chính vì vậy cốc non mà kết hợp với bạch tuột quá thật là một bộ đôi hoàn hảo luôn đó"},{"time":143.1,"text":"Cái phần ớt này xin cũng sẽ cắt lát luôn"},{"time":145.5,"text":"Nó không cay lắm nhưng mà nó làm cho cái phần món trộn của ta có thêm màu sắc ha"},{"time":154.3,"text":"Cái phần rau râm này"},{"time":156.0,"text":"Thì xin cũng sẽ cắt nhuyễn luôn"},{"time":159.6,"text":"Cắt này thì"},{"time":161.0,"text":"Mình mua về mình nhớ là ngâm muối ha"},{"time":162.9,"text":"Rửa sạch bởi vì mình sẽ cắt"},{"time":164.6,"text":"Ăn luôn cái phần vỏ cay cay the the"},{"time":167.1,"text":"Chung với món này cũng rất là hợp"},{"time":169.0,"text":"Cái bạch tuột chúng ta là"},{"time":173.8,"text":"Chuyển thành cái màu hơi tím tím như vầy nè"},{"time":176.0,"text":"Chúng ta sẽ cho vào cái tô đá"},{"time":177.8,"text":"Trước khi mà chúng ta làm cái sốt á"},{"time":179.4,"text":"Thì chúng ta sẽ pha cái hỗn hợp sốt thái trước nha Phương nha"},{"time":181.7,"text":"Đầu tiên thì xin sẽ có khoảng 1 muỗng canh"},{"time":183.9,"text":"Gia vị nem sẵn azuic lẩu thái nha"},{"time":185.7,"text":"Khoảng 1 muỗng canh nước, 1 muỗng canh đường"},{"time":188.6,"text":"Xin có thêm 1 muỗng canh tương ớt nữa nha"},{"time":190.8,"text":"Đối với những loại sốt như vầy thì chúng ta sẽ cho tất cả gia vị vào và chúng ta trộn đều"},{"time":195.1,"text":"Trước khi nấu thì cái phần sốt thái chúng ta sẽ ngon hơn ha"},{"time":198.3,"text":"Cuối cùng thì mình có 1 muỗng canh nước mắm truyền thống để cho cái phần sốt chúng ta được thơm hơn ha"},{"time":204.3,"text":"Rồi, sau khi chúng ta có cái hỗn hợp sốt thái rồi"},{"time":207.1,"text":"Bây giờ chúng ta sẽ mở lửa"},{"time":208.4,"text":"Xin sẽ cho vào đây 1 chút xíu dầu ăn"},{"time":210.9,"text":"Và chúng ta sẽ cho lần lượt những gia vị thơm gồm có tỏi, hành, sả"},{"time":214.8,"text":"Và chúng ta sẽ xào thơm cái phần gia vị này lên"},{"time":217.0,"text":"Các bạn nhớ là chúng ta xay nhuyễn gia vị trước khi nấu"},{"time":219.5,"text":"Để phần sốt chúng ta được sánh mịn nhất có thể nha"},{"time":221.7,"text":"Mình giảm lửa nhỏ ha"},{"time":223.2,"text":"Cho cái phần sốt này vào luôn"},{"time":225.4,"text":"Hành nè, tỏi xả cũng rất là thơm rồi"},{"time":227.2,"text":"Chúng ta chỉ cần xôi nhẹ lên"},{"time":229.5,"text":"Chọn đều"},{"time":232.0,"text":"Và chúng ta tắt bếp"},{"time":233.7,"text":"Cho ra ngoài một cái chén"},{"time":235.3,"text":"Trời ơi cái mùi thơm đúng là chuẩn vị món Thái luôn đó nha"},{"time":239.4,"text":"Bây giờ mình sẽ cắt cái phần bạch tuột này ra những miếng vừa ăn ha Phương ha"},{"time":242.8,"text":"Ta sẽ cắt từng cái rau bạch tuột ra"},{"time":246.6,"text":"Đúng là khi mà chúng ta nấu và luộc bạch tuột vừa chín tới"},{"time":249.7,"text":"Thì bạch tuột vẫn còn giữ được vị giòn nè"},{"time":252.4,"text":"Và bên trong vẫn còn giữ được cái vị ngọt tự nhiên của hải sản"},{"time":255.4,"text":"Và Xin cũng đã có sốt rồi"},{"time":256.9,"text":"Hấp dẫn như thế nào"},{"time":258.1,"text":"Trời ơi cái màu sắc đẹp quá"},{"time":261.4,"text":"Và món này bây giờ Phương chỉ cần trộn đều lên và thưởng thức thôi"},{"time":264.2,"text":"Chắc chắn là các bạn cũng đang rất là thích thú với món ăn này đúng không ạ"},{"time":267.3,"text":"Chúng ta có thể quét bả QR để tìm hiểu thông tin chi tiết để thực hiện món ăn nha"},{"time":273.0,"text":"Và bây giờ Xin sẽ cho cái phần bạch tuột này ra dĩa nha"},{"time":276.3,"text":"Về màu sắc thì hấp dẫn nè"},{"time":278.0,"text":"Rồi cái mùi thì kiểu như là mình nghe được cái mùi chua chua ngọt ngọt luôn á"},{"time":282.3,"text":"Và với một món khai vị hấp dẫn như thế này thì mình sẽ ăn kèm với món gì thì sẽ hợp hạt xin"},{"time":287.0,"text":"Với món này thì cần một món ví dụ như là cá chiên sốt cam chẳng hạn"},{"time":291.4,"text":"Nước sốt màu đỏ cam áo đều trên cốc non và bạch tuột giòn sừng sực"},{"time":295.8,"text":"Cắn một miếng vị chua ngọt hài hòa cay cay lan tỏa trong khoang miệng ngon mê ly"},{"time":303.0,"text":"Thêm món chua ngọt cay cay thực hiện ngay món bạch tuột lát cốc non sốt thái"},{"time":307.8,"text":"Ngoài ra hãy truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày để cập nhật những công thức của món ăn ngày hôm nay nha"}]}