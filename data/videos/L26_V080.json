76.3,"until":282.0,"text":"ming · AJINOMOTO · AJINOMOT · Eat Well, Live Well. · Live Well · Eat W · NGO! · Eat Well. · agày · Well · moingay · ngày · máingày · AJINON · nōingày · Gungay"},{"time":282.6,"until":291.7,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · AJINOMOTO · Onlin · maingay"},{"time":292.5,"until":304.5,"text":"150g · 200g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Công ty HKFilm · NGUYÊN LIÊU · 1/2 cù · Bn quyn kch bn và cu trúc · ·CÀ RÓT · ·HÀNH TÂY · ·MÈ TRÂNG RANG · ·CÀI NGÓNG · Phi hp thc hin · · XÖT MAYONNAISE VI NGOT DIU · Onl · · THIT ÚC GÀ · ·GIÃM GAO LÊN MEN · chuơng trình thuc · Thc hin chương trình · · DÁU MÈ, DÁU HÀO · · TUONG CÀ, TUONG ÓT BÁC · THÀNH PHÓ HO CHÍMINH · Thc hin chươ · · HÚNG LÙI · DÀI TRUYÊN HìNH · ·ÓT CÁT SI"}],"speech":[{"time":37.8,"text":"Rất vui được gặp lại các bạn trong chương trình Món ngon mỗi ngày"},{"time":40.1,"text":"Nấu chuẩn"},{"time":41.6,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":45.1,"text":"Hôm nay nguyên liệu trông hấp dẫn quá"},{"time":48.5,"text":"Thanh Phương thích nhất là món cải ngồng luôn đó anh Long"},{"time":50.8,"text":"Trước đây nếu mà ăn cải ngồng thì Thanh Phương sẽ ăn món gì?"},{"time":53.9,"text":"Em hay làm cải ngồng xào thịt bò nè hoặc là làm luộc cũng ngon nữa"},{"time":57.7,"text":"Hôm nay chúng ta thay đổi một chút xíu"},{"time":59.3,"text":"Nó hơi hiện đại một chút xíu"},{"time":61.0,"text":"Mình sẽ làm món cải ngồng trộn gà xé"},{"time":63.6,"text":"Wow, cải ngồng thì có quanh năm các bạn ơi"},{"time":66.2,"text":"Nhưng mà cải ngồng vào mùa thu là ngon nhất"},{"time":68.5,"text":"Bởi vì vào lúc đó cải ngồng rất là ưa"},{"time":70.7,"text":"Cái độ ẩm nè"},{"time":71.4,"text":"Nên nó sẽ tươi ngon và hấp dẫn hơn"},{"time":73.5,"text":"Thanh Phương chuẩn bị giúp Long nè"},{"time":75.6,"text":"Mình sẽ luộc ớt gà trước"},{"time":78.3,"text":"Bây giờ Long chuẩn bị một nồi nước sôi"},{"time":80.2,"text":"Long sẽ cho vào nồi nước một muỗng cà phê muối"},{"time":82.0,"text":"Trong khi Thanh Phương giúp Long luộc gà"},{"time":84.5,"text":"Thì Long sẽ chuẩn bị"},{"time":86.2,"text":"Phần rau củ quả ăn kèm"},{"time":87.5,"text":"Với cà rốt thì Long sẽ sắc sợi"},{"time":95.4,"text":"Nước đã sôi Thanh Phương sẽ bảo phần ớt gà này vào luộc"},{"time":98.1,"text":"Như các bạn cũng biết là ớt gà"},{"time":99.8,"text":"Và có nhiều protein, đặc biệt là với những ai mà cần tăng cơ bắp này thì sẽ hay thường ăn ướt gà."},{"time":107.6,"text":"Bởi vì ăn ướt gà sẽ giúp cho cơ bắp được tốt hơn."},{"time":110.2,"text":"Hành tây Lâm sẽ cắt sớm ngang."},{"time":111.8,"text":"Hành tây chúng ta sẽ cắt ngang cũ để hạn chế mùi hăng."},{"time":118.8,"text":"Sau khi cắt cái phần cà rốt và hành thì Lâm sẽ cho vào đây 1 muỗng rưỡi cà phê, đường, trộn đều lên."},{"time":126.8,"text":"Bây giờ Lâm sẽ tiến hành pha phần sốt để mình trộn kèm với lại gà và cải ngọc."},{"time":132.6,"text":"Lâm sẽ cần 3 muỗng canh mayonnaise"},{"time":133.9,"text":"Azumayo vị ngọt dịu"},{"time":137.6,"text":"1 muỗng canh mè rang giải nhuyễn"},{"time":139.2,"text":"Với mè trắng chúng ta đem rang"},{"time":141.0,"text":"Sau đó giải nhuyễn để phần mè nó dậy mùi mè đặc trưng"},{"time":143.6,"text":"1 muỗng cà phê tương ớt bắc"},{"time":145.4,"text":"1 muỗng cà phê dầu hào"},{"time":147.7,"text":"1 muỗng cà phê tương cà"},{"time":149.8,"text":"1 muỗng cà phê giấm gạo lên men"},{"time":151.6,"text":"Ajinomoto"},{"time":153.5,"text":"1 muỗng cà phê dầu mè"},{"time":155.0,"text":"Và cuối cùng là 1 phần 3 muỗng cà phê muối"},{"time":157.4,"text":"Sau đó chúng ta sẽ trộn đều lên"},{"time":158.9,"text":"Như vậy là gà chín rồi đó Thanh Phương ơi"},{"time":160.5,"text":"Rồi bây giờ em sẽ lấy gà ra nha"},{"time":162.9,"text":"Và phần cải ngồng thì Thanh Phương cũng sẽ trụng vào"},{"time":164.8,"text":"Sau đó ngâm vào trong nước đá lạnh"},{"time":167.2,"text":"Bây giờ Thanh Phương sẽ giúp Long là xé gà ra"},{"time":173.2,"text":"Dạ"},{"time":174.5,"text":"Mình luộc vừa chín tới thôi"},{"time":176.0,"text":"Mình trần sơ qua nên cái miếng gà nó vẫn còn"},{"time":179.0,"text":"Rất là dai nè"},{"time":180.5,"text":"Và nó còn giữ được vị ngọt"},{"time":182.0,"text":"Khi mà xé ra mình cảm thấy là cái nước ngọt của gà nó tiết ra"},{"time":184.4,"text":"Trông rất là hấp dẫn luôn đấy ạ"},{"time":185.6,"text":"Trong khi Thanh Phương đang xé gà"},{"time":187.8,"text":"Thì Long sẽ chuẩn bị cái phần cải ngồng để trộn vào"},{"time":190.5,"text":"Sẽ cắt cải ngồng thành từng đoạn 5cm"},{"time":193.0,"text":"Và mình cho vào"},{"time":196.6,"text":"Sau cái ngồng thì mình sẽ cho cái phần"},{"time":198.7,"text":"Cà rốt và hành tây"},{"time":200.8,"text":"Mà chúng ta đã trộn với đường"},{"time":203.4,"text":"Sau đó mình vắt ráo"},{"time":204.9,"text":"Ước sừng chúng ta hái sợi"},{"time":207.3,"text":"Lâu rồi cho phần ức gà vào"},{"time":209.7,"text":"Cái đấy là phần sốt"},{"time":213.1,"text":"Trộn đều lên"},{"time":214.9,"text":"Như vậy là món ăn của chúng ta đã hoàn thành"},{"time":216.6,"text":"Các bạn có thể quét mã QR để xem lại công thức của món ăn ngày hôm nay"},{"time":222.4,"text":"Phương ơi bây giờ mình lại vào công đoạn"},{"time":224.0,"text":"Làm trình bày"},{"time":228.5,"text":"Thân Phương rất là thích những món gỏi salad"},{"time":230.4,"text":"Mà nhiều màu sắc như thế này"},{"time":231.7,"text":"Bởi vì mình biết được là nó sẽ có nhiều vitamin và khoáng chất cung cấp nhiều giá trị dinh dưỡng cho cơ thể"},{"time":236.4,"text":"Cái ngông thì có chứa vitamin C nè"},{"time":238.6,"text":"Và trong thịt gà, đặc biệt là ướt gà thì có rất là nhiều protein"},{"time":242.6,"text":"Bây giờ Long sẽ thêm vào một chút hoa, cải ngông, thêm một chút xíu lá húng lũi nữa"},{"time":248.2,"text":"Thêm một tí mè rang để thơm thơm béo béo nè"},{"time":251.7,"text":"Một món ăn quả thật vừa ngon mắt lại ngon miệng"},{"time":254.2,"text":"Món này thì mình sẽ kết hợp với những món nào khác ạ?"},{"time":257.0,"text":"Để tạo nên một bữa ăn hoàn thiện thì chúng ta sẽ ăn kèm với lại cá hồi nướng lá thơm"},{"time":262.0,"text":"Món trộn đẹp mắt với màu vàng hoa cải điểm suyết, cái ngông giòn ngọt, thịt gà thấm sốt, chua cay béo nhẹ, thêm chút mùi mùi của mè rang, cân bằng lại tất cả, rất lạ miệng."},{"time":275.9,"text":"Cái ngông trộn gà xé vừa lạ miệng lại dễ làm, rất thích hợp cho những ngày thèm rau. Các bạn hãy thử nhé."},{"time":282.5,"text":"Ngoài ra chúng ta có thể truy cập vào kênh youtube, website và fanpage của Món Ngon Mỗi Ngày để tìm hiểu công thức của các món ngon."},{"time":288.6,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại."},{"time":291.2,"text":"Cảm ơn các bạn đã theo dõi."}]}