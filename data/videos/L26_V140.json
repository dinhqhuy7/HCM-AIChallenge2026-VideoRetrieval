l":233.4,"text":"Oniine"},{"time":244.6,"until":249.2,"text":"line"},{"time":249.6,"until":251.0,"text":"Eat Well, Live Well. · mingày · AJINOMOTO."},{"time":253.1,"until":259.2,"text":"Onli"},{"time":259.6,"until":263.3,"text":"mingày · Eat Well, Live Well. · AJINOMOTO."},{"time":264.1,"until":274.0,"text":"móingay"},{"time":274.4,"until":281.7,"text":"mingày · Eat Well, Live Well. · CANH BÓNG · AJINOMOTO. · BÍNGÒI · CUÓN · DÁY DÙ DINH DUÖNG · CUÔN · VÓI · BÜA ÃN"},{"time":294.3,"until":300.6,"text":"OMOTO · mingày · Eat Well, Live Well. · moingay · IGON · BOTERIENIGION · AJINO · ApQaick · qqingay"},{"time":300.8,"until":307.2,"text":"monngonmoingay.com · ine · AJINOMOTO · Món Ngon Mōi Ngày · Eat Well, Live Well. · maingay · Lngay · AiQuich · BOTCHILNICION · ApQuick · BOWGHIENIGION"},{"time":307.6,"until":319.6,"text":"200g · 1chén · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · ·CHANH · NGUYÊN LIÊU · Công ty Golden Scale · 1/2M · Công ty HKFilm · Bán quyn kch bán và cu trúc · 1 trái · ·MÈ DEN RANG · Phi hp thc hin · ·BÔT CHIÊN GIÒN · ·CÁ TRÚNG · ·HÚNG LÙI · · XÖT MAYONNAISE VI NGUYÊN BÀN · chuơng trình thuc · Thc hin chương trình · THÀNH PHÓ HO CHÍMINH · ·ÖT SÜNG · Thc hin chưo · DÀI TRUYÊN HìNH"}],"speech":[{"time":42.9,"text":"Em thấy cô Hà đang chuẩn bị một cái dĩa cá trứng đúng không ạ?"},{"time":49.1,"text":"Và cá trứng thì luôn luôn đầy ấp trứng ở trong bụng mặc dù không phải là mùa sinh sản"},{"time":53.1,"text":"Thế thì với nguyên liệu chính ngày hôm nay là cá trứng thì mình sẽ làm món gì hả cô?"},{"time":56.8,"text":"Chúng ta sẽ tẩm bột chiên giòn"},{"time":58.2,"text":"Dạ bây giờ thì mình bắt đầu cô ha"},{"time":59.9,"text":"Chúng ta sẽ sử dụng gia vị nêm sẵn Ajiquit bột chiên giòn"},{"time":63.9,"text":"Đầu tiên là chúng ta sẽ múc ra 2 muỗng bột chúng ta để riêng"},{"time":67.4,"text":"Phần còn lại mình sẽ cho vào tô và mình pha với nước theo hướng dẫn trên bao bì"},{"time":72.5,"text":"Và trong gói gia vị nêm sẵn, Ajiquit bột chiên giòn này đã có gia vị rồi"},{"time":77.0,"text":"Cho nên là mình không cần phải thêm gia vị nữa cô Hà ha"},{"time":79.3,"text":"Đúng rồi, mình trộn bột này cũng rất là đơn giản, dễ trộn và dễ hòa tan, dễ mịn"},{"time":84.4,"text":"Và chúng ta sẽ sử dụng tiếp là phần bột khô mà hồi nãy mình để lại"},{"time":88.0,"text":"Thông thường thì các thực phẩm mà chúng ta muốn nhúng qua một nước để chiên"},{"time":91.7,"text":"Thì mình nên áo xung quanh một lớp bột khô, đặc biệt là đối với lại hải sản"},{"time":96.7,"text":"Cô sẽ trộn qua"},{"time":99.0,"text":"Bây giờ là cô nhờ Minh Phương sẽ bắt lên trên bếp cho cô một cái chảo dầu để mình chiên cá"},{"time":103.1,"text":"Khi mà dầu nóng rồi thì chúng ta sẽ chiên lá húng lũi này trước"},{"time":106.2,"text":"Các bạn sẽ lặt rời từng lá ra"},{"time":108.0,"text":"Các bạn lưu ý nha"},{"time":109.3,"text":"Chúng ta sẽ chiên lá húng lũi trước để cho dầu thơm"},{"time":112.2,"text":"Sau đó mình chiên cá thì sẽ ngon hơn"},{"time":114.1,"text":"Rất là thơm luôn"},{"time":115.9,"text":"Chiên cái phần lá húng lũi trước"},{"time":117.1,"text":"Giờ em vớt ra đi Phương"},{"time":117.9,"text":"Dạ rồi"},{"time":118.9,"text":"Phần bột mà nãy mình pha bây giờ chúng ta sẽ cho vào thêm đây khoảng nửa muỗng canh mè đen"},{"time":124.1,"text":"Trộn đều lên"},{"time":126.5,"text":"Và chúng ta sẽ lần lượt dúng cá qua bột ướt này và mình cho vào chảo dầu mình chiên"},{"time":131.0,"text":"Có gì thì cô thả vô cô chiên và em trở cá giúp cô ha"},{"time":134.7,"text":"Dạ"},{"time":136.8,"text":"Khi mình cho vô thì mình để khi nào mà bột nó ổn định rồi mình bắt đầu mình trở con cá"},{"time":145.3,"text":"Và đối với món ăn ngày hôm nay thì sẽ giúp cho những ai mà không thích ăn cá quá"},{"time":150.1,"text":"Cũng sẽ cảm thấy rất là bắt miệng"},{"time":152.0,"text":"Tại vì cái phần chiên ở ngoài nó rất là giòn và hấp dẫn"},{"time":155.3,"text":"Trong cá trứng theo như em được biết thì có rất là nhiều omega 3"},{"time":158.8,"text":"Và đây là chất béo không bảo hòa, rất là tốt cho sức khỏe"},{"time":161.4,"text":"Và cái chất này cũng giúp kiểm soát quá trình đông máu trong cơ thể chúng ta đúng không cô?"},{"time":166.1,"text":"Đúng rồi đấy em"},{"time":166.9,"text":"Và đối với lại cá cũng như là hải sản"},{"time":169.3,"text":"Khi mình chiên, khi mà cái bề mặt của bột nó đã xe lại, nó hơi vàng"},{"time":174.8,"text":"Chúng ta có thể tăng lửa nhẹ một chút để cho cá và hải sản bên trong chín luôn"},{"time":179.4,"text":"Mình không nên chiên lâu quá, vì lâu quá thì nó sẽ bị khô"},{"time":184.7,"text":"Wow, vàng giòn và lấm tấm những cái hạt mè màu đen rất là hấp dẫn cô Hà ơi"},{"time":189.9,"text":"Sau khi chiên cá xong thì bây giờ chúng ta sẽ bắt đầu pha sốt"},{"time":195.1,"text":"Cô sẽ cho là 4 muỗng canh sốt mayonaise ajime do vị nguyên bản"},{"time":199.8,"text":"Cùng với lại 2 muỗng canh tương ớt"},{"time":202.7,"text":"Rồi cô trộn đều lên"},{"time":204.1,"text":"Vì là món chiên cho nên là các bạn lưu ý chúng ta sẽ kết hợp thêm rau sống, rau thơm"},{"time":209.2,"text":"Vừa làm món ăn đẹp nè và điều quan trọng nữa là làm cân bằng dinh dưỡng"},{"time":213.3,"text":"Trước khi thưởng thức thì cũng đừng quên chúng ta có thể lưu lại công thức của món ngày hôm nay"},{"time":217.7,"text":"Bằng cách dùng điện thoại di động quét mã QR đang hiển thị trên màn hình đây"},{"time":223.8,"text":"Bây giờ thì chúng ta cùng trình bày món ăn nha"},{"time":225.9,"text":"Cô sẽ cho lên đây một ít ớt xương cắt sợi nè"},{"time":228.3,"text":"Mình cho thêm một ít lá hống lũi chiên"},{"time":231.8,"text":"Mèo đen rang"},{"time":233.4,"text":"Tiếp theo thì cô sẽ đặt cá lên"},{"time":240.1,"text":"Cô cho thêm một ít lá hống lũi lên đây"},{"time":244.7,"text":"Để đẹp hơn thì cô sẽ cho lên mấy cái bông để trang trí"},{"time":249.3,"text":"Mình bắt một ít sốt mayonnaise aji mayo vị nguyên bản lên trên cái phần rau này"},{"time":254.6,"text":"Khi ăn mình trộn đều"},{"time":258.6,"text":"Rồi"},{"time":259.0,"text":"Như vậy là món ăn ngày hôm nay đã hoàn thành rồi"},{"time":261.7,"text":"Rất là đơn giản đúng không cô?"},{"time":263.3,"text":"Và đối với món cá trứng chiên giòn này thì mình có thể là một món khai vị nè"},{"time":267.6,"text":"Một món ăn vặt"},{"time":268.7,"text":"Hay thậm chí là cuối tuần mình làm một cái món để mình nhâm nhi lai rai với gia đình của mình"},{"time":273.4,"text":"Và nếu như mà ăn cơm thì các bạn có thể kết hợp với món canh bóng cuộn bí ngòi"},{"time":279.1,"text":"Chúng ta sẽ có một bữa ăn rất là đầy đủ dinh dưỡng"},{"time":281.9,"text":"Cá chiên vàng rượm ngon bắt mắt với sốt mayonnaise"},{"time":284.9,"text":"Điểm những hạt mè đen lấm tấm"},{"time":287.2,"text":"Bên ngoài giòn nhẹ, bên trong trứng cá bùi thơm"},{"time":290.4,"text":"Ăn hoài không chán"},{"time":293.9,"text":"Cá trứng chiên giòn, một món nhâm nhi vừa ngon vừa nhanh gọn"},{"time":298.2,"text":"Vào bếp và làm ngay thôi các bạn ơi"},{"time":300.3,"text":"Các bạn cũng có thể xem thêm công thức của món ngày hôm nay"},{"time":303.1,"text":"Bằng cách truy cập vào kênh youtube, website và fanpage của chương trình"}]}