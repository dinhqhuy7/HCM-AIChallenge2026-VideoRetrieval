19],["L30_V002",2186,87.4,null],["L30_V050",1861,74.4,17],["L30_V010",2226,89.0,26],["L30_V050",1122,44.8,11],["L30_V010",3621,144.8,42],["L30_V010",3274,130.9,null],["L30_V002",3408,136.3,43],["L30_V050",448,17.9,3],["L21_V005",4167,138.9,52]]]],"onScreen":[{"time":0.1,"until":2.1,"text":"tv.tuoitre.vn"},{"time":5.1,"until":7.1,"text":"Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024 · tusitreTv"},{"time":11.9,"until":16.7,"text":"Lp hc đc bit gia rng"},{"time":16.9,"until":19.3,"text":"Lp hc đc bit gia rng"},{"time":19.5,"until":21.8,"text":"Lőp hc đc bit gia rng"},{"time":29.8,"until":32.4,"text":"Bay · chim · chim chó · hat thóc · loc · dàn só · ing · -Con · vrt d · gió lo'c · gió lc · dong · huaing · hieing · -Còn t6i"},{"time":32.8,"until":36.2,"text":"Frast"},{"time":36.4,"until":38.6,"text":"thy"},{"time":46.7,"until":49.3,"text":"HOC XOA MU CHU · ALENG · TIÉNG VIÈT · AY1 · ge li hat thé"},{"time":49.5,"until":52.6,"text":"KY1 · Bay qua · cila · chat · HOC XOA MU CHÚ · TIÉNG VIÊT · oo cila con · gio lox hat tha · chim choc nay lo · tôi là gio · làgi · hat tho · dān sóc viôt d · lagio"},{"time":52.8,"until":59.9,"text":"Chi THT · Làng Pral Sơmei, xã Đăk Sơmei, huyn Đăk Đoa, tinh Gia Lai · Henife"},{"time":60.1,"until":66.6,"text":"tuóitrefv · tuöitreV · DEALO"},{"time":99.2,"until":102.2,"text":"hat · nat · hat tho · thóc · loc · dot · lin di vriot · din d vrot · wwm.choc · vriot · chim choc · chim chón · doe · chi"},{"time":102.4,"until":104.4,"text":"Cathuse"},{"time":105.1,"until":110.9,"text":"Giáo viên Trung tiu hc Đăk Sđmei, xã Đăk Sđmei, huyn Đăk Đoa, tinh Gia Lai · Thãy DÕ HUU QUÀNG"},{"time":128.7,"until":130.5,"text":"Tác già: TÃN LC"},{"time":131.1,"until":133.4,"text":"Tác già: TÃN LC · Hen ife"},{"time":133.7,"until":135.2,"text":"Tác già: TN LC · Catheste"},{"time":135.6,"until":140.5,"text":"tv.tuoitre.vn · Tác già: TN LC · tuóitre"}],"speech":[{"time":13.1,"text":"Gần 2 năm qua, một lớp học xóm mùa chữ đặc biệt giữa rừng Đắc Sơ Mê, huyện Đắc Đoa, tỉnh Gia Lai vẫn sáng đèn."},{"time":19.2,"text":"Người đứng lớp là các giáo viên trường tiểu học Đắc Sơ Mê, còn học viên là những phụ nữ ba na tuổi đã 40-60,"},{"time":24.9,"text":"nhiều chị còn điều cả con nhỏ sau lưng lên lớp tìm con chữ."},{"time":30.8,"text":"Trong lớp này, học viên lớn tuổi nhất là cụ Hờ Nai, 63 tuổi."},{"time":34.6,"text":"Dưới mái đầu bạc trắng, đôi mắt cụ chăm chú vào quyền sổ ô ly, tay cầm cụi gò từng nét chữ chưa tròn vành."},{"time":40.7,"text":"Còn chị Đương, 41 tuổi, mặc cậu con trai nhỏ đang ngái ngủ trên chiếc điệu"},{"time":45.4,"text":"Chị luôn nhắc nhở mình phải học lấy cây chữ để ra ngoài kiếm thêm việc, cơ may thay đổi số phận ngặt nghèo"},{"time":52.6,"text":"Học đến đâu rồi, nhưng mà hiện tại thì viết tên cho sơ thôi, nhưng mà không viết nhiều"},{"time":60.3,"text":"Tại mình không viết chữ mà, thì mong muốn là mình muốn viết chữ"},{"time":63.7,"text":"Giống như ta nè, không muốn viết chữ là mình đã đảm bình duyên"},{"time":93.5,"text":"Lớp học nằm cách trung tâm xã Đắc Sơn Mây cả chục cây số."},{"time":96.3,"text":"Dù đường xá cách trở, nhưng khi trời vừa tắt nắng, vừa buông tay cuốc, tay cày, bà con vẫn đều đạn cấp tập sách đến lớp."},{"time":107.0,"text":"Nhiều bà con gần chữ biết chữ và họ có cái lòng ham hiểu viết và ham biết chữ để vượt qua những khó khăn của sống hàng ngày."},{"time":114.6,"text":"Và nhà trường, nhà đảo, nhà bán cũng quyết định mở lớp đường xóa mù chữ ở làng Trà Sơn Mây để giúp cho bà con."},{"time":121.8,"text":"Dù điều kiện giảng dạy khó khăn, đường xá xa xôi, nhưng các thầy cô rất nhiệt huyết giúp đỡ bà con trong hành trình xóa mù chữ."},{"time":128.5,"text":"Sở Giáo dục và Đào tạo tỉnh Gia Lai cho biết hiện toàn tỉnh đã mở được 225 lớp xóa mù chữ với hơn 6.200 học viên là đồng bào dân tộc thiểu số."}]}