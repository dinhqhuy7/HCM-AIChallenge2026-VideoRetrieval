,"until":278.6,"text":"Eat Well, Live Well. · mingày"},{"time":292.6,"until":298.9,"text":"Eat Well, Live Well. · ming · mingày · Eat Well. · gày · Eat W · mir · AJINO · AJINOMO1 · MOTO. · moi-agay"},{"time":299.3,"until":308.2,"text":"monngonmoingay.com · Món Ngon Mōi Ngày"},{"time":309.8,"until":321.7,"text":"200g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · NGUYÊN LIÊU · Công ty HKFilm · Phi hp thc hin · ·KEM VANI · ·DÂU TÂY · · TRÀ MATCHA GAO RANG · · KEM DÁNH BÔNG · Bán quyn kch bán và cău trúc · Thc hin chương trình · ·CHUI · 1 quà · ·DÂU PHONG RANG · ·DÃU TÃY · chương trình thuc · DÀI TRUYÊN HINH · THÀNH PHÓ HO CHÍMINH · Onlil"}],"speech":[{"time":12.2,"text":"Candy gạo rang kem chuối, chân ái cho mùa Valentine."},{"time":34.3,"text":"Rất vui khi được gặp lại quý vị khán giả đang xem chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành."},{"time":39.1,"text":"Chương trình được tài trợ bởi công ty Agino Moto Việt Nam."},{"time":42.8,"text":"Và thưa các bạn, ngày hôm nay chúng ta không phải là một món mặn, không phải là một món trắng miệng, là một món dạy khác."},{"time":53.6,"text":"Và Kim Thảo nghĩ rằng thức uống chính là một nhịp cầu nối cảm xúc rất hữu hiệu khi chúng ta muốn kết nối với một ai đó."},{"time":60.2,"text":"Đúng vậy, thưa các bạn món ngày hôm nay của chúng ta có tên gọi là"},{"time":63.9,"text":"Blendy gạo rang kem chuối các bạn ạ"},{"time":66.1,"text":"Và thưa các bạn miếng đựng chính chúng ta dùng hôm nay"},{"time":68.2,"text":"Đó là Blendy chà matcha gạo rang"},{"time":70.7,"text":"Chúng ta còn có 4 gói chúng ta khoa được 2 ly"},{"time":74.0,"text":"Bây giờ ở đây thì 1 gói chúng ta sẽ dùng 40ml nước ấm ấm"},{"time":78.8,"text":"4 gói chúng ta cho vào đây 160ml nước ấm"},{"time":82.8,"text":"Món này thực sự phải nói là người lớn cũng ghiền"},{"time":85.2,"text":"Mà các bé lại càng rất thích đúng không ạ"},{"time":87.3,"text":"Khuấy cho nó ra cái màu matcha"},{"time":90.0,"text":"Rất là hấp dẫn luôn"},{"time":91.7,"text":"Và bây giờ chúng ta phải làm lạnh nhanh nha các bạn"},{"time":94.0,"text":"Chúng ta làm lạnh trà sau khi pha"},{"time":96.2,"text":"Để đảm bảo được độ lạnh của thức uống"},{"time":98.3,"text":"Blendy trà matcha gạo rang"},{"time":100.1,"text":"Sẽ có thơm mùi gạo lứt rang"},{"time":102.5,"text":"Nhật Bản"},{"time":103.1,"text":"Và bên cạnh đó sẽ có độ béo nhẹ"},{"time":105.7,"text":"Của matcha, của trà, của sữa"},{"time":109.0,"text":"Chúng ta dùng trà chuối già"},{"time":110.5,"text":"Chúng ta cắt vô"},{"time":111.6,"text":"Bỏ vô trong máy sinh tố luôn"},{"time":113.0,"text":"Chúng ta có thể thay chuối bằng các loại hoa quả khác"},{"time":116.1,"text":"Tùy theo vị của mình nha"},{"time":117.5,"text":"Với chuối thì chúng ta đã biết là dầu chất sơ và ca ly"},{"time":120.5,"text":"Sẽ rất là tốt cho sức khỏe"},{"time":122.2,"text":"Và đặc biệt là đối với những ai là đang muốn tăng cơ bắp tập thể dục"},{"time":125.3,"text":"Vì nó ít calor"},{"time":126.7,"text":"Nhưng mà nó cho một cái cảm giác là no khá là lâu"},{"time":129.5,"text":"Rau chúng ta cắt lầm đôi theo chiều dọc"},{"time":131.9,"text":"Rồi đó chúng ta"},{"time":133.2,"text":"Cửa hình trái tim như vậy nha"},{"time":134.8,"text":"Dùng chiếc ve hình trái tim luôn"},{"time":137.3,"text":"Chúng ta mũi tên xuyên qua như vậy"},{"time":140.2,"text":"Để qua"},{"time":140.8,"text":"Và thưa các bạn"},{"time":142.7,"text":"Đây là khâu chế biến của món phương uống ngày hôm nay"},{"time":145.3,"text":"Chúng ta cho cái hộng hộp brandy, trà, matcha, rau rang vào"},{"time":150.4,"text":"Khoảng 200 gram kem vani"},{"time":153.9,"text":"Cho thêm ở đây khoảng 120 gram nước đá thôi nha các bạn"},{"time":159.3,"text":"Bây giờ thì chúng ta sẽ xay thôi các bạn"},{"time":162.0,"text":"Rất là hấp dẫn nha"},{"time":168.7,"text":"Xong"},{"time":169.1,"text":"Như vậy là chúng ta đã xong món ngày hôm nay hả anh?"},{"time":171.4,"text":"Đúng rồi, món này vô cùng dễ luôn các bạn và ai cũng có thể làm được"},{"time":174.8,"text":"Như vậy là trong dịp lễ Valentine, ngày tình nhân là chúng ta đã có một món quà"},{"time":179.6,"text":"Mà do đầu bếp Thanh Vũ đại diện cho chương trình món ngon mỗi ngày gửi đến cho các bạn khán giả"},{"time":184.5,"text":"Và các bạn khán giả thì có thể là làm món này để gửi đến cho người thân yêu của mình đúng không ạ"},{"time":189.4,"text":"Cho vợ hoặc chồng, cho người yêu của mình nữa"},{"time":191.8,"text":"Cảm ơn anh Vũ rất là nhiều"},{"time":193.2,"text":"Và để xem lại từ đầu chương trình cho đến bây giờ với công thức hoàn hảo"},{"time":196.9,"text":"Thì chúng ta hãy quét mã QR trên mạng hình quý vị nhé"},{"time":201.9,"text":"Bây giờ chúng ta chỉ cần chế ra ly chừa khoảng 2cm cho bây giờ được nha các bạn"},{"time":212.4,"text":"Nhìn rất là hấp dẫn luôn ạ"},{"time":214.2,"text":"Rồi, về làm ngay món này đi"},{"time":217.2,"text":"Như là mình đang đi uống ở nhà hàng vậy đó"},{"time":220.0,"text":"Rồi, cho kem đến bông vào"},{"time":232.8,"text":"Cái món này thử xíu được không mới ngon"},{"time":234.7,"text":"Không thể tin được là chúng ta có thể có được bộ đôi nước uống yêu thích"},{"time":239.3,"text":"Dành cho ngày Valentine mà chúng ta làm tại gia"},{"time":243.7,"text":"Thả vô đây một cái trái tim các bạn"},{"time":245.4,"text":"Wow"},{"time":247.2,"text":"Dễ thương quá"},{"time":248.2,"text":"Xong"},{"time":249.7,"text":"Thưa các bạn, món này thì chúng ta có thể dùng kèm với món tôm chiên xả trái tim"},{"time":254.5,"text":"Thì chúng ta có ngay một bữa ăn rất là lãng mạn luôn"},{"time":258.1,"text":"Dạ đúng rồi"},{"time":259.1,"text":"Đầu bếp Thanh Vũ ngày hôm nay rất là tâm lý đúng không ạ"},{"time":261.6,"text":"Không chỉ là hướng dẫn cho chúng ta một món thức uống như ở nhà hàng"},{"time":264.8,"text":"Có thể làm rất hấp dẫn vừa đẹp mắt mà còn thơm ngon nữa làm tại da luôn"},{"time":269.4,"text":"Cho ngày Valentine ngọt ngào hơn còn đề xuất một món ăn kèm nữa chứ"},{"time":273.0,"text":"Một lần nữa Kim Thảo xin phép được đại diện cho tất cả các bạn khán giả"},{"time":276.2,"text":"Gửi lời cảm ơn đến Đầu bếp Thanh Vũ rất là nhiều"},{"time":278.9,"text":"Lý trà gạo rang sánh nguyện, vị ngọt béo, thơm mùi gạo rang, hòa cùng vị chuối đậm đà"},{"time":284.9,"text":"Uống một ngụm làm mát lạnh tỏa ra, có chút bùi thơm của đậu phộng vui miệng, cân bằng"},{"time":292.2,"text":"Lý trà blendy gạo rang kem chuối là một gợi ý ngọt ngào cho mùa Valentine năm nay"},{"time":297.6,"text":"Hãy thử ngay các bạn nhé"},{"time":299.1,"text":"Và để xem lại công thức của thức uống đặc biệt ngày hôm nay cùng với rất nhiều những gợi ý khác nữa"},{"time":304.0,"text":"Chỉ cần truy cập vào Youtube website Fanbase của chương trình Món Ngon Mỗi Ngày"},{"time":308.8,"text":"Hẹn gặp lại các bạn trong những video tiếp theo."}]}