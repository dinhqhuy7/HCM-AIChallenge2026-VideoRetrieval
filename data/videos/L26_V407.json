me":67.7,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":71.4,"text":"Đầu tiên là đậu đỏ đã luộc chín"},{"time":73.6,"text":"Mình sẽ cho vào trong chảo"},{"time":74.7,"text":"Bây giờ em cho thêm 2 muỗng canh đường"},{"time":76.8,"text":"Rồi và em cho vô 1 chút xíu muối"},{"time":78.8,"text":"Để cho nó dịu cái vị ngọt lại"},{"time":80.5,"text":"Em sẽ sơn với lại lửa nhỏ nhỏ để cho đường tan ra hết"},{"time":83.6,"text":"Các bạn lưu ý là chúng ta sẽ sơn đậu đỏ còn nguyên hạt"},{"time":86.7,"text":"Giúp có cảm giác bùi bùi của hạt đậu nha"},{"time":89.2,"text":"Cô sẽ đánh nổi cái phần kem whipping này"},{"time":91.7,"text":"Trước khi mà mình đánh thì mình sẽ làm lạnh cái phần whipping cream các bạn nha"},{"time":95.8,"text":"Rồi sau đó mình sẽ cho vào trong đây mình đánh"},{"time":100.9,"text":"Và rất là nhanh cô Hà cũng đã đánh nổi cái phần whipping rồi"},{"time":104.2,"text":"Đây mình không nên đánh quá kỹ"},{"time":106.0,"text":"Bởi vì whipping mà mình đánh kỹ quá thì nó sẽ bị chảy ra"},{"time":109.2,"text":"Phần whipping này sau khi đã đánh nổi rồi thì chúng ta tiếp tục giữ trong ngăn mát"},{"time":113.1,"text":"Để cuối cùng thì chúng ta sẽ phớt lên bánh"},{"time":115.3,"text":"Rồi được rồi đó em giờ cô tắt cửa thêm"},{"time":117.4,"text":"Em thấy không? Nó dẻo dẻo đúng không?"},{"time":120.1,"text":"Thì nó sẽ có độ ngọt và độ bùi bùi"},{"time":123.3,"text":"Bây giờ thì chúng ta sẽ chuẩn bị bột để đổ bánh"},{"time":125.4,"text":"Đầu tiên thì chúng ta sẽ cho 1 gói bột bánh rán pha sẵn vị truyền thống vào đây"},{"time":129.9,"text":"Và phần đặc biệt của ngày hôm nay nữa là chúng ta sẽ trộn thêm 40g bột hạnh nhân"},{"time":136.1,"text":"Và ở đây chúng ta sẽ sử dụng là bột hạnh nhân còn sống, chưa có lan"},{"time":139.9,"text":"Bánh sẽ rất là ngon, bổ dưỡng"},{"time":142.7,"text":"Đúng rồi, rồi mình sẽ cho vào đây 170ml nước và khuấy bột"},{"time":146.7,"text":"Và trong món ăn này thì chúng ta sẽ thêm bột hạnh nhân"},{"time":149.7,"text":"Giúp món bánh thơm, ngon hơn và còn tăng dinh dưỡng nữa"},{"time":153.1,"text":"Đầu tiên thì mình sẽ đặt một cái chảo lên trên bếp"},{"time":156.6,"text":"Rồi em mở lửa giúp cô nha"},{"time":157.9,"text":"Rồi cảm ơn em"},{"time":158.9,"text":"Rồi bây giờ thì mình sẽ giảm nhiệt chảo"},{"time":161.7,"text":"Bằng cách là mình sẽ đặt lên một cái khăn ẩm"},{"time":163.9,"text":"Hồi nãy là cô có rang sơ cái hạnh nhân lát này rồi"},{"time":166.9,"text":"Bây giờ thì mình sẽ xếp cái phần hạnh nhân này lên trên cái bánh nha"},{"time":170.8,"text":"Mình xếp thành một cái hoa"},{"time":173.6,"text":"Cái hoa cứt sơ sơ gì cũng được"},{"time":176.4,"text":"Rồi bây giờ thì cô sẽ đặt lại cái cảo lên trên bếp"},{"time":179.2,"text":"Dạ"},{"time":179.6,"text":"Mình sẽ đổ bột vào"},{"time":181.5,"text":"Như bình thường mà mình đổ bánh lên thét thôi"},{"time":183.9,"text":"Bây giờ thì bánh được rồi đó"},{"time":185.6,"text":"Mình sẽ lật trở lại nha"},{"time":186.9,"text":"Em hồi hộp quá"},{"time":187.7,"text":"Wow"},{"time":190.1,"text":"Đẹp quá"},{"time":191.5,"text":"Rồi bây giờ mình sẽ lấy cái bánh này ra"},{"time":195.1,"text":"Mình sẽ"},{"time":196.6,"text":"Hạ nhiệt"},{"time":197.2,"text":"Bánh thứ 2"},{"time":197.7,"text":"Rồi mình sẽ hạ nhiệt cái chảo"},{"time":200.4,"text":"Bây giờ thì mình sẽ xếp hành nhân lên"},{"time":202.8,"text":"Hành hình bông hoa"},{"time":205.6,"text":"Ngoài bông hoa thì mình có thể là xếp hình mặt cười nữa đúng không?"},{"time":209.1,"text":"Mình có thể xếp hình ngôi nhà"},{"time":212.5,"text":"Rồi"},{"time":222.7,"text":"Và cứ như vậy thì chúng ta sẽ đổ những cái bánh bằng nhau cho đến khi mà hết bột"},{"time":228.8,"text":"Một lớp bánh"},{"time":229.9,"text":"Cô sẽ cho cái phần kem lên"},{"time":232.7,"text":"Cho đậu đỏ lên ở chính giữa nha"},{"time":234.6,"text":"Trông rất là bắt mắt"},{"time":235.8,"text":"Mình sẽ đặt cái lớp bánh thứ 2 lên"},{"time":238.2,"text":"Một cách khéo léo nha"},{"time":240.0,"text":"Rồi tiếp theo mình cũng sẽ cho một lớp whipping lên"},{"time":243.0,"text":"Một lớp đậu đỏ"},{"time":244.1,"text":"Thành nhân lát mình đã rang một cái đọt húng lũi"},{"time":247.4,"text":"Rồi, được một cái và mình sẽ trang trí một cái nữa"},{"time":251.1,"text":"Cứ mỗi bước mà cô Hà trang trí là em lại càng thấy cái bánh nó hấp dẫn hơn, càng muốn ăn hơn"},{"time":257.5,"text":"Rồi, và với bánh này thì chúng ta có thể dùng kèm với lại món trà sữa trân châu đường đen"},{"time":263.7,"text":"Wow, cô Hà thiệt là tâm lý quá"},{"time":266.4,"text":"Những miếng bánh pancake ngập tràn trong lớp kem béo nhẹ"},{"time":270.4,"text":"Rải thêm một lớp đậu đỏ bùi bùi ngọt thơm"},{"time":273.8,"text":"Lại thêm giòn giòn thơm nước từ hạnh nhân"},{"time":276.6,"text":"Vị ngon đến thẫn thờ"},{"time":278.7,"text":"Chúng ta đã có thêm một công thức bánh pancake hấp dẫn"},{"time":281.9,"text":"Cho buổi tiệc trà chiều hoặc một buổi sáng đầy năng lượng"},{"time":284.7,"text":"Các bạn hãy thử ngay nha"},{"time":286.1,"text":"Và để có thể xem lại kỹ hơn các bước của món ăn ngày hôm nay"},{"time":289.8,"text":"Và những công thức khác nữa"},{"time":291.3,"text":"Các bạn hãy truy cập vào Youtube, Website, Fanpage của chúng tôi"}]}