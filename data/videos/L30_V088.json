.1,null],["L21_V013",9519,317.3,93],["L22_V023",15601,624.0,175],["L27_V008",11632,465.2,144],["L21_V009",10373,414.9,129]]]],"onScreen":[{"time":0.1,"until":2.1,"text":"tv.tuoitre.vn"},{"time":4.9,"until":7.1,"text":"Herbalife · Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.9,"until":14.0,"text":"Herbalife · Nu đã chn, hãy hc cách kiên trì"},{"time":15.0,"until":20.2,"text":"Herbalife · Nu đã chn, hãy hc cách kiên trì · tusitrety"},{"time":20.6,"until":23.5,"text":"Herbalife · Nu đã chn, hãy hc cách kiên trì"},{"time":59.2,"until":63.3,"text":"tuoitrev · tuoitrerv · tuoitlev"},{"time":71.8,"until":73.8,"text":"LED · LED NHEADLINT"},{"time":74.0,"until":77.1,"text":"PCB"},{"time":77.3,"until":83.9,"text":"Herbalife · Huyn Bù Đǎng, tinh Bình Phưc · Ông HOÀNG VÄN MAC · tuoitreT"},{"time":97.1,"until":100.7,"text":"tuoitre"},{"time":101.7,"until":104.1,"text":"tuoitrev"},{"time":148.5,"until":150.9,"text":"tuoitrev"},{"time":157.8,"until":160.8,"text":"Herbalife · Huyn Bù Đăng, tinh Binh Phưc · Ông HOÀNG VÄN MAC · tuoitreTy"},{"time":161.0,"until":163.0,"text":"PCB · tuöitrev"},{"time":166.8,"until":169.4,"text":"tuoitreV"},{"time":169.7,"until":172.4,"text":"tuoitrety"},{"time":195.1,"until":197.0,"text":"Herbalife"},{"time":197.2,"until":199.5,"text":"Herbalife · Tác già: Yn Nhà Bi – Binh Phuc"},{"time":199.7,"until":201.8,"text":"Herbalife · Tác già: Yn Nhà Bi - Bình Phưc"},{"time":202.0,"until":204.2,"text":"Herbalife · Tác già: Yn Nhà Bi - Bình Phưc"},{"time":204.4,"until":209.0,"text":"tv.tuoitre.vn · Herbalife · Tác già: Yn Nhà Bôi - Bình Phưc · Tác gia: Yên Nha BajBinn Phuðc · tuói"}],"speech":[{"time":15.6,"text":"Kiên trì mới thu hái được lọc của trời, ở xã Thống Nhất, huyện Bù Đăng, tỉnh Bình Phước của chúng tôi có hơn 50 nóc nhà cao tầng nuôi yến, nhưng chỉ có độ hơn 10 nhà có yến đến làm tổ, gia đình chúng tôi cũng vậy, mất 2 năm trời và gấp 3 lần số tiền đầu tư ban đầu, chúng tôi mới có thể thu hái được lọc của trời."},{"time":36.7,"text":"Nếu như không kiên trì, không chịu bỏ vốn đầu tư làm lại,"},{"time":40.3,"text":"thì có lẽ gia đình chúng tôi đã phải gánh một khoản nợ khổng lồ vì nuôi Yến."},{"time":45.3,"text":"Miền đất đỏ quê tôi rộ lên phong trào nuôi Yến độ khoảng chục năm nay."},{"time":49.6,"text":"Từ độ người ta thấy từng đàn Yến bay rợp trời vào mỗi buổi chiều,"},{"time":53.3,"text":"Yến làm tổ vạ trên tầng 2, tầng 3 của một số ngôi nhà."},{"time":57.5,"text":"Thế là mọi người bắt đầu vay tiền để cất nhà nuôi Yến."},{"time":61.0,"text":"Nhà thì thuê công ty chuyên thiết kế, thi công nhà Yến để xây,"},{"time":64.8,"text":"Cũng có nhà tự đi sang tỉnh khác, nhìn xem người ta xây nhà thế nào, rồi về học hỏi và làm lại"},{"time":71.0,"text":"Gia đình tôi chọn thuê công ty, nhưng gặp thất bại ngay từ lần đầu tiên"},{"time":77.0,"text":"Xây nhà hồi đó nó nằm vào cả 5 tấm hoàn thiện, nó vào tỷ bảy thôi"},{"time":84.0,"text":"Năm 2018 là bắt đầu, tháng 5 năm 2018 là bắt đầu khởi công xây"},{"time":90.4,"text":"Đến cuối năm 2018 là mở máy, là hoàn thiện mở máy"},{"time":97.8,"text":"Đến 2020 chưa có con chim nào"},{"time":100.6,"text":"Đó lắng nhé"},{"time":101.8,"text":"Cả tài sản bỏ vào đó hết"},{"time":105.5,"text":"Thiết kế ban đầu của căn nhà Yến này rộng khoảng 5m3"},{"time":108.8,"text":"Ngăn đôi từ trệt tới lầu thành từng phòng riêng"},{"time":111.9,"text":"Nhưng do nóng quá, Yến về không làm tổ"},{"time":114.5,"text":"Chúng tôi lại đập hết tường ngăn"},{"time":117.0,"text":"Thay mới toàn bộ dàn âm loa"},{"time":119.0,"text":"Đi đường dây điện, hệ thống phun xương lại từ đầu"},{"time":121.9,"text":"Tổng tiền thu sửa 2 lần"},{"time":123.8,"text":"Nhà Yến vốn 1 tỷ 7"},{"time":125.3,"text":"Bây giờ đã tốn ngót 3 tỷ"},{"time":127.3,"text":"Đến năm 2022, gia đình tôi đón những con chim yến đầu tiên"},{"time":132.0,"text":"Bắt đầu được thu lượm lọc của trời"},{"time":134.4,"text":"Sau bao nhiêu năm cố gắng không nạn trí"},{"time":137.2,"text":"Có lúc phải vai ngân hàng"},{"time":139.0,"text":"Giờ chúng tôi cũng đã có dòng tiền ổn định mỗi tháng"},{"time":142.1,"text":"Có thương hiệu yến nhà bối"},{"time":143.9,"text":"Có yến sạch nhà làm cho cả gia đình sử dụng"},{"time":146.8,"text":"Có nguồn thu, nguồn yến ổn định"},{"time":149.1,"text":"Nên gia đình tinh chế luôn hành yến xào"},{"time":151.6,"text":"Giá tổ yến thô cũng khá cao"},{"time":153.7,"text":"Việc làm ăn cũng dần trở nên phát triển"},{"time":172.4,"text":"Mặc dù còn khá lâu nữa"},{"time":175.2,"text":"thì mới hề vốn"},{"time":176.2,"text":"nhưng gia đình đã coi như vượt qua"},{"time":178.7,"text":"được giai đoạn khủng hoảng"},{"time":180.3,"text":"của lộc trời"},{"time":181.6,"text":"do cố gắng kiên trì"},{"time":183.2,"text":"cũng là do may mắn mới có được"},{"time":185.0,"text":"nên khi làm chúng tôi luôn trân trọng"},{"time":187.4,"text":"từng chiếc tổ yến, từng khách hàng"},{"time":189.4,"text":"đã tin tưởng ủng hộ, sản xuất"},{"time":191.6,"text":"và buôn bán tại gia. Những người"},{"time":193.4,"text":"làm yến như chúng tôi luôn phải cố gắng"},{"time":195.5,"text":"làm với cái tâm, vì lộc"},{"time":197.4,"text":"của trời cho. Nếu như không"},{"time":199.2,"text":"kiên trì, không thật thà"},{"time":201.2,"text":"thì sẽ không nhận được mãi."}]}