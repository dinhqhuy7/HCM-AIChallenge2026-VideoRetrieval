A"},{"time":271.4,"until":277.0,"text":"tv.tuoitre.vn · Tác già: THANH THI · tuöitréTV"}],"speech":[{"time":13.3,"text":"Bằng trái tim ấm áp và sự thấu cảm với những thiệt hồi, cả về thể chất và tinh thần của những người khuyết tật,"},{"time":20.6,"text":"anh Trịnh Công Luận đã mở ra lớp dạy thể dục miễn phí cho các em mắc hội chứng đau, tự kỷ, chậm phát triển."},{"time":28.2,"text":"Lớp học vừa tạo sân chơi lành mạnh, vừa tạo cơ hội để các em hoàn thiện và phát triển bản thân."},{"time":35.3,"text":"Suốt hơn một năm qua, cứ điều đặn từ 16h đến 17h30 thứ ba hàng tuần"},{"time":41.1,"text":"Tại một khoảng sân nhỏ bên trong sân vận động Phú Thọ, quận 10, thành phố Hồ Chí Minh"},{"time":46.3,"text":"Có một người thầy chân đi khập khiển, đang tỉ mận hướng dẫn từng bước chạy cho những học trò đặc biệt của mình"},{"time":55.0,"text":"Mục đích mà tạo ra các bạn không phải là mục đích gì cao cả"},{"time":58.5,"text":"thì tôi cũng người khuyết tật, cũng người tập luyện chủ yếu là về sức khỏe."},{"time":66.1,"text":"Còn nếu mà có thành tích tốt thì được đội tuyển quốc gia, tuyển chọn đi thi đấu quốc tế."},{"time":70.9,"text":"Thì trong những năm qua tôi tập luyện hơn 30 năm thì tôi thấy riêng bản thân tôi về khuyết tật"},{"time":78.2,"text":"thì cái sức khỏe tôi càng ngày càng tốt."},{"time":80.7,"text":"Thì riêng về các bạn bị thiểu năng trí tệ này thì cái sức đề kháng của các bạn rất là yếu."},{"time":86.7,"text":"thì tôi có sự đồng cảm với các phụ huynh mà có con em vậy hai diễn các bạn bị thiểu năng này thì tôi"},{"time":94.4,"text":"có hứa là và sinh ở bên cộng đồng thì tôi sẽ hứa tôi hỗ trợ các bạn một buổi tập để tăng cường các"},{"time":104.2,"text":"bạn được bao nhiêu thì cứ bao nhiêu cuộc đời anh Luận không mai khi mắc căn bệnh sốt bại liệt lúc"},{"time":110.8,"text":"11 tháng tuổi. Kể từ đó"},{"time":113.0,"text":"hai chân anh không còn đi đứng"},{"time":114.8,"text":"như bình thường. Chính vì thế"},{"time":116.8,"text":"hơn ai hết anh lượng thấm thiến"},{"time":119.0,"text":"được những thiệt thòi cả về"},{"time":120.6,"text":"thể chất và tinh thần mà các em"},{"time":122.7,"text":"phải giánh chịu. Do đó"},{"time":124.6,"text":"lớp học là nơi để anh chia sẻ"},{"time":126.8,"text":"tinh thần thể thao với các em"},{"time":128.3,"text":"và hơn hết là sự sẻ chia và"},{"time":130.6,"text":"đồng cảm với các bậc phụ huynh"},{"time":132.3,"text":"có con em kém may mắn. Và"},{"time":134.6,"text":"thông qua liều thuốc thể thao này"},{"time":136.2,"text":"hy vọng sẽ giúp các em được đông đảo"},{"time":138.5,"text":"nhiều người quan tâm và không xa lánh"},{"time":142.4,"text":"Làm để hỗ trợ các bạn thì mình có phải có trách nhiệm"},{"time":145.4,"text":"Giống như cái tâm lòng để hướng dẫn các bạn để cho các bạn khả năng phát triển càng ngày càng tốt"},{"time":151.6,"text":"Cái quan trọng là tăng cường sức khỏe cho các bạn để chống lại những cái bệnh tật cảm cúng thông thường"},{"time":160.1,"text":"Qua một năm các bạn tập luyện thì tôi cũng có nhìn nhận các bạn có sự linh hoạt nhanh nhẹ hơn"},{"time":165.7,"text":"Thì nhờ qua tập những cái thể thao không riêng bộ môn liên kinh mà những cái bộ môn khác"},{"time":171.7,"text":"Các bạn có linh hoạt một phần nữa là quan trọng là các bạn bước ra ngoài xã hội,"},{"time":176.3,"text":"phụ huynh đưa tới, các bạn có giao tiếp với nhau, nói chuyện với nhau, đùa giỡn với nhau,"},{"time":180.6,"text":"vui vẻ với nhau, giống như được tham gia, vui chơi với nhau,"},{"time":185.1,"text":"thì sự linh hoạt của các bạn sẽ tiến bộ càng ngày càng rõ."},{"time":191.5,"text":"Đối với các em bị đau, tự kỷ, thì việc tiếp thu sẽ chậm hơn các em bình thường khác."},{"time":197.0,"text":"Nên trước khi mở lớp, anh Luận phải dành nhiều thời gian tìm hiểu về tâm lý, cách giao tiếp với các em"},{"time":203.3,"text":"Và đặc biệt là phải thật kiên trì, thông qua sự chuẩn bị kỹ lưỡng đó"},{"time":207.4,"text":"Giúp anh hiểu, gần gũi và truyền đạt với các em hiệu quả hơn"},{"time":213.1,"text":"Con tôi là nó đi theo lớp này là từ đầu luôn"},{"time":216.7,"text":"Cái chuyện học với lớp này thì nó rất là hay"},{"time":219.8,"text":"Nó vừa rèn luyện sức khỏe, nó vừa tạo cho những kỹ năng giao tiếp tốt"},{"time":225.6,"text":"Mà nó giúp cho những đứa không chỉ là về tinh thần của nó"},{"time":233.6,"text":"Mà cả những phát biểu, những câu nói của nó đều có mang ý nghĩa hết"},{"time":238.4,"text":"Nó không còn phải nhúc nhát, sợ sệt như trước"},{"time":241.8,"text":"Thì các phụ huynh ở đây thì phải nói thẳng rằng là"},{"time":245.3,"text":"Nếu mà mình nói lời cám ơn thì cũng chưa đủ đâu với thầy"},{"time":248.5,"text":"Mà phải nói là cái lời tri ân được gửi đến thầy rất là nhiều"},{"time":254.3,"text":"Những nụ cười hồn nhiên, những tiếng gọi thầy ơi, những câu hô vang, khỏe, khỏe hay những bước chạy vụn về của các em"},{"time":262.7,"text":"là những hình ảnh đẹp khó phai trong trái tim anh luận, trong tâm tượng của các em và những bậc phụ huynh hay những người chứng kiến nhị cử cao đẹp này."}]}