time":253.0,"until":255.7,"text":"CAM · AJINOMOTO · Onlir · Eat Well. Live Well. · BÁNH RÁN · DÁY DÙ DINH DUÖNG · BÜA ÃN · MÁT ONG · VÓI"},{"time":255.9,"until":262.9,"text":"MINUS-ZERO COOUNG · EatWed,Live · Eat Well, Live Wol · INOMOTOD · TO CODING"},{"time":263.7,"until":268.8,"text":"AJINOMOTO · Onlir · Eat Well, Live Well."},{"time":279.3,"until":284.6,"text":"Blendy · AJINOMOTO · Eat Well, Live Well · Singay · AJINON · Eat Wel · gày · moi"},{"time":285.0,"until":297.3,"text":"monngonmoingay.com · Blendy · AJINOMOTO · Món Ngon Mōi Ngày · MON · gqingay"},{"time":299.9,"until":309.5,"text":"150g · Công ty Ajinomoto Vit Nam · 3 gói · Công ty Hakuhodo Vit Nam · Tham gia thc hin · Công ty Golden Scale · Bn quyn kch bn và cu trúc · ·KEM TOPPING · Công ty HKFilm · NGUYÊN LIÊU · ·HANH NHÂN LÁT · Phi hp thc hin · 4 cái · · Blendy® Trà Matcha · ·BÁNH QUÊ · chương trình thuc · Thc hin chương trình · THÀNH PHÓ HO CHÍ MINH · DÀI TRUYÊN HìNH"}],"speech":[{"time":34.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":37.9,"text":"Các bạn khán giả thân mến, nếu như có một ngày nào đó mà các bạn cảm thấy mình lạc quan giữa đám đông"},{"time":45.3,"text":"Nhưng khi một mình thì lại không"},{"time":46.9,"text":"Thì hãy làm ngay món của ngày hôm nay"},{"time":49.4,"text":"Đó chính là kem vị trà xanh Matcha Blendy"},{"time":52.6,"text":"Xong rồi sau đó chúng ta cho vào trong tủ lạnh để ăn"},{"time":55.9,"text":"Để có thể là chúng ta chữa lành cho tâm hồn của mình đó"},{"time":59.2,"text":"Đúng rồi nhưng mà lại rất là đơn giản luôn"},{"time":61.9,"text":"Đầu tiên thì chắc phải nhờ Kim Thảo pha dùm cho 3 gói trà matcha sữa Blendy"},{"time":66.9,"text":"Và chúng ta sẽ pha với 50 gram nước sôi"},{"time":69.6,"text":"Kim Thảo khuấy nó tan rồi nè"},{"time":74.6,"text":"Rồi cảm ơn Kim Thảo"},{"time":75.8,"text":"Và chúng ta sẽ để hỗn hợp Blendy thật là nguội và chúng ta hãy cho vào kem"},{"time":79.6,"text":"Làm như vậy thì giúp cho kem không bị chảy"},{"time":81.9,"text":"Bây giờ thì Phương Hương sẽ đặt lên trên bếp một cái chảo để chúng ta rang phần hạnh nhân lát"},{"time":86.3,"text":"Đây là phần hạnh nhân lát"},{"time":87.7,"text":"Mình sẽ cho vào chảo luôn ha"},{"time":89.0,"text":"Cho vào luôn"},{"time":89.6,"text":"Kim Thảo còn được biết là trong hạnh nhân có chất pha-ni-la-la-nin"},{"time":93.0,"text":"Rất là tốt cho tinh thần của chúng ta"},{"time":95.5,"text":"Giảm căng thẳng, giảm stress"},{"time":97.1,"text":"Thành ra là ngày hôm nay với món kem vị trà xanh matcha blendy"},{"time":101.3,"text":"Mà cho hạnh nhân vào thì thật sự là rất là hợp lý đúng không ạ?"},{"time":104.9,"text":"Bây giờ thì phần hạnh nhân lát cũng đã dậy lên một cái mùi rất là thơm rồi"},{"time":108.7,"text":"Phải đưa cái phần hạnh nhân lát này ra"},{"time":111.6,"text":"Rồi"},{"time":113.4,"text":"Và bây giờ Phước Hương sẽ cho vào đây là 150g topping"},{"time":118.7,"text":"Chúng ta sẽ đánh cho cái phần topping này nổi bông lên"},{"time":124.8,"text":"Bây giờ thì phần topping của mình đã gần có cái độ cứng và xốp lên rồi"},{"time":128.8,"text":"Bây giờ thì phần topping cũng đã nổi cứng rồi"},{"time":131.6,"text":"Và bây giờ chúng ta sẽ lần lượt chúng ta cho cái vòng blend đi vào"},{"time":134.8,"text":"Và đây cũng là một lưu ý cho quý vị khán giả"},{"time":136.7,"text":"Chúng ta sẽ đánh bông kem và cho pha hỗn hợp blend đi"},{"time":139.8,"text":"Làm như vậy thì giúp cho kem được bông xốp"},{"time":143.0,"text":"Bây giờ chúng ta sẽ đánh đều lên"},{"time":145.0,"text":"Để cho phần topping cũng như là blend đi nó đều lại với nhau"},{"time":157.6,"text":"Và bây giờ chúng ta sẽ cho hết luôn"},{"time":169.7,"text":"Bây giờ thì hỗn hợp topping cũng như là blendy matcha trà xanh cũng đã đồng nhất với nhau rồi"},{"time":174.8,"text":"Bây giờ chúng ta sẽ không đánh nữa"},{"time":178.7,"text":"Bông lên đẹp quá"},{"time":181.8,"text":"Và ở đây Phước Hương cũng đã chuẩn bị sẵn một cái tô để chúng ta cho vào"},{"time":185.7,"text":"Bây giờ thì nổi sớp rất là ngon"},{"time":187.8,"text":"Mà dậy lên cái mùi matcha rất là thơm luôn"},{"time":192.0,"text":"Sau khi mà chúng ta đã cho ra một cái tô rồi"},{"time":194.5,"text":"Thì bây giờ Phước Hương sẽ cho vào ngăn đông của tủ lạnh khoảng 4-5 tiếng"},{"time":198.3,"text":"Khi ăn thì chúng ta sẽ lấy ra thưởng thức thôi"},{"time":200.4,"text":"Cảm ơn Phước Hưng"},{"time":201.7,"text":"Và không thể tưởng tượng một món kem mình làm tại nhà"},{"time":204.9,"text":"Nhìn rất là hấp dẫn, thơm ngon"},{"time":207.1,"text":"Mà lại cực kỳ đơn giản như vậy"},{"time":209.1,"text":"Quý vị và các bạn có thể quét mã QR trên mạng hình của chúng tôi"},{"time":212.8,"text":"Để ghi nhớ công thức cực kỳ đơn giản ngày hôm nay nhé"},{"time":217.7,"text":"Phần kem cũng đã hơn 4 tiếng đồng hồ rồi"},{"time":220.4,"text":"Rất là đông, rất là ngon"},{"time":221.8,"text":"Chúng ta sẽ múc kem vào ly"},{"time":223.2,"text":"Phước Hưng cũng đã chuẩn bị sẵn một cái ly để chúng ta ăn kem"},{"time":225.9,"text":"Rất là xinh luôn"},{"time":232.6,"text":"Chúng ta sẽ cho một ít hạnh nhân lát trên mặt kem"},{"time":235.6,"text":"Còn Kim Thảo lấy bánh quế chúng ta cho vào kem luôn"},{"time":249.5,"text":"Và để tạo nên một cái bữa ăn đầy dinh dưỡng"},{"time":251.6,"text":"Thì chúng ta có thể kết hợp với món bánh rán cam mật ong"},{"time":254.6,"text":"Sẽ rất là thú vị luôn"},{"time":255.6,"text":"Như vậy là ngày hôm nay chúng ta đã có thể tự làm kem ăn ở nhà rồi"},{"time":259.2,"text":"Mà lại còn một vị kem rất là ngon đặc biệt nữa chứ"},{"time":262.9,"text":"Kim Thảo tin chắc rằng là cả nhà của mình sẽ rất thích thú với món kem này"},{"time":266.6,"text":"Nếu có sẵn ở trong tủ lạnh đấy ạ"},{"time":268.6,"text":"Kem bông xốp, mịn ngon, thơm mùi trà matcha, béo béo vị sữa và kem topping"},{"time":274.4,"text":"Nếm vào là tan ngay trên đầu lưỡi, mát lạnh tuyệt vời"},{"time":279.0,"text":"Món kem hôm nay đơn giản và ngon không thể hình dung"},{"time":282.6,"text":"Các bạn hãy làm thử ngay nhé"},{"time":284.3,"text":"Và đơn giản hơn nữa đó là chúng ta ghi nhớ lại công thức của món ăn ngày hôm nay"},{"time":288.7,"text":"Và nhiều món ăn khác nữa để chúng ta kết hợp lại thành một bữa ăn hoàn chỉnh"},{"time":292.7,"text":"Chỉ cần truy cập vào Youtube, website, fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":297.2,"text":"Cảm ơn các bạn đã theo dõi và hẹn gặp lại."}]}