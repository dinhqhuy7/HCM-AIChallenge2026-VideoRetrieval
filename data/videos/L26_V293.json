":28.0,"text":"Phương gọt sạch sẽ sẵn luôn"},{"time":29.2,"text":"Phương Hưng nhìn củ sen này thì lại nhớ"},{"time":31.2,"text":"Khi mà chúng ta ăn củ sen nhiều"},{"time":32.6,"text":"Cũng như là hạt sen lại rất là an thần"},{"time":34.6,"text":"Rất là dễ ngủ"},{"time":35.9,"text":"Vậy thì ngày hôm nay đã có củ sen rồi nè"},{"time":37.9,"text":"Phương Hưng sẽ kết hợp với sườn"},{"time":39.6,"text":"Làm một cái món kho rất là ngon"},{"time":41.4,"text":"Bắt tay vào thôi"},{"time":45.0,"text":"Sườn non kho củ sen"},{"time":47.1,"text":"Đượm vị ngon cơm"},{"time":64.7,"text":"Mình chào các bạn đang đến với chương trình Món ngon mỗi ngày"},{"time":67.4,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":71.8,"text":"Đối với món ăn ngày hôm nay thì các bạn nên chọn những củ sen thon tròn"},{"time":75.7,"text":"Còn tươi màu sáng vỏ là củ sen ngon"},{"time":78.4,"text":"Như vậy là cái củ sen Phương chọn có đúng tiêu chuẩn không?"},{"time":82.0,"text":"Đúng tiêu chuẩn luôn"},{"time":82.9,"text":"Và bây giờ chúng ta sẽ nhờ Minh Phương sơ chế cũng như là cắt cái phần củ sen này"},{"time":87.7,"text":"Củ sen thì chúng ta sẽ cắt khối vuông khoảng 2cm"},{"time":90.7,"text":"Vì đây là món kho nên quý vị lưu ý chúng ta đừng cắt quá nhỏ"},{"time":94.3,"text":"Thì nó sẽ không có đồng đều với phần sườn non"},{"time":96.4,"text":"Phần ớt sừng thì bây giờ chúng ta sẽ cắt lát xéo"},{"time":99.8,"text":"Còn phần hành lá thì chúng ta cắt khúc"},{"time":103.2,"text":"Đối với món kho ngày hôm nay thì các bạn nên lưu ý"},{"time":105.4,"text":"Chúng ta sẽ chọn sườn non đầu mềm"},{"time":107.7,"text":"Thì sườn mới nhiều thịt khi ăn sẽ ngon hơn"},{"time":110.1,"text":"Cho hết cái phần sườn non vào tô và giờ chúng ta ướp gia vị"},{"time":113.3,"text":"Đầu tiên Phước Hưng sẽ cho vào đây 1 muỗng canh hạt nêm Azi ngon heo"},{"time":117.2,"text":"1 muỗng canh đường"},{"time":118.9,"text":"1 muỗng canh tương ớt"},{"time":120.7,"text":"1 phần 3 muỗng cà phê tiêu"},{"time":122.2,"text":"1 muỗng canh tỏi băm"},{"time":123.5,"text":"Một muỗng canh giấm gạo lên men Ajinomoto"},{"time":126.3,"text":"Ồ, lạ quá ha"},{"time":127.8,"text":"Trong công thức ướp này, Minh Phương thấy có cả giấm gạo lên men Ajinomoto"},{"time":131.8,"text":"Tại sao vậy Phước Hưng?"},{"time":133.0,"text":"Đúng rồi đó Minh Phương"},{"time":133.9,"text":"Và đây cũng là một cái bí quyết cho các bạn nha"},{"time":136.1,"text":"Chúng ta sẽ ướp một ít giấm gạo lên men Ajinomoto vào trong sườn"},{"time":139.9,"text":"Làm như vậy thì sẽ giúp cho sườn mềm mỏng khi ăn sẽ ngon hơn"},{"time":143.7,"text":"Chúng ta sẽ ướp sườn này từ 10 tới 15 phút là đã được rồi"},{"time":147.0,"text":"Và bây giờ Phước Hưng sẽ đặt trên bếp một cái chảo để chúng ta kho sườn"},{"time":149.9,"text":"Cho vào đây khoảng một muỗng canh dầu ăn để chúng ta làm caramel"},{"time":152.7,"text":"Phương cho vào đây 2 muỗng canh đường"},{"time":156.9,"text":"Bây giờ chúng ta sẽ cho sườn vô"},{"time":158.6,"text":"Sau khi mà các bạn chúng ta cho phần sườn vào rồi thì chúng ta sẽ xào cho sườn thật là săn lại"},{"time":163.5,"text":"Khi mà kho món sườn thì chúng ta nên hắn caramel để tạo cái màu và cái sự hấp dẫn cho món ăn đúng không?"},{"time":169.0,"text":"Đúng rồi, nó có cái màu tự nhiên hơn"},{"time":170.7,"text":"Rồi bây giờ chúng ta sẽ cho nước xăm xắp mặt sườn"},{"time":173.9,"text":"Phần sườn non thì Minh Phương thấy cái phần thịt nó mềm nè, nó mọng nước mà nó không có quá dai"},{"time":178.7,"text":"Cho nên là mình chế biến được rất là nhiều món"},{"time":180.8,"text":"Và Minh Phương được tìm hiểu thì trong cái phần thịt ở sườn non nó có rất là nhiều chất đạm nè, chất sắc nè"},{"time":186.9,"text":"Không những tốt cho trẻ nhỏ, cho người lớn tuổi mà phụ nữ mang thai ăn thịt sườn non rất là giàu chất dinh dưỡng"},{"time":192.8,"text":"Và sau khi mà phần nước kho đã sôi trở lại, Phước Hương sẽ cho hết cái phần củ sen vào"},{"time":197.4,"text":"Chúng ta kho chung với lại phần sườn"},{"time":200.1,"text":"Chúng ta kho lửa vừa thôi để mà cho gia vị từ từ thấm vào củ sen cũng như là sườn non"},{"time":205.1,"text":"Trông rất là hấp dẫn"},{"time":206.6,"text":"Và ngoài ra trong đông y còn xem củ sen là một cái vị thuốc"},{"time":211.3,"text":"Giúp cho các phụ nữ mang thai an thai nè"},{"time":213.8,"text":"Và tăng cường sức khỏe nữa"},{"time":215.0,"text":"Củ sen cũng giúp được trẻ em tránh được cái bệnh vàng da"},{"time":218.4,"text":"Và bây giờ cái phần nước kho cũng đã sánh cạn lại rồi nè"},{"time":221.5,"text":"Chúng ta sẽ tăng lửa lớn lên lại một tí"},{"time":224.0,"text":"Để cho cái nước nó nhanh cạn"},{"time":225.5,"text":"Và các bạn ơi trong lúc chúng ta theo dõi các thao tác của Phước Hưng hướng dẫn"},{"time":229.2,"text":"Chúng ta bỏ qua một cái công đoạn nào đó thì không sao"},{"time":232.0,"text":"Chỉ cần dùng điện thoại quát mã QR của chương trình Món Ngon Mỗi Ngày"},{"time":236.2,"text":"Đang hiển thị trên màn hình để xem lại công thức của món ăn ngày hôm nay nha"},{"time":239.3,"text":"Cuối cùng Phước Hưng sẽ cho vào đây ớt sừng và hành lá nè"},{"time":242.4,"text":"Chúng ta sẽ tắt bếp và chúng ta sẽ đảo đều"},{"time":245.2,"text":"Vậy là món kho đã xong"},{"time":248.8,"text":"Rồi và bây giờ chúng ta sẽ trình bài ra món ăn"},{"time":251.0,"text":"Wow"},{"time":252.5,"text":"Mình Phương thích cái phần nước sốt đó"},{"time":255.2,"text":"Nó sống sánh và nó cũng có một cái màu caramel rất là hấp dẫn"},{"time":258.9,"text":"Ít củ sen nữa nè"},{"time":260.4,"text":"Đúng rồi"},{"time":261.8,"text":"Rồi cuối cùng Hưng sẽ cho lên đây một ít ngò rí nè"},{"time":264.4,"text":"Để tăng thêm màu xanh cho món ăn"},{"time":266.4,"text":"Như vậy là món kho ngày hôm nay đỏ hoàn thành rồi"},{"time":269.1,"text":"Món kho ngày hôm nay các bạn nên nhớ chúng ta sẽ kết hợp với cơm trắng nè"},{"time":272.6,"text":"Và chấm với một ít nước tương ăn cũng sẽ rất là ngon"},{"time":275.1,"text":"Và để tạo nên một bữa ăn dinh dưỡng thì chúng ta có thể kết hợp với món canh đầu cá bóp ăn cũng sẽ rất là ngon"},{"time":280.7,"text":"Sườn kho chín mềm, củ sen giòn ngon, thấm vị đậm đà"},{"time":285.1,"text":"Thoáng một chút chua nhẹ nhẹ, cay cay, dư vị thật đắm say"},{"time":289.9,"text":"Công thức hoàn hảo cho món sườn non kho củ sen đã có rồi"},{"time":293.8,"text":"Chân chơi gì nữa, vào bếp ngay thôi"},{"time":296.3,"text":"Để tìm hiểu thêm nhiều công thức của các món ăn ngon"},{"time":299.1,"text":"Thì các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":303.4,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}