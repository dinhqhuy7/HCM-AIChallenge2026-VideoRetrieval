"},{"time":221.6,"until":222.8,"text":"NGON · AJINOMOTO · Ajingon · moingày"},{"time":223.3,"until":225.4,"text":"MIGON"},{"time":226.6,"until":234.2,"text":"NGON · AJINOMOTO · Ajingon · QUÉT MÃ QR DÊ XEM CÔNG THÚC · moingày · MON"},{"time":234.6,"until":236.4,"text":"NGON · mingày"},{"time":247.1,"until":249.6,"text":"NGON · AJINOMOTO · Onli · Eat Well, Live Well. · moingày · ina"},{"time":249.8,"until":252.5,"text":"NGON · gay · moing · moingay · AJINOMOTO · AJI-NC-MOTO · 味の素 · mInus-ZERO COOUNG"},{"time":252.7,"until":256.1,"text":"ine"},{"time":256.3,"until":257.8,"text":"NGON · gay · moingay · AJINCMOTO · Thu · 味の素 · day"},{"time":258.2,"until":262.2,"text":"#NuChunnLành"},{"time":271.6,"until":277.2,"text":"NGON · MOTO · Ajingon · mingày · Eat Well, Live We · NOON · MON · moingày · moingàv · Eat Well, · Aii-noon"},{"time":277.6,"until":286.8,"text":"monngonmoingay.com · NGON · Món Ngon Mōi Ngày · mingay · AJINOMOTO · Ajungon · MON · MBNOMOTO"},{"time":288.2,"until":299.8,"text":"300g · 100g · Công ty Ajinomoto Vit Nam · Công ty Hakuhodo · Tham gia thc hin · 2 trái · 1/2 con · Công ty Golden Scale · Công ty HKFilm · NGUYÊN LIÊU · Bn quyn kch bn và cu trúc · 6 cây · · Gim go lên men Ajinomoto · · RAU OM, NGÒ GAI, HÚNG QUE · ·MÄNG CHUA · Phi hp thc hin · ·SÀ · ·BOt ngot AJI-NO-MOTO® · ·TÒI BÄM · · Hat nêm Aji-ngon® Heo · Thc hin chương trình · ·VIT XIÊM · · MÀU DÁU DIÉU · chuơng trình thuc · ·SÀ BÄM · ·NUÓC DÙA TUOI · DÀI TRUYÊN HìNH TP. HCM · Thc hin chươ · ·GÜNG BÄM · ·NÁM ROM · ·GÙNG BÄM · ·GÜNG BÃM"}],"speech":[{"time":11.9,"text":"Lẩu vịt hầm sả, mềm thơm đậm vị, ai ăn cũng mê"},{"time":31.2,"text":"Rất vui được gặp lại các bạn khán giả đang đến với chương trình Món ngon mỗi ngày"},{"time":34.5,"text":"Nấu chuẩn, ăn lành"},{"time":36.1,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":40.6,"text":"Phần thịt vịt khi mà các bạn mua về"},{"time":42.5,"text":"Chúng ta sẽ sử dụng gừng và rượu để khử mùi hoài lông của vịt"},{"time":46.4,"text":"Rửa sạch và chặt ra thành từng miếng vừa ăn"},{"time":48.6,"text":"Chúng ta sử dụng vịt xiêm hay là vịt cỏ cũng đều được luôn"},{"time":52.0,"text":"Thì bây giờ chúng ta sẽ cho vào tô, chúng ta ướp gia vị"},{"time":54.5,"text":"Đầu tiên Phước Hưng sẽ cho vào đây 2 muỗng canh xả băm, 1 muỗng canh tỏi băm, 1 muỗng canh gừng băm, 1 muỗng cà phê ớt băm, 1 muỗng cà phê bột ngọt Ajinomoto, 2 muỗng cà phê hạt nêm Ajinon heo, 1 muỗng canh đường, 3 muỗng canh giấm gạo lên men Ajinomoto."},{"time":73.2,"text":"Và đây cũng là một lưu ý cho món ăn này các bạn nha."},{"time":75.9,"text":"Chúng ta sẽ ướp vịt hơi đậm để món thịt vịt khi nấu vị sẽ đậm đà, sẽ không bị nhạt khi ăn sẽ ngon hơn."},{"time":82.1,"text":"Chúng ta sẽ ướp thịt vịt khoảng 15 phút là đã thấm rồi"},{"time":85.0,"text":"Với các gia vị mang tính nóng ngày hôm nay"},{"time":87.7,"text":"Khi chúng ta kết hợp với thịt vịt có tính hàng"},{"time":90.2,"text":"Thì sẽ tạo nên được sự cân bằng"},{"time":92.3,"text":"Rất là hay luôn"},{"time":93.2,"text":"Phần xả cây bây giờ chúng ta sẽ đập dập các khúc vừa ăn"},{"time":100.5,"text":"Rồi"},{"time":101.0,"text":"Vừa đã xong phần xả"},{"time":102.1,"text":"Còn đây là phần rau nêm"},{"time":103.6,"text":"Chúng ta sẽ cắt rối"},{"time":104.7,"text":"Có ngò gai, rau ôm và lá quế"},{"time":107.5,"text":"Đúng rồi"},{"time":108.9,"text":"Rồi"},{"time":109.4,"text":"Và bây giờ thì tất cả nguyên liệu cũng đã sẵn sàng"},{"time":111.7,"text":"Chúng ta sẽ đặt một cái nồi lên trên bếp để chúng ta nấu lẩu"},{"time":114.9,"text":"Cho vào đây khoảng 2 muỗng canh dầu ăn"},{"time":117.4,"text":"Dầu cũng đã nóng"},{"time":118.5,"text":"Phước Hương sẽ cho tỏi băm vào"},{"time":121.1,"text":"Cho sả cây vào luôn"},{"time":122.6,"text":"Và chúng ta phi thơm"},{"time":123.8,"text":"Rất là thơm rồi"},{"time":125.1,"text":"Chúng ta sẽ cho phần thịt vịt vào"},{"time":127.1,"text":"Chúng ta xào xăng"},{"time":128.6,"text":"Và đối với món ăn ngày hôm nay"},{"time":130.1,"text":"Thì chúng ta sẽ xào xăng thịt vịt thật là kỹ"},{"time":132.6,"text":"Với các gia vị"},{"time":133.5,"text":"Để chúng ta cho nước vào"},{"time":135.3,"text":"Thì thịt vịt sẽ thơm ngon hơn"},{"time":136.8,"text":"Sẽ thấm vị hơn"},{"time":137.7,"text":"Tiếp tục chúng ta sẽ cho phần nấm rơm vào nè"},{"time":140.4,"text":"Và măng chua vào luôn"},{"time":141.9,"text":"Và bây giờ chúng ta sẽ xào chung"},{"time":143.9,"text":"Và ở đây Phước Hương cũng đã chuẩn bị sẵn là 2 lít nước"},{"time":147.3,"text":"Trong đó có 1 lít nước dừa tươi và 1 lít nước lạnh nè"},{"time":150.7,"text":"Sẽ cho vào"},{"time":151.4,"text":"Chúng ta đậy nắp lại nấu lửa vừa đến khi nào thịt vịt chín mềm là được"},{"time":155.0,"text":"Như chúng ta đã biết thịt vịt rất là bổ dưỡng"},{"time":157.0,"text":"Bởi vì có rất là nhiều hàm lượng protein"},{"time":158.9,"text":"Bên cạnh đó còn có các chất như là sắc, phốt pho hay là canxi"},{"time":163.2,"text":"Chính vì điều này mà thịt vịt sẽ rất là hợp lý"},{"time":165.5,"text":"Nếu như chúng ta kết hợp với một nguyên liệu nào đó"},{"time":167.4,"text":"Có nhiều tính acid, ví dụ như là măng chua"},{"time":170.2,"text":"Đúng rồi"},{"time":170.7,"text":"Chính vì sự kết hợp này sẽ giúp cho chúng ta dễ hấp thụ các chất dinh dưỡng này hơn"},{"time":175.3,"text":"Wow, một món ăn đầy đủ chất dinh dưỡng mà lại rất là dễ làm nữa"},{"time":179.5,"text":"Phần nước lẩu cũng đã sôi trở lại và bây giờ chúng ta sẽ nêm gia vị vào đây"},{"time":183.5,"text":"Để cho thịt vịt được thấm vị hơn nữa"},{"time":186.0,"text":"Đầu tiên Phước Hưng sẽ cho vào đây là 2 muỗng cà phê hạt nêm Ajinomoto"},{"time":189.8,"text":"1 muỗng canh đường"},{"time":191.0,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":193.4,"text":"Phước Hưng sẽ sử dụng nửa chén giấm gạo lên men Ajinomoto"},{"time":199.6,"text":"2 muỗng canh nước mắm"},{"time":204.5,"text":"Và cuối cùng Phước Hương sẽ cho vào đây 2 muỗng canh dầu điều để tăng thêm màu sắc cho món lẩu"},{"time":209.4,"text":"Cho 1 phần 2 lượng rau nêm vào đây"},{"time":211.5,"text":"Chúng ta sẽ tắt bếp nè"},{"time":213.3,"text":"Như vậy là món lẩu vịt hàm xả của chúng ta đến đây đã hoàn tất rồi"},{"time":216.8,"text":"Khi chúng ta hiểu đúng về thành phần dinh dưỡng cũng như là biết cách kết hợp với nhau"},{"time":220.5,"text":"Thì quả thật vừa nấu chuẩn mà lại có những món ăn thơm ngon và tốt cho sức khỏe nữa"},{"time":225.3,"text":"Chúng ta có thể sử dụng điện thoại di động để quét mã QR đang hiển thị trên màn hình"},{"time":229.7,"text":"Để xem thêm nhiều thông tin và công thức của các món ngon trong chương trình Món ngon mỗi ngày các bạn nhé"},{"time":236.4,"text":"Và bây giờ chúng ta sẽ múc lẩu ra"},{"time":241.8,"text":"Cho lên đây một đọt rau ơm nè"},{"time":244.6,"text":"Cho thêm một ít rau nêm lên bên trên"},{"time":246.8,"text":"Và bây giờ thì món lẩu vịt của chúng ta đã hoàn tất"},{"time":249.5,"text":"Và đây là một món lẩu cho nên chúng ta sẽ dùng nóng"},{"time":252.4,"text":"Khi ăn thì chúng ta sẽ nhúng rau từ từ ăn đến đâu nhúng đến đó"},{"time":255.8,"text":"Để hương vị sẽ thơm ngon hơn quý vị nhé"},{"time":258.0,"text":"Lẩu có nước dùng chua nhẹ, ngọt của vịt, thơm của sả"},{"time":262.0,"text":"Rất khó quên"},{"time":263.2,"text":"Thịt vịt mềm, thấm vị"},{"time":265.1,"text":"Ăn cùng măng giòn giòn"},{"time":266.9,"text":"Nhúng thêm rau củ thanh mát"},{"time":268.8,"text":"Cuốn vị không ngừng"},{"time":271.2,"text":"Các bạn hãy nhớ ăn thịt vịt nhé"},{"time":273.0,"text":"Nhưng sẽ là một hương vị mới lạ"},{"time":274.8,"text":"Đến từ món lẩu vịt hầm xả"},{"time":277.0,"text":"Và để tìm hiểu thêm nhiều thông tin các món ăn ngon"},{"time":279.6,"text":"Thì đừng quên truy cập vào kênh youtube"},{"time":281.9,"text":"Website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":284.1,"text":"Xin chào tạm biệt và hẹn gặp lại"}]}