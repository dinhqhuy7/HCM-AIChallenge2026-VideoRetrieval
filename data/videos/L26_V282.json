],"speech":[{"time":12.7,"text":"Đầu tiên mua kiếm sườn non"},{"time":14.6,"text":"Mang về rửa sạch không còn bẩn nha"},{"time":18.0,"text":"Xong rồi mình ướp gì ta?"},{"time":20.6,"text":"Xong rồi mình ướp tỏi, hành và hạt nêm"},{"time":23.5,"text":"Trời ơi"},{"time":26.1,"text":"Bữa nay qua hai đứa dằn thờ quá trời luôn á"},{"time":28.7,"text":"Dằn luôn á"},{"time":29.9,"text":"Hiện tại thì mình đã có những cái cây sườn non rất là ngon rồi đúng không nè"},{"time":33.6,"text":"Nhưng mà thường thì sườn non người ta chỉ biết kho hoặc là làm những món hàm thôi"},{"time":37.5,"text":"Ngày hôm nay Phước Hương sẽ hướng dẫn cho các bạn một cái món canh từ sườn non rất là lạ miệng"},{"time":42.5,"text":"Vậy thì bây giờ mình thực hiện ngay thôi"},{"time":47.3,"text":"Xì xụp nóng hổi hấp dẫn với canh chua sườn"},{"time":66.5,"text":"Mình chào các bạn đang đến với chương trình Món Ngon Mỗi Ngày"},{"time":69.4,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":73.8,"text":"Đây là phần sườn non mà chúng ta đã sơ chế sẵn rồi"},{"time":76.4,"text":"Phước Hưng sẽ ướp gia vị vào đây để cho sườn được thấm"},{"time":79.4,"text":"Đầu tiên Phước Hưng sẽ cho vào đây 1 muỗng canh hành và tỏi bằm"},{"time":82.7,"text":"Nửa muỗng cà phê hạt nêm Ajinomoto"},{"time":84.7,"text":"Tiếp theo Phước Hưng sẽ cho vào đây 1 muỗng cà phê gia vị nêm sẵn Ajinomoto"},{"time":89.3,"text":"Chúng ta sẽ ướp gia vị nêm sẵn Ajiquit lẩu thái với sườn"},{"time":93.0,"text":"Giúp cho sườn có vị chua cay"},{"time":95.0,"text":"Khi ăn thì sườn có hương vị đặc trưng hơn"},{"time":99.0,"text":"Gia vị nêm sẵn Ajiquit lẩu thái không chỉ có thể làm nước dùng được"},{"time":102.5,"text":"Mà còn có thể nêm nếm gia vị được luôn"},{"time":104.4,"text":"Sườn non rất là ngon mà lại còn nhiều giá trị dinh dưỡng nữa"},{"time":108.3,"text":"70% giá trị dinh dưỡng của sườn non là protein"},{"time":111.8,"text":"Còn bây giờ phần cà chua thì chúng ta sẽ cắt muối cao"},{"time":120.5,"text":"Đối với món canh ngày hôm nay"},{"time":121.7,"text":"Phước Hưng sẽ sử dụng rau muống và bắp cải trắng"},{"time":124.1,"text":"Phần rau muống này thì Phước Hưng sẽ rửa sạch và để ráo"},{"time":126.8,"text":"Bây giờ chúng ta sẽ cắt thành từng cút vừa ăn"},{"time":129.1,"text":"Rồi Hưng sẽ cho qua cái dĩa"},{"time":133.7,"text":"Còn phần bắp cải này Phước Hưng sẽ cắt miếng vuông vừa ăn"},{"time":139.1,"text":"Rồi bây giờ Phước Hưng sẽ cho qua đây luôn"},{"time":141.2,"text":"Wow, qua các phần sơ chế nguyên liệu thôi"},{"time":143.6,"text":"Thì thấy là đây là một món ăn có rất là nhiều giá trị dinh dưỡng"},{"time":146.6,"text":"Rau, củ quả, đầy màu sắc và rất là tươi ngon"},{"time":149.4,"text":"Phần rau nêm chúng ta sẽ cắt nhỏ thôi để chúng ta nêm vào canh"},{"time":158.2,"text":"Và bây giờ Phước Hưng sẽ đặt lên trên bếp"},{"time":160.3,"text":"Một cái nồi để chúng ta nấu canh"},{"time":163.4,"text":"Cho vào đây khoảng 2 muỗng canh dầu ăn"},{"time":165.5,"text":"1 muỗng canh hành tím và tỏi băm"},{"time":167.6,"text":"Để chúng ta phi thơm"},{"time":169.2,"text":"Tiếp theo mình sẽ cho cà vào không Phước Hưng"},{"time":171.7,"text":"Đúng rồi cho nửa lượng cà chua"},{"time":173.8,"text":"Và chúng ta xài trước nè"},{"time":174.9,"text":"Chúng ta sẽ trừa lại"},{"time":176.8,"text":"Chúng ta sẽ xào cà chua để cho nó ra màu"},{"time":179.7,"text":"Và tiếp tục đó"},{"time":181.6,"text":"Phước Hưng sẽ cho phần sườn non vào"},{"time":183.2,"text":"Chúng ta sẽ xào săn lên"},{"time":185.2,"text":"Bây giờ thì phần sườn non cũng đã săn rồi"},{"time":187.4,"text":"Và Phước Hưng sẽ cho vào đây 1 lít rưỡi nước."},{"time":189.7,"text":"Phước Hưng ơi, mình sẽ nấu sườn trong khoảng bao lâu thì nước dùng sẽ ngon?"},{"time":193.4,"text":"Đối với món canh ngày hôm nay thì các bạn chúng ta sẽ nấu khoảng 10-15 phút là sườn vừa chín mềm rồi."},{"time":199.1,"text":"Như vậy thì món canh sẽ ngon hơn."},{"time":201.4,"text":"Bây giờ chúng ta sẽ vớt bọt cho cái phần nước canh nó hơi trong chút xíu nè."},{"time":206.0,"text":"Cho phần ngà chua vào nè, phần bắp cải trắng vào."},{"time":209.7,"text":"Rau muống thì rất là nhanh chín, chúng ta sẽ cho sao cục."},{"time":212.6,"text":"Cho gia vị nêm sẵn, achi quyết, lẩu thái còn lại vào."},{"time":215.8,"text":"Mình không cần phải nêm nếm nhiều nè"},{"time":218.2,"text":"Và công thức cũng khá là đơn giản nữa"},{"time":220.3,"text":"Chúng ta có thể dễ dàng thực hiện ngay tại nhà"},{"time":222.1,"text":"Cuối cùng Phước Hưng sẽ cho vào đây 1 muỗng canh nước mắm"},{"time":225.5,"text":"Để phần canh thêm đậm đà hơn"},{"time":228.2,"text":"Một loại rau không thể thiếu đó chính là rau muống"},{"time":231.3,"text":"Và Hưng sẽ cho vào đây 1 ít rau nêm luôn nè"},{"time":234.0,"text":"Trộn đều lên và canh xôi trở lại là được rồi"},{"time":237.4,"text":"Wow phần canh chua cực kỳ hấp dẫn luôn các bạn ơi"},{"time":240.6,"text":"Và nếu như các bạn muốn tìm hiểu kỹ hơn về công thức của món ăn này"},{"time":243.9,"text":"Hãy quét mã QR code ở trên màn hình nha"},{"time":247.8,"text":"Wow đầy đủ màu sắc quá trời luôn"},{"time":254.1,"text":"Hấp dẫn quá"},{"time":255.0,"text":"Cuối cùng Phước Hưng sẽ cho lên đây một ít tỏi phi nè"},{"time":258.5,"text":"Không thể thiếu cho món canh chua"},{"time":260.0,"text":"Đúng rồi"},{"time":260.8,"text":"Một chút tỏi phi sẽ làm dậy lên mùi thơm của món canh chua"},{"time":263.9,"text":"Nên quả thật là món canh cực kỳ hấp dẫn Phước Hưng ơi"},{"time":266.7,"text":"Khi ăn thì chúng ta sẽ chấm với một ít nước mắm"},{"time":269.1,"text":"Và không thể thiếu đó chính là cơm trắng đúng không?"},{"time":271.4,"text":"Và để tạo nên một bữa ăn dinh dưỡng"},{"time":273.1,"text":"Thì chúng ta có thể kết hợp với món"},{"time":290.2,"text":"ngay món canh chua cay bùn vị này nhé."},{"time":292.5,"text":"Để xem lại công thức của các món ăn ngon,"},{"time":294.4,"text":"hãy truy cập vào Youtube, website và fanpage"},{"time":296.9,"text":"của chương trình Món Ngon Mỗi Ngày."},{"time":298.5,"text":"Còn bây giờ, xin được mến chào tạm biệt"},{"time":300.3,"text":"và hẹn gặp lại quý vị."}]}