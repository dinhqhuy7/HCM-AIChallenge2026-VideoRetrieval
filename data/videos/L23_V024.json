,{"time":9.2,"text":"Đi ngay sau tay đua Matilas"},{"time":11.0,"text":"Người đang được hậu thuẫn bởi người đồng đội Mikael Renn"},{"time":14.0,"text":"Đây là một trong những hình ảnh lần đầu tiên chúng ta thấy"},{"time":16.4,"text":"Tại cuộc đua năm nay khi mà hai tông song song ở hai bên đường"},{"time":20.1,"text":"Trong khi đó thì các tay đua của ekip thành phố Hồ Chí Minh Vinama"},{"time":22.5,"text":"Cũng đang tìm cách phá bỉnh tông này được tạo ra bởi các tay đua của An Giang"},{"time":26.2,"text":"và 620 Châu Thế Bình Long."},{"time":28.1,"text":"Một tay đua của Vinama đã thoát lên ở phía trên."},{"time":31.5,"text":"Với việc các tay đua của Đồng Tháp ép trái"},{"time":33.6,"text":"thì tông của quân khu 7 đã gặp bất lợi"},{"time":35.9,"text":"và không có khoảng trống để tràn lên."},{"time":38.4,"text":"Giờ là lúc Trần Tuấn Kiệt phải tìm cách"},{"time":40.8,"text":"để chen lên hàng trên"},{"time":42.0,"text":"và nếu như có thể thì buộc cho Loic Desuiac"},{"time":44.7,"text":"và Phan Hoàng Thái phải mở thêm một tông mới"},{"time":46.2,"text":"để đưa Trần Tuấn Kiệt di chuyển lên phía trên"},{"time":48.0,"text":"hoặc chính tay đua này phải chọn một vị trí"},{"time":50.1,"text":"cùng với tông của các đối thủ."},{"time":52.6,"text":"Ở tình thế hiện tại thì Trần Tuấn Kiệt"},{"time":54.2,"text":"Không thấy có lợi thế đâu cả khi mà đoàn đua còn cách 1,5 km nữa"},{"time":57.5,"text":"Và chưa thấy Trần Tuấn Kiệt tràn lên được ở phía trên"},{"time":59.6,"text":"Một động thái tràn lên phía trên của các tay đua An Giang"},{"time":62.4,"text":"Để che đi tông dành cho Trần Tuấn Kiệt"},{"time":64.4,"text":"Chúng ta thấy là tay đua mặc áo cam Nguyễn Tuấn Hoài"},{"time":66.9,"text":"Vẫn đang duy trì tông đó và đi sát với anh đó là Timofei Vanoff"},{"time":69.7,"text":"Nhưng một lần nữa thì Đồng Tháp cho thấy quyết tâm để đưa Trần Tuấn Kiệt lên phía trên"},{"time":72.8,"text":"Một đường mấu được mở ra ở bên phía bên trái dành cho tay đua của Đô Ba Ganh Đồng Tháp"},{"time":77.7,"text":"Quan trọng lúc này là có khoảng trống cho các tay đua dược"},{"time":80.2,"text":"Domesco Đồng Tháp đưa Trần Tuấn Kiệt lên hay không"},{"time":82.1,"text":"Và họ có đủ sức hay không đây"},{"time":84.5,"text":"Trước Trần Tuấn Kiệt vẫn còn 4 máy nữa"},{"time":86.5,"text":"Của ekip dược Domesco Đồng Tháp"},{"time":88.3,"text":"Và bám ngay sát anh đó là tê đua Lê Nguyệt Minh"},{"time":90.5,"text":"Người đang thi đấu với một chiếc quần màu đỏ"},{"time":92.0,"text":"Rất nổi bật ở trên đường đua vào lúc này"},{"time":93.4,"text":"Và lúc này là thời điểm để các tê đua Đồng Tháp lựa chọn"},{"time":96.0,"text":"Họ sẽ phải tăng tốc"},{"time":97.1,"text":"Trần Nguyễn Minh Trí đang mở tốc độ và đi ngay phía sau anh"},{"time":99.7,"text":"Đó là 2 máy còn lại của dược Domesco Đồng Tháp"},{"time":101.9,"text":"Trần Nguyễn Minh Trí vẫn đang là người đi phía trên"},{"time":141.2,"text":"Ngành tranh nước đốt hấp dẫn"},{"time":142.0,"text":"Và có lẽ không ai cạn được tay đua của Dovagan Đồng Tháp"},{"time":144.7,"text":"Có lẽ là Trần Tuấn Kiệt sẽ là người giành chiến thắng"},{"time":146.7,"text":"Trong trận đua ngày hôm nay"},{"time":149.7,"text":"Một kết thúc mỹ mãn cho các tay đua"},{"time":151.7,"text":"Dược Dovesco Đồng Tháp và Dovagan Đồng Tháp"},{"time":154.6,"text":"Mặc dù Mikael Rem"},{"time":155.8,"text":"Đã ôm cua trước có được vị trí thuận lợi hơn"},{"time":158.0,"text":"Nhưng có vẻ như tay đua của 620 Nông nghiệp Vĩnh Long"},{"time":160.8,"text":"Có phần bị hụt tầm"},{"time":162.4,"text":"Và Trần Tuấn Kiệt"},{"time":163.7,"text":"Ở được vào một vị trí thuận lợi"},{"time":165.3,"text":"Khi được 2 người đồng đội Phan Hoàng Thái"},{"time":167.4,"text":"Và đặc biệt là Louis Detriac dẫn vào"},{"time":172.3,"text":"Và đó là niềm vui bất tận cho hai ekip Dược Domesco Đồng Tháp và Dobaganh Đồng Tháp"},{"time":177.3,"text":"Cũng như niềm vui cho người hâm mộ đội xe đạp đất sen hồng"},{"time":180.3,"text":"Khi những người con cưng của họ đã ăn mừng chiến thắng trong trận đua ngày hôm nay"},{"time":210.6,"text":"Sẽ là một ngày vui trọn vẹn cho người hâm mộ của Đồng Tháp"},{"time":214.8,"text":"Khi những người con cưng của họ về đến quê nhà cao lãnh"},{"time":218.4,"text":"Những khán giả đã có mặt từ cả tiếng đồng hồ trước"},{"time":221.8,"text":"Và họ chấp nhận đội cái nắng oi bức để chờ đợi"},{"time":225.4,"text":"Những tay đua của Dược Domesco Đồng Tháp và Dược Domesco Đồng Tháp về đích"},{"time":229.1,"text":"Và Trần Tuấn Kiệt đã không làm phụ sự kỳ vọng của người hâm mộ"},{"time":235.2,"text":"Chân rút số 51 của Đô Ba Gạt Đồng Tháp đã có chiến thắng chặn thứ 3 ở cuộc đua năm nay"},{"time":257.1,"text":"Chúng ta xem lại đoạn về đích khi mà Mikael Rem có được một vị trí thuận lợi hơn"},{"time":266.7,"text":"Nhưng tay đua của 620 Nông Nghiệp Vĩnh Long vì một lý do nào đó có thể là hơi bị hụt chân"},{"time":273.8,"text":"Và đã nhường lại màn cảnh tranh cho Trần Tuấn Kiệt"},{"time":277.0,"text":"Ở phía sau Trần Tuấn Kiệt là Sapa Novikov"},{"time":284.3,"text":"Sapa Novikov, Lê Nguyệt Minh, Nguyễn Văn Bình và Ivanov Timofey"},{"time":288.1,"text":"Là 4 tay đua còn lại có được 1 vị trí trong 5 hạng đầu cá nhân ở chặng đua thứ 24 này"},{"time":301.0,"text":"Và ở góc ngoài này chúng ta thấy là Peter Rikunov ở phía trước của Martin Lad"},{"time":307.7,"text":"Như vậy là kết thúc chặng đua ngày hôm nay thì cách biệt điểm áo xanh của Peter Rikunov đã an toàn"},{"time":313.1,"text":"Để anh có thể bảo vệ thành công danh hiệu vua nước rút"},{"time":316.0,"text":"Trước sức tấn công của Mạc Tinh Lát trong những trận vừa qua"},{"time":319.7,"text":"Như vậy là tay đua của 620 Châu Thới Vĩnh Long"},{"time":322.4,"text":"Đã chính thức không còn cơ hội cạnh tranh danh hiệu vua nước rút"},{"time":326.0,"text":"Và chỉ có thể bảo vệ được vị trí hạng nhì trên bảng điểm áo xanh"},{"time":338.9,"text":"Chúng ta cũng có thể cảm nhận được rằng Peter Rikunov"},{"time":341.9,"text":"Sau khi đã giữ vững những danh hiệu của mình"},{"time":346.7,"text":"Cũng đã chủ động thi đấu an toàn trong những đoạn cạnh tranh nước rút"},{"time":354.6,"text":"Đối với Peter Rikunov và tập thể An Giang"},{"time":356.7,"text":"Trận đua ngày hôm qua về đến quê nhà Lâm Xuyên"},{"time":359.3,"text":"Với chiến thắng trận thứ 10 của Peter Rikunov"},{"time":361.8,"text":"Đã có thể xem là"},{"time":365.0,"text":"Một diễn biến hoàn hảo"},{"time":367.7,"text":"Một mùa giải hoàn hảo"},{"time":369.0,"text":"Cho cá nhân tay đua đang nắm giữ áo vàng"},{"time":370.8,"text":"Cũng như tập thể An Giang"},{"time":372.3,"text":"Còn ngày hôm nay là niềm vui cho Trần Tuấn Kiệt"},{"time":374.9,"text":"Và người hâm mộ của xe đạp đất sen hồng"},{"time":385.1,"text":"Hạng nhì là tay đua"},{"time":386.4,"text":"Của TP.HCM New Group Nguyễn Văn Bình"}]}