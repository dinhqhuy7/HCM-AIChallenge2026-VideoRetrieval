":250.0,"text":"ingày · AJINOMOTO. · Vell, Live Well. · Ajongon"},{"time":255.2,"until":263.6,"text":"Eat Well, Live Well. · QUÉT MÃ QR DÊ XEM CÔNG THÚC · AJINOMOTO. · moingày"},{"time":264.0,"until":265.8,"text":"mingày · MON"},{"time":286.6,"until":291.0,"text":"Blendy · móingay · AINOMOTOD · Eat Well,Live Wel · móinga · MON · AjeMaye"},{"time":291.4,"until":296.3,"text":"rine"},{"time":306.0,"until":309.8,"text":"Eat Well, Live Well. · mingày · AJINOMOTO."},{"time":310.0,"until":313.4,"text":"PANCAKE SÔ-CÔ-LA · MÚTCAM · MÉ GÀ XÀO CAY · COM · TS.BS Đào Th Yn Phi - Chuyên gia dinh dung · CANH TÔM CHUA CAY · BÜA PHU TRUA · BÜA SÁNG · CÓ DUÖNG · BÜA CHIÉU · ĐÃU HÙ XÃO NÃM · SÜA GIÀM BÉO · THÚC DON DINH DUÕNG · MÍ Ý XÀO THIT BÒ BÃM · DUOC TU VÁN BI CHUYÊN GIA DINH DUÕNG · QUYT · BÚNÖC · BÜA TÕI · THÚC DON HO TRO THN KHOE MANH"},{"time":315.8,"until":320.6,"text":"mingày · Eat Well, Live Well. · AJINOMOTO."},{"time":321.0,"until":326.8,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · AJINOMOTO · moingày"},{"time":330.2,"until":339.5,"text":"300g · 25g · 3 nhánh · Công ty Ajinomoto Vit Nam · Tham gia thc hin · NGUYÊN LIÊU · Công ty Hakuhodo Vit Nam · MÊGÀ · Công ty Golden Scale · Công ty HKFilm · Phi hp thc hin · 1 trái · XÀO CAY · ·DÁU HÀO · ·HÀNH LÁ · DAI TRUYEN HINH · Ban quyen kich ban va cau truc · Bán quyn kch bán và cău trúc · ·NUÖC TUONG · Thc hin chương trình · • GIÃM GAO LÊN MEN · · DÃU MÀU DIÊU · ·TUONG ÖT · THÀNH PHÓ HO CHÍMINH · ·TÒI BÄM · chuơng trinh thuc · ·ÖT SÜNG · ·ME GÀ · ·ÔT SÙNG · ·ÖT BOT · MÊGA · · ÖT BOT"}],"speech":[{"time":11.9,"text":"Mega được tạo hình hoa khế đẹp mắt, vị chua ngọt, cay cay hoài hòa, giòn sần sật"},{"time":17.8,"text":"Thêm chút màu sắc từ hành lá và ớt sừng"},{"time":20.3,"text":"Cuối tuần Lai Rai là chuẩn bài"},{"time":39.6,"text":"Rất vui khi được gặp lại các bạn khán giả đang theo dõi chương trình Món Ngon Mỗi Ngày"},{"time":43.5,"text":"Nấu chuẩn, ăn lành"},{"time":44.9,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":49.2,"text":"Nghị ơi, cuối tuần rồi thì có một gợi ý món ngon nào cho Minh Phương không?"},{"time":53.2,"text":"Chắc chắn là có rồi"},{"time":54.2,"text":"Cuối tuần Lai Rai thì Quốc Nghị sẽ hướng dẫn Minh Phương cùng các bạn khán giả"},{"time":58.1,"text":"Thực hiện món mê gà sầu cay nha"},{"time":60.4,"text":"Và theo chuyên gia dinh dưỡng tiến sĩ Đào Thị Yến Phi"},{"time":63.3,"text":"Thì món ăn này giúp hỗ trợ cho thằng khỏe luôn đó nha"},{"time":66.5,"text":"Nghe hấp dẫn quá"},{"time":67.8,"text":"Thôi bây giờ mình bắt tay làm liền đi"},{"time":69.3,"text":"Sẵn sàng"},{"time":69.8,"text":"Nguyên liệu chính cho món ăn ngày hôm nay đó là mê gà"},{"time":72.5,"text":"Thì các bạn mua về rửa sạch với lại nước muối giấm đi"},{"time":75.5,"text":"Và chút nữa quý vị sẽ hướng dẫn các bạn sơ chế mê gà"},{"time":78.2,"text":"Các bạn có thể sử dụng nguyên bộ lòng gà"},{"time":80.2,"text":"Nếu mà các bạn không mua được mê gà nha"},{"time":82.0,"text":"Gừng củ thì các bạn sẽ cắt lát"},{"time":84.4,"text":"Về phần hành lá thì các bạn cắt khúc khoảng 3cm"},{"time":89.1,"text":"Ớt sườn đỏ các bạn cắt lát xéo"},{"time":96.7,"text":"Bây giờ chúng ta sẽ đi trụng mề gà qua nước rượu gừng"},{"time":100.2,"text":"Các bạn cho vào nước sôi vài lát gừng"},{"time":102.3,"text":"Và một ít rượu trắng"},{"time":105.0,"text":"Cái việc trụng sơ mề gà qua nước có rượu gừng giúp khử mùi tanh trong mề gà"},{"time":109.4,"text":"Trong mề gà thì có rất là nhiều chất natri và cali"},{"time":113.3,"text":"Những khoáng chất này rất là tốt cho hoạt động của thận"},{"time":116.0,"text":"Chính vì thế mà trong bữa ăn hàng ngày mình có thể bổ sung những món ăn để giúp cho hoạt động của thần khỏe hơn"},{"time":121.7,"text":"Rồi bây giờ chúng ta sẽ vớt mì gà nè, các bạn ngâm qua một thang nước lạnh"},{"time":127.0,"text":"Tiếp theo chúng ta sẽ khứa mì gà thành hình hoa khế"},{"time":130.1,"text":"Cái mì gà này mình sẽ khứa lắc ngang như thế này, mỏng"},{"time":134.4,"text":"Sau khi khứa dọc thì các bạn tiếp tục khứa ngang nè"},{"time":138.8,"text":"Cắt lát nè"},{"time":140.6,"text":"Chúng ta đang khứa mì gà thành hoa khế để khi xào thấm vị sốt hơn"},{"time":144.4,"text":"Thú thiệt với anh Nghị nha, ở nhà mà làm những món về mề gà, Minh Phương không có cái bước này đâu"},{"time":150.1,"text":"Nhưng mà quả thật là thêm một cái thao tác tạo hình như thế này thôi"},{"time":153.9,"text":"Lát nữa khi mà chúng ta nấu và xào cái phần mề gà xong thì những cánh hoa sẽ xòe ra và có cái hình dáng rất là đẹp mắt"},{"time":161.1,"text":"Xong cái phần mề gà"},{"time":162.5,"text":"Để pha cái sốt xào cay, xào cùng mề gà thì các bạn sẽ cho vào đây 1 phần 3 muỗng cà phê tiêu"},{"time":168.0,"text":"1 muỗng cà phê ớt bột"},{"time":169.7,"text":"2 muỗng cà phê đường cát"},{"time":172.8,"text":"1 muỗng canh tương ớt"},{"time":174.5,"text":"2 muỗng canh dầu hào"},{"time":176.4,"text":"2 muỗng canh nước tương phú sỉ"},{"time":178.1,"text":"Cái nước tương của nó thơm lắm"},{"time":180.0,"text":"Và cái màu sắc cũng đẹp hơn nữa"},{"time":182.3,"text":"Đúng rồi"},{"time":182.6,"text":"Và cuối cùng là 1 muỗng canh rưỡi giám gạo lây men"},{"time":186.2,"text":"Nó có vị chua nhẹ trong cái sốt này"},{"time":188.4,"text":"Rồi bây giờ chúng ta sẽ khoái đều cái sốt này nè"},{"time":193.6,"text":"Các bạn làm nóng chảo"},{"time":194.7,"text":"Sau đó cho 1 muỗng canh dầu màu điều vào chảo"},{"time":197.9,"text":"Sau khi dầu màu điều nóng"},{"time":199.2,"text":"Các bạn sẽ cho vào đây nửa muỗng canh tỏi băm"},{"time":201.0,"text":"Chúng ta sẽ phi thơm tỏi"},{"time":205.5,"text":"Và món xào cho nên là không thể thiếu được"},{"time":207.8,"text":"Thì cái giai đoạn mà mình phi dầu nè, mình phi tỏi và cái mùi thơm nó thoát lên đúng không ạ?"},{"time":213.4,"text":"Rất là hấp dẫn."},{"time":214.4,"text":"Tỏi dài mùi thơm á, các bạn sẽ cho mì gà vào nè."},{"time":217.2,"text":"Hấp dẫn chưa?"},{"time":218.3,"text":"Mình vừa đang đợi là những cái cánh hoa kháng nó sẽ nở như thế nào."},{"time":224.2,"text":"Wow, được áo thêm một cái lớp dầu màu đều ở ngoài nữa cho nên rất là đẹp mắt anh Nghị ha."},{"time":229.9,"text":"Sẽ đảo đều nè."},{"time":231.5,"text":"Sau khi xào xăng á, các bạn sẽ cho hết cái phần nước sốt vào nè."},{"time":235.2,"text":"Cho vào đây một chén nước."},{"time":238.7,"text":"Chúng ta sẽ xào khoảng 5 phút"},{"time":243.2,"text":"Sau khi xào mê gà với sốt xào cay"},{"time":245.6,"text":"Thì các bạn sẽ cho hành lá và ớt sừng đỏ vào nè"},{"time":248.0,"text":"Trộn đều là xong"},{"time":250.7,"text":"Vì hành và ớt nó rất là dễ chiến"},{"time":252.3,"text":"Như vậy là món mê gà xào cay"},{"time":254.6,"text":"Chúng ta đã hoàn thành xong rồi"},{"time":256.1,"text":"Trong tích tắc thôi đúng không nào"},{"time":257.7,"text":"Chân chơi gì nữa chúng ta hãy dùng điện thoại của mình"},{"time":260.1,"text":"Quét mã QR đang hiển thị trên màn hình"},{"time":262.3,"text":"Để lưu lại công thức món ăn này nha"},{"time":265.8,"text":"Không để bên phương và các bạn đợi lâu nữa"},{"time":267.6,"text":"Quý vị sẽ trình bày ra đĩa thưởng thức cùng cơm nóng nha"},{"time":272.6,"text":"Hấp dẫn quá"},{"time":275.3,"text":"Về cái phần màu sắc thì không thể chê vào đâu được"},{"time":278.8,"text":"Cái mề gà được xòe cánh hoa khế trông rất là đẹp"},{"time":282.8,"text":"Và bây giờ thì Minh Phương sẽ ăn cùng với lại cơm trắng nha"},{"time":293.1,"text":"Mặn mặn nè, ngọt ngọt nè, cay cay nữa"},{"time":296.3,"text":"Nhưng mà cái điểm nhấn Minh Phương nghĩ đó chính là một chút chua chua"},{"time":299.9,"text":"Hài hòa tất cả các cái vị vừa rồi"},{"time":302.7,"text":"Đến từ giấm gạo lên men Ajinomoto"},{"time":305.1,"text":"Và để đạt được hiệu quả dinh dưỡng"},{"time":307.1,"text":"Các bạn có thể tham khảo món ăn này cùng với lại bản thực đơn một ngày sau đây các bạn nhé"},{"time":314.9,"text":"Mega xào cay, lai rai cuối tuần"},{"time":317.1,"text":"Các bạn hãy làm thử xem gia đình của mình có trầm trồ không nhé"},{"time":320.5,"text":"Và để xem thêm thông tin về món ăn thì các bạn cũng có thể truy cập vào kênh youtube, website và fanpage của Món Ngon Mỗi Ngày"}]}