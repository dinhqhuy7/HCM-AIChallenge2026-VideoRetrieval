t":"NGON · AJINOMOTO · mingày · Eat Well, Live Well. · QUÉT MÃ QR DÊ XEM CÔNG THÚC"},{"time":202.0,"until":203.6,"text":"NGON · mingày · MON"},{"time":221.6,"until":232.0,"text":"Eat Well, Live Well. · NGON · AJINOMOTO · mingày · Aagon"},{"time":232.4,"until":239.8,"text":"NGON · Eat Well,Live Well · NGO, · mingày · AINOMOTO · môing"},{"time":257.6,"until":261.0,"text":"NGON · mingày · AJINOMOTO. · Eat Well, Live Well."},{"time":264.4,"until":266.0,"text":"BÚN RIÊU CUA · COM · CHIM CÚT HAT SEN · CANH CHUA BÔNG THIÊN LÝ · TÔM SÚ KHO LÁ QUÊ · BUI · RAU CÙ XÀO XÔT CHAY · BÜATRUA · LAU CHÁO · BÜA SÁNG · THÚC DON DINH DUONG · ĐUÖC TU VÄN BI CHUYÊN GIA DINH DUÖNG · CHUÕI · THÚC ĐON HÕ TRO GIÀM KHOI MO THÜA · BÜA TÕI"},{"time":267.4,"until":271.1,"text":"NGON · Eat Well, Live Well. · AJINOMOTO. · moingày · Aagon"},{"time":274.3,"until":286.7,"text":"monngonmoingay.com · NGON · mingày · AJINOMOTO · Món Ngon Mōi Ngày · Eat Well, Live Well. · NOMOID"},{"time":287.1,"until":299.3,"text":"250g · 30g · 10 tép · 3 trái · Công ty Ajinomoto Vit Nam · 10 cù · NGUYÊN LIÊU · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Phi hp thc hin · Công ty HKFilm · ·TÔM SÚ · ·DÁU DIÉU · KHO LÁ QUÊ · ·HÀNH TÍM · Thc hin chương trình · Bán quyěn kch bán và cău trúc · ·BÔT NGOT · ·DÁU PHONG RANG · Thc hin chươ · ·TòI · chuong trinh thuc · ·LÁ QUÉ · THÀNH PHÓ HO CHÍMINH · DÀI TRUYÊN HINH · ·ÓT HIÊM"}],"speech":[{"time":11.8,"text":"Tôm săn chắc thịt, dai ngọt đậm đà, có chút bùi từ đậu phộng và thơm mùi lá quế"},{"time":17.0,"text":"Nước kho sánh nguyện, hào cơm lắm nha"},{"time":39.9,"text":"Nấu chuẩn, ăn lành, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":45.9,"text":"Chào Kim Thảo"},{"time":46.7,"text":"Chào Phước Hưng"},{"time":47.6,"text":"Phước Hưng ơi, Kim Thảo muốn ăn tôm kho quá"},{"time":50.1,"text":"Nhưng mà bình thường ở nhà chỉ kho nước tương, nước mắm tự nhiên thấy nó hơi quen thuộc"},{"time":54.0,"text":"Có cách nào làm cho món tôm kho nó đặc biệt hơn không?"},{"time":56.5,"text":"Tôm kho đúng không? Thường thì mình hay kho là mình sử dụng tôm sú hoặc là tôm càng"},{"time":61.8,"text":"Hai loại tôm này thì kho rất là ngon và rất là phù hợp luôn"},{"time":65.1,"text":"Vậy thì ngày hôm nay Phước Hưng sẽ hướng dẫn cho Kim Thảo cũng như là các bạn"},{"time":68.1,"text":"Một cái món kho có một cái sự kết hợp rất là độc đáo"},{"time":71.3,"text":"Đó là món tôm sú kho lá quế"},{"time":73.6,"text":"Và cũng theo lời của chuyên gia dinh dưỡng thì món ăn ngày hôm nay"},{"time":76.4,"text":"Hỗ trợ giảm khói mỡ thừa trong cơ thể của chúng ta rất tốt"},{"time":79.8,"text":"Lá quế Phước Hưng sẽ cắt sợi để Hưng ướp vào tôm"},{"time":82.9,"text":"Theo Kim Thảo được biết thì lá quế rất là tốt cho sức khỏe"},{"time":85.8,"text":"Có thể cân bằng được acid và giúp cho cơ thể của chúng ta trao đổi chất tốt"},{"time":90.3,"text":"Ớt hiểm đặc dập"},{"time":91.9,"text":"Còn phần hành tím vứt Hưng cũng sẽ đặc dập luôn"},{"time":96.0,"text":"Bây giờ chúng ta sẽ ướp gia vị vào tôm cho tôm được thấm vị"},{"time":99.3,"text":"Đối với món tôm ngày hôm nay thì chúng ta sẽ bỏ đầu, lột vỏ cho sạch, chừa đuôi"},{"time":103.7,"text":"Chúng ta sẽ dọc sâu vào lưng tôm"},{"time":106.4,"text":"Khi kho thì tôm sẽ thấm vị và bung trong rất là đẹp mắt"},{"time":109.8,"text":"Hưng sẽ cho hết cái phần tôm vào"},{"time":112.6,"text":"Đầu tiên Hưng sẽ cho vào đây 2 muỗng canh nước mắm"},{"time":116.5,"text":"Một muỗng cà phê bột ngọt Ajinomoto"},{"time":118.8,"text":"Nửa muỗng cà phê tiêu"},{"time":121.1,"text":"Cho phần tỏi nè"},{"time":123.3,"text":"Hành tím đạp dập"},{"time":125.3,"text":"Cho lá quế cắt sợi vào luôn"},{"time":127.6,"text":"Và cuối cùng Hương sẽ cho ớt hiểm đạp dập"},{"time":129.9,"text":"Chúng ta sẽ ướp lá quế cắt sợi vào phần tôm trước"},{"time":132.8,"text":"Để lá quế ngắm gia vị vào tôm"},{"time":135.3,"text":"Thì khi kho món ăn có mùi thơm đặc trưng hơn"},{"time":137.9,"text":"Ngày hôm nay chúng ta có món tôm"},{"time":139.7,"text":"Thì chắc chắn là sẽ có thể cung cấp được một lượng đạm tốt cho cơ thể"},{"time":143.0,"text":"Đồng thời là chất chống oxy hóa"},{"time":145.2,"text":"Và ít calor cho nên chúng ta có thể thoải mái ăn mà không sợ tăng cân"},{"time":149.5,"text":"Chúng ta để tôm được thấm khoảng 5 phút là được rồi"},{"time":152.1,"text":"Và chúng ta bắt chảo lên chúng ta kho"},{"time":154.0,"text":"Phước Hương sẽ cho vào đây 2 muỗng canh màu dầu điều"},{"time":157.9,"text":"Cho vào đây 1 muỗng canh đường để chúng ta thắng caramel"},{"time":164.9,"text":"Phần màu caramel đã ngã cái màu nâu đẹp rồi"},{"time":168.2,"text":"Bây giờ Phước Hương sẽ cho phần tôm vào"},{"time":175.3,"text":"Và chúng ta sẽ sóc sơn"},{"time":177.0,"text":"Cho phần caramel áo điều vào tôm"},{"time":181.6,"text":"Phước Hương sẽ cho vào đây 2 muỗng canh nước lọc"},{"time":184.1,"text":"Để chúng ta kho"},{"time":185.1,"text":"Chúng ta không cần kho quá lâu"},{"time":187.2,"text":"Vì kho quá lâu thì phần thịt tôm sẽ bị khô"},{"time":189.8,"text":"Ăn không ngon"},{"time":190.5,"text":"Bây giờ thì cái màu sắc của tôm rất là đẹp luôn"},{"time":192.9,"text":"Với Hưng sẽ tắt bếp nè"},{"time":194.6,"text":"Còn các bạn khán giả thì chỉ cần lấy điện thoại ra"},{"time":197.1,"text":"Và quét mã QR trên màn hình của chúng tôi"},{"time":199.2,"text":"Là có trọn vẹn công thức của món ăn ngày hôm nay nha"},{"time":203.7,"text":"Bây giờ Hưng sẽ cho tôm vào"},{"time":208.9,"text":"Sẽ cho lên đây"},{"time":210.4,"text":"Tỏi nè, ớt nè, hành tím nè"},{"time":213.6,"text":"Một ít lá quế tươi"},{"time":215.1,"text":"Khi ăn thì chúng ta sẽ trộn đều lên"},{"time":217.4,"text":"Cuối cùng Phước Hưng sẽ cho lên đây một ít đậu phộng rang"},{"time":221.0,"text":"Một con tôm nè"},{"time":223.0,"text":"Một củ hành tím nè"},{"time":224.7,"text":"Và một ít tỏi nè"},{"time":227.0,"text":"Đang kèm với một cái lá quế"},{"time":229.2,"text":"Rồi mời Kim Thảo"},{"time":230.8,"text":"Cảm ơn Phước Hưng"},{"time":232.0,"text":"Chưa ăn mà đã thấy ngon rồi đó ạ"},{"time":239.7,"text":"Thịt tôm giữ được độ dai và rất thấm vị luôn"},{"time":244.4,"text":"Thơm nè, có chút cay nhẹ nhẹ"},{"time":246.4,"text":"Và đặc biệt khi mà ăn kết hợp với lá quế"},{"time":248.8,"text":"Đúng thật là vị tôm, sú, kho tự nhiên cảm thấy đặc biệt hơn hẳn"},{"time":253.1,"text":"Chắc chắn là các bạn khán giả cũng sẽ mê món này giống như Kim Thảo đấy ạ"},{"time":257.1,"text":"Và để đạt được hiệu quả dinh dưỡng thì chúng ta nên tham khảo món ăn này cùng với bản thực đơn sau đây"},{"time":266.3,"text":"Tôm, sú, kho lá quế, nhanh gọn, đơn giản, hao cơm cực kỳ, không thể bỏ qua"},{"time":271.6,"text":"Để xem lại công thức của món ăn ngày hôm nay cùng với gợi ý của rất nhiều món ăn hấp dẫn nữa cho bữa cơm gia đình"},{"time":277.5,"text":"Các bạn chỉ cần truy cập vào Youtube, website, fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":282.4,"text":"Và website của chúng tôi đã có giao diện mới, dễ sử dụng và nhiều tiện ích"}]}