,"until":315.6,"text":"monngonmoingay.com · AJINOMOTO · Món Ngon Mōi Ngày · maingay · Agingon · Apengon"},{"time":316.8,"until":329.4,"text":"250g · 150g · 20 trái · 1/2m · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo · Công ty Golden Scale · 2 quà · NGUYÊN LIÊU · Công ty HKFilm · Bn quyn kch bn và cu trúc · ·TRÚNG GÀ · ·TÔM SÚ · · HAT NÊM HEO, BÔT NGOT · · XÖT MAYONNAISE VI NGUYÊN BÀN · ·BÔT Mì · Thc hin chương trình · Phi hp thc hin · ·CHÔM CHÔM · ·HÚNG LÙI · chuơng trình thuc · ·CONG NGÒ BĂM · ·BÔT XÙ · ·ÖT SÜNG BÄM · THÀNH PHÓ HO CHÍMINH · Thc hin chươ · DÀI TRUYÊN HìNH · Onl"}],"speech":[{"time":33.5,"text":"Mình chào quý vị khán giả đang theo dõi chương trình Món ngon mỗi ngày"},{"time":36.4,"text":"Nấu chuẩn, ăn lành"},{"time":38.1,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":41.1,"text":"Minh nè, Thanh Phương thấy là anh đang chuẩn bị bột, lát nữa chắc sẽ là một món chiên nào đó hả anh?"},{"time":47.0,"text":"Nhưng mà tại sao có chôm chôm hay là chôm chôm để ăn tráng miệng ạ?"},{"time":50.1,"text":"Một món từ trái cây để tráng miệng cho thành một món chính luôn"},{"time":53.5,"text":"Món gì vậy anh?"},{"time":54.5,"text":"À cái món này là món chôm chôm nhồi tôm chiên nha"},{"time":57.8,"text":"Thì mình sẽ hướng dẫn Thanh Phương cũng như các bạn thân giả"},{"time":60.6,"text":"Tắt lấy cái hộp của chôm chôm ha"},{"time":63.9,"text":"Mình đừng có cắt vô sâu quá cái phần thịt của chôm chôm á"},{"time":67.0,"text":"Sau đó thì mình để như vầy"},{"time":68.7,"text":"Cắt tiếp"},{"time":69.8,"text":"Vô cái phần hộp luôn"},{"time":71.6,"text":"Mình sẽ luôn cái đầu tay của mình vô"},{"time":76.1,"text":"Sẽ tắt rời một bên như thế này"},{"time":77.8,"text":"Tiếp theo bên này mình cũng vậy"},{"time":80.2,"text":"Chúng ta nên khéo léo tắt hạt chôm chôm"},{"time":82.2,"text":"Giúp chôm chôm không bị nát và dễ định hình nhân hơn"},{"time":84.6,"text":"Trong trái chôm chôm thì có chứa vitamin C"},{"time":87.0,"text":"Và một số các loại vitamin và khoáng chất khác"},{"time":89.3,"text":"Vitamin C thì giúp văn cường hệ miễn dịch, giúp phát triển hệ thần kinh tốt hơn và giúp cho xương khớp được chắc khỏe nữa"},{"time":96.6,"text":"Chúng ta sẽ lấy cái hộp này ra"},{"time":99.2,"text":"Thanh Phương thử tách thử coi thế nào ha"},{"time":104.6,"text":"Mình lấy ra luôn"},{"time":106.8,"text":"Đây trái cuối chắc thịt rất là ngon"},{"time":109.4,"text":"Đúng rồi, cảm ơn Thanh Phương ha"},{"time":111.7,"text":"Và bây giờ mình sẽ tới cái bước là đi trộn cái phần nhân để nhòi vào bên trong"},{"time":116.0,"text":"Cho vào đây 150g tôm xú băm nhỏ nha"},{"time":119.7,"text":"Nửa muỗng canh ớt sườn băm, nửa muỗng cà phê cộng ngò băm, một muỗng cà phê húng lũi băm nhỏ vào trong đây, nửa muỗng cà phê hạt niêm Ajinomoto, nửa muỗng cà phê bột ngọt Ajinomoto, một phần tư muỗng cà phê tiêu."},{"time":135.4,"text":"Sau đó chúng ta sẽ trộn đều cái phần nhân này."},{"time":137.9,"text":"Em sẽ phụ anh Minh đập cái phần nhân gà này ra nha."},{"time":139.9,"text":"Ừ đúng rồi."},{"time":144.7,"text":"Cái phần nhân của chúng ta đã trộn xong rồi nè."},{"time":147.3,"text":"Đó nó thấy độ dai chưa?"},{"time":149.3,"text":"Mình sẽ cho cái phần nhân tôm này vào trong cái túi bắp bông kem nha."},{"time":155.7,"text":"Bây giờ chúng ta sẽ nhòi cái phần tôm này vào trong chôm chôm nha"},{"time":160.4,"text":"Tém cho nó đều lại"},{"time":163.6,"text":"Trong khi anh Minh đang làm cái phần nhân tôm em sẽ chuẩn bị cái chảo dầu nóng"},{"time":166.8,"text":"Ok, cảm ơn Thanh Phương nha"},{"time":169.4,"text":"Tôm thì có chứa nhiều canxi"},{"time":171.5,"text":"Canxi thì như quý vị biết là sẽ giúp cho hệ xương của chúng ta được chắc khỏe hơn nè"},{"time":176.0,"text":"Còn giúp cho tóc cũng bóng mượt và chắc khỏe nữa các bạn ạ"},{"time":179.1,"text":"Chúng ta sẽ bắt đầu tới công đoạn tẩm bột"},{"time":181.7,"text":"Đầu tiên mình sẽ lăn qua cái bột mì trước"},{"time":184.5,"text":"Sau đó mình phải nhúng vào trứng như thế này"},{"time":187.8,"text":"Mình sẽ lăn tiếp qua bột xù"},{"time":191.2,"text":"Chúng ta nên kết hợp bột mì cùng với bột xù để tăng độ khích chín và cho món ăn thêm giòn hơn nha"},{"time":196.2,"text":"Và mình làm lần lượt lần lượt như vậy cho nó hết luôn nha Thanh Phương ha"},{"time":199.7,"text":"Và bây giờ dầu của chúng ta đã nóng rồi"},{"time":201.9,"text":"Chúng ta sẽ chiên cái phần lá húng lũi"},{"time":203.9,"text":"Mình sẽ chiên giòn nó lên để vừa trang chiến và vừa ăn kèm luôn ha"},{"time":207.5,"text":"Khi mà chúng ta chiên cái phần lá húng lũi này thì tinh dầu của lá húng lũi tiết ra cũng sẽ làm cho phần dầu được thơm hơn"},{"time":212.8,"text":"Sẽ giòn và giữ được màu xanh"},{"time":219.9,"text":"Mình sẽ cho lần lượt cái chôm chô"},{"time":222.2,"text":"Chôm chôm thì rất là mọng nước, tuy nhiên khi chúng ta áo qua một lớp bột như vậy, phần nước chôm chôm cũng sẽ không bị tiết ra làm văn dầu đấy ạ."},{"time":230.3,"text":"Với món này mình sẽ chiên với lửa vừa thôi ha, để cho phần nhân ở bên trong nó được chín đều hơn."},{"time":235.4,"text":"Trái chôm chôm chúng ta đã vàng như thế này, mình sẽ vớt ra nha."},{"time":240.1,"text":"Trông vàng giòn, rất đẹp mắt và lại rất là thơm luôn các bạn ơi."},{"time":244.1,"text":"Mình sẽ cho ra giấy thấm dầu nha."},{"time":247.3,"text":"Chúng ta nên chấm cùng với sốt mayonaise"},{"time":249.5,"text":"Aji mayo nguyên bản"},{"time":251.0,"text":"Giúp món ăn thêm hấp dẫn hơn"},{"time":253.2,"text":"Rất là thơm các bạn ơi"},{"time":254.5,"text":"Và để thực hiện món ăn ngày hôm nay"},{"time":256.1,"text":"Các bạn đừng quên quét mã QR nha"},{"time":260.1,"text":"Bây giờ mình sẽ trình bày ở đĩa"},{"time":266.8,"text":"Sốt mayonaise"},{"time":267.6,"text":"Aji mayo nguyên bản"},{"time":268.9,"text":"Có vị chua nhẹ của giấm"},{"time":270.3,"text":"Vị béo thơm ngon của trứng gà"},{"time":272.7,"text":"Nên kết hợp với những món chiên"},{"time":274.3,"text":"Vô cùng hài hòa và tròn đầy hương vị"},{"time":276.5,"text":"Đó, thế là món ăn chúng ta đã hoàn thành rồi đó Thanh Phương"},{"time":279.1,"text":"Dạ, món này thì mình sẽ kết hợp với những món nào để hấp dẫn hả?"},{"time":282.5,"text":"Với một món chiên thì các bạn nên kết hợp với một món salad"},{"time":285.3,"text":"Đó là salad bò rau má nha"},{"time":287.4,"text":"Lớp vỏ vàng giòn, ôm trọn cùi chôm chôm mềm ngọt, mọng nước"},{"time":291.8,"text":"Và nhân tôm bằng mặn dai dai, thơm nhẹ mùi tiêu và ớt sừng"},{"time":295.8,"text":"Hòa cùng chút bèo béo của mayonnaise, vị lạ miệng, ngon bất ngờ"},{"time":301.5,"text":"Chôm chôm nhồi tôm chiên rất lạ và cũng rất quen"},{"time":304.5,"text":"Các bạn nhớ thực hiện cho gia đình mình thưởng thức nha"},{"time":306.8,"text":"Và để xem lại công thức của món ăn ngày hôm nay"},{"time":308.9,"text":"Đừng quên truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":313.1,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại"}]}