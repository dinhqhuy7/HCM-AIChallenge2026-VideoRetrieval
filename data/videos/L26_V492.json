:203.3,"text":"BanhRan · AJINOMOTO · MON · moingày"},{"time":208.0,"until":209.9,"text":"AJINOMOTO · BanhRan · MON · moingày · Aogan"},{"time":212.2,"until":214.0,"text":"mingày · MON"},{"time":214.2,"until":220.4,"text":"AJINOMOTO · Eat Well, Live Well. · moingày"},{"time":233.7,"until":234.8,"text":"AJINOMOTO · Eat Well, Live Well. · moingày"},{"time":266.0,"until":267.6,"text":"AJINOMOTO · Eat Well, Live Well. · moingày"},{"time":267.8,"until":271.8,"text":"IGON · moingày · Eat Well, LIve Well. · mōingày"},{"time":277.3,"until":279.6,"text":"ngay · mōingày · Eat Well, Uve Well. · gày"},{"time":290.7,"until":295.8,"text":"AJINOMOTO · moingay · Eat Well, Live Well. · HOV · moingáy"},{"time":296.6,"until":308.5,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Golden Scale · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Mt ong: 50g · Bn quyn kch bn và cu trúc · Kem tuoi: 70g · Khoai lang tim: 200g · Công ty HKFilm · Phi hp thc hin · Bolat: 30g · Thc hin chương trình · Bt bánh rán pha sǎn vi truyèn thóng: 1 gói · Hat dè cuòi: 30g · chuơng trình thuc · Công ty A · Thc hié · DÀI TRUYÊN HìNH TP. HCM"}],"speech":[{"time":11.8,"text":"Hôm nay có một món quà tặng cho người đẹp trai"},{"time":13.8,"text":"Cảm ơn anh"},{"time":14.6,"text":"Ủa nhưng mà anh thích ăn khoai lang đúng không?"},{"time":16.1,"text":"Để Phương Hương đem đi luộc cho"},{"time":16.9,"text":"Ờ, gì vậy?"},{"time":18.2,"text":"Ủa tự nhiên cái đầu bếp thiên tài"},{"time":19.7,"text":"Cái đem luộc khoai"},{"time":20.5,"text":"Khoai lang đem đi luộc thì hơi thường đúng không?"},{"time":22.6,"text":"Ừ"},{"time":22.8,"text":"Rồi Phương Hương suy nghĩ coi"},{"time":23.8,"text":"Hay là bây giờ chúng ta sẽ làm món banh kết đi"},{"time":26.9,"text":"Mà có phối hợp cùng khoai lang"},{"time":28.9,"text":"Sẽ cho ra một món bánh rất là thịnh soạn"},{"time":30.8,"text":"Cùng khoai lang đúng không?"},{"time":32.0,"text":"Ok"},{"time":35.8,"text":"Pancake khoai lang mật ong"},{"time":37.3,"text":"Ngọt ngào cho bữa sáng"},{"time":57.5,"text":"Để tự trợ với công ty Ajinomoto Việt Nam"},{"time":61.5,"text":"Phần khoai lang tím này khi mà chúng ta mua về"},{"time":63.6,"text":"Thì chúng ta bỏ vỏ đi rửa sạch về để ráo"},{"time":65.9,"text":"Và chúng ta sẽ hấp chín"},{"time":67.7,"text":"Chúng ta sẽ tán mịn trong khi khoai còn nóng"},{"time":70.1,"text":"Thì khoai sẽ dễ mịn hơn"},{"time":71.3,"text":"Bây giờ Phước Hương sẽ cho khoai lang vào"},{"time":74.1,"text":"Bây giờ chúng ta sẽ tán thật là mịn nè"},{"time":76.3,"text":"Trong khi chúng ta đang tán cái phần khoai mịn"},{"time":78.6,"text":"Thì tiếp theo chúng ta pha cái hỗn hợp bột"},{"time":80.8,"text":"Bây giờ Phước Hương sẽ sử dụng một gói bột bánh rán pha sẵn vị truyền thống"},{"time":84.4,"text":"Cho phần nước theo tỷ lệ trên bao bì là 140ml nước"},{"time":88.1,"text":"Khuấy cho thật là mịn cái hỗn hợp bột này"},{"time":91.8,"text":"Phước Hương sẽ để bột sang một bên"},{"time":94.4,"text":"Rồi bây giờ phần khoai tím cũng đã rất là mịn luôn"},{"time":96.8,"text":"Đặt lên trên bếp một cái chảo để chúng ta xào nhân"},{"time":99.2,"text":"Đầu tiên Phước Hương sẽ cho vào đây là 200g khoai lang"},{"time":104.0,"text":"Tiếp theo đó Phước Hương sẽ cho 30g bơ lạc, 50g mật ong"},{"time":108.1,"text":"Và 70g kem béo"},{"time":109.7,"text":"Chúng ta sẽ nấu đến khi nào cái hỗn hợp nhân này sẽ lại"},{"time":112.8,"text":"lại và nó có cái độ dẻo"},{"time":114.6,"text":"nhất định. Công nhận khoai lang tím"},{"time":116.6,"text":"lúc nào cũng cho ra những cái món ăn mà có màu sắc"},{"time":118.7,"text":"rất là hài hòa. Đúng rồi"},{"time":120.1,"text":"Và đặc biệt khoai lang tím có rất là nhiều chất sơ"},{"time":122.7,"text":"tốt cho sức khỏe của chúng ta và"},{"time":124.3,"text":"cũng làm cho chúng ta điều chỉnh được cân nặng"},{"time":126.5,"text":"cơ thể nữa. Bây giờ thì cái phần nhân của mình"},{"time":128.6,"text":"đã đến một cái độ dẻo nhất định rồi"},{"time":130.5,"text":"Phúc Hưng sẽ cho ra một cái tô"},{"time":132.6,"text":"để chúng ta để nguội. Sau khi mà"},{"time":135.6,"text":"cái phần nhân này của mình thật là nguội rồi"},{"time":137.2,"text":"thì chúng ta sẽ pha cái hạt dẻ cười này vào"},{"time":139.4,"text":"và các bạn nên lưu ý"},{"time":141.0,"text":"Trước khi sử dụng hạt giả cười này chúng ta sẽ rang sơ đi"},{"time":143.6,"text":"Thì sẽ giúp cho món ăn thơm ngon hơn"},{"time":145.4,"text":"Bây giờ Phước Hưng sẽ bắt một cái chảo lên trên bếp để chúng ta gắn bánh"},{"time":149.1,"text":"Đầu tiên chúng ta sẽ tăng nhiệt độ của lửa lên để làm cho cái phần chảo này thật là nóng"},{"time":153.2,"text":"Bây giờ thì phần chảo cũng đã nóng rồi"},{"time":154.9,"text":"Phước Hưng sẽ giảm lửa nhỏ nè"},{"time":156.5,"text":"Và chúng ta sẽ cho vào cái khăn ẩm ướt để giảm nhiệt độ của chảo"},{"time":160.0,"text":"Thì khi đổ bánh thì cái màu sắc của bánh sẽ đẹp hơn"},{"time":162.2,"text":"Bây giờ thì phần chảo cũng đã giảm nhiệt độ rồi"},{"time":164.5,"text":"Phước Hưng sẽ đặt lên trên bếp lại và chúng ta cho bột vào"},{"time":182.2,"text":"Quá đẹp"},{"time":186.8,"text":"Bây giờ Phương Hương sẽ lấy bánh ra"},{"time":207.9,"text":"Rồi bây giờ chúng ta sẽ lấy bánh ra nè"},{"time":211.2,"text":"Rồi"},{"time":213.9,"text":"Bây giờ thì Phương Hương cũng đã chuẩn bị sẵn"},{"time":215.6,"text":"Một cái dĩa để chúng ta trình bài ra món bánh ngày hôm nay"},{"time":218.3,"text":"Đầu tiên thì Hương sẽ cho"},{"time":220.0,"text":"Một miếng bánh xuống bên dưới trước nè"},{"time":222.0,"text":"Rồi và bây giờ chúng ta sẽ"},{"time":223.9,"text":"Bắt cái hỗn hợp nhân lên"},{"time":228.2,"text":"Và bây giờ chúng ta sẽ cho lớp bánh thứ 2"},{"time":230.6,"text":"Rồi chúng ta sẽ ấm nhẹ xuống"},{"time":233.3,"text":"Và tiếp tục chúng ta sẽ cho nhân lên"},{"time":238.5,"text":"Rồi bây giờ chúng ta sẽ cho lớp cuối cùng"},{"time":240.4,"text":"Ở ấm xuống"},{"time":242.1,"text":"Cho nó thấy cái phần dưng ra"},{"time":249.9,"text":"Thì tôi cũng đẩy cho nó"},{"time":251.3,"text":"Và bây giờ cuối cùng Phúc Hưng sẽ cho hạt giả cười giả bể lên"},{"time":261.3,"text":"Rồi xong"},{"time":262.0,"text":"Vậy là ngày hôm nay chúng ta đã kết hợp được khoai lang tím"},{"time":264.9,"text":"Với lại món bánh cách cho ra một cái món bánh thịnh sọn đúng không?"},{"time":268.5,"text":"Nhìn thì ban đầu mình nghĩ nó không có hấp dẫn như vậy đâu"},{"time":271.6,"text":"Nhưng mà khi đã thành phẩm thì đúng là những màu sắc của bánh này"},{"time":274.9,"text":"Của khoai lang tím hạt giả cười kết hợp với nhau"},{"time":276.9,"text":"Công nhận món này mới lạ thiệt"},{"time":279.2,"text":"Vị ngọt bùi của khoai lang"},{"time":281.1,"text":"Quyện thêm chút béo béo của kem tươi"},{"time":283.5,"text":"Và ngọt ngào của mật ong"},{"time":284.9,"text":"Thật thú vị"},{"time":285.9,"text":"Cắn với miếng pancake sốt mềm"},{"time":288.3,"text":"Là sự cân bằng hài hòa khỏi bàn"},{"time":290.4,"text":"Không quá cầu kỳ để thực hiện bữa sáng"},{"time":292.6,"text":"Cho gia đình cùng với món pancake khoai lang mật ong"},{"time":294.8,"text":"Phải không các bạn?"}]}