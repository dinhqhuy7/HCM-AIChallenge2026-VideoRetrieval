until":190.4,"text":"tuoitre"},{"time":190.6,"until":192.6,"text":"Herbalife · Tác gi: Hồng Thm · OTIS CIB"},{"time":193.0,"until":194.8,"text":"Herbalife · Tác gi: Hồng Thm · tuoitre"},{"time":195.0,"until":198.4,"text":"Herbalife · Tác gi: Hồng Thm"}],"speech":[{"time":12.8,"text":"Với phương châm ai cần thì đến lấy, ai dư thì đến cho,"},{"time":17.0,"text":"gian hàng mở cửa 3 ngày hằng tuần, thứ 2, thứ 5, thứ 7,"},{"time":20.7,"text":"trong khung giờ sáng từ 9h đến 11h30."},{"time":25.0,"text":"Tấm bản phía trước thu hút sự chú ý của người đi đường với nội dung"},{"time":28.3,"text":"gian hàng không đồng sang sẻ yêu thương, hãy lấy vừa đủ dùng,"},{"time":32.1,"text":"nếu bạn ổn xin nhường cho người khác."},{"time":37.0,"text":"Nói chung là chị thích làm từ thiện, chị thích làm cái mô hình này"},{"time":51.5,"text":"Bữa sáng, trang hàng quần áo không đồng của bà Uyên mở cửa, nhuộm dịp người đến gửi tặng đồ cũ cũng như nhận đồ, lựa chọn những bộ quần áo vừa vặn, ưng ý, bên trong rộng rãi, sạch sẽ, với những kệ quần áo được sắp xếp ngay ngắn."},{"time":74.6,"text":"Rồi khi mà chưng lên tiệm để mà thấy nó vẫn chưa đầy thì bỏ sức tiền mua"},{"time":79.8,"text":"Nhưng mà sau này khi mà được lan tỏa rộng rãi rồi mọi người biết đến nhiều"},{"time":85.0,"text":"Mọi nhiều người mang đến cho rồi thì giờ tụi chị không cần phải đi mua nữa"},{"time":89.2,"text":"Là có đồ của mọi người mang đến ủng hộ"},{"time":93.1,"text":"Những người đến dọn quần áo đa phần là người lao động bình dân"},{"time":96.4,"text":"Như người bán vé số, nhặt vé chai, xe ôm"},{"time":99.7,"text":"Nhiều người dân sống ở gần đây cũng đến tặng quần áo"},{"time":102.5,"text":"Sẵn cũng lựa cho mình vài cái áo, cái quần, dây dép phù hợp"},{"time":108.0,"text":"Vui cũng có, buồn cũng có"},{"time":109.8,"text":"Vui là có những người mà họ vô, họ nhận những cái món đồ mà họ rất là cảm thấy họ vui mừng, họ thích thú"},{"time":116.2,"text":"Thì mình cảm thấy mình cũng vui lây, mình hạnh phúc lây với họ"},{"time":119.2,"text":"Mà có những người, mình làm những cái này mình giúp cho người ta"},{"time":122.6,"text":"Mà có những người tham lam, họ vô họ lấy, họ mang đi họ bán"},{"time":126.2,"text":"Hay là họ sử dụng vào cái mục đích gì thì mình không biết"},{"time":129.1,"text":"Khi mình nhắc nhở họ thì họ bị quê, họ quay qua họ chửi tôi chị"},{"time":133.4,"text":"Đó là những cái bức xúc, những cái mình làm là mình mang đến những cái tốt đẹp cho mọi người"},{"time":142.9,"text":"Nhưng mà mình lại bị những cái mọi người, có những người họ lại quay qua họ, họ chửi mắng mình"},{"time":150.2,"text":"Chị cũng nghe nói là ở đây có quần áo phát cho người nghèo"},{"time":159.9,"text":"Ở đây phục vụ cũng tốt lắm, mấy cô cũng dễ thương lắm."},{"time":163.3,"text":"Nếu mà ở thành phố mình mà được như vậy thì rất tốt."},{"time":167.0,"text":"Cho những người người ta gặp khó, người ta đến đây cũng có đồ để người ta mặc."},{"time":178.5,"text":"Ví dụ ai có thì mang tới, còn những người nào mà không có thì người ta lại người ta nhận."},{"time":186.8,"text":"Giang hàng không đồng của bà Uyên là hoạt động thiện nguyện mang ý nghĩa thiết thực,"},{"time":190.8,"text":"kịp thời động viên, chia sẻ, lan tỏa tình yêu thương trong cộng đồng, giúp đỡ người có hoàn cảnh khó khăn."}]}