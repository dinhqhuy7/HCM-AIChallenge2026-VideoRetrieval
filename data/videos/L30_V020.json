]]]],"onScreen":[{"time":0.1,"until":1.7,"text":"tv.tuoitre.vn"},{"time":4.1,"until":6.3,"text":"Herbalife · trên th gii · thương hiu · cân nng · quán ly · & súc khóe"},{"time":7.1,"until":7.1,"text":"Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.7,"until":14.2,"text":"REKE · Cuc thi Lan ta năng lung tích cc 2024: · 50000 · Tm lòng hung v nhng bnh nhn nghèo · 5000 · thung hu · WEILK · WEHRLK"},{"time":14.4,"until":24.4,"text":"tuoitre · Cuc thi Lan ta năng lung tích cc 2024: · Tm lòng hung v nhng bnh nhn nghèo · thuong hitu · cann"},{"time":24.6,"until":32.0,"text":"REKE · PHI · 50000 · tuoitre"},{"time":43.0,"until":46.4,"text":"576648 · CHUNGHIA · SOOO · cc5000 · acc5000"},{"time":46.6,"until":58.7,"text":"0000 · 17516755"},{"time":58.9,"until":62.1,"text":"tuöitreV"},{"time":62.7,"until":65.2,"text":"tuoitrerv"},{"time":69.8,"until":72.8,"text":"tuöitre · tuöitreV"},{"time":73.3,"until":78.9,"text":"tuoitre"},{"time":100.8,"until":106.0,"text":"tuoitre · 5000"},{"time":112.4,"until":115.7,"text":"TRUNG · Bi DU"},{"time":116.0,"until":124.1,"text":"CHAT THAI NHUA · a dinh · NOT SAC PIN · tuoitrey · SIEUAM- · trinh · in tién · CHAT THAI Nituoitre. · qua trinh · DIÈN THOAI · ngudi · tuoithery · máu · hám sic · BAO VE MOTTROUNG · stuoitrev · BÃO VÉ MÔI T · du; · Bubitrery · MENTHOAI · tusitlery · mhān tién · BAO VÉ MÖI TRUONG · tusltrerv · à chám só · di nguài · sa gia dinh"},{"time":124.4,"until":128.1,"text":"KHOA · tuoitre · HANH · YANH CHINH · KHÓNG HUT THUOC · TRONG BÉNHVIEN · 100.000-3000.00d · 101.001-300.000"},{"time":128.7,"until":132.6,"text":"KLAAF · AAF"},{"time":133.2,"until":134.6,"text":"Tác gi: Phúc Ân"},{"time":134.9,"until":140.9,"text":"Tác gi: Phúc Ân · thuang hitu"}],"speech":[{"time":12.3,"text":"55.000 đồng cho bữa ăn được Trung tâm Y tế huyện Bình Sơn, tỉnh Quảng Ngãi trao tận tay mỗi ngày cho những bệnh nhân nghèo đang điều trị nội trú."},{"time":20.4,"text":"Khoản tiền hỗ trợ này chủ yếu từ sự đóng góp của cán bộ, nhân viên, y bác sĩ và từ nguồn quỹ hỗ trợ cho bệnh nhân nghèo do đơn vị tiết kiệm."},{"time":29.8,"text":"Nhận số tiền này, ai cũng cảm động vì nghĩa cử cao đẹp của những lương y."},{"time":58.9,"text":"Bữa cơm trưa của bà Hộ tại trung tâm y tế huyện Bình Sơn,"},{"time":63.4,"text":"Nhà nghèo lại đau ốm triền miên, nên khi vào điều trị nội trú, được hỗ trợ tiền ăn ngày 3 bữa, bà cảm thấy ấm lòng."},{"time":72.7,"text":"Rất là mừng vô cùng, không biết nó lấy làm nào, trái xứng đó."},{"time":79.1,"text":"Thật tình, nó cũng cảm ơn hết tất cả, nhưng mà không biết nó sao, mình thấy cũng không thể."},{"time":86.9,"text":"Rất là nhiều người nghèo, kể đến điều trị là vấn đề ăn uống của bệnh nhân rất là thiếu."},{"time":91.9,"text":"Thậm chí là có những bệnh nhân không có tiền an nên là xuất viện sớm."},{"time":96.1,"text":"Do đó là lãnh đạo Trung tâm Y tế Bình Sơn cũng bàn bọc và đưa ra chính sách hỗ trợ cho những bệnh nhân điều trị nội tố."},{"time":104.3,"text":"Và nó là bệnh nhân, đặc biệt là người nghèo thì người ta rất là vui mừng."},{"time":108.5,"text":"Cái này đúng với tinh thần là không để là người nghèo phía sau."},{"time":112.9,"text":"Trung tâm Y tế huyện Bình Sơn dự kiến mỗi năm sẽ tiết kiệm cơ gọi đóng góp của cán bộ, nhân viên, y bác sĩ"},{"time":119.2,"text":"và từ các nguồn tiền hợp pháp khác để hỗ trợ tiền ăn cho người nghèo,"},{"time":123.6,"text":"gia đình có hoàn cảnh khó khăn, cụ già không nơi nương tựa khoảng 300 triệu đồng."},{"time":128.2,"text":"Mô hình ngoài thể hiện sự quan tâm, chia sẻ khó khăn với bệnh nhân nghèo"},{"time":132.1,"text":"thì còn mang ý nghĩa lớn khi kịp thời động viên những bệnh nhân nghèo vượt qua khó khăn bệnh tật."}]}