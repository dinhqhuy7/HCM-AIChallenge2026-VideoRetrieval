peech":[{"time":20.2,"text":"Ủa rồi sao em tính một mình em ăn hết cái mẻ bánh mì luôn hả?"},{"time":22.9,"text":"Không"},{"time":23.7,"text":"Sao lại dập tắt cái cô nương ca hát của em?"},{"time":25.9,"text":"Thì anh thấy em cầm bánh mì"},{"time":27.4,"text":"Ôi chết"},{"time":27.9,"text":"Có khi nào"},{"time":29.1,"text":"Em có số bản nguồn hướng"},{"time":31.3,"text":"Cầm lên thử"},{"time":32.9,"text":"Bánh mì nóng nóng"},{"time":35.2,"text":"Giòn giòn"},{"time":35.8,"text":"Anh thấy hợp đó nhưng mà em rao hơi sai rồi"},{"time":37.4,"text":"Sao vậy?"},{"time":37.7,"text":"Anh nghĩ không bây giờ ai rao như đó đó"},{"time":39.5,"text":"Bây giờ bánh mì phải kẹp kẹp bánh ngắn ăn mới ngon"},{"time":42.0,"text":"Kẹp kẹp"},{"time":42.8,"text":"Có nghĩa là phải có nhân đúng không?"},{"time":44.3,"text":"Đúng rồi"},{"time":44.7,"text":"Nhưng mà nhân gì bây giờ?"},{"time":45.7,"text":"Ủa mình đứng ở bếp thì mình làm luôn chứ hỏi gì nữa"},{"time":47.9,"text":"À quên, được đó"},{"time":51.2,"text":"Bánh mì kẹp cá chiên xù"},{"time":52.8,"text":"Giòn ngậy, nóng thơm"},{"time":70.8,"text":"Mình chào quý vị khán giả đã quay trở lại với chương trình"},{"time":72.8,"text":"Món ngon mỗi ngày"},{"time":73.7,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":78.1,"text":"Rồi, đầu tiên mình làm gì nào"},{"time":79.5,"text":"Ở đây Long có 2 miếng pasta"},{"time":81.1,"text":"Filet bỏ hết xương rồi"},{"time":82.3,"text":"Với cái miếng này thì Long sẽ cắt làm đôi"},{"time":84.6,"text":"Sao Hoàng Long lại cắt ngang như vậy, mình phải cắt dọc chứ đúng không ta"},{"time":87.6,"text":"Đây đây, bây giờ mình cắt dọc đấy"},{"time":88.9,"text":"Cắt cá theo thế dọc giúp khi chiên cá được thẳng hơn và không bị nát cá"},{"time":92.4,"text":"Bây giờ cái phần cá mà Long đã cắt ra"},{"time":94.7,"text":"Long sẽ ớt vào đây là một ít tiêu, một ít ớt bột vẫy"},{"time":97.8,"text":"Tại sao lại có tên gọi này hả Hoài Long?"},{"time":99.7,"text":"Ớt này là ớt khô mà nó hơi không có mịn lắm và nó cũng không có lớn lắm"},{"time":103.7,"text":"Ướt cá với ớt bột vẫy giúp khử mùi tanh của cá"},{"time":106.1,"text":"Và chúng ta cần một chút xíu hạt nêm Azi ngon gà"},{"time":109.4,"text":"Long cho vào đây một ít vỏ chanh bào và nước cút chanh"},{"time":113.2,"text":"Vừa rồi thì Long có cho cái phần vỏ chanh bào vào khi ớt cá"},{"time":116.0,"text":"Thì công đoạn này giúp cho cái phần cá chúng ta thơm hơn và hấp dẫn hơn"},{"time":119.0,"text":"Mình sẽ trộn đều lên cho thấm gia vị"},{"time":120.6,"text":"Rồi, bây giờ thì chúng ta sẽ để cho cá thấm gia vị trong bao lâu?"},{"time":123.8,"text":"Chúng ta sẽ để khoảng tầm 10 phút"},{"time":125.2,"text":"Rồi, mình đã có chỗ dầu đây"},{"time":126.6,"text":"Dầu cũng đã sắp nóng rồi"},{"time":127.9,"text":"Bây giờ mình sẽ chuẩn bị mình nhúng cái phần cá qua bột mì, qua trứng, qua bột xù"},{"time":132.2,"text":"Xong rồi mình đem chiên"},{"time":132.9,"text":"Nhúng qua trứng, qua bột xù"},{"time":136.3,"text":"Đây"},{"time":137.9,"text":"Đây, rồi, một viên"},{"time":140.3,"text":"Wow"},{"time":142.8,"text":"Làm lần lượt"},{"time":152.1,"text":"Mình chở đều tay để nó vàng đều nha Phương"},{"time":154.2,"text":"Rồi, những thanh cá đã bắt đầu chuyển sang một cái màu vàng rồi, rất là hấp dẫn"},{"time":160.0,"text":"Nếu như ngoài phần cá basa, philet này thì mình có thể sử dụng cá philet nào khác?"},{"time":165.3,"text":"Mình có thể sử dụng được cá điêu hồng nè, cá lóc"},{"time":168.2,"text":"À đúng rồi, cá hồi nữa đúng không?"},{"time":169.9,"text":"Cá hồi thì các bé cũng rất là thích"},{"time":173.3,"text":"Wow, hấp dẫn quá"},{"time":175.1,"text":"Những thanh cá chiên vừa giòn vừa nóng hổ như thế này, không kìm lòng được"},{"time":179.4,"text":"Chip basa"},{"time":180.6,"text":"Đúng rồi, chip basa"},{"time":181.8,"text":"Bây giờ mình quay lại công việc chính của mình là bán bánh mì"},{"time":184.7,"text":"Rồi đầu tiên"},{"time":185.7,"text":"Đó đầu tiên là mình cắt bên đây"},{"time":187.0,"text":"Mình quay ra mình cắt bên đây"},{"time":188.7,"text":"Wow"},{"time":189.2,"text":"Thấy chuyên nghiệp chưa?"},{"time":190.1,"text":"Và đầu tiên chúng ta hãy cho vào đây là"},{"time":191.9,"text":"Sốt mayonnaise hay chimayo ngọt dịu"},{"time":194.0,"text":"Phết đây"},{"time":195.9,"text":"Dưa leo nha"},{"time":197.2,"text":"Rồi"},{"time":197.6,"text":"Chuyên nghiệp chưa?"},{"time":199.4,"text":"Salad nè"},{"time":200.1,"text":"Đó mình cho vào"},{"time":201.1,"text":"Ít cà chua nè"},{"time":203.1,"text":"Chua chua ngọt ngọt nữa nè đúng không?"},{"time":204.7,"text":"Chua chua ngọt ngọt nè"},{"time":206.1,"text":"Rồi hành tây nè"},{"time":208.8,"text":"Và nhân vật chính của chương trình ngày hôm nay đó chính là"},{"time":212.0,"text":"Những cái thanh cá"},{"time":213.9,"text":"Chip pasta"},{"time":215.3,"text":"Chiên rất là giòn và thơm như thế này"},{"time":218.9,"text":"Thêm một ít mayona"},{"time":220.3,"text":"Ở trên những cái thanh cá chiên nữa đi"},{"time":222.8,"text":"Rồi"},{"time":224.2,"text":"Xong một ổ"},{"time":225.9,"text":"Sốt mayona"},{"time":228.1,"text":"Dưa leo"},{"time":231.1,"text":"Cà chua"},{"time":232.2,"text":"Cá"},{"time":233.8,"text":"Rồi mình bắt mayona lên nha"},{"time":237.1,"text":"Như vậy là xe bánh mì Minh Phương"},{"time":239.7,"text":"Đã khai trương rồi các bạn ơi"},{"time":241.8,"text":"Cảm ơn Hoàng Long về công thức ngày hôm nay và hy vọng quý vị khán giả sẽ cảm thấy thích thú và làm thử món bánh mì này tại gia đình của mình nha"},{"time":248.5,"text":"Chúng ta có thể dùng món ăn này kèm với trà sữa gạo rang thạch matcha"},{"time":252.1,"text":"Bánh mì giòn giòn, cà ba xa béo ngọt thơm thơm, quyện cùng vị sốt mayonnaise azemayo ngọt dịu và cà rốt củ cải chua chua"},{"time":260.9,"text":"Thật đậm đà và cuốn hút"},{"time":262.8,"text":"Với công thức bánh mì này thì rất phù hợp cho bữa sáng có đúng không ạ?"},{"time":266.5,"text":"Thế thì chân chơi gì nữa? Vào bếp làm ngay cho bữa sáng ngày mai các bạn ơi"},{"time":270.1,"text":"Để xem lại rất nhiều công thức của món ngon mỗi ngày"},{"time":272.6,"text":"Các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":276.8,"text":"Còn bây giờ thì xin chào tạm biệt và hẹn gặp lại"}]}