"CHIENGION · JINOMOTO · MON · móingày"},{"time":233.4,"until":237.2,"text":"mline · Onilne"},{"time":245.2,"until":248.4,"text":"moingay · Angay · ARNOMOTO. · ATHONOTO."},{"time":249.8,"until":257.3,"text":"AJINOMOTO · QUÉT MÃ QR DÊ XEM CÔNG THÚC · CHIENGION · MON · móingày"},{"time":257.9,"until":259.7,"text":"mingày · MON"},{"time":277.6,"until":281.5,"text":"AJINOMOTO · Eat Well, Live Well. · XÀOHOA · DÁY DÙ DINH DUÕNG · moingày · THIÈNLÝ · CÓI SÒ DIÊP · BÜA ÃN · VÓI"},{"time":282.1,"until":289.4,"text":"Beo béo · Thom thom · Thamthom · Đm đà"},{"time":294.0,"until":299.6,"text":"AJINOMOTO · ngay · Eat Well, Live Well · gay · Eat Wel, Live · maingay · Eat Wel · moing · ABNOMOTO"},{"time":300.0,"until":309.7,"text":"monngonmoingay.com · AJINOMOTO · Món Ngon Moi Ngày · moingay"},{"time":311.3,"until":323.5,"text":"Tham gia · Công ty Ajinomoto Vit Nam · Nguyên liu · Công ty Hakuhodo Vit Nam · Tham gia thc hin · Công ty Golden Scale · Hành táy: 1/2 cù · Công ty HKFilm · Ht nêm Aji-ngon Heo · Suòn non: 400g · Bn quyn kch bn và cu trúc · Phi hp thc hin · Màu đièu, bt nàng · Công ty H · Bt tm khò chiên giòn: 42g · Giám đò, mt ong, ngò rí · Tói bàm: 1M · Gia vi nêm sån Aji-Quick° · Thc hin chương trình · chuơng trình thuc · DÀI TRUYÊN HìNH TP. HCM · Ot súng: 1 trái · Gùng: 1 cù nhò · Thc hié"}],"speech":[{"time":16.1,"text":"Anh là anh chàng mê sườn, đổi chén giấm đỏ, đẩy miếng sườn"},{"time":20.8,"text":"Để em coi coi cái thương vụ này nó có thành công không"},{"time":23.8,"text":"Nhưng mà chưa gì là nghe có lợi cho cái bụng đói của em rồi đó"},{"time":26.4,"text":"Rất có lợi cho Minh Phương á"},{"time":28.1,"text":"Tại sao?"},{"time":28.7,"text":"Tại vì món sườn sốt giấm đỏ do chính tay mình làm"},{"time":31.4,"text":"Chúc luôn anh ơi"},{"time":34.7,"text":"Sườn non, sốt giấm đỏ, đẹp mắt, bắt cơm"},{"time":53.3,"text":"Mến chào các bạn khán giả đang theo dõi chương trình"},{"time":55.6,"text":"Món ngon mỗi ngày được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":60.7,"text":"Để thực hiện món sườn non sốt giấm đỏ"},{"time":62.8,"text":"Thì chúng ta sẽ lựa chọn phần sườn non có nhiều sụn hơn"},{"time":66.2,"text":"Cho vào đây 1 muỗng canh giấm đỏ"},{"time":69.5,"text":"Nửa muỗng cà phê hạt nêm Ajinomoto"},{"time":71.8,"text":"Cùng với nửa muỗng cà phê tiêu"},{"time":73.7,"text":"Nửa muỗng cà phê đường"},{"time":75.3,"text":"Chúng ta sẽ để phần gia vị thấm vào sườn này bao lâu hả anh Minh?"},{"time":79.8,"text":"Khoảng 10 phút là được đó Minh Phương"},{"time":81.6,"text":"Nhờ Minh Phương lấy giúp mình 1 cái chảo có nắp nha"},{"time":83.7,"text":"Dạ"},{"time":85.7,"text":"Và cho thêm một ít dầu vào trong đây"},{"time":87.6,"text":"Cùng với nửa lượng gần cắt sợi vào trong"},{"time":90.3,"text":"Đây, xào cái phần gần này cho nó thiệt là thơm"},{"time":92.8,"text":"Cho hết cái phần sườn nó ướp vào"},{"time":94.6,"text":"Dạ"},{"time":95.3,"text":"Đó, cái sườn chúng ta đã xém cạnh lên rồi đó"},{"time":98.9,"text":"Rất là hấp dẫn"},{"time":100.0,"text":"Cho cái phần nước xâm xấp cái mặt sườn đó"},{"time":103.3,"text":"Rồi, cảm ơn Minh Phương"},{"time":104.3,"text":"Và bây giờ thì chúng ta sẽ ôm trong bao lâu hả Minh?"},{"time":108.1,"text":"Chúng ta sẽ ôm sườn trong khoảng 15 phút là sườn chúng ta đã chín mềm rồi đó Minh Phương"},{"time":112.3,"text":"Thế nhưng em vẫn thắc thắc là tại sao lại cần thêm một cái bước ôm sườn"},{"time":116.0,"text":"À chúng ta sẽ ôm sườn trước khi chiên giúp sườn chín mềm và thấm vị nha"},{"time":120.4,"text":"Hành tây chúng ta sẽ cắt hình con thôi"},{"time":128.1,"text":"Và hành lá chúng ta sẽ cắt khúc"},{"time":133.5,"text":"Chúng ta sẽ cắt sợi cái phần ớt sườn"},{"time":136.9,"text":"Rồi sườn chúng ta đã xâm sắp nước rồi đó Minh Phương"},{"time":139.9,"text":"Cái phần nước ôm thịt nó đã rút xuống bớt chỉ còn xâm sắp thôi đúng không ạ"},{"time":144.0,"text":"Đúng rồi đó Minh Phương"},{"time":144.9,"text":"Bây giờ thì mình sẽ lấy sườn ra"},{"time":147.9,"text":"Rồi, tiếp theo chúng ta sẽ tẩm sườn qua gia vị niêm sẵn, ai quýt bột tẩm khô chiên giòn"},{"time":154.4,"text":"Giờ đây, một chảo dầu, mình phương mở lửa lên luôn nha"},{"time":158.7,"text":"Chúng ta sẽ cho hết phần sườn này vào chiên giòn"},{"time":161.7,"text":"Và hôm nay thì chúng ta cũng chiên ngập dầu đối với phần sườn này đúng không ạ?"},{"time":165.9,"text":"Đúng rồi, mình phương"},{"time":166.7,"text":"Chúng ta sẽ tẩm sườn qua gia vị niêm sẵn, ai quýt bột tẩm khô chiên giòn"},{"time":170.7,"text":"Giúp sườn giòn và thơm hơn"},{"time":172.3,"text":"Mình sẽ chiên cái phần sườn với lửa lớn một tí để cho sườn nó giòn hơn"},{"time":177.9,"text":"Theo như em tìm hiểu đó anh Minh, trong sườn non có rất là nhiều chất đạm, chất sắc cũng như là cali"},{"time":183.8,"text":"Mà đặc biệt là cali trong sườn non thì rất là tốt cho hệ tiên mạch, hệ tiêu hóa cũng như là cơ bắp nữa"},{"time":189.6,"text":"Bây giờ sườn chúng ta đã vàng rồi đó Minh Phương"},{"time":191.7,"text":"Chúng ta sẽ vớt cái sườn này ra nha"},{"time":194.4,"text":"Dạ rồi, hấp dẫn quá"},{"time":197.3,"text":"Em mở lửa lên nha"},{"time":198.5,"text":"Cho 1 ít dầu màu điều vào"},{"time":201.4,"text":"Cùng với nửa muỗng canh tỏi bông"},{"time":203.9,"text":"Phi thơm lên"},{"time":204.8,"text":"Xào cái phần hành tây này cho nó chín"},{"time":208.9,"text":"Tiếp theo chúng ta sẽ cho gừng còn lại vào"},{"time":211.0,"text":"Tiếp theo chúng ta sẽ cho cái gia vị làm sốt vào trong đây"},{"time":214.0,"text":"Là 2 muỗng canh giấm đỏ"},{"time":215.9,"text":"Cùng với 3 muỗng canh nước ôm sườn đó Minh Phương"},{"time":218.6,"text":"Chúng ta sẽ dùng nước ôm sườn để làm sốt"},{"time":221.4,"text":"Giúp món ăn thơm ngon và ngọt vị hơn nha"},{"time":223.6,"text":"3 muỗng canh mật ong"},{"time":226.6,"text":"Để tạo cái phần sánh sệt cho cái món ăn của chúng ta"},{"time":228.8,"text":"Thì chúng ta sẽ cho vào đây một ít bột năng cho cái phần sườn vào"},{"time":234.0,"text":"Để cái phần sốt chúng ta áo đều hết qua cái phần sườn"},{"time":237.3,"text":"Để tạo thêm màu sắc thì chúng ta sẽ cho cái phần ớt sườn và hành lá vào luôn"},{"time":242.0,"text":"Dạ rồi"},{"time":242.6,"text":"Thơm quá không Minh ơi"},{"time":244.8,"text":"Quả thật là không thể phủ nhận được độ hấp dẫn của món ăn ngày hôm nay đúng không ạ"},{"time":248.8,"text":"Thế thì còn chân chơi gì nữa"},{"time":250.6,"text":"Quý vị và các bạn ơi hãy sử dụng điện thoại di động của mình"},{"time":252.9,"text":"Để quét mã QR đang hiển thị trên màn hình để lưu lại công thức của món ăn ngày hôm nay nha"},{"time":259.6,"text":"Bây giờ chúng ta sẽ ra món nha"},{"time":262.3,"text":"Công dụng của giấm táo đỏ cho nên là phần nước sốt của chúng ta có một màu rất là đẹp không ạ?"},{"time":267.2,"text":"Đúng rồi, Minh Phương"},{"time":268.0,"text":"Wow, thật món ăn ngày hôm nay rất là hấp dẫn đúng không ạ?"},{"time":271.4,"text":"Và hứa hẹn sẽ mang đến cho các bạn một hương vị rất là mới lạ từ nguyên liệu sườn non"},{"time":276.4,"text":"Để có một bữa ăn hoàn chỉnh, chúng ta có thể kết hợp món còi điệp xào hoa thiên lý nha"},{"time":282.3,"text":"Sườn béo béo, mềm mại, áo nước sốt nâu ống ánh, đậm đà, thơm thơm giấm đỏ và vị gừng"},{"time":289.0,"text":"cay cay, nồi cơm hết ngay"},{"time":291.1,"text":"trong tích tắc"},{"time":293.8,"text":"Một món chiên vừa bắt cơm vừa bắt vị"},{"time":296.3,"text":"đã có công thức rồi"},{"time":297.4,"text":"vào bếp và thực hiện ngay thôi"},{"time":299.4,"text":"Quý vị và các bạn cũng có thể xem lại rất nhiều công thức"},{"time":302.4,"text":"của các món ăn ngon bằng cách truy cập"},{"time":304.1,"text":"vào kênh youtube, website"},{"time":305.6,"text":"và fanpage của chương trình"},{"time":307.3,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}