e":11.9,"text":"Cá thu sốt thảo mộc, ai ăn cũng gật gù khen ngon"},{"time":30.6,"text":"Mình chào các bạn khán giả đến với chương trình món ngon mỗi ngày"},{"time":33.2,"text":"Nấu chuẩn, ăn lành"},{"time":35.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":38.8,"text":"Và các bạn ơi, trong chương trình ngày hôm nay thì chúng ta sẽ cùng nhau thực hiện món cá thu sốt thảo mộc"},{"time":43.7,"text":"Cá thu được xem là vua của biển cả và được rất nhiều các quốc gia trên thế giới yêu thích"},{"time":48.4,"text":"Vị chua chua của xoài rất là dễ ăn"},{"time":50.8,"text":"Xoài còn cung cấp 75% lượng vitamin C cần thiết mỗi ngày cho chúng ta nữa"},{"time":55.2,"text":"Bây giờ Thanh Phương sẽ xắt lát rồi sau đó xắt sợi ra nha"},{"time":67.5,"text":"Tới phần xin thì phần rau thơm này thì chúng ta sẽ băm ra để một chút xíu làm sốt và ăn trực tiếp luôn"},{"time":72.4,"text":"Cho nên là mình sẽ sử dụng bao tai ha"},{"time":75.9,"text":"Các phần húng lũi khi mà băm nhuyễn ra thì tiết ra tinh dầu rất là thơm"},{"time":79.0,"text":"Đây cũng chính là gia vị đặc trưng của món ăn ngày hôm nay đấy ạ"},{"time":81.8,"text":"Chúng ta còn 2 loại gia vị thơm nữa là ngò ghí và ngò gai"},{"time":85.3,"text":"Thì bây giờ chúng ta cũng sẽ cắt nhuyễn ha"},{"time":89.4,"text":"Và tiếp theo thì xin sẽ lấy 1 phần 3 trái ớt sừng này"},{"time":92.8,"text":"Và chúng ta cũng sẽ băm nhỏ ra luôn để làm phần sốt"},{"time":95.7,"text":"Phần còn lại chúng ta sẽ thái sợi để trộn chung vào phần xoài"},{"time":98.7,"text":"Để cái phần xoài trộn chúng ta có màu sắc được đẹp hơn Phương ha"},{"time":103.0,"text":"Gốc hành cái phần trắng đó Phương"},{"time":104.4,"text":"Đập dập một chút xíu ha"},{"time":106.0,"text":"Và chúng ta sẽ thái nhuyễn nó ra"},{"time":108.0,"text":"Để tẩm ướt vào cái phần cá thu"},{"time":109.9,"text":"Và bây giờ thì xin sẽ hướng dẫn mọi người"},{"time":112.7,"text":"Chọn được cái miếng cá thu làm sao cho ngon"},{"time":114.7,"text":"Đầu tiên á"},{"time":115.5,"text":"Thì cá thu mình mua có thể là rất là dễ dàng ở chợ hoặc siêu thị"},{"time":118.9,"text":"Thì cái phần cá thu philet hôm nay thịt rất là trong nè"},{"time":121.2,"text":"Độ đàn hồi chúng ta có nè"},{"time":123.0,"text":"Thì đây là phần cá thu ngon ha"},{"time":124.4,"text":"Thì xin sẽ cắt cái phần cá thu này làm đôi ha"},{"time":126.5,"text":"Và cắt những khối vuông vừa ăn"},{"time":128.3,"text":"Các bạn lưu ý chúng ta cắt cá thành những khối vuông đồng đều nhau"},{"time":131.9,"text":"Để khi chiên cá được chín đồng đều nha"},{"time":133.8,"text":"Và các bạn ơi trong cá thu có chứa omega 3"},{"time":136.4,"text":"Giúp và chống ung thư nè và chống lão hóa nữa"},{"time":139.3,"text":"Rất là tốt cho sức khỏe đấy"},{"time":140.5,"text":"Xin sẽ nhờ chị Phương chuẩn bị một cái chảo dầu và bật lửa lên"},{"time":143.1,"text":"Và trong khi đợi chảo dầu nóng"},{"time":144.6,"text":"Thì xin sẽ nêm vào đây nửa gói gia vị nem sẵn aziquit bột tẩm khô chiên giòn nha"},{"time":149.3,"text":"Các bạn lưu ý chúng ta tẩm cá qua gia vị nem sẵn aziquit bột tẩm khô chiên giòn để cá không bị nát và dính chảo khi chiên nha"},{"time":155.3,"text":"Và bây giờ dầu cũng đã nóng rồi thì Phương chiên dùm xin cái phần húng lưỡi này một chút chúng ta sẽ ăn kèm và trang trí luôn ha"},{"time":160.6,"text":"Chiên lá húng lưỡi như thế này là để giúp cho dầu được thơm hơn"},{"time":164.5,"text":"Dầu thơm là lát nữa chiên cá, cá cũng sẽ thơm hơn đấy các bạn ạ"},{"time":168.1,"text":"Và cái phần cá sau khi đã tẩm ướp xong thì xin sẽ cho được vào chiên luôn nha"},{"time":171.1,"text":"Và đối với cá thu hôm nay thì chúng ta sẽ chiên rất là nhanh"},{"time":174.3,"text":"Bỏ vô chúng ta khoan hay đảo liền"},{"time":175.9,"text":"Thì đảo liền thì cá sẽ dễ bị vỡ và nát"},{"time":178.2,"text":"Bây giờ Phương có thể đảo nhẹ cái phần cá chúng ta được rồi đó"},{"time":180.8,"text":"Và chúng ta sẽ thăm chừng cái màu vàng của cá"},{"time":182.7,"text":"Thì bây giờ xin sẽ hướng dẫn quý vị"},{"time":184.2,"text":"Cái cách làm sao để có một chén sốt thảo mộng thật là ngon"},{"time":186.9,"text":"Đầu tiên thì chúng ta sẽ sử dụng 2 muỗng canh mật ong"},{"time":189.1,"text":"Các bạn lưu ý chúng ta sử dụng mật ong để làm sốt"},{"time":191.7,"text":"Để tạo được cái vị ngọt dịu tự nhiên"},{"time":193.6,"text":"Và độ sánh sệt cho sốt nha"},{"time":195.1,"text":"2 muỗng canh nước mắm truyền thống nha"},{"time":198.1,"text":"Thêm 1 muỗng canh nước chanh cho phần sốt của mình nha"},{"time":200.3,"text":"Và chúng ta sẽ trộn đều hỗn hợp này lên"},{"time":203.0,"text":"Rồi trong khi đó thì cá cũng đã bắt đầu vàng rồi nè các bạn ơi"},{"time":207.3,"text":"Và với cách chiên như thế này thì mình sẽ thấy là ở bên ngoài cá vàng giòn"},{"time":212.6,"text":"Nhưng mà bên trong cá vẫn còn giữ được cái vị ngọt của thịt nè"},{"time":217.0,"text":"Để xem lại công thức của món nấu chuẩn ăn lành ngày hôm nay"},{"time":220.1,"text":"Các bạn nhớ quét mã QR đang hiển thị trên bàn hình nha"},{"time":225.1,"text":"Và bây giờ thì Xin với Phương sẽ trang trí món ăn này nha"},{"time":228.0,"text":"Đầu tiên thì mình sẽ sử dụng cái phần xoài bầm khi nãy"},{"time":231.0,"text":"Đúng là cái vị chua chua của xoài mà ăn kèm với những cái món cá chiên quá thật là hết ý luôn đấy ạ"},{"time":236.2,"text":"Chúng ta sẽ xếp những cái miếng cá lên trên phần xoài này nha"},{"time":242.9,"text":"Nhìn dĩa cá chiên của chúng ta rất là hấp dẫn rồi đúng không Phương nào"},{"time":245.7,"text":"Nhưng còn hấp dẫn hơn khi chúng ta sử dụng cái sốt thảo mộc này"},{"time":248.7,"text":"Đây, chúng ta sẽ trang lên phần cá trước ạ"},{"time":252.7,"text":"Vài sợi ớt để lên trên"},{"time":254.2,"text":"Và cũng không thể nào thiếu cái công sức của Phương khi nãy để chiên những cái lá húng lũi nha"},{"time":258.5,"text":"Ngoài công việc là chúng ta làm thêm dầu thì chúng ta còn sẽ cho thêm lên đây để ăn kèm"},{"time":262.3,"text":"Và thêm một vài lá húng lũi tươi nữa"},{"time":264.6,"text":"Wow, rất là đẹp luôn"},{"time":266.3,"text":"Món ăn ngày hôm nay không chỉ bắt mắt, thơm ngon mà còn cân bằng về giá trị dinh dưỡng nữa"},{"time":271.4,"text":"Nhìn món cá chiên chúng ta rất là hoàn hảo và rất là ngon rồi đúng không?"},{"time":274.4,"text":"Để bữa ăn trở nên ngon miệng hơn thì chúng ta nên kết hợp món cá chiên này với canh gà nấm mỡ"},{"time":278.7,"text":"Cá chiên tươi ngon, giòn thơm bên ngoài, mọng ngọt của thịt cá tươi bên trong"},{"time":283.4,"text":"Nhằm nhì thêm sợi xoài chua chua, chấm sốt thơm mùi lá thảo mộc, chua cay ngọt đậm đà"},{"time":290.1,"text":"Nếu nhà bạn đang có sẵn cá thu thì hãy thực hiện ngay món ăn ngày hôm nay nhé"},{"time":294.0,"text":"Ngon nhất ngay"},{"time":295.3,"text":"Và nếu như để xem lại công thức của món ăn này"},{"time":297.9,"text":"Hãy truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":302.1,"text":"Hẹn gặp lại quý vị và các bạn trong những chương trình lần sau"}]}