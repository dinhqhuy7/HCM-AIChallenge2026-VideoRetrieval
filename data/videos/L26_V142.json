,{"time":223.5,"until":227.5,"text":"moingay"},{"time":236.8,"until":239.4,"text":"llne"},{"time":239.6,"until":242.6,"text":"moingay"},{"time":242.8,"until":246.5,"text":"Blendy · AJINOMOTO · MON · móingày · móingay · Aregon"},{"time":252.0,"until":254.4,"text":"IME1m · Onlin · DÂU MÈ 1 · IDAU MÈ 1m · DAUMÈ · DÃU MÈ"},{"time":254.6,"until":259.0,"text":"NUÓC BÔT NANG · INUÓC BÔT NÄNG"},{"time":259.3,"until":261.2,"text":"Eat Wel,Live Well · móingay · Blendy · Ellendy · AINOMOTOD"},{"time":261.8,"until":267.4,"text":"AJINOMOTO · QUÉT MÃ QR DÊ XEM CÔNG THÚC · MON · moingay"},{"time":267.6,"until":269.4,"text":"mingày · MON · MO7"},{"time":284.8,"until":290.2,"text":"AJINOMOTO · Eat Well, Live Well. · mingày · RONG BIÉN · CUÓN · CHÀ CHAY · DÁY DÙ DINH DUÖNG · Blen · BÜA ÃN · CUÔN · VÓI"},{"time":303.9,"until":309.2,"text":"NOMOTO · ngay · OTO · IGON · Live Well · KOMOTO · AJINOM · moinga · moi · Eat Wes."},{"time":310.2,"until":317.1,"text":"monngonmoingay.com · nline · AJINOMOTO · Onl · Món Ngon Mōi Ngày · maingay · Eat Wed, Live Weil. · ngingay"},{"time":317.7,"until":329.8,"text":"50g · 1/2 ming · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo · Công ty Golden Scale · 4 tai · 3 cây · Công ty HKFilm · NGUYÊN LIÊU · Bn quyn kch bn và cu trúc · Phi hp thc hin · ·DÁU HÀO CHAY · ·DÂU HÙ NON · ·GIÁM GAO LÊN MEN · · GÙNG CÁT QUÀ TRÁM · ·NÃM DÔNG CÔ NGÂM · chuơng trình thuc · ·CÀI THIA · Thc hin chương trình · ·BOA-RÔ BĂM · · BÔT NGOT, NUC TUONG · · DÁU MÈ, BÔT NÄNG · Thc hin chươ · DÀI TRUYÊN HìNH · THÀNH PHÓ HO CHÍMINH · Onl · ·ÓT SÜNG · ·NÃM ROM · ·Mì CÃN · ·NÄM RÓM"}],"speech":[{"time":11.9,"text":"Mì căn sốt nấm, món chay ngon miệng cho cả gia đình"},{"time":34.9,"text":"Chúc vui được gặp lại các bạn khán giả đang đến với chương trình Món ngon mỗi ngày"},{"time":38.4,"text":"Nấu chuẩn, ăn lành"},{"time":40.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":44.1,"text":"Và đối với món ăn ngày hôm nay thì Phước Hương sẽ hướng dẫn cho các bạn"},{"time":47.2,"text":"Một món ăn chay rất là thanh đạm mà lại rất là dễ làm nữa"},{"time":51.0,"text":"Vậy thì bây giờ chúng ta sẽ bắt tay vào làm ngay món này nha"},{"time":54.0,"text":"Phần nấm rơm của món ăn này bây giờ chúng ta sẽ cắt đôi"},{"time":60.3,"text":"Phần nấm đông cô thì bây giờ chúng ta sẽ cắt hạt lũ hết luôn"},{"time":63.3,"text":"Phần ớt sừng thì các bạn cắt quả trám"},{"time":66.5,"text":"Phần gừng thì bây giờ chúng ta cũng sẽ cắt quả trám luôn"},{"time":69.4,"text":"Phần cải thịa trong món ăn này thì chúng ta sẽ cắt ra 2 phần"},{"time":73.0,"text":"Sẽ lựa 3 cọng cải thịa đẹp để chúng ta làm hoa"},{"time":78.3,"text":"Còn những cải thịa còn lại bỏ bớt lá đi và chúng ta chẻ đôi"},{"time":82.1,"text":"Đối với món chai thì chúng ta sẽ kết hợp với 1 ít rau"},{"time":85.4,"text":"Thì ăn sẽ rất là ngon"},{"time":86.9,"text":"Phần đậu hủ non này thì bây giờ chúng ta sẽ cắt khối vuông khoảng 1cm"},{"time":92.9,"text":"Phần mì căng này Phước Hương sẽ cắt khối vuông"},{"time":95.2,"text":"Và đối với món ăn ngày hôm nay thì chúng ta sẽ chọn mì căng chắc mịn, đó là mì căng ngon"},{"time":100.0,"text":"Mì căng thì được làm từ gluten, một cái thành phần chính, một cái loại protein có trong bột mì"},{"time":106.1,"text":"Cách làm thì chúng ta sẽ nhồi bột mì với nước, sau đó sẽ rửa qua nước để loại bỏ đi phần tinh bột và giữ lại phần protein"},{"time":112.6,"text":"Bây giờ chúng ta sẽ ướp gia vị vào đây"},{"time":114.7,"text":"Đầu tiên Hương sẽ cho vào đây 1 muỗng cà phê hành bò rô bằm"},{"time":118.5,"text":"Nửa muỗng cà phê đường"},{"time":119.8,"text":"Nửa muỗng cà phê muối"},{"time":123.0,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":125.4,"text":"Chúng ta sẽ ướp gia vị cho mì căng trước"},{"time":127.9,"text":"Giúp cho món ăn thơm ngon hơn"},{"time":129.7,"text":"Và bây giờ tiếp theo Phước Hương sẽ hướng dẫn cho các bạn"},{"time":132.1,"text":"Chúng ta sẽ pha cái hỗn hợp sốt"},{"time":133.9,"text":"Cho vào đây 1 muỗng canh dầu hào chai"},{"time":136.3,"text":"1 muỗng canh nước tương phú sỉ"},{"time":138.4,"text":"1 muỗng canh giấm gạo lên men Ajinomoto"},{"time":141.7,"text":"1 muỗng canh đường"},{"time":143.7,"text":"Một muỗng cà phê bột ngọt Ajinomoto"},{"time":146.2,"text":"Một muỗng cà phê hạt nêm Ajinon nấm"},{"time":149.2,"text":"Cho vào đây một ít tiêu"},{"time":151.0,"text":"Và nửa chén nước"},{"time":153.5,"text":"Chúng ta sẽ khuấy đều lên"},{"time":155.2,"text":"Phước Hưng cũng đã chuẩn bị sẵn một cái nồi nước sôi để chúng ta trần sơ qua phần cải thề"},{"time":159.7,"text":"Cho vào đây một ít muối nè"},{"time":161.5,"text":"Bây giờ thì Phương sẽ cho cải thề vào ha"},{"time":165.6,"text":"Giờ chúng ta sẽ vớt ra"},{"time":168.6,"text":"Phước Hưng sẽ đặt lên trên bếp một cái chảo để chúng ta xào cải thề"},{"time":171.6,"text":"Rồi lên lửa nha"},{"time":172.9,"text":"Cho vào đây một ít hành bò rô băm để chúng ta phi thơm"},{"time":176.4,"text":"Bò rô cũng đã dậy lên mùi thơm rồi Phước Hương sẽ cho cải thịa vào"},{"time":180.8,"text":"Cho vào đây một phần tư muỗng cà phê hạt nêm Azi ngon nắm"},{"time":184.7,"text":"Xào nhanh tay cái phần cải thịa này cho phần cải thịa thấm gia vị"},{"time":188.7,"text":"Phần cải thịa rất là xanh luôn"},{"time":190.6,"text":"Chúng ta sẽ tắt bếp nè"},{"time":192.4,"text":"Hương sẽ cho ra dĩa"},{"time":196.4,"text":"Hương cho vào đây một ít dầu"},{"time":198.3,"text":"Chúng ta xào cái phần mì căng này cho vàng ra mặt"},{"time":201.5,"text":"Mặc dù là một loại thực phẩm đã qua chế biến"},{"time":204.0,"text":"Nhưng mà hàm lượng đường, calor cũng như là chất béo trong mì căng thì rất thấp"},{"time":208.2,"text":"Chính vì thế đây sẽ là một nguyên liệu rất phù hợp cho các thực đơn ăn kiên"},{"time":211.8,"text":"Phần mì căng cũng đã vàng xém mặt rồi chúng ta sẽ tắt bếp"},{"time":215.9,"text":"Hương sẽ cho hết phần mì căng này ra một cái dĩa"},{"time":218.8,"text":"Sử dụng chảo này chúng ta sẽ phi gừng và ớt để chúng ta làm phần sốt"},{"time":223.1,"text":"Hương sẽ cho gừng cắt quả trám vào chúng ta phi thơm"},{"time":227.3,"text":"Phần gừng đã dậy lên mùi thơm rồi tiếp tục"},{"time":229.9,"text":"Phước Hương sẽ cho phần nấm rơm vào chúng ta xào sợi"},{"time":234.1,"text":"Phần nấm rơm cũng đã thơm rồi"},{"time":235.8,"text":"Hương sẽ cho phần đông cô vào"},{"time":239.2,"text":"Chúng ta sẽ nhỏ lửa"},{"time":240.6,"text":"Hương sẽ cho phần sốt vào"},{"time":241.9,"text":"Sẽ nhẹ tay cho phần đậu hủ vào"},{"time":244.0,"text":"Để cho đậu hủ được thấm vị"},{"time":245.9,"text":"Cho luôn cái phần ớt sừng đỏ nè"},{"time":248.5,"text":"Cho phần mì căng vào tiếp tục"},{"time":250.7,"text":"Cho vào đây 1 muỗng cà phê dầu mè nè"},{"time":253.9,"text":"Cho bột năng vào từ từ thôi"},{"time":257.1,"text":"Và như vậy là chúng ta sẽ có thêm 1 công thức"},{"time":259.4,"text":"Về món chay vô cùng hấp dẫn"},{"time":261.0,"text":"Quý vị và các bạn đừng quên dùng điện thoại di động của mình"},{"time":263.5,"text":"Quẹt mã QR đang hiển thị trên bàn hình để lưu ngay công thức của món ăn này nha"},{"time":269.5,"text":"Chúng ta sẽ múc phần nhân vào"},{"time":272.6,"text":"Cho cải thìa vào"},{"time":280.6,"text":"Thêm một chút ớt sừng nữa cho màu sắc của món ăn bắt bắt hơn"},{"time":284.0,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng thì chúng ta có thể kết hợp với món chả chai cuộn rong biển cũng sẽ rất là ngon"},{"time":290.3,"text":"Mì canh dẻo, đậu hủ béo mềm, nấm và rau củ giòn giòn thanh mát"},{"time":295.4,"text":"Phần nước sốt sánh vị đậm đà rất hài hòa hấp dẫn"},{"time":299.3,"text":"Cùng hương thơm của gừng và hành barro"},{"time":302.6,"text":"Muốn ăn chay hãy nhớ ngay tới món ngon mỗi ngày"},{"time":305.9,"text":"Đảm bảo vừa độc lạ vừa thơm ngon và đầy đủ chất dinh dưỡng"},{"time":309.7,"text":"Và cũng đừng quên truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":314.2,"text":"Để xem thêm nhiều công thức của các món ăn ngon khác"},{"time":316.5,"text":"Quý vị nhé"}]}