ÄM · Onl"}],"speech":[{"time":12.1,"text":"Canh cá chép giòn nấu nghệ, chua thanh, ngọt thịt, thích mê"},{"time":36.2,"text":"Rất vui khi được gặp lại các bạn khán giả đang xem chương trình Món ngon mỗi ngày"},{"time":39.9,"text":"Nấu chủ ăn lành"},{"time":41.0,"text":"Chương trình được tài trợ bởi công ty Agiro Moto Việt Nam"},{"time":45.7,"text":"Hôm nay mình nấu một cái món ăn mà anh ơi em ghiêng"},{"time":49.8,"text":"Cái món này đó chính là cá chép giòn"},{"time":52.8,"text":"Và em nghĩ rằng là nếu mà quý vị nào mà chưa ăn cá chép giòn"},{"time":57.1,"text":"Thì chúng ta ăn một lần thì mọi người sẽ cảm thấy thích ngay luôn"},{"time":60.8,"text":"Và đây là cá chép anh đã fillet rồi"},{"time":63.7,"text":"Bây giờ chúng ta sẽ cắt ra thành miếng nhỏ"},{"time":66.2,"text":"Cắt xuôi theo như vậy nha"},{"time":67.8,"text":"Đó"},{"time":69.3,"text":"Kéo vào đây"},{"time":71.3,"text":"Cắt đứt cái da luôn"},{"time":73.1,"text":"Tiếp tục"},{"time":73.8,"text":"Đó, cắt ra như vậy"},{"time":76.6,"text":"Đó"},{"time":77.0,"text":"Theo như em biết thì cá chép giòn mà được nuôi theo một chế độ đặc biệt"},{"time":80.0,"text":"Tôi thích nó giòn"},{"time":80.6,"text":"Đúng rồi"},{"time":81.5,"text":"Và không phải con cá nào nuôi theo chế độ đó nó cũng giòn"},{"time":84.3,"text":"Chúng ta ướp vào đây 1 muỗng canh nghệ tươi"},{"time":88.3,"text":"Chúng ta xay nhuyễn hoặc giả"},{"time":90.8,"text":"khoảng 1 muỗng cà phê hành tím băm, 1 muỗng cà phê tỏi băm, và 1 muỗng cà phê bột canh Ajinomoto."},{"time":99.5,"text":"Rồi chúng ta ướp để ở đây 15 phút."},{"time":104.9,"text":"Phần cà chua thì như mỗi khi chúng ta sẽ cắt muối cao."},{"time":112.8,"text":"Món này chúng ta phải còn nhiều hành lá và thịt lạ ăn mới ngon."},{"time":115.9,"text":"Càng nhiều càng ngon."},{"time":117.2,"text":"Đúng rồi. Em có thích ăn thịt lạ không?"},{"time":119.0,"text":"Dạ rất thích ăn."},{"time":121.3,"text":"Bây giờ chúng ta bắt lên cái nồi chúng ta nấu thôi các bạn."},{"time":124.2,"text":"Chúng ta cho vô đây 1 ít dầu ăn."},{"time":126.5,"text":"Chúng ta cho nốt cái phần hành tím và tỏi vào"},{"time":129.3,"text":"Xào thơm"},{"time":130.2,"text":"Và mình sẽ cho cà chua để dầu ăn"},{"time":132.8,"text":"Và nó sẽ giúp cho cà chua có thể chuyển hóa"},{"time":135.8,"text":"Mình hấp thụ vitamin tốt hơn"},{"time":137.0,"text":"Hay quá ta mà màu nó đẹp nữa"},{"time":138.8,"text":"Cho vô"},{"time":140.8,"text":"Đỏ nhanh qua"},{"time":142.4,"text":"Thưa các bạn chúng ta phi thơm hành tỏi"},{"time":145.1,"text":"Sau đó cho cà chua vào và trút ra để điên"},{"time":147.5,"text":"Như vậy nước canh chúng ta sẽ thơm"},{"time":149.9,"text":"Và giữ được màu đỏ đẹp của cà chua"},{"time":152.1,"text":"Bây giờ tiếp tục"},{"time":153.4,"text":"Chúng ta cho cái cá đã ướp"},{"time":155.9,"text":"Cho vào xào xanh"},{"time":157.6,"text":"Các bạn nhớ nha"},{"time":158.6,"text":"Chúng ta nên ướp cá với nghệ tươi xay ngay từ đầu"},{"time":161.5,"text":"Để cho cá thấm được màu nghệ"},{"time":163.9,"text":"Và cũng như cá có mùi thơm tự nhiên từ nghệ"},{"time":166.7,"text":"Ở trong cá chép giòn thì có rất là nhiều vitamin, canxi"},{"time":169.8,"text":"Và đặc biệt là chất béo như là chất đạm"},{"time":171.7,"text":"Và có collagen"},{"time":173.5,"text":"Để nắm đẹp da nữa"},{"time":174.6,"text":"Đúng rồi"},{"time":175.2,"text":"Rồi bên cạnh đó nghệ thì là cucumin"},{"time":176.7,"text":"Tốt cho hệ tiêu hóa cũng tốt cho da luôn"},{"time":178.6,"text":"Kết hợp với nhau kèm với những loài rau củ nữa"},{"time":181.1,"text":"Thì đây là một món ăn mà có thể nói là nó đầy đủ những thành phần dinh dưỡng bên trong"},{"time":184.6,"text":"Và thưa các bạn, cá sau khi chúng ta xào săn, chúng ta cho vào đây 1,5 lít nước nóng nha các bạn."},{"time":190.0,"text":"Như vậy thì cá sẽ săn chắc và giữ được độ giòn sau khi nấu."},{"time":193.3,"text":"Chúng ta sẽ đem vào đây 1 muỗng canh bột canh Ajinomoto, 1 muỗng cà phê bột ngọt Ajinomoto, 2 muỗng canh giấm gạo lê men Ajinomoto."},{"time":205.4,"text":"Sau khi chúng ta nấu khoảng 7 phút thì cá chín, chúng ta sẽ cho cà chua vào, hành lá, chìa gà vào."},{"time":214.0,"text":"Và sau cùng chúng ta cho vào đây 1 muỗng cà phê nước mắm"},{"time":221.9,"text":"Đây là 1 món ăn rất là hấp dẫn, rất là thơm"},{"time":225.6,"text":"Và nó sẽ thu hút tất cả quý vị"},{"time":228.1,"text":"Và đối với những người miền Nam thì chúng ta sẽ cảm thấy hương vị này sẽ rất là lạ lắm"},{"time":232.5,"text":"Ăn rất là thích miệng luôn"},{"time":233.5,"text":"Ngay bây giờ trên màn hình đang có 1 mã QR"},{"time":235.8,"text":"Quý vị có thể quét mã này thì công thức nấu ăn này sẽ hiện ra"},{"time":238.7,"text":"Và quý vị có thể thực hiện ngay tại nha"},{"time":242.4,"text":"Rồi chúng ta cho ra đây"},{"time":244.9,"text":"Một món yêu thích của em luôn"},{"time":246.3,"text":"Tất cả những nguyên liệu em đều yêu thích"},{"time":248.0,"text":"Thì là hành lá, cà chua, cá chép giòn"},{"time":252.7,"text":"Và thưa các bạn thế là trong tích đắc"},{"time":254.4,"text":"Chúng ta đã hoàn thành xong"},{"time":256.1,"text":"Một bún canh khá là hấp dẫn"},{"time":257.8,"text":"Bên cạnh là cơm thì các bạn có thể ăn kèm cùng với lại bún"},{"time":260.2,"text":"Đây là một món mà em rất là ghiền luôn"},{"time":262.5,"text":"Cảm ơn anh ngày hôm nay đã"},{"time":263.6,"text":"Một lần nữa thích đại em món ăn này"},{"time":265.6,"text":"Thưa các bạn món này chúng ta kết hợp cùng với lại"},{"time":267.9,"text":"Sườn non kho củi sen"},{"time":269.2,"text":"Và đậu cơ ve xào tim gam"},{"time":271.0,"text":"Thì chúng ta có ngay một bữa ăn hoàn chỉnh"},{"time":273.3,"text":"Với đầy đủ các thành phần dinh dưỡng"},{"time":275.4,"text":"Canh cá có màu vàng nghệ"},{"time":277.1,"text":"Nước canh trong thơm lừng mùi thị lạ"},{"time":279.8,"text":"Cá chép chín giòn ngọt thích"},{"time":281.9,"text":"Vị chua dịu"},{"time":283.2,"text":"Ăn vào thanh mát nhẹ người thích mê"},{"time":291.0,"text":"Cuối tuần các bạn thử vào bếp"},{"time":293.2,"text":"Và làm ngay món canh cá chép giòn nấu nghệ"},{"time":295.9,"text":"Xem cả gia đình mình có trầm trồ khen ngon hay không nha"},{"time":298.6,"text":"Riêng Minh Tuấn sau khi nếm thử"},{"time":300.2,"text":"Thì bản thân mình vô cùng trầm trồ"},{"time":302.0,"text":"Để làm món ăn này chúng ta có thể truy cập vào"},{"time":304.1,"text":"Youtube, website và fanpage"}]}