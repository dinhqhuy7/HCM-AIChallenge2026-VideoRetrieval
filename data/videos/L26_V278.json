},{"time":82.4,"text":"Mình có ớt rồi nha bạn Long"},{"time":83.8,"text":"Nên bạn cứ làm những việc bạn cần làm đi"},{"time":85.8,"text":"Hành cắt khúc 3cm"},{"time":87.9,"text":"3cm"},{"time":89.4,"text":"Cái ớt hiểm tiện Kim Thảo giúp Long là mình đập dập"},{"time":92.3,"text":"ớt hiểm sẽ làm cho món ăn chúng ta có vị cay, vị the"},{"time":95.1,"text":"Cái phần ớt sần này là Kim Thảo giúp Long là mình cắt sợi"},{"time":98.4,"text":"Long sẽ ướp phần cá"},{"time":99.8,"text":"Các bạn lưu ý là món ăn này chúng ta sử dụng cá bớp"},{"time":102.3,"text":"Tại vì cá bớp ít xương, mềm và thịt thơm"},{"time":105.0,"text":"Giúp cả nhà thích ăn nhiều hơn và đặc biệt là những em bé"},{"time":107.5,"text":"Mình sẽ cho vào đây là 1 muỗng canh hành tỏi băm"},{"time":110.7,"text":"1 phần 3 muỗng cà phê tiêu"},{"time":112.2,"text":"1 muỗng cà phê đường"},{"time":113.7,"text":"1 muỗng canh nước mắm"},{"time":115.3,"text":"Và mình trộn đều lên"},{"time":116.6,"text":"Sau đó để thịt cát nghỉ thấm gia vị"},{"time":119.5,"text":"Ở đây Long có 1 miếng thịt ba rọi heo rút xương rất là ngon"},{"time":122.8,"text":"Bây giờ Long sẽ cắt mỏng phần thịt heo"},{"time":125.4,"text":"Kho cá mà mình bỏ thịt ba rọi vô"},{"time":127.8,"text":"Rất là nhiều những công dụng khác nhau ha Long ha"},{"time":130.5,"text":"Làm nổi bật cái vị thơm của mỡ heo lên"},{"time":133.5,"text":"Đồng thời cái độ béo, độ ngậy tăng lên"},{"time":137.3,"text":"Bây giờ cái phần thịt mình đã cắt xong"},{"time":139.3,"text":"Long sẽ ướp phần thịt này trước khi mình kho"},{"time":141.3,"text":"Cho vào đây là 1 muỗng canh hành tỏi băm"},{"time":144.2,"text":"1 phần 3 muỗng cà phê hạt nêm Aji ngon heo"},{"time":148.2,"text":"1 phần 3 muỗng cà phê tiêu"},{"time":149.9,"text":"1 phần 3 muỗng cà phê đường"},{"time":151.6,"text":"Và trộn đều lên"},{"time":153.4,"text":"Bây giờ chúng ta sẽ bật lửa lên và kho cá"},{"time":157.4,"text":"Cảm ơn Kim Thảo"},{"time":158.2,"text":"Mình sẽ cho vào đây là 1 ít dầu ăn"},{"time":160.5,"text":"Mời bạn Kim Thảo cho vào đây là 1 muỗng canh đường"},{"time":162.8,"text":"Và mình quan sát cái đường"},{"time":164.4,"text":"Phần đường nó chảy ra"},{"time":167.1,"text":"Kim Thảo và các bạn lưu ý nha"},{"time":168.6,"text":"Khi mà caramel chúng ta có được 1 cái màu như mong muốn"},{"time":171.7,"text":"Thì kế đến mình sẽ cho dầu đều vào"},{"time":173.6,"text":"Sau khi cho dầu đều vào mình sẽ cho cá vào luôn"},{"time":177.1,"text":"Mật lửa lên"},{"time":177.9,"text":"Rồi"},{"time":181.0,"text":"Lúc này mình sẽ cho cá ra ngoài tô"},{"time":183.3,"text":"Màu quá là đẹp luôn á Long"},{"time":185.4,"text":"Chúng ta xóc cá với đường caramel"},{"time":187.3,"text":"Giúp thịt cá săn chắc và thấm vị"},{"time":189.4,"text":"Rồi cái chảo khi nãy"},{"time":191.0,"text":"Mình sẽ dùng để tiếp tục"},{"time":192.4,"text":"Mình xào phần thịt"},{"time":193.8,"text":"Mình xin tí xíu dầu điều của cá nè"},{"time":196.1,"text":"Mình xào săn cho nó rám mặt tí xíu là được"},{"time":198.7,"text":"Các gia vị là Long ướp rất là chuẩn"},{"time":201.5,"text":"Cho nên là khi vừa cho thịt vào thôi"},{"time":203.5,"text":"Kim Thảo đã thấy cái mùi thơm"},{"time":206.1,"text":"Rồi"},{"time":206.5,"text":"Rồi sau khi mà thịt săn lại thì Long sẽ cho cá vào."},{"time":209.4,"text":"Cho vào đây là nửa chén nước nóng."},{"time":211.6,"text":"Xăm xách mặt cá là được."},{"time":213.0,"text":"Cho nước vào là phải cho nước nóng để cho cá đừng có bị tanh."},{"time":215.9,"text":"Chính xác."},{"time":216.9,"text":"Cá bớp đặc biệt là có DHA tốt cho trí nả của các bạn nhỏ nè."},{"time":221.8,"text":"Còn có cả Omega 3 là một chất béo tốt, dễ hấp thụ."},{"time":225.7,"text":"Và nó sẽ giúp cho các loại khoáng chất và vitamin dễ hấp thụ vào trong cơ thể của chúng ta."},{"time":230.4,"text":"Long sẽ cho vào đây là 3 trái ớt khiểm nếu cho các người lớn ăn nè."},{"time":233.0,"text":"Khi mà nước cạn dần đi"},{"time":234.5,"text":"Chúng ta sẽ cho vào đây là 1 cuộn canh sốt mayonnaise"},{"time":237.3,"text":"Aji mayo ngọt dịu"},{"time":238.8,"text":"Vì chúng ta cho sốt mayonnaise Aji mayo ngọt dịu"},{"time":241.8,"text":"Vào trong món ăn tạo có 1 độ mứt"},{"time":243.6,"text":"Mềm và màu sắc đẹp cho món kho"},{"time":245.8,"text":"Đảo nhẹ chảo như vầy"},{"time":246.9,"text":"Sẽ không làm cái phần cá bị nát đi nữa"},{"time":248.9,"text":"Cho phần hành ở và Kim Thảo đã cắt vào"},{"time":251.6,"text":"Rồi hành trước nha"},{"time":253.5,"text":"Bây giờ mình mới có cái màu sắc tương phản nè"},{"time":255.6,"text":"Rải đều ra"},{"time":256.8,"text":"Wow rất là hấp dẫn luôn"},{"time":258.9,"text":"Và Kim Thảo tin chắc rằng là món cá bớp"},{"time":261.4,"text":"Kho thịt ba rọi sẽ rất là bắt cơm"},{"time":263.3,"text":"Và nếu như quý vị muốn xem lại công thức của ngày hôm nay"},{"time":265.8,"text":"Quý vị có thể quét mã QR của chúng tôi nha"},{"time":271.1,"text":"Mình lấy những cái phần thịt mình múc ra trước"},{"time":273.1,"text":"Ừ"},{"time":273.6,"text":"Miếng cá thì quá hấp dẫn luôn"},{"time":275.6,"text":"Wow"},{"time":277.4,"text":"Hấp dẫn quá"},{"time":279.6,"text":"Rồi"},{"time":280.0,"text":"Mình cho thêm một tí xíu nước sốt lên nè"},{"time":282.5,"text":"Một nhánh ngò"},{"time":283.8,"text":"Như vậy là chúng ta đã hoàn thành xong món ăn này"},{"time":285.9,"text":"Và để tạo nên một bữa ăn hoàn chỉnh"},{"time":287.8,"text":"Long khuyên các bạn nên ăn kèm với món canh gà bí xanh"},{"time":290.7,"text":"Ừ"},{"time":291.7,"text":"Những khúc cá vàng nâu, bóng mứt, thịt cá ngọt như mềm, thấm vị, thịt bà rọi béo béo thơm thơm, siêu cuốn hút."},{"time":301.2,"text":"Đưa ngay món này vào danh sách các món kho ngon và độc đáo của gia đình các bạn nhé."},{"time":306.1,"text":"Và để xem lại công thức của món ăn ngày hôm nay, các bạn có thể truy cập vào Youtube, website, fanpage của chương trình Món Ngon Mỗi Ngày."}]}