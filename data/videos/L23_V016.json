:66.7,"text":"Sẽ lại là một đoạn cạnh tranh nước đúc cực kỳ hấp dẫn nữa"},{"time":69.5,"text":"Chúng ta đang chờ đợi"},{"time":70.5,"text":"Đồng Tháp không lên làm tông"},{"time":71.8,"text":"Và Trần Tuấn Kiện lúc này đang đi ngay phía sau xe của Lê Nguyệt Minh và Trịnh Đức Tâm"},{"time":76.2,"text":"1,5 km cuối cùng vẫn là nhiệt kiểm soát của ekip Vĩnh Long"},{"time":85.1,"text":"Nhưng lúc này những người đang muốn lên cạnh tranh trực tiếp với họ"},{"time":87.5,"text":"Đó là các tay đua của ekip quân của Bảy"},{"time":91.0,"text":"Vẫn là vị trí tốt của Roman Maikin ở ngay phía trước Martin Las"},{"time":95.2,"text":"Nhưng chưa thấy người đồng đội của anh Peter Rikunov xuất hiện ở trong khung hình này"},{"time":99.6,"text":"Trong khi đó thì lúc này các tay đua của Vĩnh Long đã gò lưng để nạp tốc độ lên trên 50kmh"},{"time":104.5,"text":"Đây là lực kéo của Bỏ Thanh An vừa hoàn tất và tiếp theo đó là đội Khánh Duy"},{"time":117.5,"text":"Đã có đến 4 tay đua trong màu áo đỏ ở 1km cuối cùng đang cố gắng tràn lên ngang với tổng của Vĩnh Long"},{"time":127.2,"text":"Đây là 1km cuối cùng"},{"time":129.0,"text":"Tay đua đang đi ngay phía sau trên nước đốt chủ lực của ekip quân khu 7"},{"time":132.8,"text":"Đó là phòng lên xuân lọc để mở ra cơ hội cho Quang Quang Cường"},{"time":135.7,"text":"Các tay đua của 620 châu đới Vĩnh Long đã tăng tốc lên phía trên"},{"time":139.4,"text":"Roman Makin đi giữa Mikael Rehn và Martin Las"},{"time":142.6,"text":"Nhưng chúng ta chưa thấy được chiếc áo vàng của Peter Dikunov"},{"time":145.3,"text":"Áo vàng Peter Dikunov đang đi ngay sau áo cam Nguyễn Tấn Hoài"},{"time":150.0,"text":"Và ở phía sau Nguyễn Văn Bình"},{"time":152.4,"text":"Tay đua cuối cùng tách ra nhưng bây giờ là một tông song song"},{"time":155.5,"text":"Thậm chí có tốc độ ngang bằng và tốt hơn cả các tay đua của 620 châu đới Vĩnh Long"},{"time":159.8,"text":"Đó là các tay đua của quân khu 7"},{"time":161.9,"text":"Phạm Lê Xuân Lộc đang là người mở tốc độ làm nước lớn cho quang bắn cường"},{"time":174.9,"text":"Hoàng Văn Cường đang tăng tốc, bên kia là Roman Maikin, Hoàng Brandy rất mạnh mẽ tìm kiếm chiến đắng."},{"time":179.8,"text":"Cố lên các thầy đua quân khu 7, Roman Maikin, Hoàng Văn Cường, một đoàn chơi nước đốt áp giảm cùng chờ xem."},{"time":185.2,"text":"Đó là thầy đua Lê Nguyệt Minh."},{"time":210.0,"text":"Chân rút số 11 của TP.HCM, New Group đã chọn vị trí và tình huống ra xe quá hay để có được chiến thắng chẳng đầu tiên cho tập thể TP.HCM tại Cúp Truyền hình năm nay."},{"time":220.5,"text":"Những chân rút mạnh như Peter Rikunov đã bị kẹt lại ở phía sau"},{"time":224.3,"text":"Và có vẻ như áo vàng ngày hôm nay không quá nỗ lực để cạnh tranh ở đoạn nước rút này"},{"time":228.8,"text":"Và muốn chọn phương án an toàn"},{"time":232.3,"text":"Không hề có mặt của Peter Rikunov ở trong nhóm các tài đua cạnh tranh ở vạch nước rút"},{"time":240.5,"text":"Peter Rikunov đã không tràn lên để có vị trí thuộc lợi và tham gia vào cuộc cạnh tranh nước rút này"},{"time":247.7,"text":"Anh đã nằm lại ở phía sau"},{"time":249.5,"text":"Và đó là cơ hội mở ra"},{"time":251.2,"text":"Lê Nguyệt Minh có được vị trí tốt"},{"time":252.8,"text":"Đã tận dụng hoàn hảo với cú ra xe lách trái"},{"time":255.1,"text":"Và vượt lên ngay trước mặt Hoàng Văn Cường"},{"time":258.0,"text":"Ở ngay vạch đích"},{"time":259.7,"text":"Một màn bức tốc mạnh mẽ"},{"time":263.2,"text":"Của tài đua từng 3 lần mặc áo xanh chung cuộc"},{"time":265.1,"text":"Cúp truyền hình thành phố Hồ Chí Minh"},{"time":273.1,"text":"Những nỗ lực tuyệt vời"},{"time":274.9,"text":"Những màn thi đấu xuất sắc của các tài đua"},{"time":277.2,"text":"Quân khu 7 ở đoạn nước rút"},{"time":278.9,"text":"Đã không mang về được quả ngọt"},{"time":281.0,"text":"Như họ mong đợi"},{"time":282.7,"text":"Nhưng đó là một tình huống thi đấu rất hay"},{"time":315.7,"text":"Tình huống ra xe chọn vị trí khôn khéo và cú bức tóc mạnh mẽ đã mang về chiến thắng chặng đầu tiên cho Lê Nguyệt Minh."},{"time":322.2,"text":"Cũng như là chiến thắng chặng đầu tiên cho tập thể TP.HCM ở cuộc đua năm nay."},{"time":326.5,"text":"Một lần nữa cái duyên của Lê Nguyệt Minh được thể hiện ở trận đua từ Tuy Hòa về Nha Trang."}]}