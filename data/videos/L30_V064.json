:"Tác già: LONG SA · Herbalife"},{"time":265.0,"until":268.1,"text":"Herbalife · Tác già: LONG SA · NHA TAO · HiEU THÃO"},{"time":268.5,"until":274.0,"text":"tv.tuoitre.vn · Herbalife · Tác già: LONG SA · MEU THÃO · tuöi"}],"speech":[{"time":12.5,"text":"Với mong muốn được sẻ chia và mang đến niềm vui cho những hoàn cảnh khó khăn,"},{"time":17.1,"text":"một chủ quán phở ở thành phố Sa Đéc, tỉnh Đồng Tháp đã có một việc làm ý nghĩa"},{"time":22.3,"text":"là mỗi tháng dành riêng một ngày phục vụ phở không đồng cho bà con nghèo."},{"time":28.6,"text":"Hơn hai năm qua, quán phở này đã trở thành điểm đến quen thuộc của nhiều hoàn cảnh khó khăn,"},{"time":33.8,"text":"phục vụ hàng ngàn tô phở miễn phí cho bà con."},{"time":36.7,"text":"Quán phở chúng tôi đang nhắc đến có tên Cô Úc Hai Hiển ở phương 1, thành phố Sa Đéc, tỉnh Độc Tháp."},{"time":45.3,"text":"Nằm ở góc đường Lê Thị Hồng Gấm, Lê Thị Riêng, quán phở Cô Úc Hai Hiển không chỉ là điểm đến quen thuộc của nhiều thực khách ở Sa Đéc,"},{"time":53.7,"text":"mà còn là địa chỉ quen thuộc của những vị khách đặc biệt vào ngày mùng 10 âm lịch hàng tháng."},{"time":60.5,"text":"Gọi là khách đặc biệt vì mỗi tháng họ chỉ ghé ăn một lần."},{"time":65.5,"text":"Như hai mẹ con bà Mai"},{"time":67.1,"text":"Nhà ở tận huyện Trà Ôn"},{"time":69.3,"text":"Tỉnh Vĩnh Long"},{"time":70.2,"text":"Đến thành phố Sa Đéc thuê nhà trọ"},{"time":72.8,"text":"Để bán vé số mưu sinh"},{"time":74.4,"text":"Nên việc tiết kiệm cho chi tiêu hàng ngày"},{"time":76.8,"text":"Được bà đặt lên hàng đầu"},{"time":78.5,"text":"Vì thế cứ vào ngày mùng 10 hàng tháng"},{"time":81.6,"text":"Hai mẹ con bà lại đến quán"},{"time":83.7,"text":"Để được thưởng thức phở công đồng"},{"time":110.1,"text":"Ông bà ta thường nói"},{"time":111.6,"text":"Của cho không bằng cách cho"},{"time":113.5,"text":"Mặc dù là phở không đồng"},{"time":115.6,"text":"nhưng thành phần của tô phở này không khác những tô phở bán hàng ngày."},{"time":120.0,"text":"Dù là phở không đồng, chủ quán vẫn ân cần niềm nở đón khách."},{"time":124.1,"text":"Khách đến ăn được phục vụ chú đáo, miễn phí cả phở lẫn trà đá."},{"time":128.9,"text":"Cũng vì lẽ đó mà chỉ hơn nửa giờ đồng hồ,"},{"time":131.8,"text":"100 tô phở đã được tặng hết cho bà con."},{"time":147.3,"text":"Cô Út với chú Út mà có lòng hảo tâm mà cho gì rất là cảm ơn chứ nói thiệt nhiều khi tôi xin cơm từ thiện cầu cái sân ba đó,"},{"time":155.6,"text":"ăn dưới chỗ này cho cháu, chỗ kia cho này, chỗ kia cho nó, xin ăn chứ đâu có tiền đâu mua được tô phở."},{"time":161.5,"text":"Nó cũng ngon, cũng đàng hoàng, tử tế mà chú Út với cô Út này là rất là vui vẻ, tử tế lắm."},{"time":169.5,"text":"Cứ đến ngày mùng 10 âm lịch, những khách quen riết rồi cũng biết,"},{"time":173.5,"text":"Đến ngày nay, mỗi tháng họ sẽ không ghé quán mà nhường chỗ cho các vị khách đặc biệt"},{"time":179.9,"text":"Phở không đồng ở đây bắt đầu phục vụ từ 6 giờ sáng cho đến khi hết số lượng 100 tô"},{"time":186.0,"text":"Điều đặc biệt nữa là những anh chị em phục vụ của quán đến phụ trong ngày nay cũng không nhận thiện công"},{"time":193.5,"text":"Tính từ tháng 2 năm 2022 đến nay, quán đã phục vụ gần 4.000 tô phở miễn phí cho bà con"},{"time":202.2,"text":"Má chị là xuất thân từ cái nghèo khó đi lên"},{"time":205.7,"text":"Mà thương hiệu của má đã gây dựng 50 năm nay rồi"},{"time":208.2,"text":"Chị biết nói cái nghèo của má"},{"time":209.8,"text":"Mà má chị thì có tinh thần thiện nguyện rất là cao"},{"time":212.5,"text":"Lúc nào cũng đi thiện nguyện ở các nơi"},{"time":215.4,"text":"Nên chị muốn nói tiếp ý tưởng của má"},{"time":217.4,"text":"Nói tiếp cái thiện nguyện của má"},{"time":219.5,"text":"Mình thử mỗi tháng là chị tâm điểm là"},{"time":222.3,"text":"Chị sẽ cho chị em nghèo 100 phần khỏi"},{"time":226.4,"text":"Thay vì mình sẽ cho những phần quà"},{"time":228.6,"text":"Cho người nghèo như mọi người"},{"time":230.4,"text":"Nhưng mà ví dụ như chị nói em, em cầm 100 ngàn em cho người nghèo"},{"time":234.1,"text":"Chưa chắc gì người ta dám trích ra 40 ngàn người ta ăn tô phở"},{"time":236.6,"text":"Thành hữu ra chị suy nghĩ chị sẽ tặng món quà vào tô phở"},{"time":240.0,"text":"Có thịt như mọi người bình thường"},{"time":242.4,"text":"Cho người ta ăn, người ta thưởng thức được cái ngon của gia đình mình"},{"time":246.9,"text":"Với người có điều kiện thì 40 ngàn đồng cho một tô phở sẽ không là bao"},{"time":251.4,"text":"Nhưng với những người khó khăn, ăn sáng bằng một tô phở là điều xa xỉ"},{"time":256.4,"text":"Vì thế, việc tặng những tô phở không đồng đến với bà con nghèo"},{"time":261.1,"text":"Là món quà nhân văn"},{"time":262.5,"text":"Làm ấm lòng những hoàn cảnh khốn khó"},{"time":265.2,"text":"Làn tỏa nét đẹp của tình người"}]}