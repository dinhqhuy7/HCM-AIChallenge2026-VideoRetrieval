":53.1,"text":"Bây giờ chúng ta sẽ ướp gia vị vào đây"},{"time":55.2,"text":"Cho vào đây 1 phần 3 muỗng cà phê muối"},{"time":57.8,"text":"1 muỗng canh hạt nêm Azi ngon gà"},{"time":60.2,"text":"Trộn đều gia vị lên"},{"time":61.4,"text":"Và thời gian ướp gà sẽ khoảng là từ 15 cho đến 20 phút"},{"time":65.0,"text":"Ở đây chúng ta có cà chua ha"},{"time":66.6,"text":"Và cà chua này chúng ta sẽ cắt phần muối cao như thế này"},{"time":69.6,"text":"Cho phần cà chua"},{"time":71.0,"text":"Nắp rơm khi mà các bạn mua về"},{"time":72.6,"text":"Thì chúng ta sẽ bỏ cái phần góc đi"},{"time":74.5,"text":"Và rửa sơ qua nước muối"},{"time":75.7,"text":"Và chúng ta sẽ chẻ đôi"},{"time":80.5,"text":"Phần hành thây thì đúng rồi"},{"time":81.7,"text":"Chúng ta sẽ cắt muối cao để chúng ta cho vào lẩu"},{"time":85.2,"text":"Phần xả cây thì chúng ta sẽ cắt khúc để chúng ta nấu lẩu"},{"time":88.1,"text":"Mình sẽ đập nhập ra nhé"},{"time":91.5,"text":"Ơt mình cũng sẽ đập nhập luôn"},{"time":94.6,"text":"Còn phần thi la thì chúng ta sẽ cắt cút để làm rau nêm cho phần lẩu"},{"time":98.6,"text":"Và bây giờ thì tất cả nguyên liệu rau cũ chúng ta cũng đã sơ chế xong"},{"time":102.0,"text":"Và tiếp theo Phúc Hương sẽ đặt lên trên bếp một cái chảo dầu để chúng ta chiên khoai môn"},{"time":105.5,"text":"Và khoai môn thì rất là tốt đối với những ai bị bệnh tiểu đường"},{"time":110.0,"text":"Bởi vì nó sẽ giúp cho chúng ta kiểm soát đường huyết được tốt hơn"},{"time":112.6,"text":"Rau muống mình cũng sẽ rửa sạch và cắt cút"},{"time":114.7,"text":"Nấm kim châm thì mình sẽ bỏ cái phần chân nấm đi và cũng sẽ bắp nhỏ ra"},{"time":118.5,"text":"Còn ở vùng bông bí này thì chúng ta sẽ bỏ các phần vị và rửa sạch nhé"},{"time":122.4,"text":"Và bây giờ tiếp theo thì Phước Hưng sẽ đặt lên trên bếp một cái nồi"},{"time":125.6,"text":"Để chúng ta xào cái phần gà cho thật là săn để chúng ta nấu lẩu"},{"time":128.8,"text":"Đối với món ăn ngày hôm nay thì chúng ta sẽ chiêm khoai môn trước"},{"time":131.8,"text":"Làm như vậy thì giúp cho khoai môn thơm ngon khi nấu lẩu khoai sẽ không bị nát"},{"time":136.1,"text":"Và bây giờ phần nồi bên đây của Phước Hưng cũng đã nóng rồi"},{"time":138.7,"text":"Hưng sẽ cho vào đây khoảng 2 muỗng canh dầu ăn"},{"time":140.7,"text":"Cho tỏi băm vào chúng ta phi thơm"},{"time":142.8,"text":"Và phần tỏi cũng đã chuyển sang bào giàn nhẹ rồi"},{"time":145.4,"text":"Phước Hưng sẽ cho vào đây 3 muỗng canh tương ớt nè"},{"time":148.1,"text":"Và 2 muỗng canh cà chua cô đặc"},{"time":149.8,"text":"Xào đều cái hỗn hợp này lên"},{"time":152.0,"text":"Thanh Phương cho giúp giùm Hưng cái phần xả cây đập dập"},{"time":154.5,"text":"2 trái ớt hiểm đập dập chúng ta vào đây xào thơm luôn"},{"time":157.2,"text":"Rồi"},{"time":158.3,"text":"Bây giờ đã dậy lên cái mùi rất là thơm rồi"},{"time":160.8,"text":"Tiếp tục Phước Hưng sẽ cho cái phần gà vào chúng ta xào xăng"},{"time":163.9,"text":"Đối với món ăn ngày hôm nay thì Phước Hưng xào gà với tương ớt và cà chua cô đặc"},{"time":168.1,"text":"Làm như vậy giúp cho thịt gà thấm vị chua cay khi ăn sẽ thơm ngon hơn"},{"time":171.7,"text":"Khoai cũng đã bắt đầu vàng giòn rồi"},{"time":174.4,"text":"Phương sẽ dớt ra nhé"},{"time":178.3,"text":"Bây giờ thì phần thịt gà cũng đã săn thơm ngon rồi"},{"time":181.1,"text":"Phương sẽ cho vào đây 1 lít 2 nước để chúng ta nấu lẩu"},{"time":183.9,"text":"Thịt gà có chứa protein cũng giống như thịt bò và thịt heo"},{"time":187.2,"text":"Thế nhưng lại có ít chất béo hơn"},{"time":189.0,"text":"Vì vậy rất là tốt cho sức khỏe"},{"time":190.7,"text":"Phương sẽ nêm vào đây 1 muỗng rưỡi canh đường"},{"time":194.8,"text":"Nửa muỗng canh hạt nêm Ajinomoto"},{"time":196.9,"text":"Một phần 3 muỗng cà phê bột ngọt Ajinomoto"},{"time":199.9,"text":"3 muỗng canh giấm gạo lên men Ajinomoto"},{"time":204.8,"text":"Và cuối cùng Phước Hưng sẽ cho vào đây 1 muỗng canh nước mắm"},{"time":208.3,"text":"Sẽ vớt bọt nha"},{"time":211.7,"text":"Cho phần khoai môn vào để cho khoai được chín mềm"},{"time":214.7,"text":"Tiếp tục Phước Hưng sẽ cho cà chua nè, nấm rơm và hành tây vào luôn"},{"time":218.4,"text":"Thì chúng ta sẽ cho lửa lớn sôi lại 1 lần nữa"},{"time":221.4,"text":"Và các bạn có thể quét bả QR đang hiện tiện trên màn hình để tìm hiểu kỹ hơn về công thức món ăn"},{"time":226.4,"text":"Bây giờ thì phần nước lẩu cũng đã sôi trở lại rồi"},{"time":229.1,"text":"Phước Hưng tắt bếp nè, vậy là đã xong"},{"time":234.2,"text":"Wow, nồi lẩu cực kỳ hấp dẫn luôn các bạn ơi"},{"time":237.2,"text":"Và nguyên liệu thì vừa được chín tới"},{"time":239.9,"text":"Nên vẫn giữ được cái độ giòn ngọt"},{"time":242.0,"text":"Và giá trị dinh dưỡng cho món ăn"},{"time":245.1,"text":"Nghe cái mùi thơm và đói mụn rồi đó Phước Hân"},{"time":246.8,"text":"Đúng rồi, khi ăn thì chúng ta lại nhúng rất là nhiều rau củ nữa"},{"time":250.6,"text":"Cho lên đây một ít thị là"},{"time":252.3,"text":"Để tăng thêm hương vị"},{"time":253.8,"text":"Cũng như là màu sắc cho món lẩu"},{"time":255.4,"text":"Khi ăn thì chúng ta kết hợp với bún tươi"},{"time":257.8,"text":"Và tất cả các loại rau tươi"},{"time":259.6,"text":"Sẽ cho ra một cái bữa ăn đầy dinh dưỡng luôn"},{"time":261.6,"text":"Như vậy là đã hoàn thành rồi"},{"time":263.8,"text":"Gà chín mềm, thấm đậm gia vị"},{"time":277.3,"text":"vừa ăn, món lẩu gà chua cây"},{"time":279.4,"text":"vừa giàu protein, vitamin"},{"time":281.0,"text":"và các loại khoáng chất. Các bạn nhớ"},{"time":283.2,"text":"thực hiện ngay nhé. Và ngoài ra nếu tìm hiểu"},{"time":285.4,"text":"kỹ về các món ăn ngon thì các bạn nhớ"},{"time":287.1,"text":"truy cập vào kênh youtube, website và"},{"time":289.1,"text":"fanpage của chương trình Món Con Mỗi Ngày"},{"time":290.8,"text":"Còn bây giờ xin được mến chào tạm biệt. Hẹn gặp lại"},{"time":293.1,"text":"quý vị và các bạn trong những chương trình lần sau"}]}