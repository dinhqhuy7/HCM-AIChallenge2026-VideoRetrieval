xoài xoài chúng ta sẽ giòn hơn, thấm vị hơn"},{"time":99.4,"text":"Và sẽ không bị chảy nước sau khi chúng ta trộn"},{"time":101.9,"text":"Thưa các bạn, phần tôm thì chúng ta lựa con khoảng độ 30-40 con 1 kg"},{"time":107.3,"text":"Lọt bỏ vỏ, lấy chỉ lưng, bỏ đầu"},{"time":110.0,"text":"Chừa lại phần đuôi xíu và nhớ bỏ phần đuôi nhọn"},{"time":113.4,"text":"Chúng ta cho vào trong tôm"},{"time":115.5,"text":"Chúng ta cho vào đây ớt, ớt xìu nhỏ các bạn"},{"time":118.1,"text":"Xả băm"},{"time":120.3,"text":"cho vào đây một ít muối cho vừa ăn"},{"time":122.8,"text":"rồi, chúng ta cũng trộn đều lên như vầy"},{"time":126.8,"text":"bây giờ thì chúng ta sẽ xiên"},{"time":128.6,"text":"những con tôm vào trong cây xả"},{"time":130.8,"text":"chúng ta dùng chiếc đũa"},{"time":132.1,"text":"có mũi nhọn như vầy, cây que"},{"time":133.8,"text":"chúng ta xiên lên như vầy trước, lấy dấu trước"},{"time":136.2,"text":"sau đó xiên cây xả qua"},{"time":138.6,"text":"à, cho nó dễ"},{"time":140.4,"text":"rồi chúng ta để như vầy"},{"time":142.2,"text":"thức bạn chúng ta nên xiên tôm trước"},{"time":144.0,"text":"bằng cây xiên hoặc đũa nhọn, sau đó xiên bằng xả"},{"time":146.3,"text":"như vầy sẽ dễ xiên hơn rất là nhiều"},{"time":147.9,"text":"chúng ta bắt ở đây một cái chảo"},{"time":154.7,"text":"Để chúng ta chiên tôm"},{"time":156.0,"text":"Cho đều ít dầu"},{"time":162.3,"text":"Rồi chúng ta chiên xíu"},{"time":165.6,"text":"Quá là thơm"},{"time":166.5,"text":"Đây là một món ăn mà tôi thấy là đây có tôm"},{"time":169.2,"text":"Thì trong tôm mình biết là cũng có rất là nhiều"},{"time":171.5,"text":"Những cái chất dinh dưỡng và đặc biệt trong đây là chất đạm"},{"time":173.8,"text":"Bên cạnh đó thì tôm còn có"},{"time":175.6,"text":"Chứa rất là nhiều omega 3"},{"time":177.8,"text":"Thưa các bạn bây giờ chúng ta sẽ đốt rượu"},{"time":182.6,"text":"Thưa các bạn chúng ta đốt rượu brandy"},{"time":184.7,"text":"Sau khi áp chảo tôm"},{"time":186.2,"text":"Để cho món chúng ta có một vị đặc trưng"},{"time":188.5,"text":"Sau khi chúng ta để rượu cháy hoàn toàn"},{"time":190.7,"text":"Chúng ta sẽ chúp tôm ra dĩa"},{"time":195.6,"text":"Làm sao mà kềm lòng được chứa con tôm này đúng không ạ"},{"time":198.9,"text":"Ngay bây giờ có một mã QR hiển thị trên màn hình"},{"time":201.7,"text":"Dành cho quý vị nào mà chúng ta chưa xem kịp"},{"time":203.7,"text":"Hãy quét mã này chúng ta sẽ ngay lập tức có công thức của món ăn này"},{"time":206.7,"text":"Để thực hiện tại nhà các bạn nha"},{"time":209.9,"text":"Và thưa các bạn đây là những cái sợi xoài"},{"time":212.2,"text":"Chúng ta đã ướp với lại ít đường và giữ lạnh"},{"time":214.2,"text":"Chúng ta sẽ cho vào từng ly"},{"time":221.2,"text":"Mỗi ly chúng ta cho đây khoảng chừng nửa muỗng canh"},{"time":223.5,"text":"Sop Millionaire Aji Mayo vị nguyên bản"},{"time":226.1,"text":"Và chúng ta tiếp tục cốp bên này tương cà"},{"time":229.3,"text":"Hẳn một muỗng cà phê"},{"time":231.5,"text":"Húng lũi chúng ta cắt nhỏ ra"},{"time":233.9,"text":"Một con tôm"},{"time":235.5,"text":"Hai con tôm"},{"time":237.6,"text":"Ớt sắc chỉ"},{"time":238.6,"text":"Và cuối cùng chúng ta rắc mè trắng lên"},{"time":241.0,"text":"Thưa các bạn đây là một món"},{"time":243.5,"text":"Au fusion"},{"time":244.3,"text":"Một món au và đại tạo với món Việt"},{"time":247.7,"text":"Thì chúng ta có thể ăn cùng với lại"},{"time":249.7,"text":"Một món bò biscuit"},{"time":250.5,"text":"Cũng rất là học kỹ luôn"},{"time":252.2,"text":"Đây là một cái món starter"},{"time":254.0,"text":"Và nó là một cái món mà theo dạng salad"},{"time":257.1,"text":"Cho nên là chúng ta có thể kết hợp rất là nhiều kiểu ăn khác nhau"},{"time":260.5,"text":"Thậm chí cho một cái bữa cơm gia đình mình cũng có thể dùng nó đúng không anh?"},{"time":263.7,"text":"Đúng"},{"time":263.8,"text":"Để mình bắt đầu bữa cơm của mình luôn"},{"time":264.9,"text":"Đúng"},{"time":265.3,"text":"Đó, rất là ngon, rất là hấp dẫn"},{"time":267.3,"text":"Mà vô cùng phù hợp để mà đải tiệt việc chuẩn bị cũng rất nhanh"},{"time":270.5,"text":"Cảm ơn anh Vũ rất nhiều vì đã mang đến một món ăn rất đẹp mắt và cũng cực kỳ ngon miệng"},{"time":275.3,"text":"Sợi xoài giòn, chua chua, ngọt ngọt, thơm nhẹ nhẹ"},{"time":279.5,"text":"Hòa cùng tôm áp chảo thơm nứt"},{"time":282.0,"text":"Bung tỏa trong khoang miệng"},{"time":283.6,"text":"Một hương vị khó quên"},{"time":287.5,"text":"Không cần phải làm nhiều món khai vị một cách cầu kỳ"},{"time":290.5,"text":"Chỉ cần món khai vị phải chất"},{"time":292.5,"text":"Và nếu như tất cả các bạn cần một món khai vị chất như thế"},{"time":295.5,"text":"Hãy làm món ăn của ngày hôm nay gỏi xoài tôm xả"},{"time":298.1,"text":"Công thức luôn có sẵn trên Youtube, Website và Fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":303.1,"text":"Truy cập vào, lấy công thức và thực hiện ngay tại nhà nha"},{"time":305.5,"text":"Chúc các bạn sẽ có một bữa ăn ngon cùng với lại món ngon mỗi ngày"}]}