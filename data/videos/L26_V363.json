text":"Và bây giờ tiếp theo Phương Hương sẽ hướng dẫn cho quý vị chúng ta pha cái hỗn hợp trà sữa"},{"time":110.2,"text":"Ừ"},{"time":110.5,"text":"Ở đây Phương Hương đã chuẩn bị sẵn 2 gói Pro Your Blendy"},{"time":113.4,"text":"Chúng ta sẽ pha với 40ml nước ấm"},{"time":116.4,"text":"Ủa"},{"time":116.8,"text":"Bình thường định lượng của nó là 1 gói trà và 70ml nước"},{"time":121.3,"text":"Ừ"},{"time":121.7,"text":"Mà hôm nay 2 gói chúng ta chỉ dùng có 40ml nước thôi"},{"time":124.1,"text":"Đúng rồi, đối với món nước ngày hôm nay thì chúng ta sẽ giảm định lượng nước để chúng ta có thể pha với nhiều nguyên liệu khác"},{"time":129.8,"text":"Chúng ta sẽ cho vào đây 2 gói"},{"time":132.5,"text":"Rồi"},{"time":132.9,"text":"Và bây giờ chúng ta sẽ cho 40ml nước ấm vào"},{"time":141.6,"text":"Chúng ta sẽ khuấy tan"},{"time":147.0,"text":"Rồi"},{"time":147.4,"text":"Và chúng ta để đây"},{"time":148.7,"text":"Rồi ở đây Phước Hưng đã chuẩn bị sẵn một cái máy xay sinh tố"},{"time":151.6,"text":"Hưng sẽ cho phần bánh cookie vị bạc hà vào nè"},{"time":154.2,"text":"Sử dụng bánh cookie vị bạc hà sẽ giúp cho món nước có vị the mát hơn"},{"time":158.8,"text":"Vậy là bây giờ Hakuta đã biết tại sao món nước này lại có vị the mát như vậy"},{"time":163.0,"text":"Biết quyết chính là cookie sô-cô-la bạc hà"},{"time":166.9,"text":"Thần nước cốt trà sữa vào"},{"time":168.6,"text":"Rồi"},{"time":169.4,"text":"Và Hưng sẽ cho vào đây 50ml whipping cream"},{"time":172.5,"text":"Cho vào đây 180g nước lá"},{"time":174.4,"text":"Và bây giờ chúng ta sẽ đậy lại"},{"time":185.4,"text":"Ở đây thì Phước Hưng cũng đã chuẩn bị sẵn một cái ly mà Phước Hưng cũng đã giữ lạnh rồi"},{"time":189.9,"text":"Và đây cũng là một cái lưu ý cho quý vị khán giả nha"},{"time":192.0,"text":"Chúng ta sẽ giữ lạnh ly trước khi mà chúng ta cho trà sữa vào"},{"time":195.1,"text":"Làm như vậy thì giúp cho trà sữa giữ được nhiệt lâu hơn"},{"time":206.8,"text":"Bây giờ thì món nước của chúng ta đã xong"},{"time":208.5,"text":"Bây giờ Phước Hưng sang bên đây để chúng ta topping lên trên phần nước"},{"time":213.1,"text":"Và bây giờ Phước Hưng sẽ topping whipping cream lên trên"},{"time":219.2,"text":"Hưng sẽ trang trí thêm bánh nữa nè"},{"time":223.3,"text":"Hưng cho lên đây một ít đọt bạc hà để tăng thêm màu xanh cho món nước"},{"time":227.2,"text":"Và bây giờ cuối cùng Phước Hưng sẽ cho lên đây một ít bánh cookie mà chúng ta giả vụn lên"},{"time":236.2,"text":"Chỉ cần mất có vài phút thôi mà bây giờ đã cho ra một cái món nước thật là hoàn hảo luôn"},{"time":240.9,"text":"Đã có một món nước rất là thơm ngon như thế này phù hợp cho ngày sinh nhật của mình trong tháng 3 nè"},{"time":245.6,"text":"Ngày quốc tế hạnh phúc nè"},{"time":246.8,"text":"Vậy thì còn hạnh phúc hơn nữa nếu như kết hợp được một món bánh nào đó thật là tuyệt vời"},{"time":250.9,"text":"Các bạn có thể kết hợp với bánh rán thông thường như vậy cũng được"},{"time":254.7,"text":"Hoặc là banh két thanh long đỏ cũng rất là tuyệt vời"},{"time":257.8,"text":"Ly trà sữa mát lạnh, ngọt ngào vị trà sữa, hòa lẫn chút béo béo của kem sữa"},{"time":263.4,"text":"Thơm thơm the mát từ bánh cookie bạc hà"},{"time":266.0,"text":"Tất cả quyện đều vào nhau thơm ngon mát lạnh tới giọt cuối cùng"},{"time":270.1,"text":"Trời tháng 3 có nắng nóng thì các bạn ơi đừng lo"},{"time":272.5,"text":"Đã có những món ngon tươi mát từ chương trình rồi đó nha"},{"time":275.1,"text":"Để xem lại công thức món ăn ngon"},{"time":277.1,"text":"Hoặc các thông tin bổ ích"},{"time":278.0,"text":"Các bạn hãy truy cập vào Youtube, Website và Fanpage"},{"time":281.2,"text":"Của chương trình"},{"time":281.9,"text":"Còn ngay bây giờ thì Hakuta cùng Phước Hưng"},{"time":283.8,"text":"Xin chào và hẹn gặp lại"}]}