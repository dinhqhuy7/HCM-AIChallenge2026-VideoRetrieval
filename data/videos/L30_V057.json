until":124.2,"text":"STAT · KENT · UNIVER · KEST"},{"time":156.9,"until":162.6,"text":"tuöitréV"},{"time":173.8,"until":186.5,"text":"STATE · KENT · UNIVER · Tác gi: Minh Hưng · Herbalife · UNIVERSTY · KEIT · KEST"}],"speech":[{"time":12.5,"text":"Đây là bộ môn nghệ thuật gọi là Điêu Khắc Ánh Sáng"},{"time":15.7,"text":"Minh Hưng cho biết chúng xuất phát từ Nhật Bản"},{"time":18.5,"text":"Ban đầu khi vừa học xong ngành Marketing tại một trường đại học ở Cần Thơ"},{"time":22.5,"text":"Trong lúc rảnh rỗi, Hưng tình cờ xem được các clip giới thiệu về bộ môn nghệ thuật này trên mạng"},{"time":28.7,"text":"Thời gian rảnh rỗi ở nhà, chàng trai ngồi xé thùng bìa các tông"},{"time":32.9,"text":"Loay hoay các tạo hình chân dung các nhân vật nổi tiếng"},{"time":37.8,"text":"Bộ môn này có tên là Điêu Khắc Ánh Sáng"},{"time":40.0,"text":"Tại vì chủ yếu là chúng ta sẽ điêu khắc một cái mô hình tác phẩm"},{"time":44.3,"text":"Mà cho nó thật tỉ mỉ, nó ra nét"},{"time":46.3,"text":"Để mà khi chúng ta chiếu ánh sáng vào"},{"time":48.2,"text":"Nó sẽ ra một hình chân dung"},{"time":50.0,"text":"Hình chân dung người hay là hình phong cảnh"},{"time":52.6,"text":"Theo ý chúng ta muốn"},{"time":53.8,"text":"Bộ môn điêu khắc ánh sáng này thì cũng có nhiều lựa chọn để mình sử dụng chất liệu"},{"time":58.1,"text":"Giống như là chúng ta sử dụng chất liệu giấy thùng cài tông"},{"time":61.4,"text":"Hay là vỏ nhựa, vỏ gỗ hay là ván ép"},{"time":65.0,"text":"Còn riêng bản thân em thì em chọn giấy bia cài tông"},{"time":68.2,"text":"Tại vì với biệt kệ tông em sẽ tạo ra một cái tác phẩm rất là dễ và có thể nói là đưa ra một cái hình ảnh đẹp nhất có thể."},{"time":77.5,"text":"Theo Hưng, muốn có một bức chân dung bằng nghệ thuật điêu khắc ánh sáng phải qua nhiều bước."},{"time":82.8,"text":"Đầu tiên phải hình dung trong đầu các đường nét cơ bản của gương mặt qua hai màu trắng đen."},{"time":88.1,"text":"Những đường nét chính tạo ra gương mặt trên ảnh chân dung."},{"time":91.1,"text":"Sau đó chúng ta vẽ lại và xé giấy làm thẳng lên mô hình."},{"time":97.4,"text":"Cái khâu khó nhất có lẽ là cái khâu dựng hình ảnh từ trên những cái thùng như thế này"},{"time":101.5,"text":"Tại vì chúng ta sẽ phải xé giấy cho nó ra nét rất là khó"},{"time":106.0,"text":"Và sự tỉ mỉ, đòi hỏi tính tỉ mỉ và cận trọng rất là cao"},{"time":109.8,"text":"Bởi vì chỉ cần một nét mà chúng ta xê dịch một tí thôi"},{"time":112.8,"text":"Thì cái hình ảnh chúng ta cho ra sẽ hoàn toàn khác như là dự tính ban đầu"},{"time":117.8,"text":"Quá trình chế tác các bức hình chân dung được Minh Hưng quay lại và chia sẻ lên TikTok"},{"time":122.8,"text":"Dựng được rất nhiều lượt xem, nhiều bình luận khen ngợi sự sáng tạo"},{"time":126.7,"text":"Nhiều bạn còn cho biết những clip của Hưng đã tạo cảm hứng, khơi gợi sáng tạo cho giới trẻ"},{"time":134.3,"text":"Bởi vì ấn tượng của bộ môn nghệ thuật chiếu bóng này đối với em nó thật sự rất thu hút"},{"time":138.4,"text":"Điểm thu hút nhiều nhất mà em thích đó chính là mình có thể tạo ra một cái hình ảnh"},{"time":142.7,"text":"Một con người hoàn chỉnh thông qua một cái bóng được chiếu trên tường"},{"time":146.3,"text":"Mà khi nhìn vào tác phẩm chúng ta không thể nào hành dung ra được là nó là cái gì"},{"time":151.1,"text":"Nhưng mà khi chúng ta chiếu bóng lên nó sẽ hiện nguyên một bức tranh hoàn chỉnh"},{"time":159.6,"text":"Các mô hình thường được Hưng dành thời gian từ 1 đến 2 ngày để hoàn thiện"},{"time":163.6,"text":"Theo chàng trai này, việc này đòi hỏi sự tỉ mỉ, kiên nhẫn và chính xác đến từng chi tiết"},{"time":170.1,"text":"Về lâu dài, Minh Hưng cho biết đang dự định làm thêm các loại hình tranh phong cảnh"},{"time":174.8,"text":"Làm mô hình bằng các thanh vỗ lũa, nguyên khối"},{"time":177.5,"text":"Nếu làm thành công, sản phẩm sẽ có giá trị cao hơn, bảo quản được lâu hơn"}]}