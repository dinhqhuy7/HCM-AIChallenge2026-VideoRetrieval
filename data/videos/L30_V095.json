ext":"CF-35"},{"time":164.4,"until":166.9,"text":"FUJICA · AX3"},{"time":167.3,"until":171.0,"text":"Qun 6, TP.HCM · 6,TP.HCM · ColorPlus · TRÄN HIÊU THINH"},{"time":181.4,"until":183.7,"text":"ColorPlus"},{"time":184.0,"until":188.6,"text":"tuoitrey"},{"time":189.9,"until":192.0,"text":"ColorPlus · POMAPAN"},{"time":199.3,"until":200.4,"text":"ColorPlus"},{"time":205.5,"until":207.3,"text":"axell"},{"time":207.5,"until":212.5,"text":"Qun Bình Tân, TP.HCM · TRÄN DÚC LUONG · NDUO · Lian Binh Tan · NDUCONG · NDUC · uan B"},{"time":213.9,"until":218.6,"text":"OLYMPUS · BMW"},{"time":218.8,"until":222.3,"text":"minolfa · minofo · iol"},{"time":222.5,"until":226.0,"text":"BMW · RMW · minola · aMW · CLC · 101 · SR ol · cre"},{"time":226.2,"until":229.2,"text":"minolta"},{"time":229.9,"until":232.0,"text":"BMW · tuöitreV"},{"time":245.7,"until":248.8,"text":"tuoitre"},{"time":251.6,"until":256.7,"text":"Qun 6, TP.HCM · 6,TP.HCM · ColorPlus · NEU THINH · TRAL · TRÄN HIÊU THINH"},{"time":261.8,"until":264.3,"text":"tuoitre"},{"time":264.5,"until":289.0,"text":"ColorPlus"},{"time":289.2,"until":296.8,"text":"Kenko · Headway · Herbalife · RICOH · MYPORT · 310SF · Tác già: HIU TH!NH · Kenko MC FILTER · KTRA · In I inhamp ing"},{"time":297.0,"until":300.9,"text":"Herbalife · Tác già: HIU TH!NH"},{"time":301.1,"until":309.2,"text":"tv.tuoitre.vn · Herbalife · tuoitre · Tác gia: HiEU THINH · CobrPus · AtreTV · CoborPlus · Coboils"}],"speech":[{"time":22.7,"text":"Mình có cái duyên là hợp buôn bán với thằng em học chung"},{"time":27.9,"text":"Hai anh em mình học xong cái gai trà nhật tảo"},{"time":31.2,"text":"Cái lựa mấy ảnh cũ rồi về sửa chữa"},{"time":35.6,"text":"Sửa chữa rồi đăng bán thẳng lên Shopee luôn"},{"time":37.8,"text":"Rồi vô tình mình mua một con máng 110 nghìn"},{"time":41.7,"text":"Mình bán ra là 900 nghìn"},{"time":43.5,"text":"Sau này mình cũng có đi mua nhiều hơn"},{"time":47.4,"text":"Rồi mình cũng bán nhiều hơn"},{"time":48.6,"text":"Hai anh em quyết định kiếm một cái chỗ"},{"time":51.2,"text":"Để làm chung, quản lý chung, chia sẻ công việc, quản lý máy ảnh dễ dàng hơn"},{"time":58.8,"text":"Lúc mà mở cái tiệm này thì tổng nguồn giống của mình là 50 triệu về chi phí nhập máy"},{"time":66.1,"text":"Cái đó là từ tích góp tiền tiết kiệm 2 anh em"},{"time":68.9,"text":"Bây giờ thì 2 anh em cũng đi vay mượn và nhập máy"},{"time":72.8,"text":"Bây giờ cũng lên tổng cộng lên đến 160 triệu"},{"time":75.8,"text":"May mắn thì mở ra tiệm này cũng gặp được nhiều cô chú buôn đưa ra cái giá để hỗ trợ buôn bán"},{"time":99.0,"text":"Trong cái tình khởi nghiệp của mình may mắn nhất chính là gặp được ân nhân"},{"time":102.0,"text":"Chúng là người thầy hướng dẫn mình trong cái con đường sự nghiệp này"},{"time":106.6,"text":"Chú chỉ cách đầu tiên là nhận biết máy"},{"time":110.2,"text":"Máy nào mới xịn, máy nào mới dở, máy nào không nên nhận"},{"time":113.3,"text":"Thì đầu tiên là sửa chữa những cái linh tinh lập tật"},{"time":116.6,"text":"Những cái kiến thức ví dụ là vì sao lọt sáng cái phần này"},{"time":119.9,"text":"Vì sao cái phần này thì là như vậy"},{"time":122.4,"text":"Như kia thì chú sẽ tự tình hướng dẫn mình từng bước từng bước chứ không mà đi nhanh được"},{"time":126.5,"text":"Tại vì máy phim này rất là lâu đời rồi"},{"time":128.7,"text":"Mình chủ yếu sửa bằng cái chất xám"},{"time":131.0,"text":"Một số dòng máy bên mình thì có là Minanta, Canon, Nikon, Ricoh với lại là Konica"},{"time":139.0,"text":"Thì đa số mình sẽ bán dựa trên nhu cầu thị trường"},{"time":144.0,"text":"Thì nhu cầu thị trường sẽ hướng theo máy sắt thì mình nhập những máy sắt nhiều hơn"},{"time":147.8,"text":"Như cầu thị trường phim nào thế kia là tùy theo nhu cầu thị trường mình sẽ nhập máy"},{"time":171.0,"text":"Số lượng nó chỉ có một, giới hạn rất giới hạn"},{"time":173.9,"text":"Trên dưới 200 đầu máy bao gồm máy ảnh Pone & Shoot, chụp ăn liền"},{"time":178.9,"text":"Máy ảnh bán cơ RF, Rainfader, máy ảnh SLR, Single Lens Relax"},{"time":185.3,"text":"Nhiên đại vô thông là từ 1980 đến 1990"},{"time":188.0,"text":"Tại mình chọn điện đại này tại vì số lượng máy nó an toàn về chất lượng bên trong"},{"time":194.0,"text":"Kỹ thuật thời đại đó cũng hơi tiên tiến hơn"},{"time":196.8,"text":"Cho nên là đảm bảo lỗi sai sót, lỗi kỹ thuật bên trong máy nó hạn chế"},{"time":207.2,"text":"Khi mà mình nhận máy về thì mình có thể sửa chữa được dòng máy cơ"},{"time":211.3,"text":"Hoặc là bán cơ, hoặc là máy bòi sốt mà dạng lại, sửa chữa lại nhẹ nhàng"},{"time":218.6,"text":"Tại vì máy đó là điện tử hay là nhiều khi hư mặt là hư nguyên công máy"},{"time":222.6,"text":"Mình không thể làm gì thêm"},{"time":224.4,"text":"Mình chủ yếu sửa chữa là mấy ảnh bán cơ"},{"time":227.3,"text":"Hoặc là cơ là chủ yếu"},{"time":229.1,"text":"Với lại về sinh lên"},{"time":230.7,"text":"Sửa chữa ví dụ là kẹt cò, kẹt mài chập"},{"time":233.2,"text":"Hoặc là chỉnh tốc độ"},{"time":234.3,"text":"Hay là mấy cái linh ta linh tinh"},{"time":237.4,"text":"Về phần cơ"},{"time":238.4,"text":"Còn phần điện thì mình sẽ không chắc là hoạt động được bình thường"},{"time":248.7,"text":"Cứ bán được 5 máy"},{"time":250.1,"text":"Là đủ tiền trả chi phí một bằng"},{"time":251.5,"text":"Cái nỗi lo của tụi mình chỉ là chi phí một bằng thôi"},{"time":254.5,"text":"Tụi mình trụ được qua 3 tháng"},{"time":256.1,"text":"4 tháng, doanh thu ổn ổn"},{"time":257.9,"text":"tụi mình lại tái đầu tư, nhập thêm cái nguồn hàng mới về"},{"time":260.2,"text":"rồi cứ tiếp tục xây vốn xây vốn vậy"},{"time":262.6,"text":"với một số bạn thì gặp rất nhiều khó khăn về kinh phí"},{"time":266.3,"text":"cũng như là về chuyên môn"},{"time":269.0,"text":"các bạn bị hạn chế về cái việc mua chiếc mảnh phim"},{"time":272.2,"text":"và sở hữu riêng cho mình"},{"time":273.3,"text":"cũng như là sưu tầm những chiếc mảnh phim khác"},{"time":275.4,"text":"thì riêng mình thì mình cảm thấy rất là may mắn"},{"time":278.2,"text":"khi mình có cơ duyên buôn bán"},{"time":280.4,"text":"cũng như là chuyên môn kinh doanh"},{"time":283.2,"text":"nên là mình có thể trải nghiệm được rất nhiều máy ảnh"},{"time":287.0,"text":"và nuôi dưỡng được cái đam mê của mình"}]}