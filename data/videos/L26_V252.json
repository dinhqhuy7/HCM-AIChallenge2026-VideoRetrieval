t":"Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày"},{"time":73.5,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":77.4,"text":"Đầu tiên là chúng ta sẽ pha trà sữa dâu Blandi"},{"time":80.6,"text":"Mình sẽ cho vào đây 4 gói"},{"time":84.9,"text":"Rồi, cùng với 50ml nước nóng"},{"time":87.2,"text":"Thì mình pha như thế này nó sẽ hơi đặc một chút"},{"time":89.8,"text":"Mình sẽ khuấy tan và cho trà sữa này nguội"},{"time":93.0,"text":"Chúng ta có 150ml whipping thì mình sẽ cho vào đây 100ml whipping mình đánh nổi thôi"},{"time":98.4,"text":"Còn 50ml thì mình sẽ chừa lại để mình xay chung với lại cái phần sinh tố"},{"time":103.3,"text":"Khi đánh whipping thì các bạn lưu ý là chúng ta sẽ giữ lạnh whipping trước"},{"time":107.1,"text":"Hoặc là ngâm cái thố đánh vào trong cái thao đá lạnh để whipping sẽ được nhanh bông hơn nha"},{"time":112.3,"text":"Và chúng ta vừa đánh whipping chúng ta sẽ vừa cho thêm 20g đường vô"},{"time":116.0,"text":"Rồi mình sẽ tăng thêm một chút xíu độ ngọt nữa trong whipping nha em"},{"time":118.9,"text":"Dạ"},{"time":124.2,"text":"Rồi em sẽ thấy nè"},{"time":125.2,"text":"Đây là phần whipping mà nó đã nổi bông đứng lên nè"},{"time":127.8,"text":"Thấy không? Nó sẽ không chảy ra nữa"},{"time":129.5,"text":"Mình lấy ra mà nó không chảy nữa"},{"time":131.0,"text":"Là ok cô ha"},{"time":132.9,"text":"Chúng ta sẽ đem phần whipping này cho vào túi bắp bông kem"},{"time":135.7,"text":"Và mình giữ trong tủ mát"},{"time":136.7,"text":"Cô nhờ tôi một chút bẻ mấy cái bánh này ra dùm cô"},{"time":140.0,"text":"Nhưng mà màu đỏ theo màu đỏ"},{"time":141.4,"text":"Màu đen theo màu đen nha"},{"time":142.3,"text":"Tại sao ở đây là bánh quy kem cô lại chọn 2 màu khác nhau"},{"time":145.3,"text":"Chắc là phải có ý đồ gì đấy"},{"time":146.7,"text":"Đó hồi nãy cô nói là làm 3 tầng đó"},{"time":149.6,"text":"Các bạn lưu ý là chúng ta sẽ dùng"},{"time":151.9,"text":"2 màu bánh quy kem khác nhau"},{"time":153.6,"text":"Để món nước có màu sắc đẹp"},{"time":155.3,"text":"Hấp dẫn hơn nha"},{"time":157.6,"text":"Xong, bây giờ màu đỏ cô cần trước đúng không"},{"time":159.5,"text":"Đúng rồi"},{"time":160.8,"text":"Bây giờ thì chúng ta sẽ sử dụng"},{"time":163.0,"text":"Máy xay xương tố"},{"time":163.9,"text":"Đầu tiên thì chúng ta sẽ cho 1 nửa lượng trà sữa dâu blendi vô"},{"time":169.4,"text":"1 nửa lượng whipping còn lại"},{"time":171.2,"text":"Khoảng là 25ml"},{"time":172.4,"text":"1 nửa sữa tươi không đường"},{"time":174.2,"text":"Khoảng 50ml"},{"time":176.0,"text":"Cảm ơn Tướng"},{"time":177.1,"text":"Công sức mồ hôi của em trong đó đó cô"},{"time":179.0,"text":"Nhưng mà hình như cảm giác là nó nhẹ hơn hồi nãy khi cô đưa qua"},{"time":182.2,"text":"Mất có một miếng thôi"},{"time":183.3,"text":"Thấy không? Cô biết mất mà"},{"time":184.8,"text":"Tiếp tục thì chúng ta sẽ cho bánh quy kem màu đỏ vô đây"},{"time":187.9,"text":"Rồi"},{"time":188.5,"text":"Và một ít đá xay"},{"time":190.1,"text":"Cô sẽ xay màu đỏ trước"},{"time":191.5,"text":"Vì một chút nữa mình xay màu đen thì nó không sao"},{"time":194.1,"text":"Chứ mình đừng có xay ngược lại màu đen nó lên ra màu đỏ"},{"time":196.8,"text":"À"},{"time":198.4,"text":"Quả là cao nhân"},{"time":200.4,"text":"Rồi"},{"time":200.8,"text":"Và bây giờ cô sẽ lót ra hai ly"},{"time":203.8,"text":"Rồi"},{"time":204.6,"text":"Tiếp theo"},{"time":206.1,"text":"Rồi"},{"time":206.5,"text":"Mình bắt một cái lớp kem whipping cream của mình lên ha"},{"time":209.0,"text":"Cái mà nãy mình đã đánh"},{"time":210.1,"text":"Đúng rồi"},{"time":210.7,"text":"Và cho vào tủ mát"},{"time":211.8,"text":"Sau khi mà đã bắt phần whipping cream"},{"time":215.6,"text":"Trên 2 cái ly đó rồi"},{"time":217.0,"text":"Bây giờ chúng ta sẽ xay phần sinh tố còn lại"},{"time":219.2,"text":"Với lại bánh màu đen nha"},{"time":220.3,"text":"Mình sẽ cho trà sữa còn lại"},{"time":222.3,"text":"Cùng với lại sữa tươi và whipping cream"},{"time":225.2,"text":"Cho hết vô đây luôn"},{"time":227.0,"text":"Chúng ta sẽ cho vào đây là đã xay"},{"time":228.9,"text":"Cho cái bánh màu đen"},{"time":234.9,"text":"Bây giờ mình chế vô nhưng mà mình chế chậm chậm thôi"},{"time":237.0,"text":"Mình lấy 1 cái muỗng mình đỡ"},{"time":242.1,"text":"Bây giờ chúng ta sẽ trình bài bước cuối cùng"},{"time":244.6,"text":"Đây là phần whipping"},{"time":245.6,"text":"Hồi nãy mình thánh, giờ cô sẽ cho nó lên này."},{"time":249.9,"text":"Như vậy là mình sẽ tạo ra cái ly rất là nhiều lớp."},{"time":252.2,"text":"Quá đẹp luôn."},{"time":253.5,"text":"Rồi, rắc lên đây một ít bột cacao và để lên một lá húng lũi."},{"time":258.1,"text":"Rồi, như vậy là đã hoàn thành."},{"time":261.1,"text":"Các bạn đang nhìn thấy một món uống vô cùng hấp dẫn và đẹp mắt, rất là thu hút đúng không?"},{"time":265.1,"text":"Ngay bây giờ thì chúng tôi đang có một mã QR bên cạnh để tất cả quý vị chúng ta có thể là quét mã này."},{"time":270.2,"text":"Chúng ta sẽ có ngay công thức để làm món thức uống của ngày hôm nay."},{"time":273.0,"text":"Chúng ta cũng có thể dùng kèm với món pancake nhân táo"},{"time":276.5,"text":"Phần bánh cookie thơm ngon"},{"time":278.5,"text":"Kết hợp vô cùng ăn ý"},{"time":280.2,"text":"Với trà sữa dâu ngọt ngào"},{"time":281.9,"text":"Đá say mát lạnh"},{"time":283.5,"text":"Phủ thêm lớp kèm béo béo thơm thơm"},{"time":286.1,"text":"Càng gây thích thú tồn cung"},{"time":290.2,"text":"Lâu lâu các bạn có thể làm món thức uống này"},{"time":292.3,"text":"Để dành tặng cho người yêu của mình"},{"time":293.7,"text":"Hay là dành tặng cho các bé ở nhà"},{"time":295.3,"text":"Mọi người sẽ rất thích cho mà xem"},{"time":296.8,"text":"Công thức thì luôn có trên Youtube, website"},{"time":299.8,"text":"Và fanpage của chương trình Món ngon mỗi ngày"},{"time":302.2,"text":"Chúng ta có thể truy cập vào đây"},{"time":303.3,"text":"Và có công thức ngay lập tức để bắt đầu thực hiện tại nhà"}]}