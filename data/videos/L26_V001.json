UÓC CÕT HÀNH, TÒI · DÀI TRUYÊN HINH · THÀNH PHÓ HO CHÍMINH · ·DUI ECH"}],"speech":[{"time":12.6,"text":"Đùi ít áo một lớp bột vàng ướm, giòn rụm"},{"time":16.1,"text":"Bên trong thịt ít mềm, thơm"},{"time":18.7,"text":"Ăn cùng sốt mayonnaise béo béo và salad dầu giấm chua ngọt"},{"time":22.7,"text":"Một món ăn đơn giản nhưng rất cuốn"},{"time":44.4,"text":"Nấu chuẩn, ăn lành"},{"time":45.6,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":48.4,"text":"Xin chào cô"},{"time":50.4,"text":"Xin chào Minh Tuấn"},{"time":51.0,"text":"Chương trình của mình là mình sẽ đáp ứng được nhu cầu của mọi người, mọi nhà, mọi gia đình, mọi thành viên"},{"time":56.6,"text":"Mình có món nào mà nó bắt mồi xíu không cô"},{"time":59.2,"text":"Để mà mình thết đải cho các người đàn ông trong gia đình vào dịp cuối tuần"},{"time":62.3,"text":"Món ăn ngày hôm nay sẽ là món đùi ếch chiên mè"},{"time":65.7,"text":"Một món ăn mà chúng ta có thể thết đải bạn bè vào dịp cuối tuần"},{"time":69.2,"text":"Và đồng thời theo chuyên gia dinh dưỡng món ăn này"},{"time":71.5,"text":"Còn có công dụng là hỗ trợ xây dựng khối cơ xương nữa"},{"time":74.5,"text":"Đùi ếch cho vào trong tô và mình ướp gia vị"},{"time":76.7,"text":"Chỉ cần ướp vào đây một muỗng canh nước hành tỏi băm"},{"time":80.4,"text":"Cùng với nửa muỗng cà phê tiêu say"},{"time":82.3,"text":"Chúng ta sẽ trộn đều cho đùi ếch thấm vị"},{"time":84.7,"text":"Đùi ếch không chỉ ngon và bên trong còn chứa nhiều đạm và canxi để bổ sung phát triển hệ cơ xương của chúng ta nữa các bạn nha"},{"time":91.0,"text":"Và đối với món ăn này thì các bạn cũng nên lưu ý là chúng ta sẽ chọn đùi ếch nó đều nhau"},{"time":95.5,"text":"Để khi chiên thì đùi ếch sẽ chín đều và món ăn đẹp mắt nha"},{"time":98.5,"text":"Mình sẽ pha cái dầu giấm"},{"time":100.3,"text":"Chúng ta sẽ sử dụng 1 phần 5 muỗng cà phê bột ngọt Ajinomoto"},{"time":103.1,"text":"1 chút xíu muối"},{"time":104.5,"text":"1 phần 4 muỗng cà phê tiêu"},{"time":106.8,"text":"1 muỗng cà phê đường"},{"time":108.4,"text":"Thêm vào 1 muỗng canh giấm gạo lên men Ajinomoto"},{"time":111.3,"text":"Một muỗng canh nước đun sôi để nguội"},{"time":113.8,"text":"Mình sẽ cho vào đây một muỗng canh dầu"},{"time":115.9,"text":"Cho vào đây là một củ hành tím cắt lát"},{"time":118.7,"text":"Khuấy và để cho nó tan hết đường gia vị là được"},{"time":122.5,"text":"Chúng ta sẽ bắt đầu pha aji quyết bột chiên giòn"},{"time":125.4,"text":"Đầu tiên thì mình sẽ lấy hai muỗng canh ra"},{"time":127.8,"text":"Mình sẽ cho vào mình ướp vô trong cái phần đùi ếch đó"},{"time":131.8,"text":"Chúng ta sẽ tẩm aji quyết bột chiên giòn đều xung quanh thịt ếch"},{"time":135.8,"text":"Để cho món ăn được thấm đều vị nha các bạn"},{"time":137.8,"text":"Phần còn lại thì mình sẽ cho vào trong tô và mình pha nước"},{"time":141.6,"text":"Bởi vì mình đã lấy bớt 2 muỗng ra để mình trộn với làm bột khô rồi"},{"time":145.2,"text":"Nên là mình sẽ giảm bớt lượng nước lại cô ha"},{"time":147.5,"text":"Đúng rồi"},{"time":149.6,"text":"Chúng ta pha bột ha, có độ sánh vừa phải như thế này"},{"time":158.4,"text":"Chúng ta sẽ cho thêm vào đây nửa muỗng canh mè đen"},{"time":162.7,"text":"Nó vừa tạo độ thơm, bên trong mè còn có nhiều canxi"},{"time":167.0,"text":"Bây giờ thì dầu đã nóng rồi, mình bắt đầu tẩm cái đùi ếch qua bột và mình cho vào chảo dầu mình chiên nha"},{"time":174.9,"text":"Mình dùng aziquit bột chiên giòn"},{"time":176.9,"text":"Nó vừa tạo vị cho cái món đùi ếch"},{"time":179.3,"text":"Và bên cạnh đó nó còn giúp cho chúng ta tăng độ kết dính"},{"time":182.1,"text":"Ở cái phần thịt ếch với lại cái phần bột ướt ở bên ngoài"},{"time":184.9,"text":"Trước khi mà mình vết ra khoảng 10 giây"},{"time":187.0,"text":"Thì chúng ta sẽ tăng lửa lên chút xíu"},{"time":188.8,"text":"Để giúp đẩy dầu bên trong ra"},{"time":191.6,"text":"Đấy chưa"},{"time":193.8,"text":"Mình sẽ vết ra"},{"time":194.9,"text":"Để lên giấy thấm dầu"},{"time":198.6,"text":"Rất là thơm, cực kỳ hấp dẫn luôn"},{"time":200.9,"text":"Và bên cạnh một dĩa đùi ếch chiên giòn rúm như vậy"},{"time":204.0,"text":"Là một mã QR để các bạn có thể quét mã này"},{"time":206.1,"text":"Chúng ta có công thức để thực hiện ngay tại nhà"},{"time":209.8,"text":"Sau khi bày xong"},{"time":210.9,"text":"Mình sẽ rưới lên đây một ít dầu giấm"},{"time":212.7,"text":"Đối với các loại rau trộn"},{"time":214.3,"text":"Thì chúng ta nên giữ trong tủ mát 20 phút"},{"time":216.5,"text":"Để giữ được độ giòn nha các bạn"},{"time":218.3,"text":"Và bây giờ thì mình sẽ thưởng thức thôi"},{"time":220.3,"text":"Đó"},{"time":222.2,"text":"Độ giòn"},{"time":231.2,"text":"Bên ngoài giòn rụm mọi người"},{"time":233.0,"text":"Thơm mùi mè"},{"time":234.2,"text":"Cắn vô cái phần thịt đất ngọt liệm"},{"time":236.6,"text":"Béo béo của mayonnaise aji mayo"},{"time":239.8,"text":"Xuất sắc"},{"time":240.7,"text":"Cái này mà có một cái miếng"},{"time":242.3,"text":"Hoặc là trà đá mà kiểu có bọt đó cô"},{"time":245.6,"text":"Đó, hấp dẫn, ngon"},{"time":248.4,"text":"Cảm ơn cô rất nhiều"},{"time":249.5,"text":"Và các bạn cũng lưu ý là để đạt hiệu quả dinh dưỡng"},{"time":252.6,"text":"Thì mỗi ngày hôm nay các bạn nên kết hợp theo sự đơn"},{"time":255.6,"text":"Như gợi ý bên dưới nha"},{"time":260.6,"text":"Để ghi điểm trong lòng chồng của mình"},{"time":262.8,"text":"Và những người bạn của chồng"},{"time":264.1,"text":"Thì những người phụ nữ nên làm món ăn này ở nhà"},{"time":266.8,"text":"Hoặc các anh thì cũng nên chuẩn bị biết cách nấu món này"},{"time":269.7,"text":"Để thích đại bạn mẹ của mình"},{"time":271.1,"text":"Đùi ít chiên mẹ"},{"time":272.3,"text":"Và công thức thì sẽ luôn có trên Youtube"}]}