ty Ajinomoto Việt Nam"},{"time":63.4,"text":"Rồi đầu tiên thì mình sẽ pha bột"},{"time":65.4,"text":"Cô Hạch chuẩn bị là"},{"time":66.6,"text":"200 gram bột bánh xèo"},{"time":68.5,"text":"Có 200ml nước cốc dừa"},{"time":70.4,"text":"Cô cho thêm khoảng 250ml nước nữa"},{"time":73.0,"text":"Tiếp theo thì cô sẽ cho vào đây 1 quả trứng gà"},{"time":75.8,"text":"Trứng gà mình đã đánh tan qua cái rây"},{"time":78.0,"text":"Và mình nêm vào đây 1 muỗng cà phê hạt nêm Azi ngon heo"},{"time":81.3,"text":"Cho vào đây 1 ít hành lá cắt nhỏ"},{"time":83.5,"text":"Và các bạn cũng lưu ý là sau khi mà mình pha bột xong"},{"time":86.6,"text":"Thì chúng ta sẽ để cho bột nghỉ khoảng chừng 30 phút đến 1 tiếng"},{"time":90.0,"text":"Bánh xèo sẽ phồng xốp ngon hơn"},{"time":92.2,"text":"Tôm cũng đã sơ chế sạch, mực cũng đã sơ chế sạch luôn"},{"time":94.8,"text":"Trong món ăn này thì các bạn lưu ý là chúng ta sẽ dùng tôm bạc"},{"time":97.8,"text":"Hoặc là tôm đất thì món ăn sẽ ngon hơn"},{"time":99.7,"text":"Hải sản mà mình phải cho chút xíu tiêu ha"},{"time":101.9,"text":"Và nửa muỗng cà phê hạt nêm Azi ngon heo"},{"time":104.9,"text":"Trong lúc mà chờ tôm và mực thấm gia vị"},{"time":107.4,"text":"Thì chúng ta sẽ sơ chế đến cái phần rau củ trong món bánh xèo"},{"time":110.9,"text":"Mình sẽ trộn đều nó lại cắt rau củ với nhau"},{"time":113.4,"text":"Ở đây cũng có giá"},{"time":114.3,"text":"Có hành tím cắt nhỏ mỏng như thế này"},{"time":117.0,"text":"Rồi cà rốt, củ sắn, hành lá mình cắt khúc"},{"time":120.7,"text":"Và mình trộn đều nó lên"},{"time":122.2,"text":"Bánh xèo này chất lượng quá"},{"time":123.8,"text":"Tôm, mực là tươi ngon luôn"},{"time":126.1,"text":"Còn cái phần rau củ quả nè"},{"time":128.1,"text":"Trời ơi có củ sắn nữa"},{"time":129.3,"text":"Chúng ta sẽ cho vào đây khoảng chừng 1 chén dầu ăn"},{"time":133.1,"text":"Mình đung cho dầu vừa nóng thôi"},{"time":135.0,"text":"Không có đợi phải sôi"},{"time":136.4,"text":"Thì mình sẽ cho vào đây là"},{"time":138.2,"text":"1 ít cái hành và tỏi đập dập"},{"time":141.0,"text":"Các bạn lưu ý là chúng ta sẽ phi hành tỏi với dầu ăn cho thơm"},{"time":144.5,"text":"Rồi lấy dầu đó chiên bánh xèo để bánh được thơm ngon nha"},{"time":147.0,"text":"Mút 1 ít dầu cho vô lại"},{"time":149.0,"text":"Rồi cô sẽ cho cái phần tôm vào đây"},{"time":151.3,"text":"Mình xào tôm"},{"time":152.5,"text":"Bây giờ khi mà tôm vừa chín thôi"},{"time":154.4,"text":"Thì bây giờ mình tắt lửa"},{"time":155.9,"text":"Và cái chảo còn đang nóng như thế này nè"},{"time":158.2,"text":"Mình sẽ cho cái phần mực còn lại vào"},{"time":160.4,"text":"Mình chỉ đảo vậy thôi"},{"time":161.6,"text":"Mực nó chín săn vừa"},{"time":163.1,"text":"Ôi thơm quá"},{"time":166.3,"text":"Rồi xong rồi mình sẽ trút cái phần tôm mực này ra"},{"time":169.8,"text":"Rồi bây giờ mới là tới công đoạn đổ bánh xèo nè"},{"time":172.4,"text":"Mở đưa giúp cô nha"},{"time":174.1,"text":"Rồi mình đợi cho cái chảo nóng lên xíu á"},{"time":177.2,"text":"Rồi cô sẽ cho lên đây dầu"},{"time":179.3,"text":"Nán dầu khắp chảo cho đều"},{"time":181.1,"text":"Múc một giá bột"},{"time":182.2,"text":"Cái này thì mình đổ những cái bánh xèo nhỏ nhỏ thôi nha"},{"time":185.2,"text":"Không có đổ bự nha"},{"time":187.6,"text":"Tráng đều mà có lớp mỏng như vậy"},{"time":189.1,"text":"Cũng công hô lắm cô ha"},{"time":191.0,"text":"Tiếp theo cho vào đây tôm và mực"},{"time":193.2,"text":"Cho rau, giá"},{"time":195.3,"text":"Vô trong này"},{"time":195.9,"text":"Bây giờ thì chúng ta sẽ đậy nắp lại"},{"time":198.0,"text":"Và chúng ta nhớ là chúng ta chỉ cần giảm lửa vừa thôi"},{"time":200.9,"text":"Đừng có làm nhanh quá"},{"time":201.9,"text":"Bởi vì bánh xèo đổ chậm chậm"},{"time":203.8,"text":"Chín từ từ thì mới giòn và ngon được"},{"time":205.8,"text":"Nhân cũng chín rồi đó"},{"time":207.3,"text":"Mình sẽ mở dung"},{"time":208.7,"text":"Các bạn lưu ý là khi bánh vừa chín thì chúng ta sẽ mở dung"},{"time":212.0,"text":"Và đợi cho bốc hết hơi nước"},{"time":213.8,"text":"Bánh ráo cái rìa thì chúng ta sẽ"},{"time":215.5,"text":"mình sẽ rưới thêm một ít dầu để bánh được giòn lâu nha Rồi giờ chuẩn bị mình vết ra"},{"time":220.3,"text":"ui giòn rộn trong bắt mắt quá mà thơm vô cùng các bạn ơi"},{"time":230.7,"text":"phần bột còn lại là của Thanh Phương nha Thanh Phương đổ nha"},{"time":234.6,"text":"cô tin tưởng em dữ vậy hả chứ sao"},{"time":241.9,"text":"mình sẽ pha nước mắm sẽ lấy là đó là một quả đường một quả nước mắm"},{"time":248.6,"text":"Nước dừa tươi 3 vá"},{"time":251.1,"text":"Như vậy là tỷ lệ đường, nước mắm và nước dừa của mình là 1, 1, 3"},{"time":256.8,"text":"Nấu lên cho sôi, cho tan hết đường"},{"time":259.5,"text":"Chúng ta sẽ để nguội phần nước chấm này"},{"time":261.4,"text":"Khi ăn thì mình sẽ cho thêm là tỏi băm, ớt băm và đồ chua"},{"time":268.0,"text":"Một món ăn nhân giả cực kỳ dễ làm"},{"time":270.4,"text":"Chúng ta hoàn toàn có thể thực hiện được tại nhà"},{"time":272.2,"text":"Cả nhà cùng nhau quay quần đổ bánh xèo và thưởng thức"},{"time":275.4,"text":"Sẽ tạo nên một bộ không khí vô cùng vui nhộn"},{"time":277.9,"text":"Vỏ bánh xèo giòn xốp, thơm thoang thoảng nước cốt dừa"},{"time":281.6,"text":"Tôm mực thì chín ngọt, ăn với rau rừng tươi mát"},{"time":284.7,"text":"Quyện thêm nước chấm chua ngọt, thật ngon khó cử"},{"time":288.0,"text":"Để thưởng thức món bánh xèo thơm ngon chất lượng"},{"time":290.7,"text":"Cả nhà ơi đừng quên vào bếp với Món Ngon Mỗi Ngày"}]}