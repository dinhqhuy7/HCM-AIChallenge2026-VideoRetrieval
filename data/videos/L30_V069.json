,21],["L30_V069",1951,78.0,13],["L30_V069",988,39.5,8],["L30_V069",5129,205.1,32],["L22_V006",9999,333.3,110],["L22_V006",9281,309.3,102],["L30_V069",681,27.2,6],["L22_V006",10551,351.7,116]]]],"onScreen":[{"time":0.1,"until":2.9,"text":"tv.tuoitre.vn"},{"time":4.7,"until":7.1,"text":"Herbalife · Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.7,"until":14.3,"text":"Herbalife · Sáng ch hu ích ca 'k su chân đt' · Cuc thi Lan ta năng lung tích cc 2024:"},{"time":14.9,"until":16.9,"text":"Herbalife · Cuc thi Lan ta năng lung tích cc 2024: · Sáng ch hu ích ca 'k su chân đt'"},{"time":17.2,"until":21.6,"text":"Herbalife · tuoitre · Cuc thi Lan ta năng lung tích cc 2024: · Sáng ch hu ích ca 'k su chân đt'"},{"time":22.0,"until":23.6,"text":"tuoitre · Herbalife · Cuc thi Lan tòa năng lung tich cuc 2024: · Sáng ch hu ích ca 'k su chân đt'"},{"time":71.7,"until":75.6,"text":"tuoitre"},{"time":80.4,"until":85.7,"text":"tuöitreV"},{"time":85.9,"until":91.0,"text":"EF224 · YANA"},{"time":95.0,"until":97.1,"text":"tuoitre"},{"time":100.2,"until":111.2,"text":"tuoitre · tuóitre · tuoitneTV"},{"time":112.4,"until":119.6,"text":"tuoitrev"},{"time":119.8,"until":129.1,"text":"YANMAR · YAAMAN · F-22 · AF-22 YANMAR · YANMAA"},{"time":131.0,"until":139.2,"text":"tuoitrerv"},{"time":139.8,"until":141.1,"text":"YASMAR"},{"time":141.3,"until":147.4,"text":"Ituoitrev · tucitreTv"},{"time":161.5,"until":169.3,"text":"tuoitre"},{"time":169.5,"until":172.6,"text":"tuoitre"},{"time":172.8,"until":183.0,"text":"tuoitre · quortre"},{"time":207.6,"until":211.3,"text":"tuoitre"},{"time":211.5,"until":214.7,"text":"tuoitre"},{"time":215.1,"until":216.9,"text":"75WP · TSWP · T5WP"},{"time":217.1,"until":224.8,"text":"Tác gi: Hnh Phúc · Herbalife · life"}],"speech":[{"time":13.4,"text":"Mới đây nhất là nông cụ cắt rau muống gắn với chiếc máy cày thay thế sức người."},{"time":17.8,"text":"Thiết bị này cũng đạt giải nhì tại Hội thi Sáng tạo Kỹ thuật tỉnh An Giang năm 2023."},{"time":23.4,"text":"Nông cụ cắt, giải gốc rau muống dựa trên nguyên lý hoạt động của máy cắt lúa."},{"time":30.5,"text":"Tháng 10 là bắt đầu người ta đem, người ta gieo giống."},{"time":34.4,"text":"Thì lọt qua tháng 2 người ta giải, bà con người ta giải thu hoạch."},{"time":38.7,"text":"Hiện nay thì bà con người ta mần số lượng nhiều là người ta cần cái máy vô nó phục vụ cho nó lẹ."},{"time":44.1,"text":"cho kịp mùa nắng."},{"time":45.2,"text":"Mình ở đây tàu tiết nó thất thường lắm."},{"time":47.4,"text":"Nhiều khi những tháng này nó nắng tốt chứ lọc từng sao mưa không chừng."},{"time":51.3,"text":"Còn máy móc mình đưa vô thì cũng ok."},{"time":53.2,"text":"Mình là nông dân thì chung ra là bản thân tôi thì nó không phải là gọi là giỏi"},{"time":58.0,"text":"mà tại vì những lấy cái khó bà con nông dân mình đã sáng kiến ra"},{"time":61.5,"text":"những sản phẩm này cho phục vụ bà con nông dân mình ở địa phương mình."},{"time":65.1,"text":"Hiện nay bà con của chúng tôi thì cũng rất là phấn khởi cái chỗ đồng cuộn"},{"time":67.8,"text":"hôm nay có máy móc nó lên và giờ phục vụ cho kịp mùa vụ mình."},{"time":71.9,"text":"Rau muống là loại dây đang sen lẫn nhau, nên để tránh hao hụt khi thu hoạch, sau thời gian vượt lộn với hương hao tổn thất, hệ thống đã hoàn thiện, cải tiến thêm vài chi tiết cuốn tránh, hạn chế tối đa cây rau bị nhừ, dẫn đến hạt rau muống rụng nhiều, gây hao hụt."},{"time":87.8,"text":"Nếu như trước đây, một hectare rau muống chủ đất thuê 30 người dậy cắt trong một ngày, thì nay chỉ mất nửa ngày và mô tệ xế điều khiển sẽ thu hoạch tiện ít hơn."},{"time":98.2,"text":"Mặt khác khi năng suất hoạt động của máy tăng gấp đôi thì có thể cấp, dãy được 2 hectare"},{"time":103.1,"text":"Nghĩa là trong một ngày chiếc máy thay thế được khoảng 60 nhân công lao động"},{"time":107.4,"text":"Vì vậy thời gian thu hoạch sẽ rút ngắn hơn"},{"time":111.6,"text":"Mình không phải là nhận định mà phải là công nhận"},{"time":113.8,"text":"Công nhận là cũng như một người nông dân thôi"},{"time":116.2,"text":"Từ sáng kiến của người nông dân ra là chế được một thành phẩm như vậy cũng ok lắm rồi"},{"time":120.0,"text":"Đầu tiên là giảm trị phí, thứ hai là nhẹ nhân công"},{"time":122.6,"text":"Nó đã đem được cơ giới hóa cho đồng ruộng mình"},{"time":125.6,"text":"mình tức là người nông dân mình đã nhẹ được một cái gì đó của cái cái cái gì sản xuất của hàng năm của"},{"time":129.7,"text":"mình phải dùng từ là quá mừng thứ nhất là nó không kể thành công thứ hai là thời gian ngắn hơn nhanh"},{"time":138.9,"text":"lẹ hơn bởi vì lý do là máy làm thứ nhất là rẻ tiền thứ hai là mình ít ít tốn thời gian hơn thứ ba là"},{"time":179.8,"text":"Mình giúp ích cho bà con là cái máy này làm chi phí nó nhẹ, nhẹ chi phí thu hoạch, rồi nó làm thời gian mau, trong đồng thời gian thu hoạch mau hơn."},{"time":189.1,"text":"Ví dụ như bà con người ta là thí dụ màn 20 công đi, phải tốn 60 công nhân, vô dĩ một ngày mới rồi, mà chỉ một chiếc máy là trang là 20-20 công."},{"time":201.0,"text":"Có thể nói, bàn tay cần cụ và khối ốc thông minh tạo nên sự đam mê và sáng tạo khoa học."},{"time":206.5,"text":"Nông cụ của một kỹ sư chân đất ở An Giang đáp ứng được nhu cầu của nông dân trồng rong muốn lấy hạt"},{"time":212.8,"text":"Bởi giải pháp hữu ích này đem lại hiệu quả kinh tế cho nhà nông"},{"time":216.9,"text":"khi ngành nông nghiệp nước ta trong quá trình cơ giới hóa sản xuất đồng ruộng"}]}