me":55.5,"text":"Chúng ta thực hiện ngay thôi"},{"time":56.6,"text":"Đúng rồi, và bây giờ mình sẽ đi vào thực hiện ha"},{"time":59.1,"text":"Chúng ta sẽ cho vào trong đây 2 gói Landy trà sữa Royal"},{"time":63.3,"text":"Thêm vào trong đây là 60ml nước sôi"},{"time":65.9,"text":"Sau đó chúng ta sẽ khuấy toan điều và để nguội"},{"time":68.8,"text":"Đơn giản như vậy thôi à"},{"time":70.7,"text":"Đúng rồi, rất là nhanh gọn"},{"time":72.4,"text":"Mình nghe trà sữa mình cứ nghĩ là mình phải nấu trà lên"},{"time":74.6,"text":"Mình phải nấu sữa lên rồi mình pha định lượng như thế nào sao cho phù hợp"},{"time":78.5,"text":"Tuy nhiên khi mà có gói Landy trà sữa Royal"},{"time":81.6,"text":"Thì dường như mọi thứ đã đơn giản hơn rất là nhiều"},{"time":83.7,"text":"Chúng ta sẽ bỏ qua được rất là nhiều công đoạn"},{"time":85.7,"text":"Mà nhanh chóng thôi"},{"time":86.6,"text":"Mình đã có được một phần trà sữa đậm vị đúng chất luôn"},{"time":90.1,"text":"Đúng rồi"},{"time":90.7,"text":"Mình sẽ khuấy cho nó tan hết đều luôn nha"},{"time":94.1,"text":"Để pha được ngon hơn thì đơn giản lắm"},{"time":96.7,"text":"Chúng ta chỉ việc theo dõi thật là kỹ hướng dẫn"},{"time":98.8,"text":"Ở trên Blendy trà sữa Royal"},{"time":100.7,"text":"Đó là nếu như chúng ta muốn uống nóng"},{"time":102.8,"text":"Thì chúng ta sẽ pha lượng nước bao nhiêu"},{"time":104.5,"text":"Còn uống lạnh thì mình pha ít nước thôi"},{"time":106.4,"text":"Để khi cho đá vào thì sẽ vừa hơn"},{"time":108.5,"text":"Đúng rồi"},{"time":109.2,"text":"Khuấy xong rồi"},{"time":110.0,"text":"Mình sẽ để qua một bên cho nó nguội"},{"time":114.5,"text":"Tiếp theo mình sẽ đi pha phần thức uống"},{"time":117.5,"text":"Cho vào trong đây là 6 trái nho"},{"time":120.4,"text":"Như là nho bổ đơ đúng không ạ?"},{"time":122.0,"text":"Đúng rồi, mình sẽ chọn cái nho không hột thì nó sẽ ngon và dễ thưởng thức hơn"},{"time":127.9,"text":"Chúng ta sẽ chọn phần nho xanh không hạt nha"},{"time":130.6,"text":"Bởi vì nó sẽ không có phần lợi cận trong nước pha khi mà không có hạt"},{"time":134.1,"text":"Ngoài ra nho xanh thì có vị chua nhẹ nữa, cũng rất là phù hợp với thức uống ngày hôm nay"},{"time":138.8,"text":"Thì mình sẽ dầm cái phần nho này cho nó dập ra"},{"time":142.7,"text":"Trong lúc dầm mình sẽ xoáy nhẹ như thế này, nó sẽ dễ hơn"},{"time":148.9,"text":"Với thức uống ngày hôm nay chúng ta nên dằm nho để tạo hương vị đặc trưng cho thức uống nha"},{"time":152.8,"text":"Tiếp theo là mình sẽ cho cái phần nước đá này vào"},{"time":159.4,"text":"Cho cái phần nước đá nó sẽ sách thắt cái mặt như thế này luôn ha"},{"time":162.8,"text":"Ở đây mình sẽ sử dụng sữa tươi không đường nha"},{"time":166.7,"text":"Cho cái hỗn hợp Lenny trà sữa rojo này vào trên"},{"time":171.3,"text":"Mình sẽ cho cái phần này nhẹ nhàng thôi"},{"time":173.9,"text":"Để nó tạo cái tầng cho nó đẹp mắt"},{"time":176.1,"text":"Wow một cái loại thức uống rất là đẹp mắt luôn"},{"time":178.5,"text":"Có từng lớp từng phần rõ phần phía dưới là màu xanh ngọc của nho nè"},{"time":183.0,"text":"Nho rất là tốt cho mắt"},{"time":184.6,"text":"Kết hợp với lại sữa có canxi"},{"time":186.8,"text":"Và thêm trà sữa các vị thơm thơm béo béo nữa"},{"time":189.5,"text":"Món thức uống này quả thật rất hấp dẫn luôn đó anh Vinh"},{"time":192.4,"text":"Và để hấp dẫn hơn chúng ta sẽ cho thêm 3 viên kem vani lên trên ly"},{"time":197.1,"text":"Để tăng thêm cái vị béo nhẹ cho món thức uống của chúng ta nha"},{"time":200.6,"text":"Rồi mình sẽ cho vào trong đây"},{"time":203.3,"text":"Chúng ta nên kết hợp với kem vani để tạo hương vị béo nhẹ cho thức uống nha"},{"time":206.9,"text":"Cho thêm 1 viên nữa nè"},{"time":216.3,"text":"Cho thêm 1 miếng nho lên trên nha"},{"time":222.2,"text":"Thêm vào trong đây là một ít sốt sô-cô-la"},{"time":225.1,"text":"Để hấp dẫn hơn chúng ta nên trang trí bằng một lớp sốt sô-cô-la"},{"time":228.6,"text":"Trang trí một lá húng lụi bên trên nữa nè"},{"time":230.9,"text":"Và bây giờ là món thức uống của chúng ta đã hoàn thành rồi đó Thanh Phương"},{"time":233.9,"text":"Dạ, Thanh Phương để ý dạo gần đây các bạn trẻ rất là thích những loại thức uống mà có kết hợp với kem"},{"time":239.3,"text":"Ở đây vừa có sự kết hợp giữa trà sữa, kem và nho nữa"},{"time":243.1,"text":"Thì chắc chắn rằng đây sẽ là một món thức uống mà hầu như ai cũng yêu thích luôn đấy ạ"},{"time":246.7,"text":"Và để tìm hiểu kỹ hơn về công thức của món thức uống ngày hôm nay"},{"time":249.3,"text":"Quý vị đừng quên quét bả QR nha"},{"time":251.4,"text":"Và món thức uống của chúng ta đã hoàn thành rồi đó Thanh Phương"},{"time":255.8,"text":"Wow rất là hấp dẫn"},{"time":257.2,"text":"Các bạn ơi đừng bỏ lỡ món blendy kem nho ngày hôm nay nha"},{"time":261.0,"text":"Và với món thức uống này thì chúng ta sẽ kết hợp với một món nào khác nữa anh"},{"time":264.6,"text":"À với món thức uống này thì chúng ta nên kết hợp với một món bánh đó là ban kết thanh long đỏ nha"},{"time":270.9,"text":"Ngấm đi trà sữa phân tầng, đẹp sỏ nét, nhấp ngụm trà thấy vị béo thơm, chua thanh"},{"time":276.1,"text":"Cân bằng của nho và kem vani trang về mát lạnh"},{"time":279.5,"text":"Sẵn khoái tận tim"},{"time":281.8,"text":"Các bạn hãy trổ tài pha chế ngày"},{"time":283.6,"text":"Plenty kem nho"},{"time":284.6,"text":"Để xem cả nhà có trầm trộn hay không nhé"},{"time":286.9,"text":"Và để xem lại công thức của thức uống ngày hôm nay"},{"time":289.2,"text":"Vui lòng truy cập vào kênh youtube, website"},{"time":291.2,"text":"Và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":293.3,"text":"Còn bây giờ xin được mến chào tạm biệt"},{"time":294.9,"text":"Và hẹn gặp lại"}]}