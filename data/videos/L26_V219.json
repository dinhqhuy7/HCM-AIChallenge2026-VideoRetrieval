it Nam · Công ty Hakuhodo Vit Nam · Tham gia thc hin · 3 cây · Công ty Golden Scale · 1/2M · 6 cái · Bn quyn kch bn và cu trúc · Công ty HKFilm · NGUYÊN LIÊU · Phi hp thc hin · ·CÀ RI BÔT · ·LÁCÀRI · · KHOAI LANG · ·SÀ · ·CÀ RI DÁU · ·TÒI BÄM · Thc hin chương trình · 2 cù · · Hat nêm Aji-ngon® Gà · chuơng trình thuc · ·GÜNG BÄM · ·DÙI GÀ · Thc hin chươ · · HÀNH TÍM BÃM · DÀI TRUYÊN HìNH TP. HCM · ·DÜA NAO · Onl · · GÙNG BĂM"}],"speech":[{"time":12.2,"text":"Thơm đổi vị ngày mới với curry gà"},{"time":29.9,"text":"Rất vui được gặp lại các bạn khán giả đang theo dõi chương trình món ngon mỗi ngày"},{"time":33.4,"text":"Nấu chuẩn, ăn lành"},{"time":35.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":39.2,"text":"Khi mà nhắc đến curry thì là một món ăn rất là quen thuộc rồi đúng không nào?"},{"time":43.3,"text":"Đúng rồi"},{"time":43.6,"text":"Đây là món ăn xuất xứ từng Ấn Độ"},{"time":45.8,"text":"Chữ curry trong tiếng Tami của Ấn Độ có nghĩa là nước sốt"},{"time":50.7,"text":"Và ở mỗi nơi thì họ sẽ biến tấu cái hương vị sốt curry này theo một cách khác nhau"},{"time":55.0,"text":"Ngày hôm nay thì chúng ta sẽ thực hiện món cà ri gà với cách hướng dẫn của đồ bếp Phước Hưng"},{"time":59.5,"text":"Để xem có gì thú vị và đặc biệt nha"},{"time":61.2,"text":"Vậy thì bây giờ chúng ta hãy nấu liền đi"},{"time":63.0,"text":"Mà để tiết kiệm thời gian hơn thì bây giờ Phước Hưng sẽ bặt lên trên bếp một cái chảo dầu để chúng ta chiên khoai"},{"time":68.1,"text":"Phần nguyên liệu chính cho món ăn ngày hôm nay đó chính là đùi gà"},{"time":71.1,"text":"Phần đùi gà thì chúng ta rửa sạch và để ráo và chặt làm đôi thành từng miếng vừa ăn"},{"time":75.7,"text":"Phước Hưng sẽ cho vào đây 2 muỗng cà phê hạt nêm Azi ngon gà"},{"time":79.2,"text":"1 muỗng cà phê đường"},{"time":80.5,"text":"Nửa muỗng cà phê muối, nửa muỗng cà phê tiêu"},{"time":83.5,"text":"Một muỗng cà phê bột cà ri"},{"time":85.2,"text":"Sẽ trộn đều gia vị lên"},{"time":86.6,"text":"Sau khi mà các bạn chúng ta đã cho gia vị vào trong gà"},{"time":89.3,"text":"Chúng ta ướp rồi thì chúng ta chỉ ướp khoảng từ 10-15 phút thôi"},{"time":92.6,"text":"Là gà đã được thấm"},{"time":93.8,"text":"Khoai lang thì chúng ta sẽ cắt khối khoảng 3cm"},{"time":96.6,"text":"Và khi mà chúng ta cắt xong"},{"time":98.2,"text":"Thì ngâm ngay qua bên cái nước muối khoa loãng"},{"time":101.0,"text":"Để cho khoai không bị thâm"},{"time":103.2,"text":"Đối với phần xá cây thì chúng ta sẽ đập dập và cắt khúc vừa ăn"},{"time":110.8,"text":"Phần khoai sau khi cắt khúc và ngâm qua phần nước lọc có pha một chút muối"},{"time":115.3,"text":"Thì bây giờ Minh Phương đã vớt ra để ráo nước nè"},{"time":117.5,"text":"Bây giờ mình chiên đúng không Phương Hương Tân?"},{"time":119.1,"text":"Đúng rồi"},{"time":119.2,"text":"Và đây cũng là một lưu ý khi mà quý vị chúng ta làm món ăn này nha"},{"time":122.7,"text":"Chúng ta phải chiên khoai lang trước khi nấu"},{"time":125.0,"text":"Giúp cho khoai lang không bị nát thì ăn sẽ thơm ngon hơn"},{"time":128.1,"text":"Phương Hương ơi phần khoai đã vàng xém cái cạnh bên ngoài rồi"},{"time":131.9,"text":"Bây giờ mình vớt được chưa Phương Hương?"},{"time":133.3,"text":"Được rồi đó Minh Phương"},{"time":136.6,"text":"Và bây giờ tiếp theo Phương Hương sẽ đặt lên trên bếp một cái nồi để chúng ta nấu cà ri"},{"time":140.5,"text":"Cho vào đây khoảng 2 muỗng canh dầu ăn"},{"time":142.4,"text":"Đối với món cà ri ngày hôm nay thì Phước Hương cũng sẽ sử dụng lá cà ri tươi"},{"time":147.0,"text":"Và bây giờ chúng ta sẽ cho lá cà ri vào"},{"time":149.3,"text":"Chúng ta chia"},{"time":151.0,"text":"Quả thật là lá cà ri tươi khi mà được chiên lên á"},{"time":153.7,"text":"Có một cái mùi thơm rất là dễ chịu và đặc trưng"},{"time":156.4,"text":"Bây giờ là cái lá cà ri đã trong lại và chuyển màu rồi"},{"time":159.3,"text":"Hương sẽ vớt lá cà ri ra"},{"time":161.0,"text":"Phước Hương sẽ chừa lại ở đây vài lá"},{"time":162.7,"text":"Cho phần xả cây đập dập vào chúng ta phi thơm"},{"time":165.5,"text":"Tiếp tục Phước Hương sẽ cho phần hành tím băm vào"},{"time":168.0,"text":"Và tỏi băm"},{"time":169.5,"text":"Rất là nhiều gia vị đúng không nào"},{"time":171.1,"text":"Đúng rồi"},{"time":171.5,"text":"Tiếp theo thì Phước Hưng cho phần ớt băm vào luôn"},{"time":174.2,"text":"Phần xả cây cũng như là tỏi, hành tím, ớt"},{"time":177.1,"text":"Đấy vậy lên được mùi thơm rồi"},{"time":178.5,"text":"Cho phần gà vào chúng ta xào xăng"},{"time":180.9,"text":"Và bây giờ tiếp theo Phước Hưng sẽ cho vào đây khoảng 1 muỗng canh cà ri dầu"},{"time":184.5,"text":"Giúp cho cái món cà ri có cái hương vị đặc trưng và có cái ván dầu rất là đẹp"},{"time":188.6,"text":"Và đây cũng là một cái lưu ý cho các bạn nha"},{"time":190.3,"text":"Chúng ta sẽ xào thịt gà trước"},{"time":191.9,"text":"Giúp cho thịt gà xăng chắc nạt khi ăn sẽ thơm ngon hơn"},{"time":195.0,"text":"Phước Hưng sẽ cho phần nước giảo dừa vào trước để chúng ta hầm gà cho mềm."},{"time":199.5,"text":"Sau khi mà cái nồi cà ri của chúng ta sôi trở lại thì các bạn nấu với lửa vừa."},{"time":203.6,"text":"Khoảng từ 5-10 phút là gà được chín mềm rồi."},{"time":206.6,"text":"Cho phần khoai lang chiên vào."},{"time":208.2,"text":"Thì chúng ta nấu nhanh thôi để khoai không bị nát."},{"time":211.3,"text":"Phước Hưng sẽ nêm thêm gia vị vào đây."},{"time":213.3,"text":"Nửa muỗng cà phê muối, nửa muỗng canh đường."},{"time":216.5,"text":"Cho vào lá cà ri chiên."},{"time":218.6,"text":"Chúng ta sẽ cho nước cốt dừa vào sau cùng."},{"time":220.8,"text":"Giúp cho nước cốt dừa không bị tắt dầu nè và món cà ri sẽ thơm ngon hơn."},{"time":224.7,"text":"Và cuối cùng cho phần hành tây cắt muối cao vào"},{"time":227.8,"text":"Nồi curry của chúng ta đã sôi trở lại rồi bây giờ Phước Hưng sẽ tắt bếp"},{"time":231.3,"text":"Vậy là hoàn tất rồi"},{"time":232.6,"text":"Để nấu đúng chuẩn, để có được một thành phẩm, một nồi curry thơm ngon như thế này"},{"time":237.2,"text":"Thì hãy nhớ những lưu ý từ đội bếp Phước Hưng các bạn nha"},{"time":240.2,"text":"Và các bạn cũng có thể sử dụng điện thoại di động để quét mã QR đang hiển thị trên màn hình"},{"time":244.7,"text":"Để xem lại công thức của món ăn ngày hôm nay và nhiều món ăn ngon nữa"},{"time":250.4,"text":"Món ăn ngày hôm nay thịt gà sẽ cung cấp protein nè"},{"time":253.5,"text":"Thì còn có khoai lang nữa"},{"time":255.0,"text":"Ở trong khoai lang còn có cái hoạt chất beta carotene"},{"time":258.5,"text":"Khi mà chuyển hóa vào trong cơ thể cùng với dầu"},{"time":260.9,"text":"Thì sẽ tạo thành vitamin A"},{"time":263.0,"text":"Và vitamin A thì quý vị biết rồi rất là tốt cho sức khỏe đúng không nè"},{"time":266.0,"text":"Đúng rồi"},{"time":266.6,"text":"Và cuối cùng Phước Hưng sẽ cho lên đây một cọng ngò rí nè"},{"time":270.4,"text":"Và một ít ớt sừng luôn"},{"time":272.2,"text":"Và bây giờ món curry của chúng ta đã hoàn tất rồi"},{"time":275.1,"text":"Khi ăn thì các bạn chúng ta sẽ dùng bánh mì chúng ta chấm nè"},{"time":278.4,"text":"Và chấm với một ít muối ớt sẽ rất là tuyệt vời"},{"time":281.1,"text":"Cà ri gà với phần thịt gàm chín mềm, khoai lang dẻo bùi, thấm nước cà ri đậm đà, cay nhẹ và béo ngậy vị cốt dừa"},{"time":290.2,"text":"Món quen nay đã có công thức mới, thực hiện ngay để chiêu đải gia đình của mình nào các bạn ơi"},{"time":295.0,"text":"Và các bạn cũng có thể truy cập để xem thêm nhiều công thức của các món ăn ngon"},{"time":298.9,"text":"Tại địa chỉ youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":302.8,"text":"Còn bây giờ thì xin chào tạm biệt và hẹn gặp lại"}]}