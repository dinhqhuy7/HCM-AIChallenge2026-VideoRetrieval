án giả đã quay trở lại với chương trình Món ngon mỗi ngày, nấu chuẩn, ăn lành"},{"time":36.1,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":41.0,"text":"Hôm nay Hoàng Long sẽ hướng dẫn Kim Thảo làm một món ăn rất là dân dã và rất là hấp dẫn"},{"time":45.6,"text":"Đó là món ốc xào khế"},{"time":47.7,"text":"Kim Thảo đặc biệt là thích khế chua nữa"},{"time":50.1,"text":"Tại vì khế chua sẽ có vitamin A và vitamin B5"},{"time":53.4,"text":"Rất là tốt cho quá trình trao đổi chất trong cơ thể"},{"time":56.0,"text":"Và đặc biệt hơn nữa là còn có vitamin B6 nữa"},{"time":59.3,"text":"Và sẽ tốt cho tim mạch giảm cholesterol đó"},{"time":62.1,"text":"Bây giờ mình làm nhanh đi"},{"time":63.1,"text":"Đây là phần ốc bu mà Long đã rửa với nước pha giấm"},{"time":65.9,"text":"Sau đó xả sạch giúp cho ốc được sạch nhất"},{"time":68.1,"text":"Long sẽ cho phần ốc vào"},{"time":70.3,"text":"Nửa muỗng canh hành băm"},{"time":72.5,"text":"Nửa muỗng canh tỏi băm"},{"time":74.2,"text":"Hai muỗng canh nước nghệ"},{"time":75.6,"text":"Một muỗng canh giấm gạo lên men Ajinomoto"},{"time":80.9,"text":"Nửa muỗng cà phê búi"},{"time":84.4,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":87.8,"text":"Mình sẽ trộn đều lên"},{"time":91.8,"text":"Bây giờ mình sẽ cắt khế"},{"time":93.1,"text":"Kim Thảo cắt là khoảng tầm 0,3cm"},{"time":101.7,"text":"Rồi với khoảng tí tô thì chúng ta sẽ cắt là 5mm"},{"time":108.5,"text":"Rồi"},{"time":108.9,"text":"Được rồi Thảo ha"},{"time":112.4,"text":"Rồi hành lá thì mình cắt 3cm nha"},{"time":119.5,"text":"Với phần khế này thì Long sẽ ướp vào đây là 1 muỗng cà phê đường"},{"time":123.2,"text":"Xóc khế với đường giúp khế giảm vị chua"},{"time":125.4,"text":"Tăng thêm vị ngọt của khế"},{"time":126.9,"text":"Sau khi xào khế sẽ ngon hơn"},{"time":128.7,"text":"Bật bếp lên nha"},{"time":130.9,"text":"Khi mà chảo nóng chúng ta sẽ cho vào đây là 1 muỗng canh dầu ăn"},{"time":135.1,"text":"Cho vào đây là muỗng cà phê, hành tím băm, thêm một phần đầu hành"},{"time":140.0,"text":"Rồi, và sau đó mình sẽ cho cái phần ốc vào"},{"time":143.5,"text":"Xào ốc với lửa to, sau khi xào mới trụng chung với khế"},{"time":146.9,"text":"Giúp cho khế và ốc chín giòn"},{"time":148.8,"text":"Ốc bu là một loại để cung cấp protein rất là tốt cho cơ thể"},{"time":152.4,"text":"Mà bên cạnh đó thì chất béo trong ốc bu rất là thấp"},{"time":156.0,"text":"Cho nên chúng ta có thể bồi bổi thoải mái mà không lo bị béo đúng không ạ?"},{"time":159.6,"text":"Bây giờ mình sẽ cho phần ốc bu mình ra dĩa, sau đó mình xào khế"},{"time":165.7,"text":"Lâm sẽ cho được một xíu dầu"},{"time":168.0,"text":"Rồi, mình cho phần khế vào"},{"time":170.6,"text":"Và Lâm sẽ cho cái phần nước ốc này vào"},{"time":175.4,"text":"Và chúng ta đợi cho"},{"time":176.7,"text":"Cái phần nước ốc nó rút hết vào"},{"time":178.6,"text":"Trong phần thân khế đúng không"},{"time":180.1,"text":"Sau đó nó có thể là thấm vị và ngon hơn"},{"time":182.4,"text":"Đúng rồi"},{"time":183.2,"text":"Rồi khi đó mình đổ ốc ngược trở lại"},{"time":185.0,"text":"Lâm sẽ nêm vào đây là nửa bún canh nước mắm"},{"time":186.9,"text":"Cho phần ốc sừng vào"},{"time":190.2,"text":"Wow, cái mùi nó bắt đầu có vẻ như là"},{"time":193.1,"text":"Sắc lại và nó có cái thương thơm"},{"time":195.7,"text":"Nó nghèo nghẹt thơm rồi đó"},{"time":197.3,"text":"Và cuối cùng là mình sẽ cho cái phần hành lá và tí tô vào"},{"time":202.7,"text":"Sau đó xốp đều là tắt bếp"},{"time":204.6,"text":"Có 2 loại ốc rất là giống nhau"},{"time":206.9,"text":"Đó là ốc bưu và ốc lát"},{"time":208.3,"text":"Thực ra với món ăn ngày hôm nay thì mình làm ốc nào cũng được đúng không Long?"},{"time":211.9,"text":"Đúng rồi"},{"time":212.2,"text":"Ốc bưu thì sẽ là con to hơn"},{"time":214.8,"text":"Và ở cái phần đuôi thì nó nhọn"},{"time":216.7,"text":"Còn ốc lát thì là con nhỏ có màu nâu sáng"},{"time":219.4,"text":"Phần đuôi thì nó là người ta hay gọi là đích bằng đó"},{"time":222.3,"text":"Và món ăn của ngày hôm nay nhanh gọn lẹ đã được hoàn tất rồi"},{"time":225.8,"text":"Và để có thể xem lại trọn bộ công thức chuẩn vị dinh dưỡng của ngày hôm nay"},{"time":230.5,"text":"Quý vị và các bạn có thể quét mã QR trên mạng hình của chúng tôi"},{"time":235.7,"text":"Món ăn đã hoàn thành và Long sẽ dọn ra đĩa và mời mọi người cùng thưởng thức"},{"time":247.5,"text":"Rồi mình điểm tô thêm một chút lá tí tô lên mặt"},{"time":251.1,"text":"Hấp dẫn quá"},{"time":252.4,"text":"Rất là thơm, màu sắc rất là đẹp đúng không ạ?"},{"time":254.6,"text":"Ừ"},{"time":254.9,"text":"Như vậy là món ăn của chúng ta cũng đã hoàn thành"},{"time":256.9,"text":"Và để tạo nên một bữa ăn hoàn chỉnh"},{"time":258.6,"text":"Thì Long khuyến khích mọi người nên ăn kèm với món canh sườn củ sen artichoke"},{"time":262.6,"text":"Wow, nghe thôi là lại rất là hấp dẫn rồi đúng không ạ?"},{"time":265.9,"text":"Chúng ta đã có một phần gợi ý cho bữa ăn hoàn chỉnh"},{"time":269.2,"text":"Và Kim Thảo tin rằng là khi chúng ta sử dụng ốc để làm một món ăn chính cho cả gia đình"},{"time":273.9,"text":"Thì sẽ thay đổi khẩu vị và bữa ăn sẽ ngon hơn rất là nhiều"},{"time":277.9,"text":"Bởi vì các thành viên đều rất thích"},{"time":279.5,"text":"Từng miếng ốc nóng hổi, cắn vào giòn, ngọt thanh"},{"time":283.3,"text":"Thấm chút chua nhẹ từ khế và nồng thơm"},{"time":286.6,"text":"Cây cây của gia vị ướp cùng"},{"time":288.4,"text":"Tuy dân giả nhưng khiến bao người mê"},{"time":291.0,"text":"Ốc xào khế cho bữa cơm dân giả ấm áp bên gia đình"},{"time":295.4,"text":"Thật là thích đúng không ạ?"},{"time":296.9,"text":"Và để xem lại món ăn ngày hôm nay"},{"time":298.7,"text":"Cùng với rất nhiều món ăn hấp dẫn khác nữa"},{"time":300.9,"text":"Của chương trình Món Ngon Mỗi Ngày"},{"time":302.4,"text":"Quý vị và các bạn chỉ cần truy cập vào"},{"time":304.2,"text":"Youtube, website, fanpage của chương trình Món Ngon Mỗi Ngày"}]}