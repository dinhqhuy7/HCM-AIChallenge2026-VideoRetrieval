bi: 30g · Công ty Ajinomoto Vit Nam · Nguyên liu · Công ty Chuo Senko Vit Nam · Tham gia thc hin · Bt chiên giòn · Công ty Golden Scale · V chanh mài: 1m · Hành táy: 1/2 cù · Bn quyn kch bn và cu trúc · Công ty HKFilm · Tóm sú: 400g · Xót Mayonnaise Aji-mayo · Hón hop cài màm: 150g · Gia vi ném sån Aji-Quick · Thc hin chương trình · Phi hp thc hin · chuơng trình thuc · Công ty C · Cà rôt: 30g · ĐÀI TRUYÊN HìNH TP. HCM · Thc hié"}],"speech":[{"time":17.3,"text":"Trời ơi con của tôi"},{"time":19.2,"text":"Cái gì vậy"},{"time":20.9,"text":"Ủa sao mà anh nói là em chuẩn bị một món quà"},{"time":23.3,"text":"Cho các chị em phụ nữ mà"},{"time":24.5,"text":"Quà"},{"time":24.9,"text":"Đây"},{"time":26.7,"text":"Nhỏ ghê"},{"time":27.4,"text":"Trời ơi không có đâu"},{"time":28.4,"text":"Thế nó nhỏ chứ nó không nhỏ đâu nha"},{"time":29.8,"text":"Rau mầm nó chứa rất là nhiều lượng vitamin C nè"},{"time":33.0,"text":"Thường là các chị em hay thích ăn rau đúng không"},{"time":34.8,"text":"Rất tốt cho sức khỏe của các chị em nữa"},{"time":36.6,"text":"Bởi làm quà rất là tốt đó"},{"time":37.9,"text":"Nghe có lý"},{"time":38.7,"text":"Vô bếp lạnh"},{"time":43.3,"text":"Salad cải mầm tôm chiên"},{"time":44.8,"text":"Ngon phát ghiền"},{"time":62.2,"text":"Mới chào các bạn đang đến với chương trình"},{"time":63.9,"text":"Món ngon mỗi ngày được tài trợ với công ty Ajinomoto Việt Nam"},{"time":68.1,"text":"Và công đoạn đầu tiên cho món ăn này"},{"time":70.0,"text":"Tôm xú thì chúng ta mua về làm sạch"},{"time":71.9,"text":"Phước Hương sẽ bỏ đầu, bỏ đuôi và chúng ta sẽ lột sạch vỏ luôn"},{"time":75.0,"text":"Cho hết cái phần tôm này cho chúng ta ướp"},{"time":77.3,"text":"Cho vào đây là 1 phần tư muỗng cà phê muối, nửa muỗng cà phê tiêu"},{"time":81.2,"text":"Và bây giờ chúng ta sẽ trộn đều lên cho phần tôm này được thấm vị"},{"time":84.5,"text":"Và phần cải mầm thì ở đây Phước Hương chuẩn bị cải mầm 2 loại nè"},{"time":88.4,"text":"Phần cà gót thì bây giờ Phước Hương sẽ cắt chỉ nhuyễn"},{"time":94.6,"text":"Rồi bây giờ Phước Hương sẽ cho phần cà rốt này qua cái dĩa"},{"time":97.7,"text":"Còn phần hành tây này Phước Hương sẽ cắt lắc"},{"time":101.1,"text":"Sau khi mà chúng ta đã cắt phần hành tây rồi"},{"time":103.2,"text":"Thì Phước Hương sẽ ngâm vào một cái tô nước đã lạnh để giảm bớt đi mùi hăng của hành tây"},{"time":107.1,"text":"Còn phần cà chua bi cắt làm đôi"},{"time":110.6,"text":"Và bây giờ tiếp theo chúng ta sẽ trộn tất cả các loại rau lại với nhau"},{"time":114.5,"text":"Bây giờ Hương sẽ cho 2 loại rau mầm vào nè"},{"time":118.3,"text":"Và hành tây, cà rốt và cà chua bi luôn"},{"time":122.6,"text":"Cuối cùng Hương sẽ cho vào đây húng lũi"},{"time":125.5,"text":"Chúng ta sẽ trộn đều lên"},{"time":127.6,"text":"Rất là đẹp đúng không?"},{"time":128.7,"text":"Rất là nhiều màu sắc luôn nè"},{"time":131.2,"text":"Sau khi mà các bạn chúng ta đã trộn rau rồi"},{"time":133.3,"text":"Thì bây giờ Phước Hưng sẽ cắt cái phần rau này vào trong tủ mát"},{"time":135.9,"text":"Khi ăn thì chúng ta đem ra"},{"time":137.3,"text":"Thì giúp cho phần rau có độ giòn và mát hơn"},{"time":139.4,"text":"Và bây giờ tiếp theo Phước Hưng sẽ hướng dẫn cho quý vị"},{"time":141.8,"text":"Chúng ta sẽ trộn cái hỗn hợp sốt"},{"time":144.1,"text":"Đầu tiên thì Phước Hưng sẽ cho vào đây"},{"time":146.0,"text":"2 muỗng canh sốt mayonaise"},{"time":148.3,"text":"Tiếp tục Hưng sẽ cho vào đây là"},{"time":149.9,"text":"2 muỗng canh mật ong"},{"time":151.2,"text":"Và 2 muỗng canh nước cốt chanh"},{"time":153.2,"text":"Hương cho vào đây 1 muỗng cà phê vỏ chanh mài"},{"time":156.1,"text":"Nửa muỗng cà phê muối"},{"time":157.7,"text":"Cuối cùng Hương sẽ cho vào đây khoảng 1 muỗng canh mè trắng rang vàng"},{"time":161.4,"text":"Vậy là bây giờ chúng ta đã có 1 cái hỗn hợp sốt rất là mịn và ngon"},{"time":164.9,"text":"Sau khi mà các bạn chúng ta đã khuấy xong cái hỗn hợp sốt này rồi"},{"time":168.2,"text":"Thì chúng ta sẽ đem vào ngăn mát"},{"time":169.5,"text":"Khi ăn thì chúng ta đem ra trộn thì sẽ ngon hơn"},{"time":171.9,"text":"Và bây giờ bước tiếp theo thì chúng ta sẽ chiên tôm"},{"time":174.7,"text":"Hương sẽ sử dụng 1 gói gia vị nêm sẵn achukit bột chiên giòn để chúng ta chiên tôm"},{"time":180.1,"text":"Chúng ta sẽ để vào nước nè, theo tỷ lệ trên bao bì"},{"time":183.9,"text":"Và bây giờ chúng ta sẽ khuấy đều"},{"time":185.5,"text":"Bây giờ thì phần dầu cũng đã nóng, Phước Hương sẽ chiên tôm"},{"time":188.2,"text":"Chúng ta sẽ dùng con tôm mà mình đã ướp rồi nhúng vào phần bột nè"},{"time":193.0,"text":"Rồi cho vào chảo dầu"},{"time":195.1,"text":"Công đoạn chiên tôm này mình sẽ thực hiện cuối cùng để cho lát nữa mình trộn tôm nó được giòn hơn đúng không?"},{"time":200.0,"text":"Đúng rồi đó, nhưng mà chưa hết đâu"},{"time":201.3,"text":"Vì hôm nay chúng ta sẽ chiên tôm với gia vị nêm sẵn"},{"time":203.8,"text":"À chứ cuối cùng chiên giòn nữa thì sẽ giúp cho tôm giòn lâu hơn"},{"time":207.2,"text":"Wow, ngon quá"},{"time":210.5,"text":"Bây giờ tôm cũng đã vừa vàng giòn rồi, bây giờ Phước Hương sẽ vớt ra"},{"time":213.5,"text":"Wow, màu vàng ươm rất là đẹp luôn"},{"time":219.4,"text":"Chúng ta sẽ cho ra cái giấy thống dầu"},{"time":224.7,"text":"Ở đây Phước Hương cũng đã chuẩn bị sẵn một cái dĩa để chúng ta trình bài ra món ăn rồi"},{"time":228.4,"text":"Bây giờ chúng ta sẽ sắp xà lách vào, tới cà chua bi"},{"time":231.5,"text":"Và bây giờ chúng ta sẽ cho tôm lên"},{"time":234.3,"text":"Và bây giờ cuối cùng chúng ta sẽ bắt một ít sốt mèo nè lên"},{"time":237.3,"text":"Khi ăn thì chúng ta có thể trộn đều, sẽ rất là ngon"},{"time":240.2,"text":"Vậy là Phước Hương đang tạo hình gì đó?"},{"time":242.7,"text":"Bó hoa"},{"time":244.9,"text":"Đúng rồi"},{"time":245.5,"text":"Để các chị em"},{"time":246.1,"text":"Đúng rồi và bây giờ chúng ta sẽ"},{"time":247.9,"text":"Bó hoa tôm chiên"},{"time":250.7,"text":"À"},{"time":253.5,"text":"Thiệt là khéo tay"},{"time":255.2,"text":"Cái cà chua"},{"time":256.2,"text":"Cho chúng ta tạo hình trái tim nè"},{"time":257.9,"text":"Vậy là bây giờ món salad của chúng ta đã hoàn tất rồi"},{"time":260.3,"text":"Khi ăn thì chúng ta rưới một ít sốt lên và trộn đều lên"},{"time":263.1,"text":"Ăn sẽ rất là ngon"},{"time":264.1,"text":"Công nhận luôn"},{"time":265.2,"text":"Bó hoa này đúng là nhỏ mà có giỏ thiệt"},{"time":267.4,"text":"Đảm bảo là một món quà rất là dễ thực hiện"},{"time":269.8,"text":"Dành cho các anh tặng cho người thương yêu của mình"},{"time":272.1,"text":"Trong dịp đặc biệt này nha"},{"time":273.4,"text":"Đĩa salad tươi xanh bắt mắt"},{"time":275.6,"text":"Miếng tôm giòn rụng tan ngay trong miệng"},{"time":278.0,"text":"Lẫn với vị nhẫn nhẫn từ rau mầm"},{"time":280.1,"text":"Thơm thơm từ vỏ chanh"},{"time":281.7,"text":"Tất cả quyển thêm chút béo béo của sốt"},{"time":284.5,"text":"Vị ngất ngay"},{"time":286.0,"text":"Ngày 8 tháng 3 này bạn tặng món quà gì cho người thương"},{"time":288.8,"text":"Chưa biết thì hãy trổ tài khéo tay với món salad lạnh ngày hôm nay nha"}]}