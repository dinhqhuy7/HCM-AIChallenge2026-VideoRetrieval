4,[["L30_V082",786,31.4,8],["L30_V082",3357,134.2,18],["L30_V082",1073,42.9,10],["L22_V025",4466,148.8,44],["L30_V037",3382,135.2,44],["L30_V082",4353,174.1,20],["L30_V078",2496,99.8,26],["L30_V021",511,20.4,null],["L30_V078",1519,60.7,16],["L30_V042",716,28.6,7],["L22_V017",6524,260.9,90],["L30_V093",2792,111.6,null]]],[5241,209.6,25,[["L30_V082",935,37.4,9],["L30_V082",3357,134.2,18],["L30_V082",645,25.8,6],["L30_V012",1183,47.3,11],["L30_V082",4899,195.9,22],["L30_V091",3747,149.8,null],["L30_V012",6518,260.7,67],["L30_V012",1845,73.8,21],["L30_V083",5528,221.1,38],["L30_V091",2411,96.4,21],["L30_V091",1055,42.2,8],["L30_V058",1785,71.4,9]]],[5335,213.4,26,[["L30_V082",576,23.0,5],["L30_V082",935,37.4,9],["L30_V082",3357,134.2,18],["L21_V023",13995,466.5,126],["L30_V053",308,12.3,null],["L21_V029",1908,63.6,14],["L22_V023",23504,940.1,243],["L30_V046",638,25.5,8],["L30_V091",3193,127.7,24],["L30_V028",4900,196.0,55],["L30_V073",458,18.3,2],["L30_V028",5370,214.8,60]]],[5455,218.2,27,[["L30_V082",645,25.8,6],["L30_V082",935,37.4,9],["L30_V012",7622,304.8,81],["L30_V091",383,15.3,2],["L30_V091",6461,258.4,58],["L30_V082",3357,134.2,18],["L30_V091",3747,149.8,null],["L30_V012",1183,47.3,11],["L30_V081",4457,178.2,42],["L30_V066",6862,274.4,36],["L30_V091",2411,96.4,21],["L30_V083",7303,292.1,53]]]],"onScreen":[{"time":0.1,"until":2.9,"text":"tv.tuoitre.vn · tuitréTV"},{"time":4.9,"until":7.1,"text":"Herbalife · Clip bn đoc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.7,"until":16.3,"text":"Herbalife · 147.08 · Cuc thi Lan ta năng lung tích cc 2024: · Trái tim yêu thương · 43-C2 · 432"},{"time":16.5,"until":18.8,"text":"Herbalife · Trái tim yêu thương · Cuc thi Lan ta năng lung tích cc 2024:"},{"time":19.0,"until":21.6,"text":"Trái tim yêu thudng · Herbalife · Cuc thi Lan ta năng lung tích cc 2024:"},{"time":24.4,"until":27.0,"text":"tuoitreT"},{"time":101.8,"until":106.6,"text":"stancars · charter"},{"time":106.9,"until":111.2,"text":"tuóitreTy · tuóitre"},{"time":163.7,"until":187.5,"text":"tuoitrerv"},{"time":202.5,"until":205.6,"text":"NAB"},{"time":205.8,"until":212.1,"text":"tuoitre · QATAM"},{"time":212.4,"until":216.0,"text":"Tác gi: Bình Nam · Herbalife"},{"time":216.2,"until":220.1,"text":"Herbalife · Tác gi: Bình Nam · tuoitre"}],"speech":[{"time":13.0,"text":"Những ngày này, gian nhà của anh Nguyễn Bình Nam tại hẻm 36 Lê Duẩn, thành phố Đà Nẵng bỗng dộn dịp."},{"time":20.3,"text":"Giấy hành lang dẫn vào nhà trở thành sân tập vật lý trị liệu bất đắc dĩ của những cô bé, cậu bé, vùng cao Quảng Nam, Quảng Trị vừa được phẫu thuật và cho ra viện để điều trị."},{"time":32.1,"text":"Người kết nối vạn tấm lòng, đưa những đứa trẻ khèo chân, vượt núi về thành phố Phổ Thuật Chân là anh Nguyễn Bình Nam, người nổi tiếng với các dự án thiện nguyện cho người vùng cao khắp các tỉnh miền Trung."},{"time":45.7,"text":"Ở miền Trung mình, sang từ trong 13 năm qua, chúng ta làm được rất nhiều việc ở miền núi, nhưng bây giờ đúng là có những đứa bé nói như vậy lắm."},{"time":54.5,"text":"Và nếu như không có nhịp cầu kết nối thì các con sẽ không thể nổi được đường chân của sứ phận của mình."},{"time":60.2,"text":"cho nên từ đó được về xong anh mới nghĩ là bây giờ phải chuyển hướng sang thêm một cái hỗ trợ nữa đó"},{"time":67.1,"text":"là cho những đứa bán người lớn bị bệnh trăm chỉ đặt bệnh sinh thì đi về với Nguyễn Lê thì có chuyện"},{"time":73.5,"text":"của Tân Lâm và từ có chuyện của Tân Lâm thì anh kết nối thêm một bạn nữa là bạn ở Nguyễn Đình giống"},{"time":79.7,"text":"ở cửa tôn nhà bạn chưa biết mình sẽ làm việc này như thế nào và những thành công hay không nhưng"},{"time":86.9,"text":"Nhưng thôi cứ đăng lên Facebook này và có một kết nối."},{"time":92.5,"text":"Trường hợp đầu tiên mà anh Nam gửi gắm là câu chuyện một học sinh ở Quảng Trị bị dị tật bẩm sinh."},{"time":98.3,"text":"Sau khi đăng câu chuyện lên thì một bác sĩ ở TP.HCM đã liên lạc và nhận tài trợ phẫu thuật miễn phí."},{"time":105.7,"text":"Người này đề nghị anh Nam tìm kiếm thêm để cùng tổ chức các chuyến đi vào bệnh viện tại TP.HCM cùng thăm khám can thiệp."},{"time":116.6,"text":"4 bạn này thì trong 4 bạn này nha, 2 bạn kia mới ngủ xong thì tối nay anh bay vào mới tính"},{"time":125.5,"text":"Hiện tại bạn Bâm đó, bạn đó là sát xuất sẽ được cho anh xuất ngủ sớm"},{"time":133.0,"text":"Sau bạn đó sẽ đến bạn này, tức là về khả năng đi được ấy, rất là ổn luôn"},{"time":138.6,"text":"Còn bạn Dũng và bạn Lâm đợt đầu thì lại lâu hơn vì cao nó nặng hơn"},{"time":143.9,"text":"Như bạn Lâm thì chắc phải 1 năm, hơn 1 năm nữa, nhưng bạn Dũng thì anh đoán là khoảng tầm 2-3 tháng nữa."},{"time":151.5,"text":"Bạn Dũng người cơ tu Đông Giang vừa mới đi vào Nhật Viện thì phải tầm 3 tháng nữa."},{"time":156.2,"text":"Nhưng hai bạn này thì anh đánh giá, nhưng mà bông đi vào thì sắp đến anh sẽ xin cho ra sớm."},{"time":160.9,"text":"Bạn này chỉ chẳng hưởng thức, cố gắng vào đoàn học mất."},{"time":163.7,"text":"Hoàn cảnh của em thì cũng rất khó khăn."},{"time":187.8,"text":"Từ sự tận tâm của anh Nguyễn Bình Nam, tới nay đã có ít nhất 6 đứa trẻ bị khờ chân."},{"time":194.1,"text":"Con em đồng bào trên núi cao Quảng Trị, Quảng Nam được đưa đi phẫu thuật và bắt đầu được xuất viện cho tập vật lý trị liệu."},{"time":202.2,"text":"Anh Nam cho biết dự án của anh vẫn đang tiếp tục mở rộng để tìm kiếm những trường hợp bị dị tật bẩm sinh."},{"time":208.5,"text":"Tất cả sẽ được đưa đi thành phố Hồ Chí Minh phẫu thuật."},{"time":211.9,"text":"Toàn bộ chi phí từ nằm viện cho tới đi lại ăn uống được mạnh thường quân tài trợ."}]}