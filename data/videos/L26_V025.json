,{"time":21.2,"text":"Dậy hương mè"},{"time":22.3,"text":"Một món ăn vặt lạ"},{"time":23.8,"text":"Cả gia đình thích mê"},{"time":48.0,"text":"Trong chương trình món ngon mỗi ngày"},{"time":49.6,"text":"Nấu chuẩn ăn lành"},{"time":51.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":54.9,"text":"Em chào cô"},{"time":56.3,"text":"Vào dịp cuối tuần"},{"time":57.3,"text":"Cô có một món ăn nào đó để cho các bé"},{"time":60.0,"text":"Giống như nó chơi đồ hàng"},{"time":61.0,"text":"Có chơi đồ chơi, xong nó vừa làm được món ăn cho chính nó luôn"},{"time":64.3,"text":"Thì nguyên cả gia đình sẽ rất là vui"},{"time":65.9,"text":"Tưởng gì chứ cái việc này thì trong đầu cô cũng có rất nhiều ý tưởng"},{"time":69.6,"text":"Hôm nay chúng ta sẽ cùng nhau thực hiện món viên xúc xích trứng cút chiên"},{"time":73.3,"text":"Theo chuyên gia dinh dưỡng thì món ăn ngày hôm nay"},{"time":75.7,"text":"Là một món sẽ hỗ trợ bổ máu rất là tốt"},{"time":78.3,"text":"Bây giờ chúng ta sẽ trộn cái phần để mà bọc trứng cút"},{"time":81.4,"text":"Mình sẽ sử dụng ở đây là 300g giò sống, xúc xích xong khói nha"},{"time":84.9,"text":"Khoảng chừng 3 muỗng canh"},{"time":86.8,"text":"Trong món ăn này thì chúng ta sẽ chọn xúc xích hung khói"},{"time":89.5,"text":"Để tạo hương vị đặc trưng cho món ăn nhé"},{"time":91.6,"text":"Bắp mỷ luộc sẵn ha"},{"time":93.1,"text":"Khoảng chừng 2 muỗng canh"},{"time":94.5,"text":"Cần tây chúng ta sẽ cắt nhỏ"},{"time":96.3,"text":"Chúng ta sử dụng khoảng chừng 2 muỗng canh"},{"time":97.9,"text":"Cà rốt băm nhỏ như thế này"},{"time":99.3,"text":"Khoảng 2 muỗng canh"},{"time":100.2,"text":"Hành tím băm nửa muỗng canh"},{"time":102.3,"text":"Khoảng chừng nửa muỗng canh tiêu xanh"},{"time":103.9,"text":"1 phần 3 muỗng cà phê tiêu xay"},{"time":105.9,"text":"Rồi sau đó chúng ta sẽ trộn đều lên"},{"time":108.8,"text":"Trộn xong rồi"},{"time":109.7,"text":"Bây giờ chúng ta sẽ tạo hình"},{"time":111.1,"text":"Sẽ lấy ra khoảng chừng 2 muỗng canh bột"},{"time":113.3,"text":"Bột chiên giòn nha"},{"time":114.8,"text":"Cô Hà sẽ cho trứng cút vào"},{"time":116.3,"text":"Mình sẽ áo qua một lớp bột mỏng"},{"time":119.1,"text":"Cái phần cả này thì mình cũng sẽ chia ra làm 2"},{"time":121.8,"text":"Sau đó thì mình đã chia ra làm 6 viên"},{"time":124.6,"text":"Lấy một quả trứng cút mà mình đã lăn qua bột chiên giòn"},{"time":128.3,"text":"Lớp bột mỏng thôi"},{"time":129.3,"text":"Bọc lại"},{"time":134.2,"text":"Sau đó thì mình sẽ lăn lại cái bột này một lần nữa nè Tướng"},{"time":138.1,"text":"Các bạn lưu ý là chúng ta sẽ lăn trứng cút"},{"time":140.3,"text":"Và sau đó mình lăn viên xúc xích qua"},{"time":142.0,"text":"Aji quyết bột chiên giòn"},{"time":143.6,"text":"Như vậy thì bột sẽ bám đều"},{"time":145.4,"text":"Và viên xúc xích sẽ giòn ngon hơn nha các bạn"},{"time":148.0,"text":"Chúng ta đã biết thì cái món ăn này sẽ hỗ trợ cho việc là bổ máu"},{"time":151.2,"text":"Bởi vì ở trong trứng cút là có vitamin B12"},{"time":153.5,"text":"Đó, rất là tốt cho sức khỏe và đặc biệt là hỗ trợ cho cái quá trình là giúp cho chúng ta có thể là bổ máu hơn"},{"time":160.7,"text":"Phần axi khuyết bột chiên giòn còn lại chúng ta sẽ cho vào trong cái tô và mình pha dưới nước theo công thức"},{"time":165.4,"text":"Cô cho khoảng chừng 120ml nước thôi"},{"time":168.1,"text":"Dạ, rất là đa năng cho một món ăn luôn"},{"time":170.4,"text":"Vừa là kết dính vừa tăng độ giòn"},{"time":172.6,"text":"Đó"},{"time":173.1,"text":"Tuấn thấy nãy giờ cô đâu có nêm gia vị gì đúng không?"},{"time":175.6,"text":"Đó, đó là một thứ điều mà em cũng rất là thích nhà em"},{"time":178.1,"text":"Mà luôn luôn có một gói sẵn như vậy luôn"},{"time":179.6,"text":"Em hay làm hả cô là em tẩm bột aziquit"},{"time":182.5,"text":"Bột chiên giòn ở xung quanh mực tươi"},{"time":184.1,"text":"Xong bỏ vào chiên như vậy là ngon luôn"},{"time":185.6,"text":"Không cần phải làm gì thêm"},{"time":186.7,"text":"Tướng sẽ giúp cô là tướng bắt lên trên bếp một cái chảo dầu"},{"time":190.8,"text":"Trước khi mà chúng ta cho cái viên trứng cút vào trong bột"},{"time":193.6,"text":"Mình cũng sẽ vo lại để cho nó tròn trịa nha"},{"time":196.2,"text":"Rồi mình hãy cho vào trong cái bột"},{"time":197.8,"text":"Thì chút nữa mình tạo hình nó sẽ đẹp hơn"},{"time":202.9,"text":"Rồi em lăng lăng cho nó tròn nha"},{"time":204.4,"text":"Dạ rồi"},{"time":206.1,"text":"Những cái cặn bột thế này"},{"time":209.0,"text":"Bây giờ thì Tướng thấy là những cái viên xúc xích trứng cút nó đã rất là giòn, đầu dớt ra nha"},{"time":214.8,"text":"Trước khi trình bày thì các bạn thấy là trên màn hình đang có một cái mã QR"},{"time":217.6,"text":"Các bạn có thể quét mã này, công thức món ăn sẽ hiện ra rồi chúng ta sẽ làm ngay tại nhà nha"},{"time":223.4,"text":"Bây giờ thì chúng ta sẽ trình bày nha"},{"time":225.2,"text":"Quá hấp dẫn"},{"time":227.4,"text":"Mình là sẽ cắt ra để coi là bên trong nó có cái gì"},{"time":238.6,"text":"Khi ăn món này thì các bạn nên nhớ chúng ta sẽ chấm kèm với một chút sốt mè rang Aji sốt nha"},{"time":244.3,"text":"Dạ, các bạn sẽ nhớ"},{"time":246.8,"text":"Bây giờ các bạn sẽ làm nè"},{"time":248.0,"text":"Rồi con mời Tuấn nha"},{"time":249.2,"text":"Các bạn sẽ lấy một cái miếng"},{"time":250.3,"text":"Trời ơi trời ơi hấp dẫn"},{"time":253.2,"text":"Sốt mè rang"},{"time":257.7,"text":"Bên ngoài giòn rụm"},{"time":259.0,"text":"Ở trong là cái xúc xích sông khói rất là thơm"},{"time":262.1,"text":"Bên trong cùng là"},{"time":263.8,"text":"Cái phần trứng cút bùi bùi"},{"time":265.8,"text":"Rồi áo bên ngoài là cái mùi mè rang"},{"time":267.8,"text":"Thơm nồng của sốt nữa"},{"time":269.1,"text":"Rất là ngon"},{"time":270.4,"text":"Không chỉ các bé đâu mà cả gia đình sẽ chanh ăn nha"},{"time":273.4,"text":"Để đạt được hiệu quả dinh dưỡng"},{"time":275.2,"text":"Các bạn có thể áp dụng món ăn này"},{"time":277.2,"text":"Theo bản thực đơn trong ngày như sau"},{"time":283.2,"text":"Các bạn phải làm ngay"},{"time":284.8,"text":"Món ăn của ngày hôm nay"},{"time":285.8,"text":"Bởi vì nó không chỉ ngon miệng đâu"},{"time":287.6,"text":"Mà nó còn gắn kết tất cả các thành viên trong gia đình lại với nhau"},{"time":290.5,"text":"Và các bé sẽ rất là thích khi được chính tay"},{"time":292.6,"text":"Thực hiện món ăn này"},{"time":293.4,"text":"Và công thức món ăn sẽ luôn có trên Youtube, Website"},{"time":296.2,"text":"Và Fanpage của chương trình Món ngon mỗi ngày"},{"time":298.1,"text":"Các bạn hãy truy cập vào team những công thức"},{"time":300.2,"text":"Thật hấp dẫn của chúng tôi và thực hiện ngay tại nhà nha"},{"time":302.4,"text":"Chúc các bạn thành công"}]}