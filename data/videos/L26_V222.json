{"time":304.1,"until":314.2,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Hakuhodo Vit Nam · Tham gia thc hin · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · Phi hp thc hin · Công ty A · ·Báp cái tim: 200g · · Gim go lên men Ajinomoto · Thc hin chương trình · · Lá qué: 10 lá · · Dàu tráng Dà Lat tuoi: 50g · ·Tóm sú: 200g · DÀI TRUYÊN HìNH TP. HCM · Thc hié · chuơng trình thuc · · Xót Mayonnaise Aji-mayo Vi Nguyên Bàn"}],"speech":[{"time":31.2,"text":"Mến chào các bạn khán giả đến với chương trình món ngon mỗi ngày"},{"time":33.8,"text":"Nấu chuẩn, ăn lành"},{"time":35.7,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":39.9,"text":"Các bạn ơi khi làm món salad thì chúng ta nhớ ưu tiên bóc cải tím nha"},{"time":43.6,"text":"Bởi vì trong bóc cải tím có chứa vitamin C và vitamin K"},{"time":47.0,"text":"Ăn sống thì sẽ giữ lại được trọn vẹn giá trị chính dưỡng"},{"time":50.0,"text":"Và bây giờ thì chúng ta sẽ chuẩn bị một ngồi nước"},{"time":52.2,"text":"Và chúng ta sẽ cho vào đây một vài gốc ngò rí và một vài củ hành tím"},{"time":56.0,"text":"Để cho phần tôm chúng ta được thơm ngon hơn nha"},{"time":58.2,"text":"Đầu tiên xin sẽ có một ít lá quế"},{"time":59.9,"text":"Mấy lá nhỏ thì chúng ta sẽ trừ lại để trang trí ở bên trên cho đẹp"},{"time":62.8,"text":"Những lá lớn chúng ta sẽ cắt rối"},{"time":66.2,"text":"Rồi nước cũng đã bắt đầu sôi rồi"},{"time":67.7,"text":"Thanh Phương sẽ luộc tôm nha các bạn"},{"time":69.7,"text":"Thì chúng ta sẽ luộc với lửa lớn"},{"time":71.5,"text":"Và khi thấy cái phần đuôi tôm và đầu tôm công lại với nhau"},{"time":74.6,"text":"Gần chạm nhau"},{"time":75.5,"text":"Thì lúc đó tôm sẽ vừa chín tới"},{"time":76.8,"text":"Và tôm sẽ giữ được độ giòn cũng như ngọt của tôm nha"},{"time":79.4,"text":"Và bây giờ trong thời gian đợi cái phần tôm chúng ta được chín"},{"time":82.0,"text":"Thì xin thái nhuyễn cái phần xà lát tím này"},{"time":83.9,"text":"Các bạn thân mến bắp cải tím ngoài việc là cung cấp chất sơ cần thiết"},{"time":87.6,"text":"Thì còn có chứa vitamin C và vitamin K"},{"time":89.9,"text":"Giúp ngăn ngừa ung thư, chống tiểu đường và còn tốt cho tim mạch nữa đấy ạ"},{"time":94.4,"text":"Tôm cũng đã bắt đầu sắp chín rồi"},{"time":96.0,"text":"Chúng ta vớt tôm ra thì chúng ta sẽ cho vào liền nước ga đá lạnh"},{"time":99.1,"text":"Để tôm giữ được cái màu sắc tươi ngon và tôm cũng sẽ hấp dẫn hơn"},{"time":103.2,"text":"Phần bắp cải tím thì xin cũng đã cắt nhuyễn"},{"time":105.6,"text":"Và chúng ta cũng sẽ ngâm vào phần nước đá đã được chuẩn bị trước"},{"time":108.0,"text":"Các bạn lưu ý bắp cải tím sau khi thái sợi chúng ta ngâm qua nước đá lạnh để bắp cải tím được giòn hơn và bớt đi độ hăng nha"},{"time":114.4,"text":"Cho chúng ta sử dụng tôm để làm xa láp nên chúng ta sẽ bỏ hết cả phần đầu, chân và cả đuôi luôn ạ"},{"time":120.1,"text":"Chỉ lấy lại các phần mình tôm thôi"},{"time":122.3,"text":"Rồi xong"},{"time":123.0,"text":"Về phần đậu trắng bà lạc thì sau khi chúng ta luộc và chúng ta thông chừng nó mềm rồi đó"},{"time":126.8,"text":"Khi vừa vớt ra đậu còn nóng thì chúng ta sẽ trộn vào đây một tí muối và tiêu sẽ ngon hơn nha"},{"time":131.8,"text":"Và bây giờ xin sẽ chia sẻ cách làm sao để có được 1 phần sốt trộn gỏi thật là ngon nha"},{"time":136.7,"text":"Xin sẽ sử dụng 3 muỗng canh giấm gạo lên men Ajinomoto nha"},{"time":141.1,"text":"3 muỗng canh đường nữa nha"},{"time":146.4,"text":"Khuấy lên cho phần đường và giấm gạo lên men Ajinomoto này được hoà quyện vào nhau trước nha"},{"time":150.9,"text":"Và xin sẽ cho vào phần hỗn hợp đường với giấm gạo này thêm 1 muỗng canh nước lọc nữa"},{"time":155.0,"text":"1 muỗng cà phê dầu mè để cho món ăn chúng ta được thơm hơn nha"},{"time":157.7,"text":"Thêm 1 phần tư muỗng cà phê muối"},{"time":159.5,"text":"Có nửa muỗng cà phê tiêu nha"},{"time":160.8,"text":"Và bây giờ chúng ta sẽ khuấy đều hỗn hợp này lên"},{"time":163.8,"text":"Bây giờ xin sẽ thêm vào đây 1 muỗng canh sốt salad"},{"time":166.9,"text":"Thì chúng ta sẽ trộn riêng cái phần tôm"},{"time":168.8,"text":"Các bạn lưu ý chúng ta nên trộn tôm riêng, bắp cải tím riêng"},{"time":172.0,"text":"Để giữ được màu sắc đẹp cho tôm nha"},{"time":173.9,"text":"Xin sử dụng 1 cái tô lớn"},{"time":175.3,"text":"Chúng ta sẽ cho hết phần bắp cải tím này vào"},{"time":177.8,"text":"Phần đậu trắng đã được luộc thật là mềm"},{"time":180.5,"text":"Và trộn với 1 ít muối tiêu để cho đậm đà hơn"},{"time":182.7,"text":"Tiếp theo là chúng ta sẽ cho phần húng quế cắt rối vào đây"},{"time":185.4,"text":"Rồi, bây giờ Xin sẽ sử dụng hết tất cả phần sốt salad khi nãy mà chúng ta đã pha trộn vào"},{"time":191.3,"text":"Thanh Phương cảm nhận được mùi thơm của dầu mè và giấm gạo lên men Ajinomoto rất là hấp dẫn luôn"},{"time":196.6,"text":"Ngoài ra đây là một món ăn còn cân đối về dinh dưỡng nữa"},{"time":199.8,"text":"Không chỉ có chất sơ từ bóc cải tím, từ rau củ quả"},{"time":203.0,"text":"Mà bên cạnh đó còn có tinh một từ đậu trắng và chất đạm từ tớm nữa"},{"time":207.7,"text":"Ngoài cái việc mà chúng ta dùng dầu mè để tạo nên mùi thơm cũng như hương vị đặc biệt cho món salad của mình"},{"time":212.6,"text":"Thì quý vị khán giả cũng thấy là cái phần salad chúng ta rất là bóc bẩy, rất là đẹp đúng không nào?"},{"time":216.7,"text":"Món bắp cải tím trộn tôm đúng tiêu chí, nấu chuẩn, ăn lành"},{"time":220.5,"text":"Các bạn có thể quét bả QR đang hiện tị trên bàn hình để xem lại công thức nha"},{"time":224.7,"text":"Và còn chần chờ gì nữa, bây giờ chúng ta sẽ trang trí món bắp cải tím với tôm để xem nó ngon như thế nào nha"},{"time":232.4,"text":"Cho bắp cải tím ở bên dưới trước"},{"time":235.2,"text":"Với những món salad thì khi ăn chúng ta mới bắt đầu trộn thì salad sẽ giòn và tươi ngon hơn"},{"time":240.0,"text":"Một ít đậu trắng để ăn có một vị béo béo bùi bùi trong cái phần salad này nha"},{"time":244.5,"text":"Trang trí những con tôm lên bên trên nha"},{"time":248.8,"text":"Trang trí thêm một vài lá quế nữa"},{"time":250.7,"text":"Để cho món bắp cải tím trộn tôm trở nên hấp dẫn hơn"},{"time":253.4,"text":"Thì Xin sẽ cho lên đây một ít mayonnaise ajimejo vị nguyên bản nữa nha"},{"time":257.0,"text":"Và cuối cùng thì chúng ta sẽ cho lên vài nhánh ngò rí"},{"time":260.2,"text":"Giòn, tươi ngon, béo, thơm, đậm vị"},{"time":262.8,"text":"Quả thật là một món salad hoàn hảo"},{"time":264.9,"text":"Và Xin ơi, món ăn này chúng ta sẽ kết hợp với những món nào nữa để tạo nên bữa ăn dinh dưỡng"},{"time":269.1,"text":"Để cho món bắp cải trộn này trở nên hoàn hảo hơn thì chúng ta sẽ kết hợp với bánh mì nướng tỏi nha"},{"time":274.0,"text":"Thịt tôm ngọt, bắp cải tiến tròn, đậu trắng mùi mùi"},{"time":277.5,"text":"Với lớp sốt salad bèo béo, chua nhẹ, thơm mùi dầu mè"},{"time":281.3,"text":"Là món ăn mới lạ, tươi mát, bắt mắt vô cùng"},{"time":285.3,"text":"Lâu lâu các bạn nhớ đổi những món ăn mới màu sắc lạ mắt cho gia đình mình thưởng thức nha"},{"time":289.9,"text":"Các bạn có thể xem lại công thức của những món nấu chuẩn ăn lành"},{"time":294.0,"text":"Tại kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":297.3,"text":"Còn bây giờ xin được bến chào tạm biệt"},{"time":299.1,"text":"Hẹn gặp lại quý vị và các bạn trong những chương trình lần sau"}]}