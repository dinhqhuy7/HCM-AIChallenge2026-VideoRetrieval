time":36.8,"text":"Cùng lên làm máy kéo với những tay đua này"},{"time":38.9,"text":"Để đưa nhau về đích cạnh tranh song phẳng"},{"time":41.5,"text":"Cũng là một động thái đi ở trên đầu"},{"time":43.3,"text":"Để có thể canh chừng những đợt tấn công"},{"time":45.2,"text":"Và ngay lập tức là Sapanovikov đã pháo lên"},{"time":48.7,"text":"Mạng tăng tốc của Sapanovikov"},{"time":50.4,"text":"Khi còn cách đích 1,5 km nữa"},{"time":53.6,"text":"Không một tay đua nào chọn vấn án"},{"time":55.3,"text":"Đeo bám theo Sapanovikov"},{"time":58.9,"text":"Peter Rikunov thì rõ ràng là"},{"time":60.4,"text":"Chỉ canh chừng Igor Prolov"},{"time":62.4,"text":"Và Ivanov Timofey"},{"time":65.9,"text":"Liệu Sapanovikov có đủ thể lực"},{"time":67.8,"text":"Để duy trì được khoảng cách về đích hay không"},{"time":71.4,"text":"Sẽ hơi khó"},{"time":75.9,"text":"Còn đến 1km"},{"time":76.9,"text":"Và rất khó để Sapa Novikov"},{"time":79.3,"text":"Có thể duy trì tốc độ cao hơn so với nhóm phía sau"},{"time":81.5,"text":"Có đến 3 chiếc máy kéo lúc này"},{"time":84.6,"text":"Peter Rikunov thì vẫn đang đi trước"},{"time":86.6,"text":"Igor Prolov và Ivanov Timofey"},{"time":88.4,"text":"Vẫn luôn luôn canh chừng 2 tay đua này"},{"time":93.0,"text":"Chắc chắn là Peter Rikunov"},{"time":94.4,"text":"Cũng rất muốn giành được chiến thắng chặn"},{"time":98.3,"text":"Một cái cuối cùng rồi"},{"time":99.4,"text":"Đã vào dốc tương Hồ Tùng Mậu"},{"time":101.2,"text":"Nếu ở trong thế canh chừng nhau giữa 3 tay đua phía sau"},{"time":108.2,"text":"Thì Sapa Novikov hoàn toàn có cơ hội"},{"time":112.5,"text":"Novikov đang tăng tốc"},{"time":113.7,"text":"Và hướng về đất đến"},{"time":115.3,"text":"Ở phía sau của anh vẫn"},{"time":116.9,"text":"Cũng đang rượt lên"},{"time":118.8,"text":"Peter Rikunov đang tăng tốc"},{"time":120.2,"text":"Ở phía sau là Igor Prolov và Ivanov Timofey"},{"time":124.0,"text":"Chúng ta chờ xem cuộc đuổi bắt của các đua"},{"time":126.0,"text":"Ở phía sau họ vẫn đang rất nỗ lực"},{"time":128.2,"text":"Sapanovikov cũng đang cố gắng"},{"time":129.5,"text":"Lạc hình những cuộc chân đạp rất mạnh mẽ của mình"},{"time":132.0,"text":"Vẫn tốc trên dưới 60kmh"},{"time":134.8,"text":"Sapanovikov"},{"time":135.2,"text":"Sapanovikov đã về tới đất và chiến thắng"},{"time":137.5,"text":"Ở trạng thua ngày hôm nay đã gọi tên Sapanovikov"},{"time":141.3,"text":"Ở vị trí thứ 2 là Peter Rikunov"},{"time":153.6,"text":"mà Safa Novikov đã chọn thời điểm tấn công hợp lý khi cách đích khoảng 1,5 km."},{"time":158.9,"text":"Để mang về chiến thắng chặn đầu tiên cho cá nhân mình cũng là dành cho tập thể của nhựa Bình Minh Bình Dương."},{"time":166.5,"text":"Vậy là trong 2 mùa giải cấp trường hành TP.HCM liên tiếp,"},{"time":169.7,"text":"thì đội đua miền Đông Nam Bộ luôn luôn có cho mình 1 chiến thắng chặn."},{"time":175.3,"text":"Với cuộc đua năm ngoái, cũng như cuộc đua năm nay,"},{"time":180.2,"text":"đều là sự khẳng định của những ngoại binh mang về 1 chiến thắng chặn cho nhựa Bình Minh Bình Dương."},{"time":199.3,"text":"Khoảng cách mà anh tạo ra với áo cam Nguyễn Tấn Hoài hoàn toàn không đáng kể"},{"time":203.4,"text":"Nhưng đó là tình huống ăn mừng của Nguyễn Hoàng Sang"},{"time":207.3,"text":"Khi anh lọt vào top 5 cá nhân ở trận đua ngày hôm nay"},{"time":211.2,"text":"Trận đua khắc nghiệt và cũng xin nhắc lại là Mạnh Thường Quân đã trao thưởng"},{"time":215.5,"text":"Các giải thưởng 10 triệu đồng, 3 triệu đồng và 2 triệu đồng"},{"time":218.6,"text":"Cho 3 tư đua Việt Nam thi đấu ấn tượng nhất ở trận ngày hôm nay"},{"time":222.0,"text":"Và Nguyễn Hoàng Sang là người đầu tiên"},{"time":225.9,"text":"Tây đua Việt Nam đầu tiên về đích"},{"time":227.6,"text":"Ở trận đua thứ 17 từ Nha Trang lên Đà Lạt"},{"time":233.0,"text":"Vâng, đôi khi có những chiếc huy chương đồng"},{"time":237.3,"text":"Cũng danh giá không khác gì những chiếc huy chương vàng"},{"time":240.1,"text":"Và đôi khi vị trí thứ 5 đối với một tây đua như Nguyễn Hoàng Sang"},{"time":243.7,"text":"Cũng có ý nghĩa và giá trị không khác gì"},{"time":246.0,"text":"Vị trí chân chiến thắng ở một trận đua như ngày hôm nay"},{"time":252.6,"text":"Với Sapa Novi Cup cũng vậy"},{"time":256.6,"text":"Tài đua đã vượt qua những khó khăn để thích nghi với điều kiện thi đấu và sinh hoạt tại Việt Nam"},{"time":261.9,"text":"Trong lần đầu tiên góp mặt tại Cúp truyền hình thành phố Hồ Chí Minh"},{"time":266.1,"text":"Một chiến thắng để đời của Sapa Novi Cup"},{"time":270.6,"text":"Thứ 3 liên tiếp đạt danh hiệu áo chấm đỏ vua leo núi Cúp truyền hình thành phố Hồ Chí Minh"},{"time":274.9,"text":"Ở vị trí thứ 5 là Nguyễn Hoàng Sang"},{"time":276.9,"text":"Tài đua đã nỗ lực tấn công không biết mệt mỏi trong trạng đua ngày hôm nay"}]}