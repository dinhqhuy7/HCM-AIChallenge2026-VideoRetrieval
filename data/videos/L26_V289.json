time":222.4,"until":224.3,"text":"AJINOMOTO · Eat Well, Live Well."},{"time":237.9,"until":244.7,"text":"AJINOMOTO · Eat Well, Live Well."},{"time":249.9,"until":264.3,"text":"AJINOMOTO · Eat Well, Live Well. · QUÉT MÃ QR DÊ XEM CÔNG THÚC · NOON"},{"time":264.5,"until":267.3,"text":"Nóng hi · Nónghá · Nong"},{"time":267.5,"until":269.4,"text":"aniPhom thom"},{"time":269.7,"until":273.1,"text":"Giòn tan · Giòn"},{"time":273.5,"until":278.8,"text":"ine · AJINOMOTO · mingày · Eat Well, Live Well. · MON · Eat Wed · moing · AJINOM"},{"time":279.0,"until":290.4,"text":"monngonmoingay.com · AJINOMOTO · Món Ngon Mōi Ngày · Blendy · Alagon"},{"time":291.8,"until":303.6,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Golden Scale · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Bn quyn kch bn và cu trúc · Công ty HKFilm · Ngò ri: 2 cày · Xôt Mayonnaise Aji-mayo · Tói: 5 tép · Ót bt · Bánh mi Baguette: 2 ó · Công ty H · Thc hin chương trình · chuơng trình thuc · Phi hp thc hin · DÀI TRUYÊN HìNH TP. HCM · Thc hié"}],"speech":[{"time":12.4,"text":"Chào Long"},{"time":13.6,"text":"Đố Long đây là gì?"},{"time":15.2,"text":"Tỏi"},{"time":15.5,"text":"Đây là khắc tinh của mọi loại virus"},{"time":17.7,"text":"Nhà Tuấn là uống nước tỏi, nấu ăn bỏ tỏi"},{"time":20.2,"text":"Thậm chí mẹ nấu tỏi ra để xong nữa"},{"time":22.0,"text":"Nhưng mà riết cái đó bị ghiền mùi"},{"time":23.7,"text":"Món nào cũng phải bỏ tỏi vô hết"},{"time":24.9,"text":"Thì hôm nay mình có tỏi rồi"},{"time":26.6,"text":"Thì đằng ấy phải có cái gì đó cho nó cân bằng chứ"},{"time":28.7,"text":"Có luôn, bây giờ mới mua về 2 ổ bánh mì nè"},{"time":32.4,"text":"Tính ăn bánh mì không người lái"},{"time":33.9,"text":"Bây giờ đằng kia đem tỏi lại"},{"time":35.3,"text":"Thì bây giờ mình kết hợp lại đi"},{"time":37.7,"text":"Vậy thì mình sẽ làm món bánh mì khắc tinh của mọi loại virus"},{"time":92.8,"text":"1 cái mùi nó quyến rũ lắm"},{"time":94.0,"text":"Đây"},{"time":94.4,"text":"Cho nó thật là nhuyễn ha"},{"time":96.3,"text":"Chắc là nhà mình tốn mỡ dưới lòng cái lò nướng đi"},{"time":98.0,"text":"Bây giờ"},{"time":99.1,"text":"Lửa trên lửa dưới hay là 2 lửa"},{"time":100.8,"text":"Mình sẽ dùng nướng lửa trên nha"},{"time":102.4,"text":"Mình dùng bao nhiêu độ C"},{"time":103.4,"text":"150"},{"time":104.2,"text":"Ok"},{"time":105.8,"text":"150 độ C"},{"time":107.6,"text":"Nướng lửa trên"},{"time":108.5,"text":"Và mình sẽ để lò nóng khoảng 15 phút"},{"time":110.8,"text":"Dặn 30 phút cho chắc ăn"},{"time":111.8,"text":"Đâu ra phụ web chuyên nghiệp chứ"},{"time":113.3,"text":"Bởi"},{"time":113.6,"text":"Để làm phần sốt này thì Long Thế Châu"},{"time":115.4,"text":"Ở đây là 2 muỗng canh sốt Mojana"},{"time":117.0,"text":"Aji Mayo"},{"time":118.6,"text":"Lông thích cho vào đây là nửa muỗng cà phê tiêu, phần tỏi bằm không thể thiếu được"},{"time":121.7,"text":"Nếu mà nói về tỏi thì có rất là nhiều loại tỏi khác nhau"},{"time":124.1,"text":"Ví dụ Việt Nam mình có tỏi Lý Sơn nè"},{"time":126.0,"text":"Rồi mình còn có tỏi Tây, rất là nhiều thứ luôn"},{"time":128.3,"text":"Vậy thì mình có cái cách để lựa chọn cái tỏi nào phù hợp với món ăn này không Lông?"},{"time":132.6,"text":"Chúng ta nên chọn những phần tỏi tép to"},{"time":134.5,"text":"Để khi mà chúng ta cắt ra thì giảm bớt mùi hăng của món ăn ngon hơn"},{"time":137.9,"text":"Bây giờ Lông sẽ trộn đều cái phần sốt"},{"time":142.9,"text":"Cái vị ngậy ngậy béo béo và mùi thơm của tỏi đang hòa vị vào nhau"},{"time":146.3,"text":"Đặc biệt là khi mà nướng lên thì nó còn ngon"},{"time":148.4,"text":"Rồi, phần bánh mì Long sẽ lấy"},{"time":150.6,"text":"Và quét một lớp sốt lên"},{"time":155.5,"text":"Thật sự luôn, rất hấp dẫn luôn"},{"time":157.9,"text":"Cái món này ha, cái mình làm buổi sáng"},{"time":160.4,"text":"Cái mình nướng lên"},{"time":161.6,"text":"Cái mình pha thêm ly cà phê nữa"},{"time":163.5,"text":"Hấp dẫn"},{"time":165.0,"text":"Bây giờ chúng ta sẽ rắc một ít ớt bột paprika"},{"time":168.9,"text":"Với những người mà thích ăn cay như là Minh Tuấn"},{"time":170.8,"text":"Thì Minh Tuấn sẽ trộn"},{"time":172.1,"text":"Cái ớt bột paprika với lại"},{"time":173.7,"text":"Một ít ớt bột của Việt Nam mình nữa"},{"time":175.5,"text":"Cho nó hơi cay cay"},{"time":176.5,"text":"Cái lớn là ngò rí"},{"time":180.7,"text":"Các bạn lưu ý là chúng ta sẽ nướng bánh mì ở nhiệt độ 150 độ C"},{"time":184.0,"text":"Và nướng lửa trên, nướng vàng một mặt"},{"time":185.9,"text":"Như thế thì bánh mì sẽ thơm và ngon hơn"},{"time":188.5,"text":"Với cái món ăn này thì nó phải có được cái độ giòn"},{"time":192.0,"text":"Ờ thì nó mới ngon đúng không?"},{"time":193.9,"text":"Đúng rồi"},{"time":194.1,"text":"Vậy làm sao để mà mình đạt được cái độ giòn của bánh mì khi mà mình nướng món này đây Long?"},{"time":197.7,"text":"Chúng ta lưu ý chúng ta sẽ nướng bánh mì ở nhiệt độ thật cao và nướng thật nhanh"},{"time":201.2,"text":"Để bánh mì giòn và không bị cháy"},{"time":202.8,"text":"Bây giờ mình sẽ gắp bánh mì mình bỏ lên"},{"time":208.0,"text":"Bây giờ Long sẽ cho cái phần bánh mì này vào lò nướng"},{"time":210.3,"text":"Bạn mình nướng khoảng bao nhiêu lâu Long?"},{"time":211.6,"text":"Mình nướng khoảng 3 phút"},{"time":215.1,"text":"Thơm lừng, nóng hổi luôn"},{"time":218.0,"text":"Đẹp grey luôn Long ơi"},{"time":219.9,"text":"Wow, thấy chưa"},{"time":221.3,"text":"Rồi bây giờ xong rồi, bây giờ mình ra món đây"},{"time":223.5,"text":"Đó"},{"time":225.4,"text":"Trời ơi, thơm quá là thơm"},{"time":227.8,"text":"Quá ngon"},{"time":228.8,"text":"Bây giờ mình sẽ topping lên đây một ít mayonnaise"},{"time":232.3,"text":"Đó, trang trí cho đẹp nha"},{"time":233.6,"text":"Đúng rồi"},{"time":234.6,"text":"Đảm bảo luôn là với cái món ăn này thì các em nhỏ sẽ rất là thích"},{"time":237.8,"text":"Như vậy món ăn đã xong và để tạo nên"},{"time":239.5,"text":"Một bữa ăn hoàn chỉnh"},{"time":240.4,"text":"Chúng ta có thể dùng bánh mì này kèm với lại súp và salad của món ngon mỗi ngày"},{"time":245.2,"text":"Phải nói là cái món ăn này nội bà mới vừa lấy ra khỏi lò"},{"time":248.5,"text":"Cho là đã rất thơm rồi, cực kỳ dễ làm"},{"time":250.9,"text":"Tuy nhiên nếu mà bạn nào chúng ta không biết công thức"},{"time":253.5,"text":"Thì ngay bây giờ trên màn hình của chúng tôi đang có một QR code"},{"time":256.0,"text":"Quý vị có thể quét và công thức sẽ hiện ra"},{"time":258.2,"text":"Chúng ta sẽ làm món này rất là nhanh chóng thôi"},{"time":260.1,"text":"Cả nhà từ lớn đến nhỏ Minh Tuấn đảm bảo luôn đều rất là mê cho bà xem"},{"time":264.4,"text":"Miếng bánh mì nóng hổi, sốt mayonnaise trụng tỏi xem xem, thơm thơm"},{"time":269.1,"text":"Cắn một miếng, giòn tan trong miệng, vô cùng mê ly"},{"time":272.9,"text":"Món ăn ngày hôm nay là một món ăn vừa nhanh, vừa gọn, vừa ngon, vừa giòn"},{"time":277.4,"text":"Nên các bạn làm thử ngay nha"},{"time":278.6,"text":"Và công thức thì luôn có trên những kênh rất quen thuộc của chương trình Món ngon mỗi ngày"},{"time":282.6,"text":"Đó chính là Youtube, Website và Fanpage của chương trình"},{"time":286.2,"text":"Các bạn hãy truy cập vào, thực hiện ngay món ăn này tại nhà để chinh phục các thành viên trong gia đình nha"}]}