{"time":297.8,"until":302.4,"text":"XANH · Clip: · viettel · tuoitre · GTAO · VIET NAM · PHUONG 14 QUAN 10 · 2023\" · QUAN 10 · STT · HO VA TEN"},{"time":314.2,"until":332.4,"text":"Herbalife · Tác gi: Tn Lc · Herife · tuitreTV"}],"speech":[{"time":11.2,"text":"Tôi là Nguyễn Thắng Lộc, là founder và CEO công ty tái cháy cà phê Lộc Nhân"},{"time":23.5,"text":"Quảng Thăng Lộc là người tốt chết từ dụng cháy chung cư Carina"},{"time":27.6,"text":"Lúc mà chạy xuống thì lòng nghĩ là nếu như ông chờ cho mình sống một lần nữa"},{"time":31.0,"text":"thì mình sẽ làm một điều gì đó bằng ước mơ và hoài bảo của mình"},{"time":35.9,"text":"mà điều đó có thể giúp được cho xã hội dù chỉ một ít thôi"},{"time":39.1,"text":"Để từ bỏ một công việc ngân hàng mà gắn bó nó mười mấy năm"},{"time":42.2,"text":"thì cũng không phải là một điều dễ dàng"},{"time":44.0,"text":"bởi vì ở ngân hàng thật sự rất ổn định"},{"time":46.7,"text":"Tuy nhiên là cái gì ổn định quá nó sẽ trở thành không ổn"},{"time":50.5,"text":"Bởi vì ước mơ và cái hoài bảo của Lộc là làm ra một cái công việc gì đó"},{"time":54.7,"text":"Mà có thể tạo ra giúp cho được nhiều người cùng làm với mình"},{"time":58.1,"text":"Cứ hằng ngày đi uống cà phê thì thấy nó bỏ đi rất là phí"},{"time":63.2,"text":"Cho nên là thôi mình chọn cái khởi nghiệp nào nó gần gũi với mình hơn"},{"time":67.0,"text":"Mà nó thói quen rất là đời thường của mình"},{"time":69.5,"text":"Nên Lộc chọn là cái cà phê"},{"time":77.7,"text":"Bây giờ gọi không phải là gọi là thành công hay không thành công"},{"time":79.7,"text":"Nhưng mà tín hiệu trong vòng 6 tháng một lập khởi nghiệp như thế này"},{"time":83.0,"text":"Được tất cả mọi người quan tâm về sản phẩm"},{"time":86.0,"text":"Thì đó là một tín hiệu nấp thấp"},{"time":88.0,"text":"Và danh thu không có lỗ"},{"time":90.4,"text":"Đó là điều rất là vui"},{"time":91.6,"text":"Và vui hơn"},{"time":93.2,"text":"Vui hơn nữa chính là"},{"time":94.9,"text":"Khi đi chia sẻ này cho bà con mọi người"},{"time":96.7,"text":"Mọi người nấp thấp"},{"time":98.2,"text":"Và mọi người làm được thì lắm đất vui"},{"time":100.3,"text":"Nó đi theo đúng cái định hướng của mình"},{"time":102.0,"text":"Ngay từ lúc ban đầu là chia sẻ và nhân bản"},{"time":104.9,"text":"Đây là cái bột cây bờ lời"},{"time":106.4,"text":"Còn cái bã cà phê thì mình có thể xin ở các quán"},{"time":109.5,"text":"rất là khó hiện tại đang rất là miễn phí để tránh mất thời gian của mọi người thì lọc sẽ trộn sẵn"},{"time":113.4,"text":"như thế này rồi cắt như thế này ra thì để hướng dẫn bà con làm á thì chúng ta cần cái khu này"},{"time":122.2,"text":"cái khu này cũng mua rất dễ có mấy chục nghìn cái thôi thì chúng ta để vô thì khi để vô bà"},{"time":127.3,"text":"con lưu ý thao tác là chúng ta ấn xuống để làm cái tâm để làm cái tâm thì chúng ta đẩy lên tại"},{"time":134.7,"text":"để cái bột lên cho nó tràn đầy cái khuôn"},{"time":138.8,"text":"chúng ta nên ấn"},{"time":140.5,"text":"ấn xuống rồi ở đây trước đều ở sau đều một cái nữa"},{"time":144.6,"text":"cái kỹ thuật mà khi ấn xuống thì chúng ta phải giữ cái khuôn thật chặt"},{"time":148.3,"text":"giữ ra chặt như thế này"},{"time":149.8,"text":"Còn cái tay này chúng ta ấn xuống, ấn nhẹ nhàng thôi, không cần phải ấn mạnh hay đè mạnh gì đâu"},{"time":153.9,"text":"nó sẽ bể bể khuôn"},{"time":155.2,"text":"thì chúng ta giữ ở đây khoảng 5 đến 7 giây tối thiểu"},{"time":158.5,"text":"thì chúng ta buông ra"},{"time":160.0,"text":"chúng ta dở lên và khi mà đóng cái này xuống thì chúng ta giữ cái tay này thật chặt"},{"time":163.5,"text":"bởi vì cái tay này không chặt"},{"time":164.9,"text":"thì cái viên nén nó chạy tới trên lui"},{"time":166.0,"text":"nó sẽ bị ném"},{"time":167.5,"text":"đó"},{"time":167.8,"text":"nó nhẹ ra là nó ra"},{"time":168.9,"text":"như thế này"},{"time":170.1,"text":"bằng phẳng"},{"time":170.7,"text":"không có bị gì hết"},{"time":171.6,"text":"thì chúng ta mang đi phơi thôi"},{"time":173.3,"text":"đây là một lệnh lệnh liệu mới"},{"time":175.2,"text":"là lệnh liệu từ cái"},{"time":177.2,"text":"bãi cà phê kết hợp với cái bột cây vờ lời"},{"time":180.6,"text":"và hoàn toàn không dùng hóa chất"},{"time":183.6,"text":"không chỉ nó in hình được"},{"time":185.4,"text":"để lưu niệm được"},{"time":186.3,"text":"mà nó còn có phục dụng để khử mùi được"},{"time":189.0,"text":"tại vì bãi cà phê nó có"},{"time":190.9,"text":"khả năng là khử hút mùi rất hiệu quả"},{"time":192.7,"text":"thì đối với"},{"time":193.7,"text":"đối với các viên nén"},{"time":195.3,"text":"Có thể lớn như thế này thì chúng ta dùng chân bài, đây là một sản phẩm mới."},{"time":199.0,"text":"Còn có thể nhỏ như thế này thì chúng ta có thể bỏ thêm bộ tủ lặn nè,"},{"time":201.6,"text":"tủ sách nè, tủ quần áo nè, cấp xe nè, xe hơ."},{"time":205.3,"text":"Thì nó hút cửa mua rất hiệu quả, mà nó an toàn."},{"time":207.8,"text":"Bởi vì sản phẩm này rất là tham thiện ngôi trường."},{"time":210.0,"text":"Thông điệp ở sản phẩm của Binh Lập sản xuất ra thì nó mang hai câu chuyện."},{"time":215.5,"text":"Giống như là ở đây là hồ gơm, thì câu chuyện văn hóa."},{"time":218.6,"text":"Thay vì chúng ta in trên nền liệu khác"},{"time":221.2,"text":"Như Powder Night thì chúng ta sao không in trên nền liệu này"},{"time":223.6,"text":"Thì đây là một câu chuyện văn hóa"},{"time":225.2,"text":"Giúp cho cái sản phẩm đi xa hơn"},{"time":226.9,"text":"Câu chuyện văn hóa danh lâm thắng cảnh của đất nước Việt Nam của mình đi xa hơn"},{"time":230.6,"text":"Và thứ hai"},{"time":231.8,"text":"Thì đây là một câu chuyện môi trường"},{"time":233.4,"text":"Chúng ta tái chế và tất cả các loại"},{"time":235.1,"text":"Ra sản phẩm như thế này"},{"time":236.9,"text":"Thì hai thông điệp"},{"time":238.2,"text":"Giá trị môi trường và giá trị văn hóa nó nằm ở đây"},{"time":240.5,"text":"Đó chính là một cái điểm sáng tạo và nổi mới"},{"time":244.6,"text":"Các bạn có thể đọc nó"},{"time":247.8,"text":"Không bao giờ vỡ"},{"time":249.2,"text":"đừng cố ý đập đập nó để để bởi thôi thì nó xong bởi còn này là đảm bảo rơ rớt không bởi rơ rớt"},{"time":255.4,"text":"từ tầng 10 xuống không bể nát xe cán cũng không hề bể nát luôn đó là đậu bền thì Lộc cũng mong"},{"time":260.9,"text":"muốn là một điều đó là một hướng đến một cái việc mà chưng bài mang câu chuyện văn hóa và đậu bền"},{"time":265.2,"text":"độc đáo hơn chính là đậu bền thì chúng ta cứ nghĩ là mỗi quán cà phê thay vì thải ra bỏ một rác thì"},{"time":270.4,"text":"thôi tại quán tái chế bảo cà phê luôn giống như đang ngồi ở quán cà phê này thì mã cà phê đưa ra"},{"time":275.0,"text":"Thì Lộc có thể thái chế thành những sản phẩm này ngay tại chủ"},{"time":277.5,"text":"Các chị bên Hội Liên Phụ Nữ các phương, quận"},{"time":279.6,"text":"Mà đã triển khai là ở quận 1 và quận 3"},{"time":284.8,"text":"Thì các buổi chia sẻ đó thì sẽ lan tỏa rất là nhiều cho các chị em"},{"time":288.6,"text":"Và nói lại luôn là chính là ở đâu cần thì Lộc đến"},{"time":292.2,"text":"Hoàn toàn miễn phí, chỉ không hề thu phí gì cả"},{"time":294.8,"text":"Chỉ cho bà con cách làm, cách trộn bột, cách nén kỹ thuật ra làm sao"},{"time":299.3,"text":"Bởi vì trong thời gian mình mầy mò, mình nghiên cứu"},{"time":301.3,"text":"Thì gia đình mình ủng hộ rất nhiều"},{"time":303.4,"text":"Mà người mà ủng hộ mình lớn nhất, nhiều nhất chính là vợ mình"},{"time":309.6,"text":"Bởi vì phải chăm con nè"},{"time":312.2,"text":"Rồi phải vừa kiếm tiền và làm những việc khác"},{"time":317.7,"text":"Và phụ mình những cái đơn hàng online"},{"time":322.9,"text":"Rồi đi chợ mua sắm công cụ dụng cụ tiết mình để dành thời gian nhiều nhất"},{"time":327.7,"text":"Cho mình bày mòn mình nghiên cứu ra sản phẩm tái chế từ bạc cà phê"}]}