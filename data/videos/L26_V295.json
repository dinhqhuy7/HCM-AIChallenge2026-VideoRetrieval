},{"time":36.8,"text":"Ủa? Vậy là Phương không mua hết"},{"time":39.1,"text":"Chứ ai nữa"},{"time":39.7,"text":"Hèn chi"},{"time":40.4,"text":"Ủa nhưng mà sao mua nhiều cánh gà quá vậy?"},{"time":42.4,"text":"Hôm nay cánh gà rất là to mà lại tươi nữa"},{"time":45.1,"text":"Mật mỹ nha"},{"time":46.4,"text":"Ê quên, mỹ mật nha"},{"time":49.8,"text":"Vào bếp liền nha"},{"time":50.8,"text":"Đúng rồi"},{"time":53.3,"text":"Cánh gà chiên nước mắm"},{"time":54.7,"text":"Sâu đậm vị thân thương"},{"time":72.7,"text":"Mình chào các bạn đang đến với chương trình"},{"time":74.5,"text":"Món ngon mỗi ngày"},{"time":75.4,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":79.6,"text":"Ở đây có cà chua, dưa leo và salad"},{"time":82.1,"text":"Rồi nhờ Minh Phương cắt dùm nha"},{"time":83.9,"text":"Đồng ý"},{"time":84.4,"text":"Phần dưa leo thì chúng ta sẽ cắt lát xéo"},{"time":86.5,"text":"Dày hay mỏng thì tùy ý gia đình của mình"},{"time":89.3,"text":"Còn phần cà chua thì bây giờ chúng ta sẽ cắt khoanh tròn"},{"time":96.4,"text":"Và bây giờ tiếp theo"},{"time":97.5,"text":"Phước Hương sẽ hướng dẫn cho quý vị"},{"time":98.7,"text":"Một cái nguyên liệu chính trong món ăn ngày hôm nay"},{"time":100.6,"text":"Đó chính là cánh gà"},{"time":102.0,"text":"Chúng ta sẽ chọn cánh gà công nghiệp cho món ăn ngày hôm nay"},{"time":104.7,"text":"Để cánh gà được mềm hơn và nhiều thịt hơn"},{"time":107.5,"text":"Khi ăn sẽ ngon hơn"},{"time":108.7,"text":"Cánh gà khi mà chúng ta mua về thì chúng ta chặt làm 3 đoạn vừa ăn"},{"time":112.5,"text":"Rửa sạch để ráo"},{"time":113.7,"text":"Hân sẽ cho hết cái phần cánh gà vô đây"},{"time":115.8,"text":"Cho vào đây nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":118.3,"text":"Nửa muỗng cà phê tiêu"},{"time":119.7,"text":"Và một muỗng cà phê nước cốt tỏi"},{"time":122.0,"text":"Và bây giờ chúng ta sẽ trộn đều lên cho thấm gia vị"},{"time":125.0,"text":"Bây giờ Phước Hân sẽ đặt lên trên bếp một cái chảo dầu để chúng ta chiên cánh gà"},{"time":128.6,"text":"Trong khi mà chúng ta đang đợi phần dầu nóng"},{"time":130.7,"text":"Thì Phước Hương sẽ hướng dẫn cho quý vị"},{"time":132.3,"text":"Chúng ta sẽ tẩm cái phần cánh gà này"},{"time":134.4,"text":"Qua gia vị nêm sẵn"},{"time":136.0,"text":"Ajiquit bột tẩm khô chiên giòn"},{"time":137.7,"text":"Ở đây Phước Hương sẽ sử dụng bột gói"},{"time":139.9,"text":"Bây giờ chúng ta sẽ dùng tay"},{"time":141.9,"text":"Phủ đều phần cánh gà"},{"time":143.4,"text":"Sẽ lần lượt cắp cánh gà vào"},{"time":145.9,"text":"Chúng ta phải chi nhiều dầu đúng không Phước Hương"},{"time":147.9,"text":"Đúng rồi đó Minh Phương"},{"time":148.9,"text":"Như vậy thì món ăn sẽ giòn và chín đều hơn"},{"time":151.6,"text":"Minh Phương thấy khi sử dụng gia vị nêm sẵn"},{"time":153.6,"text":"Ajiquit bột tẩm khô chiên giòn"},{"time":155.2,"text":"Thì những cái cánh gà của chúng ta được áo một cái lớp bột rất là mỏng"},{"time":158.2,"text":"Chứ không có bị quá dày"},{"time":159.7,"text":"Đúng không Phước Hưng?"},{"time":160.7,"text":"Và đối với món ăn ngày hôm nay thì chúng ta có thể hấp cánh gà trước"},{"time":163.6,"text":"Rồi chúng ta đem chiên"},{"time":164.9,"text":"Như vậy thì giúp cho cánh gà chín triệt để hơn"},{"time":167.8,"text":"Và khi ăn sẽ mềm mại hơn"},{"time":169.4,"text":"Như vậy là chúng ta sẽ lưu ý 2 cách làm"},{"time":171.7,"text":"Và các bạn có thể làm cách nào cũng được nha"},{"time":173.7,"text":"Trong quá trình chiên thì chúng ta có cần lưu ý về lửa như thế nào không Phước Hưng?"},{"time":177.8,"text":"Đối với món cánh gà ngày hôm nay thì các bạn nên lưu ý"},{"time":180.2,"text":"Chúng ta chỉ chiên với lửa vừa thôi"},{"time":182.0,"text":"Như vậy thì cánh gà sẽ chín đồng đều"},{"time":184.1,"text":"Và khi nào mà cánh gà gần chín"},{"time":186.3,"text":"Thì chúng ta sẽ tăng lửa lớn lên"},{"time":187.9,"text":"Như vậy thì cánh gà sẽ giòn lâu hơn"},{"time":189.8,"text":"Bây giờ cánh gà đã vừa vàng tới rồi"},{"time":192.1,"text":"Phước Hưng sẽ cho ra"},{"time":194.5,"text":"Nhìn thôi là đã cảm nhận được độ giòn"},{"time":196.8,"text":"Của phần da gà rồi các bạn"},{"time":198.3,"text":"Bây giờ chúng ta sẽ cho qua 1 tờ giấy thấm dầu"},{"time":201.0,"text":"Đặt lên trên bếp 1 cái chảo để chúng ta làm sốt"},{"time":203.3,"text":"Chảo cũng đã nóng"},{"time":204.5,"text":"Hưng sẽ cho vào đây khoảng 1 muỗng canh dầu ăn"},{"time":206.6,"text":"Dầu nóng Hưng sẽ cho vào đây 1 ít hành tỏi băm nạt"},{"time":209.6,"text":"Để chúng ta phi thơm"},{"time":212.7,"text":"Hành tỏi cũng đã thơm"},{"time":213.9,"text":"Phước Hưng sẽ cho gia vị vào đây"},{"time":215.2,"text":"Đầu tiên Hưng sẽ cho vào đây 1 muỗng canh nước mắm"},{"time":218.1,"text":"3 muỗng canh nước lọc"},{"time":220.2,"text":"Cho vào đây 1 muỗng cà phê đường"},{"time":222.5,"text":"Và nửa muỗng cà phê hạt nêm"},{"time":224.4,"text":"Azi ngon gà"},{"time":225.2,"text":"Cuối cùng Hưng sẽ cho vào đây 1 ít tiêu"},{"time":228.1,"text":"Xong"},{"time":228.5,"text":"Bây giờ thì đảo đều lên"},{"time":229.8,"text":"Wow cái phần nước sốt chúng ta phải để lửa lớn đúng không Phước Hưng"},{"time":233.8,"text":"Đúng rồi"},{"time":234.4,"text":"Để cho nó kẹo lại"},{"time":235.8,"text":"Và bây giờ chúng ta sẽ giảm lửa nhỏ lại nè"},{"time":237.9,"text":"Và cho hết cái phần cánh gà vào"},{"time":240.1,"text":"Và chúng ta sẽ sóc đều"},{"time":244.0,"text":"Wow hấp dẫn quá"},{"time":246.1,"text":"Các bạn có thể dùng điện thoại di động quét mã QR code đang hiển thị trên bàn hình để xem lại công thức của món ăn này các bạn nha"},{"time":252.7,"text":"Rồi và bây giờ chúng ta sẽ tắt bếp"},{"time":254.9,"text":"Cuối cùng Hương sẽ cho vào đây một ít hành lá nè"},{"time":258.1,"text":"Rồi vậy là xong"},{"time":259.2,"text":"Quá ngon"},{"time":263.7,"text":"Wow chính cái phần nước sốt kẹo kẹo nha"},{"time":266.6,"text":"Áo lấy vào mặt ngoài của từng cái cánh gà trông rất là hấp dẫn các bạn ơi"},{"time":270.9,"text":"Cuối cùng Hân sẽ cho lên đây một ít ớt xoăn nè để tăng thêm màu sắc cũng như là trang trí cho món ăn bắt mắt thêm"},{"time":277.8,"text":"Và để tạo nên một bữa ăn dinh dưỡng thì chúng ta có thể kết hợp với món canh cua chả cá sẽ rất là phù hợp"},{"time":283.5,"text":"Cánh gà trong thấm ngoài thơm, da giòn thịt mứt thân thương món nhà"},{"time":289.0,"text":"Đừng thấy món quá quen mà không làm nha các bạn"},{"time":291.9,"text":"Hãy thử làm theo công thức của món ngon mỗi ngày"},{"time":294.1,"text":"Đảm bảo các bạn sẽ có một món cánh gà chiên nước mắm vừa thân thuộc vừa tươi mới"},{"time":298.8,"text":"Để xem lại công thức của món ăn ngày hôm nay và nhiều món ăn ngon khác"},{"time":302.1,"text":"thì các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":306.6,"text":"Bây giờ thì xin chào tạm biệt và hẹn gặp lại"}]}