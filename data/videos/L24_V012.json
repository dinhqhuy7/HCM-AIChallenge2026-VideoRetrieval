]],[2340,93.6,13,[["L24_V012",238,9.5,1],["L24_V012",1650,66.0,9],["L24_V012",969,38.7,5],["L24_V012",672,26.8,3],["L24_V012",1956,78.2,11],["L24_V012",1389,55.5,7],["L24_V004",19827,793.0,91],["L24_V035",391,13.0,null],["L24_V024",15588,519.6,45],["L24_V008",11202,448.0,40],["L30_V046",4798,191.9,null],["L24_V003",17726,709.0,87]]]],"onScreen":[{"time":0.1,"until":5.1,"text":"ChoLon · 2024 · GIAI · COP CHOLON · CUP CHO LON HTV · 2NGAY · LAN SU RONG · LAN-SU · 10CM · 1DCM · 2100 · S MO RÓNG · VIM 2024 · quAnS · GIÁI · OCM · 10EM · UIN 5 MO HÓNG · SMRONG · AnS · CHOLUN HTV"},{"time":5.3,"until":13.5,"text":"HITASA · XEDAP-XEDA · HICA · 精英堂 · XEBA-XEE · JTINH ANHI · TULO · THÂNTÁNG · ÁNG · 13 Lë Qua · EA XE · 3 Lé Quaun · UYHELA · XEDA · 34XE · HÀÃNG"},{"time":13.7,"until":24.1,"text":"精英堂 · ANH · TINH · TINH ANHJ · NGAY · 精美堂 · HANHJ · Anl"},{"time":24.3,"until":29.2,"text":"HITASA · ANH · XEDAP-XEDA · XEPP-XEDA · TINH · THÂN TÁNG · TÄNG · ANP · HICA"},{"time":29.4,"until":33.9,"text":"精英堂 · TINH · LTINH ANH · 2NGAY · TINH ANHI · 000 · TIN' · ITINI"},{"time":34.1,"until":43.5,"text":"HO CHI MINB CITY TELEVISION · TNHAN · HI CE LINE CITY TELIVSIN"},{"time":51.0,"until":59.7,"text":"THG · ANH · TIN · HITASA · HISI · DUONG · THAN NG · XEDAP DIÉN · HISA · TSI · HEASA · BO OB KINE CITY TELEVHRIN · THANIG · XE -E DAP DIEN"},{"time":59.9,"until":64.2,"text":"URONG · 4TV"},{"time":64.4,"until":67.6,"text":"TIN · 精英堂 · NGAY · TINH ANHI"},{"time":67.8,"until":75.4,"text":"NO CHI MINE CITY TELEVESION. · HO CHI MINE CITE TELEVEBIER · HO CHI WINE CITY TELEVISIN · HO ONI HINE CITY TELEYTARN"},{"time":81.2,"until":89.9,"text":"CHIP · TINH · NGAY · LTINH · LTINH ANA · CHI PHIEU · 2roy · 2moy"}],"speech":[{"time":3.8,"text":"Ngày nhỏ mình sẽ không để ý nhiều, mình sẽ nghĩ là nhảy nhảy nhảy vậy thôi là rất là đơn giản"},{"time":8.1,"text":"Nhưng mà khi mà lớn rồi mình có cái sự hiểu biết rồi á"},{"time":11.0,"text":"Thì mình nhìn vô mình thấy là rất là nguy hiểm luôn"},{"time":13.5,"text":"Lúc đầu có mấy anh em mua mình rất là hào hức, rất là ngưỡng mộ"},{"time":19.0,"text":"Và mình muốn thử và khi thử thì thật sự là khó và mệt thật sự"},{"time":23.8,"text":"Cái đầu lân nhỏ đầu chơi của con nít thì nó rất là nhẹ"},{"time":26.7,"text":"Còn cái đầu lân này thì rất là nặng luôn mọi người"},{"time":29.1,"text":"Phải giữ nguyên một tư thế không như thế nào"},{"time":30.9,"text":"Mà trong suốt bài diễn 5 phút mấy là cái lưng gọi là muốn liệt luôn á"},{"time":33.8,"text":"Cái động tác mà nhìn mọi người thì mấy cái động tác nhảy qua nhảy lại thì rất là khó"},{"time":38.0,"text":"Nhưng mà mình đứng ở đây thôi chỉ cần nhấc cái người phía trước mình lên thôi là đối với em nó đã quá khó rồi"},{"time":43.4,"text":"Chỉ mấy phút ở trên mấy cái hành sắc này thôi"},{"time":46.4,"text":"Nhưng mà mấy anh em phải tập phải đổi đi bằng mù hôi, nước mắt, nhiều khi bằng tánh mạng của mình nữa"},{"time":50.6,"text":"Bởi vì nó quá là cực đi và nó quá là khó"},{"time":53.2,"text":"Bởi vì họ luyện tập rất là nhiều năm thì mới có thể thể hiện được những cái màn như này"},{"time":59.5,"text":"Rất là cực khổ và có thời gian luyện, có 2 thứ đó là kiên nhẫn và đam mê thì mới theo được cái môn này"},{"time":64.0,"text":"Rất là nể phục các nghệ sĩ trong đại lương Sư Đồng"},{"time":67.4,"text":"Hy vọng người sẽ yêu thương và ủng hộ mãi mãi để bộ môn này có thể phát triển"},{"time":71.7,"text":"Cũng như là thế hệ sau biết đến bộ môn này nhiều hơn, đăng tỏa nhiều hơn"},{"time":75.2,"text":"Ai yêu thích những loại hình nghệ thuật giống như này thì mọi người có thể tới với lại công viên Văn Lan"},{"time":80.8,"text":"Có một cái giải mà vô cùng lớn nữa đó là chuyên nghiệp"},{"time":83.9,"text":"Và đặc biệt là họ tụ rất là nhiều những đoàn lân uy tín và biểu diễn là giải thế giới nữa"}]}