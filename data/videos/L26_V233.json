me":144.4,"until":145.6,"text":"moingày"},{"time":148.8,"until":149.5,"text":"moingày"},{"time":149.7,"until":151.4,"text":"H MÀl 1/2m · VÒ CHANH MÀ"},{"time":151.7,"until":154.2,"text":"Ô Chanh mÀi 1/2m"},{"time":155.8,"until":157.9,"text":"moingày · Ajingon"},{"time":163.1,"until":167.2,"text":"MON · moingày · Eat Well, L"},{"time":167.6,"until":169.4,"text":"mingày · MON"},{"time":172.1,"until":173.0,"text":"mingày · Blendy · Eat Well, Live Well."},{"time":179.4,"until":180.0,"text":"Eat Well, Live Well. · Onl · moingày"},{"time":190.9,"until":196.2,"text":"CHO MÓN BÁNH · Eat Well, Live Well. · RÁC VÒ CHANH XANH LÊN LÓP KEM · MON · DÊ TÄNG MÙI THOM · moingày"},{"time":200.0,"until":202.3,"text":"Eat Well, Live Well. · moingày"},{"time":207.2,"until":208.2,"text":"Eat Well, Live Well. · moingày"},{"time":215.1,"until":218.1,"text":"Eat Well, Live Well. · moingày"},{"time":221.9,"until":224.7,"text":"Eat Well, Live Well. · moingày"},{"time":244.7,"until":247.0,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC · MON · moingay · m&ingily"},{"time":247.3,"until":248.9,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC · Eat Well, Live Well. · moingày"},{"time":249.5,"until":253.5,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC"},{"time":253.9,"until":259.0,"text":"BLENDY · SINH TÓ · NGON HON · Eat Well. Live Well. · moingày · DÁU 3MÀU · KHI THUÒNG THUC · CÙNG · CÚNG"},{"time":259.4,"until":262.4,"text":"Xp mêm · Xop · xpm"},{"time":265.1,"until":269.7,"text":"Beo · Beobéo"},{"time":270.1,"until":273.6,"text":"Eat Wel, Live · mingày · AJINOM · NOMOTO · BanhRan · MON · Live Wel · Eat we"},{"time":274.4,"until":282.8,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · moingay"},{"time":283.4,"until":295.6,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · Whipping dang binh xit · · Bt bánh rán pha sn v truyn thng: 200g · Phi hp thc hin · ·Chanh: 1trái · Công ty H · ·Dáu táy: 50 g · Thc hin chưng trình · · Xoài cát Hòa Lc: 1 trái · chuơng trình thuc · Thc hié · • Húng li, đưòng bt · DÀI TRUYÊN HìNH TP. HCM"}],"speech":[{"time":11.9,"text":"Nếm vị ngọt ngào, đón hè rực rỡ với pancake xoài kem tươi"},{"time":31.4,"text":"Chào mừng các bạn đang đến với chương trình Món Ngon Mỗi Ngày"},{"time":34.1,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":38.1,"text":"Chúng ta sẽ cùng nhau đếm lại một món ăn kết hợp giữa bánh pancake với trái cây"},{"time":41.5,"text":"Bên cạnh việc cung cấp cho chúng ta những dưỡng chất cần thiết cho cơ thể"},{"time":45.2,"text":"thì cũng góp phần làm tăng sức đề kháng của mình nữa"},{"time":47.3,"text":"Nên ngay bây giờ, Minh Tuấn và cả cô Tu Hà mời tất cả các bạn"},{"time":50.8,"text":"chúng ta sẽ cùng vào bếp để làm món ăn của ngày hôm nay"},{"time":52.8,"text":"Đầu tiên thì chúng ta sẽ dùng bột bánh rán pha sẵn vị truyền thống"},{"time":57.0,"text":"Một gói"},{"time":57.8,"text":"Tiếp theo thì mình sẽ cho nước vào"},{"time":59.6,"text":"Theo hướng dẫn trên bao bì"},{"time":61.3,"text":"Đó, bột pha xong thì nó sẽ hơi đặc như thế này"},{"time":63.8,"text":"Rồi em cho cô cái chảo lên và cô sẽ lấy một cái khăn"},{"time":67.5,"text":"Đó"},{"time":68.4,"text":"Cô sẽ đổ bánh"},{"time":69.4,"text":"Cô sẽ nhờ Tướng là sơ chế cái phần trái cây bên kia"},{"time":72.3,"text":"Dâu"},{"time":73.2,"text":"Rồi mình sẽ cắt bỏ cuốn"},{"time":74.7,"text":"Đó"},{"time":76.1,"text":"Rồi, vậy Tướng cắt ha"},{"time":77.1,"text":"Rồi, sau khi mà chúng ta làm nóng chảo xong"},{"time":79.8,"text":"Thì chúng ta sẽ hạ nhiệt bằng cách là chúng ta để qua một cái khăn ẩm"},{"time":82.8,"text":"khoảng 10 giây. Sau khi mà hạ nhiệt xong"},{"time":85.0,"text":"thì bây giờ chúng ta sẽ đặt lại cái chảo lên trên bếp"},{"time":87.1,"text":"và mình sẽ múc bột đổ vào chảo"},{"time":91.1,"text":"Em đã cắt xong cái phần dâu"},{"time":92.5,"text":"Tôi sẽ trở lại cái mặt lại"},{"time":94.9,"text":"Quá đẹp luôn"},{"time":95.7,"text":"Và bây giờ thì mình sẽ chọn xoài"},{"time":98.0,"text":"Chúng ta sẽ chọn xoài cát hòa lọc"},{"time":100.3,"text":"vừa chín tới, có vị chua, ngọt"},{"time":102.5,"text":"phù hợp với món bánh"},{"time":103.6,"text":"Rồi xong rồi đó, bánh đầu tiên"},{"time":105.7,"text":"giờ tôi sẽ lấy ra"},{"time":107.5,"text":"Tiếp tục chúng ta sẽ hạ nhiệt chảo"},{"time":109.3,"text":"và chúng ta sẽ đổ bánh tiếp tục"},{"time":111.1,"text":"Như vậy là món ăn ngày hôm nay của chúng ta thì mình thấy là có dâu"},{"time":113.7,"text":"Thì dâu có rất là nhiều những cái vitamin ở bên trong"},{"time":116.3,"text":"Mà đặc biệt nhiều những chị em phụ nữ mà yêu thích làn da đẹp"},{"time":119.7,"text":"Hay là bóc dáng đẹp thì mình rất là quan tâm"},{"time":122.2,"text":"Và trong xoài thì cũng rất là giàu vitamin B6"},{"time":124.6,"text":"Giúp tăng cường cái hoạt động của tế bào não nè"},{"time":127.7,"text":"Để phòng ngừa cái bệnh Alzheimer"},{"time":129.4,"text":"Bây giờ xoài này thì mình sẽ cắt mỏng dây được cho cô nha"},{"time":132.5,"text":"Rồi"},{"time":134.5,"text":"Quá ngon mọi người ơi"},{"time":139.1,"text":"Rồi, giờ cái này cũng xong rồi"},{"time":140.6,"text":"Cô sẽ lấy ra"},{"time":142.1,"text":"Tiếp tục thì chúng ta sẽ đổ những cái bánh bằng nhau cho đến khi nào hết bột"},{"time":145.6,"text":"Cô ơi còn phần chanh này của mình thì mình sẽ làm gì đây cô ạ"},{"time":148.3,"text":"Em mài vỏ chanh giúp cô"},{"time":149.5,"text":"Và mình chỉ mài cái phần xanh thôi"},{"time":151.3,"text":"Đúng rồi lấy mài phần xanh thôi"},{"time":152.1,"text":"Không mài vô trong cái phần trắng thì mình nó sẽ bị đắng"},{"time":154.3,"text":"Cô cần nhiều vỏ chanh không cô"},{"time":155.5,"text":"Cô cần chừng nửa muỗng cà phê à"},{"time":157.5,"text":"Dạ"},{"time":158.1,"text":"Rồi đó giờ cô đổ bánh xong rồi đó"},{"time":160.1,"text":"Đây em cũng xong hết luôn cả cái phần vỏ chanh"},{"time":162.7,"text":"Đây em gửi cô"},{"time":164.4,"text":"Cảm ơn Tuấn"},{"time":165.5,"text":"Trời ơi những trái cây rất là đẹp ha"},{"time":169.5,"text":"Đặt mỗi một cái bánh lên trên cái dĩa này"},{"time":171.6,"text":"Tuấn ơi cô nhờ Tuấn á Tuấn"},{"time":172.9,"text":"Thịt một ít kem lên vừa gần gần cái bánh thôi nha, không dày quá nha"},{"time":176.8,"text":"Với lại cái đây là một cái kem dạng bọt nên là nó sẽ xẹp xuống nữa"},{"time":179.8,"text":"Sau đó thì chúng ta sẽ đặt lên một lớp xoài"},{"time":182.4,"text":"Tiếp theo thì Tướng sẽ chấm một ít chấm kem ở trên đó nữa"},{"time":186.0,"text":"Trước khi mà mình để dâu thì mình sẽ rắc lên đây một ít giỏ chanh"},{"time":190.7,"text":"Các bạn lưu ý là chúng ta sẽ rắc giỏ chanh xanh lên kem để tạo hương vị đặc trưng cho món bánh nha"},{"time":196.1,"text":"Và tiếp theo mình sẽ làm dâu"},{"time":197.6,"text":"Đúng rồi"},{"time":198.6,"text":"Bên kia nhiều dâu hơn không cô?"},{"time":200.0,"text":"Đây, em xê miếng dâu"},{"time":202.3,"text":"Bây giờ mình sẽ chấm điểm thêm"},{"time":203.7,"text":"Ít ít thôi nha"},{"time":204.6,"text":"Mặc dù mình thích kem"},{"time":205.9,"text":"Bây giờ mình đặt cái bánh thứ 2 lên"},{"time":209.5,"text":"Ừ đẹp quá"},{"time":210.7,"text":"Ít kem ở chính giữa thôi"},{"time":212.2,"text":"Để cô dán cái cây lên nữa"},{"time":214.4,"text":"Những miếng xoài này bây giờ mình sẽ gấp lại"},{"time":222.3,"text":"Mình sẽ kẻ vô mấy miếng dâu"},{"time":224.4,"text":"Rồi"},{"time":225.2,"text":"Có người thích ăn xoài nhiều"},{"time":226.9,"text":"Cho nên cho xoài nhiều quá kìa"},{"time":229.1,"text":"Rõ ràng luôn á cô"},{"time":230.1,"text":"Em thích ăn xoài"},{"time":231.0,"text":"Rồi mình rắc thêm xíu đường bột"},{"time":236.1,"text":"Rồi"},{"time":237.8,"text":"Cực kỳ hấp dẫn"},{"time":239.0,"text":"Giống như là mình đi ra về một cái nhà hàng sang trọng mà mình làm cái món này"},{"time":242.8,"text":"Nhưng mà thật ra nó rất là đơn giản mọi người ạ"},{"time":244.6,"text":"Và trên màn hình của chúng ta đang có một mã QR"},{"time":246.7,"text":"Để cho tất cả các bạn chúng ta có thể quét mã này"},{"time":249.1,"text":"Và chúng ta có ngay công thức để làm món ăn của ngày hôm nay"},{"time":251.3,"text":"Với món ăn này thì chúng ta sẽ kết hợp với xinh tố dâu blendy 3 màu"},{"time":256.1,"text":"Thì chúng ta sẽ có những cái bữa ăn rất là thú vị"},{"time":259.6,"text":"Bánh nở xốp mềm, xoài và dâu tây chua chua, ngọt ngọt, thanh thanh"},{"time":264.9,"text":"Ngon mê ly cùng lớp kèm béo béo, mịn màng, hoàn hảo"},{"time":270.7,"text":"Ngon, tươi, bắt mắt mà lại còn dễ làm"},{"time":273.4,"text":"Công thức luôn có sẵn sàng trên Youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":278.2,"text":"Các bạn có thể truy cập vào bất cứ lúc nào để chúng ta có công thức và thực hiện ngay tại nhà"},{"time":281.7,"text":"Chúc các bạn thành công"}]}