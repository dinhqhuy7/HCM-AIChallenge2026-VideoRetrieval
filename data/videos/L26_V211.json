tươi, có lớp da sáng, bóng, bụng chắc và còn nguyên là cá cơm ngon"},{"time":49.6,"text":"Và cá cơm thang là loại cá ngon nhất cho nên là được lựa chọn để làm nước mắm"},{"time":55.2,"text":"Bởi vì độ đạm cao, có acid béo omega 3 và có nhiều khoáng chất rất là tốt cho sức khỏe"},{"time":61.2,"text":"Mình sẽ bỏ cái phần đầu đi và mình sẽ nặng bỏ bớt cái phần ruột ở trong bụng cá"},{"time":65.9,"text":"Đầu tiên thì chúng ta sẽ ướp vào đây nửa muỗng cà phê tiêu trộn đều lên"},{"time":70.0,"text":"Kim Thảo ơi Kim Thảo em giúp dùm cô là em nặng cái phần nước cốt tắc đó dùm cô"},{"time":74.2,"text":"Giữ cái giỏ lại nha"},{"time":75.5,"text":"Các bạn lưu ý là chúng ta chọn giỏ tắc chính để băm và làm nước chấm thì sẽ thơm và ít bị đắng hơn nha"},{"time":81.2,"text":"Ướp cá với lại một muỗng canh nước cốt tắc"},{"time":83.5,"text":"Trộn đều phần cá lên"},{"time":85.8,"text":"Dạ"},{"time":86.9,"text":"Em bầm cái phần giỏ ngoài không thì nó sẽ đẹp hơn"},{"time":90.4,"text":"Chỉ cần sử dụng khoảng chừng 2 muỗng cà phê vỏ tắc băm là được rồi"},{"time":93.4,"text":"Dạ"},{"time":95.2,"text":"Bây giờ thì chúng ta sẽ chuẩn bị bột"},{"time":97.0,"text":"Chúng ta sẽ dùng gia vị nêm sẵn"},{"time":99.3,"text":"Acid wheat bột chiên giòn"},{"time":100.4,"text":"Đầu tiên là chúng ta sẽ lấy ra chừng 2 muỗng canh"},{"time":103.3,"text":"Ướp với lại phần cá"},{"time":104.6,"text":"Phần còn lại thì chúng ta sẽ cho vào tô để pha với nước"},{"time":108.4,"text":"Nước từ từ"},{"time":110.7,"text":"Cô Hà, đây là một tác phẩm nghệ thuật"},{"time":112.6,"text":"Rồi, cô cảm ơn Kim Thảo"},{"time":114.1,"text":"Tốt lắm luôn hả Kim Thảo"},{"time":115.3,"text":"Rồi, cô cũng pha bột xong rồi nè"},{"time":117.0,"text":"Em đặt trên bếp cho cô một cái chảo dầu để mình chiên nha"},{"time":120.0,"text":"Mình chờ dầu nóng nha"},{"time":121.3,"text":"Rồi cái phần bột này thì mình sẽ trộn đều với cá"},{"time":124.3,"text":"Cá nó sẽ có một cái lớp bột khô mỏng mỏng bên ngoài"},{"time":127.4,"text":"Còn cái phần bột nước này nè"},{"time":128.7,"text":"Bây giờ cô sẽ cho vào đây khoảng chừng một muỗng canh mè đen"},{"time":131.2,"text":"Phần bột của chúng ta sẽ có lấm tắm chấm mè đen"},{"time":134.7,"text":"Nhìn sẽ đẹp mắt hơn cô Hà ha"},{"time":136.4,"text":"Đúng rồi và thật ra thì nó cũng thêm cái dinh dưỡng nữa đó em"},{"time":139.4,"text":"Trong cá này có nhiều vitamin A, E, K nè"},{"time":142.5,"text":"Là những vitamin nó tan trong chất béo"},{"time":145.0,"text":"Cho nên là nếu như mà mình sử dụng cái phương pháp chiên"},{"time":147.8,"text":"Thì cơ thể chúng ta sẽ hấp thụ cái cá này tốt hơn"},{"time":151.7,"text":"Giờ mình sẽ bỏ một nửa cá vô trong cái phần bột này"},{"time":154.2,"text":"Trộn cho nó thấm bột"},{"time":155.6,"text":"Sau đó thì mình sẽ lấy từng con cá mình bỏ vô trong cái chảo dầu mình chiên"},{"time":159.5,"text":"Em nhớ canh giùm cô á"},{"time":160.7,"text":"Cái này là cô định là cô sẽ chiên 2 lần"},{"time":162.6,"text":"Cho nên là khi mà nó vừa vàng vàng là mình bắt đầu mình vớt ra"},{"time":166.4,"text":"Rồi trong lúc thảo chiên thì cô sẽ tiếp tục trộn cái phần cá vào bột còn lại"},{"time":170.9,"text":"Giờ em vớt ra đi"},{"time":172.2,"text":"Rồi vũ ráo vào"},{"time":173.8,"text":"Bây giờ thì chúng ta sẽ pha sốt mắm tắc để ăn kèm"},{"time":176.9,"text":"Đầu tiên chúng ta sử dụng nửa muỗng cà phê đường"},{"time":180.8,"text":"Một muỗng canh nước cốt tắc"},{"time":182.5,"text":"Một muỗng canh rưỡi mật ong"},{"time":185.7,"text":"Ba muỗng canh nước mắm"},{"time":186.9,"text":"Hai muỗng cà phê giỏ tắc băm"},{"time":194.0,"text":"Cho tỏi ớt băm"},{"time":195.2,"text":"Tùy theo ý thích"},{"time":197.5,"text":"Cô ơi, nước mắm tắc này là ăn cái gì cũng ngon luôn á cô"},{"time":200.3,"text":"Đúng rồi"},{"time":200.8,"text":"Mình sẽ mở lại lửa đây nha"},{"time":202.3,"text":"Mình chiên cá lần hai"},{"time":203.3,"text":"Chúng ta lưu ý là mình sẽ chiên cá hai lần"},{"time":205.9,"text":"Để giữ được độ giòn của cá nha"},{"time":208.7,"text":"Nó vàng nhanh quá kìa cô"},{"time":209.7,"text":"Và em cảm nhận được độ giòn của nó luôn đó cô"},{"time":213.8,"text":"Rồi"},{"time":216.0,"text":"Wow"},{"time":217.3,"text":"Ngon quá"},{"time":218.3,"text":"Như vậy là món ăn của chúng ta ngày hôm nay đã xong rồi"},{"time":220.8,"text":"Và để có thể ghi nhớ công thức của món ăn ngày hôm nay"},{"time":223.6,"text":"Quý vị và các bạn có thể quét mã"},{"time":225.4,"text":"Quý rờ trên màn hình của chúng tôi nha"},{"time":229.3,"text":"Và bây giờ thì chúng ta sẽ trình bày món ăn ra"},{"time":231.6,"text":"Wow"},{"time":236.0,"text":"Em kết nhất là chén nước chấm của cô Hà"},{"time":238.7,"text":"Nhưng mà cũng phải thử"},{"time":240.3,"text":"Trời ơi nhanh thiệt luôn đó"},{"time":243.7,"text":"Rất là giòn và rất là ngon cô"},{"time":245.4,"text":"Ở bên ngoài thì nó giòn mỏng nhẹ"},{"time":248.2,"text":"Đủ tạo cái độ hấp dẫn"},{"time":249.9,"text":"Còn bên trong thì thịt cá bùi bùi"},{"time":251.8,"text":"Chấm với lại mắm sốt tắc rất là ngon và hấp dẫn"},{"time":254.6,"text":"Thì để có một bữa cơm hoàn chỉnh"},{"time":257.0,"text":"Chúng ta có thể kết hợp thêm với món canh sườn bò củ sen các bạn nhé"},{"time":260.5,"text":"Và quý vị cũng có thể theo dõi chương trình Món ngon mỗi ngày"},{"time":263.9,"text":"Để chúng ta được nấu chuẩn, ăn lành"},{"time":266.4,"text":"Nghĩa là có những công thức nấu ăn chuẩn"},{"time":268.5,"text":"Và có những món ăn rất ngon, lanh mạnh"},{"time":271.4,"text":"Và một lần nữa xin được cảm ơn cô Hà rất là nhiều"},{"time":274.0,"text":"Lớp bột giòn rụm ôm trọn thịt cá mềm ngọt, thơm mùi mè"},{"time":279.0,"text":"Ăn kèm xoài chua chua và chấm nước mắm tắc thơm lừng, cay cay, say ngay đầu lưỡi"},{"time":286.6,"text":"Một món cá cơm ăn theo kiểu cuốn mang trọn cảm xúc của một mắm cơm gia đình"},{"time":291.4,"text":"Các bạn hãy thử ngay nha"},{"time":293.2,"text":"Và để ghi nhớ lại công thức của món ăn ngày hôm nay cùng với nhiều món ăn khác nữa"},{"time":297.8,"text":"Các bạn có thể truy cập vào Youtube website fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":302.7,"text":"Còn đến đây thì xin chào và hẹn gặp lại"}]}