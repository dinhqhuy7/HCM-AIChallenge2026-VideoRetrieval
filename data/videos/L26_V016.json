ext":"ớt hiểm đỏ các bạn đập dập"},{"time":93.2,"text":"Với cái phần hành lá thì chúng ta sẽ cắt nhỏ nè"},{"time":96.8,"text":"Cái phần đầu hành thì các bạn cắt nhỏ ra"},{"time":101.4,"text":"Khoai tây thì các bạn trắng răng cưa"},{"time":104.4,"text":"Sườn với khoai tây thì có rất là nhiều vitamin B6"},{"time":107.3,"text":"Và các chất dinh dưỡng tốt cho trí não, hệ thần kinh"},{"time":109.9,"text":"Chính vì thế món ăn hôm nay giúp cho chúng ta giảm stress"},{"time":112.8,"text":"Bây giờ chúng ta sẽ vào cái công đoạn ướp sườn nha"},{"time":115.2,"text":"Các bạn sẽ ướp vào đây đầu trắng hành lá cắt nhỏ"},{"time":117.6,"text":"Một muỗng canh củ nén băm"},{"time":119.2,"text":"Quốc nghệ sẽ ướp sườn với củ nén để tăng mùi thơm cho món ăn"},{"time":122.8,"text":"Một muỗng cà phê hạt nem Azi ngon heo"},{"time":125.5,"text":"Nửa muỗng canh nước tương phú sỉ"},{"time":128.1,"text":"Hành tăm hay còn gọi là củ nén"},{"time":130.2,"text":"Xuất hiện rất là nhiều trong các món ăn của người miền Trung"},{"time":133.7,"text":"Với cái hương thơm đặc trưng"},{"time":135.2,"text":"Và khi mà nấu chín thì có một cái vị ngọt"},{"time":137.8,"text":"Ngoài ra thì đây còn được xem là một cái loại thuốc để giải cảm nữa đó các bạn"},{"time":142.2,"text":"Chúng ta chiên khoai tai trước"},{"time":145.0,"text":"Sau khi giờ ăn đã nóng các bạn sẽ cho khoai tai vào chiên nè"},{"time":147.9,"text":"Cái mục đích chiên là giúp cho khoai tây nó thơm bùi hơn"},{"time":151.1,"text":"Cũng như là giúp cho trong quá trình kho khoai tây nó không bị bỡ ra"},{"time":155.0,"text":"Rồi chúng ta sẽ cho ra đĩa"},{"time":158.5,"text":"Bây giờ chúng ta sẽ chuẩn bị một cái chảo sao lòng một chút để kho sườn nha"},{"time":161.8,"text":"Sau khi chảo nóng các bạn sẽ cho vào đây 2 muỗng canh dầu màu điều"},{"time":164.8,"text":"Cho vào đây 1 muỗng canh đường để thắng màu"},{"time":167.8,"text":"Sau khi đường lấy màu đẹp nè"},{"time":169.8,"text":"Thì các bạn sẽ cho cái phần củ nén nguyên còn lại vào nè"},{"time":173.0,"text":"Mình đảo đều"},{"time":175.1,"text":"Hấp dẫn chưa ạ"},{"time":176.2,"text":"Cái màu caramel rất là đẹp anh chị ha"},{"time":178.6,"text":"Tiếp đến là 1 muỗng canh hành tím băm"},{"time":181.0,"text":"Hành tím và củ nén dạy mùi thơm"},{"time":182.7,"text":"Thì các bạn sẽ cho sườn vào"},{"time":184.7,"text":"Sóc chảo nha"},{"time":186.1,"text":"Để cho cái phần"},{"time":187.9,"text":"Nước màu áo đều lên sườn"},{"time":192.3,"text":"Thơm quá"},{"time":196.7,"text":"Sườn đã săn thì chúng ta sẽ cho nước vào nè"},{"time":199.2,"text":"Xăm xấp mặt sườn"},{"time":200.5,"text":"Xem đây vào đây 1 muỗng canh nước tương phú sỉ"},{"time":204.1,"text":"Kho là phải có nước tương"},{"time":205.5,"text":"Dùng nước tương phú sỉ khi kho"},{"time":207.5,"text":"Giúp món ăn đậm đà và thơm ngon hơn đó các bạn"},{"time":210.0,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":212.3,"text":"Một muỗng cà phê hạt nem Azi ngon heo"},{"time":215.3,"text":"Một trái ớt hiểm đập dập"},{"time":216.6,"text":"Và cuối cùng là một nhánh tiêu xanh"},{"time":218.7,"text":"Sau khi sườn đã thấm"},{"time":220.6,"text":"Thì các bạn sẽ cho khoai tây vào nè"},{"time":222.2,"text":"Tiếp đến đó là nấm rơm nha"},{"time":224.2,"text":"Tiếp tục kho để cho khoai tây và nấm rơm chiến tới"},{"time":227.2,"text":"Và nếu như các bạn bỏ lỡ"},{"time":229.4,"text":"Một công đoạn nào đó của món ăn ngày hôm nay"},{"time":231.6,"text":"Thì có thể dùng điện thoại"},{"time":232.9,"text":"Quét mã QR đang hiển thị trên màn hình"},{"time":235.1,"text":"Để lưu lại công thức của món ăn này nha"},{"time":239.1,"text":"Trình bài ra đĩa"},{"time":240.3,"text":"Thưởng thức cùng với cơm nóng"},{"time":242.4,"text":"Và cái hương thơm giữa nước tương phú sỉ nè"},{"time":246.1,"text":"Hòa quyện với củ nén"},{"time":247.4,"text":"Rất là thơm các bạn ơi"},{"time":248.9,"text":"Cho cái sốt kho lên đây nè"},{"time":254.7,"text":"Wow"},{"time":256.3,"text":"Một vài lá ớt sừng nữa nè"},{"time":258.0,"text":"Một ít hành lá cắt nhỏ"},{"time":260.1,"text":"Wow còn bốc khói luôn"},{"time":262.4,"text":"Những cái miếng sườn kho"},{"time":264.2,"text":"Thấm gia vị rất là ngon"},{"time":266.2,"text":"Nấm nè"},{"time":267.6,"text":"Khoai tây nè"},{"time":277.8,"text":"Anh Nghị ơi phần thịt á"},{"time":279.5,"text":"Chín mềm nè"},{"time":281.0,"text":"Thơm mùi củ nén"},{"time":282.6,"text":"Hương vị thì đậm đà đến từ nước tương phú sỉ"},{"time":285.4,"text":"Khoai tây thì bùi bùi kết hợp với lại nấm rơm thơm thơm"},{"time":290.1,"text":"Món ăn này mình vừa nghĩ nha mà ăn với cơm trắng là đúng bài luôn"},{"time":293.2,"text":"Và để đạt được cái hiệu quả dinh dưỡng thì các bạn có thể áp dụng món ăn này cùng với bản thực đơn tham khảo sau đây các bạn nha"},{"time":303.1,"text":"Vẫn là món sườn kho nhưng trở nên thơm ngon và độc đáo khi kết hợp với củ nén"},{"time":307.4,"text":"Đảm bảo sẽ bắt cơm lắm đây các bạn ơi"},{"time":309.8,"text":"Làm thử ngay nha"},{"time":311.0,"text":"Ngoài ra còn rất nhiều món ngon các bạn có thể tham khảo trên website của món ngon mỗi ngày"}]}