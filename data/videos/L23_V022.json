t":"top · TONDONG · DICH · DONG · CÚP TRUYN H · CUP TRUYÈN HINH · MOND"},{"time":300.5,"until":303.8,"text":"DONG · TONDONG"},{"time":304.0,"until":331.3,"text":"CAN · HIEMK · BIEUMAT · MG LÁN THU X · BIEU"},{"time":331.5,"until":359.0,"text":"TONDONG · NGA · FACTOR · TON DO · STOFE · HÉJHAO"},{"time":359.2,"until":360.8,"text":"DONG · DONGA · TON · TONDO · ON DOI · DOI"},{"time":361.0,"until":364.5,"text":"TONDONGA · CÚP TRUYÉN HINH · DÀI TRUYÈN HiNH THÀNH PHÓ HÒ CHÍ MINH · THVG HIÊN"}],"speech":[{"time":0.1,"text":"Lúc này thì các tay đua đã đẻ phải vào trục đường Quang Trung"},{"time":2.8,"text":"Sau khi qua cầu Quang Trung thì họ sẽ đến ngã 3 đẻ phải vào đường 30 Tháng Tư"},{"time":7.8,"text":"Trước khi đi ngang qua khu vực công viên Lưu Hữu Phước và vào đường Hòa Bình"},{"time":11.5,"text":"Nơi màn cảnh tranh nước thuốc đang chờ đợi các tay đua cúp truyền hình thành phố Hồ Chí Minh năm nay"},{"time":16.4,"text":"Một máy kéo của Vĩnh Long đã làm việc hết sức và đã giặt ra"},{"time":22.3,"text":"Xin được nhắc lại là cuộc đua gần nhất thì Trần Thuấn Kiệt đã là người có được chiến thắng ở đích đến tại tay đua"},{"time":30.8,"text":"Ekip Đồng Tháp cũng sẽ chờ đợi cho mình một cơ hội để tìm kiếm thêm một chiến thắng chặn nữa cho Trần Thú Kiệt ở cúp truyền hình năm nay"},{"time":38.2,"text":"Tay đua của TP.HCM New Group"},{"time":40.5,"text":"Có lẽ là Lê Nguyệt Minh đang tràn lên sát với áo vàng Peter Rikunov để tìm kiếm một vị trí thuận lợi"},{"time":48.0,"text":"Thì cuộc cạnh tranh của rất nhiều những tổng nước rút thì chọn vị trí luôn là một yêu cầu cực kỳ quan trọng cho các tay đua"},{"time":53.4,"text":"Và hai tay đua của TP.HCM là Lê Nguyệt Minh và Nguyễn Phan Bình đang cho thấy sự sắc bén ở trong việc chọn một vị trí thuận lợi"},{"time":60.0,"text":"Và vừa rồi thì Đăng Thành Đức cũng đã bị bắt lại bởi đoàn đông phía sau"},{"time":63.8,"text":"Igor Prolop cũng đang rướng lên ở bên phải của áo vàng"},{"time":71.3,"text":"Trong tông của Vĩnh Long vẫn có một màu áo của gạo hàng không trời An Giang"},{"time":76.4,"text":"Đó là Roman Maikin"},{"time":78.7,"text":"Lúc này thì Lê Nguyệt Minh đã chọn được một vị trí tốt hơn tay đua mặt áo vàng"},{"time":82.4,"text":"Anh Đăng đi ngay phía sau tay đua Maktilas"},{"time":84.5,"text":"Nhưng một lần nữa thì Peter Nikunov lại chen lên phía trên"},{"time":88.2,"text":"Có thể thấy sự khôn khéo của những chân nước rút ở thời điểm then chốt này"},{"time":126.9,"text":"Ngay phía sau Bỏ Đanh An, đó là có lẽ là tay đua Mỹ Nhật Pháp và một chiếc áo của ekip An Giang đã chen vào cột này."},{"time":135.6,"text":"Michael Ram sẽ là chân nước lớn, cực kỳ chất lượng để đưa Mạc Tinh Lách về rút."},{"time":140.9,"text":"Còn ở phía sau Mạc Tinh Lách vẫn là tình huống chen để tranh giành vị trí tốt giữa Lê Nguyệt Minh và Peter Rykunov."},{"time":146.5,"text":"Đây là khoảng cách 500m cuối cùng."},{"time":149.8,"text":"Lại thêm một cuộc cạnh tranh hấp dẫn ở đích đến nữa."},{"time":152.2,"text":"Tay đua Bỏ Đanh An tách ra và người đang làm tốc độ cao có lẽ là Roman Maikin."},{"time":167.3,"text":"Martin Lach là người làm tốc độ, Martin Lach vẫn đang có được một vị trí thuận lợi"},{"time":170.1,"text":"Và đó là chiến đấu cho ekip 620 châu đới Vĩnh Long"},{"time":180.3,"text":"Có lẽ là Peter Rikunov bị một sự tố kỹ thuật về xe khiến anh phải lơi chân ở đoạn 500m cuối"},{"time":194.7,"text":"Một tình huống không có sự tranh chấp của Peter Rikunov và Martin Lach"},{"time":198.4,"text":"Đã tỏ ra không có đối thủ khi được Mikael Rem đưa vào một vị trí vô cùng thuận lợi"},{"time":219.3,"text":"Phải nói hôm nay là chiến thắng rất là xứng đáng cho 620 châu thới Vĩnh Long"},{"time":236.2,"text":"Hôm nay xin chúc mừng 60 châu Thế Vĩnh Long có chặng thắng về người Tây, về quân của mình."},{"time":243.1,"text":"Vâng đây chắc chắn là một trong những chiến thắng chặng ý nghĩa nhất của cá nhân Martin Lat cũng như 620 châu Thế Vĩnh Long ở cuộc đua năm nay."},{"time":253.0,"text":"Chiến thắng đến từ sự tự tin, sự nỗ lực của các bạn."},{"time":257.7,"text":"Chúng ta xem lại đoạn tranh chấp nước rút này, Lê Nguyệt Minh đã cố gắng đeo bám Martin Lat."},{"time":262.7,"text":"Nhưng trước sức mạnh của chân rút đẳng cấp Grand Tour"},{"time":266.8,"text":"Thì Lê Nguyệt Minh cũng phải chịu thua một thân xe"},{"time":275.3,"text":"Về vị trí thứ 3 là Sapa Novikov"},{"time":278.4,"text":"Hạng 4 và hạng 5 thuộc về Nguyễn Văn Bình và Hoàng Văn Cường"},{"time":290.3,"text":"Một đoạn làm nước lớn quá tốt của các tài đua 620 Châu Thế Vĩnh Long"},{"time":294.0,"text":"Đặc biệt là Mikel Rem"},{"time":296.4,"text":"Đã đưa Mạc Tinh Lát vào một vị trí vô cùng thuận lợi"},{"time":301.3,"text":"Ở phía trước và ở cả hai bên trái phải của Mạc Tinh Lát"},{"time":304.9,"text":"Không hề có bóng dáng của một tài đua nào gây sức ép"},{"time":307.6,"text":"Và chân rút người Estonia chỉ việc hướng thẳng đến vạch đích"},{"time":325.3,"text":"Rất đơn giản của Martin Las"}]}