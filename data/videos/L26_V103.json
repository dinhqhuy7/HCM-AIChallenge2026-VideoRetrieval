me":222.0,"until":223.5,"text":"DUONG · DUÖNG 1m · NG 1m · 111 · BUDNG"},{"time":223.7,"until":227.1,"text":"AJHNO-MOTO · NGOT 1/3m"},{"time":227.3,"until":229.4,"text":"NGON · AJINOMOTO · móingày"},{"time":229.7,"until":231.6,"text":"NUC 3M"},{"time":231.8,"until":236.9,"text":"ÁNG · ÍT NUÓG BÔT NÄNG · IÓC BÔT NÄNG"},{"time":237.1,"until":240.3,"text":"UMÈ · ÍT DÂU MÈ"},{"time":240.5,"until":244.4,"text":"Dnli"},{"time":244.8,"until":247.2,"text":"NGON · ngay · mingày · moingay · Agagen"},{"time":247.4,"until":251.5,"text":"nline · ATV"},{"time":251.7,"until":256.3,"text":"NGON · AJINOMOTO · QUÉT MÃ QR DÊ XEM CÔNG THÚC · móingày · Agagen"},{"time":259.0,"until":260.8,"text":"NGON · mingày · MON"},{"time":275.2,"until":282.0,"text":"CANH · NGON · mingày · NÁUNGÓT · Eat Well, Live Well. · AJINOMOTO. · CÁ CHIM · DÁY DÙ DINH DUÖNG · VÓI · BÜA ÃN"},{"time":294.2,"until":301.8,"text":"NGON · AJINOMOTO · Eat Well, Live Well · mingày · moingay · MOTO · Eat Well: Li · Cat Well · PhuSi · MHNOMOTO · mđinaày · AJING"},{"time":302.0,"until":308.7,"text":"monngonmoingay.com · NGON · Món Ngon Mōi Ngày · AJINOMOTO · moingay"},{"time":309.1,"until":321.7,"text":"300g · 70g · 10g · Công ty Ajinomoto · Công ty Hakuhodo · 10 lá · Tham gia thc hin · 1cù · Công ty Golden Scale · NGUYÊN LIÊU · Công ty HKFilm · Bn quyn kch bn và cu trúc · ·TRÚNG GÀ · 1 quà · Phi hp thc hin · ·LÁ CÀI XANH · ·HÀNH LÁ · ·THÄN HEO · · THUÖC MUÖI (BAKING SODA) · ·NUÓC TUONG · ·NÃM HUONG · Thc hin chương trình · chuơng trình thuc · ·BÔT NGOT · ·CÀ RÔT · ·GIÒ SÓNG · ·NÃM MÈO · THÀNH PHÓ HO CHÍMINH · · HÀNH TÍM BĂM · Thc hin chươ · DÀI TRUYÊN HìNH · ·BOT NCOT"}],"speech":[{"time":11.9,"text":"Ngon mắt, khéo vị, ngọt lành với thăng heo cuộn cải hấp"},{"time":34.9,"text":"Rất vui được gặp lại các bạn khán giả đang đến với chương trình Món ngon mỗi ngày"},{"time":38.4,"text":"Nấu chuẩn, ăn lành"},{"time":40.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":43.8,"text":"Và ngày hôm nay Phước Hương với Minh Phương sẽ hướng dẫn cho các bạn"},{"time":46.8,"text":"Một món hấp rất là thanh đạm nhưng mà đầy đủ chất dinh dưỡng luôn"},{"time":50.5,"text":"Đó là món thăng heo cuộn cải hấp"},{"time":52.9,"text":"Phước Hương sẽ đặt lên trên bếp một cái nồi nước"},{"time":55.1,"text":"Chúng ta sẽ ướp cái phần nấm mèo và nấm hương"},{"time":58.0,"text":"Cho hết cái phần nấm hương này vào tô"},{"time":60.8,"text":"Phần nấm mèo cũng vậy"},{"time":62.0,"text":"Chúng ta sẽ ngâm nở và cắt nhỏ luôn"},{"time":64.1,"text":"Và đây cũng là một lưu ý cho quý vị khán giả nha"},{"time":66.3,"text":"Chúng ta sẽ ướp phần nấm mèo và nấm hương trước"},{"time":68.7,"text":"Khi trộn vào giò sống"},{"time":70.3,"text":"Giúp cho phần nhân thơm ngon hơn"},{"time":71.5,"text":"Cho vào đây một ít hành tím, một ít tiêu"},{"time":74.2,"text":"Trộn đều lên cho tiêu và hành tím được thấm gia vị"},{"time":77.2,"text":"Chúng ta sẽ cho vào đây một ít thuốc muối"},{"time":79.4,"text":"Hay chúng ta còn gọi đó là baking soda đó à"},{"time":82.0,"text":"Đây là cái phần cọng cải đúng không Phước Hưng"},{"time":83.8,"text":"Đúng rồi"},{"time":84.1,"text":"Chúng ta sẽ cho ngay vào một cái tô nước đá lạnh để giữ được màu xanh cho cọng cải"},{"time":88.9,"text":"Rồi bây giờ thì đến phần cà rốt"},{"time":92.1,"text":"Chúng ta sẽ tắt bếp nè"},{"time":93.6,"text":"Vớt cà rốt ngâm vào trong nước đá lạnh luôn"},{"time":95.9,"text":"Tiếp tục Phước Hương sẽ cho phần giò sống vào chúng ta trộn"},{"time":99.8,"text":"Cho vào đây một muỗng cà phê nước mắm"},{"time":102.0,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":105.0,"text":"Nửa muỗng cà phê hạt nêm Ajinon heo"},{"time":107.8,"text":"Trộn đều cái phần nhân"},{"time":109.1,"text":"Chúng ta sẽ cắt cái phần thăng heo có cái độ dày khoảng 0,5cm"},{"time":113.3,"text":"Nếu như mà ngày hôm nào cái phần thịt thăng nó không đủ bề bảng lớn"},{"time":117.0,"text":"Thì chúng ta sẽ tạo hình bằng cách là chúng ta sẽ cắt hình cánh bướm"},{"time":120.5,"text":"Chúng ta sẽ đập phần thân heo này mềm ra"},{"time":124.1,"text":"Sử dụng thêm một lớp màng thuộc phẩm nữa và chúng ta dần ra"},{"time":131.9,"text":"Chúng ta để qua đây và tiếp tục như vậy chúng ta sẽ làm hết cái phần thân heo luôn"},{"time":135.8,"text":"Cho vào đây nửa muỗng canh dầu ăn"},{"time":140.7,"text":"Nửa muỗng cà phê hạt nêm Azi ngon heo"},{"time":144.8,"text":"Một muỗng cà phê đầu hành trắng bằm"},{"time":147.3,"text":"Và cuối cùng Hương sẽ cho vào đây một ít tiêu"},{"time":150.4,"text":"Chúng ta sẽ trộn đều lên cho phần thịt thăng heo được thấm vị"},{"time":153.7,"text":"Khi nãy thì Phước Hương giao nhiệm vụ là phải tráng cho Phước Hương những trứng thiệt là mỏng như thế này"},{"time":158.6,"text":"Để tiết kiệm thời gian thì chúng ta cũng đã tráng sẵn rồi"},{"time":161.0,"text":"Phước Hương sẽ sử dụng một miếng thịt thăng heo mà chúng ta đã ướp rồi nè"},{"time":164.6,"text":"Chúng ta sẽ trải lên bề mặt của tấm thớp"},{"time":167.2,"text":"Sẽ lấy một lớp giò sống chúng ta phớt mỏng lên"},{"time":172.8,"text":"Cho vào một lớp trứng"},{"time":174.3,"text":"Sử dụng một cọng cà rốt và một cọng cải xanh"},{"time":177.6,"text":"Và đối với món ăn ngày hôm nay thì chúng ta sẽ cuộn chặt tay"},{"time":180.5,"text":"Khi đó khi hấp thì món ăn sẽ đẹp mắt hơn"},{"time":182.9,"text":"Sử dụng lá cải xanh chúng ta cuốn bên ngoài lại"},{"time":188.8,"text":"Và tiếp tục như vậy chúng ta sẽ làm hết cái phần thăng heo luôn"},{"time":192.5,"text":"Đặt lên trên bếp một cái sửng hấp"},{"time":194.2,"text":"Rồi chúng ta hấp với lửa lớn khoảng tầm 10-15 phút là cuốn cải chín"},{"time":200.0,"text":"Chúng ta sẽ đậy lại"},{"time":201.1,"text":"Phương sẽ hướng dẫn cho các bạn chúng ta sẽ làm sốt cho món ăn"},{"time":204.0,"text":"Cho vào đầu hành trắng băm nè và hành tím băm"},{"time":207.3,"text":"Cho vào đây một ít gừng băm luôn để cho cái phần sốt có cái vị ấm nồng hơn"},{"time":211.8,"text":"Chúng ta sẽ sử dụng nước tương phú sỉ để giúp cho món sốt có vị đậm đà và có hương vị đặc trưng hơn"},{"time":217.3,"text":"Cho vào đây là 4 muỗng canh nước tương phú sỉ"},{"time":221.5,"text":"1 muỗng cà phê đường"},{"time":222.9,"text":"1 phần 3 muỗng cà phê bột ngọt Ajinomoto"},{"time":226.8,"text":"Và Hưng sẽ cho vào đây 3 muỗng canh nước"},{"time":231.4,"text":"Và bây giờ chúng ta sẽ cho vào đây một ít bột năng để tạo đủ sánh cho sốt nè"},{"time":236.7,"text":"Và cuối cùng Phước Hưng sẽ cho vào đây một ít dầu mè"},{"time":240.4,"text":"Hưng sẽ cho phần sốt này ra cái chén"},{"time":244.3,"text":"Chúng ta sẽ mở đắp ra"},{"time":246.2,"text":"Wow"},{"time":247.9,"text":"Chúng ta sẽ cho ra"},{"time":249.7,"text":"Một món cuốn rất là dễ làm"},{"time":251.3,"text":"Mà lại đảm bảo đầy đủ chất dinh dưỡng nữa"},{"time":253.1,"text":"Các bạn hãy sử dụng điện thoại di động"},{"time":254.5,"text":"Quét mã QR đang hiển thị trên màn hình"},{"time":256.9,"text":"Để lưu về công thức của món ăn ngày hôm nay nha"},{"time":260.9,"text":"Chúng ta sẽ trang trí cho món ăn"},{"time":267.6,"text":"Sau khi mà chúng ta đã cắt ra"},{"time":269.2,"text":"Thành từng khoanh vừa ăn rồi"},{"time":270.6,"text":"Thì bây giờ chúng ta sẽ cho vào dĩa"},{"time":272.2,"text":"Khi ăn thì các bạn chấm với một ít nước tương phú sỉ"},{"time":275.0,"text":"Sẽ rất là tuyệt vời"},{"time":276.0,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng thì chúng ta có thể kết hợp với món canh cá chim nấu ngót sẽ rất là ngon"},{"time":282.9,"text":"Cuộn cải có vị ngọt tự nhiên từ thịt và nấm, béo của trứng, giòn ngọt từ bắp cải và cà rốt"},{"time":288.8,"text":"Chấm cùng sốt nồng thơm, ngọt nhẹ là đủ ngất ngây"},{"time":294.0,"text":"Thăng heo cuộn cải hấp, một món ăn với hương vị thanh mát từ cải xanh và thịt thăng heo hòa quyện rất hấp dẫn"},{"time":300.2,"text":"Các bạn hãy làm thử ngay nhé"},{"time":301.7,"text":"Ngoài ra để biết thêm thông tin của nhiều món ngon ngon thì chúng ta có thể truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"}]}