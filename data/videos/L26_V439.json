e"},{"time":255.5,"until":260.0,"text":"anigiòn giòn"},{"time":260.2,"until":263.1,"text":"Ngot béo · Ngo."},{"time":268.9,"until":274.7,"text":"AJINOMOTO · MOTO · Eat Well · Eat Well, Live Well. · mingày · mingàv · AJINOMO · Live Well · MON · Eat Well. Liy · noingay · Eat V · AJING · maingly · moin"},{"time":274.9,"until":281.4,"text":"AJINOMOTO · Eat Well, Live Well. · mingày · moingay"},{"time":282.2,"until":284.0,"text":"AJINOMOTO · Eat Well, Live Well. · Ban có mun chuơng trình gii thiu món ǎn dinh dung · moingày"},{"time":284.8,"until":289.0,"text":"AJINOMOTO · mingày · Eat Well, Live Well. · êntong gia dinh minh không? · cho tng đi tung thành viên o · cho tùng đi tung thành viên trong gia đinh mình không? · molngay"},{"time":289.4,"until":296.0,"text":"<MNMN Co/Khong> · AJINOMOTO · Gi 8069 hoc · Eat Well, Live Well. · mingày · 19006946 đ đưc hưng dn thêm · Goi · Cú pháp tin nhăn · Ví d: Bn trá li \"Có”. Son ngay: MNMN Co · f Món ngon mi ngày"},{"time":296.7,"until":307.0,"text":"Goi · AJINOMOTO · mingày · Gi 8069 hoc · Eat Well, Live Well. · <MNMN Co/Khong> · Món ngon mi ngày · 19006946 đ đưc hưng dn thêm · Ví d: Bn trá li \"Có\". Son ngay: MNMN Co · Cú pháp tin nhăn · moGoi · Eatweil,Uve"},{"time":307.7,"until":309.3,"text":"<MNMN Co/Khong> · Gi 8069 hoc · Goi · AJINOMOTO · 19006946 đ đưc hưng dn thêm · Eat Well, Live Well. · Cú pháp tin nhăn · Ví d: Bn trá li \"Có”. Son ngay: MNMN Co · f Món ngon mi ngày · moingày"},{"time":309.5,"until":316.9,"text":"Gi 8069 hoc · <MNMN Co/Khong> · Món ngon mi ngày · Gúi 806 · Goi19006946 đ đuc hưng dn thêm · Ví du: Ban trá lài \"Co\". Soan ngay MNMN Co · Cú pháp tin nhăn · Go06946de duoc hueng dan thêm"},{"time":318.1,"until":321.8,"text":"AJINOMOTO · mingày · Eat Well, Live Well."},{"time":322.8,"until":334.2,"text":"Nguyên liu · Công ty Ajinomoto Vit Nam · Tham gia · Ngò gai, rau om · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Bún tàu: 2M · Công ty Golden Scale · Tht c lác: 300g · Công ty HKFilm · Bn quyn kch bn và cu trúc · Phi hp thc hin · Hành tày: 1/2 cù · Hat ném Aji-ngon (Gà) · Lá cách: 1 chén · Ót sng: 1 trái · Sà cây: 3 cây · Nám mèo: 1M · Đàu hành lá: 5 cong · Công ty C · Thc hin chương trình · Bac hà: 1bę · chuơng trình thuc · Thc hié · Nuóc côt dùa: 1 chén · DÀI TRUYÊN HìNH TP. HCM · Cóng ty A"}],"speech":[{"time":12.3,"text":"Em chào cô"},{"time":13.1,"text":"Chào Minh Tuấn"},{"time":15.1,"text":"Ủa em thấy gì mà quá trời đồ nha cô"},{"time":16.8,"text":"Ốc nè, nấm mèo, đầy đủ nguyên liệu hết trơn rồi"},{"time":20.1,"text":"Cô còn kêu em đem lá cắt làm chi"},{"time":21.7,"text":"Em nói cô nghe nha"},{"time":22.4,"text":"Lá cắt thì không có tốn tiền"},{"time":23.6,"text":"Nhưng mà tốn tiền mua cái rổ mắc lắm đúng không cô"},{"time":25.9,"text":"Trời ơi"},{"time":26.4,"text":"Hôm nay cô làm món ốc xào"},{"time":28.5,"text":"Và lá cắt là rất là quan trọng cho món ăn này"},{"time":31.1,"text":"Cho nên là cô mới nhờ em mang tới mà"},{"time":32.9,"text":"Hàng chi"},{"time":33.6,"text":"Và lá cắt trong món ăn kết hợp với lại lương, ốc và ếch"},{"time":37.3,"text":"Sẽ rất là hấp dẫn"},{"time":38.5,"text":"Món ăn hôm nay sẽ hết sảy lương"},{"time":42.4,"text":"Ốc xào lăng lá cách, hương vị thấm đậm tình quê"},{"time":67.8,"text":"Chúng ta sử dụng ốc lát để có độ giòn thì món ăn sẽ ngon hơn ha"},{"time":73.0,"text":"Các bạn lưu ý là chúng ta sẽ ngâm ốc trong nước do gạo để làm sạch ốc nha"},{"time":77.2,"text":"Chúng ta sẽ tẩm ướp con ốc này"},{"time":79.2,"text":"Cho vào đây 2 muỗng cà phê bột curry"},{"time":81.1,"text":"Ốc thì rất là hợp với lại hương vị của curry"},{"time":84.5,"text":"Đúng rồi"},{"time":85.1,"text":"1 muỗng canh hành và tỏi băm"},{"time":87.2,"text":"1 muỗng canh hạt nêm Ajinon gà"},{"time":90.9,"text":"Một muỗng canh xả băm trộn cho phần ốc thấm đều gia vị"},{"time":95.2,"text":"Em là thấy xả với lại là có cà ri là em thấy hấp dẫn hả cô?"},{"time":99.7,"text":"Đây là một cái đặc trưng của các cái món xào lăng"},{"time":103.8,"text":"Trong lúc chờ ốc thấm gia vị thì chúng ta sẽ sơ chế các nguyên liệu khác"},{"time":107.3,"text":"Tuấn và các bạn quan sát là đối với món ăn này thì chúng ta sẽ chọn lá cách bánh tẻ"},{"time":112.7,"text":"Tức là lá cách không có quá non cũng không quá già thì món ăn sẽ ngon hơn"},{"time":116.5,"text":"Bây giờ em cắt dày khoảng chừng một phần cho cô ha"},{"time":120.6,"text":"Tiếp theo là bún tàu thì chúng ta sẽ ngâm mềm"},{"time":123.8,"text":"Chúng ta ngâm với nước lạnh thôi cho vừa mềm thôi"},{"time":125.9,"text":"Bây giờ mình sẽ cắt hút khoảng chừng 5 phân"},{"time":128.1,"text":"Đây"},{"time":134.1,"text":"Đã xong rồi"},{"time":135.3,"text":"Rồi"},{"time":136.4,"text":"Còn bây giờ thì chúng ta sẽ sơ chế các loại nguyên liệu còn lại"},{"time":139.6,"text":"Đầu tiên là bạc hà"},{"time":141.1,"text":"Cái này người Bắc còn gọi là dọc mung"},{"time":142.6,"text":"Thì bây giờ chúng ta sẽ cắt lát xéo"},{"time":144.6,"text":"Xả thì mình sẽ đập dọc và mình cắt hút"},{"time":147.8,"text":"Người miền Nam thì rất là thích ăn xả"},{"time":150.2,"text":"Bởi vì xả thì ngoài cái việc mà tạo ra gia vị"},{"time":152.9,"text":"Thì nó cũng rất là tốt khi mà tạo thành những cái chất kháng sinh cho cơ thể"},{"time":157.6,"text":"Cái này mình gọi là kháng sinh tự nhiên đó cô ha"},{"time":159.7,"text":"Đúng rồi"},{"time":160.0,"text":"Nấm mèo thì chúng ta sẽ cắt sợi"},{"time":162.7,"text":"Hành tây thì mình sẽ cắt muối cao"},{"time":165.4,"text":"Rau ôm và ngò gai mình cũng sẽ cắt khúc"},{"time":169.6,"text":"Như vậy là chúng ta đã sơ chế xong các nguyên liệu"},{"time":171.9,"text":"Và bây giờ là chúng ta chỉ cần bắt chảo lên và chúng ta sẽ xào ốc"},{"time":175.2,"text":"Cho vào đây 2 muỗng canh dầu ăn"},{"time":176.9,"text":"Rồi cô sẽ cho xả cắt khúc vô"},{"time":180.0,"text":"Phi cho thơm cô ha"},{"time":181.6,"text":"Đúng rồi, cùng với lại 1 muỗng canh hành và tỏi băm"},{"time":184.6,"text":"Cho luôn cái phần ốc đã ướp gia vị vào"},{"time":188.8,"text":"Rồi, xào cho thịt ốc săn lại"},{"time":191.6,"text":"Thơm quá cô ơi"},{"time":192.7,"text":"Rồi, cô sẽ cho vào đây khoảng chừng 1 chén nước cốt dừa"},{"time":196.0,"text":"Tiếp tục cô cho cái phần bạc hà và nấm mèo vô luôn"},{"time":199.4,"text":"Bún tàu vô, hành tây luôn"},{"time":202.0,"text":"Chúng ta sẽ đảo lên cho đều"},{"time":204.1,"text":"Cô sẽ cho tiếp vào đây"},{"time":206.5,"text":"1 muỗng cà phê đường"},{"time":208.1,"text":"1 muỗng cà phê hạt nêm Ajinon gà"},{"time":211.1,"text":"Và cuối cùng cô cho vào đây là đầu hành lá nè, rau ôm ngò gai, ớt sừng và cả lá cắp nữa."},{"time":219.1,"text":"Lá cắp này khi mà em nấu lên thì cái mùi thơm của nó sẽ rất là đặc biệt luôn á."},{"time":223.5,"text":"Trời ơi, nhìn cái chảo cực kỳ hấp dẫn."},{"time":230.3,"text":"Mình tắt lửa được rồi."},{"time":234.1,"text":"Đây, mình sẽ hút ra dĩa."},{"time":237.7,"text":"Nước này chỉ hơi ít ít thôi ha, sấm sấm thôi."},{"time":240.9,"text":"Rồi, cô đặt lên đây một vài cái lát ớt và một ít đọt rau ôm"},{"time":246.5,"text":"Và đừng quên một ít đậu phộng rang"},{"time":249.4,"text":"Như vậy là mình đã hoàn thành xong món ăn rồi đó"},{"time":252.8,"text":"Quá hấp dẫn, quá ngon"},{"time":255.2,"text":"Thịt ốc giòn giòn, thơm mùi cà ri quyện chung với xả lá cách"},{"time":260.0,"text":"Có vị ngọt hậu lẫn trong vị béo của nước cốt dừa"},{"time":263.4,"text":"Ăn cùng một chút sực sực vui miệng của nấm mèo và bún càng thêm bắt vị"},{"time":268.2,"text":"Ốc xào lăng lá cách"},{"time":270.1,"text":"Một món ăn đơn giản, hấp dẫn"},{"time":272.3,"text":"Lại dễ làm, thực hiện ngay tại nhà các bạn nha"},{"time":274.4,"text":"Các bạn thân mến, như thường lệ"},{"time":276.2,"text":"Chúng ta sẽ mang đến cho tất cả các bạn"},{"time":278.0,"text":"Những câu hỏi khảo sát của chương trình"},{"time":279.6,"text":"Và câu hỏi của ngày hôm nay"},{"time":281.4,"text":"Đó chính là các bạn có muốn chương trình Món Ngon Mỗi Ngày"},{"time":284.5,"text":"Giới thiệu những món ăn dinh dưỡng"},{"time":286.4,"text":"Đến từng thành viên trong gia đình của mình hay không"},{"time":288.9,"text":"Để tham gia khảo sát"},{"time":290.2,"text":"Thì tất cả chúng ta sẽ cùng soạn tin nhắn"},{"time":292.3,"text":"Theo cú pháp MNMN"},{"time":294.4,"text":"Khoảng cách có hoặc không"},{"time":296.3,"text":"Và gửi về tổng đài 8069"},{"time":298.1,"text":"Trong đó MNMN là tên viết tắt của chương trình Món Ngon Mỗi Ngày"},{"time":301.5,"text":"Có tương ứng với câu trả lời là có"},{"time":303.9,"text":"Và không viết không giấu tương ứng với câu trả lời là không"},{"time":306.9,"text":"Cước phí cho mỗi tin nhắn sẽ là 1 ngàn đồng"},{"time":309.2,"text":"Cách thứ 2"},{"time":310.1,"text":"Các bạn soạn tin nhắn tương tự gửi đến fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":314.9,"text":"Theo địa chỉ trang đang hiện trên màn hình"},{"time":317.0,"text":"Đến đây thì xin được chào và tạm biệt"},{"time":318.8,"text":"Và hẹn gặp lại quý vị trong chương trình ngày mai"}]}