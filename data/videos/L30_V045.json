,null],["L30_V045",317,12.6,2],["L30_V045",1065,42.6,7],["L28_V019",19739,789.5,147],["L30_V068",3825,153.0,24],["L30_V045",1596,63.8,12],["L29_V014",6047,241.8,61]]]],"onScreen":[{"time":0.1,"until":1.7,"text":"tv.tuoitre.vn"},{"time":4.7,"until":6.3,"text":"Herbalife · trên th gii · cân nng · thương hiu · quán ly · & súc khóe · tusitrerv"},{"time":11.9,"until":13.8,"text":"Khoi dy tình yêu ngh truyn thng"},{"time":15.4,"until":16.3,"text":"Khi dy tình yêu ngh truyn thng"},{"time":17.2,"until":20.2,"text":"Khi dy tình yêu ngh truyn thng · toitreTV"},{"time":20.4,"until":29.5,"text":"Khi dy tình yêu ngh truyn thng"},{"time":38.2,"until":47.2,"text":"HUYNH XUÂN HUYNH · Ngưi Sáng lp và Điu hành Thương hiu Nng Ceramics · thuong hitu"},{"time":47.8,"until":51.0,"text":"HUYNHXUÂN HUYNH · Ngui Sáng lâp và Dieu hành Thuơng hiu Nng Ceramics"},{"time":62.9,"until":65.3,"text":"Teplue"},{"time":73.1,"until":74.3,"text":"tubitrerv · tusitretv"},{"time":74.8,"until":76.7,"text":"KEM · Tach"},{"time":117.1,"until":120.4,"text":"tuöitreV · tuóitréV"},{"time":159.0,"until":161.2,"text":"tuoitre"},{"time":202.2,"until":205.6,"text":"itreTV"},{"time":209.3,"until":212.5,"text":"tuoitre"},{"time":212.7,"until":216.0,"text":"tuoitre"},{"time":249.1,"until":252.1,"text":"HAD · HADES"},{"time":252.5,"until":255.8,"text":"HAO · HAOES"},{"time":267.9,"until":271.3,"text":"HAP · tusitrerv · tusitretv · tusitrety"},{"time":271.9,"until":275.3,"text":"tuöitrerv · TKO"},{"time":275.5,"until":278.3,"text":"tuoitrety · tuoitrerv"},{"time":300.6,"until":303.8,"text":"HATES"},{"time":308.6,"until":317.9,"text":"Tác già: TUnG SAN"},{"time":319.7,"until":326.4,"text":"tv.tuoitre.vn · Tác già: TUNG SAN · .TUONG SAN · AtreTV"}],"speech":[{"time":34.0,"text":"Lúc đó thì còn chưa tới 10 lò và những cái lò họ cũng không còn làm cái dòng sản phẩm chén dĩa này nhiều, chủ yếu là họ làm cầm chừng và kèm theo những cái sản phẩm khác."},{"time":43.2,"text":"từ đó thì mình nghĩ là một cái dòng sản phẩm gốm đẹp như vậy"},{"time":47.4,"text":"mà tại sao người ta lại không có phát triển nó"},{"time":51.6,"text":"để cho nó bị may một thì rất là tiếc"},{"time":53.6,"text":"và mình thấy là mình có cái khả năng làm gốm"},{"time":56.8,"text":"bởi vì mình cũng xuất thân từ trường kiến trúc ra"},{"time":59.9,"text":"sẵn cái vốn kiến thức về mỹ thuật"},{"time":62.2,"text":"thì mình mới lân la hội sinh vào làm một số những cái sản phẩm"},{"time":66.8,"text":"ban đầu là phục vụ cho cái mục đích sử dụng"},{"time":69.5,"text":"Sau đó thì do người ta không có nhận số lượng ít, người ta chỉ nhận nhiều thôi"},{"time":73.8,"text":"Thì mình làm có cái dư ra"},{"time":75.6,"text":"Rồi mình mới đi bán ở một số những cái hội trợ dành cho sinh viên"},{"time":79.2,"text":"Và cái thời điểm bây giờ thì nhận được rất nhiều cái sự ủng hộ của khách hàng cũng như là bạn bè"},{"time":84.9,"text":"Từ đó mình mới nghĩ là hay là mình thử mình theo nghề để giữ nghề"},{"time":89.8,"text":"Cũng như là nghiên cứu phát triển lại những cái sản phẩm cũ"},{"time":93.3,"text":"Và mình thổi những cái tinh thần mới của tụi trẻ vào trong những cái sản phẩm của truyền thống này"},{"time":99.2,"text":"Tiếp đây ở lò cũng có một cô thợ vẽ tên là cô Pa"},{"time":103.2,"text":"Cô cũng có hướng dẫn mình một số những nét cơ bản của cách đệ truyền thống lái tiêu"},{"time":108.4,"text":"Từ những nét cơ bản đó mình ứng dụng nó lên trên những mẫu mà mình sưu tập được"},{"time":113.7,"text":"Mình nghiên cứu và hồi lại những mẫu sản phẩm đó"},{"time":117.0,"text":"Và một trong những mẫu tiêu biểu mà mình làm được gồm có mẫu hoa sông bé cũng như là mẫu con gà"},{"time":124.7,"text":"là hai cái mẫu mà nổi bật nhất và đặc trưng nhất của dùm gớm lấy thiên ra bò."},{"time":131.6,"text":"Về cái nghề gớm này thì đây là một cái dòng sản phẩm đặc trưng sử dụng trên bàn ăn"},{"time":136.9,"text":"cho nên những cái yêu cầu về an toàn vệ sinh thực phẩm rất là cao."},{"time":141.7,"text":"Đặc biệt là về đất, về men thì phải ưu tiên sử dụng những cái nguyên liệu bản địa"},{"time":147.5,"text":"và không có được có những cái chất độc hại đặc biệt là trì."},{"time":152.5,"text":"Ở đất thì mình khai thác đất tránh luôn, đất tâm uy."},{"time":155.4,"text":"Ngoài ra thì là đất của vùng Đà Lạt người ta chở xuống"},{"time":158.8,"text":"Còn về men thì pha phối liệu từ những nguyên liệu bản địa rất là đơn giản"},{"time":163.6,"text":"Ví dụ như có đá đen hạ tiên, cát cam ranh, tràng thạch huế"},{"time":167.8,"text":"Kết hợp với đất xét chánh lưu và nước tạo ra một dòng men địa phương đặc trưng của dòng gốm lấy thiêu"},{"time":175.6,"text":"Còn về màu vẽ thì có một số màu mình sẽ sử dụng những loại oxy chim loại"},{"time":179.7,"text":"Ví dụ như là sắc, sắc thì sẽ cho ra màu nâu, đồng thì cho ra màu xanh lá"},{"time":184.1,"text":"mà ra thì mình còn có mua những cái loại màu người ta có trộn sẵn."},{"time":188.0,"text":"Phớm lấy thiêu đặc trưng ở đây là cái lối tả ý không tả hình"},{"time":192.0,"text":"tức là những cái sản phẩm người ta sẽ gợi lên cái ý nghĩa của họa tiết nhiều hơn"},{"time":196.7,"text":"là người ta tập trung mô tả hình ảnh."},{"time":199.6,"text":"Ngoài ra thì cái khối màu thì ở đây có cái da màu hủ thái"},{"time":205.2,"text":"nó gồm 5 màu cơ bản là đại hồng, lá già, màu cam, màu đen và màu xanh dương."},{"time":212.4,"text":"Thì từ những cái màu đó mình khói trộn lại với nhau để tạo nên những nhiều hỏa tiết"},{"time":219.6,"text":"Còn về sản phẩm thì sau khi vẽ thì mình cứ để đó cho nó khô dần và tình xếp"},{"time":225.9,"text":"Khi nào mà đầy một cái lò thì mình bắt đầu nung"},{"time":229.1,"text":"Trung bình thì một kỳ lò kéo dài trong khoảng từ nửa tháng đến một tháng"},{"time":233.3,"text":"Tùy theo cái thời điểm đắt đắt hay là muốn chậm"},{"time":236.8,"text":"Khi mà nhìn tới một cái sản phẩm gớm thì người ta chú trọng đến cái nét mộc mạc cũng như là sự khống thoáng trong cái tạo hình men màu cũng như là nét vẽ"},{"time":247.9,"text":"Từ đó thì những cái sản phẩm gớm lấy thiêu đã được người Nhật rất là tin dùng và ưa chuộng"},{"time":253.3,"text":"Tuy nhiên thì khoảng những năm 2000 trở về sau thì các sản phẩm gớm lấy thiêu không còn phổ biến nữa"},{"time":258.0,"text":"Và họ cũng không còn mua được những cái sản phẩm gớm yêu thích của họ"},{"time":261.8,"text":"thì khi mà mình xuất hiện thì họ thấy là mình có làm lại được những cái sản phẩm đó và nó có được những cái tinh thần mà họ mong muốn"},{"time":269.9,"text":"cho nên là họ gọi ý họ mời mình qua đó để tập trung một cái buổi bán hàng"},{"time":275.1,"text":"cũng như là làm những cái buổi talk show để giới thiệu về cái văn hoá như là cái dòng gớm này"},{"time":287.9,"text":"Đối với mình thì cái sưởng gớm nó gần như là cái ngôi nhà thứ 2 của mình"},{"time":292.6,"text":"Mình gắn bó tuổi thanh xuân của mình ở đây"},{"time":295.5,"text":"Mình nghe được những cô chú ở bên lò kể những câu chuyện về"},{"time":299.3,"text":"Cái thời mạng kim của nghề ngốm mình rất là thích"},{"time":302.1,"text":"Và mình mong muốn một ngày nào đó"},{"time":304.3,"text":"Cái nghề ngốm lấy thiêu nó riêng"},{"time":307.2,"text":"Và những cái nghề tủ công truyền thống của Việt Nam nói chung"},{"time":309.9,"text":"Có thể trở lại được cái thời kỳ mạng kim của nó"},{"time":312.6,"text":"Trở lại đứng đúng cái vị thế của nó"},{"time":314.8,"text":"Trong cái trường Việt Nam của người Việt Nam"}]}