chào quý vị khán giả đã quay trở lại với chương trình Món ngon mỗi ngày"},{"time":43.0,"text":"Nấu chuẩn, ăn lành, chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":49.2,"text":"Hôm nay chúng ta có một món gà"},{"time":52.7,"text":"Gà thì thực sự là nấu các món ăn trong gia đình thì mọi người rất là dễ ăn"},{"time":56.8,"text":"Hôm nay mình có cái món gì nó lạ từ gà được không?"},{"time":59.5,"text":"Hôm nay Long muốn thay đổi về tí xíu thì mình sẽ làm món gà ôm kiểu hoa"},{"time":63.8,"text":"Đầu tiên thì mình sẽ cho phần cánh gà này vào tô và chuẩn bị ướp"},{"time":67.8,"text":"Lâu hết trò đây là 2 muỗng cà phê đường"},{"time":71.4,"text":"1 muỗng cà phê hạt nêm Ajinomoto"},{"time":76.6,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":78.8,"text":"Và trộn đều lên"},{"time":82.1,"text":"Thịt gà thì có nhiều protein"},{"time":84.2,"text":"Bên cạnh đó còn có chứa cả vitamin B6 và vitamin A"},{"time":87.8,"text":"Rất là tốt cho sức khỏe não bộ"},{"time":89.8,"text":"Và giúp cho cơ thể của chúng ta tăng sức đề kháng"},{"time":92.2,"text":"Rất là tuyệt vời"},{"time":93.1,"text":"Bà rô thì mình sẽ cắt khoảng tầm 1cm"},{"time":95.1,"text":"Cắt xéo xéo xíu"},{"time":96.1,"text":"Gừng thì mình sẽ cắt lát"},{"time":101.8,"text":"Tới tỏi, cắt làm bốn"},{"time":108.1,"text":"Hành tây mình cắt láp"},{"time":116.5,"text":"Mở lửa lên"},{"time":117.3,"text":"Mình chiên xăm xắp dầu thôi"},{"time":119.7,"text":"Rồi mình sẽ chiên tỏi trước"},{"time":121.0,"text":"Để dầu thơm, cái tinh dầu tỏi đúng không nè"},{"time":123.1,"text":"Rồi khi mà cho gà vào thì gà sẽ rất là thơm"},{"time":126.0,"text":"Khi mà tỏi vừa vàng lên"},{"time":128.1,"text":"Mình sẽ vớt ra để ráo dầu"},{"time":130.9,"text":"Mình đã chiên sơ phần gà này"},{"time":135.8,"text":"Mình có cần chiên cho cả"},{"time":137.4,"text":"Hai mặt của cánh gà vàng không Long"},{"time":139.2,"text":"Mình chiên sơ thôi Thảo à"},{"time":140.7,"text":"Phần gà của mình đã chiên sơ vàng nhẹ rồi"},{"time":143.7,"text":"Rồi thì mình sẽ vớt gà ra"},{"time":144.8,"text":"Cánh gà đã được ướp gia vị"},{"time":146.3,"text":"Cho nên là khi mà đội bếp Hoàng Long đang chiên với dầu thôi"},{"time":149.4,"text":"Thì Kim Thảo đã nghe một cái mùi rất là thơm hấp dẫn rồi"},{"time":152.2,"text":"Và nhìn màu cũng rất là đẹp"},{"time":154.8,"text":"Kim Thảo đã có một cái nồi rất là đẹp ở đây"},{"time":156.9,"text":"Thấy không? Thôi Kim Thảo giúp Lông cái này luôn nha"},{"time":160.2,"text":"Mình lót hành tây dưới đây nó vừa thơm"},{"time":161.9,"text":"Mà nó sẽ không bị cháy phần gà"},{"time":164.5,"text":"Lông có cho các cái gia vị vô như là hành tím nè"},{"time":166.9,"text":"Và gừng vào"},{"time":169.5,"text":"Bà Rô mình bỏ vô lên lúc này luôn cũng được"},{"time":173.5,"text":"Xào thơm nhẹ"},{"time":174.5,"text":"và tí xíu ớt khô"},{"time":176.0,"text":"Tất cả những món hoa mà Kim Thảo đã từng ăn"},{"time":178.1,"text":"thì có mùi gừng rất là thơm và hình như là rất là ấm bụng nè"},{"time":180.7,"text":"Đúng rồi, bây giờ Long phải cho cái phần gà này vào"},{"time":186.0,"text":"Rồi, bây giờ Long phải cho cái phần gà này vào nha"},{"time":189.5,"text":"Wow"},{"time":191.1,"text":"Đốt rượu để gà được thơm"},{"time":192.5,"text":"Sau khi đốt rượu mình phải tắt bếp"},{"time":193.7,"text":"Cho vào đây là 5 muỗng canh nước tương phú sỉ"},{"time":197.9,"text":"Đó, hương vị của món này"},{"time":199.5,"text":"chính là nước tương phú sỉ"},{"time":202.5,"text":"2 muỗng canh dầu hào"},{"time":206.2,"text":"Và nửa chén nước"},{"time":211.1,"text":"Thơm rồi đó"},{"time":212.2,"text":"Bây giờ Long sẽ xếp gà vào bên trong nồi"},{"time":214.8,"text":"Xong mình ôm lên"},{"time":215.9,"text":"Là một lát nữa ôm đúng đủ thời gian rồi"},{"time":218.9,"text":"Rồi mình dọn lên mâm mình ăn thôi hả"},{"time":220.8,"text":"Đúng rồi"},{"time":221.2,"text":"Sau khi xếp gà thì mình sẽ rưới cái phần nước sốt này lên"},{"time":225.7,"text":"Rưới từng cái góc nè"},{"time":228.8,"text":"Nó rất là thơm đúng không Kim Thảo"},{"time":231.9,"text":"Cho cái phần tiêu xanh"},{"time":233.9,"text":"Kỷ tử và tỏi chiên vào"},{"time":235.7,"text":"Sau khi mình cho cái này vào"},{"time":237.4,"text":"Thì mình sẽ dùng giấy bạc mình bọc kính lại"},{"time":242.6,"text":"Mình lưu ý là"},{"time":243.5,"text":"Mình sẽ dùng đại nắp mình đậy lại"},{"time":245.0,"text":"Sau đó mình chỉnh cái viền giấy bạc lại cho kính hơi"},{"time":247.0,"text":"Sau khi mình bọc giấy bạc lại để gà kính hơi bên trong"},{"time":250.2,"text":"Thì mình sẽ ôm với lửa vừa để gà thấm vị"},{"time":252.3,"text":"Kim Thảo bật lửa nha"},{"time":254.6,"text":"Kim Thảo ơi quá 25 phút rồi đó"},{"time":256.7,"text":"Bây giờ món ăn chúng ta đã hoàn thành nha"},{"time":258.4,"text":"Như vậy là món ăn của chúng ta trong tích tắc đã hoàn thành rồi"},{"time":261.7,"text":"Chỉ có tốn thời gian 25 phút mà chúng ta ôm gà thôi"},{"time":264.7,"text":"Rất tuyệt vời đúng không ạ"},{"time":266.2,"text":"Để xem lại công thức của món ăn ngón lành ngày hôm nay"},{"time":268.9,"text":"Quý vị và các bạn chỉ cần quét mã QR trên mạng hình nha"},{"time":280.9,"text":"Thì mình nên ăn kèm với món canh cua khổ qua"},{"time":282.8,"text":"Kim Thảo xin chúc cho tất cả mọi người"},{"time":284.6,"text":"Sẽ làm thành công món ăn ngày hôm nay"},{"time":286.0,"text":"Để đãi cho cả gia đình của mình nhé"},{"time":288.5,"text":"Thịt gà màu vàng nâu"},{"time":290.0,"text":"Thơm mùi hương hài hòa của nước tương phú sỉ"},{"time":292.4,"text":"Và các loại gia vị"},{"time":293.8,"text":"Nước sốt quyện sánh"},{"time":295.5,"text":"Thấm vào từng thớ thịt vị mặn ngọt"},{"time":297.9,"text":"Hao cơm"},{"time":300.2,"text":"Đối vị cho bữa cơm gia đình bằng món gà om kiểu hoa"},{"time":303.8,"text":"Cực kỳ lôi cuốn"},{"time":305.1,"text":"Và thật bắt cơm"},{"time":306.4,"text":"Và để xem lại công thức của món ăn ngày hôm nay"},{"time":308.4,"text":"Cùng với rất nhiều món ăn tuyệt vời khác nữa"}]}