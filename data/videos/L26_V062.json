 giả đã quay trở lại với chương trình Món ngon mỗi ngày nấu chuẩn ăn lành"},{"time":37.8,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":41.6,"text":"Kim Thảo đã nhìn thấy đầu bếp Hoàng Long ngày hôm nay chuẩn bị một con gà sẵn trên bàn bếp rồi"},{"time":46.1,"text":"Đáng suy nghĩ là không biết sẽ nấu món hấp, món nướng hay là món gì đây ta?"},{"time":50.0,"text":"Hay quá vậy, nhìn là biết món hấp luôn hả? Đúng"},{"time":52.0,"text":"Hôm nay làm món hấp, nhưng mà một món hấp là kiểu rất là mới, rất là lạ"},{"time":55.9,"text":"Đó là món gà hấp hành râm"},{"time":58.2,"text":"Đầu tiên thì chúng ta sẽ ướp gà, chúng ta cần một muỗng cà phê tiêu"},{"time":61.2,"text":"2 muỗng canh nước hành tím"},{"time":63.4,"text":"1 muỗng canh nước mắm"},{"time":65.7,"text":"Và 1 muỗng canh bột canh Ajinomoto"},{"time":70.4,"text":"Khuấy đều lên"},{"time":73.2,"text":"Mình sẽ thoa đều lên"},{"time":75.5,"text":"Massage cả ở bên ngoài da"},{"time":77.3,"text":"Và bên trong lòng của con gà luôn"},{"time":79.0,"text":"Để cho nó thấm đều gia vị đúng không"},{"time":80.8,"text":"Đúng rồi"},{"time":81.3,"text":"Với bữa ăn này chúng ta chọn gà ta con vừa để bữa ăn ngon hơn"},{"time":84.8,"text":"Thịt gà có chứa nhiều protein"},{"time":86.6,"text":"Giúp bồi bổ sức khỏe rất là phù hợp đấy ạ"},{"time":89.8,"text":"Giờ trong khi gà"},{"time":90.8,"text":"Mình cho nó thấm gia vị thì Long với Kim Thảo"},{"time":92.9,"text":"Gìm Thảo sẽ cùng nhau chuẩn bị các phần nguyên liệu đi kèm, Gìm Thảo sẽ giúp Long cắt phần hành tây nha"},{"time":108.0,"text":"Hành tím mình đập dập, rau răm thì mình cắt rối, xong rồi"},{"time":121.3,"text":"Rồi cảm ơn Gìm Thảo, gừng thì Long sẽ cắt lát sau đó đập dập"},{"time":124.3,"text":"Mặc dù món ăn ngày hôm nay có tên là gà hấp hành răm, gà cùng với hành lá và rau răm là nguyên liệu chính"},{"time":131.5,"text":"Nhưng mà đầu bếp Hoàng Long vẫn đang sử dụng gừng để có thể là tạo lên mùi thơm cho món ăn ngày hôm nay"},{"time":140.7,"text":"Mình sẽ đập dập cái phần đầu hành"},{"time":146.5,"text":"Phần lá chanh thì mình sẽ cắt chỉ"},{"time":156.5,"text":"Bây giờ thì mình sẽ chuẩn bị một cái nồi nước để mình hấp gà"},{"time":159.7,"text":"Mở bếp lên"},{"time":161.3,"text":"Trên tay Long là phần nửa của rau răm và hành tây mà Long đã chia sẵn"},{"time":165.3,"text":"Cái đến Long sẽ trộn vào đây nửa muỗng cà phê bột canh Ajinomoto"},{"time":169.1,"text":"Trộn đều lên"},{"time":170.4,"text":"Mình sẽ nhòi bên trong con gà"},{"time":175.6,"text":"Mình dồn hết cái phần rau răm và hành này vào bên trong của gà"},{"time":178.8,"text":"Thì khi hấp đó Kim Thảo"},{"time":180.1,"text":"Cái phần mùi thơm của rau râm"},{"time":182.1,"text":"Và hành sẽ quyện vào bên trong thịt gà"},{"time":184.6,"text":"Bây giờ Long sẽ lót một ít đậu hành"},{"time":186.6,"text":"Và gừng phía dưới"},{"time":191.3,"text":"Rồi, rồi mình xếp gà lên"},{"time":192.6,"text":"Một chút gừng"},{"time":196.6,"text":"Và hành lên phía trên"},{"time":199.0,"text":"Cho thơm"},{"time":199.8,"text":"Và bây giờ nước đã sôi"},{"time":201.3,"text":"Thì Long hãy cho gà vào hấp"},{"time":203.7,"text":"Rồi, Kim Thảo giúp Long nha"},{"time":210.2,"text":"Chúng ta hấp lửa vừa để gà chín đều"},{"time":212.1,"text":"Mình sẽ có thể hấp trong vòng bao nhiêu lâu thì gà chín Long?"},{"time":215.3,"text":"Ừ, với con gà trong hôm nay mình dùng"},{"time":217.4,"text":"Nó là khoảng 1kg 3"},{"time":218.2,"text":"Thì mình hấp trong vòng 30 phút"},{"time":220.2,"text":"Bây giờ chúng ta sẽ tiến hành pha nước chấm gà"},{"time":222.9,"text":"Long sử dụng 2 muỗng canh"},{"time":224.5,"text":"Một canh Ajinomoto"},{"time":226.5,"text":"Nửa muỗng canh ớt băm"},{"time":230.1,"text":"Một muỗng canh nước cốt chanh"},{"time":232.2,"text":"Một chút lá chanh"},{"time":233.7,"text":"Và trộn đều lên"},{"time":236.9,"text":"Bây giờ thì sau 30 phút thì món gà của chúng ta cũng đã chín"},{"time":239.3,"text":"Bây giờ Long sẽ dọn ra và mời mọi người cùng thưởng thức"},{"time":241.5,"text":"Cắt bếp"},{"time":242.6,"text":"Wow"},{"time":245.2,"text":"Rồi"},{"time":248.3,"text":"Gà đã chín vừa và rất thơm"},{"time":249.9,"text":"Bây giờ Long sẽ chặt ra và dọn ra đĩa"},{"time":251.5,"text":"Như vậy là chúng ta đã hoàn tất món ăn của ngày hôm nay rồi"},{"time":254.7,"text":"Nhanh gọn lẹ đúng không ạ?"},{"time":256.3,"text":"Nếu mà muốn xem lại những bí kíp sáng tạo của đầu bếp Hoàng Long ngày hôm nay"},{"time":260.1,"text":"Quý vị và các bạn chỉ cần quét mã QR trên mạng hình của chúng tôi"},{"time":265.4,"text":"Gà thì đã chặt ra rồi"},{"time":266.6,"text":"Bây giờ mình sẽ xếp từng miếng vào đĩa đây"},{"time":276.1,"text":"Hành tím"},{"time":281.5,"text":"Như vậy là món gà hấp hành răm của chúng ta cũng đã hoàn thành"},{"time":285.2,"text":"Những miếng thịt gà vàng ươm"},{"time":286.9,"text":"Thơm được mùi rau răm"},{"time":288.8,"text":"Lá chanh"},{"time":289.7,"text":"Thịt chín vừa tới ngọt đậm"},{"time":291.8,"text":"Chấm cùng vị đậm đà chua cay của bột canh"},{"time":294.5,"text":"Tạo nên hương vị khó lẫn cho món ăn"},{"time":296.8,"text":"Sức hấp dẫn của món gà hấp hành răm nóng hổi"},{"time":302.1,"text":"Không thể chối từ đúng không ạ"},{"time":303.9,"text":"Chúng ta hãy bắt tay thử ngay nào"},{"time":306.0,"text":"Và để xem lại trọn vẹn công thức của món ăn ngày hôm nay"},{"time":308.7,"text":"Và kết hợp với rất nhiều món ăn hấp dẫn khác nữa"},{"time":311.5,"text":"Xin hãy truy cập vào Youtube website fanpage của chương trình Món Ngon Mỗi Ngày"}]}