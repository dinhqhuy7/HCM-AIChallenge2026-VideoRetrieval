t":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":40.4,"text":"Hôm nay mình pha thức uống"},{"time":42.1,"text":"Đúng"},{"time":42.6,"text":"Mình lại pha kết hợp cùng với lại trà xanh với lại cacao"},{"time":46.8,"text":"Phải có bột trà xanh đúng không?"},{"time":48.5,"text":"Đây là cái thành phần mà không bao giờ thiếu trong nhà tôi"},{"time":51.5,"text":"Bởi vì người Nhật người ta làm ra cái bột trà xanh này rất là hay"},{"time":54.8,"text":"Chất chống oxy hóa ở trong bột trà xanh Matcha là nó cao gấp 137 lần"},{"time":60.2,"text":"So với trà thông thường mà mình hãm bằng nước nóng ở nhà"},{"time":63.2,"text":"Cho nên đây là một cái thành phần mà chúng ta hãy sử dụng thường xuyên"},{"time":66.8,"text":"Để giúp cho chúng ta duy trì thanh xuân của mình"},{"time":69.6,"text":"Minh Tướng rành ghê ha"},{"time":70.8,"text":"Thấy trẻ không?"},{"time":71.8,"text":"Đó, uống trà xanh mỗi ngày"},{"time":73.1,"text":"Minh Tướng uống thêm cái này cũng là chống oxy hóa nữa nè"},{"time":75.4,"text":"Cacao"},{"time":75.9,"text":"Đúng rồi, cacao"},{"time":77.7,"text":"Các cà cao mà kết hợp với trà xanh nữa thì mọi người trẻ trường tôn"},{"time":81.7,"text":"Thế là chúng ta làm ngay món thức uống của ngày hôm nay thôi"},{"time":84.4,"text":"Ok, thì đầu tiên thì mình sẽ pha cái bột matcha trà xanh nha"},{"time":88.1,"text":"Chúng ta sẽ cho 2 gói trà matcha sữa blended"},{"time":92.5,"text":"Cho 60ml nước nóng vào trong đây"},{"time":94.4,"text":"Quấy cho nó tan hết cái bột trà sữa bên trong"},{"time":97.0,"text":"Bột matcha của chúng ta đã tan hết rồi"},{"time":99.3,"text":"Chúng ta sẽ để nguội một tí xíu"},{"time":101.0,"text":"Tiếp theo thì chúng ta sẽ ngâm nợ nho khô này nha"},{"time":104.4,"text":"Cùng với rượu rum"},{"time":105.3,"text":"Chúng ta ngâm nho khô cùng với rượu rum giúp tăng hương vị cho thức uống của chúng ta ngày hôm nay nha"},{"time":109.9,"text":"Nho mà kết hợp với rượu rum là một sự kết hợp hoàn hảo luôn"},{"time":114.4,"text":"Tuấn thích ăn kem rung nho nè, nho mà ngâm với đuôi rung trong làm bánh cũng rất là ngon luôn"},{"time":120.1,"text":"Và bây giờ mình lấy nho mình ngâm với đuôi rung và mình cho vào trong thức uống này luôn"},{"time":123.3,"text":"Đúng, khi mà mình uống xong mình thưởng thức một quả nho như vậy thì nó sẽ tăng vị giác của mình nên rất là hấp dẫn"},{"time":130.4,"text":"Tiếp theo mình sẽ cho 50g kem béo này vào, cùng 20g bột cacao"},{"time":136.1,"text":"Và chúng ta sẽ cho sữa không đường này vào 2 phần 3 thôi"},{"time":139.4,"text":"Trước khi mở máy thì chúng ta nên quậy cho nó đều lên trước"},{"time":143.1,"text":"Mình mới mở máy"},{"time":144.2,"text":"Các bạn khán giả lưu ý chúng ta đánh kem cùng với bột cacao"},{"time":147.1,"text":"Bằng máy đánh cầm tay giúp bột cacao tan đều hơn nha"},{"time":149.9,"text":"Mình đánh cho nó bong cứng lên một tí xíu là được đó Minh Tùng"},{"time":157.7,"text":"Rồi và bây giờ kem cacao của chúng ta đã bong lên rồi"},{"time":160.6,"text":"Chúng ta sẽ kết hợp tất cả các nguyên liệu lại trong ly nha"},{"time":163.6,"text":"Một lớp matcha này xuống dưới đấy"},{"time":165.4,"text":"Sau đó chúng ta sẽ cho nhẹ nhàng"},{"time":168.0,"text":"Cái phần sữa này vào"},{"time":169.0,"text":"Và bây giờ là tới cái phần hấp dẫn nhất nè"},{"time":171.3,"text":"Chúng ta sẽ cho cái phần kem cacao này vào"},{"time":174.7,"text":"Trời ơi Mình ơi đẹp quá Mình ơi"},{"time":176.5,"text":"Đó"},{"time":177.8,"text":"Quá xuất sắc"},{"time":179.3,"text":"Rồi"},{"time":180.3,"text":"Nho khô đã ngâm nở lúc nãy á"},{"time":182.4,"text":"Chúng ta sẽ"},{"time":183.5,"text":"Lớp bên lên trên"},{"time":186.0,"text":"Rồi"},{"time":188.1,"text":"Trời ơi mọi người nhìn đi"},{"time":189.2,"text":"Một cái ly 3 tầng"},{"time":191.1,"text":"Đẹp"},{"time":191.7,"text":"Nhất nhối"},{"time":193.2,"text":"Nhìn thì có vẻ phức tạp"},{"time":194.7,"text":"Tưởng là làm nó khó khăn lắm"},{"time":196.1,"text":"Nhưng thật ra rất đơn giản"},{"time":197.7,"text":"Các bạn có muốn làm cái này ở nhà không?"},{"time":199.5,"text":"Rất dễ ha"},{"time":200.2,"text":"Ngay bây giờ trên màn hình có một mã QR"},{"time":202.4,"text":"Để mọi người có thể quét mã này"},{"time":204.2,"text":"Chúng ta sẽ biết được cách thức để làm một ly trà sữa siêu đẹp"},{"time":207.7,"text":"Có thể dành tặng người yêu hay là dành tặng chính bản thân mình"},{"time":212.3,"text":"Và bây giờ chúng ta sẽ tăng cái phần hấp dẫn lên một tí xíu"},{"time":215.2,"text":"Đó là cắm thêm một ít lá húng lũi vào"},{"time":217.2,"text":"Nhân trí, thấy là phần nước của chúng ta đã hoàn thành rồi đó Minh Tuấn"},{"time":220.3,"text":"Uống nước các bạn hay kết hợp với món bánh đúng không?"},{"time":223.0,"text":"Chúng ta có thể kết hợp cùng với bánh rán trái cây nha"},{"time":226.6,"text":"Mọi người nhìn cái món thức uống ngày hôm nay đi"},{"time":228.6,"text":"Như là được phục vụ trong một nhà hàng năm sau vậy đó"},{"time":231.4,"text":"Nhưng mà thật ra cái cách thức để mà làm ra rất là đơn giản"},{"time":234.1,"text":"Bây giờ ăn một miếng bánh rán trái cây, nhai trong miệng, xong rồi hớp một hớp nước."},{"time":239.9,"text":"Cuộc đời thật đẹp làm sao. Cảm ơn Minh đã mang đến một món nước rất là hấp dẫn và rất đẹp mắt như thế này trong ngày hôm nay."},{"time":246.4,"text":"Cảm ơn Minh Tuấn."},{"time":247.5,"text":"Lớp kem cacao béo ngậy, bột matcha thơm lừng, nho khô ngọt ngào, nồng nồng mùi rượu, cùng sắc xanh nâu cuốn hút tạo nên một ly matcha sữa cacao mát lạnh, đẹp từ hình thức, ngon đặc biệt."},{"time":262.6,"text":"Uống một ngụm là gật gù mê say"},{"time":266.2,"text":"Đến với lại món ngon mỗi ngày rồi"},{"time":267.7,"text":"Ăn ngon rồi"},{"time":268.9,"text":"Thì phải uống ngon đúng không"},{"time":270.2,"text":"Đó chính là món thức uống vô cùng tuyệt vời"},{"time":272.4,"text":"Matcha sữa cacao mà chúng tôi giới thiệu đến cho mọi người hôm nay"},{"time":275.4,"text":"Nhìn có vẻ phức tạp"},{"time":276.5,"text":"Nhưng làm thì rất đơn giản"},{"time":277.8,"text":"Công thức thì có trên Youtube, Website và Fanpage"},{"time":281.0,"text":"Của chương trình Món ngon mỗi ngày"},{"time":282.3,"text":"Truy cập vào đây và thực hiện ngay tại nhà"},{"time":284.5,"text":"Để dành tặng cho người yêu của mình nha"},{"time":286.1,"text":"Chúc các bạn thành công"}]}