e":64.5,"text":"Ăn chay á cô"},{"time":65.2,"text":"Bây giờ mình lại tiếp tục em nhờ cô"},{"time":67.4,"text":"Làm thêm món mới để vào những cái dịp đặc biệt"},{"time":70.0,"text":"Như là rằm hay là bụng một"},{"time":71.3,"text":"Để cho mọi người có những cái món mới"},{"time":72.9,"text":"Mình trải nghiệm trong việc ăn chay"},{"time":74.2,"text":"Chương trình sẽ giới thiệu một món chay"},{"time":76.1,"text":"Có tên gọi là củ năng ôm nắm chay"},{"time":79.3,"text":"Theo chuyên gia dinh dưỡng sẽ là một món ăn"},{"time":81.5,"text":"Hỗ trợ cho tim mạch và giảm mỡ thừa"},{"time":83.9,"text":"Để chọn củ năng ngon"},{"time":85.3,"text":"Thì chúng ta sẽ chọn những cái củ năng"},{"time":87.6,"text":"Mà nó không có bị mùi chua"},{"time":89.8,"text":"Và phía bên ngoài thì nó láng bóng"},{"time":92.2,"text":"Không sần sùi"},{"time":92.8,"text":"Và đồng thời nó cũng không có đổ nhớt"},{"time":94.6,"text":"Vì vậy là củ năng sẽ ngon đó"},{"time":95.9,"text":"Bây giờ chúng ta sẽ cắt đôi"},{"time":97.1,"text":"Nếu mà củ nào nhỏ thì chúng ta có thể là mình sẽ để nguyên"},{"time":100.0,"text":"Củ cải trắng chúng ta mua về"},{"time":101.8,"text":"Mình sẽ gọt vỏ ra"},{"time":103.0,"text":"Và mình cắt như thế này ra"},{"time":104.7,"text":"Người ta hay gọi là cắt móng ngựa đó"},{"time":106.6,"text":"Củ cà rốt cũng vậy"},{"time":107.8,"text":"Chúng ta cũng sẽ cắt móng ngựa"},{"time":111.0,"text":"Xả đập dập cắt khúc"},{"time":113.5,"text":"Cái này tôi cắt làm 3 khúc"},{"time":115.4,"text":"Tiếp theo là nấm mèo thì chúng ta sẽ cắt miếng khoảng chừng 2 phần"},{"time":119.3,"text":"Còn nấm hương"},{"time":120.1,"text":"Cắt sợi"},{"time":121.7,"text":"Củ hành tây thì chúng ta sẽ cắt miếng thành tam giác"},{"time":125.7,"text":"Xong sau đó mình cắt đôi"},{"time":127.7,"text":"Ơt sừng thì chúng ta sẽ cắt lá"},{"time":131.5,"text":"Cuối cùng là rau ôm và ngò gai chúng ta cắt nhỏ"},{"time":135.4,"text":"Còn bây giờ thì xong xuôi hết rồi"},{"time":136.7,"text":"Mình nấu cô ha"},{"time":137.5,"text":"Đúng rồi đó"},{"time":138.2,"text":"Đầu tiên thì chúng ta sẽ cho vào đây 2 muỗng canh màu dầu điều"},{"time":141.1,"text":"Đợi dầu nóng vừa vừa thôi"},{"time":142.5,"text":"Chúng ta sẽ cho sả vào"},{"time":143.9,"text":"Tiếp theo chúng ta sẽ cho vào đây là bò rô cắt lá"},{"time":146.6,"text":"Bây giờ chúng ta sẽ cho củ năng vô"},{"time":148.6,"text":"Củ cải trắng và cà rốt vô"},{"time":150.7,"text":"Các bạn lưu ý là chúng ta sẽ xào trước củ năng, củ cải trắng và củ cà rốt cho đến gần chín"},{"time":156.1,"text":"Sau đó thì chúng ta mới cho các nguyên liệu khác để là các nguyên liệu chín đều"},{"time":159.8,"text":"Đậu phộng này chúng ta sẽ mua đậu phộng chúng ta về luộc chín"},{"time":163.0,"text":"Hoặc là chúng ta có thể là mua đậu phộng luộc sẵn"},{"time":167.9,"text":"Tất cả những thành phần nguyên liệu rất là thơm luôn"},{"time":169.8,"text":"Và đặc biệt là trong đây có 2 cái thành phần giúp cho chúng ta có thể là cân bằng được khuyết áp cũng như là ổn định nhịp tim"},{"time":175.5,"text":"Đó chính là củ năng cũng như là củ cải trắng"},{"time":177.4,"text":"Bởi vì trong đây có rất là nhiều cali"},{"time":178.8,"text":"Các bạn hãy nhớ bổ sung thêm 2 thành phần này ha"},{"time":180.7,"text":"Chúng ta sẽ nêm vào đây là 1 muỗng canh bột cà ri hòa với nước"},{"time":184.9,"text":"1 muỗng canh hạt nêm Aji ngon nắm"},{"time":188.2,"text":"Nửa muỗng canh đường"},{"time":189.4,"text":"1 muỗng cà phê bột ngọt Aji no moto"},{"time":193.1,"text":"Chúng ta sẽ đảo đều"},{"time":195.5,"text":"Bây giờ thì mình sẽ cho nấm hương vô trước nha"},{"time":197.8,"text":"Chúng ta sẽ cho vào đây là nước dảo dừa"},{"time":200.2,"text":"Mình cho khoảng chừng 1 tô như thế này"},{"time":206.0,"text":"Rồi đủ 10 phút rồi đó, Tứng bây giờ mở ra nè"},{"time":210.0,"text":"Tiếp theo thì chúng ta sẽ cho đậu hủ chiên vô đây"},{"time":212.1,"text":"Và tiêu xanh"},{"time":213.5,"text":"Sau khi mà mình cho đậu hủ vô"},{"time":215.6,"text":"Chúng ta sẽ nấu tiếp khoảng chừng 3 phút"},{"time":217.4,"text":"Cuối cùng thì mình sẽ cho vô"},{"time":219.3,"text":"Gồm có nấm mèo, hành tây và ớt"},{"time":222.2,"text":"Cuối cùng thì mình sẽ nêm vào đây"},{"time":224.1,"text":"Thêm nửa muỗng canh nước tương phú sỉ"},{"time":225.9,"text":"Mình sẽ cho phần nước cốt dừa"},{"time":227.8,"text":"Khoảng 1 chén nước cốt dừa"},{"time":229.2,"text":"Mình cho vô, mình đảo đều"},{"time":231.3,"text":"Và đến khi mà phần nước sôi lại"},{"time":233.5,"text":"Thì mình sẽ tắt lửa nha các bạn"},{"time":241.6,"text":"Với nước cốt dừa thì chúng ta nấu gần xong"},{"time":243.9,"text":"Mới cho vô để tránh trường hợp bị vóng cụt nha"},{"time":246.2,"text":"Trước khi tắt lửa"},{"time":247.2,"text":"Thì chúng ta sẽ cho một ít rau nêm vô"},{"time":250.6,"text":"Ngay bây giờ trên bàn hình có một mã quy đờ"},{"time":252.5,"text":"Các bạn có thể quét mã này"},{"time":253.9,"text":"Chúng ta sẽ có ngay công thức nấu ăn"},{"time":255.4,"text":"Của món chay ngày hôm nay để thực hiện tại nhà"},{"time":259.5,"text":"Bây giờ thì chúng ta sẽ trình bày món ăn này nha các bạn"},{"time":265.6,"text":"Sẽ thêm vào đây một ít tàu hủ kia chiên"},{"time":268.2,"text":"Mình bớp dụng dụng ra"},{"time":269.5,"text":"Rắc lên"},{"time":270.5,"text":"Rồi mình sẽ cho thêm rau thơm nè"},{"time":272.7,"text":"Rắc đậu phộng lên nè"},{"time":274.4,"text":"Sẽ đặt lên đây một cọng đọt của rau ôm"},{"time":277.7,"text":"Cho nó đẹp"},{"time":278.3,"text":"Với hôm nay thì các bạn có thể ăn kèm với lại bánh mì và muối tiêu chanh"},{"time":283.5,"text":"Rất là thơm"},{"time":284.7,"text":"Em ăn thử củ năng nè"},{"time":292.0,"text":"Tất cả các thành phần rau củ thì nó mềm"},{"time":294.8,"text":"Ăn đến nấm mèo thì nó giòn giòn"},{"time":296.9,"text":"Ăn đến củ năng thì nó còn giòn hơn nữa"},{"time":298.9,"text":"Cắn chút một chút đậu phộng thì nó béo"},{"time":301.4,"text":"Nước dùng thì thơm lừng béo ngậy luôn"},{"time":304.3,"text":"Nói chung là rất là bắt luôn"},{"time":306.1,"text":"Và món ăn củ năng ôm nấm chay ngày hôm nay"},{"time":308.9,"text":"Các bạn có thể áp dụng theo thực đơn như gợi ý"},{"time":315.8,"text":"Như vậy là chúng ta lại có thêm một công thức món ăn mới"},{"time":318.3,"text":"Cho mỗi dịp ngày rằm hay là ngày đầu tháng"},{"time":321.2,"text":"Các bạn hãy nhớ thực hiện ngay món ăn này tại nhà"},{"time":323.6,"text":"Bởi vì đây là một món ăn có thể đáp ứng được"},{"time":325.4,"text":"Mọi nhu cầu của mọi thành viên trong gia đình"},{"time":327.4,"text":"Ai ăn cơm cũng được, ăn bánh mì cũng được"},{"time":329.4,"text":"Hay thậm chí ăn bế bún cũng được luôn"},{"time":330.7,"text":"Và công thức thì sẽ có trên những kênh rất quen thuộc"},{"time":333.4,"text":"Của Món Ngon Mỗi Ngày"},{"time":334.2,"text":"Đặc biệt là website mới của Món Ngon Mỗi Ngày"},{"time":337.0,"text":"Trang mónngonmỗingày.com"},{"time":338.4,"text":"Các bạn có thể truy cập vào đây"},{"time":339.8,"text":"để có thêm nhiều công thức chay khác hấp dẫn hơn các bạn nha."},{"time":342.6,"text":"Chúc các bạn thành công!"}]}