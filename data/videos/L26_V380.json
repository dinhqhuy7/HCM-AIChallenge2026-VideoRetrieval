3.4,"until":225.7,"text":"AJINOMOTO · MON · BOT CANH · móingày"},{"time":233.2,"until":235.0,"text":"mingày · MON · MOZ"},{"time":252.1,"until":254.1,"text":"AJINOMOTO · Onlir · Eat Well, Live Well · moingày"},{"time":254.3,"until":255.6,"text":"máingay"},{"time":256.2,"until":260.1,"text":"AJINOMOTO · CÀ TÍM · Onlin · KHO RAU RÁM · DINH DUONG · Eat Well, Live Well. · KHO RAU RÁM XÀO TÓM THIT · CÁ KÈO · moingày · VÓI · BÜA ÃN DÀV DÙ · BUA ÀN DÀY DÚ · inmON · VOI"},{"time":260.5,"until":264.5,"text":"moingay · moingày · CONONOTO · MInUS-ZERO COOUNG · mInuS-ZERO CODUNG · HTW · HTM · ENOMOTO"},{"time":264.7,"until":267.5,"text":"Beobéo · Tuơi mêm"},{"time":267.7,"until":271.6,"text":"Thanh ngot"},{"time":275.8,"until":282.0,"text":"NOMOTO · Eat Well · Eat Well, Live Well. · Singay · mingày · mir · Live weld · moing"},{"time":282.3,"until":284.3,"text":"AJINOMOTO · Eat Well, Live Well. · MON · moingày"},{"time":285.3,"until":292.8,"text":"Website · Youtube · Fanpage Facebook · Fanpage Fa · www.monngonmoingay.com · Món Ng · XEMKY · www.monn · Món Ngon Mõi Ngày · moingay · CÁC BUO · CÁC BUÓCNÃU · CÁC BUOC NÃU ÃN:"},{"time":293.6,"until":305.2,"text":"Bt Canh Ajinomoto · Nguyên liu · Tham gia · Công ty Ajinomoto Vit Nam · Mit non: 400g · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Chanh: 1/2 trái · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Hành lá: 3 nhánh · Suòn non: 400g · Công ty HKFilm · Báp chui xanh: 150g · Trái và: 2 quà · Phi hp thc hin · Công ty C · Thc hin chương trình · Lá lôt: 5 lá · chương trình thuc · DÀI TRUYÊN HìNH TP. HCM · Nuc tuong “Phú Si” · Thc hié · Ký tú 1M"}],"speech":[{"time":13.4,"text":"Anh ăn cái gì mà anh ăn một mình nên không cho em ăn vậy hả?"},{"time":15.7,"text":"Biết cái gì thôi mà đòi ăn"},{"time":16.7,"text":"Trời ơi, không biết nữa để em coi"},{"time":22.3,"text":"Em xuất khẩu thành thơ luôn cho anh coi"},{"time":24.5,"text":"Ghê lắm"},{"time":26.5,"text":"Quả xanh xanh, có gân, da nhám"},{"time":31.0,"text":"Đúng rồi"},{"time":32.1,"text":"Thân tròn tròn mà tạo hóa bắt dẹt ra"},{"time":36.4,"text":"Đó chính là trái vả"},{"time":38.1,"text":"Em hay quá anh ơi"},{"time":39.3,"text":"Xuất sắc đúng là MC của chương trình Nóng Ăn"},{"time":42.4,"text":"Dạ em thấy người ta làm nhiều món lắm nè"},{"time":44.2,"text":"Ví dụ như là chấm mâm ruốt nè"},{"time":45.7,"text":"Ví dụ như là mình trộn gỏi nè"},{"time":48.1,"text":"Đó chẳng hạn vậy"},{"time":48.8,"text":"Hôm nay mình làm món gì anh?"},{"time":50.5,"text":"Hôm nay mình nấu canh đi"},{"time":51.9,"text":"Tại vì mình mới học được một món canh từ trái vả"},{"time":54.1,"text":"Vô bếp"},{"time":56.8,"text":"Thành ngọt với canh xương mít nòn trái vả"},{"time":76.2,"text":"Rất vui khi được gặp lại các bạn khán giả đang xem chương trình Món ngon vỏ ngay"},{"time":79.3,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":83.3,"text":"Chúng ta cần xương chặt ra từng khúc từ khúc khoảng 3cm"},{"time":86.0,"text":"Vậy chúng ta ngâm trong nước lạnh"},{"time":87.2,"text":"Ngâm xả, ngâm xả khoảng 3-4 lần"},{"time":89.2,"text":"Cho nước ngâm được trong"},{"time":90.4,"text":"Sau đó chúng ta để ráo như vầy"},{"time":92.1,"text":"Như vầy nước canh nấu sẽ trong và thơm"},{"time":94.3,"text":"Ngọt thịt"},{"time":95.2,"text":"Phần đầu hành và phần lá hành"},{"time":96.6,"text":"Phần đầu chúng ta đập dập ra"},{"time":98.9,"text":"Như vầy"},{"time":99.6,"text":"À chúng ta cắt nhỏ"},{"time":102.1,"text":"Rồi làm gì Minh Tứng biết không nào"},{"time":103.9,"text":"Để ướp vô trong thịt"},{"time":105.1,"text":"Chính xác"},{"time":105.9,"text":"Cho thịt thơm"},{"time":106.7,"text":"À"},{"time":108.0,"text":"Phần lá chúng ta làm gì"},{"time":109.2,"text":"Mình sẽ nêm sau khi nấu canh xong"},{"time":110.8,"text":"Hoàng đòn chính xác"},{"time":112.2,"text":"Rồi hành lá mình cắt xong cho vào đây nha"},{"time":115.1,"text":"Rồi xong"},{"time":115.9,"text":"Cho vô"},{"time":117.2,"text":"Rồi chúng ta ướp vào đây 1 muỗng cà phê"},{"time":119.3,"text":"Bột canh của công ty Ajinomoto"},{"time":121.3,"text":"Đó, với một ít đầu hành lá"},{"time":125.2,"text":"Trời ơi"},{"time":126.5,"text":"Xuất sắc"},{"time":128.3,"text":"Lấy nồi thì anh mở bếp"},{"time":129.9,"text":"Bắt lên luôn"},{"time":131.8,"text":"Bắt bếp thì cho dầu vô"},{"time":133.7,"text":"Rồi, anh nghĩ được rồi đó"},{"time":134.9,"text":"Rồi, bỏ bộ vô"},{"time":136.8,"text":"Đó, xào vừa gì mỡ vừa tương ra"},{"time":139.8,"text":"Các bạn lưu ý nha"},{"time":141.1,"text":"Chúng ta chỉ cần xào cho sườn xanh"},{"time":143.3,"text":"Để sườn tương mỡ ra"},{"time":144.8,"text":"Để làm gì? Sườn thấm gia vị"},{"time":146.6,"text":"Và sườn thơm hơn"},{"time":147.8,"text":"Chúng ta cho đây 1,5 lít nước vào"},{"time":149.7,"text":"Và các bạn nhớ là cho nước nguội nha các bạn"},{"time":154.8,"text":"Đây là cái bí quyết mà anh Vũ mới vừa chia sẻ với Tuấn là chúng ta sẽ dùng nước nguội để cái phần nước thịt mình nó sẽ ngọt hơn"},{"time":160.7,"text":"Chính xác"},{"time":161.5,"text":"Và một điều nữa các bạn chúng ta nên nấu sườn với lại nước lạnh để cho nước canh được ngọt và sườn được mềm hơn nha các bạn"},{"time":166.5,"text":"Bít non này coi một nguyên liệu dân giả nhưng mà ăn vô cùng hấp dẫn"},{"time":170.9,"text":"Nó bùi bùi bùi bùi chát chát này nha"},{"time":172.8,"text":"Đó cắt miếng ra bùi ăn như vậy"},{"time":176.4,"text":"Rồi"},{"time":177.3,"text":"Rồi bít non xong"},{"time":178.3,"text":"Đây, chế vả, chúng ta bào vỏ nó nha các bạn"},{"time":180.8,"text":"Sau đó chúng ta cắt ra miếng vừa ăn"},{"time":183.0,"text":"Và chúng ta nhớ ngâm trong nước, có khoai nước cốt chanh nha các bạn"},{"time":187.7,"text":"Để cho đừng bị thăm đen đúng không anh?"},{"time":189.4,"text":"Đúng vậy"},{"time":189.8,"text":"Và thưa các bạn, chúng ta nêm vào đây 1 muỗng canh bột canh của công ty Ajiro Moto"},{"time":195.5,"text":"Và chỉ cần 1 lần là tròn vị"},{"time":198.9,"text":"Cho vào đây mít non trước"},{"time":200.8,"text":"Đó, chúng ta nấu"},{"time":202.6,"text":"Rau niêm thì chúng ta dùng lá lót, khoảng chừng 5 lá là được nha các bạn nha"},{"time":207.2,"text":"Dưới lá lót nó sẽ có mùi vị lạ hơn"},{"time":209.7,"text":"Rồi chúng ta cắt nhỏ ra như vầy"},{"time":213.4,"text":"Thưa các bạn bắp chuối xưa chúng ta cắt xong"},{"time":215.6,"text":"Thì ngâm trong nước pha đi xíu nước cốt chanh"},{"time":217.6,"text":"Như vậy thì bắp chuối sẽ giữ được màu xanh"},{"time":219.5,"text":"Chúng ta sẽ cho trái vả vào"},{"time":221.6,"text":"Chúng ta nấu một tí xíu nữa"},{"time":222.7,"text":"Rồi sau khi chúng ta cho trái vả vào nấu khoảng 2 phút"},{"time":225.6,"text":"Kế tiếp chúng ta sẽ cho bắp chuối xanh vào"},{"time":228.1,"text":"Chúng ta nấu cũng cỡ 2 phút nữa thôi"},{"time":230.7,"text":"Là món canh chúng ta đã hoàn tất"},{"time":232.9,"text":"Anh ơi"},{"time":236.8,"text":"Nó có sườn của em nữa anh ơi"},{"time":238.8,"text":"Trái vả của em nữa"},{"time":240.3,"text":"Rồi, rồi"},{"time":243.4,"text":"Ta lót vô"},{"time":246.3,"text":"Và thưa các bạn, kỳ tử chúng ta nên cho vào cuối cùng"},{"time":248.8,"text":"Các bạn nghe để cho kỳ tử còn giữ được"},{"time":250.8,"text":"Cái vị ngọt của nó ha"},{"time":251.7,"text":"Món canh này chúng ta sẽ dùng chung với"},{"time":254.1,"text":"Cái món cá kẹo khỏi rau răm nè"},{"time":255.4,"text":"Cà tím xào tôm thịt đi"},{"time":257.1,"text":"Bao luôn cân bằng dinh dưỡng"},{"time":260.1,"text":"Cân bằng dinh dưỡng mà còn hấp dẫn"},{"time":261.9,"text":"Một cái bữa ăn thịnh soạn luôn"},{"time":263.6,"text":"Cảm ơn anh"},{"time":264.4,"text":"Phân xương tươi mềm, ăn béo béo"},{"time":267.0,"text":"Hóa quả thì bùi bùi"},{"time":268.7,"text":"Đấm mình thấm vị trong nước canh thanh ngọt"},{"time":271.6,"text":"Thơm nhẹ mùi lá lốt"},{"time":273.4,"text":"Vừa ngon lại vừa tốt cho sức khỏe"},{"time":275.4,"text":"Món ăn ngày hôm nay thì phải nói là cực kỳ dễ nấu"},{"time":278.2,"text":"Nhưng mà về mặt hương vị và về mặt nhìn thì phải nói cực kỳ hấp dẫn luôn"},{"time":281.9,"text":"Các bạn hãy nhớ là chúng ta sẽ nấu thử món ăn này tại nhà"},{"time":285.8,"text":"Và công tức thì luôn luôn có ở trên Youtube, Website và cả Fanpage của chương trình Món ngon mỗi ngày"},{"time":291.2,"text":"Hãy nhớ truy cập vào và theo dõi nha"}]}