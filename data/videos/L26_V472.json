:275.0,"text":"Háp dân quá!"},{"time":276.2,"until":277.1,"text":"NGON · AJINOMOTO · mingày · Eat Well, Live Well."},{"time":280.1,"until":284.2,"text":"Béo thom · p mêm"},{"time":284.4,"until":288.1,"text":"Chua ngot · Chuan"},{"time":288.5,"until":294.7,"text":"NGON · OMOTO · mingày · moingay · Eat Well, Live Well. · Eat Wen. Liy · AJINC"},{"time":295.7,"until":305.1,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · Nho xanh không ht: 6 quà · Thanh long đò cát ht lu: 1M · Whipping đánh ni: 1 chén · Nuóc thanh long đò xay: 100g · Bt bánh rán pha sn · Thanh long dò cát lát: 2 mièng · Phi hp thc hin · Thc hin chương trình · v truyn thóng: 1 gói · DÀI TRUYÊN HìNH TP. HCM · chuơng trình thuc · Thc hié · Công ty C"}],"speech":[{"time":16.1,"text":"Em chọn cái hình pancake cho nó đẹp đẹp"},{"time":18.4,"text":"Mời các bạn nhỏ đến nhà em chơi với hai bạn nhỏ nhà em"},{"time":21.3,"text":"À như vậy thì chắc chắn phải làm bánh rồi ha"},{"time":24.4,"text":"Dạ"},{"time":24.9,"text":"Mà bánh thì chương trình mình có các loại bánh mặn nè"},{"time":28.1,"text":"Có bánh ngọt nè, làm với lại các loại hạt nữa"},{"time":31.8,"text":"Đủ thứ hết á"},{"time":32.8,"text":"Mà chưa có kết hợp với thanh long"},{"time":35.1,"text":"Hay là hôm nay mình làm thanh long đỏ đi"},{"time":37.2,"text":"Hết giải cứu thanh long rồi"},{"time":38.5,"text":"Mà mình làm pancake kết hợp với thanh long đỏ"},{"time":41.2,"text":"Chắc có lẽ là hot đây cô ơi"},{"time":42.7,"text":"Chắc chắn là hot"},{"time":43.6,"text":"Vậy mình vào bếp nha cô"},{"time":44.7,"text":"Đúng rồi, mình vô bếp"},{"time":45.7,"text":"Thêm niềm vui, thêm ngọt ngào với pancake thanh long đỏ"},{"time":70.4,"text":"Được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":74.3,"text":"Cô có một quả thanh long và cô sẽ cắt làm hai khoanh như thế này"},{"time":77.8,"text":"Và phần còn lại thì chúng ta sẽ cắt lấy khoảng chừng một muỗng canh thanh long như thế này"},{"time":83.3,"text":"Rồi phần dụng nữa thì mình sẽ tán qua cái rây"},{"time":87.5,"text":"Mình sẽ lấy khoảng chừng 100ml nước thanh long"},{"time":90.4,"text":"Các bạn lưu ý là phần thanh long chúng ta sẽ cắt nhỏ, tán qua đây lấy nước rất là dễ dàng"},{"time":95.8,"text":"Nho, bây giờ em sẽ cắt dọc làm đôi cho cô"},{"time":98.6,"text":"Dạ, nhiệm vụ này căng não quá cô Hà ơi"},{"time":101.4,"text":"Nhưng mà cô đếm rồi đó nha, 6 quả đó, phải còn đủ 6 quả cho cô"},{"time":105.4,"text":"Vậy là được 12 miếng phải không cô Hà"},{"time":107.5,"text":"Đúng rồi"},{"time":107.8,"text":"Tiếp theo thì chúng ta sẽ chuẩn bị tiếp phần whipping"},{"time":111.3,"text":"Sử dụng khoảng chừng 100ml whipping"},{"time":113.6,"text":"Và chúng ta sẽ giữ lạnh nó trước khi mình sẽ cho vào trong cái cối này và mình sẽ đánh lên"},{"time":118.9,"text":"Và khi đánh whipping thì chúng ta lưu ý là chúng ta chỉ đánh cho đến khi mà whipping vừa nổi đứng thôi"},{"time":124.8,"text":"Mình nên nhớ là mình sẽ đánh lúc mà whipping lạnh nha"},{"time":128.3,"text":"Chúng ta chỉ cần đánh bông vừa cũng sẽ thấy là nó có vân đứng vừa vừa như thế này được rồi"},{"time":133.1,"text":"Sau đó thì chúng ta sẽ cho cái phần whipping này vào trong một cái túi bát bông kem"},{"time":137.4,"text":"Chúng ta sẽ giữ trong tủ mát cho một bịch bột vào trong cái tô"},{"time":141.2,"text":"Quá là đơn giản luôn cô Hà ha"},{"time":143.6,"text":"Cho từ từ phần nước thanh long vào đây chúng ta trộn với bột"},{"time":148.0,"text":"Như vậy là bánh của mình sẽ có màu đẹp và thơm mùi thanh long đó cô Hà"},{"time":151.7,"text":"Đúng rồi, khoảng chừng 50-60ml nước vào trong này"},{"time":155.7,"text":"Mình trộn cho đến khi bột bột mịn đều và lỏng dừa ý chứ mình không có khuấy trộn quá nhiều"},{"time":162.1,"text":"Các bạn chúng ta có thể thêm nhiều loại trái cây để cho bánh tăng thêm hương vị, dinh dưỡng và màu sắc nữa"},{"time":167.8,"text":"Bây giờ thì cô sẽ đặt cái chảo lên trên bếp"},{"time":171.0,"text":"Chúng ta sẽ làm nóng cái chảo này"},{"time":173.0,"text":"Rồi bây giờ chảo nóng rồi chúng ta sẽ hạ nhiệt"},{"time":175.4,"text":"Bằng cách là đặt chảo qua một cái khăn ẩm"},{"time":178.3,"text":"Khoảng chừng 10 giây để hạ nhiệt chảo"},{"time":181.1,"text":"Rồi sau đó mình sẽ đặt chảo lại lên trên bếp"},{"time":183.5,"text":"Và chúng ta sẽ bắt đầu đổ bột vào"},{"time":188.4,"text":"Đẹp quá, uống hút của Hà ơi"},{"time":190.2,"text":"Bây giờ thì chúng ta sẽ lật cái bánh lại"},{"time":199.0,"text":"Rồi giờ cô lấy ra ha"},{"time":200.9,"text":"Dạ"},{"time":202.3,"text":"Rồi bây giờ mình sẽ đặt chảo lên"},{"time":204.1,"text":"Sau đó sẽ tiếp tục cho bột vô"},{"time":207.3,"text":"Rất là tròn và rất là đẹp luôn"},{"time":209.1,"text":"Rồi bây giờ thì cô sẽ lật"},{"time":211.3,"text":"Bánh lại"},{"time":215.2,"text":"Rồi dắt ra"},{"time":218.3,"text":"Và bây giờ cái bánh thứ tư"},{"time":220.1,"text":"Chín rồi nè"},{"time":221.2,"text":"Rồi cô lấy ra"},{"time":222.4,"text":"Và cứ như vậy thì chúng ta đổ cho đến khi hết bột"},{"time":225.5,"text":"Sau đó thì chúng ta sẽ trình bày"},{"time":230.2,"text":"Đầu tiên cô sẽ cho"},{"time":231.7,"text":"Cái bánh lên này"},{"time":232.8,"text":"Cái bánh thứ hai"},{"time":234.8,"text":"Rồi phần kem bây giờ mình sẽ bắt lên"},{"time":238.6,"text":"Tiếp theo"},{"time":239.4,"text":"Mình sẽ đặt 2 lát thanh long lên"},{"time":241.9,"text":"Tiếp theo sẽ là bánh"},{"time":246.0,"text":"Như vậy là mình sẽ dùng whipping cream"},{"time":249.3,"text":"Để có thể bắt thành 1 bông hoa lên trên cái bánh luôn hả cô?"},{"time":254.3,"text":"Cô sẽ đặt những cái nho lên trên này"},{"time":258.0,"text":"Thành cái bông hoa ha"},{"time":259.3,"text":"Hoa nho đó hả cô Hà?"},{"time":262.3,"text":"Bây giờ mình còn cho thêm thanh long, các hạt lụ lên nữa hả cô Hà?"},{"time":265.6,"text":"Đúng rồi, mình làm thành cái nhụy của cái bông hoa"},{"time":269.1,"text":"Rồi bây giờ đặt thêm một đọt húng lũi để cho nó thêm màu sắc cho đẹp"},{"time":273.8,"text":"Và như vậy là chúng ta đã hoàn thành xong món bánh rồi đó"},{"time":277.0,"text":"Chiếc bánh hình bông hoa rực rỡ xinh xắn"},{"time":279.8,"text":"Lớp kem béo thơm quyện cùng chút xốp mềm của bánh"},{"time":283.8,"text":"Thêm chút chua ngọt từ nho và thanh long"},{"time":286.6,"text":"Đặc biệt vô cùng"},{"time":288.0,"text":"Một món bánh ngọt ngào, một món quà độc đáo"},{"time":291.2,"text":"Còn chân chơi gì mà không thưởng thức ngay tại nhà các bạn nhé"},{"time":294.9,"text":"Cảm ơn các bạn đã theo dõi và hẹn gặp lại"}]}