e":181.0,"until":183.6,"text":"AJINOMOTO. · Aji-ngon · mdingày"},{"time":188.6,"until":190.8,"text":"Aji-ngon · AJINOMOTO. · mđingày"},{"time":191.0,"until":195.5,"text":"mingày"},{"time":200.4,"until":203.0,"text":"GON"},{"time":203.6,"until":206.0,"text":"Aji-ngon · AJINOMOTO. · mđingày"},{"time":206.4,"until":209.0,"text":"#NáuChuânǎnLành"},{"time":209.4,"until":212.4,"text":"Aji-ngon · #NauChuanAnLanh · AJINOMOTO · mđingày · móingáy"},{"time":220.4,"until":223.5,"text":"Aji-ngon · HAT NÊM HEO 1.5m · Hat ném"},{"time":223.8,"until":226.0,"text":"NG 2m"},{"time":226.2,"until":231.8,"text":"AJHNO-MOTO · BÔT NGOT 1m"},{"time":232.0,"until":233.0,"text":"AJINOMOTO. · mđingày"},{"time":238.0,"until":244.9,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC · AJINOMOTO. · Aji-ngon · MINOMOTO · máingày · móingay"},{"time":245.1,"until":246.9,"text":"mingày · MON"},{"time":251.7,"until":254.8,"text":"AJINOMOTO · Eat Well, Live Well. · mingày"},{"time":260.2,"until":263.0,"text":"móingay"},{"time":269.7,"until":273.4,"text":"TIM GAN · mingày · Eat Well, Live Well. · AJINOMOTO. · DÁY DÙ DINH DUÖNG · XÀO · DÀU CÔ-VE · BÜA ÃN · VÓI"},{"time":274.0,"until":275.5,"text":"Eat Well,Live Well · móingay · MON · AINOMOTOD · minus-ZERo COOUNG · MInUS-ZERO COOLING"},{"time":279.0,"until":287.5,"text":"Eat Well, Live Well. · mingày · AJINOMOTO."},{"time":302.3,"until":317.4,"text":"monngonmoingay.com · GON · Món Ngon Mōi Ngày · moingay · maingay · AJINOMOTO. · Ajungen"},{"time":319.0,"until":331.0,"text":"350g · 200g · 100g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Công ty HKFilm · NGUYÊN LIÊU · 1 nhánh · ·HAT NÊM HEO · Phi hp thc hin · ·TÔM · ·HÀNH LÁ · ·KHOAI Mì · ·BÔT NGOT · Bán quyěn kch bán và cău trúc · Thc hin chương trình · ·HÀNH TÍM BÄM · ·NGò RÍ · chuong trinh thuc · THÀNH PHÓ H CHÍMINH · DÀI TRUYÊN HINH · ·GIÒ SÖNG · Onlir · ·TÒM"}],"speech":[{"time":11.9,"text":"Canh khoai mì nấu tôm"},{"time":13.5,"text":"Dẻo mềm dai dai"},{"time":15.1,"text":"Thơm thanh quyển sánh"},{"time":39.6,"text":"Mình chào quý vị khán giả đã quay trở lại với chương trình"},{"time":41.8,"text":"Món ngon mỗi ngày nấu chuẩn ăn lành"},{"time":43.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":48.3,"text":"Và hôm nay Hoàng Long xin được phép"},{"time":50.2,"text":"Chia sẻ cùng các bạn và khán giả"},{"time":51.9,"text":"Một món ăn rất là đơn giản"},{"time":53.4,"text":"Nhưng rất là đặc biệt"},{"time":54.1,"text":"Đó là món canh khoai mì nấu tôm"},{"time":56.5,"text":"Đối với món canh khoai mì nấu tôm này"},{"time":58.4,"text":"Chúng ta sẽ có 2 nguyên liệu chính"},{"time":59.4,"text":"Đó là khoai mì và tôm"},{"time":60.6,"text":"Và sẽ kết hợp lại với nhau bằng giò sống"},{"time":64.7,"text":"Chúng ta chọn khoai mì bột tươi, mập, thẳng, vỏ mỡ màng để khoai mì không bị sượng vào sơ."},{"time":71.0,"text":"Đối với khoai mì thì Long đã sơ chế đầu tiên là mình gọt vỏ, mình ngâm với nước lạnh."},{"time":75.7,"text":"Chúng ta sẽ ngâm khoai mì vài giờ sau khi gọt vỏ để khoai mì không bị đắng."},{"time":79.5,"text":"Mình sẽ tán đều ra."},{"time":81.0,"text":"Và chúng ta phải vắt bỏ nước vàng của khoai mì để loại bỏ chất độc."},{"time":84.2,"text":"Đầu tiên Long cho vào đây là nửa muỗng cà phê hạt nêm Ajinon Hell."},{"time":87.5,"text":"Khoai mì là một loại tinh bột rất đặc biệt hay còn được gọi là tinh bột đề kháng."},{"time":92.4,"text":"Cung cấp một hệ vi sinh tốt cho đường ruột"},{"time":95.2,"text":"Tôm thì Long sẽ cho vào đây thêm một phần giò sống"},{"time":98.2,"text":"Tiếp tục Long cho vào đây là một muỗng cà phê hành tím băm"},{"time":100.7,"text":"Nửa muỗng cà phê hạt đêm Aji ngon heo"},{"time":104.1,"text":"Và một chút xíu tiêu"},{"time":105.4,"text":"Và chúng ta sẽ trộn đều"},{"time":107.0,"text":"Chúng ta có khoai mì kết hợp với tôm"},{"time":109.4,"text":"Tôm thì bên cạnh việc cung cấp protein cho cơ thể"},{"time":112.6,"text":"Thì có thể cung cấp cali"},{"time":114.4,"text":"Và cali khi kết hợp cùng với tinh bột đề kháng"},{"time":117.0,"text":"Thì sẽ cho một hệ tiêu hóa khỏe mạnh đó quý vị"},{"time":119.6,"text":"Trong khi chờ đợi thì Kim Thảo giúp Long là mình cắt cái hành ngò nha để lát mình nêm vào canh"},{"time":140.4,"text":"Bây giờ sẽ là cuộc thi vò viên"},{"time":142.1,"text":"Một bên vò khoai mì một bên vò tôm"},{"time":177.6,"text":"Mà đặc biệt là khi ở nhà mình có các bạn nhỏ"},{"time":179.8,"text":"Thì những cái công đoạn như thế này thì Kim Thảo nghĩ rằng là các bạn sẽ rất thích để làm"},{"time":184.4,"text":"Xong"},{"time":185.9,"text":"Vừa rồi Long với Thảo đã làm xong cái phần viên tôm và viên khoai mì"},{"time":189.9,"text":"Bây giờ mình sẽ chuẩn bị một cái nồi để mình tiến hành mình nấu canh"},{"time":192.8,"text":"Trong nồi nước này Long đã chuẩn bị là 1 lít 2 nước"},{"time":195.4,"text":"Và khi nước sôi trở lại chúng ta hãy cho khoai mì vào trước"},{"time":201.5,"text":"Vậy bây giờ là mình phải đợi hả? Khi nào mình mới cho tôm vào được?"},{"time":204.4,"text":"Khi nào mà Kim Thảo thấy là khoai mì trong lại và nổi lên trên mặt"},{"time":208.4,"text":"Thì là khoai mì chín thì mình sẽ cho tôm vào"},{"time":210.2,"text":"Tại vì tôm rất là mau chín"},{"time":211.2,"text":"Sau khi khoai mì trong trở lại thì Long sẽ cho phần tôm viên vào"},{"time":215.5,"text":"Mình cho lần lượt nhẹ nhẹ vào để viên nó tròn nha"},{"time":220.1,"text":"Lâm cho vào nồi canh 1 muỗng rưỡi cà phê hạt nêm Ajinomoto"},{"time":222.8,"text":"2 muỗng cà phê đường"},{"time":225.9,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":229.5,"text":"Và kế đến chúng ta sẽ nấu nhỏ lửa trong vòng 5 phút"},{"time":231.6,"text":"Những viên tôm đã nổi lên rồi"},{"time":233.4,"text":"Điều đó có nghĩa là canh của mình đã chín"},{"time":234.8,"text":"Chính xác"},{"time":235.5,"text":"Tắt bếp thôi"},{"time":236.6,"text":"Quý vị và các bạn thân mến"},{"time":238.3,"text":"Rất đơn giản để có thể xem lại công thức trọn vẹn của chương trình ngày hôm nay"},{"time":241.7,"text":"Chỉ cần là quét mã QR trên màn hình của chúng tôi nha"},{"time":247.1,"text":"Rồi mọi thứ đã chuẩn bị xong"},{"time":248.6,"text":"Bây giờ mình sẽ múc ra tô"},{"time":257.3,"text":"Kế đến là mình nêm một ít hành và ngò"},{"time":259.7,"text":"Và cuối cùng chúng ta sẽ đặt lên đây một cái lá ngò"},{"time":265.4,"text":"Vừa rồi Đông đã hoàn thành xong món canh khoai mì nấu tôm"},{"time":268.3,"text":"Và để tạo nên một bữa ăn hoàn chỉnh"},{"time":269.9,"text":"Thì mình nên ăn kèm với món đậu cô ve xào tim gan"},{"time":273.7,"text":"Nghe là đã thấy một bữa ăn đầy đủ dinh dưỡng rồi đúng không ạ"},{"time":277.0,"text":"Rất là tuyệt vời luôn"},{"time":278.2,"text":"Cảm ơn đầu bếp Hoàng Long ngày hôm nay rất là nhiều"},{"time":280.2,"text":"Kim Thảo đang rất là nóng lòng"},{"time":281.9,"text":"Không biết là canh khoai mì nấu tôm có đủ ngon như thế nào"},{"time":284.9,"text":"Và hấp dẫn như thế nào"},{"time":286.1,"text":"Quý vị có giống như Kim Thảo không ạ"},{"time":288.9,"text":"Nước canh trong có độ sánh nhẹ, vị ngọt thanh"},{"time":292.5,"text":"Cùng với viên khoai mì dẻo mềm và viên tôm dai thơm"},{"time":295.9,"text":"Rất ấm áp trong những ngày trời xe lạnh"},{"time":298.6,"text":"Canh khoai mì nấu tôm mới lạ rất đáng thử"},{"time":304.6,"text":"Các bạn hãy làm ngay cho những người thân yêu của mình thưởng thức nhé"},{"time":307.7,"text":"Và để xem lại chương trình ngày hôm nay"},{"time":309.7,"text":"Cùng với rất nhiều những món ăn gợi ý, sáng tạo và hấp dẫn khác"},{"time":313.4,"text":"Chỉ cần truy cập vào Youtube, Website, Fanpage của chương trình Món Ngon Mỗi Ngày"}]}