l":255.7,"text":"AJINOMOTO · QUÉT MÃ QR DÊ XEM CÔNG THÚC · moingày"},{"time":255.9,"until":257.7,"text":"mingày · MON"},{"time":260.5,"until":263.2,"text":"nline"},{"time":270.1,"until":277.0,"text":"SALAD CUA · mingày · Eat Well, Live Well. · AJINOMOTO. · DÁY DÙ DINH DUÕNG · BÜA ÃN · VÓI · OnIM · MiÝ"},{"time":277.2,"until":278.0,"text":"mlnge · nSingay"},{"time":278.3,"until":280.8,"text":"mingày · AJINOMOTO · Eat Well, Live Well. · Onl · OnIM · NOON"},{"time":293.3,"until":297.6,"text":"AJINOMOTO · mingày · moingay · Eat Well. Live Well · Eat Well. Live · ngay · máing · maingày · gày · man"},{"time":297.8,"until":307.4,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · mingay · AJINOMOTO"},{"time":308.2,"until":319.3,"text":"100g · 1.5M · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · NGUYÊN LIÊU · ·KHOAI LANG · ·MÈ TRÁNG RANG · Phi hp thc hin · ·KHOAI TÂY · ·KHOAI Mì · · XÖT MAYONNAISE VI NGUYÊN BÀN · chuơng trình thuc · ·SÜA CHUA KHÔNG DUÖNG 1m · ·BÔT ÓT PAPRIKA · Thc hin chương trình · ·SÜADÄC · Onl · ·LÁ QUÊ · · BOT TÁM KHO CHIÊN GIÒN · THÀNH PHÓ HO CHÍMINH · Thc hin chưo · DÀI TRUYÊN HìNH · G 1m"}],"speech":[{"time":11.8,"text":"Khoai chiên lắc mayo mè"},{"time":13.4,"text":"Giòn thơm ngọt bùi"},{"time":15.0,"text":"Cuốn quá thôi"},{"time":38.5,"text":"Rất vui khi được gặp lại các bạn khán giả"},{"time":40.5,"text":"Đang theo dõi chương trình Món ngon mỗi ngày"},{"time":42.7,"text":"Náo chuẩn ăn lành"},{"time":44.2,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":48.1,"text":"Anh Quốc Nghị ơi"},{"time":49.1,"text":"Hôm nay em nghe nói sẽ là một món ăn chơi"},{"time":51.6,"text":"Rất là vui miệng"},{"time":52.8,"text":"Không biết đó là món gì ạ"},{"time":54.2,"text":"Hôm nay trong bấy món ngon Quốc Nghị sẽ hướng dẫn các bạn khán giả"},{"time":57.2,"text":"Cùng Minh Phương thực hiện một món vừa ngon"},{"time":59.8,"text":"Vừa nhanh"},{"time":60.8,"text":"Vừa ăn vui vui"},{"time":62.3,"text":"nhưng mà rất dinh dưỡng nha"},{"time":63.5,"text":"Món ăn có tên gọi là"},{"time":64.5,"text":"Khoai chiên lắc mayo mè"},{"time":66.8,"text":"Sẵn sàng chứ nào"},{"time":67.8,"text":"Và biết thôi"},{"time":69.4,"text":"Để làm món này"},{"time":70.3,"text":"chúng ta cần 3 loại khoai nha"},{"time":72.0,"text":"Khoai tài"},{"time":72.6,"text":"Cắt lát 1cm trước nè"},{"time":75.0,"text":"Sau đó Minh Phương sẽ cắt từng thanh ra"},{"time":81.5,"text":"Khoai mì"},{"time":82.2,"text":"mình sẽ cắt thanh nè"},{"time":85.6,"text":"Để lát chiên cho nó đồng đều ạ"},{"time":87.6,"text":"Đúng rồi"},{"time":88.5,"text":"Khoai lang nè"},{"time":89.3,"text":"mình cũng sẽ cắt thanh nè"},{"time":90.7,"text":"Có thể thấy đối với các loại khoai"},{"time":92.5,"text":"thì rất là nhiều chất dinh dưỡng"},{"time":94.0,"text":"hàm lượng tinh bột tốt nè"},{"time":96.2,"text":"Protein hay là chất sơ"},{"time":97.7,"text":"Cho nên Minh Phương thấy những ai đang luyện tập thể thao như anh Quốc Nghị"},{"time":101.0,"text":"Thì rất là thích"},{"time":102.4,"text":"Cắt 3 loại khoi xong"},{"time":103.8,"text":"Chúng ta sẽ cho vào tô nè"},{"time":105.3,"text":"Chúng ta sẽ cho vào khoi nửa gói gia vị nem sẵn"},{"time":107.7,"text":"Ajiwit bột tẩm khô chiên giòn nha"},{"time":109.5,"text":"Việc tẩm khoi qua gia vị nem sẵn"},{"time":111.5,"text":"Ajiwit bột tẩm khô chiên giòn"},{"time":113.2,"text":"Giúp cho khoi có độ giòn và sốt"},{"time":115.2,"text":"Dạ rồi"},{"time":116.1,"text":"Tiếp đến thì mình làm gì hả anh Quốc Nghị"},{"time":118.2,"text":"Tiếp theo Quốc Nghị sẽ hướng dẫn các bạn cùng Minh Phương"},{"time":120.7,"text":"Chúng ta pha cái sốt mayo mè"},{"time":122.9,"text":"Để chấm cùng với lại kho chiên nha"},{"time":124.8,"text":"Cho vào đây 3 muỗng canh sốt mayonnaise"},{"time":126.8,"text":"Aji mayo vị nguyên bản nha"},{"time":131.2,"text":"Tiếp tục là 1 muỗng cà phê sữa chua"},{"time":133.1,"text":"Không đường"},{"time":133.6,"text":"1 muỗng cà phê sữa đặc"},{"time":136.0,"text":"1 muỗng cà phê mè rang giả nhuyễn"},{"time":138.4,"text":"Giao công việc cao cả này cho Minh Phương"},{"time":140.1,"text":"Khói đều sốt lên"},{"time":140.9,"text":"Dạ rồi"},{"time":145.0,"text":"Thơm quá"},{"time":145.7,"text":"Cái nền tảng hương vị của sốt mayonnaise"},{"time":148.1,"text":"Aji mayo vị nguyên bản là nó sẽ béo béo nhẹ nhẹ"},{"time":151.1,"text":"Thơm thơm ngọt ngọt"},{"time":152.9,"text":"Chua chua"},{"time":153.7,"text":"Nó rất là thích hợp với các món chiên luôn đó"},{"time":156.4,"text":"Trong thời gian chờ dầu ăn đủ nhiệt độ để chiên khoi thì Quốc Nghị sẽ hướng dẫn các bạn pha cái bột để chúng ta lắc với khoi nha"},{"time":163.1,"text":"Đầu tiên chúng ta sẽ cho vào đây 1 phần 3 muỗng cà phê muối, 1 muỗng cà phê ớt bột Barica, 1 phần 3 muỗng cà phê đường, 1 phần 3 muỗng cà phê tiêu say, 1 muỗng canh mề rang dạ nhuyễn chúng ta sẽ trộn đều nè"},{"time":175.4,"text":"Trước khi chiên khoi thì Quốc Nghị có 1 cái bí quyết nhỏ giúp cho dầu ăn nó thơm hơn đó là chúng ta sẽ chiên lá quế trước, chiên đến khi nó trong nó giòn là chúng ta vớt ra"},{"time":183.9,"text":"Chiên cái phần lá quế này để lát nữa"},{"time":186.6,"text":"Mình sẽ lắc chung với khoai luôn hả Quốc Nghị"},{"time":188.2,"text":"Chính xác, lá quế bắt đầu nó trong và nó giòn á"},{"time":190.5,"text":"Thì chúng ta vớt ra"},{"time":191.5,"text":"Mình sẽ cho khoai giá thấm dào nè"},{"time":195.7,"text":"Rồi, tiếp tục cho khoai vào chiên"},{"time":198.1,"text":"Lửa lớn nha"},{"time":199.7,"text":"Chiên cho khoai bắt đầu nó giòn"},{"time":201.5,"text":"Thì nó sẽ nổi lên trên mặt dầu ăn"},{"time":203.4,"text":"Khoai cũng đã vàng giòn"},{"time":204.9,"text":"Thì bây giờ Quốc Nghị sẽ vớt nó ra"},{"time":206.7,"text":"Minh Phương giúp Quốc Nghị tắt lửa nha"},{"time":208.1,"text":"Cho khoai giá thấm dào nè"},{"time":210.2,"text":"Thông thường các món mà khoai chiên á"},{"time":211.9,"text":"Thì Minh Phương thấy là khoai tây hay là khoai lang thì rất là quen thuộc"},{"time":214.3,"text":"Nhưng mà ngày hôm nay thì có khoai mì nữa"},{"time":216.5,"text":"Khoai mì thì anh nghĩ biết không"},{"time":218.2,"text":"Có rất là nhiều vitamin A"},{"time":219.5,"text":"Và vitamin A sẽ giúp cho cơ thể của chúng ta"},{"time":222.2,"text":"Xây dựng một cái hàng rào bảo vệ chắc chắn"},{"time":225.3,"text":"Và ngăn chặn sự xâm nhập của vi khuẩn từ bên ngoài"},{"time":227.9,"text":"Để lắc khoai thì chúng ta cần một cái tô thị tinh"},{"time":230.9,"text":"Cho khoai chiên vào"},{"time":233.5,"text":"Tiếp đến các bạn sẽ cho hết cái hỗn hợp bột lắc vào"},{"time":236.2,"text":"Một cái đĩa ấp lên tô này"},{"time":240.2,"text":"Lắc"},{"time":241.4,"text":"Nghe cái âm thanh không?"},{"time":242.9,"text":"Giòn tan"},{"time":245.8,"text":"Chúng ta lắc khoai qua hỗn hợp bột lắc"},{"time":247.8,"text":"Giúp tăng hương vị cho khoai"},{"time":249.2,"text":"Đừng quên mã QR của công thức món ngày hôm nay"},{"time":251.8,"text":"Đang hiển thị trên màn hình"},{"time":253.0,"text":"Quý khán giả có thể quẹt mã để lưu về công thức này nha"},{"time":257.6,"text":"Bây giờ quý khán giả sẽ cho ra đĩa"},{"time":259.6,"text":"Và thưởng thức"},{"time":263.2,"text":"Lá quế chiên giòn"},{"time":264.5,"text":"Cuối cùng một ít mè rang giả bỉa nữa"},{"time":267.1,"text":"Lên trên món ăn"},{"time":269.5,"text":"Món này các bạn ăn kèm với lại salad cua mì ý"},{"time":272.4,"text":"Là hết sải luôn đó nha"},{"time":274.2,"text":"Một món ăn chơi rất là thú vị"},{"time":276.1,"text":"Mà đảm bảo đầy đủ chất dinh dưỡng"},{"time":278.0,"text":"Và chúc quý vị khán giả sẽ ngon miệng với món ăn ngày hôm nay"},{"time":281.6,"text":"Các loài khoai được áo một lớp bột vang giòn, thoang thoảng, mùi lá quấy độc đáo"},{"time":286.1,"text":"Hòa quyện cùng sốt mayonnaise sánh quyện, béo thơm, thật lạ miệng"},{"time":293.0,"text":"Khoai chiên lắc mayonnaise rất tích hợp để đổi vị cho gia đình và bạn bè"},{"time":297.6,"text":"Và hãy cùng chúng tôi khám phá nhiều công thức món ăn ngon bằng cách truy cập vào kênh, youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":304.7,"text":"Xin chào và hẹn gặp lại"}]}