no"},{"time":305.8,"until":313.0,"text":"monngonmoingay.com · AJINOMOTO · Món Ngon Mōi Ngày · moingay · MON · Eat Wel, Live Wes · BOWHIENGION · Eat Weil, Live wet · AeQuich · BOTCHIENICION · BOTERIENICIÓN · BORGHIENICIÓN"},{"time":316.6,"until":326.6,"text":"200g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · NGUYÊN LIÊU · ·MÈ DEN · ·MÈ TRÁNG · · BÔT CHIÊN GIÒN · ·CÁ KÈO · Phi hp thc hin · Thc hin chương trình · chuơng trình thuc · · TÒI, ÔT, SÀ BÄM · ·BOT NÄNG PHA LOÃNG 1M · ·DUÖNG THÓT NÓT · THÀNH PHÓ HO CHÍMINH · DÀI TRUYÊN HìNH · Onl · ·NUÓC CÕT ME"}],"speech":[{"time":12.2,"text":"Dòng thơm đậm đà, chua ngọt xuyết xoa với cá kèo chiên mè"},{"time":41.1,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":43.6,"text":"Cá kèo là một loài cá sống trong vùng nước giàu phù sa"},{"time":48.1,"text":"Cho nên là giàu dinh dưỡng và bên cạnh đó còn ăn rất là ngon nữa"},{"time":52.4,"text":"Thành ra Kim Thảo nghĩ rằng là khi chế biến cá kèo thì làm món gì cũng ngon luôn"},{"time":56.9,"text":"Chính xác đó Kim Thảo"},{"time":58.1,"text":"Cá kèo thì nó rất là thơm ngon và ngọt"},{"time":61.2,"text":"Hôm nay quý vị sẽ thử làm món cá kèo chiên mè"},{"time":64.2,"text":"Để xem vị nó như thế nào các bạn nha"},{"time":66.9,"text":"Chúng ta nên chọn những con cá kèo nó đều con với nhau"},{"time":69.8,"text":"Xương mềm có thể ăn được"},{"time":72.2,"text":"Mình sẽ cảm nhận được cái vị béo bùi"},{"time":74.3,"text":"Và khi muốn ăn trình bài ra nó sẽ đồng đều và đẹp hơn đó các bạn"},{"time":77.5,"text":"Thịt cớ kèo thì chúng ta sẽ cắt phần đuôi, phần đầu"},{"time":80.9,"text":"Rửa một ít nước muối cho nó sạch"},{"time":82.7,"text":"Rồi bây giờ chúng ta sẽ ướp với 2 muỗng canh"},{"time":86.1,"text":"Gia vị nem sẵn, aji huyết, bột chiên giòn"},{"time":88.5,"text":"Sau đó trộn đều"},{"time":90.1,"text":"Gia vị nem sẵn, aji huyết, bột chiên giòn này đã có hương vị rồi"},{"time":93.8,"text":"Nên chúng ta sẽ không cần ướp bất kỳ gia vị gì vào nữa"},{"time":97.3,"text":"Rất là tiện ích luôn"},{"time":98.4,"text":"Quốc nghệ sẽ hướng dẫn các bạn chúng ta sẽ pha bột lỏng để chiên cá kèo"},{"time":102.3,"text":"Chúng ta dùng gia vị nem sẵn, aji huyết, bột chiên giòn"},{"time":105.6,"text":"Tiếp đó các bạn sẽ cho vào đây 75ml nước lọc"},{"time":109.5,"text":"Cái bột này chúng ta sẽ nhúng cá để chiên"},{"time":111.9,"text":"Quốc nghệ sử dụng mè trắng và mè đen"},{"time":115.3,"text":"Trong món ăn này Quốc Nghị đã sử dụng 2 loại mè thưa quý vị"},{"time":118.6,"text":"Đó là mè trắng và mè đen"},{"time":120.1,"text":"Mè đen nó có vị hơi đắng"},{"time":121.6,"text":"Cho nên là khi chúng ta kết hợp với mè trắng có vị ngọt"},{"time":124.2,"text":"Thì nó sẽ rất thú vị cho món ăn"},{"time":125.9,"text":"Đồng thời là trong mè có chất kháng khuẩn"},{"time":128.3,"text":"Và rất là tốt cho tim và thận"},{"time":130.6,"text":"Bây giờ Quốc Nghị sẽ pha hỗn hợp nước mắm mè trước"},{"time":133.3,"text":"Các bạn sẽ cho vào đây 2 muỗng canh nước cốt mè"},{"time":136.6,"text":"Tiếp đấy là 1 muỗng canh nước lọc"},{"time":138.4,"text":"Chúng ta sẽ cho mè và nước lọc vào hòa tan"},{"time":141.5,"text":"Sau đó cho vào lọc vi sóng"},{"time":142.8,"text":"Quay 2 phút thò các bạn sẽ lái được nước cốc me rất là dễ dàng luôn"},{"time":146.7,"text":"1 muỗng canh nước mắm"},{"time":147.9,"text":"Và cuối cùng là 2 muỗng canh đường thốt nốt"},{"time":150.7,"text":"Khói đều cho nó tan hết cái gia vị vào nhau"},{"time":153.1,"text":"Rất là thơm mắm"},{"time":154.9,"text":"Thơm ơi là thơm luôn"},{"time":156.0,"text":"Bây giờ chúng ta sẽ sử dụng chảo"},{"time":158.0,"text":"Các bạn cho vào đây 1 ít dầu ăn"},{"time":159.8,"text":"1 muỗng cà phê sả băm"},{"time":161.9,"text":"1 muỗng cà phê tỏi băm"},{"time":163.4,"text":"Và 1 muỗng cà phê ớt sừng băm"},{"time":165.7,"text":"Rồi bây giờ chúng ta sẽ xào cho nó thơm"},{"time":168.1,"text":"Cái mùi sả, tỏi và ớt sừng"},{"time":169.9,"text":"Sau khi các bạn cảm nhận được cái mùi thơm rồi á"},{"time":172.1,"text":"Thì chúng ta sẽ cho hết cái phần"},{"time":174.8,"text":"Sốt mắm me mà chúng ta đã pha"},{"time":176.3,"text":"Như vậy là đã xong"},{"time":177.7,"text":"Bây giờ Quốc Nghị sẽ tắt lửa"},{"time":180.2,"text":"Và sẽ cho nó ra chén để cho nó nguồi"},{"time":182.1,"text":"Bây giờ chúng ta sẽ qua công đoạn cuối cùng"},{"time":184.1,"text":"Đó là chiên cá"},{"time":185.5,"text":"Nhúng cá vào bột loãn và chiên"},{"time":187.4,"text":"Bây giờ chúng ta sẽ cho vào cái bột loãn này"},{"time":189.7,"text":"Cho nó áo đều luôn nha Kim Thảo"},{"time":191.9,"text":"Rồi đó chúng ta sẽ đặt vào từ từ"},{"time":193.7,"text":"Thẳng con cá ra nha"},{"time":195.2,"text":"Và các bạn lưu ý nha, nhiệt độ vào vừa phải thôi"},{"time":199.3,"text":"Món này các bé nhà mình sẽ rất là thích luôn"},{"time":203.3,"text":"Bây giờ phần còn lại"},{"time":204.8,"text":"Do cho Kim Thảo"},{"time":205.7,"text":"Đầu bếp chính của chương trình"},{"time":207.6,"text":"Các bạn phải trở đều liên tục"},{"time":209.2,"text":"Để cho cái lớp bột ngoài nó vàng giòn"},{"time":211.8,"text":"Mà nó không có bị sẩm vào"},{"time":214.0,"text":"Biết quyết của đầu bếp quốc nghị rất là hay đúng không ạ"},{"time":216.4,"text":"Bởi vì khi chúng ta sử dụng 2 lần bột như thế này"},{"time":218.9,"text":"Thì lần bột mà khô"},{"time":220.6,"text":"Thì áo đều quanh cá kèo"},{"time":222.4,"text":"Giúp cho cá kèo đầu tiên là thấm vị"},{"time":223.9,"text":"Thứ 2 là sẽ có thể"},{"time":225.8,"text":"Bám chắc được với cái lớp bột ướt"},{"time":228.1,"text":"Mà khi chúng ta thấm cá kèo vào trước khi chiên đúng không ạ"},{"time":231.1,"text":"Cái lớp bột ngoài của cá kèo nó vàng, giòn và đều như thế này"},{"time":235.0,"text":"Thì các bạn sẽ ráp ra và đặt ra giá thấm vào cho nó thật ráo vào"},{"time":238.7,"text":"Bây giờ chúng ta sẽ trang trí trình bày và thưởng thức các bạn nha"},{"time":243.1,"text":"Món ăn của ngày hôm nay rất đơn giản đúng không ạ"},{"time":245.4,"text":"Chúng ta chỉ cần quét mã QR trên màn hình để lưu lại công thức của món ăn nhanh gọn lẹ này nha"},{"time":250.7,"text":"Và công đoạn mà quý vị chắc chắn rằng Kim Thảo và các bạn chờ đợi nhất"},{"time":259.7,"text":"Bữa ngày chuẩn bị một cái đĩa nè, một chén sốt me"},{"time":262.2,"text":"Bây giờ chúng ta sẽ đập những con cá kèo chiên ra đĩa"},{"time":268.9,"text":"Bữa ngày cố tình cắt đôi một con"},{"time":271.0,"text":"Để các bạn cảm nhận được cái thịt cá kèo ở trong nè"},{"time":274.2,"text":"Thấy không? Ăn luôn được xương luôn đó"},{"time":275.7,"text":"Và bữa ngày đề xuất các bạn nên nấu thêm món cồi sò điệp xào hoa thiên lý"},{"time":281.4,"text":"Để ăn cái món cá kèo chiên mè này nữa thì thơm ngon tròn vị cho bữa ăn các bạn luôn"},{"time":286.9,"text":"Bọc bên ngoài là lớp bột giòn tan, lắm tấm mè đen bùi bùi nịnh miệng"},{"time":291.4,"text":"Thịt cá bên trong ngọt, tươi, chấm mắm me chua cay là chuẩn cá kèo đệ nhất món"},{"time":300.1,"text":"Cá kèo là một món quà quý của sông nước miền Tây"},{"time":302.8,"text":"Làm món ăn gì cũng đi vào lòng người"},{"time":304.8,"text":"Và để xem lại món ăn của ngày hôm nay cùng với nhiều món ăn hấp dẫn khác nữa"},{"time":309.5,"text":"Thì quý vị và các bạn có thể truy cập vào Youtube website fanpage của chương trình Món Ngon Mỗi Ngày"}]}