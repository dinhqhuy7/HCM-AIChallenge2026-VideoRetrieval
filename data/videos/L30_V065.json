"},{"time":18.6,"until":22.8,"text":"Herbalife · Thanh âm đi ngàn · Cuc thi Lan ta năng lung tích cc 2024: · tucitrery"},{"time":27.8,"until":29.8,"text":"tuóitréV"},{"time":48.3,"until":50.4,"text":"tuoitne"},{"time":50.8,"until":52.4,"text":"tuöitréV"},{"time":57.2,"until":68.0,"text":"tusltrerv · tublthery · tubitreTV"},{"time":68.3,"until":69.3,"text":"tuöitrery · tuöitrerv · tubitreTV · tuöitréV"},{"time":77.0,"until":82.9,"text":"tuoitrey"},{"time":100.1,"until":102.8,"text":"Tác gi: Nguyn Đc · Herbalife"},{"time":103.0,"until":105.2,"text":"Tác gi: Nguyn Đc · Herbalife"},{"time":105.4,"until":107.5,"text":"Herbalife · Tác gi: Nguyn Đc"}],"speech":[{"time":13.4,"text":"Đều đặn mỗi tuần một ngày, hơn 30 em học sinh đồng bào AD ở xã E-Bohok, huyện Chư Quyên, tỉnh Đắk Lắc"},{"time":20.9,"text":"được sống trong không gian tràn ngập âm nhạc dân dân truyền thống của dân tộc mình."},{"time":25.9,"text":"Hôm nay, nghệ sĩ Nguyễn Trường dạy các em đánh bộ chiên đinh Arab Mo'o, nghĩa là bộ chiên làm bằng tre."},{"time":35.2,"text":"Hàng chục nhạc cụ khác nhau, tất cả đều được chế tác từ tre nứa."},{"time":39.5,"text":"Có những nhạc cụ là sự kết hợp hài hòa giữa truyền thống và hiện đại"},{"time":43.8,"text":"Từ sự sáng tạo của nghệ sĩ, đến với lớp học"},{"time":47.3,"text":"Các em không chỉ được truyền dạy sử dụng các loại nhạc cụ"},{"time":50.9,"text":"Mà còn được hướng dẫn chế tác một số loại nhạc cụ bằng tre nứa"},{"time":57.0,"text":"Con đã biết chế tác được nhạc cụ Đinh Pân, Đinh Gatut"},{"time":61.1,"text":"Đinh Pân là nó xài cái dùi để gọt trên đầu"},{"time":67.3,"text":"Còn Đinh Gatut là nó rộng xuống đất"},{"time":69.1,"text":"Từ cơ hỗ trợ của công cụ kỹ thuật nó rất là mạnh, ví dụ như chúng ta chỉ cần sử dụng một cái smart phone thông minh nó tải được những phân mê miễn phí về và có thể đo được tân sổ hay là cáo đồ của các nỗ rất là chính xác, dừa vào đó học sinh sẽ vẫn dùng được, nó dễ dàng hơn."},{"time":83.0,"text":"Các em trở thành một cái nhóm chơi và có những cái bàn diện với nhau rất dễ thương và từ đó các em được kích hoạt cái niềm đam mê âm nhạc của mình ngày càng lớn hơn để duyên dự nó."},{"time":98.7,"text":"Thông qua lớp học, các em hiểu thêm nhiều lét đẹp văn hóa truyền thống của dân tộc mình."}]}