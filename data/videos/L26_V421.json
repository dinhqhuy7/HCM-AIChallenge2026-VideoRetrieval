"text":"À, biết ngay mà"},{"time":32.0,"text":"Tại vì ngày mai là rằm rồi"},{"time":33.4,"text":"Mà em lại thèm ăn một cái món gì đó"},{"time":35.5,"text":"Món chay nha"},{"time":36.4,"text":"Đơn giản nhưng mà lạ miệng"},{"time":38.1,"text":"Anh vỗ chị em chứ"},{"time":38.9,"text":"Trời ơi, tưởng rằm rủ tui đi chùa chứ"},{"time":41.0,"text":"Ê nhè, kêu tui nấu ăn nữa"},{"time":42.3,"text":"Anh có một món này kho vào rằm kho truyền thống luôn"},{"time":46.3,"text":"Nhờ uống cái miếng chào của em tự nhiên nó sáng ra luôn"},{"time":49.1,"text":"Vậy bây giờ mình vô bếp liền luôn ha"},{"time":50.6,"text":"Đúng vậy"},{"time":53.3,"text":"Nấm kho tổ, vị đậm đà, thiệt là đưa cơm"},{"time":75.2,"text":"Được tài trợ bởi công ty Aizino Moto Việt Nam"},{"time":79.3,"text":"Hôm nay nè, các bạn xem"},{"time":81.6,"text":"Chúng ta có thể sử dụng các loại nấm mà có cái độ cứng, giòn giòn, sụt sụt để chúng ta kho"},{"time":86.4,"text":"Thì rất là thích hợp với món ăn này"},{"time":88.1,"text":"Rồi bây giờ chúng ta sẽ xử lý tiếp ha"},{"time":90.6,"text":"Đầu tiên thì mình xử lý cái nấm đùa gà trước đi"},{"time":93.9,"text":"Cắt đôi theo chiều dọc, cắt xéo lại, cắt dày thế xíu như vậy"},{"time":98.0,"text":"Có bề bản khoảng chừng 2cm và chiều dài cỡ 3cm như vậy là vừa"},{"time":102.8,"text":"Nhớ nấm chúng ta rửa nhanh với dòi nước lạnh thôi nha các bạn nha"},{"time":106.5,"text":"Còn nấm đông cô thì chúng ta nhâm mềm cắt đôi thôi các bạn"},{"time":109.2,"text":"Để khi kho thì nước kho nó thấm vào trong nấm nó sẽ ngon hơn"},{"time":113.6,"text":"Rồi cà rốt thì chúng ta tỉa bông nha các bạn"},{"time":115.8,"text":"Cắt lắc dày"},{"time":117.8,"text":"Còn nấm đông cô tươi chúng ta cắt đôi luôn"},{"time":122.6,"text":"Rồi tiêu xanh chúng ta"},{"time":125.3,"text":"Đập dập như vậy"},{"time":126.3,"text":"Rồi chúng ta cho vào trong chén"},{"time":128.0,"text":"Hành bổ rô, thân và lá chúng ta cắt để riêng ha"},{"time":132.5,"text":"Đây đây, lá chúng ta phi cho thơm"},{"time":134.5,"text":"Phần lá chúng ta cắt, chúng ta cho vào sau cùng"},{"time":138.7,"text":"Rồi, bắt lên một cái tổ"},{"time":140.1,"text":"Chúng ta cho ở đây một ít dầu"},{"time":141.7,"text":"Cho phần thân hành bổ rô vô trước, xào cho thơm ha"},{"time":145.0,"text":"Nó có cái mùi rất là đặc trưng đúng không anh?"},{"time":146.7,"text":"Đúng rồi, cái phần thân của cái hành bổ rô thì là có cái mùi thơm hơn, mùi nồng hơn ha"},{"time":151.3,"text":"Khi cho vàng lên, tiểu xanh 3 nhánh như vầy, đập dập, cho vào xào luôn"},{"time":155.5,"text":"Rồi còn phần nấm với lại cà rốt thì mình sẽ cho từng lần lượt hay là mình bỏ vô luôn một lần?"},{"time":160.8,"text":"Nấm đông cô trước, tại nấm cô nó dai đó, mình xào cho nó thơm trước ha, nấm cô khô trước"},{"time":167.8,"text":"Rồi kế tiếp chúng ta sẽ cho cà rốt vào xào nha, Dũng Hà thấy bắt đầu nó dày cái mùi thơm của tiêu ha"},{"time":173.2,"text":"Rồi cuối cùng thì chúng ta cho các loại nấm vào, chúng ta xào qua tí xíu cho thơm ha"},{"time":178.8,"text":"Rồi chúng ta đảo lên như vầy, chúng ta xào tí xíu"},{"time":183.0,"text":"Bây giờ chúng ta sẽ cho gia vị vào nha các bạn"},{"time":185.8,"text":"Cho 3 muỗng canh nước tương phú sỉ vào đây"},{"time":188.1,"text":"À 3 muỗng canh nước tương phú sỉ vào ha"},{"time":190.6,"text":"Công nhận đúng là những món kho chay á"},{"time":192.4,"text":"Mà có nước tương vô đúng là làm hương vị của nó càng thêm đậm đà nữa"},{"time":196.2,"text":"Đúng rồi"},{"time":196.7,"text":"Chúng ta cho vào đây nửa muỗng canh đường"},{"time":198.8,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":201.0,"text":"2 muỗng cà phê hạt nêm nấm"},{"time":203.9,"text":"À chúng ta cho vừa xâm xấp nước thôi các bạn nha"},{"time":206.7,"text":"Thưa các bạn chúng ta có thể thay nước lọc bằng nước dừa"},{"time":209.2,"text":"Để món ăn chúng ta được ngọt và ngon hơn nha các bạn"},{"time":211.7,"text":"Cái miếng cà rốt chúng ta vừa chín tới nè"},{"time":213.6,"text":"Thấm cái lại cái nước kho nâu nâu rất là bắt mắt"},{"time":217.2,"text":"Vừa chín rồi đó"},{"time":217.8,"text":"Nếu chúng ta kho nữa thì nó bị nhủm"},{"time":219.6,"text":"Nó không có ngon"},{"time":220.7,"text":"Thưa các bạn một điều lý nhỏ nhỏ đó các bạn"},{"time":222.6,"text":"Chúng ta chỉ nên kho nấm với lửa vừa"},{"time":224.6,"text":"Để cho nấm thấm gia vị"},{"time":226.3,"text":"Nhưng vẫn giữ được độ giòn nha các bạn"},{"time":228.1,"text":"Cho vào đây khoảng 1 muỗng cà phê"},{"time":230.3,"text":"Dầu điều là được nha các bạn"},{"time":231.9,"text":"Thưa các bạn để cho món kho chúng ta được đẹp mắt"},{"time":233.8,"text":"Chúng ta chỉ cần cho vào đây 1 ít dầu điều là được"},{"time":235.8,"text":"Rồi bây giờ chúng ta sẽ tắt lửa thôi"},{"time":238.3,"text":"Thấy nước kho chúng ta đã sánh sệt nè"},{"time":240.3,"text":"Cho lá hành bổ rô vào các bạn"},{"time":242.9,"text":"À mình bỏ vô sau cùng hả anh?"},{"time":244.5,"text":"Đúng rồi bỏ vô sau cùng"},{"time":247.8,"text":"Chúng ta cho ra một cái"},{"time":250.2,"text":"Dĩa sâu lòng"},{"time":251.3,"text":"Chúng ta bày cho bung cao lên cho đẹp mắt nha các bạn"},{"time":254.0,"text":"Rồi sau cùng chúng ta rắc lên ít tiêu nha"},{"time":257.6,"text":"Các bạn có thể ăn chung món này với đồ hủ chiên xè ớt nè"},{"time":260.9,"text":"Hoặc là canh chua bông xua đũa chay"},{"time":264.1,"text":"Cũng rất là hấp dẫn luôn"},{"time":266.3,"text":"Và với những gợi ý của anh Vũ vừa rồi"},{"time":272.2,"text":"Các món này đúng không ạ"},{"time":273.0,"text":"Rất dễ dàng hãy truy cập vào website của chúng tôi"},{"time":275.3,"text":"www.mónngonmỗingày.com"},{"time":278.3,"text":"Nấm kho thấm vị đậm đà"},{"time":280.1,"text":"Có màu nâu hấp dẫn và đẹp mắt"},{"time":281.9,"text":"Nấm cùng cà rốt thơm mùi nước tương"},{"time":284.2,"text":"Lại thêm cay thơm nồng ấm"},{"time":286.3,"text":"Của tiêu xanh"},{"time":286.9,"text":"Hết sạch bánh cơm mà chưa hết thèm"},{"time":289.7,"text":"Dù món mặn hay món chay"},{"time":291.3,"text":"Nấu cùng món ngon mỗi ngày sẽ tuyệt vời ngay"},{"time":293.4,"text":"Hãy vào bếp với món ngon mỗi ngày nha"}]}