4,116.5,27],["L30_V045",7893,315.7,70]]]],"onScreen":[{"time":0.1,"until":1.7,"text":"tv.tuoitre.vn"},{"time":4.9,"until":7.1,"text":"Herbalife · Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024 · tuoitrerv"},{"time":11.7,"until":14.6,"text":"Herbalife · alifeHãy yêu thưng đng vt xung quanh ta!"},{"time":14.8,"until":17.7,"text":"Herbalife · Hãy yêu thương đng vt xung quanh ta!"},{"time":17.9,"until":21.4,"text":"Herbalife · aliféHãy yêu thương đng vt xung quanh ta!"},{"time":21.7,"until":24.8,"text":"tuöitrerv"},{"time":47.8,"until":50.7,"text":"tuoitre"},{"time":51.0,"until":55.1,"text":"tuoitre"},{"time":55.3,"until":65.3,"text":"Herbalife · Ban HOÀNG ANH TÚ · Th v ca Lò gőm Vương Xuân, tinh Bình Dương"},{"time":91.4,"until":94.1,"text":"tuoitre"},{"time":95.6,"until":97.0,"text":"tuoitre"},{"time":100.0,"until":102.0,"text":"tuoitreV"},{"time":102.2,"until":104.0,"text":"tucitre"},{"time":104.6,"until":106.1,"text":"tuoitre"},{"time":109.0,"until":120.4,"text":"Herbalife · Ban HOÀNG ANH TÚ · Th v ca Lò gm Vưðng Xuân, tinh Bình Dương"},{"time":129.4,"until":131.5,"text":"tuoitre"},{"time":142.2,"until":143.2,"text":"tuoitre"},{"time":146.5,"until":149.0,"text":"COMPOR · SMPORT"},{"time":151.7,"until":153.4,"text":"tuöitrev"},{"time":165.6,"until":168.0,"text":"tuöitrev"},{"time":175.7,"until":178.2,"text":"tuoitreV · tuoitkeTV"},{"time":181.5,"until":187.5,"text":"Herbalife · Ban HOÀNG ANH TÚ · BanHOANGANHT · Th v ca Lò gőm Vương Xuân, tinh Bình Dương"},{"time":211.7,"until":213.8,"text":"Herbalife · Tác già: NGUYËN LÂM"},{"time":214.4,"until":214.8,"text":"Herbalife\" · Tác già: NGUYËN LÂM"},{"time":216.4,"until":217.5,"text":"Herbalife · Tác già: NGuYÊN LÂm"},{"time":217.9,"until":223.5,"text":"tv.tuoitre.vn · Herbalife · Tác già: NGUYÊN LÂM · life · AtreTV"}],"speech":[{"time":12.6,"text":"Thương những chú mèo hoang bữa đói bữa no, bạn Hoàng Anh Tú 24 tuổi quê Lâm Đồng đã tạo ra một số sản phẩm gốm hình mèo, bán để kiếm thêm ít tiền, mua thức ăn cho chúng."},{"time":23.6,"text":"Làm chơi, ăn thật, những sản phẩm của Tú được đón nhận và trở thành nghề có thu nhập cao cho chàng trai Gen Z."},{"time":32.5,"text":"Năm 2021, Hoàng Anh Tú quyết định từ bỏ công việc văn phòng và theo nghề vẽ thủ công trên gốm."},{"time":39.3,"text":"Làm việc ở lò gốm, Tú gặp những mèo hoang quanh đó hàng ngày"},{"time":43.5,"text":"Cũng vốn thích mèo từ nhỏ, lại thương cảm cho những con vật bữa đói bữa no"},{"time":48.6,"text":"Tú lấy đây làm ý tưởng và thực hiện những sản phẩm độc đáo của mình"},{"time":55.0,"text":"Khi mà mình làm những cái sản phẩm về mèo"},{"time":58.1,"text":"Thì bên đầu là mình chỉ định là bán đủ có tiền để mua hẹt cho mèo ăn thôi"},{"time":62.7,"text":"Nhưng mà về sau thì mình thấy"},{"time":65.5,"text":"Mình làm những cái sản phẩm này được mọi người đón nhận nhiều"},{"time":67.8,"text":"Ví dụ có một khoảng thời gian mà tụi mình bị trộm tiền cho khách trẻ,"},{"time":72.9,"text":"thì mình nói với con mèo là tụi mày phụ hộ cho tao có tiền đi,"},{"time":76.7,"text":"thì tao sẽ lấy tiền mua pate cho mày ăn."},{"time":79.3,"text":"Thế là xong rồi không biết sao mà những lần mà mình nói như thế thì lúc nào cũng có tiền."},{"time":83.5,"text":"Và sau đấy là lúc nào mình cũng mua pate cho tụi nó ăn hết."},{"time":86.1,"text":"Nên là mình quyết định phát triển luôn cái miệng nánh mèo này."},{"time":92.2,"text":"Tú coi những con mèo hoang ở đây như linh vực."},{"time":95.0,"text":"Dù không thể mang về nhà trợ nuôi"},{"time":97.2,"text":"Nhưng nếu ai ngỏ ý xin về chăm sóc"},{"time":99.8,"text":"Anh chàng cũng không nở rời"},{"time":101.7,"text":"Đàn bèo cứ thế tự nhiên sinh sống"},{"time":104.0,"text":"Tại lò gốm"},{"time":105.0,"text":"Và rất ngoan ngoãn nghe lời"},{"time":108.5,"text":"Mình kiểu như là mình thấy tụi nó"},{"time":109.9,"text":"Kiểu rất là chill"},{"time":111.1,"text":"Nên là khi mà mình nhìn tụi nó"},{"time":112.9,"text":"Thì mình kiểu như là"},{"time":113.6,"text":"Mình thấy là ở giữa những cái thế giới"},{"time":115.5,"text":"Mà mọi người ai cũng bộn bề tất bập"},{"time":117.4,"text":"Thì mình thấy tụi nó như kiểu là"},{"time":119.0,"text":"Những cái khoảng lặng"},{"time":119.7,"text":"Để cho mình có thể nghỉ ngơi"},{"time":121.9,"text":"Rồi thơ thẳng"},{"time":123.0,"text":"Rồi bay bổng"},{"time":123.7,"text":"Khi mà mình vẽ những con mèo thì mình chú ý nhất là về đôi mắt của tụi nó, với biểu kẻ."},{"time":129.1,"text":"Vì mình thấy là một tác phẩm mà mình vẽ ra, cái hồn nhất là ở đôi mắt."},{"time":134.9,"text":"Nên là mình rất là chú trọng vào biểu kẻ và đôi mắt của những con mèo."},{"time":138.8,"text":"Tú đưa hình ảnh mèo ta Việt Nam lên sản phẩm, đem cả những bé mèo mà anh cho ăn hàng ngày vào."},{"time":146.1,"text":"Là con mèo mướp thích ngồi trong lòng anh lúc làm việc,"},{"time":149.3,"text":"Hay con cam luôn chảnh, không có đồ ăn không chịu cho ẩm, cho rờ."},{"time":154.7,"text":"Tú tạo hình ly mèo, tượng mèo, pin cài áo, tất cả đều mang hình mèo dễ thương, ngộ nghĩnh."},{"time":161.1,"text":"Mèo gốm trước khi thành hình hài sẽ được Tú nặng tay, chờ khô rồi mới lên màu, xịt men và đem đi nung."},{"time":168.9,"text":"Giá thành giao động từ 70.000 đồng đến 500.000 đồng tùy sản phẩm."},{"time":173.3,"text":"Ngoài ra, bạn còn nhận vẻ theo yêu cầu của khách hàng"},{"time":177.1,"text":"Trung bình mỗi tháng, Tú kiếm được khoảng 20 triệu đồng"},{"time":181.3,"text":"Muốn đưa tinh thần của tụi trẻ"},{"time":183.5,"text":"Về trong những tác phẩm gốm của mình"},{"time":185.3,"text":"Để dễ dàng tiếp cận với giới trẻ hơn"},{"time":187.2,"text":"Những sản phẩm của mình thì mình thấy là đường giới trẻ rất là yêu thích"},{"time":190.6,"text":"Và mình thường hay bán ở những chỗ như là đường xoắt"},{"time":194.8,"text":"Những khu trung tâm như bên cạnh nhà thờ Đức Bè"},{"time":197.3,"text":"Hoặc là khu đi bộ"},{"time":198.1,"text":"Và bán cho chủ yếu là cách du lịch"},{"time":201.2,"text":"Tú dự định trong thời gian tới sẽ học thêm chuyên sâu về nghề gốm"},{"time":205.0,"text":"Để có thể kể những câu chuyện thú vị về mèo trên tác phẩm"},{"time":209.3,"text":"Và có thể sẽ không gói gọn ở hình mèo"},{"time":212.2,"text":"Tú sẽ vẽ và tạo hình thêm những thú cưng khác trên nền gốm lái thiêu"}]}