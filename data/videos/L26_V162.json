4.7,"until":326.5,"text":"1kg · 1con · 10ml · NGUYÊN LIU · Công ty Ajinomoto Vit Nam · Công ty Hakuhodo Vit Nam · Tham gia thc hin · 2 lát · 1cù · Công ty Golden Scale · Công ty HKFilm · Bn quyn kch bn và cu trúc · ·CHANH · Phi hp thc hin · 5 lá · ·HÀNH TÍM · 1 quà · ·GÀ TA · ·NÊP BÁC · ·LÁ CHANH · Onl · ·BÔT CANH · Thc hin chương trình · chuơng trình thuc · · GÁC CHÍN · ·GÜNG · THÀNH PHÓ HO CHÍMINH · · RUU NÊP · DÀI TRUYÊN HìNH · · NÉP BÃC"}],"speech":[{"time":12.5,"text":"Gà luộc sôi gớt, đỏ rực, may mắn đón xuân sang"},{"time":37.2,"text":"Mến chào quý vị khán giả đang xem chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành"},{"time":41.3,"text":"Chương trình được tài trợ bởi công ty Ajiro Moto Việt Nam"},{"time":45.7,"text":"Kính thưa tất cả quý vị, Tết đến xuân về, dù là Tết đến sớm hơn mọi khi"},{"time":51.1,"text":"Thì không khí mùa xuân vẫn đang ngập tràn khắp nơi"},{"time":53.7,"text":"Và nhân dịp năm mới, thay mặt cho chương trình Món ngon mỗi ngày"},{"time":56.4,"text":"Chúng tôi xin chúc cho tất cả quý vị chúng ta sẽ có một năm mới an lành"},{"time":60.2,"text":"Sẽ có những bữa ăn ấm cúng bên gia đình của mình"},{"time":62.9,"text":"Chuẩn vị và thật là thiện lành cho sức khỏe của mình"},{"time":66.4,"text":"Trong cái mùa tới năm nay thì anh sẽ hướng dẫn một món ăn rất là truyền thống luôn"},{"time":70.2,"text":"Gà luộc với lại sô gấp thôi"},{"time":72.0,"text":"Nhưng ngày hôm nay thì tôi sẽ hướng dẫn cho các bạn cách luộc gà một cách mà ngon lạc nhất"},{"time":76.4,"text":"Và đầu tiên chúng ta cần có một lượng nước"},{"time":78.7,"text":"Làm sao chúng ta thả con gà vào"},{"time":80.5,"text":"Và nước phải ngập hẳn trong gà"},{"time":82.6,"text":"Bây giờ thì để cho con gà sẽ bị luộc được thơm"},{"time":86.9,"text":"Cũng như nước luộc được thơm"},{"time":88.1,"text":"Thì chúng ta thả vào đây khoảng 2 lát gừng nướng cũng như vài củ hành tím nha các bạn nha"},{"time":92.5,"text":"Đó"},{"time":94.0,"text":"Chúng ta nêm vào đây 1 muỗng canh bột canh Ajinomoto"},{"time":98.1,"text":"Thưa các bạn chúng ta luộc gà từ nước lạnh và để lửa sôi lưu riêu thôi"},{"time":102.2,"text":"Như vậy thì gà sẽ chín thám vị giòn và ngọt xịt nha các bạn"},{"time":105.8,"text":"Muốn luộc gà thì phải có nồi, muốn làm xôi thì phải có cái chỏ đồ xôi"},{"time":109.8,"text":"Chính xác"},{"time":111.7,"text":"Rồi bắt lên đây 1 cái chỏ xôi"},{"time":113.9,"text":"Chúng ta có đây nếp ngâm khoảng độ 4 giờ các bạn"},{"time":118.1,"text":"Trong đó chúng ta để ráo như vầy"},{"time":119.6,"text":"Rồi chúng ta sẽ bóp chung với lại thịt gất"},{"time":121.6,"text":"Và đây chúng ta mua gất các bạn"},{"time":123.5,"text":"Chúng ta mua một quả gất chín đỏ nha các bạn"},{"time":125.7,"text":"Rồi chúng ta bóp chung với lại rượu trắng"},{"time":128.0,"text":"Như vầy chúng ta sẽ giữ được màu đỏ tươi của gất được lâu hơn"},{"time":131.7,"text":"Rồi chúng ta sẽ cho vào đây khoảng phân nửa cái lượng gất thôi nha"},{"time":135.2,"text":"Bóp nhẹ như vầy"},{"time":136.2,"text":"Chúng ta cho gì gất nó đều"},{"time":138.3,"text":"Rồi vừa đỏ như vầy"},{"time":139.9,"text":"Màu đỏ rất là đẹp"},{"time":141.6,"text":"Rồi chúng ta cho vào trong cái chỗ"},{"time":143.3,"text":"Chúng ta hấp nha"},{"time":147.0,"text":"Nước đã sôi"},{"time":148.0,"text":"Chúng ta cho vô"},{"time":149.8,"text":"Chúng ta hấp"},{"time":151.4,"text":"Đầu tiên chúng ta hấp khoảng 15 phút trước các bạn"},{"time":153.8,"text":"Con gà thì phải có lá chanh"},{"time":156.1,"text":"Rồi bây giờ nhờ Minh Tuấn"},{"time":158.2,"text":"Chỗ tài cắt"},{"time":159.6,"text":"Chỉ nha"},{"time":162.1,"text":"Mỏng gì được chưa anh?"},{"time":163.9,"text":"Thấy chưa anh được kiểm tra vậy"},{"time":165.6,"text":"Rất là hay, mỏng nữa thì chắc cũng không được đâu"},{"time":168.6,"text":"Khó à"},{"time":169.9,"text":"Nước chấm này rất là đơn giản các bạn"},{"time":171.7,"text":"Chúng ta chỉ cần cho vào đây 1 muỗng cà phê bột canh Ajinomoto"},{"time":176.2,"text":"Và đây lá chanh em sắc mỏng được chưa anh?"},{"time":178.5,"text":"Đẹp quá đẹp luôn Minh Tuấn ơi"},{"time":180.6,"text":"Thưa các bạn bây giờ chúng ta sẽ trộn thịt gắp vô lần 2 trong xôi nha"},{"time":184.4,"text":"Chúng ta cho vào đây khoảng chừng 1 muỗng cà phê muối thôi"},{"time":187.9,"text":"Chúng ta làm món mặn mà các bạn"},{"time":189.2,"text":"Và dằn tí xíu đường"},{"time":191.2,"text":"Muốn ngọt nhiều thì cho đường nhiều"},{"time":193.0,"text":"Và chúng ta trộn đều như vậy"},{"time":196.0,"text":"Chúng ta cho vô chúng ta hấp tiếp khoảng độ chừng 30 phút nữa"},{"time":200.2,"text":"là hạt nếp chúng ta nở hoàn toàn."},{"time":203.3,"text":"Thưa các bạn, chúng ta nhớ trộn gất hai lần"},{"time":206.0,"text":"để xôi thấm vị và có màu gất được đẹp hơn."},{"time":210.0,"text":"Như anh nói là gất thì đầu tiên là màu đẹp."},{"time":212.3,"text":"Nhưng mà bên trong lại có rất nhiều vitamin C."},{"time":214.6,"text":"Vitamin C trong gất thì cao gần 40 lần so với cam."},{"time":218.4,"text":"Và bên cạnh đó là có những cái tiền vitamin A nữa"},{"time":221.9,"text":"rất là tốt cho sức khỏe luôn và đặc biệt là tốt cho thị giác."},{"time":225.2,"text":"Để cho những hạt xôi chúng ta được chín đều,"},{"time":227.8,"text":"chúng ta rảy ít nước, chúng ta trộn đều."},{"time":230.1,"text":"Tiếp tục hấp tiếp"},{"time":232.4,"text":"Xôi đã chấm"},{"time":233.1,"text":"Chúng ta có thể cho đi 1 ít dừa ăn"},{"time":235.2,"text":"Khoảng 1 muỗng canh"},{"time":236.1,"text":"Cho những cái hạt xôi chúng ta được bóng bẫy hơn"},{"time":238.8,"text":"Ngay bây giờ có 1 mã QR trên màn hình"},{"time":240.9,"text":"Quý vị có thể quét mã này"},{"time":242.3,"text":"Công thức nấu ăn sẽ ngay lập tức hiện ra"},{"time":244.7,"text":"Hoặc là chúng ta có thể chụp hình lại mã này"},{"time":246.7,"text":"Gửi tặng cho bạn bè của mình công thức nấu ăn"},{"time":248.7,"text":"Cũng rất là tiện dụng và giúp cho họ có món ngon vào ngày Tết nha"},{"time":253.6,"text":"Chúng ta vớt gà ra"},{"time":254.9,"text":"Để lên 1 cái dĩa như vầy"},{"time":259.4,"text":"Để 1 con gà"},{"time":260.6,"text":"Rất là xinh xắn lên trên"},{"time":262.0,"text":"Và chúng ta thấy nguyên cái mâm này là thấy không khí Tết lại đến trong dàn bếp món ngon mỗi ngày rồi đó"},{"time":266.4,"text":"Và tự nhiên nhìn cái mâm này mình có một cái cảm giác ấm cúng"},{"time":269.6,"text":"Và thực sự là với cái con gà mà với cách luộc của anh Vũ chia sẻ với trong chương trình ngày hôm nay"},{"time":274.7,"text":"Em thấy nó rất là đẹp, phần da, tất cả mọi thứ nó tạo ra cái sự bắt mắt của món ăn"},{"time":279.6,"text":"Cảm ơn anh Vũ rất nhiều vì đã mang đến những bí kíp này"},{"time":284.0,"text":"Hạt nếp mọng, bóng bỉ và dẻo thơm"},{"time":287.0,"text":"Thịt gà mềm, ngọt, dĩa xôi tươi tắn, Tết ăn khang"},{"time":292.6,"text":"Món ăn của ngày hôm nay là một món ăn rất bắt mắt, rực rỡ và rất ấm cúng trong ngày xuân"},{"time":298.2,"text":"Và chúc cho tất cả quý vị một lần nữa chúng ta cũng sẽ có một năm mới rực rỡ, ấm cúng và tràn ngập hương sắc như là món ăn này"},{"time":305.8,"text":"Và tất cả những công thức nấu ăn sẽ luôn có trên những kênh quen thuộc của chương trình Món Ngon Mỗi Ngày"},{"time":311.0,"text":"Là Youtube, Website và Fanpage của chương trình"}]}