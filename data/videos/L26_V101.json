},{"time":68.5,"text":"Bây giờ thì chúng ta sẽ ướp thịt nha"},{"time":71.5,"text":"Cái phần này thì cắt lắc dày khoảng 5 ly"},{"time":78.1,"text":"Bây giờ chúng ta sẽ ướp phần má heo này với lại hành tím băm nè"},{"time":81.7,"text":"Tỏi băm các bạn"},{"time":82.5,"text":"Cho vào đây nước táo hộp á"},{"time":84.0,"text":"Chúng ta cho vào nó vừa xăm thấp"},{"time":86.4,"text":"Cho tí xíu bột ớt Hàn Quốc"},{"time":88.0,"text":"Một phần ba muỗng cà phê bột ngũ huy hương"},{"time":90.3,"text":"Baking soda"},{"time":91.0,"text":"Khoảng 1 muỗng cà phê"},{"time":93.5,"text":"Và chúng ta đem đây 1 phần 3 muỗng cà phê bột ngọt Ajinomoto"},{"time":96.8,"text":"1 muỗng cà phê hạt nêm Ajinomoto"},{"time":100.0,"text":"Thưa các bạn, món này chúng ta nên ướp với nước táo"},{"time":102.6,"text":"Để các acid trong nước táo sẽ giúp cho thịt mềm hơn nha các bạn"},{"time":105.7,"text":"Trộn đều lên"},{"time":106.7,"text":"Chúng ta ướp khoảng độ 1 tiếng rưỡi các bạn"},{"time":110.2,"text":"Và theo như Cục An toàn Thực phẩm khuyên thì là nếu mà chúng ta nướng"},{"time":114.0,"text":"Chúng ta dùng với nước ướp thì nó sẽ giúp cho chúng ta làm giảm khả năng gây bệnh từ thực phẩm"},{"time":119.3,"text":"Có nghĩa là mình không có bị nướng cháy quá anh"},{"time":120.9,"text":"Đúng rồi, chúng ta ướp vào với cái hộp hộp mà nó loạn như vầy"},{"time":124.6,"text":"Thì thứ nhất là thịt sẽ không bị khô sau khi nướng nè"},{"time":127.1,"text":"Và thịt nó sẽ khó bị cháy hơn"},{"time":129.0,"text":"Và khi gia vị được hòa tan như vầy"},{"time":132.0,"text":"Thì sau cùng chúng ta mới cho khoảng 2 muỗng canh dầu ăn vào"},{"time":134.8,"text":"Cho nó bứt mát hơn"},{"time":136.5,"text":"Nó giữ cái gia vị thấm vào bên trong từng lát cái má heo luôn"},{"time":141.9,"text":"Như vầy xong"},{"time":142.7,"text":"Và thưa các bạn bây giờ sẽ hướng dẫn cho các bạn cách cái pha nước sốt nướng"},{"time":148.2,"text":"Chúng ta cho vào đây 1 muỗng canh tương ớt nè"},{"time":150.0,"text":"4 muỗng canh pin cà hoặc là 1 chén nhỏ tương cà"},{"time":153.0,"text":"Khoảng 1 muỗng canh dầu hâm"},{"time":154.9,"text":"Sữa đặc có đường"},{"time":155.8,"text":"1 muỗng canh chúng ta hòa đều luôn"},{"time":157.9,"text":"Nêm vào đây nửa muỗng cà phê hạt nêm Ajinomoto"},{"time":160.8,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":163.1,"text":"Chúng ta khuấy đều như vầy"},{"time":166.0,"text":"Chúng ta bắt đem 1 cái chảo"},{"time":167.7,"text":"Cho 1 xíu dầu ra đây thôi"},{"time":169.8,"text":"Rồi chúng ta cho những miếng thịt này vào"},{"time":172.7,"text":"Đó"},{"time":177.5,"text":"Lửa hơi cao 1 chút"},{"time":178.7,"text":"Đúng rồi"},{"time":180.1,"text":"Đó bắt đầu vàng rồi"},{"time":183.9,"text":"Chúng ta lấy cái dĩa ra"},{"time":185.2,"text":"Chúng ta chút cái mẻ đầu tiên ra"},{"time":189.0,"text":"Chúng ta cho tiếp mẻ 2 vào"},{"time":194.5,"text":"Những cái thịt vừa chín"},{"time":195.5,"text":"Chúng ta chút cái phần"},{"time":197.2,"text":"Hồi nãy vô cùng luôn"},{"time":198.5,"text":"Chúng ta xốp đều từ từ"},{"time":201.8,"text":"Sau cùng chúng ta sẽ"},{"time":204.0,"text":"Cho vào đây sốt nướng"},{"time":206.9,"text":"Thưa các bạn chúng ta áp chảo thịt trước"},{"time":209.2,"text":"Sau đó cho sốt nướng vào"},{"time":210.3,"text":"Như vậy thì thịt sẽ thấm vị mà không bị cháy nha các bạn"},{"time":213.4,"text":"Rồi như vậy thì món ăn chúng ta đã hoàn tất các bạn"},{"time":216.3,"text":"Rất là thơm, cực kỳ hấp dẫn"},{"time":218.9,"text":"Cái này mà ăn kèm với đồ chua ngon anh ha"},{"time":220.7,"text":"Đúng vậy luôn"},{"time":221.4,"text":"Và ngay bây giờ bên cạnh một cái chảo đang nghi ngút khói"},{"time":225.9,"text":"Là một mã QR để các bạn có thể quét mã này"},{"time":228.4,"text":"Chúng ta sẽ ngay lập tức có món ăn"},{"time":229.9,"text":"Hãy quét mã, chụp ảnh lại công thức và thực hiện tại nhà"},{"time":235.0,"text":"Cho những miếng thịt này ra cái dĩa lót lá chuối"},{"time":245.9,"text":"Rát ít mè lên"},{"time":249.6,"text":"Thả đây xíu bớt sợi"},{"time":252.4,"text":"Thưa các bạn, chúng ta có một món nướng từ thịt heo rồi các bạn"},{"time":255.2,"text":"Chúng ta cần thêm một món tôm chua trộn cốc xanh ma dô"},{"time":259.2,"text":"Và món cà tím nhỏ thịt áp chảo"},{"time":261.6,"text":"Là chúng ta có ngay một bữa tiệc luôn"},{"time":263.6,"text":"Chứ không phải một bữa ăn luôn"},{"time":265.1,"text":"Đúng rồi, mà em nghĩ nha"},{"time":266.6,"text":"Với một cái bữa tiệc như vậy"},{"time":268.0,"text":"Các bé thích là chuyện đương nhiên"},{"time":269.6,"text":"Vì cái món này nó chua chua ngọt ngọt, rất là dễ thích ăn"},{"time":271.6,"text":"Các chị cũng thích"},{"time":273.0,"text":"Mà đặc biệt là các anh rất thích nha"},{"time":276.7,"text":"Một món ăn ngon mà thất đại cho cả gia đình luôn"},{"time":278.9,"text":"Cảm ơn anh Vũ rất nhiều"},{"time":281.3,"text":"Thịt má heo nướng thơm lừng"},{"time":282.9,"text":"Thịt chín bóng mượt"},{"time":284.7,"text":"ống lên màu nâu đỏ đẹp mắt"},{"time":286.4,"text":"thịt bên ngoài giòn nhẹ"},{"time":288.3,"text":"bên trong ngọt, mềm"},{"time":290.2,"text":"nhờ nước táo, ăn đậm đà"},{"time":292.4,"text":"cực ngon"},{"time":293.2,"text":"nếu các bạn mời khách đến nhà và muốn gây ấn tượng"},{"time":296.6,"text":"với khách bằng một món ăn, hãy lựa chọn ngay"},{"time":298.6,"text":"má heo nướng táo"},{"time":299.7,"text":"đảm bảo mọi thực cách đều ưng"},{"time":301.8,"text":"công thức luôn có trên youtube, website"},{"time":304.2,"text":"và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":306.4,"text":"truy cập vào, xem lại công thức"},{"time":308.3,"text":"và thết đại bạn bè của mình, chúc các bạn thành công"}]}