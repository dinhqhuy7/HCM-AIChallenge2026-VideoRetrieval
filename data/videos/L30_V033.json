sports · Seroto · tuoitreV · Nhà tho LUONG DiNH KHOA · (Hưng Yên)"},{"time":320.9,"until":324.8,"text":"tuoitreV"},{"time":335.8,"until":342.8,"text":"Tác gi: Lương Đình Khoa"}],"speech":[{"time":12.6,"text":"Khi chúng ta đi đến đích, chúng ta quay lại nhìn, chặn đường sau lưng, chỉ có niềm tự hào, cho dù nó khó khăn đến đâu, thì thứ duy nhất bạn mang theo là bài học, chứ không phải nỗi đau, và đó cũng là cách mà chúng ta sống."},{"time":48.6,"text":"Và đây là thuốc lào"},{"time":50.2,"text":"Để làm gì ạ?"},{"time":51.0,"text":"Để chúng tôi có thể là bôi vào chân"},{"time":53.2,"text":"Và làm gì ạ?"},{"time":54.2,"text":"Để chúng bắt khỏi vùng chua về chúng tôi"},{"time":56.8,"text":"Nhưng mà đây là thử thách của hành trình này"},{"time":61.9,"text":"Dường như không âm thanh nào, bản nhạc nào tuyệt vời nhất"},{"time":65.2,"text":"Bằng bản nhạc của thiên nhiên và vũ trụ"},{"time":84.6,"text":"Cho phép các giác quan mình mở rộng để đón nhận"},{"time":89.0,"text":"Thiên nhiên xung quanh ta"},{"time":90.3,"text":"ta thiên nhiên mua dưỡng sự sống của ta bao nhiêu triệu năm chứ không phải là bây giờ chúng con xin"},{"time":103.8,"text":"nguyện đến đây với tình yêu thương chúng ta sẽ đi với sự biết ơn sự trân trọng thiên nhiên xung"},{"time":114.7,"text":"quanh mình mình đủ yêu thương thì tất cả những nỗi sợ sẽ được hóa giải xung quanh chúng ta là"},{"time":130.0,"text":"là sự sống sự tồn tại của chúng ta phụ thuộc vào sự tồn tại của môn loài khác cho nên nếu mình đủ"},{"time":142.3,"text":"yêu thương mình sẽ bảo vệ nơi này và nơi này sẽ bảo vệ mình tốc độ của tất cả chúng ta là tốc độ"},{"time":154.2,"text":"của người chậm nhất trong đoàn nếu chúng ta đủ yêu thương chúng ta chăm sóc cho những người chậm"},{"time":164.3,"text":"thì tốc độ của cả đoàn sẽ được cải thiện."},{"time":171.8,"text":"Mỗi bước chân của chúng ta đều có giá trị như nhau."},{"time":176.7,"text":"Để lên được đỉnh núi, bước chân nào cũng góp phần của nó."},{"time":182.5,"text":"Hãy trọn vẹn với từng bước chân."},{"time":186.8,"text":"Chỉ có bằng cách đó, chúng ta mới biết cách thưởng thức từng giây phút của cuộc sống,"},{"time":193.8,"text":"cũng như thưởng thức từng bước chân nơi đây."},{"time":254.2,"text":"Nhìn kỹ lại nỗi sợ nó từ cái mình không biết"},{"time":258.0,"text":"Mình không biết về những cái thứ mình đang đối diện"},{"time":260.6,"text":"Mình không biết rõ về nó"},{"time":262.7,"text":"Ví dụ tại sao mình lại sợ sống với thiên nhiên"},{"time":265.1,"text":"Tại sao phải sợ"},{"time":267.3,"text":"Thiên nhiên làm nên sự sống mà tại sao mình lại sợ"},{"time":270.3,"text":"Nó chỉ nuôi dưỡng sự sống thôi"},{"time":271.8,"text":"Cho nên khi mình ở một mình trong thiên nhiên"},{"time":274.0,"text":"Mình có cảm giác sợ sợ"},{"time":275.2,"text":"Đó là mình chưa hiểu về"},{"time":277.3,"text":"Chưa hiểu về cái thế giới này"},{"time":278.7,"text":"Khi bạn hiểu về thế giới này"},{"time":280.5,"text":"Thì bạn thấy"},{"time":282.6,"text":"Nó là cái thứ giúp chúng ta tồn tại"},{"time":284.4,"text":"Cho nên cái thứ sợ là nó nằm ở trong đầu chúng ta thôi"},{"time":289.5,"text":"Cái mà làm chúng ta sợ là nằm trong đầu chúng ta"},{"time":291.9,"text":"Là chúng ta hay suy diễn"},{"time":293.2,"text":"Và có những cái hình ảnh"},{"time":294.9,"text":"Mà nó không đẹp"},{"time":295.9,"text":"Hy vọng là những cái chuyến như thế này"},{"time":300.3,"text":"Mọi người sẽ"},{"time":302.3,"text":"Sẽ vượt qua"},{"time":303.4,"text":"Một chút gì đó ở trong mình"},{"time":305.1,"text":"Mình còn cái giới hạn nào đó thì mình sẽ dựa qua cái giới hạn đó."},{"time":310.6,"text":"Về với thiên nhiên là về với chính mình."},{"time":312.9,"text":"Thiên nhiên chính là chúng ta."},{"time":314.1,"text":"Chúng ta xoay về với thiên nhiên để sống bao dung hơn, yêu thương nhiều hơn."},{"time":316.8,"text":"Và học cách yêu thương trên quý thiên nhiên."},{"time":318.9,"text":"Ngắt kết nối công nghệ để kết nối con người và kết nối với chính mình."},{"time":321.6,"text":"Kết nối với đồng đồ."},{"time":322.6,"text":"Và từ đó hàm phá ra một bản thể khác, một con người khác."},{"time":326.0,"text":"Thấy hết vẻ đẹp, sự hùng bí của đất nước này."},{"time":328.6,"text":"Yêu hơn đất nước này."},{"time":329.8,"text":"Và hòa nhịp cùng thiên nhiên."}]}