261.1,"text":"NHO · COM · TS.BS Đào Th Yn Phi - Chuyên gia dinh dung · CANH ÉCH LÁ ME NON · CÁ BÓNG TRÚNG KHO TIÊU · BÁNH CANH VIT · TÁO · RAU CÙ XÀO XÔT CHAY · LÃU THÁI DÃU CÁ LÓC BÔNG · BÜATRUA · THÚC DON DINH DUÕNG · DUOC TU VÁN BÖI CHUYÊN GIA DINH DUÕNG · BÜA SÁNG · THÚC DON HO TRO GIÀM KHOI MÖ THÙA · BÜA TÕI"},{"time":261.9,"until":266.9,"text":"NGON · mingày · Eat Well, Live Well. · AJINOMOTO. · Ajingon"},{"time":268.3,"until":279.0,"text":"monngonmoingay.com · NGON · AJINOMOTO · Món Ngon Mōi Ngày · noon · moingày"},{"time":281.0,"until":292.0,"text":"250g · 3 trái · Công ty Ajinomoto Vit Nam · Công ty Hakuhodo · NGUYÊN LIÊU · Tham gia thc hin · Công ty Golden Scale · Công ty HKFilm · Phi hp thc hin · KHO TIÊU · 1nhánh · DAI TRUYEN HINH · ·CÁ BÓNG TRÚNG · Bán quyn kch bán và cău trúc · Ban quyen kich ban va cau truc · ·NUÓC MÁM · ·TUONG ÓT · ·TÒI BÄM · ·HÀNH LÁ · · HAT NÊM HEO · Thc hin chương trình · Thc hin chươ · THÀNH PHÓ H CHÍMINH · chuơng trinh thuc · ·ÓT HIÉM · ·MÕ HEO · ·ÔT HIÊM"}],"speech":[{"time":53.0,"text":"Không biết các bạn khán giả như thế nào chứ Kim Thảo hiện tại đang rất là thèm một tô cơm trắng và ăn với cá kho."},{"time":59.6,"text":"Wow, thật là trùng hợp luôn"},{"time":61.4,"text":"Ngày hôm nay Phước Hương cũng đang dự định"},{"time":63.2,"text":"Sẽ làm cái món đó chính là cá bóng trứng kho tiêu"},{"time":66.2,"text":"Và cũng như theo lời của chuyên gia dinh dưỡng"},{"time":68.2,"text":"Tiến sĩ Đào Thiên Phi"},{"time":69.3,"text":"Thì món ăn ngày hôm nay sẽ giúp cho hỗ trợ"},{"time":71.8,"text":"Giảm một lượng mỡ thừa rất tốt cho cơ thể"},{"time":74.1,"text":"Đầu tiên cho món ăn này thì Phước Hương sẽ hướng dẫn"},{"time":76.1,"text":"Cho các bạn sơ chế cái phần hành lá"},{"time":77.7,"text":"Phần đầu hành trắng thì Phước Hương sẽ đập dạp"},{"time":80.1,"text":"Cắt nhuyễn"},{"time":83.7,"text":"Còn phần hành lá thì Phước Hương sẽ cắt nhỏ"},{"time":88.9,"text":"Còn phần ớt sừng thì Phước Hương sẽ cắt lá"},{"time":92.4,"text":"Còn ớt hiểm thì Phước Hưng sẽ đặt dập"},{"time":94.5,"text":"Chúng ta sẽ ướp cái phần cá bóng trứng"},{"time":97.3,"text":"Ướp với đầu hành trắng cắt nhuyễn"},{"time":99.2,"text":"Nửa muỗng cà phê tiêu"},{"time":100.9,"text":"Cho vào đây nửa muỗng cà phê muối"},{"time":102.8,"text":"Một muỗng cà phê đường"},{"time":104.1,"text":"Một muỗng cà phê hạt nêm Azi ngon heo"},{"time":106.6,"text":"Một muỗng canh nước mắm"},{"time":108.0,"text":"Một muỗng canh tương ớt"},{"time":109.4,"text":"Trộn nhẹ tay cái phần cá bóng trứng này cho thấm vị"},{"time":112.7,"text":"Với cá bóng trứng thì chúng ta đã biết là có nhiều canxi tốt cho xương"},{"time":117.5,"text":"Nhưng mà bên cạnh đó còn một công dụng đặc biệt khác nữa"},{"time":120.4,"text":"Là bởi vì cá bống trứng có protein rất dễ hấp thu và hỗ trợ giảm khối mỡ thừa trong cơ thể rất là tốt"},{"time":127.6,"text":"Phần nồi đất cũng đã nóng, Hưng sẽ cho phần mỡ vào"},{"time":130.6,"text":"Thắng đến khi nào mà phần mỡ tươm hết ra"},{"time":133.6,"text":"Bây giờ thì phần mỡ cũng đã ra hết, phần mỡ nước rồi nè"},{"time":136.9,"text":"Hưng sẽ cho vào đây một ít dầu ăn để phần tớp mỡ của mình sẽ được giòn hơn"},{"time":141.4,"text":"Thắng đến khi nào mà tớp mỡ vàng"},{"time":143.9,"text":"Bây giờ Phước Hưng sẽ vớt phần tớp mỡ ra"},{"time":150.3,"text":"Và bây giờ Hương sẽ cho vào đây 1 muỗng canh đường để chúng ta sẽ thắng màu caramel"},{"time":154.1,"text":"Chúng ta sẽ thắng nước màu giúp cho nước kho có độ bóng sáng đẹp hơn"},{"time":158.6,"text":"Phước Hương sẽ cho vào đây 1 muỗng canh tỏi bằm"},{"time":162.8,"text":"Bây giờ Phước Hương sẽ cho phần cá vào"},{"time":168.3,"text":"Đảo nhẹ tay"},{"time":169.3,"text":"Hương sẽ cho vào đây 1 ít nước"},{"time":173.6,"text":"3 trái ớt hiểm nè để chúng ta kho cùng để bớt cái mùi tanh của cá"},{"time":177.5,"text":"Hương cho vào đây 1 muỗng cà phê hạt nêm Azi ngon heo"},{"time":180.8,"text":"Và cuối cùng Hương sẽ cho vào đây 1 muỗng canh nước mắm"},{"time":183.9,"text":"Thì món ăn sẽ thấm vị ngon hơn"},{"time":185.7,"text":"Hương cho vào đây tốt mỡ nữa nè"},{"time":187.6,"text":"Rất là giòn luôn"},{"time":188.7,"text":"Chúng ta sẽ kho cá với tốt mỡ"},{"time":190.9,"text":"Giúp cho món ăn ngon, ngọt, béo sẽ ngon hơn"},{"time":193.8,"text":"Và bây giờ thì nước kho cũng đã sánh cạn lại rồi"},{"time":196.2,"text":"Cuối cùng Phước Hương sẽ cho vào đây 1 ít ớt sần nè"},{"time":199.1,"text":"Và 1 ít hành lá"},{"time":200.6,"text":"Chúng ta sẽ tắt bếp"},{"time":202.2,"text":"Và mùi thơm của nồi cá kho đã lan tỏa khắp gian bếp rồi"},{"time":205.6,"text":"Quý vị và các bạn có thể lấy điện thoại ra"},{"time":207.7,"text":"Lưu lại mã QR đăng hiển thị trên màn hình"},{"time":210.1,"text":"Để lưu lại công thức của món ngon ngày hôm nay"},{"time":214.4,"text":"Phương Hương sẽ rắc lên đây một ít tiêu"},{"time":216.3,"text":"Rất là phù hợp với món ăn mà rất là thơm ngon luôn"},{"time":218.7,"text":"Thật sự rất là thử thách luôn"},{"time":220.3,"text":"Tại vì những ai mà đứng cạnh nồi cá kho như thế này"},{"time":223.2,"text":"Sẽ tự nhiên cảm thấy đối bụng mà"},{"time":224.9,"text":"Và ở đây Phương Hương cũng đã chuẩn bị sẵn"},{"time":226.9,"text":"Một cái chén cơm rất là nóng để chúng ta ăn kèm"},{"time":229.5,"text":"Mời Kim Thảo"},{"time":239.4,"text":"Rất là giòn luôn"},{"time":240.7,"text":"Đúng rồi, giòn và thơm"},{"time":242.8,"text":"Còn cá thì thấm vị ăn chung với cơm trắng"},{"time":245.6,"text":"Trời ơi"},{"time":246.7,"text":"Đúng là không thể cưỡng lại được"},{"time":248.9,"text":"Và chắc có lẽ là phải ăn đến hết sạch nồi cơm mới được"},{"time":252.0,"text":"Và để đạt được hiệu quả dinh dưỡng cho món ăn này"},{"time":253.9,"text":"Thì các bạn tham khảo món ăn ngày hôm nay"},{"time":255.7,"text":"Cùng với một bản thực đơn sau đây"},{"time":257.9,"text":"Cá bóng trứng vốn đã dinh dưỡng"},{"time":263.3,"text":"Nay lại còn thêm hương vị thơm ngon"},{"time":265.2,"text":"Hãy chiêu đải cả nhà món ngon ngày hôm nay nha"},{"time":267.7,"text":"Để xem lại công thức của món ngon ngày hôm nay"},{"time":269.8,"text":"Cùng với rất là nhiều những món ngon khác nữa"},{"time":271.5,"text":"Để chúng ta ghép thành một thực đơn hoàn chỉnh"},{"time":273.7,"text":"Cho bữa ăn gia đình"},{"time":274.5,"text":"Chỉ cần truy cập vào Youtube website fanbase"},{"time":277.5,"text":"của chương trình Món Ngon Mỗi Ngày."}]}