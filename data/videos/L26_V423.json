4.4,"text":"Mêm ngot · Bùibùi · Bùi"},{"time":283.0,"until":287.8,"text":"ine · MOTO · mingày · AJINOM · Eat Well, Live Well. · moingay · Eat Well. Live · Live Well · singay"},{"time":288.8,"until":300.4,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Chuo Senko Vit Nam · Tham gia thc hin · Công ty Golden Scale · Công ty HKFilm · Bn quyn kch bn và cu trúc · Thc hi · Phi hp thc hin · Dàu hào, dàu dièu · Hat nêm Aji-ngon Heo · Mui ót tôm khò Tây Ninh: 2M · Đu phng rang, t sng xanh · Ót bt, tói, côt chanh · Bt ngt AJI-NO-MOTO · Cá kèo: 300g · Rau rám, chanh · Thc hin chương trình · chuơng trình thuc · DÀI TRUYÊN HìNH TP. HCM · Mui ht, tuong t · Công ty C"}],"speech":[{"time":33.5,"text":"Trời ơi, thấp quá mình làm liền đi"},{"time":38.5,"text":"Cá kèo nướng muối ớt, ăn vào là ngất ngay"},{"time":57.8,"text":"Mình chào các bạn đang đến với chương trình Món Ngon Mỗi Ngày"},{"time":60.4,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":64.9,"text":"Với món cá kèo nướng ngày hôm nay thì Phước Hưng sẽ hướng dẫn cho quý vị cái công đoạn sơ chế cá"},{"time":69.4,"text":"Công đoạn này là kỳ công lắm luôn á"},{"time":71.3,"text":"Cá kèo thì rất là ngon nhưng mà nó hay bị nhớt á Phước Hưng"},{"time":73.9,"text":"Đúng rồi đó"},{"time":74.3,"text":"Và đây cũng là một cái lưu ý cho quý vị nha"},{"time":76.1,"text":"Chúng ta sẽ sử dụng giấm để rửa cá để giúp cho cá không bị tanh và sạch nhớt"},{"time":81.7,"text":"Chúng ta đã xử lý cái phần cá qua dưới giấm xong"},{"time":83.9,"text":"Thì chúng ta sẽ lấy cái xiên que cây"},{"time":86.1,"text":"Chúng ta xiên vào cá"},{"time":87.5,"text":"Làm như vậy thì giúp cho định hình cá đẹp hơn"},{"time":90.0,"text":"Và khi ăn chúng ta cũng có cái đồ cầm rất là tiện lợi đúng không?"},{"time":93.2,"text":"Tiếp theo thì chúng ta sẽ pha cái hỗn hợp để chúng ta ướp vào cá"},{"time":96.4,"text":"Cho vào đây là 1 muỗng cà phê hạt nêm Azi ngon heo"},{"time":99.6,"text":"2 muỗng canh muối ớt tôm khô"},{"time":101.6,"text":"1 muỗng canh tương ớt"},{"time":103.1,"text":"Nửa muỗng cà phê dầu hào"},{"time":104.4,"text":"Nửa muỗng cà phê dầu điều"},{"time":105.9,"text":"Và 2 muỗng cà phê nước mắm"},{"time":107.6,"text":"2 muỗng cà phê dầu ăn"},{"time":109.5,"text":"Sau khi mà quý vị chúng ta đã hòa tan rồi nè"},{"time":112.0,"text":"Bây giờ chúng ta sẽ rưới đều lên phần cá và chúng ta sẽ ướp"},{"time":116.2,"text":"Đây bây giờ chúng ta sẽ xóc đều lên"},{"time":118.0,"text":"Phương Hương ơi cái sốt muối ớt tôm này nó ngon quá"},{"time":120.7,"text":"Mình có thể kết hợp với những cái món cá khác nướng được không?"},{"time":123.2,"text":"Được chứ Thanh Phương"},{"time":123.9,"text":"Ví dụ như cá chim nè, cá bớt nè, cá trình mà không chỉ cá không đâu"},{"time":128.0,"text":"Chúng ta có thể ướp tôm cũng ăn rất là ngon"},{"time":130.5,"text":"Wow như vậy là đi picnic là Thanh Phương có bỏ túi khá là nhiều cái món nướng mà muối ớt tôm"},{"time":136.7,"text":"Đúng rồi, cá thì rất là nhanh thắm"},{"time":138.5,"text":"Chúng ta để 5-10 phút là chúng ta có thể đem đi nướng là được rồi"},{"time":141.6,"text":"Và bây giờ tiếp theo Phước Hưng sẽ hướng dẫn cho quý vị"},{"time":144.1,"text":"Chúng ta sẽ giả muối ớt để khi ăn mình sẽ chấm lại cũng rất là ngon"},{"time":147.5,"text":"Đầu tiên Phước Hưng sẽ cho vào đây là 2 muỗng canh muối hột"},{"time":150.5,"text":"2 trái ớt sừng xanh chúng ta sẽ giả nè"},{"time":155.1,"text":"Và bây giờ tiếp theo Hưng sẽ cho vào đây 1 muỗng cà phê bột ngọt Ajinomoto"},{"time":159.0,"text":"Nửa muỗng cà phê ớt bột"},{"time":160.7,"text":"Rồi và bây giờ chúng ta tiếp tục lại giả nhuyễn nha"},{"time":166.2,"text":"Khi ăn thì chúng ta có thể nặng vào đây một ít chanh cũng rất là ngon"},{"time":169.5,"text":"Phước Hưng chuẩn bị một cái lò nướng điện rất là tuyện lợi nè"},{"time":172.0,"text":"Còn đối với gia đình mình thì có thể nướng bằng lửa thang nè"},{"time":174.4,"text":"Hay là có thể áp chảo thì ngon cũng tương tự luôn"},{"time":177.1,"text":"Bây giờ Phước Hưng sẽ dùng một ít dầu ăn chúng ta sẽ phết lên trên cái phần lò nướng này"},{"time":181.7,"text":"Và lần lượt chúng ta sẽ cho phần cá kèo lên"},{"time":187.5,"text":"Nghe tiếng xèo đã tay ha"},{"time":189.2,"text":"Đúng rồi"},{"time":190.4,"text":"Trời ơi thơm lừng luôn kìa Phước Hưng"},{"time":192.4,"text":"Trong khi nướng cá thì chúng ta sẽ dùng cọ quét cái phần nước sốt ớt lên trên bề mặt"},{"time":197.1,"text":"Cá thì làm như vậy thì giúp cho cá thấm vị mà"},{"time":199.8,"text":"Cá sẽ không bị khô nữa"},{"time":201.0,"text":"Chúng ta sử dụng muối ớt tôm ớt cá để tăng thêm hương vị thơm ngon cho món ăn"},{"time":205.6,"text":"Wow, bây giờ thì cá đã vàng, chín rồi"},{"time":208.2,"text":"Phương giúp Dương Hương lấy cái dĩa để chúng ta trình bài ra món ăn"},{"time":210.6,"text":"Cá liền"},{"time":212.7,"text":"Cá đây"},{"time":213.2,"text":"Thơm quá"},{"time":214.9,"text":"Bán gặp ăn dụng nha"},{"time":216.1,"text":"Có đâu, đang đợi Phương lấy cái dĩa lại nè"},{"time":218.1,"text":"Bây giờ chúng ta sẽ lấy cá ra"},{"time":219.9,"text":"Bây giờ chúng ta sẽ lần lượt đẩy cá lên"},{"time":225.5,"text":"Rất là thơm và hấp dẫn"},{"time":228.3,"text":"Các phần muối ớt tôm nó áo đều bên ngoài của con cá kèo"},{"time":232.4,"text":"Cá kèo mà kết hợp ăn kèm với rau răm là không thể thiếu luôn"},{"time":239.5,"text":"Và bây giờ cuối cùng Phước Hưng sẽ cho lên đây một ít đậu phộng rang giả nhuyễn nè"},{"time":245.8,"text":"Thơm lắm, nhìn thôi là cảm thấy kích thích vị giác rồi các bạn ơi"},{"time":249.6,"text":"Khi ăn thì chúng ta sẽ chấm với một miếng muối ớt xanh nè"},{"time":253.1,"text":"Và ăn kèm với một ít dưa leo và tỏi ngâm chua nữa, rất là tuyệt vời luôn"},{"time":257.2,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng"},{"time":259.6,"text":"Thì chúng ta có thể kết hợp với salad trộn thịt bò"},{"time":262.0,"text":"Và canh gà nấm mỡ"},{"time":263.4,"text":"Cũng ra một bữa ăn rất là tuyệt vời"},{"time":266.2,"text":"Các bạn có thể theo dõi lại công thức"},{"time":268.2,"text":"Của các món ăn trên"},{"time":269.2,"text":"Tại website mónngonmũi.com"},{"time":271.2,"text":"Thịt cá kèo mềm ngọt"},{"time":273.2,"text":"Bùi bùi từ đậu phộng sang"},{"time":274.6,"text":"Lại có chút bằng bặn đăng đắng đặc trưng"},{"time":277.1,"text":"Đối đầu lưỡi"},{"time":277.8,"text":"Ăn kèm với rau râm và chút dưa leo muối sổi"},{"time":280.9,"text":"Là nhớ mãi không thôi"},{"time":282.6,"text":"Các bạn hãy thực hiện ngay món cá kèo nướng muối ớt thơm lừng ám áp cả trang bếp"}]}