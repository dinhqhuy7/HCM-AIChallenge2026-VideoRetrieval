"},{"time":60.2,"text":"Biết nhận diện là gì không"},{"time":61.4,"text":"Trời ơi mấy cái mà nó mềm mềm"},{"time":63.1,"text":"Mà nó dài dài"},{"time":63.9,"text":"Mà nó nâu nâu như vầy"},{"time":64.8,"text":"Thì em đoán chắc luôn là củ cải muối"},{"time":66.4,"text":"Mà được anh cắt ra rồi đúng không"},{"time":67.5,"text":"Chính xác"},{"time":68.3,"text":"Người ta hay gọi là xá bấu đó các bạn"},{"time":70.8,"text":"Rồi ngay bây giờ mời các bạn cùng theo dõi"},{"time":72.7,"text":"Thực hiện món canh xương đậu phộng xá bấu"},{"time":74.7,"text":"Món ăn này thì rất là đơn giản"},{"time":76.7,"text":"Mà bên cạnh đó theo chút giá dinh dưỡng"},{"time":78.4,"text":"Thì món ăn này còn giúp hỗ trợ cho việc bỏ máu"},{"time":80.9,"text":"Rất là tốt nha các bạn"},{"time":81.8,"text":"Đầu tiên thì chúng ta sẽ xử lý phần protein trước"},{"time":84.6,"text":"Trước chúng ta ướp sườn với lại 1 muỗng cà phê hạt nêm Ajinomoto, 1 muỗng cà phê bột ngọt Ajinomoto và 1 muỗng cà phê đường."},{"time":93.7,"text":"Thêm ở đây nửa muỗng cà phê bột năng nha các bạn."},{"time":96.7,"text":"Chúng ta nên ướp sườn với lại chút bột năng để giữ được độ ẩm cũng như độ ngọt của sườn nha các bạn."},{"time":101.7,"text":"Trong đây khoảng chừng 1 muỗng cà phê dầu ăn các bạn."},{"time":104.8,"text":"Cải xe báu này để xả bớt cái vị mặn trong cải xe báu thì chúng ta nhớ ngâm trong nước muối khoa lõn."},{"time":112.7,"text":"Ủa sao anh không ngâm với lại nước lã mà anh lại ngâm với nước muối?"},{"time":115.8,"text":"Chúng ta ngâm sá báu hay là củ cải muối với lại nước muối pha lõm"},{"time":119.0,"text":"Để phản ứng hóa học giúp cho giảm độ mặn của củ cải muối nha các bạn"},{"time":122.5,"text":"Bây giờ chúng ta nấu canh thôi"},{"time":123.8,"text":"Cho củ hành tím vô đây"},{"time":125.1,"text":"Chúng ta rang không dầu cho dậy mùi thơm"},{"time":127.7,"text":"Các bạn lưu ý nha"},{"time":128.5,"text":"Chúng ta chỉ cần rang thơm củ hành tím"},{"time":130.4,"text":"Để nước canh chúng ta được thơm hơn"},{"time":132.1,"text":"Món ăn này thì chúng ta cần bổ sung thêm tí xíu độ phộng ha"},{"time":135.2,"text":"Mà các bạn nhớ ngâm cho nó mềm trước nha"},{"time":137.5,"text":"Chúng ta sẽ cho dầu ăn vào"},{"time":140.0,"text":"Và chúng ta cho xương vào"},{"time":142.1,"text":"Chúng ta xào cho thẩm vị"},{"time":144.1,"text":"Thẩm vị, xăng các bạn"},{"time":147.2,"text":"Và phút này chúng ta nổi lửa lên"},{"time":150.4,"text":"Chúng ta sẽ cho cải xá báu vào"},{"time":152.3,"text":"Chúng ta xào luôn"},{"time":153.2,"text":"Cụ cải muối hay còn gọi là xá báu á"},{"time":155.1,"text":"Thì mình sơ chế hơi cực một chút xíu"},{"time":156.7,"text":"Nhưng mà nó được làm từ củ cải trắng"},{"time":158.3,"text":"Có một cái công dụng rất tốt cho sức khỏe"},{"time":160.3,"text":"Là giúp cho chúng ta có thể loại bỏ được độc tố, thanh lọc máu"},{"time":163.1,"text":"Nên là chúng ta lâu lâu hãy ăn một lần để mà"},{"time":165.1,"text":"Duy trì sức khỏe của mình các bạn nha"},{"time":166.5,"text":"Kế tiếp chúng ta sẽ cho đậu phộng vào"},{"time":168.7,"text":"Đậu phộng thì mình đảo đều thôi, không cần xào gì đâu"},{"time":171.4,"text":"Và chúng ta cho khoảng 1,5 nước lọc vào"},{"time":174.6,"text":"Chúng ta nấu"},{"time":178.9,"text":"Nêm khoảng 1 muỗng cà phê hạt nêm Aji ngon heo"},{"time":181.7,"text":"Và khoảng 1 muỗng cà phê bụng ngọt Aji domoto"},{"time":185.1,"text":"Chúng ta nấu cho sôi bùng lên"},{"time":187.6,"text":"Sau đó chúng ta vớt bọt và chúng ta hạ lửa nhỏ"},{"time":190.6,"text":"Nấu từ từ từ từ khoảng độ 1 tiếng"},{"time":193.1,"text":"Là xương vừa chín mềm sau đó vừa thấm vị"},{"time":196.3,"text":"Một tô canh rất hấp dẫn nhưng mà lại cực kỳ dễ làm"},{"time":199.4,"text":"Và ngay bây giờ bên cạnh tô canh ấy có 1 mã QR để các bạn quét mã"},{"time":202.7,"text":"Chúng ta lưu công thức lại để thực hiện tại nhà nha"},{"time":206.9,"text":"Chúng ta sẽ cho ra một cái tô đám"},{"time":218.8,"text":"Trời quá là hấp dẫn"},{"time":220.0,"text":"Bây giờ thì em sẽ thử cái món canh này"},{"time":222.9,"text":"Nước thơm, nước thơm lắm mọi người"},{"time":224.8,"text":"Bây giờ mình sẽ ăn cái phần tinh túy đây"},{"time":237.1,"text":"Cái phần thịt sườn á"},{"time":238.1,"text":"Nó mềm nha, mình cắn vào trong"},{"time":240.1,"text":"Bắt đầu cái vị umami nó bắt đầu nó bùng nổ"},{"time":242.7,"text":"Trong miệng của mình bị ngon đó mọi người"},{"time":244.3,"text":"Sau đó là nước canh nó thấm hòa"},{"time":246.9,"text":"Với lại cái phần thịt"},{"time":247.6,"text":"Tất cả mọi thứ tổng hòa ra một cái món canh"},{"time":250.2,"text":"Mình cảm giác nó rất là bổ dưỡng ở trong luôn"},{"time":253.0,"text":"Và tạo ra một cái cảm giác rất là ngon miệng"},{"time":255.3,"text":"Để đạt được hiệu quả dinh dưỡng hơn"},{"time":257.0,"text":"Chúng ta có thể kết hợp món ăn này"},{"time":258.5,"text":"Cùng với lại thực đơn tham khảo sau đây"},{"time":264.9,"text":"Một chút thay đổi về mặt nguyên liệu"},{"time":266.9,"text":"Chúng ta cho thêm xá bấu"},{"time":268.2,"text":"Một chút thêm vào của một nguyên liệu khác"},{"time":270.3,"text":"Là đậu phộng tự nhiên có một món canh sườn non hầm"},{"time":273.4,"text":"Rất hấp dẫn luôn"},{"time":274.4,"text":"Các bạn hãy thử làm ngay món ăn này tại nhà nha"},{"time":276.6,"text":"Và nếu các bạn quên công thức"},{"time":277.8,"text":"Thì sẽ luôn có trên Youtube, website và fanpage của chương trình"},{"time":281.3,"text":"Để chúng ta tham khảo trí cập vào và thực hiện món ăn"},{"time":283.4,"text":"Chúc các bạn thành công nha"}]}