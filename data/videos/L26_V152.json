hi hp thc hin · ·KHÓ QUA · ·NGÒ GAI · Thc hin chương trình · ·BÔT NGOT · chuơng trình thuc · · HÀNH TÍM BÄM · THÀNH PHÓ HO CHÍMINH · DÀI TRUYÊN HìNH · ·ÓT HIÉM · Thc hin chưo · Onl · ·ÓT BÄM"}],"speech":[{"time":32.2,"text":"Rất vui được gặp lại các bạn đang đến với chương trình Món ngon mỗi ngày, nấu chuẩn, ăn lành"},{"time":37.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":41.6,"text":"Quý vị khán giả thân mến, ngày hôm nay thì chúng ta sẽ cùng có một món ăn đến từ nguyên liệu đó là cua đồng và vị đắng đặc trưng của khổ qua"},{"time":50.0,"text":"Và ngày hôm nay thì Vương sẽ hướng dẫn cho các bạn một cái món canh rất là thanh đạm và thanh mát cho những ngày như là chuyển mùa nóng bức nè đúng chưa?"},{"time":57.6,"text":"Phần khổ qua thì bây giờ chúng ta sẽ cắt khúc 2cm và dùng muỗng lấy hết cái phần ruột bên trong ra"},{"time":63.1,"text":"Trong khổ qua có cái lớp màng nhung trắng"},{"time":65.8,"text":"Chúng ta sẽ lấy thật kỹ thì khi nấu thì phần khổ qua sẽ ít đắng hơn"},{"time":69.7,"text":"Ừ, như vậy thì Minh Phương sẽ cạo cái phần màng này cho nó kỹ một ít xíu"},{"time":74.0,"text":"Đúng rồi, chúng ta sơ chế đến những cái phần như là nhân và rau nêm"},{"time":78.0,"text":"Phần đầu hành trắng này này Phước Hương sẽ băm nhỏ để chúng ta sẽ trộn vào nhân cá thắt lát"},{"time":82.3,"text":"Bây giờ Hương sẽ cho đầu hành trắng qua đây"},{"time":84.7,"text":"Còn phần ngò gai và lá hành lá thì Phước Hương sẽ cắt nhỏ để chúng ta làm rau nêm"},{"time":90.3,"text":"Rồi Hương sẽ cho qua đây"},{"time":93.5,"text":"Còn phần ớt hiểm thì Phước Hương sẽ đập dập"},{"time":95.6,"text":"Và bây giờ tiếp theo Phước Hương sẽ hướng dẫn cho các bạn chúng ta sẽ trộn nhân cá thác lá"},{"time":101.6,"text":"Đầu tiên Hương sẽ cho vào đây 1 muỗng canh hành tím băm"},{"time":105.4,"text":"Nửa muỗng canh nước mắm"},{"time":106.8,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":109.2,"text":"Nửa muỗng cà phê ớt băm"},{"time":110.6,"text":"Nửa muỗng cà phê tiêu"},{"time":111.9,"text":"Và nửa muỗng cà phê đầu hành trắng băm"},{"time":114.7,"text":"Chúng ta sẽ quết đều"},{"time":116.8,"text":"Càng quết nhiều thì cái độ dai sẽ càng ngon đúng không Phước Hưng?"},{"time":119.9,"text":"Đúng rồi, chúng ta quết khi nào mà cảm thấy nặng tay là cái thác lát nó rất là dai rồi"},{"time":124.3,"text":"Và bây giờ tiếp theo Phước Hưng sẽ hướng dẫn cho các bạn chúng ta sẽ lọc lấy cua"},{"time":128.2,"text":"Phước Hưng chuẩn bị là 300g thịt cua xay hòa tan với lại 1 lít 2 nước"},{"time":132.9,"text":"Và chúng ta đã lọc ra lấy được 1 cái tô cua rất là ngon như thế này"},{"time":136.3,"text":"Và bây giờ Phước Hưng sẽ cho vào nồi và chúng ta sẽ nấu với lửa vừa để lấy cái ván cua thịt bên trên"},{"time":142.4,"text":"Bây giờ thì mình Phương mở lửa lên ha"},{"time":144.0,"text":"Tiếp theo Phương sẽ hướng dẫn cho các bạn chúng ta sẽ tạo hình cho phần khổ qua"},{"time":147.4,"text":"Hưng sẽ cho phần cá thác lát vào bên trong khổ qua nè"},{"time":152.4,"text":"Và đây cũng là một cái lưu ý cho quý vị khán giả nha"},{"time":154.5,"text":"Chúng ta sẽ dùng nước mắm thoa lên hai bề mặt của Hưng để giúp cho Hưng định hình tốt hơn"},{"time":159.1,"text":"Chúng ta sẽ dùng nước mắm thoa đều phần bề mặt của thác lát nè"},{"time":164.0,"text":"Cũng như là khổ qua để cho nó kết dính lại với nhau"},{"time":167.3,"text":"Khổ qua rất là nhiều vitamin A tốt cho mắt nè"},{"time":170.2,"text":"Bên cạnh đó thì còn có vitamin E và cũng như là vitamin C"},{"time":174.2,"text":"Sẽ tốt cho da cũng như là chống oxy hóa"},{"time":176.9,"text":"Rất là tốt đúng không"},{"time":177.9,"text":"Bây giờ thì phần thịt cua cũng đã định hình"},{"time":180.5,"text":"Ở bên trên bề mặt rồi"},{"time":181.6,"text":"Phước Hương sẽ dùng cái vợt"},{"time":182.7,"text":"Chúng ta sẽ vớt cái phần thịt cua"},{"time":184.4,"text":"Khi mà chúng ta vớt thì cái phần nước cua rất là trong"},{"time":188.2,"text":"Phước Hương cũng sẽ sử dụng"},{"time":189.7,"text":"Cái phần nước cua này"},{"time":190.9,"text":"Chúng ta sẽ cho lần lượt khổ qua vào"},{"time":193.0,"text":"Chúng ta nấu"},{"time":194.9,"text":"Cho một trái ớt hiểm đập dập vào"},{"time":197.2,"text":"Khi mà chúng ta nấu canh luôn"},{"time":198.8,"text":"Và đây cũng là một lưu ý cho quý vị khán giả"},{"time":200.6,"text":"Chúng ta sẽ thêm ớt hiểm khi nấu khổ qua"},{"time":203.0,"text":"Giúp cho khổ qua khi nấu sẽ bớt đắng hơn"},{"time":205.3,"text":"Cho vào đây 1 muỗng cà phê bột ngọt Ajinomoto"},{"time":208.4,"text":"1 muỗng cà phê đường"},{"time":209.9,"text":"1 muỗng rưỡi cà phê muối"},{"time":213.1,"text":"Tiếp tục thì Phước Hương sẽ lấy"},{"time":214.7,"text":"Cái phần thịt cua mà chúng ta đã vớt ra từ ban đầu"},{"time":217.5,"text":"Chúng ta sẽ cho vào"},{"time":219.9,"text":"Vì sao mà trong những ngày hè nóng nực"},{"time":221.6,"text":"Chúng ta luôn luôn có cái món canh cua đồng"},{"time":224.1,"text":"Đó là vì cua đồng sẽ giúp cho chúng ta bổ sung điện giải"},{"time":227.0,"text":"Cũng như là nước tốt cho cơ thể"},{"time":228.4,"text":"Chúng ta sẽ cho 1 muỗng cà phê nước mắm nè"},{"time":231.4,"text":"Cho vào đây một ít rau nêm, hành lá và ngò gai"},{"time":235.7,"text":"Như vậy là món canh khổ quà của chúng ta đã hoàn tất rồi"},{"time":238.6,"text":"Chúng ta sẽ tắt bếp nha"},{"time":240.0,"text":"Quý vị và các bạn ơi hãy quét ngay mã QR đang hiển thị trên màn hình"},{"time":243.7,"text":"Để lưu ngay công thức của món canh ngày hôm nay nha"},{"time":248.5,"text":"Bây giờ Phước Hương sẽ múc canh ra"},{"time":252.4,"text":"Khổ quà còn cái màu rất là xanh luôn"},{"time":254.9,"text":"Rất là đẹp đúng không?"},{"time":256.0,"text":"Đúng rồi"},{"time":257.1,"text":"Khi nấu xong thì rất là đẹp mắt"},{"time":259.9,"text":"Cuối cùng Phước Hương sẽ cho lên đây một ít ớt sừng nè"},{"time":263.3,"text":"Và một cọng ngò rí để tăng thêm màu xanh cho món ăn"},{"time":267.0,"text":"Khi ăn thì chúng ta sẽ chấm với một ít nước mắm mặn nè"},{"time":270.3,"text":"Và ăn kèm với cơm trắng là rất là tuyệt vời"},{"time":272.6,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng"},{"time":274.7,"text":"Thì chúng ta có thể kết hợp với món cánh gà xào ớt xiêm"},{"time":277.6,"text":"Cũng sẽ rất là ngon"},{"time":278.7,"text":"Và các bạn thấy đó chỉ cần một chút biến tấu dựa trên các nguyên liệu quen thuộc"},{"time":283.0,"text":"Thì chúng ta sẽ có một món canh rất là thơm ngon và hấp dẫn như thế này đây"},{"time":288.2,"text":"Khổ qua chín vừa tới xanh xanh, thơm mùi cua đồng, gạch cua béo béo"},{"time":293.0,"text":"Nước canh trong có vị ngọt của cua lẫn với vị hơi đắng của khổ qua, ngon đến lạ"},{"time":298.7,"text":"Canh cua khổ qua mát ngọt cho ngày nắng ngon cơm"},{"time":303.6,"text":"Chân chờ gì mà không thử ngay các bạn ơi"},{"time":305.8,"text":"Và để xem thêm nhiều công thức của các món ăn ngon"},{"time":308.6,"text":"Các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":313.5,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}