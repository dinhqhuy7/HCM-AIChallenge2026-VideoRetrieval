eTV"},{"time":81.2,"until":84.4,"text":"BOVIEN · GCOV · tuoitrey · OVICN"},{"time":90.6,"until":93.4,"text":"XUA · tuoitrey · NUA"},{"time":95.8,"until":101.1,"text":"tuoitre · COVI · SIC CO VIEN XUA · SIC CO VIEN NUA · tuoithery · tuoitireTy"},{"time":110.5,"until":116.1,"text":"tuoitre · tucitre"},{"time":116.3,"until":119.2,"text":"CCOT"},{"time":120.0,"until":121.1,"text":"SÁE GÓ VIÊN X"},{"time":126.6,"until":129.5,"text":"IVE · tuoitreV"},{"time":129.8,"until":140.9,"text":"Khán già · NGUYENTUA · NGUYĚN TUÃN KHA · VANLANG · thuang hiu · thurong hitu"},{"time":152.7,"until":154.6,"text":"tuöitre"},{"time":155.1,"until":164.2,"text":"VANLANG · BNYTRYA"},{"time":167.6,"until":169.4,"text":"Tác già: MINH THU · Tác gia:MINH"},{"time":169.6,"until":172.9,"text":"Tác già: MINH THU · tuoitrety · thung hibu"},{"time":173.1,"until":175.3,"text":"Tác già: MINH THU"},{"time":175.6,"until":181.2,"text":"tv.tuoitre.vn · Tác già: MINH THU · AtreTV · Vien"}],"speech":[{"time":17.6,"text":"Tụi em mất khoảng thời gian khoảng 1 tháng để lên ý tưởng cho chương trình lần này"},{"time":20.5,"text":"Và lúc đầu thì tụi em rất là gặp nhiều khó khăn trong cái việc này"},{"time":25.2,"text":"Vì sợ là ảnh hưởng quá nhiều về lịch sử"},{"time":28.1,"text":"Và nó sẽ có nhiều cái mà nó sẽ không có đúng đến lịch sử"},{"time":34.0,"text":"Nhưng mà sau khi mà tụi em đang nhìn nhận thấy được cái hiện trạng của giới trẻ hiện nay là"},{"time":38.8,"text":"Chưa thực sự họ phân biệt được trang phục nào là của Việt Nam và trang phục của nước ngoài"},{"time":45.3,"text":"Tụi em lấy ý tưởng từ đó và thời hiện đại thì họ lại muốn phá cách cái bộ trang phục đó hơn"},{"time":50.4,"text":"Và đó cũng là lý do mà tụi em muốn thay đổi"},{"time":65.9,"text":"Thông qua cái môn học này tụi em dựng lên một cái sự kiện"},{"time":69.4,"text":"Để có thể cơ lại cái niềm tự hào dân tộc, cái sự yêu thương, những cái giá trị cốt lõi mà mình đã từng có"},{"time":76.7,"text":"Và từ đó có thể là lan tải những cái thông điệp đó đến với nhiều bạn trẻ hơn"},{"time":81.1,"text":"Và có thể là mang việc phục đến gần hơn với các bạn trẻ"},{"time":84.8,"text":"Và để không bị lãng quên những giá trị văn hóa đó"},{"time":88.5,"text":"Tụi em sẽ đánh mạnh vào về việc phục của thời nhà Nguyễn"},{"time":93.3,"text":"Và trong những bộ trang phục đó thì tụi em có mang đến những bộ trang phục như là áo nhật bình"},{"time":100.0,"text":"Và áo ngũ thân hoặc là áo dao lĩnh"},{"time":103.2,"text":"Thì đó là một trong những cái gọi là những cái bộ nổi bật của thời nhà Nguyễn"},{"time":109.2,"text":"Và tụi em muốn mang đến cho các bạn đến tham dự cái buổi ngày hôm nay"},{"time":113.5,"text":"về cái sự khơi dậy cái niềm tự hào dân tộc và từ đó cũng thể là truyền tỏa lại những cái thông điệp đó đi xa hơn."},{"time":125.4,"text":"Với vai trò là một người tham gia trong chương trình thì em cảm thấy các bạn sinh viên đã đưa ra đề tài"},{"time":129.7,"text":"và thực hiện sự kiện hết sức và gần gũi đối với các bạn sinh viên."},{"time":132.8,"text":"Điều động lại nhất cho em là ý nghĩa của những cái mẫu trang phục của thời nghiện"},{"time":137.2,"text":"mà ban tổ chức đã trình diện trong cái tiết mục kịch"},{"time":142.1,"text":"và đó cũng là một cái điểm báo chốt cho chương trình và là cái hồn của sự kiện."},{"time":147.3,"text":"Đây là một điều khá là đặc biệt đối với một sự kiện được tổ chức tại Trường Đại học Quang Lan."},{"time":152.7,"text":"Thông qua những bộ cổ phục đó, giới chỉ có thể tìm ra được nhiều nét văn hóa,"},{"time":159.2,"text":"nét đặc sắc của cổ phục Việt Nam qua từng trang phục."}]}