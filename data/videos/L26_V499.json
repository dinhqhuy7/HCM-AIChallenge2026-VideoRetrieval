ime":289.2,"until":294.6,"text":"AJINOMOTO · mingày · MOTO · Well, Live Well · MON · AJIN · Eat Well · Live Well. · Eat Wes, Live Wet · moingàv · AJINOMC"},{"time":296.6,"until":306.1,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Công ty Golden Scale · Cá chép nguyên con: 1kg · Cà chua: 2 trái · Bn quyn kch bn và cu trúc · Ring cát si: 2M · Công ty HKFilm · Càn nuóc: 150g · Hành tim: 2 cù · Ngh giā nhuyn: 2M · Ót hiém, su hào · Công ty A · Ht nêm Aji-ngon® (Heo) · Com mè: 2M · Phi hp thc hin · Thc hin chương trìn · Nuc dùng gà: 1lit · chuơng trình thuc · Thc hié · Bt ngot AJI-NO-MOTO® · DÀI TRUYÊN HINH TP. HCM · Cóng ty C"}],"speech":[{"time":18.1,"text":"Bây giờ thì cô nhờ em là tiếp tục làm sạch con cá chép này dùm cô đi"},{"time":21.7,"text":"Làm cá hả cô Hà?"},{"time":23.9,"text":"Thôi hôm nay mình ăn chay đi cô Hà"},{"time":25.9,"text":"Sao vậy?"},{"time":26.6,"text":"Em không có biết làm cá"},{"time":27.9,"text":"Trời ơi, cá này làm rồi, sạch sẽ hết rồi"},{"time":31.0,"text":"Chỉ bây giờ mình rửa lại thôi"},{"time":33.3,"text":"Hôm nay là cô định chiêu đại em món cá chép mà em rất thích"},{"time":36.9,"text":"Với lại món cá chép có thịt giòn, ngọt và thơm nữa"},{"time":40.2,"text":"Chắc chắn sẽ là một món ngon"},{"time":41.8,"text":"Vậy thôi, đi rửa cá giúp cô đi"},{"time":44.2,"text":"Dạ, sẵn sàng"},{"time":45.4,"text":"Cảm ơn em"},{"time":49.5,"text":"Thanh vị với cá chép nấu riêng mẻ"},{"time":74.8,"text":"Đầu tiên cá chép mà sau khi mà làm sạch ra thì mình sẽ cắt khúc khoảng chừng 3 phân như thế này"},{"time":79.8,"text":"Rắc một ít muối lên trên cái thịt cá chép như thế này"},{"time":82.9,"text":"Nó thấm vào trong cá để làm cho thịt cá khi mình ăn thì nó sẽ săn chắc và ngon"},{"time":87.1,"text":"Trong lúc mà mình để cho cá chép thấm một chút muối thì mình sẽ sơ chế các loại rau cũ"},{"time":92.3,"text":"Cà chua thì đơn giản chúng ta chỉ cần cắt muối cao thôi"},{"time":95.1,"text":"Ở đây cô sẽ cắt làm 6 cà chua chín đỏ nha"},{"time":98.3,"text":"Thì nó sẽ ngon"},{"time":99.3,"text":"Tiếp theo 1 trái ớt hiểm chúng ta sẽ đập vặt"},{"time":102.8,"text":"2 củ hành tím mình sẽ cắt lát"},{"time":107.2,"text":"Cần nước chúng ta mua về rửa cho sạch"},{"time":109.8,"text":"Và bây giờ thì cô sẽ cắt khúc khoảng chừng 3 phần"},{"time":113.8,"text":"Người Bắc thì có những món ăn mà nấu với lại rau cần rất là ngon"},{"time":117.4,"text":"Và món này thì mình cũng nấu theo kiểu hương vị của món ăn miền Bắc"},{"time":122.1,"text":"Tiếp theo thì hành lá và thì là mình cũng sẽ cắt khúc như thế này"},{"time":126.3,"text":"Thì ở đây thì cô sử dụng thêm su hào để cho món canh mình thêm ngọt và thêm chất dinh dưỡng"},{"time":130.9,"text":"Su hào thì chúng ta sẽ cắt sợi dày khoảng chừng 7 ly như thế này"},{"time":135.7,"text":"Xong rồi nguyên liệu rồi đó"},{"time":137.3,"text":"Em giúp cho cô một cái chảo lên trên đây để cô chiên cá nha"},{"time":141.1,"text":"Rồi mở lửa lên giúp cô luôn"},{"time":143.5,"text":"Cảm ơn Kim Thảo"},{"time":144.5,"text":"Cô cho vào đây khoảng chừng nửa chén dầu"},{"time":146.5,"text":"Rồi bây giờ cô sẽ cho cá vô đây"},{"time":149.3,"text":"Em thấy cô đã làm sạch hết khăn bụng ha"},{"time":153.7,"text":"Mình chỉ cần chiên cá sơ lên cho nó thơm thôi ha"},{"time":156.5,"text":"Và săn bề mặt lại thôi"},{"time":159.4,"text":"Rồi, chắc là em sẽ tắt lửa được dùm cô"},{"time":161.6,"text":"Cô sẽ dớt cá này ra"},{"time":164.0,"text":"Khi mình chiên như vậy thì cá nó sẽ thơm béo và nó không còn cái bị tăm nữa"},{"time":168.7,"text":"Rồi bây giờ em mở lửa giúp cô"},{"time":171.1,"text":"Chúng ta sẽ cho vào đây 2 muỗng canh dầu"},{"time":173.4,"text":"Bây giờ dầu nóng rồi thì mình sẽ cho hành tím bào vào"},{"time":177.5,"text":"Riêng đã cắt sợi, nghệ đã giả nhỏ, 2 muỗng canh mọi thứ"},{"time":182.1,"text":"Các bạn chúng ta lưu ý là chúng ta sẽ xào kỹ cái phần nghệ và riêng"},{"time":186.1,"text":"Để món ăn này sẽ có mùi thơm và màu đẹp ha"},{"time":188.4,"text":"Rồi, bây giờ thơm rồi đó, cô cho luôn cà chua vô"},{"time":192.2,"text":"Và cô cho luôn trái ớt mà đã tập dập vô đây"},{"time":197.2,"text":"Rồi, tiếp theo cô cho vào đây 1 lít nước dùng"},{"time":199.6,"text":"Chúng ta sẽ nêm gia vị vào trong canh"},{"time":201.7,"text":"Đầu tiên mình cho 1 muỗng cà phê muối"},{"time":203.5,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":206.0,"text":"1 muỗng canh hạt nêm Aji ngon heo"},{"time":209.7,"text":"Tiếp theo thì chúng ta sẽ cho vào đây 2 muỗng canh mẻ"},{"time":212.2,"text":"Kim Thảo và các bạn lưu ý là chúng ta sẽ chọn mẻ nuôi có màu trắng ngà thì sẽ ngon hơn ha"},{"time":217.4,"text":"Và sau khi mà mua mẻ về thì cô đã tán qua 1 cái rây"},{"time":220.9,"text":"Thì mẻ nó sẽ mịn như thế này"},{"time":223.0,"text":"Rồi mình sẽ cho vào đây chừng 2 muỗng canh mẻ"},{"time":226.1,"text":"Với các món canh hay là lẩu mà sử dụng mẻ để nấu tạo độ chua"},{"time":230.5,"text":"Thì nhà em rằm lắm cô ạ"},{"time":233.5,"text":"Nước sôi lại thì cô sẽ cho cái phần su hào này vào"},{"time":236.4,"text":"Như vậy là nước sôi trở lại"},{"time":237.8,"text":"Sau khi mình bỏ su hào vào"},{"time":239.4,"text":"Thì mình sẽ cho cá vào hả cô Hân"},{"time":241.4,"text":"Sau khi cá sôi khoảng được 3-4 phút"},{"time":244.3,"text":"Mà chín rồi đó"},{"time":244.9,"text":"Bây giờ thì mình sẽ cho rau cần nước vô"},{"time":248.1,"text":"Cùng với lại cả cái phần rau nêm"},{"time":250.5,"text":"Là có hành lá và thị là nữa đó"},{"time":253.2,"text":"Cuối cùng thì mình cho vào đây là 1 muỗng rưỡi canh nước mắm"},{"time":257.2,"text":"Sôi lên lại rồi mình sẽ tắt lửa được"},{"time":259.4,"text":"Rồi bây giờ cô tắt lửa"},{"time":262.8,"text":"Thơm quá luôn đó cô Hà"},{"time":264.4,"text":"Rồi"},{"time":266.1,"text":"Cô sẽ cho vào đây một ít thùy là"},{"time":268.4,"text":"Để cho nó xanh mát thơm nữa nè"},{"time":270.6,"text":"Món này thì mình có thể ăn với lại cơm"},{"time":273.6,"text":"Hoặc ăn với bún hay ăn dạng lẩu cũng đều rất ngon"},{"time":275.9,"text":"Và như vậy là chúng ta đã hoàn thành món ăn rồi"},{"time":278.1,"text":"Thịt cá da giòn, tươi ngọt, thơm nồng mùi riền"},{"time":281.7,"text":"Đắm mình trong nước mẻ chua thanh, ngọt hậu"},{"time":284.9,"text":"Một món ăn sáng tạo độc đáo lại gần gũi đến lạ kỳ"},{"time":288.9,"text":"Vừa ngon vừa bắt vị"},{"time":290.4,"text":"Thử ngay món cá chép nấu riêng mẻ"},{"time":292.8,"text":"Để đã cho cả gia đình các bạn nhé"}]}