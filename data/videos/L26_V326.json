":"AJINOMOTO · Eat Well, Live Well. · moingày"},{"time":287.2,"until":289.9,"text":"Youtube · Website · Fanpage Facebook · XEMKY · wwwmonngonmoingay.com · Món Ngon Moi Ngày · MJINOMOTO · moingay · CÁC BUOCNÁU ÀN:"},{"time":291.9,"until":303.1,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Chuo Senko Vit Nam · Tham gia thc hin · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Trúng vit: 4 cái · Công ty HKFilm · Vt: 1/2 con (1kg) · Hoa hòi: 2 tai · Hành tím: 5 cù · Rau qu cát nhuyn · Công ty A · Nuóc tuong \"Phú Si · Tòi: 2 cù · Phi hp thc hin · Đuòng thôt nôt, ruu, gùng · Thc hin chương trình · chuơng trình thuc · Bt ngt AJI-NO-MOTO° · DÀI TRUYÊN HìNH TP. HCM · Nuóc dùa tuoi: 1 trái · Güng bàm nhò: 2M · Thc hié"}],"speech":[{"time":14.8,"text":"Cái gì vậy Tấn á?"},{"time":15.8,"text":"Không có, anh mua được con vịt ngon, cái hưng phấn"},{"time":18.9,"text":"Liên quan gì nãy Tết, Tết gì nữa? Hết Tết rồi"},{"time":21.2,"text":"Em bất cười quá à"},{"time":22.6,"text":"Cả cuộc đời của em, cả một năm trời chỉ có một cái Tết hả?"},{"time":25.5,"text":"Tết nào có lì xì thì em nhớ thôi"},{"time":26.8,"text":"Ủa em không mê ăn hả?"},{"time":28.1,"text":"Mình đang trong Tết Đoan Ngọ nè"},{"time":29.4,"text":"Ê"},{"time":29.9,"text":"Thấy chưa?"},{"time":30.5,"text":"Mà anh thấy nha, Tết Đoan Ngọ đặc biệt là mọi người rất là hay tổ chức tiệc"},{"time":33.4,"text":"Anh có một cái điều anh thắc nhắc là tại sao"},{"time":35.0,"text":"Cứ đến Tết Đoan Ngọ thì người miền Trung người ta lại rất thích ăn thịt vịt"},{"time":37.9,"text":"Anh biết sao không?"},{"time":38.7,"text":"Không, mới hỏi"},{"time":39.8,"text":"Tại vì Tết đó gọi là nó nằm giao động từ tháng 6, tháng 9 đúng không?"},{"time":42.7,"text":"Nó nằm trong khoảng giữa đó"},{"time":43.8,"text":"Mà thời gian này vịt rất là thơm, béo, ngọt"},{"time":46.6,"text":"Cái thứ 2 nữa, vịt có tính mát"},{"time":48.2,"text":"Mà mùa này cực kỳ nóng, ăn vịt hợp lý"},{"time":50.8,"text":"Tặng em"},{"time":51.5,"text":"Cái chuyện này em biết em phải làm gì khi được tặng món vịt này rồi"},{"time":53.9,"text":"Ừ, cho em đem về là có chuyện với anh đó"},{"time":55.5,"text":"Và bây giờ chúng ta sẽ vào bếp để làm một món ôm nha"},{"time":59.9,"text":"Vịt ôm nước tương, hương đậm đà, vị vấn vương"},{"time":79.7,"text":"Mến chào các bạn khán giả đến với chương trình Món ngon mỗi ngày"},{"time":82.2,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":85.9,"text":"Anh Tướng rất là giỏi"},{"time":87.0,"text":"Nhìn là đã biết là đã được trà gụ với gừng với muối này nọ xong rồi"},{"time":90.9,"text":"Vịt cũng đã thơm đã sạch rồi"},{"time":92.2,"text":"Thì chúng ta sẽ tiến hành áp chảo không dầu để cho lấy bớt cái phần mỡ trong da vịt ra"},{"time":96.3,"text":"Và chúng ta đợi cái chảo cho nóng nha"},{"time":98.1,"text":"Và chúng ta chỉ áp chảo cái phần da vịt thôi"},{"time":101.2,"text":"Đối với món này chúng ta nướng hoặc áp chảo phần da vịt"},{"time":103.9,"text":"Để da vịt săn lại khi ăn sẽ ngon hơn nha"},{"time":106.4,"text":"Nè nè nè nè xí nưới"},{"time":109.4,"text":"Đây mỡ nó bắt đầu"},{"time":111.0,"text":"Đó"},{"time":112.6,"text":"Công nhận ha"},{"time":113.8,"text":"Mình nhìn con vịt mình đã lựa là nó đã ít mỡ rồi"},{"time":116.9,"text":"Mà nó vẫn tương ra rất nhiều mỡ luôn"},{"time":118.6,"text":"Cái phần da vịt thì anh Tuấn thấy nè"},{"time":120.2,"text":"Nó cũng đã tràn thơm như vầy rồi"},{"time":122.5,"text":"Chúng ta đã tắt lửa nhưng mà trong thời gian này"},{"time":124.3,"text":"Chúng ta vẫn để trong chảo nha"},{"time":125.5,"text":"Nó còn giữ được cái nhiệt độ nóng"},{"time":127.1,"text":"Và nó cũng sẽ lấy thêm được phần mỡ trong da vịt"},{"time":129.0,"text":"Chúng ta sẽ pha cái phần nước da vị đi"},{"time":130.8,"text":"Chúng ta ướp cái phần vịt này"},{"time":132.1,"text":"Xin sẽ có 2 muỗng canh nước tương phú sỉ"},{"time":134.2,"text":"Đó nước tương là nó rất hợp với thịt vịt luôn nha"},{"time":138.8,"text":"Một muỗng cà phê bột ngọt Ajinomoto."},{"time":140.8,"text":"Chúng ta có một muỗng canh đường thuốc nước."},{"time":142.9,"text":"Rồi, thì bây giờ chúng ta sẽ hòa tan cái hỗn hợp này nha."},{"time":145.8,"text":"Cái phần vịt này cho vào đây nha."},{"time":147.8,"text":"Đấy, hấp dẫn quá Sinh ơi."},{"time":149.9,"text":"Và bây giờ thì chúng ta sẽ trộn cái phần vịt với cái phần gia vị mà Sinh đã trộn hồi nãy nha."},{"time":154.7,"text":"Rồi."},{"time":155.2,"text":"Bây giờ để cái phần hỗn hợp này qua một bên."},{"time":157.5,"text":"Và tiếp theo thì Sinh cũng chuẩn bị một cái nồi để chúng ta ôm vịt."},{"time":160.6,"text":"Sinh cần một chút xíu dầu ăn, gần một muỗng canh."},{"time":162.7,"text":"Thì bây giờ dầu nóng thì chúng ta cho cái phần gừng băm này vào nha"},{"time":165.3,"text":"Đó, nó kêu xèo xèo nhẹ nhẹ vậy được rồi"},{"time":167.2,"text":"Tỏi nè, hành tím, gừng"},{"time":168.8,"text":"Đã nướng"},{"time":170.2,"text":"Chúng ta có thêm đại hồi nữa"},{"time":171.9,"text":"Hay còn gọi đơn giản là hoa hồi"},{"time":173.6,"text":"Chúng ta cho hoa hồi, hành, tỏi nướng vào món ăn"},{"time":176.4,"text":"Để tạo hương vị mới lạ cho món ôm nha"},{"time":178.3,"text":"Và thêm một cái nguyên liệu nữa"},{"time":179.7,"text":"Có tiêu giả bể nữa"},{"time":182.1,"text":"Rồi, đã thơm rồi"},{"time":183.4,"text":"Và bây giờ chúng ta sẽ cho phần vịt đã tẩm ướp vào"},{"time":185.6,"text":"Sau cái phần vịt đã được tẩm ướp"},{"time":187.5,"text":"Cho săn lại"},{"time":188.4,"text":"Bây giờ anh Tuấn thấy nó thơm rồi, nó săn rồi"},{"time":190.7,"text":"Ở đây là Xin sẽ xài khoảng 1 trái dừa"},{"time":192.8,"text":"Xin cũng cần 1 ít nước lọc nữa"},{"time":195.4,"text":"Anh Tuấn biết sao không?"},{"time":196.7,"text":"Để cho cái phần đồ ăn chúng ta không bị quá ngọt"},{"time":199.0,"text":"Đúng rồi, nó cân bằng lại"},{"time":200.4,"text":"Cho luôn phần trứng vịt đã luộc và bóc vỏ vào nha"},{"time":203.0,"text":"Các bạn nhớ là đậy nắp khi ôm để vịt được mau chín và giữ được vị ngọt"},{"time":206.8,"text":"Thì bây giờ em sẽ kiểm tra cái phần vịt nha anh Tuấn nha"},{"time":208.8,"text":"Đây"},{"time":209.4,"text":"Wow"},{"time":211.3,"text":"Màu rất là đẹp"},{"time":212.2,"text":"Và cái sốt nè, anh Tuấn thấy nó đã sánh sệt như vầy"},{"time":214.2,"text":"Quá thơm luôn"},{"time":215.3,"text":"Là hoàn thành rồi nha"},{"time":216.3,"text":"Trước khi ra dĩa thì chúng ta sẽ cần thêm 1 muỗng canh nước tương phú sĩ nữa để cho đậm đà và thêm thơm hơn nha"},{"time":225.0,"text":"Đó, gắp từng miếng vịt nha"},{"time":226.8,"text":"Và bây giờ rất là hấp dẫn rồi thì em sẽ có thêm nửa cái trứng mình cắt ra nữa cho nó đẹp nha"},{"time":231.6,"text":"Đó"},{"time":232.8,"text":"Và thêm 1 ít nước sốt nữa"},{"time":234.6,"text":"Đó, chúng ta sẽ trang lên cái phần đó"},{"time":237.8,"text":"Và bây giờ cuối cùng thì chúng ta sẽ điểm xuyến lên 1 ít ớt sắc nữa"},{"time":242.7,"text":"Đây"},{"time":244.3,"text":"Và 1 ít lá quế"},{"time":246.5,"text":"Để có một cái Tết đoan ngọ hoàn chỉnh"},{"time":248.5,"text":"Thì ngoài món vịt ôm này"},{"time":249.9,"text":"Chúng ta cần thêm một món salad táo rau mầm nữa"},{"time":252.3,"text":"Trời ơi một cái ngày Tết đoan ngọ"},{"time":254.1,"text":"Mà đậm đà hương vị"},{"time":256.0,"text":"Và rất là ngon miệng nữa"},{"time":257.7,"text":"Cảm ơn Sinh rất nhiều vì đã làm ra một món ăn rất đặc biệt"},{"time":260.5,"text":"Và cực kỳ hấp dẫn cho ngày hôm nay"},{"time":261.7,"text":"Phần thịt vịt ôm tới độ chín mềm"},{"time":264.0,"text":"Tư mỡ mọng nước"},{"time":265.7,"text":"Ngọt đậm đà"},{"time":267.1,"text":"Phần nước ôm sánh lại quyện với trứng vịt bùi bùi"},{"time":270.5,"text":"Thơm thơm từ nước tương phú sỉ"},{"time":272.5,"text":"Cực kỳ bát cơm"},{"time":273.8,"text":"Như vậy là Tết Đoan Ngọ năm nay mọi người lại có thêm một sự lựa chọn để làm phong phú hơn bữa ăn của mình"},{"time":278.9,"text":"Cùng với lại món vịt ôm nước tương"},{"time":280.9,"text":"Và công thức của món ăn này thì luôn luôn sẵn sàng chia sẻ trên các trang của chương trình Món Ngọ Mỗi Ngày"},{"time":286.3,"text":"Bao gồm là Youtube, Website và cả Fanpage của chương trình"},{"time":290.1,"text":"Chúc các bạn thành công nha"}]}