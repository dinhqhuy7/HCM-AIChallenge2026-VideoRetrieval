"L24_V007",3388,135.5,7],["L24_V005",3597,143.8,9]]]],"onScreen":[{"time":0.1,"until":1.7,"text":"tv.tuoitre.vn"},{"time":5.1,"until":7.1,"text":"Herbalife · Clip bn đc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":11.7,"until":20.8,"text":"039 · 041 · Herbalife · Cuc thi Lan ta năng lung tích cc 2024: · RESO · 051 · tuoitre · STRONGER · Chin thn' làm tình nguyn · Son Life · LONGE · IN2022 · Syn kite · ntusitrety · 019 · 222"},{"time":21.0,"until":25.8,"text":"Herbalife · VIEN · SV07 · Cho · Cuc thi Lan ta năng lung tích cc 2024: · tuoitre · Chin thn' làm tình nguyn · SVOT · GUY · SV0T"},{"time":26.1,"until":32.0,"text":"VILOIICH · MI LQI ICH TAEM · VI LOIICH TRăM"},{"time":32.2,"until":38.3,"text":"tuoitreTy"},{"time":38.5,"until":47.9,"text":"tuöitreV"},{"time":48.1,"until":55.4,"text":"AVIEN · GUIENVIEN · TINH · SVO · ENVIEN · DANG, VAN MIN · Cing S · , VAN MIN! · lo nhing hat mim Tù Té · Cing S007 · Dé cube dai · CONG BANG. VAN IM · Dé cude · TIIH · Áng co 2 chil à Nhu\" · Clanng S · lo nhang hat te Tù Té"},{"time":55.6,"until":68.6,"text":"SV07 · tuoitrerv · SV67 · SVUT"},{"time":74.0,"until":78.2,"text":"TCL · SAB · QI DUNG SUNG NGAN · CHAO MUNG Q · CHAO MUNCC · OI DUNG SUNG Neán · AHUNG, SUNG · PUNG TÁM HUT QUO GIA · QI MANH QUOC"},{"time":79.2,"until":83.6,"text":"V07"},{"time":83.8,"until":88.6,"text":"Carlsberg · addal · VILINAM · GIÁI VÔ DICH QUÕC GIA · CUC THÊ DUC THÊ THAO · CNAM2024 · TRUNG TÂM HUAN LUYÊN THE THAO QUÓC GIA DÀ NÃNG · ang · MÔN BOI NGHÒIXIJY · JYETATTO · MÔN BOI NGHÒXIJYÊT AT TOI · MÔN BOI NGUÒLX · tuoltrery · YET TAT TO"},{"time":88.8,"until":93.2,"text":"tuoitre"},{"time":98.8,"until":103.2,"text":"tuoitre"},{"time":103.8,"until":108.6,"text":"tuoitreTy · SVU7"},{"time":110.2,"until":113.0,"text":"Herbalife · Tác già: Châu Thành Toàn · VIETNAM BOOK OF RECORDS · TÓ CHÚC KY LUC VIÈT NAM · XÁC LÂP KÝ LUC · DOI TINH NGUYÊN SV 07 · Đoi finh nguyên tham gia phuc vu Giài Thé thao Nguai Khuyét tát Toan quōc · lièn tuc, lou năm nhat tai Viet Nam (21 nàm, tu nam 2003 den nam 2024) · (Truc thuòc Hoi Chù Thép Do tinh Soc Trang)"},{"time":115.8,"until":118.4,"text":"VIETKINGS · Herbalife · VIETNAM BOOK OF RECORDS · Sinh ngày 24.02.1983 · Ông CHÀU THÀNH TOÀN · Tác già: Châu Thành Toàn · XÁC LÁP KÝ LUC · TÓ CHUC KÝ LUC VIĘT NAM · VK.GXL  2349 / KLTN/ (QD/KLTN/2020) · DOI TINH NGUYÊN SV 07 · (Truc thuc Hoi Chù Thp Do tinh Soc Tráng) · KÝ LUC THIEN NGUYEN VIET NAM · Doi tinh nguyên tham gia phuc vu Giài Thé thao Nguoi Khuyet tát Toan quóc · Dja chi: 417/6/5 Quang Trung, Phuòng 10, Quán Gò Váp, TP. Hò Chi Minh · lién tuc, lau năm nhát tai Vit Nam (21 nàm, tu nām 2003 dén nām 2024) · Top giá tri Ky luc Thięn nguyén Vięt Nam - Nguói có nhiéu cóng hién và dóng góp · HÀNH TRİNH TİM KIÉM · This dihe phi thin 15/03 / 2020 · ONG HOI K'Y LUC DIA VIET NAM · trong linh vc tinh nguyen cho căng dng, xă bi lin tuc trong 22 năm (tù 1998 – 202"}],"speech":[{"time":21.4,"text":"Tôi tham gia thể thao dành cho người khuyết tập suốt 22 năm, từ năm 2003 tới nay."},{"time":30.7,"text":"Với tinh thần tình nguyện, sung kích đi đầu, toàn lưu hướng dẫn, tập hướng và tham gia cùng các bạn."},{"time":40.1,"text":"các bạn muốn làm sao để cho tất cả các bạn vận động viên có một môn thể thao để tập luyện và"},{"time":49.5,"text":"nâng cao sức khỏe của tất cả các bạn và khi tới giải thể thao dành cho người quyết tâm thì toàn"},{"time":57.3,"text":"dùng hết sở trường sở đoạn như ca hát nhảy và làm đủ thứ trò miễn làm sao cho tất cả các bạn"},{"time":67.1,"text":"các bạn vận động viên khi đến tham gia thể thao dành cho ngũ khuyết tật xem thể thao ngũ khuyết"},{"time":73.6,"text":"tật như một ngôi nhà chung và đến đây thì không ai bị bỏ lại phía sau tới đây tất cả mọi người"},{"time":80.9,"text":"ai cũng đều được vui bởi nhóm tình nguyện SV07 và sẽ hứa cố gắng làm tình nguyện liên tục và"},{"time":91.3,"text":"Và lâu dài tiếp tục để làm sao đó các anh chị không bao giờ buồn khi đến thể thao dành cho người quyết tập."}]}