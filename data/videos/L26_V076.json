tên gọi gì đúng không em?"},{"time":55.9,"text":"Đó là cơm chiên kim chi"},{"time":57.4,"text":"Kim chi này thì chúng ta chọn mua kim chi vừa ngẫu thôi tức là vừa chua vừa ăn"},{"time":62.4,"text":"Và chúng ta phải vắt ráo nước"},{"time":64.1,"text":"Bây giờ nhờ em thái sợ có cái cỡ khoảng 3 ly là được"},{"time":67.7,"text":"Ở bên Hàn Quốc thì Thanh Phương thấy là mọi người hầu như trong bữa ăn nào cũng có kim chi cả"},{"time":72.6,"text":"Nó có lên men tự nhiên chứ vì vậy rất là tốt cho hệ tiêu hóa"},{"time":76.7,"text":"Và cơm thì chúng ta nấu cho khô ráo và để cho nguội như vậy"},{"time":80.2,"text":"Bây giờ tôi sẽ hướng dẫn xử lý cái phần thịt bò"},{"time":83.3,"text":"Rồi chúng ta sẽ cắt ra thành những sợi trước nha"},{"time":88.4,"text":"Chúng ta cắt những miếng hạt lụ nhỏ thôi"},{"time":93.5,"text":"Sau khi thịt bò chúng ta cắt xong thì chúng ta sẽ ướp thịt bò"},{"time":97.9,"text":"Ướp vào đây khoảng 1 muỗng cà phê gừng băm, 1 muỗng cà phê nước tương phố xị nha"},{"time":104.0,"text":"Chúng ta ướp nhanh thôi"},{"time":106.6,"text":"Đậu hành đập nhẹ nhẹ thôi"},{"time":108.1,"text":"Và chúng ta cắt nhỏ"},{"time":111.8,"text":"Còn phần lá thì chúng ta cắt nhỏ để chúng ta cho vào sau cùng"},{"time":122.6,"text":"Thưa các bạn bây giờ phần chuẩn bị nguyên liệu đã xong"},{"time":125.2,"text":"Chúng ta tới phần chính đó là chúng ta sẽ chiên cơm"},{"time":129.6,"text":"Cho ít dầu ăn vào"},{"time":131.9,"text":"cho một miếng tỏi vào nữa cho nó mới thơm rồi chúng ta mới cho thịt bò vào rồi đó chúng ta xào thịt bò vừa"},{"time":144.3,"text":"chín tán như vậy là được rồi các bạn rồi chúng ta sẽ tắt lửa cho ra đây tiếp tục chọn này chúng ta cho"},{"time":152.8,"text":"và đem ít dầu cho đậu hành lá vào cho tỏi vào và chúng ta cho kim chi vào xào trước nha các bạn"},{"time":160.4,"text":"thưa các bạn chúng ta nên bắt ráo nước kim chi và xào kim chi trước để cho kim chi được thơm và không"},{"time":165.4,"text":"không bị chua gắt nha kế tiếp chúng ta sẽ cho bắp vào xào lửa lớn xíu cho bắp nó rám rám cái mặt cái"},{"time":174.0,"text":"mùi chiên một tí rồi chúng ta cho vào đây khoảng 3 muỗng canh tương ớt Hàn Quốc nha các bạn và"},{"time":178.9,"text":"chúng ta cho vào đây tiếp luôn là cái nước mà chim chi khi nãy nha chúng ta cho vào hòa để dễ"},{"time":185.8,"text":"hòa tan tương ớt hơn và chúng ta cho côn vào khi trộn sẽ đều hơn nha các bạn cho côn vào nha chúng"},{"time":195.9,"text":"Chúng ta trộn đều ha"},{"time":196.9,"text":"Sau đó chúng ta sẽ cho thịt bò vào"},{"time":200.7,"text":"Nêm ở đây khoảng 1 muỗng cơ phê bột ngọt Ajinomoto"},{"time":203.7,"text":"1 muỗng canh nước tương phú sỉ"},{"time":207.4,"text":"Mà cái màu của cơm chiên bây giờ rất là đẹp không các bạn ơi"},{"time":210.3,"text":"Một cái màu cam"},{"time":211.2,"text":"Cuối cùng bắt mắt"},{"time":212.4,"text":"Tắt lửa chúng ta cho hành lá vào"},{"time":214.8,"text":"Sau cùng chúng ta nhớ cho dầu mè vào nha"},{"time":217.4,"text":"Chúng ta nên cho dầu mè vào sau cùng"},{"time":219.4,"text":"Để chúng ta giữ được mùi thơm của dầu mè"},{"time":222.0,"text":"Cũng như tạo cái mùi vị đặc trưng cho món ăn Hàn Quốc"},{"time":224.9,"text":"Rồi bây giờ xong"},{"time":226.1,"text":"Chúng ta bắt lên đây một chỗ bé"},{"time":228.2,"text":"Chúng ta sẽ chiên trứng ốp la"},{"time":230.0,"text":"Rồi chúng ta đổ trứng vào chúng ta chiên"},{"time":232.5,"text":"Phần trứng ốp la này vừa làm món ăn ngon hơn"},{"time":235.1,"text":"Mà vừa để trang trí cho các phần cơm chiên kim chi"},{"time":237.8,"text":"Còn thêm phần hấp dẫn"},{"time":238.9,"text":"Chúng ta chờ trứng chín một tí xíu nha"},{"time":241.8,"text":"Món ăn ngày hôm nay cực kỳ hấp dẫn"},{"time":243.6,"text":"Các bạn nhớ quét mã QR để tìm hiểu công thức của món ăn nha"},{"time":248.8,"text":"Quá thơm luôn anh Vũ ơi"},{"time":250.3,"text":"Rồi dùng cái dĩa ha"},{"time":252.3,"text":"Ta để đây ốp ra"},{"time":254.6,"text":"Thả cái trứng ốp la lên"},{"time":259.7,"text":"Để ở đây một ít rong biển cách sợ nữa nha"},{"time":262.4,"text":"Vừa trang trí vừa ăn kèm luôn"},{"time":265.1,"text":"Cuối cùng chúng ta để đây một tí xíu mè"},{"time":267.3,"text":"Mè trắng rang"},{"time":268.4,"text":"Xong"},{"time":269.2,"text":"Món cơm cực kỳ hấp dẫn luôn các bạn ơi"},{"time":272.1,"text":"Mà mình ăn kèm với một món canh nữa là hết ý luôn đấy ạ"},{"time":275.3,"text":"Đúng vậy ạ mà"},{"time":276.0,"text":"Món Hàn Quốc thì chúng ta phải cần thêm một món canh Hàn Quốc"},{"time":278.6,"text":"Đó là chúng ta có thể kết hợp cùng với lại món canh cá minh thái"},{"time":282.3,"text":"Mà đã có trong chương trình món ngon mỗi ngày"},{"time":285.2,"text":"Cơm chiên màu đỏ"},{"time":286.4,"text":"Điểm suyết màu vàng xanh cực bắt mắt"},{"time":288.5,"text":"Thơm lừng mùi kim chi và nước tương"},{"time":290.7,"text":"Vị chua cay kích thích"},{"time":292.2,"text":"Cùng với thịt bò mềm mỏng, cực cuốn"},{"time":296.1,"text":"Cơm chiên kim chi, màu sắc bắt mắt, vị bắt miệng"},{"time":299.3,"text":"Hãy cùng vào bếp để thực hiện ngay món ăn này nhé"},{"time":301.7,"text":"Và các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":306.2,"text":"Để tìm hiểu về công thức của các món ăn ngon"},{"time":308.4,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại"}]}