N"},{"time":244.0,"until":246.0,"text":"GON"},{"time":249.3,"until":252.6,"text":"NGON · IGON"},{"time":252.8,"until":255.0,"text":"QUÉT MÃ QR DÊ XEM CÔNG THÚC · niine"},{"time":255.4,"until":259.1,"text":"NGON · AJINOMOTO. · Eat Well, Live Well. · QUÉT MÃ QR DÊ XEM CÔNG THÚC · Ajingon · móingày"},{"time":259.5,"until":261.1,"text":"NGON · mingày · MON"},{"time":264.2,"until":265.5,"text":"Fbie."},{"time":282.2,"until":287.5,"text":"GÀCHAY · NGON · AJINOMOTO · mingày · Eat Well, Live Well. · Onl · HOA CHUÓI · DÁY DÙ DINH DUÖNG · BÜA ÁN · NOM · VÓI"},{"time":299.2,"until":306.3,"text":"NGON · AJINOMOTO · AJINOM · mingày · Eat We · Eat Well, · Live Well · gày · moingay · BUNG VI NAM · main"},{"time":306.7,"until":315.7,"text":"monngonmoingay.com · NGON · AJINOMOTO · Món Ngon Mōi Ngày · moingay · Live Well."},{"time":316.9,"until":328.4,"text":"150g · 80g · 100g · 1/2 trái · Công ty Ajinomoto Vit Nam · 2 ming · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · NGUYÊN LIÊU · ·DÁU HÀO CHAY · ·HEM CHAY · Phi hp thc hin · ·DÂU HÙ TRÁNG · ·GIÁ SÓNG · ·DÂU PHÔNG RANG · Thc hin chương trình · · CÂN TÂY, BOA-RÔ · ·BÁNH PH KHÔ · chuơng trình thuc · ·NUÓC TUONG · · TUONG ÖT, TUONG CÀ · Thc hin chươ · ·HAT NÊM NÄM · ·ÖT CHUÔNG DÒ · THÀNH PHÓ HO CHÍMINH · · HÚNG QUE, ÖT HIÉM BÄM · DÀI TRUYÊN HìNH · ·BÍ NGÒI · · NUÖC CÖT ME, HÃC Xi DÁU · Onl"}],"speech":[{"time":11.8,"text":"Bạch thái chay, món thanh nhẹ, vị cực kỳ lôi cuốn"},{"time":40.0,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":44.0,"text":"Và anh Nghị thân mến, hôm nay Thanh Phương thấy là món ăn rất là đầy đủ và nhiều màu sắc và lại có nhiều rau củ quả nữa"},{"time":49.6,"text":"Hôm nay quý vị sẽ hướng dẫn Thanh Phương cùng các bạn khán giả thực hiện món bạch thái chay nha"},{"time":55.0,"text":"Bạch thái là một món ăn rất là đặc trưng của người Thái Lan"},{"time":57.5,"text":"Và cái vị đó là chua chua, cay cay, không lẫn vào đâu được"},{"time":60.5,"text":"Chắc chắn món ăn ngày hôm nay rất là kích thích cẩu vị luôn"},{"time":62.8,"text":"Bây giờ chúng ta sẽ cùng sơ chế đậu khung nè"},{"time":65.6,"text":"Các bạn sẽ cắt lá có độ dài khoảng 0,5cm như thế này"},{"time":69.5,"text":"Với những món chay thì không thể nào thiếu được đậu hủ"},{"time":72.4,"text":"Bởi vì nó cung cấp lượng chất đạm cần thiết cho cơ thể của chúng ta"},{"time":75.7,"text":"Bây giờ các bạn sẽ cắt thành sợ"},{"time":79.4,"text":"Sau khi cắt sợ đậu hủ, bây giờ chúng ta sẽ chiên ngập vào"},{"time":84.8,"text":"Bạch thái chay thì chúng ta sử dụng bí ngoài nè"},{"time":87.2,"text":"Anh Phương giúp người cắt sợ luôn nè"},{"time":88.7,"text":"Ở chung cũng thế, cắt sợ"},{"time":90.3,"text":"Và chằn tay thì các bạn sẽ cắt lát mỏng, xéo"},{"time":95.4,"text":"Biến ngòi rất là tốt cho sức khỏe thưa quý vị"},{"time":97.6,"text":"Ở trong biến ngòi thì có nhiều chất sơ nè"},{"time":100.4,"text":"Và ca ly nữa"},{"time":101.5,"text":"Sẽ giúp lưu thông máu được tốt hơn"},{"time":119.3,"text":"Hem chay thì các bạn cũng sẽ cắt sợ nha"},{"time":126.6,"text":"Bây giờ chúng ta sẽ đi chiên những cái sợ đậu khung"},{"time":133.2,"text":"Sau khi các sợ đậu hủ nó giòn rồi"},{"time":135.7,"text":"Thì chúng ta sẽ vớt ra nè"},{"time":137.0,"text":"Để ráo vào"},{"time":138.6,"text":"Wow, trông vàng giòn rất là ngon luôn"},{"time":141.3,"text":"Bây giờ chúng ta sẽ qua công đoạn pha nước sốt xào cho bạc thái chai nha"},{"time":145.4,"text":"Các bạn sẽ cho vào đây 5 muỗng canh nước tương phú sỉ"},{"time":150.7,"text":"1 muỗng canh dầu hào"},{"time":152.7,"text":"1 muỗng canh tương ớt"},{"time":154.0,"text":"1 muỗng canh tương cà chua"},{"time":156.1,"text":"3 muỗng canh nước cốc me"},{"time":159.4,"text":"1 muỗng canh đường cát"},{"time":161.5,"text":"1 muỗng cà phê hạt nem Azi ngon nắm"},{"time":164.0,"text":"Và cuối cùng là 1 muỗng cà phê ớt hiểm băm"},{"time":166.6,"text":"Khoái đều cái hỗn hợp sốt này lên"},{"time":168.3,"text":"Chúng ta đang pha sốt xào trước để khi xào các nguyên liệu nó dễ hòa quyện và thấm đều hơn nha"},{"time":173.1,"text":"Thanh Phương giúp quý vị chuẩn bị 1 cái chảo chống dính để xào bạch thái chay"},{"time":178.5,"text":"Các bạn sẽ cho vào đây 2 muỗng canh dầu ăn"},{"time":181.6,"text":"Sau khi dầu ăn đã nóng các bạn sẽ cho vào đây 1 muỗng canh hành bò rô băm"},{"time":185.0,"text":"Phi thơm hành bò rô nè"},{"time":187.5,"text":"Hành bò rô dạy mùi thơm thì các bạn sẽ cho các loại rau cũ như là ớt chung, cần tai và bí ngoài vào"},{"time":194.7,"text":"Tiếp tục đảo đều"},{"time":197.7,"text":"Tiếp đến các bạn sẽ cho hem chay vào nè"},{"time":200.6,"text":"Khi rau cũ vừa chiến đều các bạn sẽ cho giá đổ và đậu khuôn chiên vào"},{"time":205.3,"text":"Các bạn sẽ nêm vào đây nửa lượng nước sốt mà chúng ta đã pha"},{"time":209.4,"text":"Vậy lên mùi thơm rất là đặc trưng của món bạc thái các bạn ơi"},{"time":213.0,"text":"Tắt lửa"},{"time":214.2,"text":"Cho ra đĩa"},{"time":224.0,"text":"Cho vào đây khoảng một muỗng cà phê hát xì dào nè"},{"time":227.1,"text":"Mình dùng đũa trộn đều đây nè"},{"time":229.1,"text":"Các bạn làm nóng chảo"},{"time":230.3,"text":"Cho vào đây hai muỗng canh dầu ăn"},{"time":232.6,"text":"Khi dầu ăn đã nóng các bạn sẽ cho vào đây một muỗng canh hành bò rô cắt lắc xéo nè"},{"time":236.3,"text":"Tiếp theo các bạn sẽ cho sợi phở vào áp chảo"},{"time":239.8,"text":"Các bạn nên dùng phở khô để sợi phở nó có độ dai và tơ hơn"},{"time":244.3,"text":"Sợi phở bắt đầu nó mềm ra"},{"time":245.4,"text":"Cho nửa chén sốt còn lại vào nè"},{"time":249.0,"text":"Cho hỗn hợp rau củ đã xào vào nè"},{"time":250.8,"text":"Rồi bây giờ chúng ta sẽ đảo đều"},{"time":252.6,"text":"Chứ bây giờ là đã xong, bây giờ chúng ta trình bài ra đĩa thưởng thức tới nào"},{"time":256.1,"text":"Hãy quét mã QR để xem lại công thức của món ăn này nha"},{"time":261.2,"text":"Rồi bây giờ Quốc Nghệ sẽ trình bài ra đĩa"},{"time":264.1,"text":"Một món chay thơm nước mũi và cực kỳ kích thích khẩu vị luôn ạ"},{"time":268.9,"text":"Và bạc thái thì không thể thiếu đậu phộng ra nha"},{"time":271.6,"text":"Hấp dẫn quá Thanh Vương à"},{"time":276.0,"text":"Và một ít lá rau quế"},{"time":277.4,"text":"Thật sự không thể tưởng tượng được một món chay mà nó hấp dẫn vô cùng như thế này"},{"time":281.4,"text":"Quý vị đề xuất các bạn ăn cây món này cùng với món nộm gà chay hoa chuối cho bữa ăn thêm tròn vị nha"},{"time":288.0,"text":"Rau củ xào tươi ngon, giòn ngọt kết hợp với sợi bánh phở mềm, thơm mùi nước tương"},{"time":293.3,"text":"Cuốn hút bởi vị cay cay, chua ngọt bùi, thơm thích thú"},{"time":298.9,"text":"Bạc thái chai phù hợp cả bữa trưa và bữa tối"},{"time":301.8,"text":"Sẽ thật tuyệt vời hơn khi chúng ta quay quần thưởng thức món ăn này"},{"time":304.8,"text":"Cùng với những người thân yêu trong gia đình"},{"time":306.3,"text":"Và quý vị có thể xem lại công thức của món ăn ngon"},{"time":308.8,"text":"Qua kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":312.2,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại"}]}