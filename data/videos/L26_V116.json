Một muỗng rưỡi canh đường"},{"time":74.1,"text":"Nửa muỗng canh hạt nêm Aji ngon heo"},{"time":76.4,"text":"Hai muỗng canh nước mắm"},{"time":78.9,"text":"Một muỗng canh hành tím và tỏi băm"},{"time":81.0,"text":"Nửa muỗng cà phê muối"},{"time":82.2,"text":"Một phần ba muỗng cà phê tiêu"},{"time":84.3,"text":"Và bây giờ trong khi mà chúng ta đợi"},{"time":86.7,"text":"Cái phần sườn được thấm gia vị"},{"time":88.1,"text":"Thì bây giờ tiếp tục chúng ta sơ chế đến phần rau củ"},{"time":90.7,"text":"Và đây cũng là một con lưu ý cho quý vị khán giả"},{"time":92.8,"text":"Chúng ta sẽ chọn phần dưa cải"},{"time":94.8,"text":"Cộng nhiều để phù hợp với món ăn hơn"},{"time":97.0,"text":"Phần dưa cải này chúng ta sẽ cắt khúc vừa ăn"},{"time":99.3,"text":"Để chúng ta cho vào kho"},{"time":106.1,"text":"Còn phần cà chua thì chúng ta sẽ"},{"time":107.9,"text":"Hương sẽ cắt khúi cao vừa ăn."},{"time":112.1,"text":"Phần ớt hiểm thì chúng ta sẽ đập chặt."},{"time":117.9,"text":"Còn phần ớt sừng thì bây giờ chúng ta sẽ cắt xéo nhưng mà chúng ta sẽ cắt có độ dày chút."},{"time":127.8,"text":"Cuối cùng thì phần hành ngò thì chúng ta sẽ cắt khúc vừa ăn để chúng ta làm rau nêm."},{"time":134.1,"text":"Như vậy thì phần rau củ của chúng ta đã sơ chế xong."},{"time":137.0,"text":"Tiếp tục Hương sẽ kho sừng non."},{"time":138.7,"text":"Cho vào đây khoảng 2 muỗng canh dầu ăn để chúng ta thắng caramel."},{"time":142.6,"text":"Hương sẽ cho vào đây 1 muỗng canh đường."},{"time":144.9,"text":"Phần caramel cũng đã được rồi."},{"time":146.5,"text":"Hương sẽ cho vào đây tỏi và hành tím băm để chúng ta phi thơm."},{"time":151.7,"text":"Tiếp tục Phước Hương sẽ cho hết cái phần sườn non"},{"time":154.0,"text":"Và chúng ta đã ướp vào"},{"time":156.0,"text":"Chúng ta sẽ xào đều lên"},{"time":158.5,"text":"Đây là cái giai đoạn quyết định"},{"time":160.4,"text":"Cho cái món sườn của chúng ta có cái màu đẹp hay không"},{"time":162.6,"text":"Đúng không nè"},{"time":166.7,"text":"Phước Hương sẽ cho phần dưa cải chua vào"},{"time":170.8,"text":"Cho vào đây ớt hiểm đập dập nè"},{"time":173.2,"text":"Bây giờ thì phần sườn cũng như là dưa cải thấm vị rồi"},{"time":175.9,"text":"Phước Hương sẽ cho vào đây một trái dừa tươi"},{"time":178.2,"text":"Kho sườn với nước dừa để tăng thêm vị ngọt và thơm ngon cho món ăn"},{"time":181.8,"text":"Cho thêm phần nước lạnh"},{"time":183.4,"text":"Để cho xăm sắp cái phần sườn non và dưa cải chua"},{"time":186.6,"text":"Tiếp tục Phước Hưng sẽ cho phần trứng cút mà chúng ta đã luộc chín lột vỏ sẵn rồi"},{"time":191.1,"text":"Đem vào đây là 1 muỗng rưỡi cà phê hạt nêm Aji ngon heo"},{"time":194.9,"text":"Sẽ đẩy nắp lại nè"},{"time":196.2,"text":"Và bây giờ chúng ta sẽ kho với lửa vừa"},{"time":198.6,"text":"Đối với món kho ngày hôm nay thì chúng ta sẽ kho đẩy nắp kho với lửa nhỏ"},{"time":202.4,"text":"Giúp cho sườn chín mềm trong quá trình kho"},{"time":204.9,"text":"Phước Hưng có biết không trong trứng cút thì có rất là nhiều vitamin nhóm B"},{"time":208.6,"text":"Và người ta xác định là cái lượng vitamin nhóm B trong trứng cút còn nhiều hơn cả trứng gà nữa"},{"time":214.2,"text":"Và đối với vitamin nhóm B đặc biệt là B2 thì sẽ giúp cho cơ thể trong quá trình phát triển"},{"time":221.2,"text":"Đặc biệt là trong giai đoạn lứa tuổi dậy thì"},{"time":225.1,"text":"Tiếp theo Phước Hưng sẽ cho phần cà chua vào để chúng ta tiếp tục kho"},{"time":229.2,"text":"Cho phần ớt sừng chúng ta cắt lát vào nè"},{"time":231.9,"text":"Kho tiếp tục khoảng 2 đến 3 phút nữa là được rồi"},{"time":234.8,"text":"Và các bạn ơi có thể thấy là nguyên liệu sườn non"},{"time":237.6,"text":"Rất là dễ mua và dễ tìm đúng không"},{"time":239.6,"text":"Nhưng mà một loại thực phẩm rất là dọc protein và cali"},{"time":242.6,"text":"Hương sẽ cho vào đây một ít hành và ngò"},{"time":244.8,"text":"Để xem lại nguyên liệu cũng như cách nấu của món ăn này"},{"time":247.6,"text":"Thì chúng ta có thể dùng điện thoại di động"},{"time":249.0,"text":"Quẹt mã QR đang hiển thị trên màn hình nha"},{"time":253.5,"text":"Bây giờ chúng ta sẽ múc món kho ra"},{"time":255.5,"text":"Cái phần nước sốt kho giữ nguyên được cái màu nâu nâu caramel"},{"time":259.9,"text":"Trông rất là hấp dẫn Phương Hân ha"},{"time":261.6,"text":"Đúng rồi"},{"time":262.1,"text":"Cho thêm một ít hành ngò lên trên"},{"time":267.5,"text":"Và bây giờ món sườn kho dưa cải của chúng ta đã hoàn tất rồi"},{"time":270.7,"text":"Và để tạo nên một bữa ăn này dinh dưỡng"},{"time":272.6,"text":"Thì chúng ta có thể kết hợp với món gà xào măng tay sẽ rất là tuyệt vời"},{"time":277.1,"text":"Sườn non chín mềm, tương mỡ, chua cay, ngọt mặn, đậm đà"},{"time":280.9,"text":"Dưa cải giòn giòn, thấm vị nước kho nóng hổi"},{"time":284.1,"text":"Ăn cùng cơm thì trời mưa nào cũng ấm áp vô cùng"},{"time":289.2,"text":"Với những nguyên liệu dễ tìm, cách chế biến thì lại dễ làm"},{"time":292.1,"text":"Sườn non kho dưa cải hứa hẹn sẽ là một món ngon cho những bữa cơm tối của các bạn"},{"time":296.5,"text":"Và chúng ta cũng có thể xem lại công thức và nhiều món ngon hơn nữa"},{"time":299.4,"text":"Của chương trình Món Ngon Mỗi Ngày"},{"time":300.8,"text":"Bằng cách truy cập vào kênh Youtube, website và fanpage của chương trình"},{"time":304.7,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}