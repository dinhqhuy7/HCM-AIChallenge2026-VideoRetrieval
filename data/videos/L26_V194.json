huơng trình thuc · · MÄNG TÂY XANH TO · ·CÁ NGÙ NGÂM DÃU · · NUÓC CÓT CHANH · · TÒI BÄM NHUYËN · THÀNH PHÓ HO CHÍMINH · ·ÖT SÜNG BÄM · ·NGÒ RÍ BĂM · DÀI TRUYÊN HìNH · Onl"}],"speech":[{"time":31.0,"text":"Mình chào quý vị khán giả đang xem chương trình Món ngon mỗi ngày"},{"time":34.1,"text":"Nấu chuẩn, ăn lành"},{"time":35.6,"text":"Chương trình được tài trợ bởi công ty Ajiro Moto Việt Nam"},{"time":40.0,"text":"Và thưa các bạn, món ăn ngày hôm nay của chúng ta"},{"time":42.3,"text":"Nguyên liệu chính là măng tay xanh"},{"time":45.2,"text":"Thêm dị xanh nữa mới đủ em"},{"time":46.8,"text":"Và trong măng tay có chứa nhiều vitamin K"},{"time":49.2,"text":"Rất là tốt cho sức khỏe"},{"time":51.1,"text":"Đồng thời là tốt cho tim mạch đó anh Dũng"},{"time":53.2,"text":"Mà anh thấy măng tay xanh này có rất là nhiều sơn"},{"time":55.9,"text":"Vậy thì mình sẽ cắt cái phần mà bị già nhiều sơ đi"},{"time":58.9,"text":"Đúng vậy"},{"time":59.5,"text":"Mình để như vầy ha"},{"time":60.7,"text":"Phong phương nửa đó em bào như vầy"},{"time":62.0,"text":"Đó mình vừa bào vừa xoay"},{"time":63.8,"text":"Mà nhớ dùng bằng bào này cho nó dễ nha các bạn"},{"time":65.8,"text":"Và thưa các bạn đối với món này"},{"time":67.7,"text":"Thì chúng ta nên chọn mua cái măng tay có cái cọng to"},{"time":72.2,"text":"Thì làm đỡ vất vả hơn"},{"time":73.9,"text":"Mà ăn sẽ ngon hơn"},{"time":74.9,"text":"Trong khi chờ đợi cho Kim Thảo sơ chế hết cái phần măng tay xanh"},{"time":79.3,"text":"Bây giờ chúng ta sẽ pha cái hổng hộp"},{"time":81.5,"text":"Để chúng ta tẩm vô chúng ta chiên giòn"},{"time":83.2,"text":"Đầu tiên thì chúng ta cần một gói gia vị nêm sẵn"},{"time":86.6,"text":"Ajiwit bột chiên giòn"},{"time":88.2,"text":"Hôm nay chúng ta thay nước lạnh bằng bia đen 150ml luôn"},{"time":93.5,"text":"Thưa các bạn chúng ta dùng bia đen thay cho nước lọc"},{"time":96.1,"text":"Để tạo mùi thơm nồng và mới lạ trong món ăn ngày hôm nay"},{"time":99.2,"text":"Măng tây xanh cắt bỏ 1 phần 3 từ dưới góc lên"},{"time":102.5,"text":"Măng tây xanh chúng ta đã sơ chế xong"},{"time":104.2,"text":"Bây giờ chúng ta phần pha nước sốt nha"},{"time":106.0,"text":"Chúng ta cho vào trong máy sinh sinh tố"},{"time":108.4,"text":"Một muỗng cà phê tổ băm"},{"time":109.8,"text":"Một muỗng cà phê nước cốt chanh"},{"time":111.7,"text":"1 muỗng canh giám gạo lên men Ajinomoto"},{"time":114.5,"text":"2 muỗng canh nước mắm"},{"time":116.3,"text":"1 muỗng canh đường"},{"time":118.7,"text":"Và cá ngừ hộp trút ra"},{"time":120.3,"text":"Nhớ giữ lại cái dầu ngâm trong nước cá ngừ nha"},{"time":123.1,"text":"Chúng ta cho 2 phần 3 vô"},{"time":125.5,"text":"Chúng ta đậy nắp xay"},{"time":132.7,"text":"Chuẩn bị 50ml dầu salat"},{"time":135.1,"text":"Dầu salat tức là cái dầu này không bị đông khi ở nhiệt độ thấp nha các bạn"},{"time":138.3,"text":"Và cái dầu ngâm cá ngừ hòa cùng với nhau"},{"time":140.9,"text":"Và chúng ta vừa xay vừa cho từ từ dầu này vào"},{"time":145.8,"text":"Thưa các bạn, chúng ta vừa xay vừa cho từ từ dầu vào để tạo độ sánh sệt cho nước sốt"},{"time":150.6,"text":"Bây giờ cuối cùng sẽ cho ớt băm, ngò rí băm"},{"time":154.4,"text":"Cái này chúng ta trộn đều thôi"},{"time":156.9,"text":"Đó, xong như vậy xong"},{"time":158.5,"text":"Chút nước sốt ra, nước sốt rớt và sệt luôn nha"},{"time":161.6,"text":"Và phần cá ngư gần lại chúng ta tán cho nhuyễn như vầy"},{"time":164.5,"text":"Cho vô chúng ta trộn sau cùng"},{"time":166.3,"text":"Thưởng thức cảm nhận được miếng cá ngư nha"},{"time":169.2,"text":"Dạ, cá ngư đóng hộp thì có rất là nhiều acid béo omega 3"},{"time":173.5,"text":"Và như chúng ta biết thì Omega 3 rất là tốt cho tim mạch, cho mắt và cho bỏ não nữa"},{"time":180.3,"text":"Đúng rồi, bỏ não nữa"},{"time":181.6,"text":"Bây giờ chúng ta sẽ tiến hành chiên những cọng măng tay xanh này thôi các bạn nha"},{"time":185.4,"text":"Măng tay xanh cho vào trong thốt"},{"time":188.5,"text":"Rảy bột mì lên"},{"time":189.5,"text":"Các bạn lưu ý điều này nha"},{"time":191.0,"text":"Chúng ta tẩm măng tay qua bột mì, sau đó tẩm qua bột ướt"},{"time":194.0,"text":"Như vậy măng sẽ bám bột hơn"},{"time":195.7,"text":"Và thưa các bạn chúng ta để dầu nóng vừa thôi"},{"time":198.3,"text":"Và chúng ta cho măng tay xanh vô, tẩm vô từng cây, từng cây như vậy"},{"time":201.6,"text":"Ta dựng nướng cái măng tay xanh như vậy ha"},{"time":203.2,"text":"Gạt qua đây xíu"},{"time":204.7,"text":"Thả vô chiên"},{"time":206.7,"text":"Đó, làm tương cộng tương cộng như vầy"},{"time":208.6,"text":"Nhớ cho bột vừa xuống rồi gạt qua cái như vầy"},{"time":211.2,"text":"Bỏ xuống"},{"time":212.7,"text":"Rồi, em lo em gắp những cái nào"},{"time":214.8,"text":"Nó vừa vàng nó chín ra"},{"time":216.5,"text":"Rách ra, đó là vừa chín rồi"},{"time":218.6,"text":"Để ở đây thấm ở đây liền"},{"time":220.2,"text":"Thấy giấy thấm dầu nha"},{"time":222.5,"text":"Nhìn như là những con cá kẹo"},{"time":224.9,"text":"Rồi, nhìn giống như cá kẹo"},{"time":229.7,"text":"Đó, mấy cái vàng vàng em gắp ra ha"},{"time":231.5,"text":"Nhanh chóng và cực kỳ đơn giản đúng không ạ"},{"time":233.6,"text":"Chúng ta đã hoàn thành xong món ăn của ngày hôm nay"},{"time":235.6,"text":"Đó là măng tay, chiên bia, sốt cá ngừ"},{"time":238.8,"text":"Nghe tên thôi là đã thấy hấp dẫn rồi"},{"time":241.1,"text":"Và để xem lại chi tiết của công thức món ăn ngày hôm nay"},{"time":244.1,"text":"Quý vị và các bạn cũng có thể quét bả QR trên màn hình của chúng tôi nhé"},{"time":250.2,"text":"Rồi bây giờ chúng ta sẽ cho những cộng măng tay xanh ra dĩa"},{"time":253.8,"text":"Đó để tương nhiên thôi"},{"time":255.0,"text":"Và một cây, anh ấy cắt ra như vậy"},{"time":258.4,"text":"Thưa bạn đây là một món khai vị nóng các bạn"},{"time":260.6,"text":"Một món ăn chơi"},{"time":261.5,"text":"Món này kết hợp cùng với món xương nướng tiêu"},{"time":263.8,"text":"Là chúng ta có ngay một bữa ăn rất là hoành tráng"},{"time":266.1,"text":"Chúng ta có một món ăn rất là ngon, hấp dẫn"},{"time":268.6,"text":"Và cũng mới lạ ngày hôm nay"},{"time":270.4,"text":"Và với món ăn này thì Kim Thảo tin chắc rằng"},{"time":272.8,"text":"Các bạn nhỏ nhà của chúng ta sẽ ăn được nhiều rau hơn"},{"time":275.6,"text":"Lớp bột màu vàng nâu"},{"time":277.4,"text":"Áo bên ngoài cộng măng tay"},{"time":278.9,"text":"Cắn vào giòn tan"},{"time":280.2,"text":"Nồng thơm mùi bia"},{"time":281.9,"text":"Bên trong ngọt ngon vị măng tay"},{"time":284.1,"text":"Chấm vào nước sốt cá ngự lạ vị"},{"time":286.3,"text":"Bèo béo, chua nhẹ, cực kỳ mê"},{"time":289.8,"text":"Một món ăn vừa ngon vừa lạ miệng"},{"time":292.1,"text":"Là chế biến nhanh trong tích tắc như thế này"},{"time":294.0,"text":"Thì các bạn phải thử liền nha"},{"time":295.5,"text":"Chúc các bạn thành công"},{"time":296.8,"text":"Và để xem lại công thức của món ăn ngày hôm nay"},{"time":299.1,"text":"Và nhiều món ăn khác nữa"},{"time":300.4,"text":"Các bạn có thể truy cập vào Youtube website fanpage"},{"time":303.3,"text":"Của chương trình Món Ngon Mỗi Ngày"}]}