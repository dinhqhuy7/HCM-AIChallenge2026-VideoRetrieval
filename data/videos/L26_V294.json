,{"time":47.9,"text":"Nếu mà Long chê cái này nhỏ"},{"time":49.6,"text":"Đây"},{"time":50.7,"text":"Một phụ bếp to đùm, đẳng cấp"},{"time":53.1,"text":"To đùm thì đúng rồi đó"},{"time":54.4,"text":"Nhưng mà đẳng cấp hay không thì phải xem lại"},{"time":56.3,"text":"Bây giờ có làm không?"},{"time":57.5,"text":"Làm chứ, không làm đâu có được"},{"time":60.8,"text":"Đậm đà, ngọt sâu"},{"time":62.5,"text":"Lẩu Xí Quách Kimchi"},{"time":82.9,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":86.7,"text":"Minh Tuấn ơi"},{"time":88.3,"text":"Lông đã chuẩn bị cho Minh Tuấn đậu hũ và kim chi"},{"time":90.5,"text":"Đây đậu hũ nha"},{"time":91.8,"text":"Cắt lông lông làm 6 miếng"},{"time":92.8,"text":"Đúng rồi"},{"time":95.4,"text":"Mình rất thích ăn lỗ một cái đậu hũ"},{"time":96.7,"text":"Đúng chính xác"},{"time":98.6,"text":"Xong"},{"time":99.0,"text":"Hành tím mình đập dập"},{"time":99.8,"text":"Ơn mình đập dập"},{"time":100.4,"text":"Đây"},{"time":104.5,"text":"Kim chi cắt khúc cho lông được rồi"},{"time":106.7,"text":"Được rồi"},{"time":107.3,"text":"Như vậy là cái phần Minh Tuấn đã xong"},{"time":109.1,"text":"Bây giờ tới lông nè"},{"time":109.7,"text":"Nước sôi á"},{"time":110.6,"text":"Bây giờ lông phải cho xương heo vào"},{"time":111.9,"text":"Mình trần sơ"},{"time":112.9,"text":"Đúng rồi"},{"time":113.6,"text":"Có người đem kim chi thì cũng phải người cho thịt heo"},{"time":116.2,"text":"Xương heo này bỏ vô chứ"},{"time":117.6,"text":"Người ta hay gọi là xương heo"},{"time":118.8,"text":"Người ta biết điều mà"},{"time":119.6,"text":"Rồi, cái phần xương heo sau khi mình trần rồi"},{"time":122.7,"text":"Thì mình sẽ vớt ra và đem rửa sơ qua nước lạnh"},{"time":124.8,"text":"Đó, đây là một cách sơ chế"},{"time":126.4,"text":"Để cho thịt heo của mình nó sạch hơn và nó bớt mùi"},{"time":128.5,"text":"Đúng rồi"},{"time":130.2,"text":"Và khi mình làm với nước dùng thì nó sẽ trong hơn nữa"},{"time":132.4,"text":"Đúng rồi"},{"time":133.9,"text":"Bộ bếp đẳng cấp có khác, chuẩn bị nồi sẵn luôn nè"},{"time":135.9,"text":"Chính xác, tất cả mọi thứ sẵn sàng chỉ còn thiếu cái nồi thôi"},{"time":137.9,"text":"Khi nồi đã nóng, chúng ta sẽ cho vào đây một xíu dầu"},{"time":141.0,"text":"Cho cái phần hành tím và ớt này vào"},{"time":143.1,"text":"Xào"},{"time":145.0,"text":"Xào sơ thôi đúng không"},{"time":146.1,"text":"Xào thơm thôi"},{"time":146.8,"text":"Cái phần ớt với lại hành nó thơm lên"},{"time":147.9,"text":"Rồi lúc này mình phải cho cái phần xương heo vào"},{"time":150.2,"text":"Phải nói là sau khi mà cho cái phần xương heo và cái thịt heo vào"},{"time":153.4,"text":"Trong xào với lại hành với ớt thì cực kỳ thơm luôn"},{"time":155.8,"text":"Đúng rồi các bạn lưu ý là công đoạn chúng ta xào xương heo với hành tím và ớt"},{"time":159.6,"text":"Để cho phần xương heo chúng ta nó thơm hơn"},{"time":161.4,"text":"Tuấn ơi chuẩn bị cho Long 1 lít rưỡi nước sôi nha"},{"time":163.7,"text":"Rồi"},{"time":164.2,"text":"Đây nước của Long đây"},{"time":165.8,"text":"Mới mới thấy có hầm xương thôi"},{"time":167.4,"text":"Cái này nấu canh cũng được đâu có gì đâu"},{"time":169.0,"text":"Cái này là nước dùng"},{"time":170.1,"text":"Và đây chính là bí quyết gia vị nêm sẵn"},{"time":172.8,"text":"Aji Quyết lẩu kimchi"},{"time":173.9,"text":"Không cho hết vào"},{"time":175.4,"text":"Mình sẽ khuấy nhẹ lên"},{"time":178.0,"text":"Cái bí quyết nó đơn giản như vậy mà tốn bao nhiêu kia bún không tìm ra"},{"time":181.0,"text":"Các bạn thân mến"},{"time":182.0,"text":"Chỉ cần xương heo"},{"time":183.9,"text":"Và một gói gia vị nêm sẵn Aji Quyết lẩu kimchi"},{"time":186.6,"text":"Là có ngay một cái lẩu kimchi"},{"time":189.0,"text":"Chuẩn vị dành cho người Việt"},{"time":190.9,"text":"Trời ơi"},{"time":192.4,"text":"Lần sau mình nói đi đỡ đem hủ kimchi qua đây được không"},{"time":194.8,"text":"Khi mà cái phần xương heo này mềm ra"},{"time":196.7,"text":"Long thích cho cái phần đậu hủ vào và sau đó tính nấm rơm"},{"time":199.5,"text":"Cái phần nấm rơm là Tún thấy là hình như là Long đã chẻ đầu nấm rơm"},{"time":203.6,"text":"Để cho nó dễ thấm gia vị hơn đúng không?"},{"time":205.2,"text":"Đúng rồi, nấu thêm 10 phút nữa cho cái vị ngọt của nấm rơm"},{"time":208.2,"text":"Rồi cái vị béo của đậu hủ nó ra tí xíu đó là xong"},{"time":210.8,"text":"Thật ra riêng Tún là Tún thích ăn lẩu nhất"},{"time":212.8,"text":"Bởi vì mình sẽ có rất nhiều những vitamin cũng như là chất sơ từ rau củ"},{"time":217.1,"text":"Rồi có kimchi nữa ăn chua chua lại ngon miệng"},{"time":219.7,"text":"Trong cái phần nước lẩu này thì mình lại có thêm protein"},{"time":222.1,"text":"Và mình còn có thêm cả collagen đến từ thịt heo nữa"},{"time":225.8,"text":"Một cái món ăn mà nó cung cấp đầy đủ tất cả dinh dưỡng luôn"},{"time":228.8,"text":"Và tinh bột đến từ bún nữa"},{"time":230.0,"text":"Nên là bây giờ mình dọn ra ăn liền đi"},{"time":231.8,"text":"Dọn ra ngay thôi"},{"time":234.3,"text":"Đầu tiên mình phải múc xương xíu quách ra nè"},{"time":238.3,"text":"Đậu hủ nữa"},{"time":239.1,"text":"Đậu hủ, thích ăn đậu hủ đúng không?"},{"time":241.4,"text":"Một cái món lẩu nó quá sức là hấp dẫn luôn các bạn ạ"},{"time":244.1,"text":"Cái bí quyết nó nằm ở chỗ là gói gia vị nêm sẵn aziquit lẩu kimchi"},{"time":248.7,"text":"Nhưng mà thật ra cũng cần có những lưu ý để mà chúng ta làm món ăn ngon hơn"},{"time":252.0,"text":"Nên tất cả các bạn chúng ta cần công thức thì ngay bây giờ hãy quét mã QR code đang hiển thị trên bàn hình để làm ngay món lẩu kim chi này tại nhà của mình nha"},{"time":259.4,"text":"Rồi bây giờ mình sẽ thêm một ít rau quế lên cho nó màu sắc nè"},{"time":263.8,"text":"Đúng"},{"time":264.8,"text":"Như vậy là món lẩu kim chi xí quách cũng đã xong rồi"},{"time":267.3,"text":"Để tạo nên một bữa ăn hoàn chỉnh thì Long khuyên khích mọi người nên ăn kèm món lẩu kim chi này với lại trà sữa hoa đậu biếc"},{"time":273.1,"text":"Cảm ơn Long rất nhiều vì đã chỉ cho Tuấn một cái công thức mà làm lẩu kim chi xí quách chuẩn vị dành cho người Việt"},{"time":280.3,"text":"Đậu hủ bùi bùi, nấm dai dai, thấm nước lẩu ngon ngọt, chua cay đậm đà, thử là mê tích"},{"time":287.5,"text":"Các bạn hãy nhanh tay thực hiện món lẩu kim chi xí quách chuẩn bị hàng đậm đà hương vị Việt"},{"time":292.9,"text":"Cách thức nấu thì cực kỳ đơn giản nhưng mà hương vị thì không thể chê vào đâu được"},{"time":297.1,"text":"Công thức luôn luôn có sẵn trên Youtube, website cũng như là fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":302.8,"text":"Các bạn hãy truy cập vào và chúng ta thực hiện ngay món ăn này tại nhà nha"},{"time":306.0,"text":"Chúc các bạn thành công"}]}