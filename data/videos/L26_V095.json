ime":43.4,"text":"Cô Hà ơi, em rất là thích nguyên liệu mít non"},{"time":46.9,"text":"Mít non thì có dinh dưỡng là manhe"},{"time":49.1,"text":"Và manhe thì sẽ giúp hấp thụ canxi tốt cho cơ thể"},{"time":52.0,"text":"Và canxi thì quý vị biết rồi đúng không ạ? Tốt cho sương"},{"time":54.9,"text":"Và món ăn ngày hôm nay của chúng ta là món sườn heo ôm mít non"},{"time":58.8,"text":"Đảm bảo một món ăn mà chắc chắn là sẽ rất ngon miệng và rất là thú vị nữa"},{"time":63.6,"text":"Dạ"},{"time":64.2,"text":"Sườn heo cho món ăn này chúng ta sẽ trộn sườn non"},{"time":67.3,"text":"Những cọng sườn mà có sụn và nó nhỏ nhỏ, nhiều thịt thì món ăn sẽ ngon ha"},{"time":71.4,"text":"Thì bây giờ đầu tiên chúng ta ướp sườn non"},{"time":73.5,"text":"Sẽ gồm có 1 muỗng canh đường"},{"time":77.4,"text":"1 muỗng cà phê muối"},{"time":79.0,"text":"1 muỗng cà phê bột ngọt Ajinomoto"},{"time":83.3,"text":"1 muỗng rưỡi cà phê hạt nêm Ajinomoto"},{"time":85.9,"text":"1 muỗng canh hành tím băm và 1 muỗng canh tỏi băm"},{"time":90.3,"text":"Một muỗng canh màu dầu điều"},{"time":93.1,"text":"Nửa muỗng cà phê bột cà ri"},{"time":95.6,"text":"Trộn đều cái phần sườn này với lại gia vị cho thấm"},{"time":100.4,"text":"Xả thì mình sẽ đạp dập cắt khúc"},{"time":102.3,"text":"Lá cà ri tước ra"},{"time":106.1,"text":"Hành tây thì em cắt muối cao"},{"time":118.0,"text":"Rau nêm trong món này thì có rau ôm và ngòi gai"},{"time":120.8,"text":"Sẽ cắt khúc một đến hai phần"},{"time":123.5,"text":"Chúng ta sẽ chọn miếng mít có kết cấu chặt chẽ"},{"time":126.9,"text":"Phần sơ và muối không tách rời là mít non ngon nha"},{"time":130.3,"text":"Mình sẽ cắt miếng cũng tương đương với lại miếng sườn"},{"time":133.2,"text":"Mình sẽ cắt khối nó ra"},{"time":134.7,"text":"Em giúp dùm cô một cái chảo lên trên bếp"},{"time":137.1,"text":"Và cô sẽ cho dầu ăn vào đây"},{"time":139.3,"text":"Mình cho khoảng chừng nửa chén dầu ăn vậy đó"},{"time":144.2,"text":"Bây giờ dầu nóng rồi cô sẽ cho cái mít vô"},{"time":146.7,"text":"Mình sẽ chiên cho xém mặt cái mít này"},{"time":150.3,"text":"Mình đâu có cần là để cho mít vàng đúng không cô?"},{"time":153.2,"text":"Ờ nó hơi xém xém hai mặt là được rồi em"},{"time":156.5,"text":"Rồi miếng này bây giờ mình bắt đầu mình vớt ra nè"},{"time":159.3,"text":"Các bạn lưu ý là chúng ta sẽ chiên sơ mít"},{"time":161.7,"text":"Giúp mít thơm và định hình sau khi kho nha"},{"time":164.1,"text":"Tiếp tục mình chắc bớt dầu trong chảo ra"},{"time":166.4,"text":"Và mình sẽ chừa lại khoảng chừng 2 muỗng canh"},{"time":169.0,"text":"Cho sả và lá cà ri vô đây"},{"time":171.0,"text":"Mình xào lên cho thơm"},{"time":172.9,"text":"Sườn non đã ướt mình sẽ cho vô đây"},{"time":175.5,"text":"Nếu như chúng ta có lá cà ri tươi thì xài"},{"time":177.9,"text":"Còn nếu không thì mình cũng có thể xài lá cà ri khô"},{"time":180.7,"text":"Cho vào đây 1 tô nước dảo dừa"},{"time":185.1,"text":"Ơt hiểm mà chỉ có đập dập thôi"},{"time":187.3,"text":"Mình sẽ đậy nắp dung lại mình ôm"},{"time":190.5,"text":"Sau đó thì mình mới cho phần mít non vô"},{"time":192.5,"text":"Với món ăn này thì chúng ta sẽ nấu sườn mềm"},{"time":195.3,"text":"Rồi mới cho mít vào kho chung để mít không bị nát"},{"time":198.1,"text":"Sau 15 phút em thấy chưa"},{"time":200.7,"text":"Đó"},{"time":201.1,"text":"Là phần sườn đã bắt đầu chín mềm rồi đó"},{"time":203.8,"text":"Bây giờ thì mình sẽ cho mít non vô kho chung luôn"},{"time":206.1,"text":"Đó"},{"time":206.8,"text":"Phần mít này mình có thể cho mình nấu thêm khoảng 15 phút nữa"},{"time":209.9,"text":"Là mít mềm và thấm vị là được rồi đó"},{"time":211.9,"text":"Dạ"},{"time":213.1,"text":"Sau khi mà mình đã kho trở cái phần mít rồi"},{"time":215.9,"text":"Mình sẽ kho tiếp em thấy nha"},{"time":216.9,"text":"Nước nó cạn sánh lại rồi"},{"time":218.5,"text":"Bây giờ cô sẽ cho thêm hành tây"},{"time":221.0,"text":"Rau nêm vào luôn hả cô?"},{"time":222.4,"text":"Đúng rồi, một ít rau nêm thôi"},{"time":223.8,"text":"Một chén nước cốt dừa"},{"time":225.7,"text":"Rồi, em giảm lửa giùm cô đi"},{"time":229.2,"text":"Với món ăn có nước cốt dừa"},{"time":230.6,"text":"Sau khi chúng ta cho vô"},{"time":231.8,"text":"Chúng ta phải để cho nó thật sôi"},{"time":233.4,"text":"Vì nước cốt dừa nếu như mình không có nấu sôi hoàn toàn"},{"time":236.5,"text":"Hay là sau khi mình nấu sôi rồi"},{"time":238.1,"text":"Mình quậy trong đó nhiều quá"},{"time":239.6,"text":"Mà mình chưa có ăn thì mình để đó sẽ bị chua"},{"time":242.2,"text":"Em tắt lửa giúp cô"},{"time":243.4,"text":"Và bây giờ chúng ta sẽ ra món nha"},{"time":245.3,"text":"Và quý vị và các bạn có thể quét mã QR"},{"time":247.5,"text":"Để chúng ta có thể nấu được món ăn này ngon giống như là chuẩn đồ bếp Thu Hà"},{"time":252.2,"text":"Bây giờ thì chúng ta sẽ ra món nha"},{"time":263.7,"text":"Thêm nước lên"},{"time":264.8,"text":"Rất là hấp dẫn luôn ạ"},{"time":267.1,"text":"Mình rắc lên trên này một ít đậu phộng rang giả bể nha"},{"time":270.4,"text":"Dạ"},{"time":271.8,"text":"Một cái đọt rau thơm"},{"time":273.6,"text":"Cái món ăn này thì chúng ta ăn kèm với lại cơm hoặc là bánh mì"},{"time":278.2,"text":"Và nếu như ta ăn cơm thì chúng ta nên dùng kèm với món gỏi mực cay"},{"time":282.2,"text":"Lâu lâu mình sẽ đổi vị"},{"time":284.0,"text":"Thay vì ăn cơm truyền thống thì chúng ta hãy thử ngay món ăn này quý vị nhé"},{"time":288.0,"text":"Sườn heo mềm mọng, vị mặn ngọt đậm đà, nít non bùi, thấm nước ôm, béo thơm, cay nhẹ"},{"time":295.1,"text":"Và chút giòn giòn của đậu phộng, ăn cùng với bún hay cơm đều hấp dẫn khó tả"},{"time":301.4,"text":"Một món lạ lạ mà quen quen với sườn non thật là tuyệt"},{"time":305.1,"text":"Hãy làm ấm căn bếp của mình với món ngon mỗi ngày nào"},{"time":308.2,"text":"Và để xem lại công thức của món ăn ngày hôm nay rất đơn giản"},{"time":311.4,"text":"Chỉ cần truy cập vào Youtube, website, fanpage của chương trình"}]}