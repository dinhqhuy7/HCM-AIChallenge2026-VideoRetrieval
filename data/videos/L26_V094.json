ale · Công ty HKFilm · Bn quyn kch bn và cu trúc · 2 cây · ·XUYÊN TIÊU · Phi hp thc hin · ·SUÖN NON · ·HAT NÊM HEO · ·BÔT NGOT · ·NÃM KIM CHÂM · ·DÂNG SÂM · ·DÁU MÀU DIÉU · chuơng trình thuc · Thc hin chương trình · · HÀNH, NGÒ · Thc hin chươ · ·NÃM DÔNG CÔ · · TÁO DÒ · DÀI TRUYÊN HìNH · THÀNH PHÓ HO CHÍMINH · ·KY TÙ · Onl"}],"speech":[{"time":32.7,"text":"Rất vui khi được gặp lại các bạn khán giả đang theo dõi chương trình"},{"time":35.5,"text":"Món ngon mỗi ngày, nấu chuẩn, ăn lành"},{"time":38.1,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":42.1,"text":"Anh Nghị ơi, thân vương để ý trong phần nguyên liệu ngày hôm nay"},{"time":44.8,"text":"Có rất là nhiều những nguyên liệu phải nói là ngon bổ luôn đó nha"},{"time":48.4,"text":"Đầu tiên, đặc biệt nhất đó là đẳng xăm"},{"time":51.3,"text":"Đẳng xăm được xem là một bài thuốc đồng y rất là tốt cho sức khỏe"},{"time":55.0,"text":"Tốt cho hệ tiêu hóa đường ruột"},{"time":56.7,"text":"Và giúp cho cơ thể của chúng ta khỏe mạnh hơn"},{"time":59.5,"text":"Ngoài ra còn có nấm kim châm, nấm đông cô, rồi còn trí tử"},{"time":63.5,"text":"Và đặc biệt một nguyên liệu rất là hấp dẫn đó là xuyên tiêu"},{"time":66.7,"text":"Cái mùi rất là thơm các bạn ạ"},{"time":68.1,"text":"Vậy chắc là anh Nghị đang định nấu món canh đúng không ạ?"},{"time":70.2,"text":"Chính xác luôn"},{"time":71.1,"text":"Thì Thanh Phương đã giới thiệu hầu hết tất cả nguyên liệu rồi"},{"time":74.0,"text":"Thì bất ngờ cũng bật mấy luôn cho các bạn"},{"time":75.6,"text":"Món ăn ngày hôm nay đó là canh sườn non xuyên tiêu"},{"time":78.6,"text":"Cực kỳ thơm ngon bổ dưỡng luôn đó nha"},{"time":81.1,"text":"Sườn non sau khi chặt miếng vừa ăn"},{"time":84.0,"text":"Ngâm phai tiết, tức là ngâm qua nước lọc khoảng 30 phút giúp cho nước canh được trong nha các bạn"},{"time":89.6,"text":"Bây giờ các bạn sẽ cho vào tô để ướp gia vị nè"},{"time":92.6,"text":"Các bạn chỉ cần ướp vào đây 1 muỗng cà phê hạt nem Azi ngon heo"},{"time":95.7,"text":"Mình sẽ trộn đều cho hạt nem ngắm vào xương"},{"time":102.6,"text":"Nhiệm vụ cao cả nhờ Thanh Phương làm đó là cắt hành và ngò"},{"time":116.5,"text":"Thanh Phương giúp Quốc Ngày cắt đôi cái đẳng xăm ra"},{"time":119.9,"text":"Vậy đây"},{"time":120.5,"text":"Cảm ơn siêu phụ bếp"},{"time":123.0,"text":"Bây giờ chúng ta chuẩn bị 1 cái nồi để nấu canh"},{"time":125.0,"text":"Cho vào đây 1 muỗng canh dầu màu điều"},{"time":128.3,"text":"Một muỗng canh xuyên tiêu"},{"time":130.2,"text":"Hay gọi là hoa tiêu đó Thanh Vương"},{"time":132.4,"text":"Rồi mình phi cho nó thơm cái mùi xuyên tiêu lên"},{"time":135.2,"text":"Các bạn đang phi thơm xuyên tiêu với một ít dầu ăn"},{"time":137.8,"text":"Trước khi nấu giúp cho tăng cái mùi thơm đặc trưng của xuyên tiêu nha"},{"time":141.1,"text":"Sau khi nghe xuyên tiêu dạy mùi thơm á"},{"time":143.0,"text":"Các bạn sẽ cho sườn vào nè"},{"time":147.0,"text":"Đảo sườn nè"},{"time":153.2,"text":"Rồi mình đảo sườn một lượt"},{"time":154.5,"text":"Cho vào đây 1,5 lít nước"},{"time":160.8,"text":"Khi mà sườn non đã dạy lên mùi thơm"},{"time":162.9,"text":"Thì chúng ta sẽ cho vào đây 1,5 lít nước"},{"time":165.4,"text":"Các bạn sẽ đài nắp và nấu 10 phút"},{"time":168.4,"text":"Các bạn nhìn thấy có quen thuộc không ạ?"},{"time":170.1,"text":"Đây là kỵ tử, Thanh Phương rất là thích luôn"},{"time":171.9,"text":"Bởi vì nó có vị ngọt nè"},{"time":173.3,"text":"Ngoài ra nó còn chứa vitamin A, vitamin C"},{"time":175.7,"text":"Giúp đẹp da mà còn bổ máu nữa ạ"},{"time":177.9,"text":"Sau khi nấu sườn 10 phút"},{"time":179.7,"text":"Bây giờ chúng ta sẽ cho đẳng xăm kỵ tử vào"},{"time":182.1,"text":"Ninh cùng sườn nha"},{"time":183.1,"text":"Đầu tiên các bạn sẽ cho vào đây táo đỏ nè"},{"time":185.3,"text":"Theo sao táo đỏ đó là đẳng xăm"},{"time":187.8,"text":"Rất bổ dưỡng"},{"time":189.4,"text":"Và nấm đông cô"},{"time":191.9,"text":"Đài nắp"},{"time":192.6,"text":"Tiếp tục các bạn nấu canh thêm 20 phút nữa"},{"time":196.2,"text":"Như vậy là 20 phút đã trâu qua"},{"time":197.9,"text":"Bây giờ chúng ta sẽ cho nấm kim châm và kỹ tử vào"},{"time":206.3,"text":"Thế nên vào đây 1 phần 3 muỗng cà phê muối"},{"time":208.2,"text":"2 muỗng cà phê hạt nem Ajinomoto"},{"time":211.0,"text":"1 muỗng cà phê đường cát"},{"time":213.6,"text":"Cuối cùng là 1 muỗng cà phê bột ngọt Ajinomoto"},{"time":216.6,"text":"Khói đèo 1 lần nữa nè"},{"time":218.0,"text":"Vâng, có thật là 1 món canh thanh mát và bổ dưỡng"},{"time":221.1,"text":"Đúng là nấu chuẩn, ăn lành"},{"time":222.8,"text":"Bây giờ chúng ta chuẩn bị tô"},{"time":225.4,"text":"Để thưởng thức món canh sườn xuyên tiêu đặc biệt ngày hôm nay nha"},{"time":228.8,"text":"Và để xem lại công thức của món ăn này"},{"time":235.4,"text":"Bây giờ chúng ta sẽ trình bày"},{"time":237.1,"text":"Một canh ra tô để thưởng thức cùng với cơm trắng"},{"time":239.4,"text":"Trời ơi hấp dẫn quá luôn đấy ạ"},{"time":243.6,"text":"Một bát canh rất nhiều màu sắc"},{"time":245.4,"text":"Đúng không anh Thanh Phương"},{"time":247.6,"text":"Màu đen của nấm"},{"time":249.7,"text":"Đông cô"},{"time":250.9,"text":"Rồi màu đỏ của táo đỏ"},{"time":256.4,"text":"Và cuối cùng canh thì không thể thiếu"},{"time":258.6,"text":"Một ít rau nêm đó là hành lá và ngò rí"},{"time":262.0,"text":"Đây quý vị sẽ cho lại nè"},{"time":264.6,"text":"Cuối cùng là màu cộng ngò"},{"time":266.1,"text":"Điếm xuyết thêm một tí hành lá và ngò rí nữa"},{"time":268.3,"text":"Sẽ làm cho tô canh của chúng ta thêm phần hấp dẫn"},{"time":270.4,"text":"Và anh Nghị ơi, món này chắc mình ăn kèm món xào là sẽ hấp dẫn lắm đúng không ạ?"},{"time":274.3,"text":"Chính xác đó Thanh Phương"},{"time":275.1,"text":"Và của ngày đề xuất các bạn nên ăn kèm với món canh sườn non xuyên tiêu này là món hào xào bông cải"},{"time":280.6,"text":"Cho bữa cơm thêm tròn vị các bạn nha"},{"time":282.7,"text":"Nước canh trong điểm suyết màu cam, đỏ của kỷ tử và táo"},{"time":286.6,"text":"Hương xuyên tiêu thơm nồng và vị ngọt của đắng xăm"},{"time":289.4,"text":"Thấm trọn trong từng thớ thịt sườn sanh chắc, thật ấm lòng"},{"time":294.4,"text":"Canh sườn non xuyên tiêu rất thích hợp để thưởng thức vào những ngày đông hay trời mưa say lạnh"},{"time":299.3,"text":"Các bạn hãy thử ngay nhé"},{"time":300.7,"text":"Và để xem lại công thức của món ăn này"},{"time":302.4,"text":"Các bạn có thể truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":306.8,"text":"Còn bây giờ xin được mến chào tạm biệt và hẹn gặp lại"}]}