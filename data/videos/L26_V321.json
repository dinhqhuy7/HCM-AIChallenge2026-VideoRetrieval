text":"maingay"},{"time":204.4,"until":207.2,"text":"nline"},{"time":209.8,"until":212.7,"text":"moingay"},{"time":212.9,"until":215.3,"text":"Chep chep · Chapchep"},{"time":215.5,"until":217.2,"text":"Blendy · AJINOMOTO · mingày · CHIEN GION · MON"},{"time":218.6,"until":221.5,"text":"máingay · msingày"},{"time":221.7,"until":223.7,"text":"AJINOMOTO · Blendy · CHIEN GION · mőingày · MON"},{"time":230.0,"until":232.6,"text":"Ngon mê ly!"},{"time":233.2,"until":235.3,"text":"Blendy · AJINOMOTO · CHIENGION · móingày · MON"},{"time":235.5,"until":237.3,"text":"mingày · MON"},{"time":241.0,"until":243.6,"text":"line"},{"time":248.2,"until":249.9,"text":"Mine"},{"time":253.2,"until":256.3,"text":"Xinh quá! · Xinn"},{"time":257.3,"until":264.0,"text":"AJINOMOTO · Eat Well, Live Well. · mingày · COMTÍM · GÀ KHÍA · CÓI DIÊP · VOI · DÀY DÙ DINH DUONG · SÚP · RAUCÚ · BÜA ÄN"},{"time":264.4,"until":267.3,"text":"vànguam"},{"time":270.0,"until":279.7,"text":"Tha · Chua béo · Thanh ngot · Bùi bùi · Büip."},{"time":279.9,"until":287.3,"text":"nline · AJINOMOTO · MOTO · mingày · Eat Well, Live Well · Eat Well, Liy · AJINO · Eat Well · III"},{"time":287.7,"until":289.8,"text":"AJINOMOTO · Eat Well, Live Well. · MON · moingày"},{"time":291.0,"until":295.0,"text":"Youtube · Website · Fanpage Facebook · XEMKY · wwwmonngonmoing · Món Ngon Mi Ngày · moingay · CÁC BUÓC NÁU ÀN: · CÁC BUOC NÃ"},{"time":296.0,"until":306.0,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Thc hi · Công ty HKFilm · Giò sóng: 150g · Trúng cút: 12 trúng · Báp My hat: 50g · Xôt Mayonnaise Aji-mayo · Lòng tráng trung gà: 1 cái · Gia vi nêm sån Aji-Quick · Phi hp thc hin · Tht nc dǎm xay: 50g · Vò chanh giy mài: 1m · Bt Tm Khò Chiên Giòn · Thc hin chương trình · Công ty A · Cong ngò ri bàm: 1M · Tôm hp đông lnh: 100g · chuơng trình thuc · Cà rót bàm nhò: 30g · DAI TRUYÊN HINH TP. HCM · Cōng ty C"}],"speech":[{"time":15.1,"text":"Trời ơi, ngó xuống mà coi"},{"time":18.7,"text":"Đường đường là một đầu bếp đỉnh cao của món ngon mỗi ngày"},{"time":23.1,"text":"Mà ăn trứng cút chấm muối"},{"time":24.9,"text":"Thì tại cô chờ tứng lâu quá"},{"time":26.7,"text":"Tứng tối thì cô ngồi cô ăn bớt trứng cút chứ sao"},{"time":29.1,"text":"À cô nghĩ là cô lấy trứng cút này để làm món gì đó khác"},{"time":31.6,"text":"Đúng rồi, tới lâu quá là hết trứng cút luôn á"},{"time":33.9,"text":"Nhưng mà cô làm trứng cút với lại cái gì cô?"},{"time":35.8,"text":"Mình sẽ làm một món chiên"},{"time":37.0,"text":"Có cái gì đó đặc biệt trong đây"},{"time":38.2,"text":"Ừ, vô bếp đi rồi biết liền"},{"time":42.2,"text":"Giá giòn, lạ miệng với tôm thịt bọc trứng cút"},{"time":61.5,"text":"Chào mừng các bạn đang đến với chương trình Món Ngon Mỗi Ngày"},{"time":64.2,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":68.3,"text":"Đầu tiên thì mình sẽ trộn các nguyên liệu lại với nhau"},{"time":71.3,"text":"Thứ nhất là thịt băm"},{"time":72.9,"text":"Cô sử dụng là tôm hấp đông lạnh lau cho khô"},{"time":76.2,"text":"Sau đó thì cô sẽ cắt nhỏ ra như thế này"},{"time":78.5,"text":"Chúng ta sẽ nêm vào đây là 1 muỗng canh gia vị nêm sẵn"},{"time":82.9,"text":"Aji quyết bột tẩm khô chiên giòn"},{"time":84.4,"text":"Như vậy thì phần tôm và thịt có gia vị vừa ăn"},{"time":87.0,"text":"Các bạn lưu ý là chúng ta sẽ nêm 1 ít gia vị nêm sẵn Aji quyết bột"},{"time":91.4,"text":"Một tẩm khô chiên giòn vào nhân để tạo độ kích dính nha"},{"time":94.1,"text":"Cô cho tiếp phần giò sống vô"},{"time":96.0,"text":"Cà rốt băm, bắp mỉ"},{"time":97.2,"text":"Mình cũng băm nhỏ nhỏ ra"},{"time":98.8,"text":"Cộng ngò rí băm, chừng nửa muỗng cà phê"},{"time":101.1,"text":"Cái giỏ chanh xanh đã mài"},{"time":102.6,"text":"Mình sẽ cho vào đây một muỗng cà phê tiêu"},{"time":104.9,"text":"Trộn sơ lên trước đi đã"},{"time":106.1,"text":"Em nhìn cái hỗn hợp giò bên ngoài thôi"},{"time":108.7,"text":"Thì em nói thật là nó đã ngon rồi"},{"time":110.3,"text":"Các bạn lưu ý là chúng ta sẽ thêm một ít lòng trắng trứng"},{"time":113.3,"text":"Để phần thịt đó sau khi kiên không bị khô"},{"time":115.5,"text":"Đó, bây giờ mình chỉ cần trộn đều thôi"},{"time":117.5,"text":"Các bạn lưu ý là chúng ta sẽ giữ hỗn hợp thịt này trong tủ lạnh giúp tạo hình dễ dàng hơn nha"},{"time":122.5,"text":"Bây giờ thì chúng ta sẽ pha sốt để ăn kèm"},{"time":125.0,"text":"2 muỗng canh sốt mayonnaise ajimayo"},{"time":130.7,"text":"Cùng với lại 1 muỗng canh tương ớt"},{"time":132.7,"text":"Nửa muỗng cà phê vỏ chanh mài nữa"},{"time":136.2,"text":"Rồi, phần sốt của mình xong rồi đó"},{"time":138.3,"text":"Và bây giờ em giúp cô mình lấy cái phần thịt ra để mình tạo hình"},{"time":142.6,"text":"Bây giờ thì mình sẽ tạo hình"},{"time":144.1,"text":"Tuấn cũng có thể giúp cô"},{"time":145.4,"text":"Lấy 1 phần thịt này"},{"time":146.8,"text":"Xong rồi mình do tròn"},{"time":148.4,"text":"Sau đó là mình sẽ ẩn dẹp xuống bọc cái trứng cút lại thôi em"},{"time":154.1,"text":"Rồi, mình kỹ vậy xong rồi mình tạo hình tròn lại thôi"},{"time":157.1,"text":"Nó cỡ như là một quả chanh"},{"time":163.5,"text":"Đó, thấy chưa"},{"time":173.3,"text":"Cô xong rồi đó, rồi cô Tuấn xong thôi"},{"time":175.7,"text":"Dạ, em cũng xong"},{"time":177.7,"text":"Rồi, mình đặt cảo dầu lên trên bếp nha"},{"time":179.8,"text":"Trong lúc chờ dầu nóng thì cô sẽ dùng gia vị nêm sẵn"},{"time":183.9,"text":"Aji quyết bột tẩm khô chiên giòn"},{"time":185.5,"text":"Chúng ta sẽ áo xung quanh những cái viên này"},{"time":188.3,"text":"Mình sẽ có một muỗng canh mình bỏ vào trong mình nêm nè"},{"time":190.9,"text":"Phân còn lại thì mình sẽ áo phủ bên ngoài"},{"time":193.4,"text":"Và bây giờ thì dầu cũng đã nóng rồi"},{"time":195.2,"text":"Bây giờ mình sẽ cho lần lượt các viên vào đây mình chiên nha"},{"time":199.8,"text":"Đừng có để dầu nóng quá nha"},{"time":201.6,"text":"Dầu nóng quá thì nó sẽ rất là nhanh"},{"time":203.9,"text":"Viên sẽ màu vàng mà nó chưa chín hết trong cô à"},{"time":209.7,"text":"Cô mình kiểm tra thử nha"},{"time":211.6,"text":"Đấy"},{"time":212.8,"text":"Vậy là được chưa cô"},{"time":213.7,"text":"Một phút nữa mình sẽ dớt ra"},{"time":215.2,"text":"Và trước khi mà dớt ra thì cô sẽ tăng lửa lên một chút xíu thôi"},{"time":218.4,"text":"Nó vàng thêm và đồng thời nó sẽ đẩy bớt cái dầu ở trong này ra"},{"time":221.5,"text":"Ừ"},{"time":221.9,"text":"Thì nó không có bị ngắm nhiều dầu"},{"time":223.7,"text":"Đây, đó"},{"time":225.4,"text":"Rồi, Túng tắt lửa giúp cô đi"},{"time":227.2,"text":"Dạ"},{"time":228.0,"text":"Rồi"},{"time":231.1,"text":"Và như vậy là chúng ta đã hoàn thành rồi đó"},{"time":233.1,"text":"Bây giờ mình chỉ cần trình bày ra là thưởng thức"},{"time":238.9,"text":"Rồi"},{"time":243.2,"text":"Đẹp quá cô ơi"},{"time":244.6,"text":"Rồi"},{"time":245.0,"text":"À, bây giờ là mình trang trí cho đẹp hơn cô ha"},{"time":247.4,"text":"Đúng rồi"},{"time":249.7,"text":"Thiếu lá nè"},{"time":250.6,"text":"Đây, có lá luôn"},{"time":252.0,"text":"Ừ, đúng rồi"},{"time":253.9,"text":"Như vậy là chúng ta đã hoàn thành món ăn này"},{"time":256.2,"text":"Và với món ăn này chúng ta kết hợp thêm món súp còi điệp rau củ và cơm tím gà khìa để có bữa ăn hoàn chỉnh nha các bạn"},{"time":264.0,"text":"Viên thịt tròn đều, vàng ươm, cắn vào bên trong, mềm, vị vừa ăn"},{"time":269.5,"text":"Có vị thanh ngọt của tôm thịt, bùi bùi của bắp, dày mùi của vỏ chanh"},{"time":274.4,"text":"Ăn kèm với phần sốt chua chua, béo béo, món ngon hết nhanh trong tích tắc"},{"time":279.5,"text":"Món ăn của ngày hôm nay có thể đốn tim bất kỳ ai ở cái phần nhìn"},{"time":283.7,"text":"Và đốn luôn cả con tim của bất kỳ ai khi mà ăn thử món ăn này"},{"time":287.4,"text":"Và công thức của những món ăn rất hấp dẫn này"},{"time":290.0,"text":"Luôn có tại Youtube, Website và Fanpage của chương trình Món Ngon Mỗi Ngày"}]}