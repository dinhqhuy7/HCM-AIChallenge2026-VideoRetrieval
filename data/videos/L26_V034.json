án và cău trúc · VI NGUYÊN BÀN · Ban quyen kich ban va cau truc · DAI TRUYEN HINH · ·NÃM MÈO · Thc hin chương trình · · SÀ, HÀNH TÂY · · NÃM DÔNG CÔ · · HAT NÊM HEO · · BÔT CÀ RI · · LÁ HÚNG QUÊ · ·DÂU PHÔNG RANG · Thc hin chươ · · THIT BÊ · chương trình thuc · · NUÓC DÃO DÙA · THÀNH PHÓ H CHÍMINH · · NUÓC CÓT DÙA"}],"speech":[{"time":62.9,"text":"Mình cái gì đó, cái món đặc sản của cái vùng đó mình phải trao lại cho chính chủ"},{"time":66.0,"text":"Nên em đem đến cho cô một miếng bê"},{"time":67.8,"text":"Đặc sản Tây Ninh luôn"},{"time":69.0,"text":"Em nhờ cô làm món gì đó mà sao động lòng người"},{"time":72.7,"text":"Với món thịt bê hôm nay thì chúng ta sẽ làm món thịt bê xào lăng"},{"time":76.6,"text":"Và theo chuyên gia dinh dưỡng tiến sĩ Đào Thị Yến Phi"},{"time":79.5,"text":"Thì món ăn này sẽ có công dụng là giúp hỗ trợ xây dựng khối cơ xương rất là tốt"},{"time":84.5,"text":"Bây giờ thì cô sẽ cắt lát thịt bê dày khoảng 2 ly"},{"time":87.5,"text":"Thịt bê thì các bạn rất là mềm, ngon, thơm, mỏng nước"},{"time":92.7,"text":"Và còn rất giàu protein"},{"time":94.1,"text":"Rất là phù hợp để cho tất cả các bạn có thể xây dựng khối cơ xương"},{"time":97.5,"text":"Ngoài ra thì còn bổ sung thêm kẻm và sắc"},{"time":99.5,"text":"Đây là những vi lượng cần thiết cho cơ thể của mình"},{"time":101.4,"text":"Chúng ta sẽ ướp gia vị vào trong thịt bê nha các bạn"},{"time":103.9,"text":"Mình sẽ cho vào đây 1 muỗng cà phê hạt nêm Aji ngon heo"},{"time":107.5,"text":"Nửa muỗng cà phê đường"},{"time":110.0,"text":"1 muỗng canh bột cà ri"},{"time":111.7,"text":"1 muỗng canh hành và tỏi băm"},{"time":114.9,"text":"1 muỗng canh sốt margina Aji Mayo"},{"time":117.2,"text":"Aji Mayo vị nguyên bản trong món ăn này thì chúng ta sử dụng sốt mayonaise Aji Mayo vị nguyên bản"},{"time":123.2,"text":"ướp và sau đó nấu nữa để tăng hương vị cho món ăn rồi bây giờ chúng ta sẽ sơ chế các cái nguyên"},{"time":129.9,"text":"liệu còn lại nấm đông cô mình sẽ cắt sợi khoảng chừng 2 ly nấm mèo cũng vậy chúng ta cũng sẽ cắt"},{"time":155.9,"text":"Hành tây thì chúng ta sẽ cắt muối cao"},{"time":158.1,"text":"Cuối cùng là lá quế thì chúng ta sẽ lấy một nửa"},{"time":165.9,"text":"Mình sẽ cắt rối"},{"time":166.9,"text":"Chúng ta đã chuẩn bị sơ chế các phần nguyên liệu xong hết rồi"},{"time":171.0,"text":"Giờ thì chúng ta sẽ bắt đầu xào thịt bê"},{"time":173.3,"text":"Bây giờ thì mình sẽ cho cái phần lá quế này vô mình chiên"},{"time":176.2,"text":"Phần lá quế này là phần lá quế mà để nguyên rồi nha"},{"time":178.8,"text":"Và mình lại lau khô nha các bạn nha"},{"time":180.8,"text":"Và lá quế mà nó chín thì nó sẽ rất là trong"},{"time":183.1,"text":"Và đẹp mắt nữa"},{"time":185.2,"text":"Rồi đó thì mình sẽ chắc bớt dầu ở trong chảo ra"},{"time":189.6,"text":"Mình sẽ cho sả vô"},{"time":191.1,"text":"Mình phi"},{"time":191.8,"text":"Cho một nửa cái phần ớt ra cắt lát"},{"time":194.7,"text":"Rồi bây giờ mình sẽ cho cái phần thịt bê đã ướp vào đây"},{"time":197.4,"text":"Các bạn lưu ý là chúng ta nên xào thịt bê với lửa to để thịt bê mềm và thấm vị nha"},{"time":202.1,"text":"Sau khi mà thịt bê đã săn rồi bây giờ chúng ta sẽ cho nấm đông cô vào"},{"time":205.4,"text":"Đảo đều và bây giờ chúng ta sẽ cho khoảng chừng 2 chén nước dảo dừa vào đây"},{"time":209.4,"text":"Chúng ta sẽ cho nước dảo dừa vào nấu trước"},{"time":212.3,"text":"Sau đó thì mới cho nước cốt dừa để nước cốt dừa không có bị vóng cụt nha"},{"time":216.3,"text":"Chúng ta sẽ nêm vào 2 muỗng cà phê hạt nêm Ajinon Hell"},{"time":219.8,"text":"Nửa muỗng cà phê đường"},{"time":221.8,"text":"Và 1 muỗng canh sốt mayonaise"},{"time":224.1,"text":"Aji mayo vị nguyên bản"},{"time":225.7,"text":"Rồi chút nó sẽ tan từ từ ra"},{"time":230.4,"text":"Tiếp theo bây giờ cô sẽ cho"},{"time":231.9,"text":"Hành tây và ớt còn lại vô nè nha"},{"time":235.2,"text":"Mộc nhỉ"},{"time":236.2,"text":"Đó là nấm mèo"},{"time":237.3,"text":"Bún tàu luôn ạ"},{"time":239.7,"text":"Tiếp tục là mình sẽ cho vô là nước cốt dừa nha"},{"time":243.5,"text":"Chúng ta đợi cho cái phần nước cốt này đều ra"},{"time":246.2,"text":"Rồi bây giờ em có thể tắt lửa"},{"time":247.8,"text":"Giúp cô được rồi đó tướng"},{"time":248.9,"text":"Bên cạnh 1 món ăn thơm lừng hấp dẫn thế này"},{"time":251.3,"text":"Là 1 mã quy đời các bạn có thể quét mã này"},{"time":259.0,"text":"Mà nãy giờ nó thơm lừng luôn nguyên cái gian bếp"},{"time":261.4,"text":"Mình rưới lên một ít nước sốt nha"},{"time":266.7,"text":"Sẽ rắc lên này là đậu phộng rang"},{"time":268.6,"text":"Cô sẽ cho lá húng quế lên đây"},{"time":272.3,"text":"Bây giờ thì"},{"time":273.8,"text":"Mình rưới đi cô"},{"time":274.6,"text":"Đúng rồi cô mời Minh Tuấn á"},{"time":276.0,"text":"Em kiềm chế từ nãy đến giờ rồi mà cô không cho em thử"},{"time":279.1,"text":"Đây"},{"time":287.6,"text":"Cái miếng thịt bê nó tứa nước ra"},{"time":291.1,"text":"Ngọt"},{"time":292.2,"text":"Thơm lừng"},{"time":293.8,"text":"Béo ngậy"},{"time":294.6,"text":"Rất là thơm mọi người ạ"},{"time":296.5,"text":"Mùi nấm là vị ngọt của thịt bê nè"},{"time":299.2,"text":"Chúng ta có một cái vị béo rất đặc trưng"},{"time":301.6,"text":"Và cái vị béo này mình cảm nhận rất đỏ luôn"},{"time":303.8,"text":"Vị béo của Mayonaise Aji Mayo"},{"time":305.8,"text":"Rất là ngon"},{"time":306.9,"text":"Và để đạt hiệu quả dinh dưỡng"},{"time":308.7,"text":"Thì ở dưới đây có một bản thực đơn"},{"time":310.9,"text":"Trong một ngày"},{"time":311.9,"text":"Trong đó chúng ta có sử dụng món ăn ngày hôm nay"},{"time":314.4,"text":"Các bạn hãy tham khảo nha"},{"time":318.8,"text":"Như là món ăn của ngày hôm nay"},{"time":320.1,"text":"Bê xào lăng các bạn hãy thực hiện ngay tại nhà nha"},{"time":322.2,"text":"Công thức sẽ luôn có trên Youtube, Website và Fanpage của chương trình"},{"time":325.7,"text":"Để mọi người có thể tham khảo"},{"time":326.6,"text":"Chúc các bạn thành công"}]}