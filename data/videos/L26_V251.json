,"until":234.8,"text":"nline · Onlime"},{"time":251.9,"until":261.4,"text":"NGON · AJINOMOTO · QUÉT MÃ QR DÊ XEM CÔNG THÚC · MON · moingày · ArQuick · BOTCHIENGION"},{"time":261.8,"until":263.6,"text":"NGON · mingày · MON · MOZ"},{"time":278.4,"until":281.9,"text":"SALAD · NGON · AJINOMOTO · mingày · Eat Well, Live Well. · DÁY DÙ DINH DUÖNG · BÍ DÓ · BÜA ÃN · VÓI"},{"time":282.1,"until":284.4,"text":"Vàng giòn · vànggi,"},{"time":287.4,"until":292.5,"text":"Beo béo · Thomtham"},{"time":293.7,"until":297.1,"text":"AJINOMOTO · NGON · Eat Well, Live Well. · mőingày"},{"time":298.1,"until":306.0,"text":"monngonmoingay.com · NGON · AJINOMOTO · moingay · Món Ngon Moi Ngày"},{"time":306.6,"until":316.5,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Thanh cua Nht 8 thanh · Tham gia thc hin · Công ty Hakuhodo Vit Nam · Bn quyn kch bn và cu trúc · Bt chiên giòn: 150g · Công ty Golden Scale · Công ty HKFilm · Chà cá basa: 300g · Dàu hành: 2M · Gia v nêm sån Aji-Quick® · Lá rong bién: 3 lá · Công ty H · Bt ngot AJI-NO-MOTO · Phi hp thc hin · Ngò rí: 1M · Thc hin chương trình · chuơng trình thuc · Thc hié · Ót sùng bǎm: 1m · DÀI TRUYÊN HìNH TP. HCM"}],"speech":[{"time":12.7,"text":"Chào Minh Phương"},{"time":13.6,"text":"Chào Phước Hưng"},{"time":14.6,"text":"Chà làm cái gì mà quá trời đồ chơi luôn"},{"time":16.6,"text":"Xin ông đố Phước Hưng nha"},{"time":18.7,"text":"Nhìn những cái vật dụng này Phước Hưng liên tưởng đến đồ ăn gì?"},{"time":23.4,"text":"Nhìn là biết ngay là sushi rồi đúng không?"},{"time":25.6,"text":"Đồ nhật đúng không?"},{"time":26.5,"text":"Đúng rồi"},{"time":26.9,"text":"Chính xác và phần thưởng sẽ dành cho Phước Hưng đó là làm sushi"},{"time":30.9,"text":"Đồng ý không?"},{"time":31.7,"text":"Đây là một cái miếng mây để làm sushi"},{"time":33.4,"text":"Nhưng mà ngày hôm nay Phước Hưng sẽ không làm sushi"},{"time":35.7,"text":"Mà sẽ biến tấu từ sushi ra một cái món chiên sẽ rất là ngon và đã lạ miệng nữa"},{"time":41.6,"text":"Hấp dẫn quá"},{"time":42.3,"text":"Vào bếp và làm ngay nha"},{"time":46.5,"text":"Ngọt vị cá, thanh vị cua"},{"time":48.5,"text":"Với cuộn rong biển chiên giòn"},{"time":65.8,"text":"Mới chào các bạn đang đến với chương trình"},{"time":67.5,"text":"Món ngon mỗi ngày"},{"time":68.5,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":72.8,"text":"Đối với món ăn ngày hôm nay"},{"time":74.0,"text":"Thì Phước Hương sẽ hướng dẫn cho quý vị"},{"time":75.5,"text":"Chúng ta sẽ ướp gia vị vào chả cá ba sa"},{"time":78.1,"text":"Thường thì chả cá ba sa chúng ta mua"},{"time":80.0,"text":"Ở ngoài thị trường thì đã có nêm gia vị rồi"},{"time":82.6,"text":"Thì chúng ta sẽ không nêm gia vị"},{"time":84.3,"text":"Quá nhiều vào đây"},{"time":85.3,"text":"Hương sẽ cho vào đây 1 muỗng cà phê bột ngọt Asinomoto"},{"time":88.4,"text":"1 muỗng cà phê tiêu"},{"time":90.1,"text":"2 muỗng canh đầu hành băm"},{"time":92.0,"text":"1 muỗng canh cọng ngò rí băm"},{"time":94.2,"text":"Và 1 ít ớt sừng băm để tạo màu sắc"},{"time":97.1,"text":"Cũng như là hương vị cho cái phần nhân"},{"time":99.5,"text":"Sẽ trộn đều cái phần nhân lên"},{"time":101.1,"text":"Đối với những món chả cá thì thông thường chúng ta sẽ cần quết"},{"time":104.0,"text":"Thời gian lâu hơn để lát nữa khi mà chế biến xong"},{"time":107.2,"text":"Cái phần chả sẽ được ngon và dai hơn"},{"time":109.4,"text":"Có đúng không Phước Hưng?"},{"time":110.2,"text":"Đúng rồi đó Minh Phương"},{"time":111.1,"text":"Chúng ta sẽ lấy 1 tờ rong biển đặt mặt láng ở bên dưới"},{"time":114.5,"text":"Cái mặt nhám lên bên trên"},{"time":115.8,"text":"Lấy phần nhân này cho vào"},{"time":117.2,"text":"Phớt phần chả cá ba sa 1 phần 2 tờ lá rong biển thôi"},{"time":123.4,"text":"Cho thanh cua vào"},{"time":124.6,"text":"Cho vào 2 thanh"},{"time":125.7,"text":"Để tương đương với chiều dài của lá rong biển luôn"},{"time":128.0,"text":"Rồi và bây giờ chúng ta sẽ cuộn chặt tay lại"},{"time":130.8,"text":"Và đây cũng là một cái lưu ý cho quý vị nha"},{"time":132.7,"text":"Chúng ta sẽ cuộn chặt tay để phần nhân"},{"time":134.7,"text":"Được kết dính với rong biển tốt hơn"},{"time":136.9,"text":"Cho qua một cái dĩa"},{"time":138.2,"text":"Tiếp tục cái thứ 2"},{"time":139.2,"text":"Cho phần thanh cua vào"},{"time":141.2,"text":"Cuộn chặt tay lại"},{"time":143.0,"text":"Lá rong biển thì rất là quen thuộc"},{"time":145.6,"text":"Đối với ẩm thực Nhật Bản, Phương rất là thích lá rong biển"},{"time":148.7,"text":"Tại vì trong lá rong biển có rất là nhiều omega 3"},{"time":151.4,"text":"Và đặc biệt rất là nhiều canxi"},{"time":153.3,"text":"Còn nhiều canxi hơn ở trong sữa nữa đó Phương"},{"time":156.4,"text":"Cho nên là không những là cho người lớn mà còn đối với trẻ nhỏ nữa"},{"time":160.8,"text":"Rất là tốt"},{"time":161.7,"text":"Thanh cua cũng là một nguyên liệu của những ẩm thực Nhật Bản nữa"},{"time":165.1,"text":"Rất là quen thuộc"},{"time":166.5,"text":"Sau khi mà các bạn cuốn xong thì chúng ta sẽ để lá rong biển được thấm mềm khoảng 10 phút"},{"time":171.2,"text":"Thì chúng ta sẽ đem nhúng bột"},{"time":172.7,"text":"Làm như vậy thì giúp cho củ rong biển sẽ định hình tốt hơn"},{"time":175.3,"text":"Chúng ta sẽ pha cái hỗn hợp nước chấm"},{"time":177.6,"text":"Cho vào đây 2 muỗng canh sốt mayonaise"},{"time":179.9,"text":"1 muỗng canh tương ớt"},{"time":182.0,"text":"Nửa muỗng cà phê cộng ngò rí băm"},{"time":184.5,"text":"Và nửa muỗng cà phê ớt sừng băm"},{"time":186.5,"text":"Và bây giờ chúng ta sẽ khuấy đều lên"},{"time":188.3,"text":"Nếu như mà ở nhà chúng ta có trẻ nhỏ"},{"time":190.4,"text":"Thì chúng ta có thể thay thế tương ớt bằng tương cà đúng không Phước Hương?"},{"time":193.2,"text":"Đúng luôn mà món sốt cũng vẫn ngon"},{"time":194.9,"text":"Tiếp tục Phước Hương sẽ hướng dẫn cho quý vị"},{"time":196.6,"text":"Chúng ta pha bột để chiên cụm rong biển"},{"time":198.6,"text":"Phước Hương sẽ sử dụng 1 phần 2 gói gia vị"},{"time":201.0,"text":"Bị nêm sẵn, ai chỉ quyết bột chiên giòn."},{"time":203.0,"text":"Cho phần nước vào theo tỷ lệ trên bao bì, sau đó khuấy đều."},{"time":206.4,"text":"Phương Hương sẽ đặt lên trên bếp một cái chảo dầu để chúng ta chiên cụm rong biển."},{"time":210.1,"text":"Bây giờ Phương Hương sẽ cắt cái cụm rong biển này ra làm ba và chúng ta nhúng vào bột chúng ta đem đi chiều."},{"time":215.2,"text":"Sẽ lấy cụm rong biển nè, năng qua bột nè, cho vào chảo."},{"time":219.2,"text":"Và món ăn này thì chúng ta sẽ chiên ngập dầu đúng không Phương Hương?"},{"time":222.2,"text":"Đúng rồi và chúng ta sẽ chiên lửa vừa để phần chả cá bên trong được chín đều hơn."},{"time":234.9,"text":"Bây giờ thì cụm rong biển cũng vừa vàng tới rồi Phước Hương sẽ tắt bếp nè"},{"time":238.6,"text":"Chúng ta sẽ lấy ra"},{"time":239.4,"text":"Ở đây Phước Hương cũng đã chuẩn bị sẵn một cái giấy thấm dầu chúng ta sẽ cho vào"},{"time":243.3,"text":"Trong cái lớp vỏ ở ngoài rất là giòn luôn Phước Hương ơi"},{"time":247.1,"text":"Vậy là bây giờ món ăn cũng đã hoàn thành rồi"},{"time":249.0,"text":"Quá là hấp dẫn luôn Phước Hương ơi"},{"time":251.0,"text":"Và trong quá trình thực hiện món ăn này nếu như chúng ta bỏ lỡ một giai đoạn nào hay một lưu ý nào đó"},{"time":255.4,"text":"Thì có thể sử dụng điện thoại để quét mã QR đang hiển thị ở màn hình đây để xem lại quý vị nhé"},{"time":263.4,"text":"Chúng ta sẽ cắt làm đôi nữa đúng không nè"},{"time":265.6,"text":"Đúng rồi"},{"time":266.0,"text":"Để khi ăn cho vừa miệng"},{"time":267.9,"text":"Chấm với sốt mayonnaise cũng sẽ dễ hơn"},{"time":269.9,"text":"Rất là hấp dẫn"},{"time":271.6,"text":"Cuối cùng Phương Hương sẽ bắt lên đây một ít sốt mayonnaise"},{"time":274.9,"text":"Món cuộn rong biển của chúng ta cũng đã xong"},{"time":277.0,"text":"Và để tạo nên một bữa ăn dinh dưỡng"},{"time":278.6,"text":"Thì chúng ta có thể kết hợp với món salad bí đỏ"},{"time":280.6,"text":"Cũng rất là tuyệt vời"},{"time":282.1,"text":"Cuốn rong biển chiên vàng giòn"},{"time":284.0,"text":"Ngọt vị cá ba sa và thanh cua"},{"time":286.2,"text":"Chấm cùng chút sốt béo béo thơm thơm"},{"time":288.8,"text":"Đến hôm sau vẫn thèm"},{"time":292.4,"text":"Hãy đón xem chương trình Món Ngon Mỗi Ngày để cập nhật nhiều công thức vừa ngon vừa nhanh gọn các bạn nhé"},{"time":297.8,"text":"Và đừng quên địa chỉ quen thuộc của chương trình đó chính là kênh youtube, website và fanpage"},{"time":302.6,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}