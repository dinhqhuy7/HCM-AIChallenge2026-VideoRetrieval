":41.3,"text":"Nguyên liệu của Hà chuẩn bị là thành"},{"time":42.7,"text":"Một bữa sáng rất là an lành đây"},{"time":45.5,"text":"Nhanh gọn lẹ"},{"time":46.3,"text":"Món ăn ngày hôm nay là pancake jambon trứng cút"},{"time":49.3,"text":"Ở đây thì chúng ta sẽ sử dụng"},{"time":51.2,"text":"Bột bánh rán pha sẵn"},{"time":52.9,"text":"Bữa sáng dinh dưỡng"},{"time":53.9,"text":"Lượng nước của một gói bột này là 105 ngâm nước"},{"time":57.3,"text":"Bây giờ bột cô khuấy xong rồi đó"},{"time":59.5,"text":"Bắt đầu đổ bánh liền luôn"},{"time":60.7,"text":"Mở lửa lên giúp cô đi Kim Thảo"},{"time":62.4,"text":"Cô sẽ hạ nhiệt cái chảo bằng cách là mình đặt lên một cái khăn ẩm"},{"time":65.4,"text":"Rồi"},{"time":65.9,"text":"Đặt chảo lên trên bếp lại"},{"time":67.8,"text":"Và chúng ta sẽ múc bột đổ vô"},{"time":69.9,"text":"Rất là đơn giản để có thể đổ được"},{"time":72.3,"text":"Một cái bánh thật là tròn"},{"time":79.4,"text":"Đẹp quá cô Hà ơi"},{"time":81.2,"text":"Rồi"},{"time":81.6,"text":"Cái bánh đầu tiên"},{"time":83.9,"text":"Mình lại tiếp tục đổ cái thứ 2"},{"time":85.6,"text":"Đúng rồi"},{"time":88.3,"text":"Cô Hà, trong lúc mà cô Hà đổ bánh thì em có thể làm phần của em"},{"time":91.7,"text":"Đó là ngò tay, bây giờ em bỏ cộng đi, em lấy phần lá thôi em băm nhuyễn ra"},{"time":95.8,"text":"Khi mà em cắt nhỏ ra em nghe mùi rất là thơm"},{"time":98.2,"text":"Đúng rồi, mùi rất là đặc trưng luôn á"},{"time":100.1,"text":"Bây giờ thì chúng ta đã đổ bánh xong rồi, giờ tiếp tục thì mình sẽ làm tới phần nhăn bánh nha"},{"time":104.0,"text":"Trên tay cô nó có một cái khuôn ấn như thế này"},{"time":106.5,"text":"Thì cô sẽ chồng hai cái lớp trăm bông lên"},{"time":109.9,"text":"Cô sẽ ấn một cái dòng tròn ở chính giữa"},{"time":111.9,"text":"Nếu mà chúng ta không có khuôn tròn để nhấn thì có thể dùng mũi dao khoét hình vuông ở trong miếng xăm bông cũng được"},{"time":117.8,"text":"Rồi cô đặt chảo lên trên bếp thảo mở lửa giúp cô nha"},{"time":120.7,"text":"Mình sẽ cho vào đây một chút dầu ăn"},{"time":122.7,"text":"Cô sẽ cho hai cái miếng xăm bông này vô cái chảo"},{"time":126.0,"text":"Đặt một quả trứng cút vào đây"},{"time":130.3,"text":"Ý dễ thương quá"},{"time":132.9,"text":"Các bạn lưu ý là chúng ta sẽ chiên trứng cút với lửa nhỏ đậy nắp cho đến khi trứng xe mặt là trứng đã chín lòng đào"},{"time":139.5,"text":"Rồi trời cái đó chín thì cô sẽ chuẩn bị tiếp cái phần còn lại luôn ha"},{"time":147.1,"text":"Trứng cút chín lòng đào luôn hả cô"},{"time":149.2,"text":"Đúng rồi"},{"time":150.0,"text":"Khi mà mình chiên trứng cút này ngoài việc dùng dầu ăn"},{"time":152.6,"text":"Thì chúng ta cũng có thể dùng dầu ăn đã phi tỏi"},{"time":155.1,"text":"Thì nó sẽ thơm hơn nha các bạn"},{"time":156.5,"text":"Dạ"},{"time":156.9,"text":"Cô ơi bây giờ em làm cái này cho cô nhé"},{"time":158.7,"text":"Đúng rồi giờ em cắt nhỏ cho cô"},{"time":161.2,"text":"Giờ cắt dọc ra thành sợi"},{"time":162.7,"text":"Sau đó xay lại cắt ngang ra được ra hạt lụng"},{"time":167.3,"text":"Trứng cút nhỏ mà có vỏ nha các bạn"},{"time":169.3,"text":"Bởi vì trong một quả trứng cút thôi"},{"time":171.3,"text":"Cũng chứa rất là nhiều vitamin B12"},{"time":174.4,"text":"Cộng với lại selen"},{"time":175.7,"text":"sẽ giúp là chuyển thức ăn thành năng lượng"},{"time":178.1,"text":"cũng như là hỗ trợ"},{"time":179.7,"text":"tuyến giáp ổn định. Bây giờ"},{"time":181.5,"text":"chúng ta sẽ pha sốt để trang trí lên bánh ha"},{"time":183.5,"text":"chúng ta sẽ cho vào đây 2 muỗng canh"},{"time":185.6,"text":"sốt mayonnaise azimayo vị nguyên bản"},{"time":187.9,"text":"cùng với lại 1 muỗng canh tương ớt"},{"time":189.7,"text":"mà nếu như trẻ em thì mình cũng có thể"},{"time":191.7,"text":"sử dụng tương cà nha"},{"time":192.8,"text":"và để cho mình trình bày"},{"time":195.5,"text":"nó đẹp thì cô sẽ cho phần sốt này"},{"time":197.5,"text":"vào trong 1 cái túi bắp bông kem"},{"time":199.7,"text":"để mình chạy lên cái bánh"},{"time":201.6,"text":"cho nó đẹp. Dạ đây"},{"time":204.9,"text":"Đây cô Hà ơi."},{"time":206.3,"text":"Một cái cô đặt lên đây."},{"time":209.3,"text":"Chúng ta sẽ phớt một lớp mayonnaise aji mayo vị nguyên bản."},{"time":213.5,"text":"Bên này cũng vậy."},{"time":215.2,"text":"Như vậy là cô sẽ tráng đều lớp mayonnaise aji mayo vị nguyên bản lên trên bề mặt của bánh pancake hả cô?"},{"time":221.5,"text":"Đúng rồi."},{"time":222.3,"text":"Bây giờ cô sẽ rắc cái chăm bông này lên."},{"time":224.5,"text":"Hãy mình như cái ruột đó."},{"time":226.1,"text":"Dạ."},{"time":226.8,"text":"Bây giờ tiếp tục thì mình sẽ đặt cái bánh thứ 2 lên."},{"time":229.9,"text":"Còn này thì kiểu một chút nha."},{"time":231.6,"text":"Cô đặt hơi nghiêng nghiêng."},{"time":232.5,"text":"Tiếp theo là cô sẽ đặt cái phần trứng lên"},{"time":236.1,"text":"Cái này mình dán thêm một miếng mayonnaise ha"},{"time":238.6,"text":"Để cho nó dính vô"},{"time":240.0,"text":"Rồi"},{"time":243.2,"text":"Sản phẩm của Kim Thảo đây"},{"time":246.7,"text":"Rắc lên đây"},{"time":247.6,"text":"Ít"},{"time":249.0,"text":"Để làm cho bánh pancake jambon của mình thơm hơn"},{"time":252.1,"text":"Có màu sắc nữa"},{"time":253.2,"text":"Mình sẽ bắt sốt mayonnaise với tương ớt lên"},{"time":255.3,"text":"Một bước rất là đơn giản"},{"time":257.2,"text":"Nhưng mà nhìn là thấy hấp dẫn hơn hẳn luôn đó cô Hà"},{"time":259.8,"text":"Rồi cảm ơn em"},{"time":261.2,"text":"Và như vậy là chúng ta đã hoàn thành món ăn này rồi"},{"time":263.9,"text":"Món ăn này thích hợp nhất là các bạn hãy sử dụng với lại trà sữa hoa đậu biếc nhé"},{"time":268.7,"text":"Ngày hôm nay có một món ăn đúng gu, nấu chuẩn, ăn lành"},{"time":272.5,"text":"Và nếu như muốn xem lại công thức của món ăn ngày hôm nay"},{"time":275.2,"text":"Quý vị và các bạn có thể quét mã QR trên màn hình nhé"},{"time":278.6,"text":"Lớp bánh xốp mềm, thơm mùi phô mai"},{"time":281.6,"text":"Ôm trọn miếng trăm bông mặn mặn, trứng cúc lòng đào tan chảy"},{"time":285.7,"text":"Thơm mùi ngò tay, béo thơm, giúp chiếc bánh thêm trọn vị khó quên"},{"time":290.7,"text":"Có ly trà sữa và có chiếc bánh xinh"},{"time":293.4,"text":"Bữa ăn sáng hoặc bữa xế thật nhanh, ngon và dễ làm"},{"time":297.0,"text":"Và để xem lại công thức của món ăn ngày hôm nay"},{"time":299.2,"text":"Có thể truy cập vào Youtube website fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":303.7,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}