e":254.7,"until":256.2,"text":"Onime"},{"time":259.6,"until":260.7,"text":"AJINOMOTO · Blend · Eat Well. Live Well. · moingày"},{"time":277.8,"until":281.7,"text":"AJINOMOTO · Eat Well. Live Well. · mingày · TÓM THIT · CÀ TÍM · XÀO · BÜA ÃN · VÓI · DÁY DÙ DINH DUÕNG · iMON"},{"time":295.3,"until":300.6,"text":"AJINOMOTO · MOTO · mingày · moingay · nay · Eat Well, Live Well. · Eat Wes, Liv · gày · moing · main · AJINOMC · OnlineNGoN · MON"},{"time":301.0,"until":308.1,"text":"monngonmoingay.com · Món Ngon Mōi Ngày · moingay · AJINOMOTO · MON"},{"time":309.1,"until":320.5,"text":"20g · 600g · 10g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Hakuhodo Vit Nam · 2 chén · Công ty Golden Scale · NGUYÊN LIÊU · Công ty HKFilm · Bn quyn kch bn và cu trúc · 1 trái · ·SUÖN NON · Phi hp thc hin · Thc hin chương trình · chuơng trình thuc · · HAT NÊM HEO · ·BÔT XÙ · ·NUÓC DÙA TUOI · ·ÖT SÜNG · THÀNH PHÓ HO CHÍMINH · · BOT TÁM KHO CHIÊN GIÒN · DÀI TRUYÊN HìNH · · LÁ LÓT · ·BÔT ÔT"}],"speech":[{"time":38.6,"text":"Rất vui được gặp lại các bạn đang đến với chương trình Món ngon mỗi ngày, nấu chuẩn, ăn lành"},{"time":43.4,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":47.6,"text":"Và bây giờ công đoạn đầu tiên cho món sườn ngày hôm nay thì Phước Hương sẽ đặt lên trên bếp một cái nồi để chúng ta luộc sơ sườn"},{"time":54.1,"text":"Hương sẽ cho vào đây 2 chén nước dừa tươi"},{"time":57.2,"text":"Hương sẽ cho sườn vào luộc"},{"time":58.9,"text":"Chúng ta sẽ luộc sơ sườn trước"},{"time":61.0,"text":"Khi chiên thì giúp cho sườn mềm, khi ăn sẽ thơm ngon hơn"},{"time":64.5,"text":"Nêm vào đây 1 muỗng cà phê hạt nêm Ajinomoto"},{"time":67.4,"text":"Và khi luộc sườn thì chúng ta cũng không quên cho sườn vào lúc nước còn lạnh đúng không?"},{"time":72.0,"text":"Đúng rồi và bây giờ chúng ta sẽ đẩy nắp luộc sườn với lửa vừa"},{"time":75.6,"text":"Trong khoảng 10 phút mà chúng ta tính từ lúc nước sôi"},{"time":78.6,"text":"Và đây là nhiệm vụ của Minh Phương"},{"time":80.5,"text":"Phần lá lốt thì bây giờ chúng ta sẽ cắt sợi nhuyễn"},{"time":84.7,"text":"Cắt thì cái tinh dầu của lá lốt tỏa ra rất là thơm luôn"},{"time":89.3,"text":"Rồi bây giờ chúng ta sẽ cho ra dĩa"},{"time":91.5,"text":"Còn phần ớt sưng thì bây giờ chúng ta sẽ cắt lát mỏng"},{"time":94.6,"text":"Minh Phương cũng cho ra dĩa luôn"},{"time":98.0,"text":"Đặt lên trên bếp một cái chảo để chúng ta rang muối"},{"time":100.9,"text":"Chảo cũng đã nóng"},{"time":102.0,"text":"Chúng ta sẽ cho vào đây là 10 gram bột sù"},{"time":105.0,"text":"Nửa muỗng cà phê muối"},{"time":106.3,"text":"Rang với lửa vừa đến khi nào mà vàng thơm là được"},{"time":109.8,"text":"Wow bây giờ thì cái phần bột sù cũng như là muối có cái độ vàng tới rồi"},{"time":114.2,"text":"Bây giờ chúng ta sẽ tắt bếp nè"},{"time":115.7,"text":"Phương cho muối với bột sù ra"},{"time":117.7,"text":"Bây giờ Phước Hưng sẽ cho vào đây một muỗng cà phê ớt bột"},{"time":120.4,"text":"Và chúng ta trộn đều lên và chúng ta đem đi xay nhiễn"},{"time":123.1,"text":"Phần sườn non cũng đã được 10 phút rồi"},{"time":125.5,"text":"Bây giờ chúng ta sẽ vớt ra"},{"time":126.6,"text":"Rất là thơm luôn"},{"time":129.7,"text":"Và bây giờ trong khi chúng ta đang đợi chảo dầu nóng"},{"time":132.4,"text":"Thì Phước Hương sẽ hướng dẫn cho các bạn"},{"time":133.9,"text":"Chúng ta sẽ lăn cái phần sườn mà mình đã luộc sơ rồi"},{"time":136.7,"text":"Phước Hương sẽ sử dụng"},{"time":138.1,"text":"Một gói gia vị nêm sẵn"},{"time":139.9,"text":"Achi quyết bột tẩm khô chiên giòn"},{"time":141.6,"text":"Lần lượt cho sườn và chúng ta sẽ áo đều"},{"time":146.5,"text":"Sườn khi mà chúng ta áo"},{"time":148.1,"text":"Một lớp mỏng gia vị nêm sẵn"},{"time":149.8,"text":"Achi quyết bột tẩm khô chiên giòn"},{"time":151.6,"text":"Khi chiên lên thì sườn thấm gia vị"},{"time":154.0,"text":"Ăn sẽ rất là ngon"},{"time":155.1,"text":"Bây giờ thì phần dầu cũng đã nóng ra"},{"time":157.3,"text":"Rồi Phước Hương sẽ chiên phần lá lốt trước"},{"time":162.4,"text":"Chúng ta sẽ chiên lá lốt trước để dầu thơm mùi lá lốt"},{"time":166.1,"text":"Thì khi chiên thịt thì món ăn sẽ thơm ngon hơn"},{"time":168.4,"text":"Quả thật, cái tinh dầu của lá lốt có một cái hương thơm rất là đặc trưng"},{"time":173.2,"text":"Và đối với lá lốt thì chúng ta có thể thấy nó có vị cay nhẹ"},{"time":177.0,"text":"Nhưng mà lại mang một cái tính ấm"},{"time":178.7,"text":"Chính vì thế mà rất tốt để chúng ta có thể giữ lạnh cũng như là bảo vệ sức khỏe"},{"time":182.6,"text":"Rồi bây giờ chúng ta chỉ chiên sơn thôi"},{"time":184.8,"text":"Bây giờ Phước Hương sẽ vớt ra cái giấy thấm dầu nè"},{"time":187.8,"text":"Và bây giờ chúng ta sẽ lần lượt chiên phần ớt sừng nè"},{"time":190.8,"text":"Chúng ta chỉ chiên sơ qua thôi"},{"time":192.9,"text":"Phần ớt này chúng ta cũng chiên lên thì có tác dụng gì hả Phước Hưng?"},{"time":195.7,"text":"Để giữ cho phần ớt có cái màu sắc đẹp"},{"time":198.0,"text":"Và chúng ta ăn có cái độ thơm và bùi hơn"},{"time":201.9,"text":"Chúng ta sẽ lần lượt cho cái phần sương mà chúng ta đã sóc đều"},{"time":206.0,"text":"Với gia vị nêm sẵn, ả chứ quyết bột tẩm khô chiên giòn"},{"time":209.2,"text":"Chúng ta sẽ cho vào chiên"},{"time":217.1,"text":"Bây giờ thì phần sườn non cũng vừa vàng tới rất là đẹp"},{"time":220.6,"text":"Phước Hưng sẽ tắt bếp nè"},{"time":221.8,"text":"Chúng ta sẽ vớt ra"},{"time":223.0,"text":"Hấp dẫn quá"},{"time":224.6,"text":"Ở bên ngoài của miếng sườn được áo một lớp bột mỏng"},{"time":227.5,"text":"Nhưng mà trông rất là giòn đúng không nè"},{"time":229.4,"text":"Đúng rồi"},{"time":230.3,"text":"Vì sườn chúng ta đã luộc sơ qua rồi"},{"time":232.7,"text":"Thì khi chiên thì trúng rất là nhanh"},{"time":234.4,"text":"Các bạn hãy nhớ là có mã QR đang hiển thị trên màn hình"},{"time":237.5,"text":"Dễ dàng chúng ta sử dụng điện thoại quẹt mã này"},{"time":239.7,"text":"Để có ngay công thức của món sườn chiên ngày hôm nay nha"},{"time":244.3,"text":"Phước Hưng sẽ cho cái phần lá lốt mà chúng ta đã chiên vào"},{"time":248.6,"text":"Đó chúng ta sẽ rãi đều nè"},{"time":251.2,"text":"Lần lượt chúng ta sẽ cho sườn vào"},{"time":255.7,"text":"Rồi, sẽ sen kẽ một ít ớt sừng nè"},{"time":258.4,"text":"Cuối cùng thì chúng ta sẽ rắc muối lên"},{"time":261.1,"text":"Để cho sườn đậm đà và thơm ngon hơn"},{"time":264.2,"text":"Cái hỗn hợp bột xù, muối và ớt khô khi nãy mà chúng ta xay đúng không nè"},{"time":268.0,"text":"Đúng rồi"},{"time":268.3,"text":"Vậy là bây giờ món sườn chiên la lốt của chúng ta đã hoàn tất rồi"},{"time":271.9,"text":"Khi ăn thì các bạn chúng ta chấm với một ít sốt mayonaise sẽ rất là tuyệt vời"},{"time":276.0,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng"},{"time":278.1,"text":"Thì chúng ta có thể kết hợp với món cà tím xào tôm thịt cũng sẽ rất là ngon"},{"time":283.1,"text":"Miếng sườn nâu nâu, bên ngoài áo bột vàng giòn, bên trong thịt ngọt mềm mọng, thấm vị đậm đà"},{"time":289.2,"text":"Cùng với hương lá lốt thơm thơm, cắn là mê"},{"time":295.2,"text":"Món sườn chiên lá lốt đơn giản, dễ làm, chẳng chờ gì nữa, thử ngay các bạn ơi"},{"time":300.0,"text":"Và các bạn cũng có thể truy cập vào kênh youtube, website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":306.1,"text":"Để xem thêm nhiều công thức của các món ăn khác nhé"}]}