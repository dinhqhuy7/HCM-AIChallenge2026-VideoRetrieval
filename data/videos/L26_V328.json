e":278.8,"until":283.7,"text":"OnlineDm đà"},{"time":283.9,"until":289.7,"text":"OMOTO · mingày · Eat Well. Live Well. · Eat Wel. Live · JINOM · IGON · Lat Well. Liy"},{"time":290.3,"until":291.8,"text":"AJINOMOTO · mingày · Eat Well, Live Well."},{"time":292.6,"until":296.3,"text":"Youtube · Website · Fanpage Facebook · XEMKY · wwwmonngonmoing · Món Ngon Mi Ngày · moingay · CÁC BUÓC NÀ"},{"time":297.3,"until":307.3,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Chuo Senko Vit Nam · Tham gia thc hin · Công ty Golden Scale · Công ty HKFilm · Rau mm xanh, đò: 100g · Bn quyn kch bn và cu trúc · Xôt Mayonnaise Aji-mayo Ngt Du · Cà chua bi vàng và dò: 150g · Ht thông rang: 3M · Dua leo: 1 trái to · Phi hp thc hin · Muc óng tuoi: 150g · Buói da xanh: 2 múi · Bo sáp: 1 trái · Chanh vàng to: 1 quà · Dàu O-liu, húng lùi · Thit heo xá xíu: 100g · Thc hin chương trình · Ót sùng: 1 quà · Sà cây, gùng · DÀI TRUYÊN HìNH TP. HCM · chuơng trình thuc · Thc hié · Cōng ty A"}],"speech":[{"time":26.3,"text":"Hôm nay em định hái rau mầm lên để làm một món ăn thật là đầy đủ và thật ngon"},{"time":30.7,"text":"Mà cuối cùng còn có nhiều đầy"},{"time":32.9,"text":"Đâu có sao đâu"},{"time":33.8,"text":"Với một nhiều đầy rau thì mình sẽ thêm các loại rau củ quả khác, thêm hạt vô"},{"time":38.7,"text":"Là mình sẽ có một món salad đảm bảo ngon và dưỡng dưỡng"},{"time":42.1,"text":"Hay quá"},{"time":42.7,"text":"Thì bây giờ mình vô bếp đi, mình làm liền luôn"},{"time":45.1,"text":"Chua ngọt dịu kỳ, mát bừng sức sống với salad cầu vồng ngày hè"},{"time":68.0,"text":"Chào mừng các bạn đến với chương trình món ngon mọi"},{"time":70.9,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":74.7,"text":"Rồi bây giờ em giúp mang nồi ở bên kia qua đây đi"},{"time":77.8,"text":"Thì cô sẽ hấp mực"},{"time":78.7,"text":"Khoan mở lửa nha"},{"time":79.6,"text":"Xả mình chỉ cần đập dập xé ra để mình lót ở dưới đáy"},{"time":82.8,"text":"Ít gừng cắt sợi"},{"time":84.0,"text":"Mình chỉ sử dụng mực ống thôi"},{"time":85.8,"text":"Sau đó thì mình cắt khoanh"},{"time":87.6,"text":"Rồi bây giờ cô cho thêm lại là gừng"},{"time":90.7,"text":"Ít ớt để cho nó thơm"},{"time":92.4,"text":"Cô sẽ đậy nắp lại không cần phải cho nước đâu"},{"time":94.5,"text":"Em mở lửa lên giúp cô"},{"time":95.8,"text":"Sau khi mà có hơi nóng nó thoát ra đây"},{"time":97.8,"text":"Thì mình chỉ cần canh khoảng chừng 4 phút nữa thôi"},{"time":100.2,"text":"Mực nó sẽ chín rồi mình sẽ lấy ra"},{"time":101.8,"text":"Kim Thảo sẽ phải giúp cô"},{"time":103.4,"text":"Ở đây thì mình có bưởi"},{"time":105.3,"text":"Em sẽ xé miếng cho cô"},{"time":106.7,"text":"Rồi dưa leo thì em sẽ cắt dọc bỏ ruột"},{"time":109.2,"text":"Rồi sau đó em cắt lát"},{"time":110.3,"text":"Vậy khoảng chừng 2 ly vậy đó để mình trộn salad"},{"time":112.4,"text":"Dạ"},{"time":117.2,"text":"Cà chua thì chỉ cắt làm đôi thôi"},{"time":118.9,"text":"Em xong luôn phần cà chua màu cam"},{"time":121.3,"text":"Còn đây là bơ chỉ cần cắt lát"},{"time":123.3,"text":"Vậy khoảng chừng 2 ly thôi"},{"time":124.5,"text":"Chúng ta sẽ mài lấy vỏ của 1 quả chanh vàng"},{"time":128.3,"text":"Chanh sau khi mà nạo lấy phần vỏ xong rồi"},{"time":130.8,"text":"Thì phần còn lại chúng ta sẽ cắt ra"},{"time":133.9,"text":"Và nặng lấy 3 muỗng canh nước cốt chanh"},{"time":136.0,"text":"Rồi bây giờ nè"},{"time":137.9,"text":"Mực chín rồi em thấy không"},{"time":139.2,"text":"Tự động nó ra nước thôi"},{"time":141.2,"text":"Rồi bây giờ thì cô sẽ dớt mực ra"},{"time":143.0,"text":"Kim Thảo và các bạn lưu ý là chúng ta hấp mực vừa chín tới thôi"},{"time":146.2,"text":"Để mực không bị dai nha"},{"time":147.6,"text":"Xá xíu chúng ta chỉ cần cắt lát mỏng là được"},{"time":157.5,"text":"Để trộn xà lách nha"},{"time":158.6,"text":"Mình sẽ cho vào đây là 1 muỗng cà phê muối"},{"time":161.1,"text":"2 muỗng canh đường"},{"time":163.7,"text":"1 muỗng canh giỏ chanh mài"},{"time":165.7,"text":"3 muỗng canh nước cốt chanh"},{"time":167.3,"text":"2 muỗng canh dầu ô liu"},{"time":170.5,"text":"Các bạn lưu ý là chúng ta sẽ dùng dầu ô liu để trộn salad"},{"time":174.0,"text":"Thì món ăn sẽ thơm ngon và bổ dưỡng hơn"},{"time":177.0,"text":"Đầu tiên là cô sẽ cho ở đây dưa leo, 2 loại cà chua, thịt xá xíu cho vô luôn"},{"time":182.6,"text":"Làm mực"},{"time":183.8,"text":"Rồi, với lại 1 nửa sốt trộn"},{"time":186.9,"text":"Cho thêm là 1 nửa cái phần giỏ chanh mài"},{"time":190.1,"text":"Trộn cho 3-4 cái nguyên liệu này thấm gia vị nha"},{"time":193.3,"text":"Dạ, xong rồi sau đó là cô Hà cho hết tất cả những nguyên liệu còn lại vào hả cô Hà?"},{"time":198.0,"text":"Không, bơ nè, rồi rau mầm nè"},{"time":200.4,"text":"Và bưởi là những cái nguyên liệu"},{"time":202.2,"text":"Mà nó rất dễ bị siêu xuống"},{"time":203.9,"text":"Nào ăn mới trộn, vậy nó mới giữ được"},{"time":205.8,"text":"Cái độ giòn ngon của các nguyên liệu"},{"time":207.7,"text":"Vậy bây giờ xong rồi đó, bây giờ mình chỉ cần ra"},{"time":209.6,"text":"Mình trình bày ra thôi"},{"time":211.4,"text":"Và như mình nói hồi nãy đó"},{"time":214.2,"text":"Mình sẽ không có trộn những cái phần rau này vô"},{"time":217.0,"text":"Tiếp theo thì mình sẽ cho lên đây"},{"time":218.8,"text":"Một ít bưởi"},{"time":220.8,"text":"Quá nhiều màu sắc luôn"},{"time":222.3,"text":"Và quá nhiều các loại rau cũ"},{"time":224.5,"text":"Mà ăn bổ dưỡng thanh mát"},{"time":226.3,"text":"Tốt cho sức khỏe, tốt cho cơ thể của chúng ta"},{"time":229.6,"text":"Mình sẽ cho thêm bơ lên"},{"time":232.7,"text":"Cô sẽ cho lên đây một ít rau húng lũi"},{"time":235.6,"text":"Sẽ rưới cái phần"},{"time":237.0,"text":"Sốt hồi nãy còn lại lên"},{"time":238.4,"text":"Em còn nhìn thấy một nguyên liệu chưa được sử dụng"},{"time":241.6,"text":"Chính là hạt thông"},{"time":243.3,"text":"Rất là tốt cho sức khỏe"},{"time":245.3,"text":"Rồi, mà đặc biệt là rất là ngon nữa"},{"time":247.3,"text":"Dạ đúng rồi"},{"time":248.1,"text":"Rồi bây giờ thì cô rắc lên một ít vỏ chanh mài"},{"time":250.5,"text":"Chúng ta sẽ sử dụng sốt mayonnaise"},{"time":252.5,"text":"Aji mayo ngọt dịu"},{"time":254.0,"text":"Để cho món ăn ngon và cân bằng vị"},{"time":257.4,"text":"Rồi như vậy là chúng ta đã hoàn thành món ăn này đó"},{"time":259.7,"text":"Và với món ăn này thì chúng ta có thể kết hợp với món vịt nướng nồi đất và canh bóng cuộn miếng ngòi để có một bữa ăn hoàn hảo nha các bạn"},{"time":267.4,"text":"Wow quá tuyệt vời luôn cô Hà ơi"},{"time":269.3,"text":"Rau củ tươi giòn, bơ dẻo bùi, còn bưởi thì chua ngọt, nguyện cùng với sốt mayonnaise ajimejo béo béo"},{"time":276.8,"text":"Hòa với những lát thịt xá xíu đậm đà và mực thơm mùi xả, ăn tới đâu đã thèm tới đó"},{"time":283.6,"text":"Một sự kết hợp quá ăn ý giữa các loại trái cây mùa hè và rau củ cơ bản"},{"time":288.2,"text":"Thử ngay các bạn nhé"},{"time":289.4,"text":"Và để xem lại công thức của món ăn ngày hôm nay"},{"time":292.2,"text":"Xin hãy truy cập vào Youtube, Website, Fanpage của chương trình"}]}