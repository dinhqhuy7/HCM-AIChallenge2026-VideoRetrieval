n kch bn và cu trúc · ·RIÊNG BÁC · 1 trái · 1 nhánh · ·HÀNH LÁ · Phi hp thc hin · · GIA VI NÊM SÃN CÁ KHO RIÉNG · Thc hin chương trình · chuơng trình thuc · ·CÁ TRÁM · THÀNH PHÓ HO CHÍMINH · · HÀNH TÍM BÄM · DÀI TRUYÊN HìNH · ·ÔT HIÊM · · THIT BA CHI · ·ÓT SÙNG · ·ÖT SÜNG · Onl · ·OT HIÉM"}],"speech":[{"time":31.2,"text":"Mình chào các bạn đang đến với chương trình Món ngon mỗi ngày, nấu chuẩn ăn lành"},{"time":35.7,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":39.6,"text":"Ngày hôm nay chúng ta sẽ chế biến một món ăn rất là ngon với cá trấm"},{"time":42.9,"text":"Và đây là một loại cá rất là quen thuộc với bữa cơm gia đình ở miền Bắc"},{"time":47.0,"text":"Bản thân Kim Thảo là có người nhà ở miền Bắc cho nên mỗi lần mà đi ra miền Bắc chơi là được ăn món cá trấm này rất là ngon"},{"time":52.9,"text":"Và cá kho làng Vũ Đại rất là nổi tiếng cũng được làm từ cá trấm nè"},{"time":57.2,"text":"Và đầu tiên cho món kho này thì phần thịt ba chỉ Phước Hương sẽ cắt con chì"},{"time":61.0,"text":"Và đối với món ăn ngày hôm nay thì chúng ta sẽ sử dụng thịt ba chỉ"},{"time":64.0,"text":"Để có một món kho khi ăn sẽ béo và thơm ngon hơn"},{"time":70.1,"text":"Còn phần ớt sừng thì bây giờ chúng ta sẽ bỏ hẹt và chúng ta sẽ cắt hình thoi"},{"time":79.2,"text":"Còn phần hành lá thì chúng ta sẽ cắt khúc để chúng ta làm rau nêm"},{"time":89.7,"text":"Còn phần ớt hiểm thì chúng ta sẽ đạp dập"},{"time":93.3,"text":"Rồi"},{"time":94.0,"text":"Và tiếp theo Phước Hương sẽ cho một ít hành tím băm vào phần thịt ba chỉ"},{"time":98.4,"text":"Chúng ta sẽ ướp trộn đều lên"},{"time":100.3,"text":"Kim Thảo giúp dùm Hưng nha"},{"time":102.0,"text":"Phước Hương sẽ ướp cái phần cá này sử dụng một gói gia vị nêm sẵn"},{"time":106.6,"text":"A chi quyết cá kho riền là đã đầy đủ gia vị cho món kho"},{"time":110.3,"text":"Rồi không cần nêm bất cứ một thứ gì nữa cả"},{"time":112.6,"text":"Rất là tiện lợi luôn"},{"time":113.9,"text":"Phước Hương sẽ cho vào đây một muỗng canh riền băm"},{"time":116.7,"text":"Sẽ trộn đều lên và chúng ta để thấm khoảng 15 phút"},{"time":119.5,"text":"Phước Hương ơi, Kim Thảo có một cái thắc mắc là như thế này nè"},{"time":122.0,"text":"Không biết là với cá trắm thì có cái mẹo nào để làm sạch giúp cho cá nó loại bỏ được mùi tanh của nó không?"},{"time":127.3,"text":"Đối với cá trắm thì chúng ta sẽ lấy hết cái phần đen ở bên trong của bụng cá"},{"time":132.1,"text":"Và chúng ta rửa lại nhiều nước"},{"time":134.0,"text":"Làm như vậy thì phải thử được mùi tanh"},{"time":136.0,"text":"Và đối với cái món kho cá trắm thì chúng ta lựa con cá thật là to"},{"time":139.8,"text":"Thì khi mà kho thì cái thịt cá mới ngon"},{"time":143.2,"text":"Phương Hương sẽ đặt lên trên bếp một cái nồi đất để chúng ta kho cá"},{"time":146.3,"text":"Đầu tiên thì sẽ cho một lớp riền ở bên dưới nè"},{"time":150.1,"text":"Để cho không bị xích nòi, không bị cháy"},{"time":152.3,"text":"Trong riền thì có chất galanin"},{"time":154.6,"text":"Là một chất chống ung thư rất là tốt cho sức khỏe luôn"},{"time":159.1,"text":"Và tiếp theo Phước Hưng sẽ cho phần thịt ba chỉ vào"},{"time":162.3,"text":"Và chúng ta sẽ trải đều bên dưới nè"},{"time":164.7,"text":"Hưng sẽ cho phần cá vào"},{"time":166.9,"text":"Nhân vật chính đã được cho vào nồi rồi"},{"time":170.3,"text":"Phước Hưng lại cho phần riền vào"},{"time":172.2,"text":"Và ớt"},{"time":173.6,"text":"Đối với món kho ngày hôm nay khi kho"},{"time":175.5,"text":"Thì chúng ta xếp lần lượt riền thịt cá"},{"time":178.2,"text":"Thì khi kho cá sẽ không bị xích nổi"},{"time":180.4,"text":"Kim Thảo có thấy không"},{"time":181.4,"text":"Hiện tại chúng ta đang còn khá là nhiều gia vị"},{"time":183.7,"text":"Dính ở bên đáy tồ"},{"time":185.2,"text":"Phước Hương sẽ sử dụng 200ml nước nóng"},{"time":188.0,"text":"Chúng ta cho vào đây"},{"time":189.0,"text":"Sẽ khuấy cho cái phần gia vị này"},{"time":191.0,"text":"Nó tan ra hết nè"},{"time":192.7,"text":"Cho phần nước vào lơi luôn"},{"time":195.1,"text":"Sau khi mà chúng ta đã cho nước vào kho cá rồi"},{"time":197.9,"text":"Thì chúng ta hãy đẩy nó vung lại"},{"time":199.5,"text":"Và kho với lửa vừa"},{"time":200.8,"text":"Khoảng 45 đến 1 tiếng là cá có thể ăn được rồi"},{"time":203.9,"text":"Các bạn khán giả có biết không"},{"time":205.5,"text":"Cá trấm là một loại cá"},{"time":207.4,"text":"Có chứa nhiều đạm và chất sắc"},{"time":209.1,"text":"Rất là tốt để chúng ta bồi bổ cho cơ thể"},{"time":211.7,"text":"Và đặc biệt là mỡ của cá trấm"},{"time":214.1,"text":"Còn có chứa nhiều acid béo không no"},{"time":216.1,"text":"Là một loại acid béo mà"},{"time":218.0,"text":"Rất tốt cho việc hỗ trợ tim mạch"},{"time":220.5,"text":"Cho người lớn tuổi"},{"time":221.5,"text":"Đồng thời là hỗ trợ trí não"},{"time":223.3,"text":"Cho các bạn nhỏ trong gia đình"},{"time":224.6,"text":"Và đối với món khoa ngày hôm nay"},{"time":226.5,"text":"Thì Phước Hương sẽ sử dụng đó chính là phần riền"},{"time":229.1,"text":"Đây là riền bắc"},{"time":230.1,"text":"Mang lại cái hương vị rất là đặc trưng"},{"time":232.3,"text":"Thơm hơn"},{"time":233.0,"text":"Thời gian cũng đã tới rồi Phước Hương mở ra nè"},{"time":236.3,"text":"Rất là thơm riền luôn và cái màu sắc của cá rất là đẹp luôn"},{"time":239.9,"text":"Đối với món ăn ngày hôm nay thì chúng ta lựa cá rất là tươi"},{"time":243.2,"text":"Khi kho xong thì cá nở rất là ngon"},{"time":245.7,"text":"Cuối cùng Phước Hương sẽ cho lên đây một ít hành lá và ớt sần cắp quả trám"},{"time":249.8,"text":"Các bạn có thể xem lại công thức của món ăn ngày hôm nay"},{"time":252.7,"text":"Cá trắm kho riền cách đơn giản"},{"time":255.3,"text":"Chỉ cần quét mã QR trên bàn hình của chúng tôi nha"},{"time":260.4,"text":"Vậy là bây giờ món ăn của chúng ta đã hoàn tất rồi"},{"time":262.9,"text":"Khi ăn thì chắc chắn không thể nào thiếu được chán cơm trắng nè"},{"time":266.4,"text":"Ăn cùng sẽ rất là bắt miệng luôn"},{"time":268.2,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng"},{"time":270.5,"text":"Thì chúng ta có thể kết hợp với món đậu cô ve xào tim gan"},{"time":273.5,"text":"Sẽ rất là tuyệt vời"},{"time":274.6,"text":"Wow, chúng ta có một bữa cơm"},{"time":277.1,"text":"Truyền thống Việt Nam"},{"time":278.6,"text":"Rất là ngon và bổ dưỡng đúng không ạ"},{"time":281.3,"text":"Thịt cá trắm kho màu nâu đẹp mắt"},{"time":283.5,"text":"Từng thớ thịt răng"},{"time":284.9,"text":"Đậm vị mà không khô"},{"time":286.7,"text":"Nước kho sóng sánh"},{"time":288.1,"text":"Thơm mùi riền rất hấp dẫn"},{"time":289.9,"text":"Đưa cơm phải biết"},{"time":291.2,"text":"Cá trắm kho riền là một món ăn rất là thân thuộc"},{"time":294.6,"text":"Nhưng luôn bắt vị và đưa cơm"},{"time":296.6,"text":"Hãy thử ngay nhé"},{"time":297.6,"text":"Và để xem lại công thức nấu ăn của ngày hôm nay"},{"time":299.9,"text":"Để có thể nấu chuẩn vị nhất"},{"time":301.7,"text":"Chỉ cần truy cập vào Youtube website fanpage"},{"time":304.4,"text":"Của chương trình Món Ngon Mỗi Ngày"},{"time":306.0,"text":"Bây giờ thì xin chào và hẹn gặp lại"}]}