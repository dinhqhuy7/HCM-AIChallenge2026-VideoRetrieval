t":"Hôm nay Phước Hưng cũng như là Minh Phương sẽ giới thiệu cho các bạn món cá thu sốt xoài"},{"time":52.9,"text":"Sẽ rất là độc đáo luôn"},{"time":54.2,"text":"Phần cá thu này rất là đơn giản thôi"},{"time":56.1,"text":"Chúng ta sẽ cắt cá thu ra từng lát vừa ăn"},{"time":59.6,"text":"Và đây cũng là một cái lưu ý cho quý vị khán giả"},{"time":61.9,"text":"Chúng ta sẽ cắt lát phần cá thu"},{"time":63.9,"text":"Giúp cho cá thấm vị khi chiên sẽ có độ giòn ngon hơn"},{"time":67.0,"text":"Và đối với món ăn ngày hôm nay"},{"time":68.5,"text":"Chúng ta sẽ sử dụng sòi keo"},{"time":70.4,"text":"Sòi keo có vị chua nhẹ"},{"time":71.8,"text":"Thì sẽ phù hợp với món ăn hơn"},{"time":73.5,"text":"Sẽ cắt ra thành tầng lát"},{"time":76.2,"text":"Bây giờ chúng ta sẽ cắt hạt lụ"},{"time":77.8,"text":"Và đối với món ăn ngày hôm nay"},{"time":82.1,"text":"Chúng ta sẽ chọn sòi có độ giòn và chua nhẹ"},{"time":84.7,"text":"Thì sẽ phù hợp với món ăn hơn"},{"time":86.4,"text":"Rồi và bây giờ chúng ta sẽ cắt hết luôn"},{"time":88.2,"text":"Phần cá thu để Phước Hương sẽ đập dập"},{"time":90.3,"text":"Phần đầu hành trắng để chúng ta ướp vào"},{"time":96.5,"text":"Bây giờ chúng ta sẽ cho đầu hành trắng"},{"time":98.5,"text":"Vô cá thu"},{"time":100.2,"text":"Trộn đều cái phần đầu hành trắng"},{"time":102.1,"text":"Để cho thấm phần cá thu này cho thơm ngon"},{"time":104.4,"text":"Bây giờ Phước Hưng sẽ đặt lên trên bếp"},{"time":106.2,"text":"Một cái chảo dầu để chúng ta chiên cá"},{"time":107.9,"text":"Trong khi chúng ta đợi dầu nóng"},{"time":109.6,"text":"Thì Phước Hưng sẽ hướng dẫn cho các bạn"},{"time":111.0,"text":"Chúng ta sẽ pha cái hỗn hộp sốt xoài"},{"time":113.6,"text":"Đầu tiên Phước Hưng sẽ cần là"},{"time":115.4,"text":"Nửa chén xoài keo mà chúng ta đã cắt hạt lũ sẵn rồi"},{"time":118.6,"text":"Cho vào đây"},{"time":119.6,"text":"Một chén tương xí mũi chúng ta sẽ trộn đều lên"},{"time":122.1,"text":"Và chúng ta sẽ trộn nhẹ nhàng thôi"},{"time":123.7,"text":"Để tránh cho phần sợi keo không bị dập"},{"time":126.1,"text":"Mà quá mềm ăn sẽ không ngon"},{"time":128.3,"text":"Như vậy là phần sốt của mình đã xong"},{"time":130.1,"text":"Rất là đơn giản thôi"},{"time":131.1,"text":"Phương Hương sẽ sử dụng nửa gói gia vị nêm sẵn"},{"time":133.7,"text":"Acid quýt bột tẩm khô chiên giòn"},{"time":135.5,"text":"Phương sẽ cho vào một cái dĩa"},{"time":139.5,"text":"Chúng ta sẽ áo đều"},{"time":141.0,"text":"Cái phần cá thu này"},{"time":142.0,"text":"Đối với món ăn nào mà chúng ta có sử dụng"},{"time":144.4,"text":"Acid quýt bột tẩm khô chiên giòn"},{"time":145.8,"text":"Thì chúng ta không cần nêm nếm gia vị nữa"},{"time":149.3,"text":"Rồi và bây giờ chúng ta sẽ lần lượt cho vào chiên luôn"},{"time":161.3,"text":"Mình sẽ chiên cho phần cá thu 2 mặt nó đều vàng giòn đúng không Phúc Tinh?"},{"time":165.9,"text":"Đúng rồi, chúng ta sẽ chiên với lửa vừa thôi để cho phần cá thu được chín đều hơn"},{"time":169.4,"text":"Và đối với món ăn ngày hôm nay về cá thu thì cá thu Minh Phương rất là thích"},{"time":173.2,"text":"Bởi vì trong cá thu có rất là nhiều chất omega 3 và chủ yếu là DHA"},{"time":178.1,"text":"Thì DHA rất là nổi tiếng cho sự phát triển não bồ ở trẻ nhỏ"},{"time":181.8,"text":"Và bên cạnh đó thì chất này cũng giúp cho cải thiện trí nhớ ở người lớn tuổi"},{"time":186.1,"text":"Một món ăn rất là giàu dinh dưỡng"},{"time":187.9,"text":"Bây giờ phần cá cũng có cái màu vàng rất đẹp"},{"time":190.5,"text":"Chúng ta sẽ cho qua một cái giấy thấm dầu"},{"time":195.7,"text":"Món ăn ngày hôm nay quả thật là siêu nhanh, siêu dễ mà lại siêu hấp dẫn đúng không nào"},{"time":200.0,"text":"Và trước khi chúng ta trình bày món ăn ngày hôm nay"},{"time":202.1,"text":"Thì chúng ta đừng quên một địa chỉ rất là quen thuộc để xem lại công thức của món ăn này hôm nay"},{"time":207.2,"text":"Đó chính là mã QR đang hiển thị trên màn hình"},{"time":210.1,"text":"Chúng ta hãy dùng điện thoại để quẹt mã này các bạn nha"},{"time":214.3,"text":"Và bây giờ Phương Hương cũng đã chuẩn bị sẵn một cái dĩa để chúng ta trình bày ra món ăn"},{"time":217.8,"text":"Cho cái phần sốt xòi bên dưới"},{"time":220.0,"text":"Cho phần cá thu lên"},{"time":224.8,"text":"Từng khoanh cá trông rất là vàng"},{"time":227.5,"text":"Đúng rồi"},{"time":234.4,"text":"Cho lên đây một ít ớt sừng nè"},{"time":236.7,"text":"Và một ít đầu hàng trắng"},{"time":238.9,"text":"Chúng ta trang trí mà chúng ta cũng có thể ăn kèm luôn"},{"time":241.4,"text":"Và một ít ngò rí nè"},{"time":245.5,"text":"Vậy là bây giờ món cá thu sốt sòi của chúng ta đã hoàn tất rồi"},{"time":248.9,"text":"Khi ăn thì chúng ta sẽ kết hợp với món cơm trắng nóng"},{"time":251.9,"text":"Sẽ rất là tuyệt vời"},{"time":253.0,"text":"Và để tạo nên một bữa ăn đầy dinh dưỡng"},{"time":255.1,"text":"Thì chúng ta có thể kết hợp với món canh sườn bí đỏ rong biển"},{"time":258.3,"text":"Sẽ rất là tuyệt vời luôn"},{"time":259.6,"text":"Và với tiêu chí của món ngon mỗi ngày"},{"time":262.0,"text":"Đó là những món vừa nhanh gọn nhưng phải đảm bảo đầy đủ chất dinh dưỡng"},{"time":265.2,"text":"Thì mình phương tin chắc rằng món cá thu sốt xoài ngày hôm nay"},{"time":268.0,"text":"Sẽ đáp ứng được những điều đó"},{"time":269.5,"text":"Chúc các bạn khán giả sẽ thành công"},{"time":271.5,"text":"Nước sốt đỏ cam đi cùng với xoài chua chua ngọt ngọt"},{"time":274.9,"text":"Cực bắt vị"},{"time":275.8,"text":"Cá thu ngọt thịt giòn giòn béo béo"},{"time":278.4,"text":"Trọn vị mâm cơm"},{"time":281.1,"text":"Nếu như các bạn đang tìm một món ngon"},{"time":283.1,"text":"Vừa đơn giản và bổ dưỡng"},{"time":284.8,"text":"Thì hãy làm ngay món cá thu sốt xoài"},{"time":287.5,"text":"Và cũng đừng quên truy cập vào kênh youtube"},{"time":289.9,"text":"Website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":292.6,"text":"Để biết thêm nhiều công tức"},{"time":294.1,"text":"Của các món ăn ngon nữa"},{"time":295.3,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}