iều luôn đấy ạ"},{"time":51.8,"text":"Hôm nay quý vị sẽ hướng dẫn các bạn"},{"time":53.4,"text":"Thực hiện món cuốn chay đậu hủ rau rừng"},{"time":55.5,"text":"Một món chay mà thích hợp cho cả nhà luôn đó Thanh Vân"},{"time":58.1,"text":"Và đặc biệt món ăn này được chuyên gia dinh dưỡng tiến sĩ Đào Thị Yến Phi"},{"time":62.3,"text":"Tư vấn cho những bạn mà đang cần một cái chế độ ăn giảm mỡ thừa luôn đó"},{"time":66.2,"text":"Đầu tiên thì chúng ta sẽ sơ chế những gì ạ?"},{"time":68.3,"text":"Trong món cuốn này quý vị sẽ sử dụng củ hủ dừa"},{"time":70.8,"text":"Giúp cho món ăn đặc sắc hơn"},{"time":72.2,"text":"Trong củ hủ dừa có chất sơ hòa tan và cả không hòa tan"},{"time":75.5,"text":"Vì vậy rất là tốt cho những ai đang muốn giảm mỡ thừa"},{"time":78.6,"text":"Củ hủ dừa cắt sợi nè"},{"time":80.4,"text":"Sau đó ngâm qua một cái tô nước có nước cốt chanh để củ hủ dừa nó được trắng"},{"time":89.7,"text":"Bây giờ chúng ta sẽ cho phần củ hủ dừa này vào trong nước"},{"time":92.2,"text":"Và nhớ là cho thêm một ít nước cốt chanh vào để củ hủ dừa được trắng hơn nha"},{"time":96.3,"text":"Rồi, đậu hủ thì quất này sẽ cắt sợ"},{"time":99.1,"text":"Đậu hủ thì có nhiều protein nè"},{"time":101.6,"text":"Và lại ít calor giúp cho cơ thể no lâu và giảm mỡ tốt"},{"time":105.1,"text":"Bây giờ chúng ta đi xào nhân trước nha"},{"time":107.0,"text":"Các bạn sẽ cho vào đây một muỗng canh dầu ăn"},{"time":110.6,"text":"Tiếp đến là một muỗng cà phê dầu mè"},{"time":113.5,"text":"Cho vào đây hai muỗng canh hành bò rô cắt lát"},{"time":115.9,"text":"Phi thơm hành bò rô này"},{"time":118.1,"text":"Bây giờ chúng ta sẽ cho củ hủ dừa vào"},{"time":120.5,"text":"Đảo đều"},{"time":121.8,"text":"Wow vậy là mùi thơm rất hấp dẫn luôn"},{"time":124.0,"text":"Tiếp đến các bạn sẽ cho đậu hủ vào"},{"time":126.0,"text":"Các bạn sẽ nêm vào đây nửa muỗng cà phê hạt nêm Ajinomoto"},{"time":129.4,"text":"Nửa muỗng cà phê bột ngọt Ajinomoto"},{"time":132.7,"text":"Một muỗng cà phê đường cát"},{"time":135.2,"text":"Và cuối cùng là một ít tiêu xay"},{"time":138.7,"text":"Tiếp tục mình đảo đều cho gia vị nó bám vào nhân"},{"time":142.2,"text":"Rồi sau khi gia vị nó bám hết vào nhân rồi"},{"time":144.3,"text":"Tắt lửa"},{"time":145.3,"text":"Cho ra đĩa để nguội trước khi cuốn nha"},{"time":149.1,"text":"Các bạn chuẩn bị 1 cái chảo nhỏ để nấu sốt"},{"time":151.4,"text":"Cho vào đây 1 muỗng canh dầu ăn"},{"time":152.9,"text":"1 muỗng canh đậu phộng xay"},{"time":155.9,"text":"Sau khi đậu phộng dạy mùi thơm"},{"time":157.4,"text":"Các bạn hạ lửa nhỏ"},{"time":158.6,"text":"Cho vào đây 2 muỗng canh nước lọc"},{"time":162.6,"text":"Tiếp đến là 1 muỗng canh tương đen"},{"time":164.4,"text":"Nửa muỗng canh tương ớt"},{"time":167.4,"text":"1 muỗng canh nước tương phú sỉ"},{"time":169.6,"text":"Hàng chai mà phải có nước tương phú sỉ"},{"time":172.2,"text":"1 phần 3 muỗng cà phê bột ngọt Asinomoto"},{"time":174.9,"text":"2 muỗng cà phê đường cát"},{"time":178.2,"text":"Và cuối cùng là 1 muỗng cà phê dầu mè"},{"time":181.5,"text":"Khoái đều"},{"time":182.3,"text":"Tất cả gia vị nó hòa quyền vào nhau"},{"time":184.7,"text":"Chúng ta thu được cái sốt chấm của gỏi cuốn"},{"time":188.0,"text":"Rồi bây giờ chúng ta sẽ cho sốt ra chén"},{"time":192.0,"text":"Các bạn sẽ sử dụng bánh tráng gạo nè"},{"time":194.1,"text":"Thoa một ít nước lọc"},{"time":195.5,"text":"Để cho bánh tráng chúng ta nó sẽ mềm lại"},{"time":199.3,"text":"Quấn nghị sẽ sử dụng rau rừng"},{"time":201.4,"text":"Việc lựa chọn đa dạng các loại rau rừng á"},{"time":203.6,"text":"Giúp cho món ăn có hương vị đặc biệt hơn"},{"time":205.7,"text":"Cuốn một vòng trước nè"},{"time":208.8,"text":"Sau khi cuốn một vòng nè"},{"time":210.2,"text":"Thì các bạn sẽ đặt cái lớp nhân lên cái vòng tiếp theo"},{"time":213.5,"text":"Bây giờ các bạn sẽ gắp phần mí trang của bánh tráng này"},{"time":216.3,"text":"Chúng ta tiếp tục cúng thêm một vòng nữa"},{"time":218.3,"text":"Mình sẽ cho các phần đậu hủ và cổ hủ dừa vào"},{"time":225.7,"text":"Cuộn chặt lại một vòng nữa"},{"time":232.3,"text":"Một bữa ăn dinh dưỡng ngon và lành"},{"time":234.3,"text":"Các bạn nhớ quét mã QR để lưu công thức nha"},{"time":238.9,"text":"Bây giờ chúng ta sẽ trình bài ra đĩa và cùng thưởng thức các bạn nha"},{"time":242.1,"text":"Đặc biệt với Thanh Phương thì mê đắm các phần sốt chấm này"},{"time":244.8,"text":"Có mùi thơm rất là đặc trưng"},{"time":246.6,"text":"Trong đó có hương vị đặc trưng của nước tương phú sỉ"},{"time":248.7,"text":"Làm dậy lên mùi thơm và sự hấp dẫn cho món cuốn"},{"time":251.9,"text":"Chúng ta sẽ đặt một cái đứng nè"},{"time":255.6,"text":"Một cái nằm nè"},{"time":264.9,"text":"Để đạt được hiệu quả giúp giảm khối mỡ thừa trong cơ thể"},{"time":268.3,"text":"Các bạn có thể tham khảo món ăn này cùng với bản thực đơn nguyên một ngày sau đây các bạn nha"},{"time":273.0,"text":"Và để cập nhật đầy đủ thông tin về thực đơn"},{"time":279.8,"text":"Các bạn vừa lộn truy cập vào website"},{"time":281.0,"text":"Món ngon mỗi ngày"},{"time":282.9,"text":"Cuốn chay tươi mát, giòn ngọt từ củ hú dừa"},{"time":286.1,"text":"Chua chua, chát nhẹ"},{"time":287.6,"text":"Và thơm lừng của rau rừng"},{"time":289.2,"text":"Chấm cùng sốt đậm đà, bùi bùi"},{"time":291.5,"text":"Như lôi cuốn và hòa quyện vào nhau"},{"time":294.1,"text":"Rất cuốn"},{"time":296.7,"text":"Một gợi ý"},{"time":297.6,"text":"Món cuốn chay đậu hủ rau rừng"},{"time":299.4,"text":"Thực hiện trong dịp Tết Nguyên Tiêu"},{"time":301.1,"text":"Các bạn hãy thực hiện ngay nhé"},{"time":302.6,"text":"Ngoài ra chúng ta có thể truy cập vào kênh youtube"},{"time":304.6,"text":"Website và fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":307.3,"text":"Để cập nhật thêm công thức của các món ăn ngon"}]}