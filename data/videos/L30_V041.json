L30_V031",3442,137.6,36]]]],"onScreen":[{"time":0.1,"until":2.9,"text":"tv.tuoitre.vn"},{"time":5.1,"until":6.3,"text":"Herbalife · trên th gii · thưong hiu · cân năng · & súc khòe · quàn ly"},{"time":7.1,"until":7.1,"text":"Clip bn đoc d thi cuc thi: · Lan ta năng lung tích cc 2024"},{"time":12.9,"until":18.7,"text":"Cuc thi Lan ta năng lung tích cc2024: · Tm v hi c tui thơ · thuong hitu · quan' · quán ly"},{"time":22.6,"until":30.4,"text":"tuöitréV"},{"time":30.6,"until":33.0,"text":"THÀNH PHÓ BÉN TRE"},{"time":39.5,"until":42.4,"text":"tuoitre · tucitre"},{"time":42.8,"until":45.2,"text":"THÀNH PHO BEN TRE"},{"time":45.6,"until":49.0,"text":"tuoitrev"},{"time":55.9,"until":83.3,"text":"Tác gi: Nguyn Th Ngc Ánh · thuong hitu · cann"}],"speech":[{"time":13.9,"text":"Trong ký ức tuổi thơ của những đứa trẻ lớn lên ở vùng quê, chắc hẳn đã từng có sự xuất hiện của đâm đóm."},{"time":20.4,"text":"Trong khung cảnh đèn dầu chập trờn ấy, có cả những nàng đâm đóm vào ngõ xóm và nếp sống."},{"time":26.3,"text":"Ngồi nghe những hoài niệm về hồi xưa, tự nhiên sẽ có những lời kể về tuổi thơ dữ dội."},{"time":31.3,"text":"Đó là những chuỗi ngày chạy dọc theo con đường làng để rượt bắt những bầy đâm đóm,"},{"time":35.7,"text":"bỏ chúng vào lọ mực, chai thủy tinh để rồi mân mê cả buổi cả đêm."},{"time":40.5,"text":"Hiện nay số lượng đông đóm ngày càng suy giảm vì ô nhiễm môi trường và sự can thiệp của con người"},{"time":45.6,"text":"Nhưng ở tại con sông Hàm Luông, chảy qua địa phận tỉnh Bến Tre"},{"time":49.2,"text":"Dù đêm sáng trăng hay đêm tối trời, đông đóm vẫn xuất hiện ở những khóc cây bên dòng sông"},{"time":55.0,"text":"Trên con thuyền lớn chạy dọc theo những rặng bần mọc dọc bờ sông"},{"time":59.0,"text":"Hay những hài dừa nước mọc khóc các con kênh rạch nhỏ"},{"time":62.2,"text":"Người trong màn đêm tối mịt, những tia sáng lắp lánh từ những chú đông đóm sẽ khiến người xem thích thú đến không trời được mắt"},{"time":68.9,"text":"Trải nghiệm ngắm đâm đớm là một trải nghiệm đặc biệt"},{"time":71.9,"text":"Tìm về những hồi ức tuổi nhỏ được tận tay bắt và sờ những chú đâm đớm lung linh"},{"time":76.7,"text":"Tướng Trần chỉ còn bắt gặp qua những bộ phim hay trong trang sách"}]}