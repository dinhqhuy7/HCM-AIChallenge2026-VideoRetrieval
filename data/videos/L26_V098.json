o Minh Tuấn và các bạn khán giả một cái món thức uống đó là Matcha Cà Phê"},{"time":57.5,"text":"Trong cà phê thì nó có caffeine giúp cho chúng ta tỉnh táo, có năng lượng"},{"time":61.6,"text":"Ngoài ra là trong trà thì cũng có caffeine luôn"},{"time":64.9,"text":"Nhưng mà bên cạnh đó trà còn có một cái hợp chất là thenin"},{"time":68.2,"text":"Giúp cho chúng ta sẵn khoái, thư giãn trinh thần, không bị lo âu"},{"time":71.5,"text":"Cho nên là buổi sáng mà mình có một cái ly mà vừa có trà vừa có cà phê như thế này"},{"time":75.8,"text":"Chắc chắn sẽ làm cho mọi người tỉnh táo để bắt đầu một ngày mới thật là rực rỡ"},{"time":79.4,"text":"Rồi bây giờ mình bắt đầu mình làm thôi"},{"time":81.0,"text":"Rồi mình sẽ pha lên đi trà matcha gạo rang"},{"time":84.0,"text":"Chúng ta sẽ cho 2 gói vào trong đây"},{"time":86.4,"text":"Như vậy là 1 ly mình sẽ có 2 gói"},{"time":89.7,"text":"Đúng rồi"},{"time":90.2,"text":"Tuấn sẽ lấy 2 gói, cũng tương tự như vậy Tuấn sẽ đổ vào"},{"time":94.2,"text":"Cho vào đây 50ml nước cho 2 gói"},{"time":98.2,"text":"Rồi, cho thêm 50ml nước sôi nha các bạn"},{"time":101.2,"text":"Mình sẽ khuấy cho nó tan đều hết ra luôn nha Minh Tuấn"},{"time":104.5,"text":"Đúng rồi, mình giống như là cách pha cà phê của mình á"},{"time":107.1,"text":"Mình đánh đánh cho nó có bọt, nhìn cho nó hấp dẫn"},{"time":109.2,"text":"Tiếp theo mình sẽ cho mỗi ly cà phê này là 4g nha"},{"time":113.1,"text":"Mỗi ly chúng ta sẽ cần 4g bột cà phê hòa tan"},{"time":116.8,"text":"Như vậy thì với 2 ly mình sẽ dùng 8g"},{"time":119.1,"text":"Đúng, với mỗi ly matcha này chúng ta sẽ cho 1 muỗng cà phê đường vào trong đây"},{"time":124.2,"text":"Cho vào đây, 1 tí xíu muối"},{"time":125.9,"text":"Tùy khẩu vị ha"},{"time":126.9,"text":"Đúng rồi, thêm 1 ít muối vào cà phê giúp tăng vị đậm đà cho thức uống của chúng ta nha"},{"time":131.2,"text":"Sau đó chúng ta sẽ cho 20ml nước sôi này vào nha"},{"time":135.1,"text":"Ở đây chúng ta sẽ cho là 40"},{"time":136.9,"text":"Như vậy là mỗi 1 ly chúng ta sẽ có là 4g cà phê hòa tan, 1 muỗng đường và 20ml nước sôi"},{"time":142.9,"text":"Đó, mình muốn mấy ly thì mình cứ nhân lên thôi, rất đơn giản"},{"time":145.8,"text":"Rồi, mình sẽ dùng cái máy đánh bọt này nè, đánh bông cái cà phê này lên"},{"time":150.0,"text":"Đây nè, cái này là tôi nhớ là ý tưởng là từ cà phê muối nè đúng không?"},{"time":152.8,"text":"Đúng rồi"},{"time":153.8,"text":"Và bây giờ chúng ta sẽ cho cái phần nước đá này vào trong"},{"time":159.1,"text":"Cái blendy trà mát trà gạo rang sau khi mà mình khuấy xong thì mình phải để cho nguội"},{"time":163.0,"text":"Thì là nguội ha"},{"time":163.7,"text":"Để tránh làm cho nước đá nó bị tan ra và thức uống của mình nó thiếu đậm đà đi"},{"time":167.4,"text":"Đúng"},{"time":167.8,"text":"Đó, chờ nguội"},{"time":169.0,"text":"Cho vào đây là 80ml sữa tươi không đường ha"},{"time":172.7,"text":"Chúng ta sẽ sử dụng sữa tươi không đường"},{"time":175.0,"text":"Giúp kiểm soát được độ ngọt của thức uống của chúng ta nha"},{"time":177.4,"text":"Cho cái phần cà phê vô"},{"time":181.9,"text":"Mình sẽ cho hết cái phần bọt cà phê lên trên"},{"time":184.7,"text":"Với matcha gạo rang"},{"time":185.9,"text":"Chúng ta sẽ kết hợp với cà phê"},{"time":187.4,"text":"Giúp tạo hương vị mới lạ cho món thức uống của chúng ta nha"},{"time":190.1,"text":"Rồi, đầu tiên mình cũng sẽ cho cà phê vô"},{"time":198.0,"text":"Topping lên trên đây"},{"time":198.9,"text":"Một ít nhò khô"},{"time":201.2,"text":"Cho 2 cái bánh quế này vào đây"},{"time":203.2,"text":"Để trang trí luôn"},{"time":204.4,"text":"Vừa trang trí mà vừa chúng ta có thể ăn được"},{"time":208.3,"text":"À, đẹp"},{"time":209.1,"text":"Tuấn cũng sẽ cần 2 cái như vậy"},{"time":212.8,"text":"Quá là hấp dẫn luôn"},{"time":213.8,"text":"Một cái ly có rất là nhiều tầng"},{"time":215.5,"text":"Như vậy là món uống của mình ngày hôm nay đã xong rồi đúng không Minh?"},{"time":217.8,"text":"Đúng rồi, rất là nhanh và đơn giản"},{"time":219.6,"text":"Rồi, mà mình đã làm một cái món uống như vầy rồi"},{"time":222.0,"text":"Để cho nó hấp dẫn hơn thì mình phải trình bày nó xíu ha"},{"time":224.8,"text":"Rồi, và ngay bây giờ trên bàn hình của chúng ta"},{"time":226.6,"text":"Bên cạnh một ly thức uống rất là hấp dẫn này"},{"time":228.6,"text":"Thì cũng có một mã QR"},{"time":229.6,"text":"Các bạn có thể quét mã để chúng ta sẽ ngay lập tức"},{"time":231.9,"text":"Có được công thức để làm món thức uống này tại nhà nha"},{"time":236.5,"text":"Chúng ta sẽ trình bày ở đây"},{"time":239.2,"text":"Và thường thường mình uống cà phê mình sẽ ăn kèm với bánh"},{"time":242.1,"text":"Đúng"},{"time":242.5,"text":"Mình có đề xuất là với cái món này mình sẽ ăn bánh gì ngon không?"},{"time":246.4,"text":"Với cái món cà phê này thì chúng ta sẽ kết hợp với món pancake xoài kem tươi"},{"time":250.8,"text":"Thì nó sẽ rất là hấp dẫn luôn đó Minh Tuấn"},{"time":253.5,"text":"Như vậy là bây giờ với một cái công thức mới"},{"time":256.9,"text":"Mỗi một cái ly cà phê buổi sáng nó sẽ làm cho chúng ta cảm thấy thú vị hơn rất là nhiều"},{"time":261.1,"text":"Nên là các bạn hãy thử trải nghiệm món này vào buổi sáng nha"},{"time":264.6,"text":"Chắc chắn nó sẽ làm cho chúng ta có một ngày còn hứng khởi hơn bình thường rất nhiều"},{"time":268.1,"text":"Cảm ơn Minh đã giới thiệu món uống của ngày hôm nay"},{"time":270.1,"text":"Cảm ơn Minh Tuấn"},{"time":272.1,"text":"Lớp bọt cà phê đánh bông lên"},{"time":274.1,"text":"Có vị đắng nhẹ, béo ngọt của sữa"},{"time":276.9,"text":"Măng mặn của muối"},{"time":278.5,"text":"Vô cùng thú vị"},{"time":279.6,"text":"Động lại hậu ngọt, mê đắm, khó tả"},{"time":284.6,"text":"Ngày nay thưởng thức cà phê đã được nâng lên một tầm mới"},{"time":287.0,"text":"Người ta không chỉ thưởng thức ly cà phê"},{"time":288.6,"text":"Mà người ta còn thưởng thức cả cách để pha ra ly cà phê đó"},{"time":291.8,"text":"Từng công đoạn đều giúp cho mình có thể thư giãn"},{"time":294.8,"text":"Dành thời gian cho riêng mình"},{"time":296.4,"text":"Và có một ly cà phê đầy năng lượng"},{"time":298.5,"text":"Mà đặc biệt thơm ngon vào buổi sáng nữa"},{"time":300.1,"text":"Công thức của món thức uống ngày hôm nay"},{"time":301.8,"text":"Luôn có trên Youtube, Website và Fanpage"},{"time":304.4,"text":"Của chương trình Món ngon mỗi ngày"},{"time":305.5,"text":"Các bạn hãy truy cập vào, tìm công thức"},{"time":307.6,"text":"Và thực hiện ngay vào mỗi buổi sáng nha"},{"time":309.1,"text":"Chúc các bạn sẽ luôn có một ngày tốt lành"},{"time":311.1,"text":"Với thức uống của ngày hôm nay"}]}