P THUYÉN HINH · Chäng! · DÍCH · TONDONGATONDO · Vong dua H · TONDONAOT · Vàng dua H Hon! · Vang dua Hó Hoàn Kiém ( · CUP TRUYN · MTV · Yáng dua Mó Hon Kém"},{"time":170.0,"until":181.2,"text":"2024 · DONGA · CÚP TRUYÊN HINH · DÀI TRUYĚN HìNH THÀNH PHÓ HÓ CHÍ MINH · HETHAb · HEJHAO"},{"time":188.8,"until":195.0,"text":"DONG · TONDONG"},{"time":203.3,"until":213.2,"text":"ONDONGA · TOND · (BM)"},{"time":213.4,"until":220.6,"text":"TONDON · HE THAO · TON · DICH · DÍCH"},{"time":231.9,"until":238.8,"text":"TONDONG · TON · TONDO · HE THAO · ONGA · F0008000"},{"time":239.0,"until":242.4,"text":"CÚP TRUYÉN HINH · DÀI TRUYÈN HiNH THÀNH PHÓ HÒ CHÍ MINH · THUC HIÊN · THUG HIÈN"}],"speech":[{"time":0.0,"text":"Cho nên tôi nghĩ là qua tới một cái dòng cuối rồi có thể là cái diễn biến nó sẽ khác"},{"time":4.5,"text":"Hoặc là một số vận viên sẽ tấn công nếu tốc độ gì, một dòng vận viên mạnh tấn công vẫn đi được"},{"time":12.9,"text":"Vừa rồi là những phân tích về những diễn biến có thể diễn ra ở trong vòng đùa cuối cùng"},{"time":18.5,"text":"Khi mà lúc này các vận viên đang chuẩn bị hoàn thành vòng chạy thứ 24"},{"time":22.5,"text":"Với các đùa của 620 Nông Nghiệp Vĩnh Long và 620 Trong Thếp Vĩnh Long"},{"time":25.6,"text":"Vẫn đang làm những động máy kéo"},{"time":27.1,"text":"Và từ góc quay này chúng ta thấy vị trí của Peter Rikunov"},{"time":30.1,"text":"đang nằm ở vị trí ngay sau lưng"},{"time":32.1,"text":"của 4 nơi đua Vĩnh Long"},{"time":33.6,"text":"Peter Nikunov đang được Roman Makin bảo vệ rất kỹ"},{"time":36.3,"text":"chỉ sau lưng có 4 nơi đua"},{"time":38.3,"text":"của Vĩnh Long mà thôi"},{"time":39.8,"text":"và chắc chắn là Peter Nikunov sẽ tham gia"},{"time":41.7,"text":"rất quyết liệt vào cuộc cạnh tranh ở nước rút"},{"time":44.3,"text":"Chúng ta còn nhớ là ở vòng đua thứ 3"},{"time":46.0,"text":"vòng đua vòng quanh thành phố Hòa Bình"},{"time":48.1,"text":"thì khi đó các tập thể Đồng Tháp"},{"time":50.5,"text":"An Giang và Vĩnh Long đã tạo nên"},{"time":52.2,"text":"3 tông cùng lúc với nhau"},{"time":54.0,"text":"tập thể An Giang là những người tạo tông sâu"},{"time":56.1,"text":"nhưng đã đẩy tốc độ lên rất cao"},{"time":57.8,"text":"với sự hỗ trợ của Roman Makin và Trịnh Thức Tâm"},{"time":59.9,"text":"Và đã giúp cho Peter Rikunov có được lợi thế nhất định và giành được chiến thắng"},{"time":65.4,"text":"Bây giờ đã là vòng đua cuối rồi"},{"time":66.7,"text":"Và chúng ta vẫn đang thấy sự nỗ lực của các tay đua thuộc 2 ekip Vĩnh Long"},{"time":70.5,"text":"Nhưng tốc độ mà họ tạo ra là không quá lớn"},{"time":74.1,"text":"Còn thấy tốc độ ở trong đoàn đông vị trí dẫn đầu"},{"time":77.1,"text":"Với các tay đua của Vĩnh Long vòng này là không quá cao"},{"time":79.6,"text":"Trong khi Peter Rikunov đã vươn lên vị trí thứ 4"},{"time":82.0,"text":"Ở trong đoàn đông và đó là 1 vị trí chắc chắn là cực kỳ thuận lợi cho anh"},{"time":85.2,"text":"Ở đoàn đông cuối cùng khi mà Roman Makin vẫn đang là người làm nước lớn"},{"time":88.7,"text":"Và bây giờ thì các tay đua đã bắt đầu rẽ vào đoạn đường thẳng cuối cùng"},{"time":94.0,"text":"Để cạnh tranh nước rút"},{"time":95.5,"text":"Và chúng ta chờ xem"},{"time":96.6,"text":"Rồi mà Martin đã tách ra để kéo Peter Rikunov sau lưng"},{"time":99.7,"text":"Cuộc cạnh tranh"},{"time":100.5,"text":"Peter Rikunov đang lao rừng rất nhanh"},{"time":105.6,"text":"Trần Tuấn Kiệt, Martin Las cũng đang rất nỗ lực"},{"time":108.1,"text":"Martin Las"},{"time":110.4,"text":"Martin Las, Trần Tuấn Kiệt, Peter Rikunov"},{"time":113.4,"text":"Trần Tuấn Kiệt hay là Martin Las"},{"time":115.6,"text":"Có lẽ là Trần Tuấn Kiệt thưa quý vị"},{"time":117.3,"text":"Cú đẩy xe có lẽ là của Trần Tuấn Kiệt"},{"time":126.2,"text":"Chúng ta sẽ chờ xem có lẽ Trần Tuấn Kiệt là người đã vượt qua Martin Las trong những bánh xe cuối cùng"},{"time":131.7,"text":"Trong những vòng xe cuối cùng"},{"time":132.8,"text":"Có lẽ là chúng ta sẽ lại ghi nhận thêm một tay đua mới giành chiến thắng ở cấp trường hình thành phố Hồ Chí Minh năm nay"},{"time":140.2,"text":"Và đó sẽ là một cái tên đã đầy đủ rất ấn tượng ở đoạn nước rút mà chúng ta vừa được theo dõi"},{"time":147.9,"text":"Cuộc cạnh tranh giữa những tay đua rất mạnh về nước rút"},{"time":153.2,"text":"Trong các vòng đua thi đấu tại Hồ Hoàng Kiếm trong cấp trường hình thành phố Hồ Chí Minh"},{"time":156.6,"text":"Trần Tuấn Kiệt mới chỉ 1 lần về đích ở vị trí thứ 2"},{"time":159.3,"text":"Ở cuộc đua năm 2022"},{"time":161.7,"text":"Và nếu như Trần Tuấn Kiệt về đích đầu tiên ở trạng đua ngày hôm nay"},{"time":165.5,"text":"Thì đây sẽ là chiến thắng trạng đầu tiên tại Hồ Hoàng Kiếm của tay đua thuộc đội hình Đô Ba Găng Đồng Tháp"},{"time":169.7,"text":"Trạng đua thứ 4 với chiến thắng thuộc về Martin Lars"},{"time":172.3,"text":"Thì ngày hôm nay, khu đẩy xe rất hoàng mục này của Trần Tuấn Kiệt"},{"time":176.7,"text":"Đã giúp anh giành được chiến thắng ở trong trạng đua thứ 5"},{"time":179.6,"text":"Vòng quanh Hồ Hoàng Kiếm của đội hình Đô Ba Găng Đồng Tháp"}]}