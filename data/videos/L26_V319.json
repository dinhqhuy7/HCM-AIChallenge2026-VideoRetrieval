ǎm: 2M · Thc hié · Công ty C"}],"speech":[{"time":57.8,"text":"Được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":61.3,"text":"Và bây giờ Phước Hưng sẽ hướng dẫn cho các bạn chúng ta trộn nhân"},{"time":64.2,"text":"Đầu tiên Phước Hưng sẽ cho phần thịt ngạc xay nhuyễn vào"},{"time":67.2,"text":"Tiếp theo Hưng sẽ cho vào đây giò sống"},{"time":69.2,"text":"Phần bắp mỹ hạt mà chúng ta đã luộc chín rồi"},{"time":71.8,"text":"Đậu hòa lan cũng đã luộc chín rồi luôn"},{"time":74.5,"text":"Phần củ sắn trong phần nhân này thì chúng ta sẽ cắt nhỏ và chắc ráo đi"},{"time":78.4,"text":"Chúng ta sẽ cho củ sắn vào trong nhân"},{"time":80.2,"text":"Để cho giúp phần nhân có độ giòn ngọt khi ăn sẽ ngon hơn"},{"time":83.7,"text":"Hưng sẽ cho vào đây 2 muỗng canh đầu hành trắng bằm"},{"time":86.5,"text":"1 muỗng canh bột năng"},{"time":88.1,"text":"Nửa muỗng canh hạt nêm Aji ngon heo"},{"time":90.3,"text":"Một muỗng cà phê bột ngọt Aji no moto"},{"time":92.9,"text":"Và một ít tiêu"},{"time":94.2,"text":"Trong nhân hoàn thánh ngày hôm nay Phước Hương sẽ cho vào một ít dầu mè để tạo điểm dấn cho món ăn"},{"time":98.3,"text":"Khi ăn thì món ăn sẽ thơm và ngon hơn"},{"time":100.7,"text":"Và cuối cùng là một ít lòng trắng trứng để tăng thêm độ kết dính cho phần nhân"},{"time":105.8,"text":"Trộn đều lên"},{"time":108.0,"text":"Này cái nhân bây giờ nó rất là dai nè"},{"time":110.1,"text":"Rất là chặt"},{"time":111.3,"text":"Và bây giờ Phước Hương sẽ bắt lên trên bếp một cái chảo dầu để chúng ta chiêu hoàn thánh"},{"time":115.3,"text":"Trong khi mà chúng ta đang đợi phần dầu nóng thì Phước Hưng sẽ hướng dẫn cho quý vị chúng ta sẽ tạo hình cho phần hoàng thánh"},{"time":120.5,"text":"Hưng sẽ cho phần nhân vào, chúng ta sẽ cho ít thôi vì nhân khi chiên thì nó sẽ nở ra nữa"},{"time":125.3,"text":"Sẽ dùng lòng đỏ trứng này, chúng ta sẽ dùng lòng đỏ trứng gà để dán mý hoàng thánh để tạo hình dễ và đẹp hơn"},{"time":135.1,"text":"Như vậy là chúng ta tạo hình như một cái thỏi vàng nhỏ nhỏ đúng không nào?"},{"time":138.6,"text":"Đúng rồi"},{"time":139.0,"text":"Minh Phương cũng làm thử xem nha"},{"time":141.2,"text":"Rồi chúng ta cho nhân vào"},{"time":142.3,"text":"Chỉ một ít thôi đúng không nào?"},{"time":144.1,"text":"Bây giờ thì sẽ dùng lòng đỏ trứng gà để gấp mí lại"},{"time":160.4,"text":"Như vậy là Minh Phương cũng có một cái thỏi vàng rồi"},{"time":162.5,"text":"Đúng rồi"},{"time":163.3,"text":"Chúng ta cho lên đó đi"},{"time":166.1,"text":"Tùy theo sở thích thì chúng ta có thể"},{"time":168.5,"text":"Những cái tạo hình khác mà chúng ta yêu thích hay không"},{"time":170.6,"text":"Đúng rồi, theo ý thích của mình"},{"time":182.2,"text":"Bây giờ thì phần dầu cũng đã nóng rồi"},{"time":184.5,"text":"Phước Hương sẽ lần lượt cho Hoàng Thánh vào chúng ta chiều"},{"time":191.8,"text":"Đẹp quá"},{"time":192.2,"text":"Wow, đẹp quá"},{"time":195.4,"text":"Sau khi mà có vị chúng ta cho hoàng thánh vào trong dầu rồi chúng ta chiên lửa vừa"},{"time":199.7,"text":"Đến khi nào mà vàng đều bên ngoài là được"},{"time":205.7,"text":"Bây giờ chúng ta sẽ coi cái nào vàng là chúng ta chở mặt nó một tí xíu nè"},{"time":209.7,"text":"Những cái miếng hoàng thánh giòn, vàng rụng, va vào nhau"},{"time":213.3,"text":"Nghe rất là hấp dẫn"},{"time":214.4,"text":"Bây giờ thì đã có một cái màu cánh dáng rất là đẹp rồi nè"},{"time":217.4,"text":"Phương Hương sẽ lần lượt chúng ta vớt ra"},{"time":219.1,"text":"Phương sẽ tắt bếp nha"},{"time":220.6,"text":"Rồi, bây giờ chúng ta sẽ cho ra một cái giấy thấp dầu"},{"time":226.2,"text":"Và bây giờ chúng ta sẽ trình bài ra nè"},{"time":228.5,"text":"Sẽ có một ít salad khi ăn thì sẽ rất là ngon"},{"time":236.9,"text":"Hương sẽ cho lên đây một cọng ngò để tăng thêm màu xanh cho món ăn"},{"time":240.9,"text":"Đối với một món chiên thì không bao giờ thiếu được một món sốt chấm"},{"time":244.5,"text":"Và đặc biệt món hoàn thánh ngày hôm nay"},{"time":246.6,"text":"Không thể thiếu món nước chấm đó là sốt bayona azimayo ngọt dịu"},{"time":250.5,"text":"Phương Hương sẽ cho vào đây"},{"time":253.2,"text":"Cách làm vô cùng đơn giản kết hợp với các nguyên liệu với nhau"},{"time":256.3,"text":"Minh Phương nghĩ rằng quý vị khán giả hãy thử làm món ăn này và thưởng thức hương vị của nó nha"},{"time":260.5,"text":"Và đối với một món chiên ngày hôm nay thì các bạn có thể kết hợp với món salad dầu giấm thì sẽ rất là tuyệt vời"},{"time":266.7,"text":"Hoành thánh xốp giòn, ôm trọn phần nhân đậm đà, sen lẫn vị bùi bùi của đậu Hà Lan, ngọt giòn của củ sắn và bắp"},{"time":274.9,"text":"Chấm thêm một chút sốt mayonaise azimayo ngọt dịu thì ai ai cũng phải trầm trồ suýt xoa"},{"time":281.1,"text":"Những món ngon không hề khó để tìm, chỉ cùng theo dõi món ngon mỗi ngày để biết được những món ngon hấp dẫn cho gia đình của mình"},{"time":287.8,"text":"Để xem lại công thức cũng như những thông tin hữu ích từ chương trình"},{"time":290.8,"text":"Quý vị và các bạn có thể theo dõi kênh youtube, website và fanpage của chương trình"}]}