k° · Thc hié"}],"speech":[{"time":23.7,"text":"Không biết là mình có cái món ăn gì mà kết hợp với củ sắn được không cô?"},{"time":27.1,"text":"Hôm nay cô chuẩn bị cho em một món"},{"time":29.1,"text":"Nhưng mà không có chuẩn bị củ sắn"},{"time":31.5,"text":"Thôi mà thôi nhân cái em yêu cầu như vậy"},{"time":33.4,"text":"Thì bây giờ mình cho thêm củ sắn vô"},{"time":34.8,"text":"Tôi nghĩ là sẽ rất là ngon"},{"time":36.2,"text":"Mở tủ lạnh lấy củ sắn thêm ra dùm cô đi"},{"time":38.7,"text":"Có liền cô"},{"time":41.7,"text":"Bánh tôm chiên củ sắn"},{"time":43.3,"text":"Giòn rụng ngọt ngay"},{"time":62.1,"text":"Chương trình Món Ngon Một"},{"time":63.7,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":67.9,"text":"Bây giờ thì cô sẽ cắt cái phần thịt này"},{"time":70.7,"text":"Cắt thành những cái miếng nhỏ nhỏ"},{"time":72.4,"text":"Cái này những thành phần hơi giống với món bánh tôm đúng không cô?"},{"time":75.7,"text":"Nhưng mà lại có củ sắn"},{"time":77.2,"text":"Cái sự kết hợp này đúng là lạ lùng ghê luôn"},{"time":79.5,"text":"Mình sẽ cho vào đây 1 phần 3 muỗng cà phê tiêu"},{"time":82.2,"text":"1 muỗng cà phê hành tím băm"},{"time":84.1,"text":"1 muỗng cà phê tỏi băm"},{"time":86.2,"text":"Rồi mình trộn đều"},{"time":87.6,"text":"Sẽ đặt 1 cái chảo nhỏ nhỏ lên trên bếp nha"},{"time":90.0,"text":"Cho vào đây 1 ít dầu ăn"},{"time":91.6,"text":"Dầu nóng thì bây giờ chúng ta sẽ cho tỏi vào trong dầu mình phi cho thơm"},{"time":95.3,"text":"Tôm khô sau khi mua về thì các bạn lưu ý là chúng ta sẽ ngâm vào trong nước nóng"},{"time":99.6,"text":"Sau đó thì mình sẽ giả cho nó bể ra như thế này"},{"time":102.4,"text":"Rồi em tắt lửa giúp cô đi"},{"time":105.0,"text":"Rồi mình sẽ trút ra dĩa này"},{"time":106.8,"text":"Chúng ta chọn củ sắn thì chúng ta lưu ý là chúng ta sẽ chọn củ sắn"},{"time":111.2,"text":"Có cái vỏ mà nó hơi màu đen đen nâu nâu"},{"time":114.8,"text":"Là những củ sắn già thì nó sẽ ít nước"},{"time":117.3,"text":"Như vậy thì bánh mình sẽ giòn lâu hơn ha"},{"time":119.8,"text":"Cắt sợi sau đó mình cắt khúc lại"},{"time":121.5,"text":"Và mình sẽ trộn vô một chút xíu muối và một chút xíu đường"},{"time":124.8,"text":"Giác ráo nước thì chúng ta sẽ được phần củ sắn như thế này"},{"time":127.1,"text":"Trộn một nửa tôm khô này với lại củ sắn"},{"time":129.8,"text":"Cái mùi tôm khô bốc lên thơm quá cô ơi"},{"time":132.1,"text":"Đúng rồi"},{"time":133.1,"text":"Để pha bột thì đầu tiên chúng ta sẽ đập 2 quả trứng gà vào chén"},{"time":136.5,"text":"Em giúp cô là em khuấy 2 quả trứng gà này lên đi ha cô ta"},{"time":139.9,"text":"Chúng ta sẽ dùng 2 gói gia vị nêm sẵn aji quyết bột chiên giòn"},{"time":143.4,"text":"Rồi mình sẽ cho vào trong tô"},{"time":146.4,"text":"Cho tiếp vào đây là 200ml nước"},{"time":149.2,"text":"Cô sẽ pha bột hơi đặc hơn so với lại công thức hướng dẫn trên bao bì"},{"time":153.3,"text":"Chúng ta sẽ cho trứng gà vô trộn chung với phần bột này luôn ha"},{"time":156.6,"text":"Bột bánh mà còn có trứng gà nữa thì lúc nào cũng làm cho bánh được béo hơn đúng không cô?"},{"time":161.1,"text":"Đúng rồi"},{"time":161.5,"text":"Cái vị rất là ngon luôn"},{"time":163.0,"text":"Thì bây giờ mình sẽ cho thêm vào trong bột này gồm có bắp mà mình đã nấu chín rồi"},{"time":168.0,"text":"Hẹ lá, mình cắt khúc, tôm khô thì mình cũng sẽ cho vào đây luôn"},{"time":171.8,"text":"Ơt, cắt sợi"},{"time":173.2,"text":"Chúng ta sẽ thêm bắp, hẹ, ớt v.v. vào trong món ăn để giúp cân bằng dinh dưỡng và đồng thời cũng tăng hương vị cho món ăn nữa"},{"time":180.9,"text":"Và để làm cho món bánh này thì chúng ta sẽ cần 2 cái vá"},{"time":184.6,"text":"Như thế này chúng ta sẽ làm nóng khuôn trước khi chiên"},{"time":187.7,"text":"Giúp bánh sẽ dễ tróc ra nha"},{"time":189.7,"text":"Mình sẽ cho vào đây một lớp bột tráng đều xung quanh"},{"time":192.8,"text":"Tiếp theo thì mình sẽ đặt lên đây thịt"},{"time":194.5,"text":"Rồi một ít củ sắn và tôm khô"},{"time":196.9,"text":"Sẽ múc lên đây thêm một lớp bột nữa"},{"time":199.5,"text":"Rồi trên cùng thì mình sẽ đặt hai con tôm"},{"time":202.4,"text":"Một miếng ớt hình tăm giác"},{"time":204.1,"text":"Khi mình cho xong hết thì bây giờ mình bắt đầu bỏ bánh vào trong chảo dầu nha"},{"time":209.3,"text":"Bỏ cái khung bánh vô nghe tiếng bánh xèo xèo"},{"time":212.8,"text":"Thiệt là đói bụng luôn á mọi người"},{"time":214.2,"text":"Đặt vô xong rồi mình bắt đầu mình chỉnh lại"},{"time":218.4,"text":"Quá đẹp luôn, hình trái tim"},{"time":220.2,"text":"Rồi một miếng ớt, mình lại cho cái khuôn thứ hai vào trong cái chảo vào"},{"time":224.5,"text":"Đối với lại món bánh này thì mình chiên lửa vừa vừa thôi"},{"time":227.0,"text":"Để cho bột chín tới ở bên trong bột luôn ha"},{"time":229.8,"text":"Chứ mình đừng có chiên lửa lớn quá"},{"time":231.6,"text":"Cái nào mà nó chín nó vàng thì em sẽ gắp ra"},{"time":235.9,"text":"Wow, quá đẹp"},{"time":237.1,"text":"Rồi bây giờ thì chúng ta làm một khâu rất là quan trọng và cần thiết trong món ăn ngày hôm nay"},{"time":240.8,"text":"Đó là pha sốt"},{"time":241.6,"text":"Cho 2 muỗng canh sốt mayonnaise aji mayo"},{"time":244.1,"text":"Cùng với 2 muỗng canh tương ớt"},{"time":246.4,"text":"Mình sẽ trộn đều lên"},{"time":247.8,"text":"Cái cuối cùng luôn ha"},{"time":251.7,"text":"Rồi bây giờ thì chúng ta sẽ trình bày món ăn này ra đĩa ha"},{"time":255.5,"text":"2 cái"},{"time":257.5,"text":"Để cho thêm màu sắc thì mình sẽ cho vào đây 1 miếng salad thôi"},{"time":261.9,"text":"Và để có 1 bữa ăn hoàn chỉnh thì chúng ta có thể kết hợp với món salad xanh và súp ốc heo tóc tiên"},{"time":268.0,"text":"Chiếc bánh nhỏ xinh được chiên vàng ruộng giòn tan"}]}