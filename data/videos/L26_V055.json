5,"text":"Các bạn lưu ý là chúng ta sẽ dùng dao hoặc kéo"},{"time":87.9,"text":"Chúng ta sẽ khứa hoặc là nhấp nó ra"},{"time":89.7,"text":"Cho nó mỏng một chút"},{"time":91.1,"text":"Chúng ta sẽ khứa khứa mỏng cho nó mỏng bớt như thế này"},{"time":93.5,"text":"Chúc mình chiên sẽ không mất nhiều thời gian"},{"time":95.3,"text":"Với lại gia vị nó sẽ thấm vào trong cái muống thịt này nhiều hơn"},{"time":98.9,"text":"Lá chanh sắc sợi"},{"time":100.4,"text":"Đó để trang trí"},{"time":101.7,"text":"Còn bây giờ thì em sẽ băm"},{"time":110.8,"text":"Bây giờ chúng ta sẽ cho vào trong cái tô để mình ướp gia vị"},{"time":114.9,"text":"Chúng ta sẽ ướp vào trong cánh gà này 1 muỗng cà phê lá chanh băm"},{"time":118.3,"text":"Nửa muỗng canh ớt sơn băm"},{"time":120.7,"text":"Chúng ta nên tẩm thêm ớt băm và lá chanh băm"},{"time":123.8,"text":"Để cánh gà thơm mùi đặc trưng nha"},{"time":125.7,"text":"Bây giờ thì Tướng giúp cô tiếp là mình sẽ bắt lên trên bếp một cái chảo dầu"},{"time":129.4,"text":"Dạ"},{"time":130.9,"text":"Tiếp tục cho vào đây gia vị nêm sẵn"},{"time":133.5,"text":"Acid fit bột tẩm khô chiên giò"},{"time":135.1,"text":"Mình sẽ cho một gói bột vô lên đây"},{"time":137.5,"text":"Rất là tiện dụng khi mình sử dụng bột này"},{"time":139.5,"text":"Vì mình không có đắn đo là phải thêm mỗi loại gia vị bao nhiêu đúng không?"},{"time":143.4,"text":"Dạ"},{"time":143.7,"text":"Có gia vị sẵn rồi, rất là dừa ăn"},{"time":145.6,"text":"Trước khi mình chiên gà thì chúng ta sẽ chiên lá chanh trước nha các bạn"},{"time":148.6,"text":"Các bạn lưu ý là chúng ta sẽ lau khô lá chanh nha"},{"time":151.1,"text":"Thì nó sẽ dễ bị găng dầu"},{"time":152.6,"text":"Các bạn lưu ý là chúng ta sẽ chiên lá chanh trước khi chiên cánh gà"},{"time":156.3,"text":"Để dầu thơm thì khi đó món ăn sẽ ngon hơn"},{"time":159.1,"text":"Vừa mới bỏ vô thôi là thơm lưng luôn ngay ngăn bếp"},{"time":161.8,"text":"Chỉ chiên vậy thôi, sau đó thì mình sẽ dớt ra"},{"time":166.2,"text":"Tiếp tục chúng ta sẽ cho cánh gà vào chiên nha"},{"time":168.3,"text":"Cái cánh tỏi gà mình sẽ cho vô chiên trước"},{"time":170.5,"text":"Bởi vì cái đó là phần lâu chín nhất"},{"time":171.8,"text":"Đúng rồi, nó hơi lâu chín hơn"},{"time":176.3,"text":"Giờ cô sẽ cho cái phần cánh vô"},{"time":178.6,"text":"Đối với món ăn này thì thời gian chiên rất nhanh"},{"time":180.9,"text":"Cho nên là chúng ta sẽ sử dụng cánh gà công nghiệp"},{"time":184.0,"text":"Nó sẽ phù hợp hơn"},{"time":185.7,"text":"Rất là nhanh chóng, màu vàng nè"},{"time":187.7,"text":"Với azikut bột tẩm khô chiên giòn là nó vừa vị luôn"},{"time":191.1,"text":"Mà nó lại vừa ra màu đẹp nữa"},{"time":192.8,"text":"Đúng rồi, bởi vì nó có gia vị sẵn trong đó rồi"},{"time":195.0,"text":"Nên màu chiên nó lên màu rất là đẹp"},{"time":196.8,"text":"Với món ăn này thì lần đầu tiên chúng ta chiên"},{"time":199.5,"text":"Là chúng ta chiên nó chín tới màu vàng sáng và non non thôi"},{"time":202.5,"text":"Thì mình vớt ra"},{"time":203.2,"text":"Chúng ta nên chiên 2 lần để giữ độ giòn cho món ăn"},{"time":206.4,"text":"Lần 2 này thì mình sẽ chiên lửa lớn cô ha"},{"time":209.1,"text":"Và chiên rất nhanh cô ha"},{"time":210.0,"text":"Đúng rồi, mình chiên nhanh thôi"},{"time":213.7,"text":"Ồ, âm thanh của sự hấp dẫn."},{"time":219.2,"text":"Đó, như vậy này được rồi nè."},{"time":220.5,"text":"Cô vớt ra nè, thấy chưa?"},{"time":221.7,"text":"Nè, em thấy những cái này cũng bắt đầu vàng."},{"time":223.2,"text":"Đúng rồi, cái nào thấy chính vàng màu đẹp rồi thì mình sẽ vớt ra."},{"time":226.9,"text":"Thơm lừng, giòn rụng."},{"time":229.4,"text":"Muốn làm món ăn này thì ngay bây giờ các bạn hãy quét mã QR đang xuất hiện trên màn hình."},{"time":233.5,"text":"Chúng ta sẽ có ngay công thức để thực hiện tại nhà nha."},{"time":237.8,"text":"Bây giờ thì chúng ta sẽ ra món ha."},{"time":239.7,"text":"Rất là đơn giản, chúng ta sẽ đặt những cái cánh gà lên."},{"time":242.8,"text":"Và mấy món này là món chiên cho nên là mình ăn kèm"},{"time":246.2,"text":"Thì mình sẽ ăn với lại các loại rau tươi"},{"time":249.1,"text":"Như là cà chua, rau mầm"},{"time":252.5,"text":"Mình sẽ trang trí lên đây"},{"time":254.3,"text":"Lá chanh nữa, nãy mình đã chiên"},{"time":256.3,"text":"Sẽ rắc thêm lên trên này một ít lá chanh"},{"time":259.2,"text":"Cắt sợi, ớt sườn băm"},{"time":262.6,"text":"Mình sẽ chấm với sốt mayonaise"},{"time":265.0,"text":"Aji mayo vị ngọt dịu"},{"time":266.6,"text":"Như vậy là mình có một món chiên này"},{"time":268.5,"text":"Em nghĩ là mình phải cần thêm những món"},{"time":270.4,"text":"Ví dụ như là nước"},{"time":271.6,"text":"Để mình làm cho cái bữa ăn mình nó hoàn chỉnh hơn"},{"time":274.0,"text":"Cô nghĩ ra ngay luôn đó Tuấn"},{"time":275.4,"text":"Chúng ta sẽ ăn kèm món này cùng với canh bí đỏ hạnh nhân nha các bạn"},{"time":279.7,"text":"Cánh gà áo một lớp bột giòn tan"},{"time":282.2,"text":"Bên trong mềm mọng"},{"time":284.3,"text":"Thơm mùi lá chanh và ớt sừng"},{"time":286.1,"text":"Cùng với chút bèo béo của mayonaise"},{"time":288.7,"text":"Cắn là mê, ăn là ghiêng"},{"time":292.0,"text":"Cánh gà chiên lá chanh"},{"time":293.6,"text":"Bên ngoài thì vàng giòn"},{"time":295.1,"text":"Bên trong thì mềm mịn mọng nước"},{"time":297.4,"text":"Cả gia đình ai cũng sẽ mê món này"},{"time":299.8,"text":"Và các bạn lâu lâu muốn làm một món ăn nhanh và ngon như vậy"},{"time":302.7,"text":"Thì ngay lập tức có thể truy cập vào trong Youtube, Website và Fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":307.8,"text":"Để chúng ta có thể thực hiện ngay tại nhà rất nhiều những món ngon của Món Ngon Mỗi Ngày"},{"time":312.3,"text":"Chúc các bạn thành công nha"}]}