l":254.8,"text":"AJINOMOTO · Eat Well, Live Well. · moingày"},{"time":261.2,"until":264.7,"text":"AJINOMOTO · NEM, · Onl · NGON HON · Eat Well, Live Well. · CHÀ, · GIÒ THÙ · KHI THUONG THÚC · moingày · CÙNG · CHÁ, · CÚNG"},{"time":265.7,"until":269.3,"text":"Thanh chua · Giòn giòn · Ngòn ngot · Tharhchu。"},{"time":271.8,"until":274.8,"text":"Kliang"},{"time":275.0,"until":280.8,"text":"AJINOMOTO · mingay · HOMOTO · Eat Well. Live Well. · Eat Wes, Live · AJINOMC · 4JINOM"},{"time":281.0,"until":283.1,"text":"AJINOMOTO · Eat Well, Live Well. · moingày · MON"},{"time":283.3,"until":287.8,"text":"Youtube · Website · XEMKY · Fanpage Facebook · wwwmonngonmoingay. · Món Ngon Mi Ngày · moingay · CÁC BUÓC NÁU · CÁC BUOC NÃU ÀN:"},{"time":291.0,"until":299.7,"text":"Tham gia · Nguyên liu · Công ty Ajinomoto Vit Nam · Công ty Chuo Senko Vit Nam · Tham gia thc hin · Dua chut: 500g · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Công ty HKFilm · Ot hiém xanh đò: 10 trái · Gim go lên men LISA · Phi hp thc hin · cúa cóng ty AJINOMOTO · Duòng phèn: 100g · Thc hin chương trình · Hat ngò tuoi · Công ty A · Gùng: 40g · Dua kiu dàngám: 50g · DÀI TRUYÊN HìNH TP. HCM · chuơng trình thuc · Nuc tuong “Phú Si” · Thc hié · fiang"}],"speech":[{"time":14.4,"text":"Mua có một cái hũ mà mua gì hai ba cái"},{"time":17.9,"text":"Cô đừng có lo, từ ngày làm món ngon mỗi ngày lúc nào em cũng chuẩn bị đầy đủ các kích cỡ luôn"},{"time":23.6,"text":"Cô muốn hũ to cũng có, muốn hũ nhỏ cũng có"},{"time":26.0,"text":"Rồi, cô sử dụng hũ nhỏ, còn cái hũ to đó là bữa nào là làm mấy món ngâm chua để tặng bạn bè, trong đó có cô nữa nha"},{"time":32.4,"text":"Rồi, vậy thì hôm nay chúng ta sẽ sử dụng một cái hũ nhỏ nhỏ này cùng với lại dưa chuột"},{"time":36.6,"text":"Chúng ta sẽ làm một món dưa ngâm chua để ăn vào dịp Tết này nha"},{"time":40.5,"text":"Nhất trí"},{"time":43.5,"text":"Dưa chuột ngâm giấm, chua ngon mộc mạc, đậm vị sắc xuân"},{"time":63.3,"text":"Chào mừng các bạn đang đến với chương trình Món ngon mỗi ngày"},{"time":66.0,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":69.8,"text":"Mình sẽ chẽ dọc những trái dưa ra làm đôi"},{"time":71.7,"text":"Mình có biết quyết gì để cho món dưa ngâm này nó được giòn ngon hơn không cô?"},{"time":75.5,"text":"Các bạn lưu ý là chúng ta sẽ chọn những quả dưa nhỏ nè"},{"time":79.1,"text":"Có kích cỡ đều nhau và còn non"},{"time":80.9,"text":"Có ít ruột thì món dưa nó sẽ giòn hơn"},{"time":83.3,"text":"Cắt xong rồi"},{"time":84.1,"text":"Thì bây giờ chúng ta sẽ ướp một ít đường và muối vào đây"},{"time":87.3,"text":"Chúng ta sẽ cho vào đây 2 muỗng canh đường, 1 muỗng cà phê muối"},{"time":92.6,"text":"Sau đó thì mình sẽ trộn đều"},{"time":94.4,"text":"Và chúng ta sẽ để cho dưa thấm gia vị khoảng chừng 30 phút"},{"time":98.4,"text":"Tiếp theo thì chúng ta sẽ cắt lát gừng"},{"time":103.4,"text":"Ớt, ở đây thì chúng ta sẽ sử dụng 2 màu ớt"},{"time":106.2,"text":"Ớt đỏ và ớt xanh nữa"},{"time":108.0,"text":"Ấn cho cái ớt nó hơi dập xuống để hồi mình ngâm nó sẽ có mùi thơm"},{"time":111.9,"text":"Và bây giờ thì chúng ta sẽ tiến hành nấu hỗn hợp giấm"},{"time":114.7,"text":"Đầu tiên chúng ta sẽ cho nửa chén nước"},{"time":116.5,"text":"Tiếp theo chúng ta sẽ cho vô 2 chén giấm gạo lên men Liza của công ty Ajinomoto"},{"time":120.7,"text":"Đó là khoảng 400ml tức là 2 chén"},{"time":123.2,"text":"Mình sẽ cho vào đây 1 muỗng cà phê muối, 2 muỗng canh nước tương phú sỉ"},{"time":129.5,"text":"Và 100g đường phèn"},{"time":131.1,"text":"Chúng ta sẽ nấu cho đến khi mà đường phèn tan hết"},{"time":134.2,"text":"Khi mà đường tan rồi thì bây giờ mình sẽ cho gừng và ớt vào mình nấu thêm 3 phút nữa"},{"time":138.9,"text":"Ủa mà bình thường em thấy các món ngâm chua đâu có gừng đâu ta"},{"time":142.0,"text":"À đối với món ngâm chua thì chúng ta lưu ý là chúng ta sẽ cho thêm 1 ít gừng"},{"time":146.6,"text":"Để tạo hương vị và để giúp cái cân bằng cho món ăn nữa"},{"time":149.8,"text":"Rồi, mình cũng cho thêm hạt ngò vào đây luôn nha"},{"time":153.3,"text":"Sau đó thì mình sẽ nấu sôi lên để cho gừng, ớt cũng như là hạt ngò thơm"},{"time":157.4,"text":"Mình nấu khoảng chừng 3 phút"},{"time":158.7,"text":"Nước sôi rồi em tắt lửa nha cô"},{"time":160.2,"text":"Rồi, cắt đi cảm ơn em"},{"time":161.5,"text":"Và cô đã dớt cái phần dưa ra để cho dưa thật ráo nước"},{"time":165.8,"text":"Các món ngâm chua thì chúng ta cần phải làm ráo nước nguyên liệu"},{"time":169.4,"text":"Bằng cách là chúng ta sẽ hơi ngắn"},{"time":171.6,"text":"Ở đây thì mình sẽ chọn cái phương án là mình ướp muối đường và mình để thật ráo"},{"time":175.8,"text":"Thì như vậy mình ngâm xong á, thì cái phần ngâm chua nó sẽ không có bị ủng, nó không có bị mềm, món ăn sẽ ngon hơn"},{"time":182.1,"text":"Và bây giờ thì chúng ta hãy chờ cho nước nguội rồi sau đó mình sẽ cho vào trong hũ cùng với lại dưa ha"},{"time":189.8,"text":"Bỏ cái phần dưa này vào trong cái hũ ha, đầu tiên mình dựng lên như vầy cho nó đẹp"},{"time":195.1,"text":"Khi mà mình chọn những cái quả dưa nó bằng nhau á, cái mình để vô trong hũ thì nó sẽ đều đều với nhau, nhìn nó rất là đẹp"},{"time":201.8,"text":"Mình xen vào trong đây là ớt và củ kiệu ha, gừng chẳng hạn"},{"time":208.2,"text":"Đây em biết cái này là gì không"},{"time":211.2,"text":"Sao tự nhiên mình ngâm chua"},{"time":212.8,"text":"Mà còn có cắm bông cắm hoa nữa vậy cô"},{"time":214.7,"text":"À cái này thật ra đây là hoa"},{"time":216.9,"text":"Và trái của cái ngò đó"},{"time":219.2,"text":"Mẹ tôi nói hạt ngò đó em"},{"time":220.8,"text":"Là cây ngò rí đó"},{"time":222.6,"text":"Lần đầu tiên em mới thấy luôn đó"},{"time":225.2,"text":"Cuối cùng thì mình sẽ múc nước"},{"time":227.1,"text":"Mình chế vô"},{"time":227.9,"text":"Màu nước giấm rất là đẹp luôn"},{"time":229.8,"text":"Thơm mùi hạt ngò và cả một ít gừng nữa"},{"time":233.0,"text":"Chắc chắn là món ngâm chua này"},{"time":234.7,"text":"Sẽ rất là bắt miệng đây"},{"time":236.0,"text":"Mình nhớ là mình đợi nước thật cho nguội rồi thì mình mới chế vô đây nha"},{"time":240.2,"text":"Các bạn lưu ý là chúng ta sẽ dằn dưa để dưa ngập trong nước"},{"time":243.6,"text":"Như vậy thì dưa mới giòn"},{"time":244.8,"text":"Và chúng ta có thể sử dụng một dụng cụ nào đó mình dằn lại cũng được"},{"time":249.5,"text":"Đối với món dưa này nè"},{"time":250.8,"text":"Đặc biệt là chúng ta có thể sau 3 giờ là chúng ta đã có thể dùng được"},{"time":254.7,"text":"Nhưng mà nếu như mình chưa dùng ngay"},{"time":256.7,"text":"Mình sẽ bỏ vào trong ngăn mát tủ lạnh"},{"time":258.9,"text":"Sau 2 ngày chắc chắn dùng sẽ rất là ngon"},{"time":260.9,"text":"Món này thì chúng ta thường dùng ăn kèm với các loại nem chả trong ngày Tết"},{"time":265.5,"text":"Dưa chuột ngâm giòn giòn ngọt ngọt, thanh chua, bung tỏa trong hương thơm của giấm"},{"time":270.2,"text":"Thoảng nhẹ chút nước tương, vị Tết, vị xuân ngập tràn trong mâm cổ"},{"time":274.7,"text":"Xuân đang về, Tết đang gõ cửa"},{"time":276.6,"text":"Còn chần chờ gì nữa mà không vào bếp thực hiện món dưa chuột ngâm giấm để cùng thưởng thức"},{"time":280.8,"text":"Để xem thêm những công thức của chương trình"},{"time":283.0,"text":"Các bạn hãy truy cập vào Youtube, Website và Fanpage theo địa chỉ sau đây"}]}