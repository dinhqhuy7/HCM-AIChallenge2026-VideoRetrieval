{"time":44.5,"text":"Chào Kim Thảo, chúng ta thấy trên bàn bếp chúng ta ngày hôm nay rất là nhiều rau củ quả, salad nữa."},{"time":51.0,"text":"Em đoán ngay món chúng ta hôm nay là gì đúng không?"},{"time":54.2,"text":"Đúng rồi, đó là một món salad."},{"time":56.1,"text":"Salad sẽ có rất nhiều các loại rau củ."},{"time":58.5,"text":"Và ngày hôm nay Kim Thảo thấy là món nào cũng ngon, rất là cũng tươi"},{"time":61.5,"text":"Và có một điều đặc biệt hơn nữa"},{"time":63.9,"text":"Món ăn ngày hôm nay đầu bếp Thanh Vũ"},{"time":66.0,"text":"Sẽ giới thiệu cho tất cả quý vị và các bạn"},{"time":67.8,"text":"Phù hợp cho những ai đang ăn chế độ thô đấy ạ"},{"time":70.5,"text":"Đúng vậy"},{"time":71.0,"text":"Nào bây giờ chúng ta cùng nhau thực hiện món salad trứng"},{"time":74.9,"text":"Rồi bây giờ salad Kim Thảo"},{"time":76.4,"text":"Cắt làm đôi theo chiều dọc"},{"time":77.6,"text":"Sau đó em xoay lại"},{"time":78.4,"text":"Chúng ta cắt miếng khoảng 5cm"},{"time":81.2,"text":"Cho vừa lại"},{"time":83.3,"text":"Phần xe tóc tím cho màu sắc luôn"},{"time":85.1,"text":"Chúng ta cắt làm đôi theo chiều dọc luôn các bạn"},{"time":92.8,"text":"Rồi Duy Lê bây giờ nhờ Kim Thở cắt thành hình nửa văn trăng"},{"time":104.2,"text":"Hành tây chúng ta còn khoảng nửa củ"},{"time":105.9,"text":"Chúng ta bồng hành tây"},{"time":106.9,"text":"Chúng ta ướp ở đây khoảng nửa muỗng cà phê đường trước"},{"time":114.1,"text":"Chúng ta nên ướp hành tây trước với ít đường để hành tây bớt mù hăng"},{"time":117.8,"text":"Còn cà rốt thì chúng ta cắt sợi"},{"time":125.7,"text":"Cà chua bi chúng ta cắt đôi các bạn"},{"time":128.6,"text":"Ngày hôm nay có cà chua bi rồi cả cà rốt nữa"},{"time":131.8,"text":"Sẽ cung cấp được lượng vitamin A, vitamin C rất là tốt cho sức khỏe"},{"time":135.5,"text":"Và một món salad chắc chắn sẽ rất thanh mát"},{"time":137.5,"text":"Bơ là một loại nguyên liệu mà cung cấp cho chúng ta chất béo không bảo hòa"},{"time":142.5,"text":"Và tốt cho tim mạch cũng như là có nhiều chất chống oxy hóa"},{"time":145.4,"text":"Chúng ta cắt nhỏ"},{"time":155.5,"text":"Thưa các bạn chúng ta nên chọn rau củ nhiều màu sắc để ăn bắt bắt hơn và được nhiều dinh dưỡng hơn nha các bạn"},{"time":161.1,"text":"Trứng gà luộc, cá cơm, đôi"},{"time":164.0,"text":"Cho trứng vô trong, đồ hành"},{"time":166.0,"text":"Bây giờ thì chúng ta sẽ pha nước trộn các bạn"},{"time":168.8,"text":"Chúng ta cho đây nửa muỗng cà phê muối"},{"time":170.9,"text":"Một phần tư muỗng cà phê tiêu"},{"time":173.4,"text":"Một muỗng cà phê đường"},{"time":175.4,"text":"2 muỗng canh giám gạo lên men"},{"time":177.1,"text":"Ajinomoto"},{"time":179.7,"text":"Và cuối cùng chúng ta sẽ cho vào đây"},{"time":181.7,"text":"5 muỗng canh sốt marionette"},{"time":183.6,"text":"Ajinomoto vị nguyên bản"},{"time":186.3,"text":"Các bạn nhớ chúng ta nên pha nước sốt trước"},{"time":188.6,"text":"Sau đó mới cho trứng vào trộn"},{"time":190.2,"text":"Như vậy trứng sẽ ít bị tắt lòng ra hơn"},{"time":192.4,"text":"Bây giờ chúng ta sẽ cho vào trong"},{"time":194.4,"text":"Trứng và hành tây chúng ta trộn đều"},{"time":201.2,"text":"Với món salad trứng ngày hôm nay"},{"time":202.9,"text":"Thì nguyên liệu chính đó chính là trứng gà"},{"time":205.1,"text":"Đúng không ạ? Rất bổ dưỡng cho sức khỏe"},{"time":207.1,"text":"Lòng trắng trứng thì ăn tốt cho sức khỏe"},{"time":209.3,"text":"Còn lòng đỏ trứng gà thì có chất choline giúp cho chúng ta giảm cảm giác là bị đói, bị thèm ăn"},{"time":215.0,"text":"Để có thể xem lại công thức thì rất đơn giản"},{"time":217.4,"text":"Quý vị chỉ cần quét mã QR trên mạng hình của chúng tôi"},{"time":222.1,"text":"Rồi, bây giờ chúng ta sẽ ra món nha các bạn"},{"time":226.2,"text":"Đủ màu sắc luôn ạ"},{"time":227.5,"text":"Đúng rồi"},{"time":229.8,"text":"Cho cải mầm vô"},{"time":231.4,"text":"Cho bơ vào"},{"time":236.6,"text":"Chúng ta sẽ để cái phần trứng còn lại lên"},{"time":239.9,"text":"Dạ, chúng ta chuẩn bị dọn tiệt lên được rồi ạ"},{"time":244.2,"text":"Thơm quá anh Vũ ơi"},{"time":247.0,"text":"Nhìn cái trứng lên"},{"time":249.5,"text":"Rồi bây giờ chúng ta sẽ bắt dứt dắt"},{"time":251.1,"text":"Sốt marionette aji mayo"},{"time":252.5,"text":"Vì nguyên bản"},{"time":258.6,"text":"Thưa các bạn thấy là chúng ta đã hoàn thành xong món"},{"time":261.0,"text":"Xà lá trứng rất là bắt mắt"},{"time":263.2,"text":"Nhiều màu sắc đúng không nào"},{"time":264.2,"text":"Và thưa các bạn món xà lá trứng rồi thì chúng ta nên kết hợp"},{"time":267.1,"text":"Với một món đạm đi ha"},{"time":269.3,"text":"Và trứng gà thì chúng ta nên cùng"},{"time":271.2,"text":"Với lại món thịt gà luôn đi"},{"time":273.4,"text":"Thưa các bạn món này sẽ rất hợp"},{"time":275.1,"text":"Với món cánh gà chiên lá chanh"},{"time":277.1,"text":"Các bạn hãy cùng thử nha"},{"time":278.9,"text":"Rau củ tươi ngon bắt mắt, giòn giòn của salad, béo bùi của trứng và bơ"},{"time":283.7,"text":"Kết hợp với nước sốt chua chua ngọt nhẹ, cân bằng kết hợp ăn ý"},{"time":290.3,"text":"Một món salad nhiều chất sơ, tốt cho sức khỏe lại còn ngon miệng"},{"time":293.8,"text":"Cho nên là quý vị và các bạn hãy lưu lại công thức ngay nha"},{"time":296.5,"text":"Cùng với nhiều công thức khác nữa, chỉ cần truy cập vào youtube, website, fanpage của chương trình Món Ngon Mỗi Ngày"}]}