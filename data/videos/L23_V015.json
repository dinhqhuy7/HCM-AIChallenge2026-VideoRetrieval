."},{"time":48.1,"text":"Các tay đua của ekip 6A mới châu đế Vĩnh Long đã quẹo cua."},{"time":50.9,"text":"Và giờ là những tay đua nước lớn chủ lực của đội 1 đang cố gắng tạo ra tốc độ."},{"time":54.9,"text":"Đó là tay đua Nguyễn Minh Thiện đang nhấn bàn đạp với vận tốc hơn 50kmh."},{"time":59.0,"text":"Phía sau anh đó là Võ Thanh An."},{"time":64.6,"text":"Vẫn còn khá xa, vẫn còn khoảng hơn 2km nữa."},{"time":70.1,"text":"Đó là điều mà họ phải chấp nhận khi đã đáp tài từ quá sớm hơn 15km trước khi về đích"},{"time":75.3,"text":"Và giờ là cơ hội được chia đều cho các ekip"},{"time":80.8,"text":"Hai ekip Đồng Tháp và TP.HCM cũng đang có được những vị trí tốt ở trong trạng đua hôm nay"},{"time":88.5,"text":"Martin Las đang đi ngay sau Mikel Ram"},{"time":90.3,"text":"Và ngay sau Martin Las là Lê Nguyệt Minh"},{"time":92.2,"text":"Lê Nguyệt Minh vẫn luôn chọn vị trí như vậy trong tất cả những trạng đua"},{"time":95.9,"text":"Anh Lu cố gắng đi theo sau chân nước đúc có được lợi thế lớn nhất"},{"time":98.9,"text":"Còn bây giờ ở góc zoom vừa rồi của cameraman"},{"time":101.9,"text":"Chúng ta thấy là Peter Rikunov đang đương thương độc mã"},{"time":104.5,"text":"Khi phía trước anh không có vị trí của Roman Maikin"},{"time":109.0,"text":"Lúc này thì Peter Rikunov đang ở giữa vòng vây của các đối thủ"},{"time":112.2,"text":"Ở ngay bên phải là Nguyễn Văn Bình"},{"time":113.8,"text":"Bên trái là Trần Tuấn Kiệt"},{"time":115.3,"text":"Phía trên là Igor Frolov"},{"time":116.7,"text":"Các tay đua của Vĩnh Long không quan tâm điều đó"},{"time":119.0,"text":"Họ đang nhấn tốc độ vẫn tốc đã hơn 56km rồi"},{"time":122.2,"text":"Độ ngợp đang được gia tăng bởi các tay đua"},{"time":124.5,"text":"Khiếp 620 châu Thế Vĩnh Long"},{"time":126.8,"text":"620 châu Thế Vĩnh Long còn 3 máy kéo và thêm 1 chiếc máy kéo đã tách ra"},{"time":130.1,"text":"Còn lại 2 máy kéo cùng với Mikael Ram và Martin Lars"},{"time":132.7,"text":"Người sẽ nạp tốc độ cao cuối cùng đó là Võ Thanh An"},{"time":135.7,"text":"Trước khi nhường lại vị trí cho bộ đôi người Esponia phối hợp"},{"time":138.5,"text":"Để tìm kiếm chiến thắng thứ 6 của Bình Long ở cấp trường hình năm nay"},{"time":141.7,"text":"Nhưng phía bên trái thì ekip Đồng Tháp cũng đang hướng tới chiến thắng chặn thứ 3 của mình"},{"time":145.9,"text":"Và đây là lần đầu tiên chúng ta thấy được chiến thuật mũi tình nước đúc của ekip thành phố Hồ Chí Minh"},{"time":149.4,"text":"Để tìm kiếm cơ hội cho những trình nước đúc của mình"},{"time":151.3,"text":"1 km cuối cùng, phần tốc được gia tăng"},{"time":154.2,"text":"Phía bên này thì có lẽ là một hội hợp tác chiến của hai tay đua ekip quân Q7"},{"time":158.5,"text":"Phạm Lê Xuân Lộc bước lên"},{"time":160.0,"text":"Phía sau anh đó là tay đua Quang Văn Cường"},{"time":162.1,"text":"Và như đã nói thì quân Q7 chắc chắn cũng sẽ không đứng ngoài cuộc chơi"},{"time":165.6,"text":"Sapa Novi Cup cũng đang tìm kiếm cho mình một cơ hội để gỡ dơ"},{"time":169.3,"text":"Nguyễn Tuấn Hoài cũng đang cố gắng bám theo trong nhóm này"},{"time":171.8,"text":"Quá hấp dẫn"},{"time":172.7,"text":"Đây là Quang Văn Cường đoàn tuân nước đốt 700m của tay đua ekip quân Q7"},{"time":177.6,"text":"Sapa Novi Cup cũng đang bước lên"},{"time":179.8,"text":"Và đây là Mikael Renn"},{"time":191.6,"text":"NDS đang nhấn bàn nạp, phía bên kia có vẻ là team OVNF gia vào đợt nước lúc này."},{"time":197.2,"text":"Công trợ sẽ mãi là người dành chiến đắng, Peter Rikunov đang có lợi."},{"time":200.3,"text":"Và đó là chiến đắng dành cho Peter Rikunov."},{"time":203.1,"text":"Quá tuyệt vời, không có gì để nói nữa về màn trình diễn của Peter Rikunov ngày hôm nay."},{"time":213.5,"text":"Một sự trở lại hoàn hảo, một lời khẳng định của một đương kỳ máu vàng, đương kỳ máu xanh."},{"time":218.3,"text":"Một ứng viên hàng đầu cho những danh hiệu cá nhân nổi bật của cấp trường hình thành phố Hồ Chí Minh năm nay."},{"time":253.4,"text":"Nguyễn Văn Bình chính là người đã theo sau Peter Rikunov để thậm chí có cú đẩy xe vượt qua Martin Las ở trong những Nguyễn Văn Bình."},{"time":265.5,"text":"Nguyễn Văn Bình có lẽ đã vượt qua Martin Las rất xích sao ở những mét cuối cùng."},{"time":272.2,"text":"Quá hay!"},{"time":275.6,"text":"Và chúng ta hãy nhìn động thái ăn mừng của Nguyễn Tấn Hoài và Trinh Đức Tâm ở phía sau."},{"time":281.9,"text":"Một chiến thắng mang giá trị tinh thần rất lớn đối với tập thể An Giang ở thời điểm này."},{"time":288.1,"text":"Ngày hôm qua khi Peter Rikunov bị té ngã"},{"time":290.8,"text":"Thì tất cả những fan xe đạp An Giang"},{"time":293.8,"text":"Và cả những khán giả hâm mộ cấp truyền hình"},{"time":296.0,"text":"Đều có một phút thắt tim lại"},{"time":300.1,"text":"Tất cả đều hồi hợp, đều chờ đợi"},{"time":303.7,"text":"Sức khỏe của Peter Rikunov như thế nào"},{"time":305.6,"text":"Và thật may mắn là mọi chuyện đều đã ổn thỏa sau đó"},{"time":308.6,"text":"Và ngày hôm nay Peter Rikunov đã khẳng định sự trở lại của mình"},{"time":312.5,"text":"Với cuốn nước rút không thể hoàn hảo hơn"},{"time":314.8,"text":"Ở trong đoạn những mét cuối cùng"},{"time":317.9,"text":"Quá tuyệt vời"},{"time":322.8,"text":"Thêm một góc quay rất đặc biệt nữa mà chúng ta sẽ được theo dõi"},{"time":326.3,"text":"Peter Rikunov đã hoàn toàn đánh bại các đối thủ cạnh tranh của mình"},{"time":336.3,"text":"Trần Tuấn Kiệt không có mặt trong tết năm"},{"time":338.3,"text":"Vì anh đã không chịu được độ ngợp"},{"time":340.4,"text":"Ở khoảng 500m cuối cùng"},{"time":342.1,"text":"Khi mà các tay đua thuộc ekip quân khu 7"},{"time":343.9,"text":"Như Quang Văn Cường, như Phạm Lê Xuân Lọc tạo nên"},{"time":347.5,"text":"Một thử thách cực đại đối với các chân nước rút"},{"time":350.2,"text":"Họ không chỉ có được những cú nước rút mạnh mẽ của riêng mình"},{"time":353.5,"text":"Mà còn phải chịu được độ ngợp đến từ những cuộc tấn công"},{"time":355.9,"text":"Những cuộc đi nước lớn của các đối thủ"},{"time":359.5,"text":"Ở góc quay này thì khá rõ"},{"time":361.1,"text":"Nguyễn Văn Bình là người đã về trước"},{"time":364.8,"text":"Martin Las"}]}