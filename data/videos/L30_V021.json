những phần quà"},{"time":18.9,"text":"để trao cho các bé màu côi ở máy ấm Mây Ngạn ở Tây Ninh"},{"time":23.7,"text":"Phần quà thì có bánh, sữa, đường, dầu ăn, bim bim và v.v"},{"time":29.1,"text":"Những thực phẩm thiết yếu để cho các bé và người già đeo đơn có thể sử dụng được hằng ngày"},{"time":35.0,"text":"Nhóm chúng em có chuẩn bị khoảng 70 phần quà để trao cho máy ấm"},{"time":39.7,"text":"Trong đó thì không thể nào thiếu lòng đèn Trung Thu"},{"time":42.7,"text":"Vì nhân dịp mà Tết Trung Thu sắp đến"},{"time":45.9,"text":"Nhìn rất đẹp đúng không ạ"},{"time":48.0,"text":"Và đây là chiến công tác ngày 15 tháng 9"},{"time":51.9,"text":"Mọi người đang chung tay"},{"time":53.4,"text":"Để sắp xếp những bằng quà lên xe"},{"time":56.6,"text":"Những anh em thiện nguyện trong nhóm"},{"time":58.8,"text":"Và những người bên ngoài để tham gia tình nguyện"},{"time":62.5,"text":"Những khuôn mặt rất là rạng rỡ"},{"time":64.6,"text":"Ai cũng nhiệt huyết, vui tươi"},{"time":66.8,"text":"Và đồng lòng cùng với nhau"},{"time":69.2,"text":"Hợp tác trong ngày hôm nay"},{"time":70.5,"text":"Ngày 15 tháng 9 Chú Nhật"},{"time":72.7,"text":"Mỗi tháng thì nhóm chúng em"},{"time":74.2,"text":"Có chuẩn bị hoặc là lên lịch trình"},{"time":76.6,"text":"Đến những nơi mái ấm hoặc là trung tâm"},{"time":79.4,"text":"Nuôi dưỡng những người già neo đơn"},{"time":81.7,"text":"Những bé mù côi"},{"time":83.1,"text":"Những người khuyết tập những vấn đề bất hạnh"},{"time":86.0,"text":"Để sẽ chia những món quà nhỏ"},{"time":88.5,"text":"Để mọi người có thể sử dụng được hằng ngày"},{"time":91.2,"text":"Mong là những phần quà nhỏ này"},{"time":94.6,"text":"Những tinh thần tích cực này"},{"time":96.2,"text":"đây có thể lan tổn mọi người và mọi người sẽ chung tay cùng nhóm chúng em đây là chúng em đang tới"},{"time":102.1,"text":"mấy áp mấy ngàn và trao những phần quà đã chuẩn bị cho các bé ở đây các bé rất là ngoan và ship hàng"},{"time":111.3,"text":"để nhận những phần quà và lồng điện chung thu các bé nhận phần quà rất là vui và rất là hấu hức và"},{"time":119.2,"text":"mọi người cũng đang rất là vui vì trao những phần quà ý nghĩa này và đây là kết quả của nhóm chúng"}]}