"Mình chào các bạn khán giả đến với chương trình Món ngon mỗi ngày"},{"time":32.6,"text":"Nấu chuẩn, ăn lành"},{"time":34.5,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":38.7,"text":"Hôm nay chúng ta sẽ làm một món bánh rán với nhân chuối và nhân dâu tay"},{"time":42.6,"text":"Thì đầu tiên là xin nhờ Phương mài cái vỏ chanh này để làm cho món bánh chúng ta ngon hơn"},{"time":47.6,"text":"Và bây giờ trong khi mà chờ Phương bào vỏ chanh để bắt cái nước chanh á"},{"time":51.3,"text":"Thì xin cũng sẽ cắt cái dâu tay trước"},{"time":53.4,"text":"Dâu tây này thì chúng ta sẽ rửa sạch và bỏ đi cái phần cuốn xanh"},{"time":56.5,"text":"Phương sẽ cắt cái trái chanh đó làm đôi và chúng ta sẽ lấy phần nước chanh luôn ha"},{"time":60.0,"text":"Phần vỏ chanh bào cũng đã xong, bây giờ chúng ta đã có nước chanh rồi"},{"time":63.1,"text":"Thì Xin sẽ tiến hành cắt lát dâu tây cũng như chuối ha"},{"time":65.8,"text":"Cắt ở như vầy là chúng ta sắp sắp lên cái bánh cho nó đẹp"},{"time":68.3,"text":"Chúng ta có thể cắt mỏng hoặc cắt dày tùy thích ha"},{"time":70.4,"text":"Dâu tây là một loại trái cây rất là được ưa dùng trong các loại bánh"},{"time":73.7,"text":"Bởi vì về màu sắc này cũng như hình dáng rất là đẹp"},{"time":76.3,"text":"Và bên cạnh đó, những ai muốn bổ sung nhiều vitamin C thì dâu sẽ là một sự lựa chọn cho các bạn"},{"time":81.8,"text":"Và bây giờ sẽ cắt cái phần chuối này"},{"time":83.4,"text":"Chuối là một loại trái cây rất là quen thuộc"},{"time":85.3,"text":"Chắc chắn là Sinh và Minh Vương rất là thích đúng không?"},{"time":88.2,"text":"Cái hàm lượng cali trong một trái chuối nó vừa đủ với 9%"},{"time":92.9,"text":"Theo cái lượng khuyến cáo mà chúng ta nên bổ sung hằng ngày"},{"time":96.0,"text":"Chuối còn giúp cho chúng ta giảm nguy cơ các bệnh về tim mạch nữa"},{"time":99.0,"text":"Các bạn nhớ, nên vắt chanh vào chuối để chuối không bị xuống màu và dậy mùi hơn"},{"time":103.7,"text":"Ở đây xin sẽ có một gói bột bánh rắn pha sẵn vị truyền thống ha"},{"time":107.3,"text":"Minh Phương biết làm sao mà pha cái bột này cho ngon nhất không nè"},{"time":110.3,"text":"Chỉ cần đọc kỹ hơn nhân sử dụng ở trên gói bột"},{"time":113.0,"text":"Thì chúng ta sẽ có ngay một công thức chuẩn"},{"time":114.9,"text":"Đúng không nào"},{"time":115.5,"text":"Đúng rồi"},{"time":116.0,"text":"Thì chúng ta sẽ sử dụng 140ml nước"},{"time":118.7,"text":"Và sau khi chúng ta cho nước vào phần bột"},{"time":120.8,"text":"Thì phần bột đã tan đều"},{"time":123.0,"text":"Xánh sọt và mịn như thế này rồi"},{"time":124.6,"text":"Thì bây giờ chúng ta sẽ chuẩn bị một cái chảo để rán bánh"},{"time":127.0,"text":"Chảo thì cũng đã nóng rồi"},{"time":128.3,"text":"Chúng ta nên đun chảo nóng"},{"time":129.9,"text":"Và sau đó giảm nhiệt độ xuống để bánh được có màu đẹp hơn nè"},{"time":132.5,"text":"Chính đều hơn nha"},{"time":133.5,"text":"Chúng ta sẽ cho lên lại bếp"},{"time":135.7,"text":"Các bạn nhớ là khi đổ bột chúng ta nên đổ vào một điểm để bột tự tràn ra"},{"time":139.4,"text":"Bánh sẽ đều và đẹp hơn"},{"time":140.6,"text":"Khi mà chúng ta thấy những cái bông bóng nổi lên như vầy nè"},{"time":143.1,"text":"Cái mặt bánh ở trên rám hơi khô lại thì chúng ta sẽ lật bánh nha"},{"time":146.3,"text":"Ồ đẹp quá"},{"time":147.8,"text":"Và bây giờ thì bánh cũng đã chín rồi Mình Phương ạ"},{"time":150.4,"text":"Chúng ta sẽ lấy ra nha"},{"time":151.5,"text":"Mình Phương hủy được cái mùi thơm"},{"time":152.7,"text":"Cái mùi rất là thơm"},{"time":154.0,"text":"Và chúng ta cũng sẽ lần lượt đổ những cái bánh tiếp theo để làm đủ 2 phần bánh với 2 loại nhân khác nhau ngày hôm nay nha"},{"time":159.2,"text":"Và cái cuối cùng Mình Phương sẽ tắt bếp đây"},{"time":162.4,"text":"Để có được những chiếc bánh rán ngon và tạo hình đẹp"},{"time":165.5,"text":"Thì bên cạnh việc pha bột chuẩn chúng ta cũng nên lưu ý những hướng dẫn đến từ đầu bếp Hoàng Sinh"},{"time":169.4,"text":"Bên cạnh đó các bạn khán giả cũng có thể sử dụng điện thoại di động để quét mã QR đang hiển thị trên màn hình"},{"time":174.4,"text":"Để lưu lại ngay công thức của món bánh ngày hôm nay nha"},{"time":179.0,"text":"Và bây giờ là cái phần trang trí bánh ha"},{"time":182.3,"text":"Rồi, thì lớp đầu tiên chúng ta sẽ rưới một ít sô-cô-la chảy"},{"time":186.2,"text":"Chúng ta sẽ rưới lên theo sở thích của gia đình mình"},{"time":191.3,"text":"Đây, Minh Phương cũng thấy là sau khi mà chúng ta vắt chanh vào cái phần chuối"},{"time":194.3,"text":"Thì cái phần chuối màu rất là đẹp"},{"time":196.9,"text":"Chứ không có mà bị xỉn mà"},{"time":198.8,"text":"Tương tự ở cái bánh còn lại thì chúng ta sẽ trang trí dâu tay sắc lát nè"},{"time":204.0,"text":"Sau khi mà chúng ta để cái phần nhân trái cây ở chính giữa rồi"},{"time":207.2,"text":"Thì chúng ta sẽ để thêm một lớp bánh lên trên"},{"time":209.7,"text":"Rưới thêm một lớp sô-cô-la"},{"time":211.1,"text":"Lớp này là quan trọng nha Minh Phương"},{"time":213.3,"text":"Mặt trên mà đẹp nha"},{"time":215.2,"text":"Đối với sô-cô-la thì chúng ta có thể mua những loại si-rô giống như vậy"},{"time":218.8,"text":"Hoặc là sử dụng sô-cô-la thỏi và chúng ta chưng lên"},{"time":221.6,"text":"Hoặc dễ dàng nhất là chúng ta có thể bỏ vào chén và để trong lò vi sống"},{"time":225.5,"text":"Nhưng nhớ là nhiệt độ phải thật là thấp để không là sô-cô-la rất là dễ cháy nha"},{"time":229.2,"text":"Rồi bây giờ chúng ta sẽ trang trí thêm một lớp chuối lên trên"},{"time":232.3,"text":"Ừm"},{"time":233.9,"text":"Bên đây cũng vậy chúng ta sẽ có một lớp dâu"},{"time":236.1,"text":"Một lớp dâu"},{"time":237.4,"text":"Đối với cái phần bánh nhân chuối thì để cho hương vị được đặc biệt hơn thì ở đây xin có một ít bột quế nha"},{"time":242.5,"text":"Bên dâu tay cho một ít đường bột vào cái gây"},{"time":245.5,"text":"Và chúng ta sẽ gây lên ha"},{"time":247.0,"text":"Đẹp quá"},{"time":247.4,"text":"Chúng ta chỉ cần lấm tấm như vậy thôi"},{"time":249.0,"text":"Nhìn rất là đẹp đúng không nào"},{"time":250.6,"text":"Chúng ta sẽ cho một ít vỏ chanh bào lên trên hoặc nhân chuối thôi"},{"time":253.8,"text":"Và để cho đẹp hơn thì chúng ta sẽ cần những cái đọt húng lũi thật là nhỏ, xanh, đẹp"},{"time":258.8,"text":"Đây ạ"},{"time":259.1,"text":"Và món ăn của chúng ta đã hoàn thành rồi ạ"},{"time":261.7,"text":"Những chiếc bánh rán rất là dễ thương"},{"time":263.9,"text":"Sự kết hợp giữa các loại trái cây tươi nè"},{"time":266.0,"text":"Cùng với bột bánh rán pha sẵn vị truyền thống"},{"time":269.3,"text":"Không những mang đến cho chúng ta một công thức chuẩn mà tạo ra những chiếc bánh rất là ngon lành"},{"time":274.0,"text":"Để cho món tráng miệng này trở nên hoàn hảo hơn nữa thì chúng ta nên kết hợp với trà sữa Royal Cookie"},{"time":279.0,"text":"Bánh xốp mềm béo béo, ăn cùng chuối dẻo ngọt và dâu tây tươi mọng, chua chua"},{"time":285.1,"text":"Một chút sô-cô-la đắng nhẹ, thơm mùi vỏ chanh, ngon vi diệu với bánh rán trái cây"},{"time":291.5,"text":"Thơm ngon, đầy đủ năng lượng và nhiều vitamin"},{"time":294.5,"text":"Làm thử ngay món bánh rán trái cây nha các bạn"},{"time":297.4,"text":"Và các bạn cũng có thể truy cập vào kênh youtube, website và fanpage của chương trình"},{"time":302.6,"text":"Để xem thêm nhiều công thức của các món ăn ngon"},{"time":304.9,"text":"Còn bây giờ thì xin chào tạm biệt và hẹn gặp lại"}]}