ext":"ming · mingày · Eat Well, Live · AJINOM · NGO · ngay · main · Unine · gày · AnQuich · Eat Wei · BOTTAMRIO · ArQuid · CHIÍN CIÓN"},{"time":304.0,"until":315.2,"text":"monngonmoingay.com · mingày · Món Ngon Mōi Ngày"},{"time":317.2,"until":325.6,"text":"500g · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Golden Scale · Công ty Hakuhodo Vit Nam · NGUYÊN LIÊU · Bn quyn kch bn và cu trúc · Công ty HKFilm · Phi hp thc hin · Thc hin chương trình · ·THIT BA ROI · chuơng trình thuc · Onl · · BÔT TÁM KHO CHIÊN GIÒN · THÀNH PHÓ HO CHÍMINH · DÀI TRUYÊN HìNH · ·SÀ · ·ÖT BÄM"}],"speech":[{"time":11.7,"text":"Ba rọi xả ớt tẩm bột chiên giòn"},{"time":14.0,"text":"Thơm nồng nàng"},{"time":15.3,"text":"Lại giòn giòn thích thú"},{"time":34.9,"text":"Rất vui khi được gặp lại các bạn khán giả"},{"time":36.9,"text":"Đang theo dõi chương trình"},{"time":37.9,"text":"Món ngon mỗi ngày, nấu chuẩn, ăn lành"},{"time":40.3,"text":"Chương trình được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":44.4,"text":"Hôm nay quý vị sẽ hướng dẫn"},{"time":45.9,"text":"Các bạn khán giả và Minh Phương"},{"time":47.2,"text":"Thực hiện một món rất ngon nhưng mà cực kỳ dễ"},{"time":50.2,"text":"Đó là món ba rọi xả ớt tẩm bột chiên giòn"},{"time":53.2,"text":"Wow"},{"time":53.7,"text":"Nghe thôi là thấy hấp dẫn rồi"},{"time":55.8,"text":"Công đoạn đầu tiên là"},{"time":57.2,"text":"anh Nghị phải hướng dẫn Minh Phương cũng như là quý vị khán giả"},{"time":59.9,"text":"lựa chọn ba rọi làm sao cho ngon"},{"time":62.0,"text":"cái việc lựa chọn ba rọi"},{"time":64.2,"text":"thì chúng ta sẽ chọn thớt thịt hồng"},{"time":66.8,"text":"chạm vào có độ đan hôi"},{"time":68.2,"text":"quan trọng đó là mỡ nạt"},{"time":70.1,"text":"nó đan xen lặn nhau"},{"time":71.4,"text":"cái miếng ba rọi nè, các bạn sẽ cắt"},{"time":73.3,"text":"có độ dài khoảng 1cm như thế này"},{"time":75.4,"text":"đó, cắt xuống"},{"time":78.0,"text":"sau khi cắt lát như thế này"},{"time":79.7,"text":"thì Minh Phương và các bạn cắt thành quân trì"},{"time":81.9,"text":"đó"},{"time":83.9,"text":"mình cứ canh khoảng ngón tay út là được"},{"time":88.5,"text":"Cho vào một cái tô nè"},{"time":94.9,"text":"Và Minh Phương được biết thì thịt heo là cái nguồn cung cấp protein rất là quen thuộc rồi đúng không ạ"},{"time":100.3,"text":"Tốt cho cơ bắp nè"},{"time":101.4,"text":"Nhưng mà bên cạnh đó thì trong thịt heo còn có một cái hòa chất rất là tốt đó là taurine"},{"time":106.1,"text":"Và cái chất này sẽ giúp cho chúng ta cảm giác hưng phấn hơn"},{"time":109.4,"text":"Chính vì thế mà ai là những người hay tập thể thao thì sẽ bổ sung cái nguồn thịt heo để giúp cho năng suất hơn trong luyện tập"},{"time":115.4,"text":"Rồi chúng ta sẽ ướp vào đây một muỗng cà phê tỏi băm nè"},{"time":118.1,"text":"Một muỗng cà phê hành tím băm"},{"time":120.4,"text":"1 muỗng cà phê ớt sườn băm"},{"time":121.9,"text":"Tẩm tỏi, hành tím, ớt và ba rọi"},{"time":124.7,"text":"Để giúp cho ba rọi thấm gia vị và thơm ngon hơn đó các bạn"},{"time":127.8,"text":"Và cuối cùng chúng ta sẽ nêm vào đây nửa gói gia vị nêm sẵn"},{"time":131.3,"text":"Ajiwit bột tẩm khô chiên giòn nha"},{"time":133.6,"text":"Quân Nghệ ướp gia vị nêm sẵn Ajiwit bột tẩm khô chiên giòn"},{"time":136.6,"text":"Để giữ màu nao cho thiệt"},{"time":138.0,"text":"Mình sẽ áo phần ba rọi đã được cắt quân trì"},{"time":141.6,"text":"Một lớp bột mỏng như thế này đúng không ạ"},{"time":144.0,"text":"Và đặc biệt trong món ăn ngày hôm nay"},{"time":146.0,"text":"Quốc Nghị sử dụng cái phần sả non nha"},{"time":148.2,"text":"Đập thành từng sợi như thế này"},{"time":149.6,"text":"Sau đó Quốc Nghị sẽ ướp cái gia vị nêm sẵn"},{"time":152.2,"text":"Aji huyết bột tẩm khô chiên giòn"},{"time":153.9,"text":"Minh Phương giúp Quốc Nghị chuẩn bị một cái chảo dao nè"},{"time":156.0,"text":"Dạ, có ngay"},{"time":157.1,"text":"Chúng ta sẽ làm nóng dầu ăn"},{"time":159.4,"text":"Sau khi dầu ăn đã nóng thì Quốc Nghị sẽ cho sả non vào chiên trước"},{"time":163.2,"text":"Chiên sả non trước giúp cho dao chúng ta thơm hơn khi mà chiên thịt và rồi đó"},{"time":168.6,"text":"Cái phần sả này mình chiên nhanh không anh Quốc Nghị?"},{"time":170.6,"text":"Thì mình chiên nó vừa vàng lên là được em"},{"time":172.6,"text":"À dạ, nếu như mà ở nhà để làm những cái sợi sả được tơi như thế này"},{"time":177.2,"text":"Thì mình lựa sả non nè, dùng một cái chày để mình đập đập đập"},{"time":181.0,"text":"Sau đó có phải là mình dùng cái nĩa để mình xới từng sợi ra đúng không anh?"},{"time":184.9,"text":"Em nên làm đầu bếp luôn đi, cái gì cũng biết hết trơn"},{"time":187.8,"text":"Sả chuyển màu vàng nè, các bạn vớt ra"},{"time":189.6,"text":"Cho ra giá thêm dầu nè, bây giờ chúng ta cho ba rọi vào chiên nè"},{"time":194.6,"text":"Thơm quá, thơm quá đi"},{"time":198.2,"text":"Mình phương quan sát nè, cái tỏi ớt nó bấm vào nhìn hấp dẫn không?"},{"time":200.8,"text":"Sau khi quan sát thấy ba rọi nó vàng ươm mà giòn á"},{"time":204.7,"text":"Thì chúng ta sẽ tắt lửa vớt ra"},{"time":206.5,"text":"Cái mỡ ba rọi này nó tươm lên nó xèo xèo xèo"},{"time":210.2,"text":"Rồi bây giờ chúng ta sẽ cho ra giấy thấm dào nè"},{"time":212.3,"text":"Dạ"},{"time":213.6,"text":"Thêm một công đoạn cuối cùng nữa đó là chúng ta sẽ phi xả ớt tỏi"},{"time":217.9,"text":"Xóc với lại ba rọi chiên nha"},{"time":219.6,"text":"Cho vào đây một muỗng canh dầu ăn"},{"time":222.5,"text":"Các bạn sẽ cho vào đây một muỗng canh xả băm"},{"time":224.6,"text":"Một muỗng canh tỏi băm"},{"time":226.1,"text":"Một muỗng canh ớt sườn băm"},{"time":227.5,"text":"Quý vị sẽ phi thơm xả tỏi ớt riêng"},{"time":229.8,"text":"Để giữ cái độ giòn cho thịt và tăng hương vị cho món ăn"},{"time":232.5,"text":"Cho thịt ba rọi chiên vào"},{"time":233.8,"text":"Nó bám vào nè, thấy không Minh Phương"},{"time":236.5,"text":"Hấp dẫn"},{"time":237.8,"text":"Xong, tắt lửa"},{"time":239.1,"text":"Để hiểu thêm và có thể xem lại công thức nhanh gọn ngon"},{"time":242.7,"text":"Trong món này thì chúng ta có thể sử dụng điện thoại di động"},{"time":245.0,"text":"Và quét mã QR đang hiển thị trên màn hình đây các bạn nhé"},{"time":248.3,"text":"Và bây giờ Quốc Nghị sẽ hướng dẫn các bạn cùng Minh Phương"},{"time":253.2,"text":"Trình bài món này ra và ăn với cơm trắng"},{"time":256.2,"text":"Cho xả chiên nè"},{"time":258.2,"text":"Hấp dẫn chưa"},{"time":259.1,"text":"Cho thịt len"},{"time":262.5,"text":"Cái phần gia vị áo ở bên ngoài đó"},{"time":265.4,"text":"Đúng rồi"},{"time":265.8,"text":"Và cuối cùng Quỳnh Nghi sẽ trang trí lên đây một ít sả chiên và ớt sừng cắt sợ"},{"time":271.9,"text":"Món này các bạn có thể ăn kèm với lại salad mực ống nữa nha"},{"time":276.0,"text":"Và với món ăn này thì Minh Phương đã chuẩn bị một cái bát cơm nóng sẵn ở cái bên rồi"},{"time":280.6,"text":"Tuy nhiên là mình cũng có thể biến tấu thành một cái món ăn chơi, ăn lai rai"},{"time":284.8,"text":"Cũng được đúng không ạ"},{"time":286.6,"text":"Thịt ba rọi chín giòn, có màu vàng hấp dẫn, lại béo ngọt đậm đà"},{"time":290.9,"text":"Thơm mùi xà ớt bao quanh"},{"time":292.6,"text":"Càng làm kích thích thêm vị giác trong bữa cơm"},{"time":295.9,"text":"Khi các bạn cần đến một món ăn vừa nhanh chóng, tiện lợi và vẫn phải ngon miệng"},{"time":300.3,"text":"Thì hãy nhớ ngay đến ba rọi xà ớt tẩm bột chiên giòn"},{"time":303.7,"text":"Và cũng đừng quên những địa chỉ quen thuộc của chương trình Món Ngon Mỗi Ngày"},{"time":307.1,"text":"Đó là kênh Youtube, website và fanpage của chương trình"},{"time":310.0,"text":"Để tìm hiểu thêm nhiều công thức của những món ăn ngon"},{"time":312.6,"text":"Còn bây giờ thì xin chào và hẹn gặp lại"}]}