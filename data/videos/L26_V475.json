278.5,"until":286.4,"text":"Beo béo"},{"time":286.6,"until":292.7,"text":"MOTO · AJINOMOTO · mingày · moingay · Eat Wel, Live"},{"time":293.3,"until":305.5,"text":"Nguyên liu · Tham gia · Công ty Ajinomoto Vit Nam · Tham gia thc hin · Công ty Chuo Senko Vit Nam · Bt Canh · Công ty Golden Scale · Bn quyn kch bn và cu trúc · Cà tím: 2 trái va · Tôm khô to: 50g · Công ty HKFilm · H ct nh: 1/2 chén · Tòi ót bám, tòi phi · Phi hp thc hin · Công ty C · Chanh: 1mièng · Bt ngot AJI-NO-MOTO° · Thc hin chương trình · chuơng trình thuc · DÀI TRUYÊN HìNH TP. HCM · Thc hié"}],"speech":[{"time":15.1,"text":"Ủa không cô em nóng quá"},{"time":16.8,"text":"Em phải em hoạt cho nó mát"},{"time":18.7,"text":"Trời ơi nóng quá thì mở máy lạnh lên"},{"time":20.9,"text":"Máy lạnh thật ra cũng có mở rồi á cô"},{"time":23.0,"text":"Nhưng mà có giảm nhiệt độ đi chăng nữa"},{"time":25.0,"text":"Thì cũng không thể làm mát được bao tử của em"},{"time":27.4,"text":"Em nhìn đây cô có cà tím nè"},{"time":29.6,"text":"Hẹ là những cái thực phẩm nó rất là mát nè"},{"time":33.6,"text":"Rồi có nhiều chất sơ"},{"time":35.3,"text":"Thì ăn vô thì sẽ giúp cơ thể thêm nhiệt"},{"time":37.5,"text":"Và giảm huyết áp đồng thời cũng giảm cho lét tiron nữa"},{"time":40.8,"text":"Hay quá cô Hà"},{"time":41.9,"text":"Nhưng mà hình như hơi thiếu đạm cô Hà"},{"time":44.3,"text":"Yên tâm đi cô có thêm tôm nữa thì không có sợ thiếu đạm đâu"},{"time":50.0,"text":"Cà tím nướng tôm cháy mỡ hẹ, mềm ngọt xốp thơm, cả nhà mê tích"},{"time":73.8,"text":"Được tài trợ bởi công ty Asinomoto Việt Nam"},{"time":77.1,"text":"Đầu tiên là việc chọn cà"},{"time":78.5,"text":"Các bạn lưu ý là chúng ta sẽ chọn những quả cà mà nó suôn, vừa phải và không non quá"},{"time":84.3,"text":"Như vậy thì nướng lên sẽ ngon hơn"},{"time":86.1,"text":"Bây giờ thì chúng ta sẽ cắt dọc quả cà này"},{"time":89.5,"text":"Làm 2"},{"time":91.1,"text":"Mình giữ lại phần cuốn luôn hả cô?"},{"time":92.7,"text":"Đúng rồi, mình giữ lại phần cuốn nó vừa đẹp nữa"},{"time":94.6,"text":"Sau khi cắt cà xong thì chúng ta sẽ ngâm cà vô trong nước"},{"time":97.9,"text":"Có pha một chút muối để cà không có bị thăm đen ha"},{"time":100.3,"text":"Và bây giờ thì chúng ta sẽ pha một cái hỗn hợp rất là đơn giản"},{"time":104.0,"text":"Để chúng ta hết trên cà trước khi mình nướng"},{"time":106.2,"text":"Mình sẽ cho vào trong chén là nửa muỗng cà phê bột canh"},{"time":110.1,"text":"Nửa muỗng cà phê bột ngọt Asinomoto"},{"time":112.8,"text":"Hai muỗng canh dầu"},{"time":114.4,"text":"Mình cho thêm một chút xíu cái gia vị á"},{"time":117.3,"text":"Thì nó sẽ thấm vô cà khi mà mình nướng cho nó sẽ ngon hơn"},{"time":120.7,"text":"Trộn để cho nó đều gia vị"},{"time":122.6,"text":"Rồi em mở lửa lên giúp cô đi ha"},{"time":124.4,"text":"Cho cái lò nó nóng"},{"time":125.8,"text":"Rồi cô sẽ phớt cái phần gia vị này lên quả cà"},{"time":130.9,"text":"Khi mà lò nóng rồi đó"},{"time":132.2,"text":"Thì em cũng sẽ phớt lên trên cái lò một lớp dầu"},{"time":135.2,"text":"Sau đó thì mình sẽ đặt áp cái phần mặt của cái quả cà lên"},{"time":141.8,"text":"Bây giờ thì chúng ta sẽ làm dầu hẹ"},{"time":143.6,"text":"Mình sẽ đặt một cái chảo lên trên bếp"},{"time":145.7,"text":"Cô sẽ cho vào đây khoảng chừng 1 phần 3 chén dầu ăn"},{"time":150.1,"text":"Phần hẹ lá sau khi mà chúng ta đã rửa sạch thì mình sẽ cắt nhỏ như thế này"},{"time":154.1,"text":"Và mình sẽ cho vào đây chừng 1 phần 4 muỗng cà phê bột canh"},{"time":157.7,"text":"Mình trộn"},{"time":158.5,"text":"Rồi bây giờ thì dầu nóng rồi đó bây giờ mình sẽ tắt lửa"},{"time":161.0,"text":"Và để cho dầu nhụy bớt một chút"},{"time":162.7,"text":"Rồi sau đó thì chúng ta sẽ chế phần dầu vào cái kén hẹ này"},{"time":168.4,"text":"Rồi chúng ta sẽ khuấy phần tôm khô"},{"time":171.3,"text":"Chúng ta sẽ lửa tôm khô hơi to con như thế này ha"},{"time":173.9,"text":"Mình sẽ nhâm nước nóng cho nó mềm"},{"time":176.4,"text":"Rồi sau đó thì mình sẽ dùng cái cối xay sinh tố"},{"time":179.2,"text":"Mình xay ra"},{"time":180.1,"text":"Và đây là phần tôm khô mà cô đã chuẩn bị rồi nè"},{"time":182.9,"text":"Mình sẽ cho phần tôm khô đã xay vào đây"},{"time":187.0,"text":"Chúng ta sẽ rang với lửa vừa"},{"time":188.7,"text":"Cho cái phần tôm khô này thật ráo và ngon"},{"time":191.8,"text":"Trong lúc mà chúng ta cháy cái phần tôm trên chảo"},{"time":194.3,"text":"Thì chúng ta sẽ cho vào đây một chút xíu bột ngọt Ajinomoto"},{"time":197.2,"text":"Mình trộn đều để tăng thêm cái hương vị cho cái phần tôm cháy này"},{"time":201.9,"text":"Thảo ơi bây giờ thì cái phần tôm này đã thơm và ráo rồi đó"},{"time":206.3,"text":"Tiếp theo thì cô sẽ cho thỏi phi vào đây"},{"time":209.2,"text":"Tỏi phi vào để thơm phải không cô?"},{"time":211.0,"text":"Đúng rồi"},{"time":211.5,"text":"Các bạn lưu ý là chúng ta sẽ trộn tỏi phi vào trong tôm"},{"time":215.2,"text":"Để cho cái phần tôm cháy được thơm ngon hơn ha"},{"time":217.8,"text":"Dạ"},{"time":218.6,"text":"Bây giờ mình chỉ trút ra thôi"},{"time":222.0,"text":"Rồi"},{"time":222.9,"text":"Bây giờ chúng ta sẽ pha nước mắm trong vòng 30 giây"},{"time":225.5,"text":"Dạ"},{"time":226.0,"text":"Chúng ta sẽ cho vào đây 1 muỗng canh đường"},{"time":228.1,"text":"1 muỗng canh nước mắm"},{"time":229.4,"text":"Và 3 muỗng canh nước"},{"time":230.9,"text":"Dạ"},{"time":231.4,"text":"Nước đun sôi để nguội"},{"time":232.8,"text":"Chúng ta sẽ nặn vào đây khoảng chừng 1 muỗng cà phê nước cốt chanh"},{"time":236.9,"text":"Phải đều"},{"time":237.8,"text":"Cho thêm tỏi băm và ớt băm"},{"time":240.5,"text":"Cô Hà thấy ngày hôm nay em nướng đạt chuẩn không?"},{"time":244.8,"text":"Rất ngon đó"},{"time":245.8,"text":"Nhờ cô Hà chuẩn bị lò nướng rất là xịn"},{"time":248.1,"text":"Chúng ta có thể nướng cà tím trong lò nướng cũng rất ngon đó các bạn"},{"time":251.2,"text":"Đó, một quả cà ở đây"},{"time":254.0,"text":"Rắc lên trên này là một ít chà bông"},{"time":257.4,"text":"Dầu hẻ"},{"time":259.5,"text":"Dầu hẻ với dầu"},{"time":260.9,"text":"Mình sẽ đặt thêm trên này một miếng cà lên nữa"},{"time":263.7,"text":"Phần tôm dầu hẻ lên"},{"time":267.4,"text":"Và món ăn này chúng ta ăn kèm với lại nước mắm mà mình đã pha"},{"time":271.4,"text":"Vị mềm ngọt của cà tím nướng thơm"},{"time":274.0,"text":"Quyện với độ bông xốp, thơm nứt của tôm trái tỏi"},{"time":277.6,"text":"Thêm chút béo béo của mỡ hẹ xanh mứt đậm đà"},{"time":281.1,"text":"Hương vị hài hòa, ngon dịu như một bản giao hưởng mùa hạ"},{"time":285.6,"text":"Chỉ cần thêm chút sáng tạo và nguyên liệu quen thuộc"},{"time":288.7,"text":"Chúng ta sẽ có một món ăn hấp dẫn mới lạ"},{"time":291.2,"text":"Hãy vào bếp thực hiện ngay"}]}