có gì cô ha"},{"time":58.5,"text":"Và để làm sốt đậu gà thì đầu tiên là Minh Tuấn giúp cô em mài cái giỏ chanh"},{"time":63.4,"text":"Cái giỏ chanh vàng kia và dắt lấy cho cô 2 muỗng canh nước cốt chanh"},{"time":68.9,"text":"Bây giờ trong lúc mà Tuấn mài giỏ chanh á"},{"time":71.2,"text":"Thì cô Hà sẽ tranh thủ là cô Hà cắt cái quả chuối này ra"},{"time":74.6,"text":"Và mình sẽ cho vào trong cái cối để mà chút nữa chúng ta xay chúng ta làm phần sốt"},{"time":78.8,"text":"Xong rồi cô ơi, mình sẽ cùng kiểm tra thành quả"},{"time":81.3,"text":"Cắt ra, cô chỉ cần 2 muỗng canh nước cốt chanh là được"},{"time":87.5,"text":"Đi cái phần nho này thì mình sẽ trang trí cô hả"},{"time":89.4,"text":"Ừ, em cắt lát 1 trái đi"},{"time":91.3,"text":"Rồi, 3 trái em cắt đôi"},{"time":93.0,"text":"sẽ bỏ nhau qua đây"},{"time":97.8,"text":"phần sốt này sử dụng đậu gà"},{"time":99.6,"text":"đã được chín hết rồi đó"},{"time":101.2,"text":"sẽ lấy khoảng chừng 1 chén đậu gà như thế này"},{"time":103.5,"text":"trong đậu gà có rất nhiều chất sơ"},{"time":105.8,"text":"và chất đạm thực vật rất tốt cho sức khỏe"},{"time":108.0,"text":"bên cạnh đó còn có rất nhiều vitamin cô"},{"time":110.0,"text":"A, C, E"},{"time":111.6,"text":"nó sẽ cung cấp cho mình vitamin, khoáng chất"},{"time":114.2,"text":"bên cạnh đó thì mình còn có luôn"},{"time":115.6,"text":"chất sơ và đạm luôn"},{"time":117.8,"text":"rồi, cho khoảng chừng 3 muỗng canh"},{"time":120.2,"text":"sốt bơ mè"},{"time":120.8,"text":"1 muỗng cà phê giỏi chanh mài"},{"time":123.3,"text":"cùng với lại 2 muỗng canh nước cốc chanh"},{"time":126.2,"text":"Và trong quá trình xay á các bạn"},{"time":128.0,"text":"Thì chúng ta sẽ cho thêm một ít cái nước"},{"time":130.6,"text":"Ở trong cái hộp đậu gà"},{"time":131.5,"text":"Chúng ta sẽ cho từ từ vô"},{"time":132.9,"text":"Để cho cái hỗn hợp sốt này nó không có quá đặc"},{"time":135.7,"text":"Ở đây thì chúng ta sẽ có khoảng chừng nửa chén dầu ô liu"},{"time":138.7,"text":"Mình sẽ cho vô từ từ thôi"},{"time":140.2,"text":"Chứ không có cho một lần"},{"time":141.3,"text":"Trong món ăn này chúng ta chọn dầu ô liu extra virgin"},{"time":144.5,"text":"Là loại dầu ép lạnh nguyên chất"},{"time":146.7,"text":"Rất tốt cho sức khỏe"},{"time":152.2,"text":"Mới xay như vậy thôi"},{"time":153.3,"text":"Mà nó ra mùi rất thơm luôn"},{"time":154.6,"text":"Sẽ kiểm tra cái thành phần nguyên liệu sau cùng của mình"},{"time":157.5,"text":"Chúng ta thêm chuối vào trong sốt để tạo độ thơm ngon, dinh dưỡng cũng như là độ sánh cho sốt các bạn nhé"},{"time":163.5,"text":"Sau khi mà chúng ta xay cái nguyên liệu nó vừa nhuyễn"},{"time":166.1,"text":"Thì chúng ta sẽ nêm thêm vào đây là 1 phần 4 muỗng cà phê muối"},{"time":169.7,"text":"Và 1 phần 4 muỗng cà phê tiêu"},{"time":172.3,"text":"Rồi sau đó chúng ta tiếp tục xay cho cái hỗn hợp này thật là nhuyễn"},{"time":175.7,"text":"Tiếp theo thì vẫn là phần làm bánh rán rất là quen thuộc"},{"time":178.8,"text":"Chúng ta sẽ sử dụng bột bánh rán pha sẵn vị truyền thống"},{"time":182.0,"text":"Một gói 200g mình pha với lại 140ml nước"},{"time":186.0,"text":"Như trên bao bì đã hướng dẫn"},{"time":187.6,"text":"Trong lúc đó thì chắc là Minh Tuấn sẽ giúp chuẩn bị"},{"time":190.3,"text":"Cho cô một cái chảo để mình đổ"},{"time":192.1,"text":"Và cái khăn để mình hạ nhiệt"},{"time":193.5,"text":"Sau khi mà chảo nóng rồi"},{"time":196.0,"text":"Thì giờ chúng ta sẽ hạ nhiệt cho chảo"},{"time":197.6,"text":"Bằng cách là đặt cái chảo lên trên cái khăn ẩm"},{"time":200.1,"text":"Khoảng 10 giây"},{"time":200.9,"text":"Sau đó đặt lại lên trên bếp và chúng ta bắt đầu cho bột vào"},{"time":208.1,"text":"Quá đẹp"},{"time":212.4,"text":"Rồi"},{"time":215.1,"text":"Quá đẹp"},{"time":217.5,"text":"Lấy bánh ra ha"},{"time":219.7,"text":"Chứ như vậy thì chúng ta sẽ lần lượt đổ cho đến khi hết bột"},{"time":226.7,"text":"Bây giờ thì chúng ta sẽ trang trí bánh ra"},{"time":228.8,"text":"Đầu tiên là mình sẽ đặt lên đây một cái bánh"},{"time":231.2,"text":"Cho thêm cái phần sốt đậu gà lên"},{"time":242.9,"text":"Đặt thêm một lớp bánh nữa"},{"time":247.2,"text":"Có một cái lớp sốt giữ cái phần nho này cố định"},{"time":251.2,"text":"Nho đặt lên"},{"time":257.7,"text":"Quá đẹp luôn cô ơi"},{"time":259.0,"text":"Rồi"},{"time":261.9,"text":"Tiếp theo thì chúng ta sẽ cùng đến với lại cái phần kem"},{"time":266.2,"text":"Mình sẽ rắc lên đây một ít cớm mèo"},{"time":268.5,"text":"Đó mọi người thấy hấp dẫn không"},{"time":270.2,"text":"Như là một món ở trong nhà hàng 5 sao luôn"},{"time":272.9,"text":"Và bên cạnh một món nhà hàng 5 sao như thế này"},{"time":275.6,"text":"Là có một cái mã cũng 5 sao"},{"time":277.0,"text":"Mã QR của chương trình"},{"time":278.2,"text":"Chúng ta quét mã này sẽ có công thức nấu ăn của ngày hôm nay"},{"time":280.6,"text":"Để các bạn làm tại nhà nha"},{"time":281.6,"text":"Và với bữa ăn này thì các bạn nên kết hợp"},{"time":284.2,"text":"Với kem vị trà matcha blendy nha"},{"time":287.0,"text":"Sốt có màu vàng sáng"},{"time":288.5,"text":"Sánh mịn vị bùi của đậu gà"},{"time":291.0,"text":"Và hương thơm nhè nhè của chuối"},{"time":293.3,"text":"Hoa cùng với bánh rán"},{"time":294.8,"text":"Sốt mềm vị ngon"},{"time":296.5,"text":"Tán trên đầu lưỡi"},{"time":299.0,"text":"Không phải món tráng miệng nào thì cũng làm cho chúng ta bị béo lên đâu ạ"},{"time":302.1,"text":"Chỉ cần một chút khéo léo tự làm món tráng miệng của riêng mình"},{"time":304.8,"text":"Chúng ta sẽ có một món tráng miệng rất dinh dưỡng"},{"time":307.1,"text":"Dành cho cả gia đình"},{"time":308.1,"text":"Công thức sẽ luôn có trên Youtube, Website"},{"time":310.8,"text":"Và Fanpage của chương trình Món Ngon Mỗi Ngày"},{"time":312.4,"text":"Để các bạn tham khảo và làm tại nhà"},{"time":313.9,"text":"Chúc các bạn thành công"}]}