ext":"Ba chỉ, riêm mắm ruốt, thơm phức, nước vị, cơm nhà"},{"time":36.3,"text":"Rất vui gần gặp lại các bạn trong chương trình Món ngon mỗi ngày, nấu chuẩn, ăn lanh"},{"time":40.8,"text":"Chương trình được tài trợ bởi công ty Ajinomoto Việt Nam"},{"time":44.9,"text":"Chào Minh Tuấn"},{"time":45.7,"text":"Em chào cô"},{"time":46.5,"text":"Em không biết là hôm nay cô nấu món gì"},{"time":48.5,"text":"Nhưng mà em thấy là bên đây có thịt ba chỉ"},{"time":50.9,"text":"Mà chỉ có thịt ba chỉ thôi, còn lại tất cả cái kia chỉ là gia vị nêm nếm thôi"},{"time":54.6,"text":"Thì em nghĩ đây là một cái món kho"},{"time":55.9,"text":"Cũng không phải kho, không phải xào"},{"time":58.1,"text":"Mà là ba chỉ, riêm mắm ruốt"},{"time":60.2,"text":"Bây giờ thì cô nhờ Tuấn làm một cái việc"},{"time":62.4,"text":"Sơ chế duy nhất hôm nay"},{"time":63.9,"text":"Đó là em cắt cái thịt ba chỉ"},{"time":66.2,"text":"Ra thành miếng con chỉ"},{"time":67.6,"text":"Thật ra là cái này chỉ quan trọng nhất là sắt thôi đó đúng không cô"},{"time":70.4,"text":"Đúng"},{"time":71.0,"text":"Là mà em làm luôn đó hả cô"},{"time":73.4,"text":"Với món ăn này thì Minh Tuấn thấy là cô Hà chọn thịt ba chỉ rất là ngon đúng không"},{"time":77.3,"text":"Đúng rồi"},{"time":77.7,"text":"Đó là những cái miếng ba chỉ mà có da mỏng vừa thôi"},{"time":80.2,"text":"Đó con heo đừng có to quá"},{"time":81.8,"text":"Ba chỉ thì có phần nạc"},{"time":83.7,"text":"Và phần mỡ nó dính liền với nhau"},{"time":85.5,"text":"Và nó có nhiều lớp"},{"time":88.3,"text":"Rồi"},{"time":88.7,"text":"Bây giờ chúng ta sẽ ướp gia vị vào trong thịt"},{"time":91.0,"text":"Mình sẽ cho vào đây 1 muỗng cà phê nước cốt chanh"},{"time":94.7,"text":"Tiếp là 1 muỗng canh rưỡi đường"},{"time":96.9,"text":"Mình nên ướp thịt ba chỉ với lại 1 ít đường và nước cốt chanh để giúp phần mỡ được trong nha các bạn"},{"time":102.9,"text":"Chúng ta ướp đường và nước cốt chanh vào thịt có thời gian các bạn để khoảng 10 phút sau"},{"time":107.6,"text":"Rồi mình hẳn ướp các gia vị khác"},{"time":109.1,"text":"Mình sẽ cho vào đây 2 muỗng canh xả băm"},{"time":111.4,"text":"1 muỗng canh hành và tỏi băm"},{"time":113.7,"text":"1 muỗng cà phê ớt hiểm băm"},{"time":115.8,"text":"1 muỗng cà phê hạt nêm Azi ngon heo"},{"time":118.3,"text":"Chúng ta sẽ trộn đều lên"},{"time":122.1,"text":"Rồi tiếp theo là một phần rất là quan trọng của món ăn"},{"time":124.6,"text":"Là chúng ta sẽ dùng khoảng chừng một chén nước nóng"},{"time":127.3,"text":"Mình sẽ cho hai muỗng canh mắm rút Huế"},{"time":130.0,"text":"Nó khoảng chừng 50 gram á"},{"time":131.3,"text":"Mình cho vào đây mình hòa tan"},{"time":132.8,"text":"Minh Tuấn biết tại sao phải hòa nước nóng không?"},{"time":135.5,"text":"Dạ để cho cái mắm rút của mình nó tan hoàn toàn ra"},{"time":138.6,"text":"Rồi mình còn lọc lại những cái cặn của con rút ở trong đó đúng không cô?"},{"time":142.6,"text":"Đúng rồi Minh Tuấn"},{"time":143.3,"text":"Các bạn lưu ý là chúng ta sẽ hòa tan mắm rút trong nước nóng"},{"time":146.8,"text":"Để cho mắm rút tan đều"},{"time":148.5,"text":"Cũng như là mùi mắm dễ chịu, món ăn sẽ ngon hơn"},{"time":150.9,"text":"Và ngoài ra cái việc mà chúng ta hòa tan mắm ruốt vào trong nước nóng này"},{"time":154.5,"text":"Thì cái mùi mắm ruốt nó sẽ bay hơi lên bớt"},{"time":157.6,"text":"Thì nó sẽ dễ chịu hơn"},{"time":158.8,"text":"Sau khi mình hòa tan rồi thì mình sẽ để một chút cho nó lắng lại"},{"time":162.1,"text":"Thì mình chỉ lấy cái phần nước ở trên thôi"},{"time":163.8,"text":"Còn cái phần cặn ở dưới thì mình không có sử dụng vô món ăn này"},{"time":167.2,"text":"Bây giờ là Tuấn bắt lên giùm cô một cái chảo đi"},{"time":170.2,"text":"Mở lửa giúp cô luôn Tuấn ha"},{"time":171.6,"text":"Dạ rồi"},{"time":173.3,"text":"Chúng ta sẽ cho vào đây khoảng chừng 2 muỗng canh màu dầu điều"},{"time":177.6,"text":"Phần hành tím băm và tỏi băm còn lại thì mình cũng cho vô mình phi cho nó thơm"},{"time":181.5,"text":"Mình cũng không cần dầu quá nóng, mình sẽ từ từ chậm chậm để cho nó thơm"},{"time":185.3,"text":"Mình sẽ cho cái phần thịt đã ướp vào"},{"time":187.5,"text":"Đầu thì mình lửa lớn nhưng mà từ từ thì mình sẽ giảm cái lửa vừa thôi"},{"time":191.2,"text":"Để cho cái phần thịt đó thấm gia vị nha"},{"time":197.6,"text":"Thịt săn lại rồi thì bây giờ mình sẽ cho cái chén mắm ruốt nãy mình đã hòa vô"},{"time":202.1,"text":"Mình sẽ gạn lại, mình lấy cái phần nước đó nha"},{"time":205.3,"text":"Mình sẽ thấy là nó còn cái phần cặn ở dưới thì mình không có lấy"},{"time":209.0,"text":"Sau đó thì mình sẽ tiếp tục riêm với lửa vừa vừa"},{"time":211.5,"text":"Riêm cho đến khi mà cái phần nước này nó cạn"},{"time":214.1,"text":"Nó hơi sánh lại là được rồi các bạn"},{"time":215.7,"text":"Rồi, Túng thấy được chưa"},{"time":217.0,"text":"Bây giờ cô sẽ cho thêm vào đây"},{"time":218.9,"text":"Là ớt, sừng, cắt lát nè"},{"time":222.9,"text":"Một ít hành, lá, cắt khúc"},{"time":225.2,"text":"Rồi"},{"time":225.7,"text":"Trời ơi, có đẹp hay không"},{"time":226.8,"text":"Mở đảo lên đi"},{"time":227.5,"text":"Rồi, tắt lửa"},{"time":229.3,"text":"Trời ơi, đảo luôn cô ơi"},{"time":230.5,"text":"Khi riêm thịt thì chúng ta lưu ý"},{"time":232.6,"text":"Mình sử dụng lửa nhẹ để riêm"},{"time":234.5,"text":"Giúp thịt dễ thấm gia vị"},{"time":236.3,"text":"Đó"},{"time":237.0,"text":"Ờ, còn ai mà mới vừa mở tivi lên, nhìn cái món hấp dẫn như thế này"},{"time":241.2,"text":"Thì bên cạnh có một mã QR để mọi người có thể quét mã này"},{"time":244.4,"text":"Chúng ta sẽ có ngay công tích để làm món ăn này tại nhà nha"},{"time":246.5,"text":"Còn bây giờ chị lẹ lẹ cô ơi, chứ em đói bụng rồi"},{"time":251.2,"text":"Bây giờ thì chúng ta sẽ nhanh chóng trình bài món ăn nha"},{"time":254.9,"text":"Ôi mọi người ơi, nó thơm lưng nguyên gian bếp của món ngon mỗi ngày luôn"},{"time":258.8,"text":"Hương vị của quê hướng"},{"time":260.8,"text":"Chỉ nghe cái mùi mắm rút thôi mà đã chuyển qua nói tiếng Huế rồi luôn à"},{"time":264.8,"text":"Bữa bữa ăn này thì chúng ta sẽ ăn kèm cơm nè"},{"time":266.8,"text":"Và rau sống với lại dưa leo ha"},{"time":268.5,"text":"Đã chuẩn bị xong hết rồi đó"},{"time":269.9,"text":"Và để cho có một bữa ăn hoàn chỉnh"},{"time":271.5,"text":"Thì chúng ta nên kết hợp thêm món canh cá chép rau cần nha các bạn"},{"time":275.7,"text":"Bởi thật ra thì đây là những món ăn quê hương"},{"time":278.4,"text":"Mà chúng ta không thể nào mà quên được đúng không ạ"},{"time":280.6,"text":"Thịt heo vừa riêm xong"},{"time":282.3,"text":"Nóng hổi"},{"time":283.2,"text":"Thơm phức mùi xả"},{"time":284.7,"text":"Mềm béo"},{"time":286.2,"text":"Chút vị cay cay của ớt"},{"time":288.1,"text":"Mắm ruốt mặn mặn"},{"time":289.7,"text":"Ngon ngọt"},{"time":290.6,"text":"Hoa quyện hoàn hảo"},{"time":292.4,"text":"Ăn cực bắt cơm"},{"time":295.7,"text":"Trời mưa mà lạnh lạnh"},{"time":297.7,"text":"Mà có một nồi ba chỉ riêng mắm rút"},{"time":300.2,"text":"Thì không còn gì hạnh phúc bằng"},{"time":302.0,"text":"Các bạn hãy chia sẻ niềm hạnh phúc này với chúng tôi"},{"time":303.9,"text":"Bằng cách là thực hiện món ăn này nha"},{"time":305.3,"text":"Công thức luôn có trên Youtube, Website và Fanpage"},{"time":308.5,"text":"Của chương trình Món Ngon Mỗi Ngày"},{"time":309.5,"text":"Chúc các bạn thành công với một loại món ăn"},{"time":311.4,"text":"Mang đậm tình quê hương như món ăn của ngày hôm nay"}]}